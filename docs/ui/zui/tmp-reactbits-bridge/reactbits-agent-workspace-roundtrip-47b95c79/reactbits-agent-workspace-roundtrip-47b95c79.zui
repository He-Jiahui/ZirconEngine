[asset]
kind = "view"
id = "res://ui/tests/reactbits_agent_workspace.zui"
version = 2
display_name = "ReactBits Agent Workspace"

[tokens]
"surface.canvas" = "#0f1117"
"surface.panel" = "#171b24"
"surface.elevated" = "#1d2330"
"surface.inset" = "#11151d"
"border.default" = "#2a3342"
"border.strong" = "#3a4658"
"text.primary" = "#f4f7fb"
"text.secondary" = "#a9b4c5"
"text.muted" = "#718096"
"accent.primary" = "#8b7cff"
"accent.info" = "#5da9ff"
"status.success" = "#55d6a0"
"status.warning" = "#f4bd62"
"status.error" = "#ff7d8a"

[root]
node = "root"

[nodes.root]
component = "HorizontalBox"
control_id = "ReactBitsAgentWorkspaceRoot"
classes = [ "rb-shell" ]

[nodes.root.props]
background_color = "$surface.canvas"
foreground_color = "$text.primary"
reference_primary = "https://pro.reactbits.dev/docs/app-ui/app-shell/app-shell-4"
reference_supporting = [ "https://pro.reactbits.dev/docs/app-ui/ai-chat/ai-chat-1", "https://pro.reactbits.dev/docs/app-ui/agent-activity/agent-activity-2", "https://pro.reactbits.dev/docs/app-ui/tool-calls/tool-calls-2", "https://pro.reactbits.dev/docs/app-ui/agent-approval" ]
responsive_wide = "sidebar + conversation + context panel"
responsive_compact = "context panel moves below the conversation"
responsive_mobile = "sidebar becomes a priority dock; composer stays primary"

[nodes.root.layout]
clip = true
input_policy = "Receive"

[nodes.root.layout.width]
min = 640
preferred = 1280
max = 1600
stretch = "Stretch"

[nodes.root.layout.height]
min = 520
preferred = 800
max = 1000
stretch = "Stretch"

[nodes.root.layout.container]
kind = "HorizontalBox"
gap = 12

[[nodes.root.children]]
node = "sidebar"

[nodes.root.children.slot.layout.width]
min = 220
preferred = 232
max = 260
stretch = "Fixed"

[[nodes.root.children]]
node = "main"

[nodes.root.children.slot.layout.width]
min = 440
preferred = 700
weight = 1
stretch = "Stretch"

[[nodes.root.children]]
node = "context"

[nodes.root.children.slot.layout.width]
min = 280
preferred = 320
max = 360
stretch = "Fixed"

[nodes.root.zircon_extension]
owner = "reactbits-reference-slice"
reference_profile = "reactbits-app-ui-agent-workspace-v1"
source_of_truth = "zui"
penpot_visual_check = "required"

[nodes.sidebar]
component = "VerticalBox"
control_id = "ReactBitsAgentSidebar"
classes = [ "rb-panel", "rb-sidebar" ]

[nodes.sidebar.props]
background_color = "$surface.panel"
border_color = "$border.default"
border_width = 1
corner_radius = 10

[nodes.sidebar.layout]
clip = true

[nodes.sidebar.layout.width]
stretch = "Stretch"

[nodes.sidebar.layout.height]
stretch = "Stretch"

[nodes.sidebar.layout.container]
kind = "VerticalBox"
gap = 10

[nodes.sidebar.layout.padding]
left = 14
right = 14
top = 14
bottom = 14

[[nodes.sidebar.children]]
node = "sidebar_brand"

[[nodes.sidebar.children]]
node = "new_session"

[[nodes.sidebar.children]]
node = "sidebar_nav"

[[nodes.sidebar.children]]
node = "sidebar_history"

[[nodes.sidebar.children]]
node = "sidebar_footer"

[nodes.sidebar_brand]
component = "HorizontalBox"
control_id = "ReactBitsAgentSidebarBrand"

[nodes.sidebar_brand.props]
background_color = "$surface.elevated"
corner_radius = 8
border_color = "$border.default"
border_width = 1

[nodes.sidebar_brand.layout.width]
stretch = "Stretch"

[nodes.sidebar_brand.layout.height]
min = 42
preferred = 42
max = 42
stretch = "Fixed"

[nodes.sidebar_brand.layout.container]
kind = "HorizontalBox"
gap = 8

[nodes.sidebar_brand.layout.padding]
