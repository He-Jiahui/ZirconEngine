[nodes.brand_title.props]
text = "Zircon Agent"
foreground_color = "$text.primary"
font_size = 13
font_weight = 650
text_overflow = "elide"

[nodes.brand_title.layout.width]
stretch = "Stretch"

[nodes.brand_title.layout.height]
stretch = "Stretch"

