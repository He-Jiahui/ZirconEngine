right = 10
top = 8
bottom = 8

[[nodes.sidebar_brand.children]]
node = "brand_mark"

[[nodes.sidebar_brand.children]]
node = "brand_title"

[[nodes.sidebar_brand.children]]
node = "brand_status"

[nodes.brand_mark]
component = "Label"
control_id = "ReactBitsAgentBrandMark"

[nodes.brand_mark.props]
text = "Z"
foreground_color = "$accent.primary"
font_size = 18
font_weight = 700
accessibility_label = "Zircon"

[nodes.brand_mark.layout.width]
min = 22
preferred = 22
max = 22
stretch = "Fixed"

[nodes.brand_mark.layout.height]
stretch = "Stretch"

[nodes.brand_title]
