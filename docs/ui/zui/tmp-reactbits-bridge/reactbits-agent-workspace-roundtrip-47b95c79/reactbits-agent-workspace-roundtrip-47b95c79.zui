[nodes.brand_status.layout.width]
min = 16
preferred = 16
max = 16
stretch = "Fixed"

[nodes.brand_status.layout.height]
stretch = "Stretch"

[nodes.new_session]
component = "Button"
control_id = "ReactBitsAgentNewSession"
classes = [ "rb-primary-action" ]

[nodes.new_session.props]
text = "+  New session"
button_variant = "contained"
background_color = "$accent.primary"
foreground_color = "$text.primary"
corner_radius = 8
border_width = 0
input_interactive = true
input_focusable = true
accessibility_label = "Create new agent session"

[nodes.new_session.layout.width]
stretch = "Stretch"

[nodes.new_session.layout.height]
min = 38
preferred = 38
max = 38
stretch = "Fixed"

[[nodes.new_session.events]]
id = "ReactBitsAgent/NewSession"
event = "Click"
route = "agent.session.create"

