penpot_dependency_sources = [ "zircon_editor/src/tests/fixtures/ui_zui/theme/editor_base.zui", "zircon_editor/src/tests/fixtures/ui_zui/theme/editor_material.zui", "zircon_editor/src/tests/fixtures/ui_zui/editor/editor_widgets.zui" ]
penpot_original_source = "stylesheets = []\n\n[asset]\nkind = \"layout\"\nid = \"editor.binding_browser\"\nversion = 1\ndisplay_name = \"Binding Browser\"\n\n[imports]\nwidgets = [\n    \"res://ui/editor/editor_widgets.zui#EditorToolbar\",\n    \"res://ui/editor/editor_widgets.zui#EditorToolbarButton\",\n    \"res://ui/editor/editor_widgets.zui#EditorSectionCard\",\n]\nstyles = [\"res://ui/theme/editor_base.zui\"]\n\n[tokens]\n\n[root]\nnode_id = \"binding_browser_root\"\nkind = \"native\"\ntype = \"VerticalBox\"\ncontrol_id = \"BindingBrowserRoot\"\nclasses = [\"editor-shell\"]\nbindings = []\n\n[root.params]\n\n[root.props]\n\n[root.layout.container]\ngap = 10.0\nkind = \"VerticalBox\"\n\n[root.layout.height]\nstretch = \"Stretch\"\n\n[root.layout.width]\nstretch = \"Stretch\"\n\n[root.style_overrides.self]\n\n[root.style_overrides.slot]\n\n[[root.children]]\n\n[root.children.slot]\n\n[root.children.node]\nnode_id = \"toolbar\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorToolbar\"\ncontrol_id = \"BindingBrowserToolbar\"\nclasses = []\nbindings = []\n\n[root.children.node.params]\n\n[root.children.node.props]\n\n[root.children.node.style_overrides.self]\n\n[root.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\nmount = \"actions\"\n\n[root.children.node.children.slot]\n\n[root.children.node.children.node]\nnode_id = \"add_binding_button\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorToolbarButton\"\ncontrol_id = \"AddBinding\"\nclasses = [\"toolbar-primary\"]\nbindings = []\nchildren = []\n\n[root.children.node.children.node.params]\nicon = \"add-outline\"\nlabel = \"Add Binding\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\nmount = \"actions\"\n\n[root.children.node.children.slot]\n\n[root.children.node.children.node]\nnode_id = \"preview_graph_button\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorToolbarButton\"\ncontrol_id = \"PreviewGraph\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.params]\nicon = \"git-network-outline\"\nlabel = \"Preview Graph\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children]]\n\n[root.children.slot]\n\n[root.children.node]\nnode_id = \"content\"\nkind = \"native\"\ntype = \"HorizontalBox\"\ncontrol_id = \"BindingBrowserContent\"\nclasses = []\nbindings = []\n\n[root.children.node.params]\n\n[root.children.node.props]\n\n[root.children.node.layout]\nclip = true\ninput_policy = \"Receive\"\n\n[root.children.node.layout.container]\ngap = 10.0\nkind = \"ScrollableBox\"\naxis = \"Horizontal\"\nscrollbar_visibility = \"Auto\"\n\n[root.children.node.layout.height]\nstretch = \"Stretch\"\n\n[root.children.node.layout.width]\nmin = 0.0\nstretch = \"Stretch\"\n\n[root.children.node.style_overrides.self]\n\n[root.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\n\n[root.children.node.children.slot.layout.width]\nmax = 320.0\nmin = 240.0\npreferred = 260.0\nstretch = \"Fixed\"\n\n[root.children.node.children.node]\nnode_id = \"binding_list_panel\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorSectionCard\"\ncontrol_id = \"BindingListPanel\"\nclasses = []\nbindings = []\n\n[root.children.node.children.node.params]\ntitle = \"Bindings\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children.node.children]]\nmount = \"content\"\n\n[root.children.node.children.node.children.slot]\n\n[root.children.node.children.node.children.node]\nnode_id = \"binding_list_label\"\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"BindingListLabel\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.children.node.params]\n\n[root.children.node.children.node.children.node.props]\ntext = \"Click, Change, Toggle bindings\"\n\n[root.children.node.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\n\n[root.children.node.children.slot]\n\n[root.children.node.children.slot.layout.width]\nmax = 360.0\nmin = 180.0\npreferred = 320.0\nstretch = \"Fixed\"\n\n[root.children.node.children.node]\nnode_id = \"payload_panel\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorSectionCard\"\ncontrol_id = \"BindingPayloadPanel\"\nclasses = []\nbindings = []\n\n[root.children.node.children.node.params]\ntitle = \"Payload Schema\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children.node.children]]\nmount = \"content\"\n\n[root.children.node.children.node.children.slot]\n\n[root.children.node.children.node.children.node]\nnode_id = \"payload_label\"\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"BindingPayloadLabel\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.children.node.params]\n\n[root.children.node.children.node.children.node.props]\ntext = \"Structured payload fields, defaults, preview values\"\n\n[root.children.node.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\n\n[root.children.node.children.slot.layout.width]\nmax = 360.0\nmin = 280.0\npreferred = 320.0\nstretch = \"Fixed\"\n\n[root.children.node.children.node]\nnode_id = \"preview_graph_panel\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorSectionCard\"\ncontrol_id = \"BindingPreviewGraphPanel\"\nclasses = []\nbindings = []\n\n[root.children.node.children.node.params]\ntitle = \"Preview Graph\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children.node.children]]\nmount = \"content\"\n\n[root.children.node.children.node.children.slot]\n\n[root.children.node.children.node.children.node]\nnode_id = \"preview_graph_label\"\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"BindingPreviewGraphLabel\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.children.node.params]\n\n[root.children.node.children.node.children.node.props]\ntext = \"Cross-node interaction edges and expression previews\"\n\n[root.children.node.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.children.node.style_overrides.slot]\n\n[components]\n"

