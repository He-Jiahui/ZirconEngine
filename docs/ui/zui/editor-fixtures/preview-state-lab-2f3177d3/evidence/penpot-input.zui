penpot_dependency_sources = [ "zircon_editor/src/tests/fixtures/ui_zui/theme/editor_base.zui", "zircon_editor/src/tests/fixtures/ui_zui/theme/editor_material.zui", "zircon_editor/src/tests/fixtures/ui_zui/editor/editor_widgets.zui" ]
penpot_original_source = "stylesheets = []\n\n[asset]\nkind = \"layout\"\nid = \"editor.preview_state_lab\"\nversion = 1\ndisplay_name = \"Preview State Lab\"\n\n[imports]\nwidgets = [\n    \"res://ui/editor/editor_widgets.zui#EditorToolbar\",\n    \"res://ui/editor/editor_widgets.zui#EditorToolbarButton\",\n    \"res://ui/editor/editor_widgets.zui#EditorSectionCard\",\n]\nstyles = [\"res://ui/theme/editor_base.zui\"]\n\n[tokens]\n\n[root]\nnode_id = \"preview_state_lab_root\"\nkind = \"native\"\ntype = \"VerticalBox\"\ncontrol_id = \"PreviewStateLabRoot\"\nclasses = [\"editor-shell\"]\nbindings = []\n\n[root.params]\n\n[root.props]\n\n[root.layout.container]\ngap = 10.0\nkind = \"VerticalBox\"\n\n[root.layout.height]\nstretch = \"Stretch\"\n\n[root.layout.width]\nstretch = \"Stretch\"\n\n[root.style_overrides.self]\n\n[root.style_overrides.slot]\n\n[[root.children]]\n\n[root.children.slot]\n\n[root.children.node]\nnode_id = \"toolbar\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorToolbar\"\ncontrol_id = \"PreviewStateLabToolbar\"\nclasses = []\nbindings = []\n\n[root.children.node.params]\n\n[root.children.node.props]\n\n[root.children.node.style_overrides.self]\n\n[root.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\nmount = \"actions\"\n\n[root.children.node.children.slot]\n\n[root.children.node.children.node]\nnode_id = \"run_preview_button\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorToolbarButton\"\ncontrol_id = \"RunPreview\"\nclasses = [\"toolbar-primary\"]\nbindings = []\nchildren = []\n\n[root.children.node.children.node.params]\nicon = \"play-outline\"\nlabel = \"Run Preview\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\nmount = \"actions\"\n\n[root.children.node.children.slot]\n\n[root.children.node.children.node]\nnode_id = \"reset_preview_button\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorToolbarButton\"\ncontrol_id = \"ResetPreview\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.params]\nicon = \"refresh-outline\"\nlabel = \"Reset State\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children]]\n\n[root.children.slot]\n\n[root.children.node]\nnode_id = \"content\"\nkind = \"native\"\ntype = \"HorizontalBox\"\ncontrol_id = \"PreviewStateLabContent\"\nclasses = []\nbindings = []\n\n[root.children.node.params]\n\n[root.children.node.props]\n\n[root.children.node.layout.container]\ngap = 10.0\nkind = \"HorizontalBox\"\n\n[root.children.node.layout.height]\nstretch = \"Stretch\"\n\n[root.children.node.layout.width]\nstretch = \"Stretch\"\n\n[root.children.node.style_overrides.self]\n\n[root.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\n\n[root.children.node.children.slot.layout.width]\nmax = 360.0\nmin = 260.0\npreferred = 300.0\nstretch = \"Fixed\"\n\n[root.children.node.children.node]\nnode_id = \"scenario_panel\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorSectionCard\"\ncontrol_id = \"PreviewScenarioPanel\"\nclasses = []\nbindings = []\n\n[root.children.node.children.node.params]\ntitle = \"Preview Scenarios\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children.node.children]]\nmount = \"content\"\n\n[root.children.node.children.node.children.slot]\n\n[root.children.node.children.node.children.node]\nnode_id = \"scenario_label\"\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"PreviewScenarioLabel\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.children.node.params]\n\n[root.children.node.children.node.children.node.props]\ntext = \"Mock state presets, collection feeds, expression probes\"\n\n[root.children.node.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\n\n[root.children.node.children.slot]\n\n[root.children.node.children.node]\nnode_id = \"graph_panel\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorSectionCard\"\ncontrol_id = \"PreviewGraphPanel\"\nclasses = []\nbindings = []\n\n[root.children.node.children.node.params]\ntitle = \"State Graph\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children.node.children]]\nmount = \"content\"\n\n[root.children.node.children.node.children.slot]\n\n[root.children.node.children.node.children.node]\nnode_id = \"graph_label\"\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"PreviewGraphLabel\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.children.node.params]\n\n[root.children.node.children.node.children.node.props]\ntext = \"Cross-node dependencies, binding payload previews, event routes\"\n\n[root.children.node.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.children.node.style_overrides.slot]\n\n[components]\n"

