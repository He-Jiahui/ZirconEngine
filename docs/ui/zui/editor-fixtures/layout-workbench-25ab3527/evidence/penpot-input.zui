penpot_dependency_sources = [ "zircon_editor/src/tests/fixtures/ui_zui/theme/editor_base.zui", "zircon_editor/src/tests/fixtures/ui_zui/theme/editor_material.zui", "zircon_editor/src/tests/fixtures/ui_zui/editor/editor_widgets.zui" ]
penpot_original_source = "stylesheets = []\n\n[asset]\nkind = \"layout\"\nid = \"editor.layout_workbench\"\nversion = 1\ndisplay_name = \"Layout Workbench\"\n\n[imports]\nwidgets = [\n    \"res://ui/editor/editor_widgets.zui#EditorToolbar\",\n    \"res://ui/editor/editor_widgets.zui#EditorToolbarButton\",\n    \"res://ui/editor/editor_widgets.zui#EditorSectionCard\",\n]\nstyles = [\"res://ui/theme/editor_base.zui\"]\n\n[tokens]\n\n[root]\nnode_id = \"layout_workbench_root\"\nkind = \"native\"\ntype = \"VerticalBox\"\ncontrol_id = \"LayoutWorkbenchRoot\"\nclasses = [\"editor-shell\"]\nbindings = []\n\n[root.params]\n\n[root.props]\n\n[root.layout.container]\ngap = 10.0\nkind = \"VerticalBox\"\n\n[root.layout.height]\nstretch = \"Stretch\"\n\n[root.layout.width]\nstretch = \"Stretch\"\n\n[root.style_overrides.self]\n\n[root.style_overrides.slot]\n\n[[root.children]]\n\n[root.children.slot]\n\n[root.children.node]\nnode_id = \"toolbar\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorToolbar\"\ncontrol_id = \"LayoutWorkbenchToolbar\"\nclasses = []\nbindings = []\n\n[root.children.node.params]\n\n[root.children.node.props]\n\n[root.children.node.style_overrides.self]\n\n[root.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\nmount = \"actions\"\n\n[root.children.node.children.slot]\n\n[root.children.node.children.node]\nnode_id = \"new_canvas_button\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorToolbarButton\"\ncontrol_id = \"NewCanvas\"\nclasses = [\"toolbar-primary\"]\nbindings = []\nchildren = []\n\n[root.children.node.children.node.params]\nicon = \"add-outline\"\nlabel = \"New Canvas\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\nmount = \"actions\"\n\n[root.children.node.children.slot]\n\n[root.children.node.children.node]\nnode_id = \"promote_button\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorToolbarButton\"\ncontrol_id = \"PromoteLayout\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.params]\nicon = \"share-outline\"\nlabel = \"Promote\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children]]\n\n[root.children.slot]\n\n[root.children.node]\nnode_id = \"content\"\nkind = \"native\"\ntype = \"HorizontalBox\"\ncontrol_id = \"LayoutWorkbenchContent\"\nclasses = []\nbindings = []\n\n[root.children.node.params]\n\n[root.children.node.props]\n\n[root.children.node.layout]\nclip = true\ninput_policy = \"Receive\"\n\n[root.children.node.layout.container]\ngap = 10.0\nkind = \"ScrollableBox\"\naxis = \"Horizontal\"\nscrollbar_visibility = \"Auto\"\n\n[root.children.node.layout.height]\nstretch = \"Stretch\"\n\n[root.children.node.layout.width]\nmin = 0.0\nstretch = \"Stretch\"\n\n[root.children.node.style_overrides.self]\n\n[root.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\n\n[root.children.node.children.slot.layout.width]\nmax = 280.0\nmin = 220.0\npreferred = 240.0\nstretch = \"Fixed\"\n\n[root.children.node.children.node]\nnode_id = \"outline_panel\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorSectionCard\"\ncontrol_id = \"LayoutOutlinePanel\"\nclasses = []\nbindings = []\n\n[root.children.node.children.node.params]\ntitle = \"Outline\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children.node.children]]\nmount = \"content\"\n\n[root.children.node.children.node.children.slot]\n\n[root.children.node.children.node.children.node]\nnode_id = \"outline_label\"\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"LayoutOutlineLabel\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.children.node.params]\n\n[root.children.node.children.node.children.node.props]\ntext = \"Pages, components, reusable layout patterns\"\n\n[root.children.node.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\n\n[root.children.node.children.slot]\n\n[root.children.node.children.slot.layout.width]\nmax = 340.0\nmin = 180.0\npreferred = 280.0\nstretch = \"Fixed\"\n\n[root.children.node.children.node]\nnode_id = \"canvas_panel\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorSectionCard\"\ncontrol_id = \"LayoutCanvasPanel\"\nclasses = []\nbindings = []\n\n[root.children.node.children.node.params]\ntitle = \"Canvas\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children.node.children]]\nmount = \"content\"\n\n[root.children.node.children.node.children.slot]\n\n[root.children.node.children.node.children.node]\nnode_id = \"canvas_label\"\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"LayoutCanvasLabel\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.children.node.params]\n\n[root.children.node.children.node.children.node.props]\ntext = \"Auto layout guides, overlay anchors, drop overlays\"\n\n[root.children.node.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children]]\n\n[root.children.node.children.slot.layout.width]\nmax = 340.0\nmin = 260.0\npreferred = 280.0\nstretch = \"Fixed\"\n\n[root.children.node.children.node]\nnode_id = \"semantics_panel\"\nkind = \"reference\"\ncomponent_ref = \"res://ui/editor/editor_widgets.zui#EditorSectionCard\"\ncontrol_id = \"LayoutSemanticsPanel\"\nclasses = []\nbindings = []\n\n[root.children.node.children.node.params]\ntitle = \"Semantics\"\n\n[root.children.node.children.node.props]\n\n[root.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.style_overrides.slot]\n\n[[root.children.node.children.node.children]]\nmount = \"content\"\n\n[root.children.node.children.node.children.slot]\n\n[root.children.node.children.node.children.node]\nnode_id = \"semantics_label\"\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"LayoutSemanticsLabel\"\nclasses = []\nbindings = []\nchildren = []\n\n[root.children.node.children.node.children.node.params]\n\n[root.children.node.children.node.children.node.props]\ntext = \"Slot inspector, layout contract, binding context\"\n\n[root.children.node.children.node.children.node.style_overrides.self]\n\n[root.children.node.children.node.children.node.style_overrides.slot]\n\n[components]\n"

