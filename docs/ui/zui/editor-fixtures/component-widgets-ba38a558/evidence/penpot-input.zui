penpot_dependency_sources = [ "zircon_editor/src/tests/fixtures/ui_zui/theme/editor_material.zui" ]
penpot_original_source = "[asset]\nkind = \"widget\"\nid = \"ui.editor.component_widgets\"\nversion = 1\ndisplay_name = \"Component Showcase Widgets\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/theme/editor_material.zui\"]\n\n[components.ShowcaseSection]\nstyle_scope = \"open\"\n\n[components.ShowcaseSection.params.title]\ntype = \"string\"\ndefault = \"Section\"\n\n[components.ShowcaseSection.slots.content]\nrequired = true\nmultiple = true\n\n[components.ShowcaseSection.root]\nnode_id = \"showcase_section_root\"\nkind = \"native\"\ntype = \"Group\"\nclasses = [\"showcase-panel\"]\nprops = { text = \"$param.title\", expanded = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 8.0 } }\n\n[[components.ShowcaseSection.root.children]]\n[components.ShowcaseSection.root.children.node]\nnode_id = \"showcase_section_title\"\nkind = \"native\"\ntype = \"Label\"\nclasses = [\"showcase-title\"]\nprops = { text = \"$param.title\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[[components.ShowcaseSection.root.children]]\nmount = \"content\"\n[components.ShowcaseSection.root.children.node]\nnode_id = \"showcase_section_content\"\nkind = \"slot\"\nslot_name = \"content\"\n"

[imports]
widgets = []
styles = []

[asset]
kind = "view"
id = "ui.editor.component_widgets"
version = 2
display_name = "Component Showcase Widgets"

[root]
node = "showcase_section_root"

[nodes.showcase_section_root]
component = "Group"
classes = [ "showcase-panel" ]
legacy_kind = "native"
legacy_type = "Group"

[nodes.showcase_section_root.props]
text = "Section"
expanded = true

[nodes.showcase_section_root.layout.width]
stretch = "Stretch"

[nodes.showcase_section_root.layout.height]
stretch = "Stretch"

[nodes.showcase_section_root.layout.container]
kind = "VerticalBox"
gap = 8

[[nodes.showcase_section_root.children]]
node = "showcase_section_title"

[[nodes.showcase_section_root.children]]
node = "showcase_section_content"

[nodes.showcase_section_root.children.slot]
name = "content"

[nodes.showcase_section_title]
component = "Label"
classes = [ "showcase-title" ]
legacy_kind = "native"
legacy_type = "Label"

[nodes.showcase_section_title.props]
text = "Section"

[nodes.showcase_section_title.layout.width]
stretch = "Stretch"

[nodes.showcase_section_title.layout.height]
min = 24
preferred = 24
max = 24
stretch = "Fixed"

[nodes.showcase_section_content]
component = "Slot"
legacy_kind = "slot"
legacy_slot_name = "content"
legacy_mount = "content"

[nodes.showcase_section_content.props]
name = "content"

[components.ShowcaseSection]
style_scope = "open"
root = "showcase_section_root"

[components.ShowcaseSection.params.title]
type = "string"
default = "Section"

[components.ShowcaseSection.slots.content]
required = true
multiple = true

[legacy_migration]
source_path = "zircon_editor/src/tests/fixtures/ui_zui/editor/component_widgets.zui"
source_kind = "widget"
source_version = 1
source_component_ids = [ "ShowcaseSection" ]

