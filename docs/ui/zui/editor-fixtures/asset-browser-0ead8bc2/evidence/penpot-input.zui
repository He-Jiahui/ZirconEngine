"\ncontrol_id = \"AssetBrowserToolbarPanel\"\nlayout = { container = { kind = \"VerticalBox\", gap = 4.0 }, width = { stretch = \"Stretch\" }, height = { min = 122.0, preferred = 122.0, max = 122.0, stretch = \"Fixed\" } }\nchildren = [{ child = \"toolbar_title_row\" }, { child = \"toolbar_subtitle_row\" }, { child = \"toolbar_search_row\" }, { child = \"toolbar_kind_primary_row\" }, { child = \"toolbar_kind_secondary_row\" }]\n\n[nodes.import_left_space]\nkind = \"native\"\ntype = \"Space\"\nlayout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.import_label]\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"AssetBrowserImportLabel\"\nprops = { text = \"Quick Import\", text_tone = \"muted\", font_size = 9.0 }\nlayout = { width = { min = 86.0, preferred = 86.0, max = 86.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.import_path_field]\nkind = \"native\"\ntype = \"TextField\"\ncontrol_id = \"AssetBrowserImportPathField\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.import_button]\nkind = \"native\"\ntype = \"Button\"\ncontrol_id = \"ImportModel\"\nprops = { text = \"Import\", button_variant = \"primary\" }\nlayout = { width = { min = 86.0, preferred = 86.0, max = 86.0, stretch = \"Fixed\" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = \"Fixed\" } }\n\n[nodes.import_right_space]\nkind = \"native\"\ntype = \"Space\"\nlayout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.import_panel]\nkind = \"native\"\ntype = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserImportPanel\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" } }\nchildren = [{ child = \"import_left_space\" }, { child = \"import_label\" }, { child = \"import_path_field\" }, { child = \"import_button\" }, { child = \"import_right_space\" }]\n\n[nodes.sources_title_text]\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"AssetBrowserSourcesTitleText\"\nprops = { text = \"Sources\", font_size = 11.0, font_weight = 700 }\nlayout = { position = { x = 12.0, y = 10.0 }, width = { stretch = \"Stretch\" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = \"Fixed\" } }\n\n[nodes.sources_subtitle_text]\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"AssetBrowserSourcesSubtitleText\"\nprops = { text = \"Project/assets\", font_size = 9.0, overflow = \"elide\" }\nlayout = { position = { x = 12.0, y = 25.0 }, width = { stretch = \"Stretch\" }, height = { min = 12.0, preferred = 12.0, max = 12.0, stretch = \"Fixed\" } }\n\n[nodes.sources_header_panel]\nkind = \"native\"\ntype = \"Overlay\"\ncontrol_id = \"AssetBrowserSourcesHeaderPanel\"\nprops = { surface_variant = \"panel\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { min = 48.0, preferred = 48.0, max = 48.0, stretch = \"Fixed\" } }\nchildren = [{ child = \"sources_title_text\" }, { child = \"sources_subtitle_text\" }]\n\n[nodes.sources_divider]\nkind = \"native\"\ntype = \"Space\"\ncontrol_id = \"AssetBrowserSourcesDivider\"\nprops = { surface_variant = \"divider\" }\nlayout = { position = { x = 0.0, y = 48.0 }, width = { stretch = \"Stretch\" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" } }\n\n[nodes.sources_row_icon]\nkind = \"native\"\ntype = \"Space\"\ncontrol_id = \"AssetBrowserSourcesRowIcon\"\nlayout = { position = { x = 8.0, y = 7.0 }, width = { min = 14.0, preferred = 14.0, max = 14.0, stretch = \"Fixed\" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = \"Fixed\" } }\n\n[nodes.sources_row_name_text]\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"AssetBrowserSourcesRowNameText\"\npro