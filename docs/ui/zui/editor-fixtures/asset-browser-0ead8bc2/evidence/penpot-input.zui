[stylesheets.rules.set.self.border]
color = "$material_border"
width = "$material_border_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-tab-bar-horizontal"

[stylesheets.rules.set.self.background]
color = "$material_surface_inset"

[[stylesheets.rules]]
selector = ".material-tab-bar-vertical"

[stylesheets.rules.set.self.background]
color = "$material_surface_inset"

[[stylesheets.rules]]
selector = ".material-tab-impl"

[stylesheets.rules.set.self.background]
color = "$material_surface_inset"

[stylesheets.rules.set.self.foreground]
color = "$material_text"

[stylesheets.rules.set.self.border]
color = "$material_surface_inset"
width = "$material_border_width_none"
radius = "$material_radius_none"

[[stylesheets.rules]]
selector = ".material-text-edit"

[stylesheets.rules.set.self.background]
color = "$material_surface_inset"

[stylesheets.rules.set.self.foreground]
color = "$material_text"

[[stylesheets.rules]]
selector = ".material-runtime-dialog"

[stylesheets.rules.set.self.background]
color = "$material_popup"

[stylesheets.rules.set.self.foreground]
color = "$material_text"

[stylesheets.rules.set.self.border]
color = "$material_border"
width = "$material_border_width"
radius = "$material_radius_medium"

[[stylesheets.rules]]
selector = ".material-runtime-hud"

[stylesheets.rules.set.self.background]
color = "$material_surface_inset"

[stylesheets.rules.set.self.foreground]
color = "$material_text"

[stylesheets.rules.set.self.border]
color = "$material_border"
width = "$material_border_width"
radius = "$material_radius_surface"

[[stylesheets.rules]]
selector = ".material-runtime-backdrop"

[stylesheets.rules.set.self.background]
color = "$material_color_scrim"

[[stylesheets.rules]]
selector = ".material-title"

[stylesheets.rules.set.self.foreground]
color = "$material_text"

[stylesheets.rules.set.self.font]
size = "$material_font_size_title"

[[stylesheets.rules]]
selector = ".material-body"

[stylesheets.rules.set.self.foreground]
color = "$material_text"

[stylesheets.rules.set.self.font]
size = "$material_font_size_body"

[[stylesheets.rules]]
selector = ".material-meta"

[stylesheets.rules.set.self.foreground]
color = "$material_text_muted"

[stylesheets.rules.set.self.font]
size = "$material_font_size_meta"

[[stylesheets]]
id = "editor_base"

[[stylesheets.rules]]
selector = ".editor-shell"

[stylesheets.rules.set.self.background]
color = "$shell_bg"

[stylesheets.rules.set.slot]
[[stylesheets.rules]]
selector = ".panel"

[stylesheets.rules.set.self.background]
color = "$panel_bg"

[stylesheets.rules.set.slot]
[[stylesheets.rules]]
selector = ".section-title"

[stylesheets.rules.set.self]
text = "$title"

[stylesheets.rules.set.slot]
[[stylesheets.rules]]
selector = ".toolbar > Button.toolbar-primary"

[stylesheets.rules.set.self.background]
color = "$accent"

[stylesheets.rules.set.slot]
[[stylesheets.rules]]
selector = "#DesignerLabel"

[stylesheets.rules.set.self]
text = "Canvas Preview"

[stylesheets.rules.set.slot]
[imports]
styles = []
widgets = []

