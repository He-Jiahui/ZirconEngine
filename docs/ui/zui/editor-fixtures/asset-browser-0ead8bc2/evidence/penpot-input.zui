penpot_original_source = "stylesheets = []\n\n[asset]\nkind = \"layout\"\nid = \"editor.asset_browser\"\nversion = 2\ndisplay_name = \"Asset Browser\"\n\n[imports]\nstyles = [\"res://ui/theme/editor_base.zui\"]\n\n[root]\nnode = \"asset_browser_root\"\n\n[nodes.toolbar_title_text]\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"AssetBrowserTitleText\"\nprops = { text = \"Asset Browser\", font_size = 12.0, font_weight = 700, overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_locate_button]\nkind = \"native\"\ntype = \"IconButton\"\ncontrol_id = \"LocateSelectedAsset\"\nprops = { label = \"Locate selected asset\", icon = \"editor_pages/asset_browser/navigation/search.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 30.0, preferred = 30.0, max = 30.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_title_row]\nkind = \"native\"\ntype = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserToolbarTitleRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 20.0, preferred = 20.0, max = 20.0, stretch = \"Fixed\" } }\nchildren = [{ child = \"toolbar_title_text\" }]\n\n[nodes.toolbar_subtitle_text]\nkind = \"native\"\ntype = \"Label\"\ncontrol_id = \"AssetBrowserSubtitleText\"\nprops = { text = \"Project/assets\", text_tone = \"muted\", font_size = 9.0, overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_subtitle_row]\nkind = \"native\"\ntype = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserToolbarSubtitleRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = 10.0, preferred = 10.0, max = 10.0, stretch = \"Fixed\" } }\nchildren = [{ child = \"toolbar_subtitle_text\" }]\n\n[nodes.toolbar_search_field]\nkind = \"native\"\ntype = \"TextField\"\ncontrol_id = \"SearchEdited\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_search_row]\nkind = \"native\"\ntype = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserToolbarSearchRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nchildren = [{ child = \"toolbar_search_field\" }]\n\n[nodes.toolbar_kind_all_chip]\nkind = \"native\"\ntype = \"Button\"\ncontrol_id = \"AssetBrowserKindAllChip\"\nprops = { text = \"All\" }\nlayout = { width = { min = 44.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_kind_texture_chip]\nkind = \"native\"\ntype = \"Button\"\ncontrol_id = \"AssetBrowserKindTextureChip\"\nprops = { text = \"Texture\" }\nlayout = { width = { min = 78.0, preferred = 78.0, max = 78.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_kind_material_chip]\nkind = \"native\"\ntype = \"Button\"\ncontrol_id = \"AssetBrowserKindMaterialChip\"\nprops = { text = \"Material\" }\nlayout = { width = { min = 84.0, preferred = 84.0, max = 84.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_kind_scene_chip]\nkind = \"native\"\ntype = \"Button\"\ncontrol_id = \"AssetBrowserKindSceneChip\"\nprops = { text = \"Scene\" }\nlayout = { width = { min = 64.0, preferred = 64.0, max = 64.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_kind_model_chip]\nkind = \"native\"\ntype = \"Button\"\ncontrol_id = \"AssetBrowserKindModelChip\"\nprops = { text = \"Model\" }\nlayout = { width = { min = 64.0, preferred = 64.0, max = 64.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_kind_shader_chip]\nkind = \"native\"\ntype = \"Button\"\ncontrol_id = \"AssetBrowserKindShaderChip\"\nprops = { text = \"Shader\" }\nlayout = { width = { min = 72.0