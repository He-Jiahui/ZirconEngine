penpot_original_source = "[asset]\r\nkind = \"view\"\r\nid = \"sound.audio_listener.drawer\"\r\nversion = 2\r\ndisplay_name = \"AudioListener\"\r\n\r\n[imports]\r\nstyles = [\"res://ui/theme/editor_base.zui\"]\r\n\r\n[root]\r\nnode = \"sound_audio_listener_drawer_root\"\r\n\r\n[nodes.sound_listener_active_target_row]\r\ncomponent = \"Space\"\r\ncontrol_id = \"SoundListenerActiveTargetRow\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.sound_listener_pose_row]\r\ncomponent = \"Space\"\r\ncontrol_id = \"SoundListenerPoseRow\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 52.0, preferred = 52.0, max = 52.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.sound_listener_ear_offsets_row]\r\ncomponent = \"Space\"\r\ncontrol_id = \"SoundListenerEarOffsetsRow\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 52.0, preferred = 52.0, max = 52.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.sound_listener_hrtf_doppler_row]\r\ncomponent = \"Space\"\r\ncontrol_id = \"SoundListenerHrtfDopplerRow\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 52.0, preferred = 52.0, max = 52.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.sound_audio_listener_drawer_root]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"SoundAudioListenerDrawerRoot\"\r\nclasses = [\"editor-shell\"]\r\nlayout = { container = { kind = \"VerticalBox\", gap = 4.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"sound_listener_active_target_row\" }, { node = \"sound_listener_pose_row\" }, { node = \"sound_listener_ear_offsets_row\" }, { node = \"sound_listener_hrtf_doppler_row\" }]\r\n"

[asset]
kind = "view"
id = "sound.audio_listener.drawer"
version = 2
display_name = "AudioListener"

[imports]
styles = [ "res://ui/theme/editor_base.zui" ]

[root]
node = "sound_audio_listener_drawer_root"

[nodes.sound_listener_active_target_row]
component = "Space"
control_id = "SoundListenerActiveTargetRow"

[nodes.sound_listener_active_target_row.layout.width]
stretch = "Stretch"

[nodes.sound_listener_active_target_row.layout.height]
min = 26
preferred = 26
max = 26
stretch = "Fixed"

[nodes.sound_listener_pose_row]
component = "Space"
control_id = "SoundListenerPoseRow"

[nodes.sound_listener_pose_row.layout.width]
