classes = [ "editor-shell" ]

[nodes.sound_audio_listener_drawer_root.layout.container]
kind = "VerticalBox"
gap = 4

[nodes.sound_audio_listener_drawer_root.layout.width]
stretch = "Stretch"

[nodes.sound_audio_listener_drawer_root.layout.height]
stretch = "Stretch"

[[nodes.sound_audio_listener_drawer_root.children]]
