[nodes.sound_listener_ear_offsets_row.layout.width]
stretch = "Stretch"

[nodes.sound_listener_ear_offsets_row.layout.height]
min = 52
preferred = 52
max = 52
stretch = "Fixed"

[nodes.sound_listener_hrtf_doppler_row]
