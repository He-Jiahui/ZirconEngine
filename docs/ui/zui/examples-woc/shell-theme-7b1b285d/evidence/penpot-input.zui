penpot_dependency_sources = [ "examples/woc/assets/ui/shell/auth_form.zui", "examples/woc/assets/ui/shell/character_create.zui" ]
penpot_original_source = "[asset]\nkind = \"style\"\nid = \"res://ui/shell/shell_theme.zui\"\nversion = 2\ndisplay_name = \"World of ClaudeCraft Shell Theme\"\n\n[imports]\nwidgets = []\nstyles = []\n\n[tokens]\nwoc_shell_bg = \"#10121f\"\nwoc_shell_scrim = \"#00000066\"\nwoc_panel_bg = \"#11101ddd\"\nwoc_panel_bg_strong = \"#0d0d16ee\"\nwoc_border = \"#6f5a2a\"\nwoc_border_soft = \"#3b3547\"\nwoc_gold = \"#ffd100\"\nwoc_gold_dim = \"#c8a94d\"\nwoc_gold_light = \"#ffe46b\"\nwoc_control_hover = \"#282737\"\nwoc_control_pressed = \"#3a3018\"\nwoc_control_disabled = \"#1b1a24\"\nwoc_text = \"#f4ead3\"\nwoc_text_muted = \"#998d6a\"\nwoc_input_bg = \"#10101acc\"\nwoc_discord = \"#5865f2\"\nwoc_discord_border = \"#3c46b0\"\nwoc_success = \"#9fdc7f\"\nwoc_error = \"#e06c75\"\nwoc_shadow = \"#00000073\"\n\n[[stylesheets]]\nid = \"woc-shell\"\n\n[[stylesheets.rules]]\nselector = \".woc-shell\"\nset = { self = { background = { color = \"$woc_shell_bg\" }, foreground = { color = \"$woc_text\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-stage-scrim\"\nset = { self = { background = { color = \"$woc_shell_scrim\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-panel\"\nset = { self = { background = { color = \"$woc_panel_bg\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-panel-strong\"\nset = { self = { background = { color = \"$woc_panel_bg_strong\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-screen-title\"\nset = { self = { foreground = { color = \"$woc_gold\" }, font = { size = 22.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-welcome-title\"\nset = { self = { foreground = { color = \"$woc_gold\" }, font = { size = 27.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-section-title\"\nset = { self = { foreground = { color = \"$woc_gold_dim\" }, font = { size = 15.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-label\"\nset = { self = { foreground = { color = \"$woc_text\" }, font = { size = 14.0, weight = 600.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-muted\"\nset = { self = { foreground = { color = \"$woc_text_muted\" }, font = { size = 12.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-error\"\nset = { self = { foreground = { color = \"$woc_error\" }, font = { size = 12.0, weight = 600.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-input\"\nset = { self = { background = { color = \"$woc_input_bg\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 5.0 }, font = { size = 14.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-input:hover\"\nset = { self = { border = { color = \"$woc_gold_dim\", width = 1.0, radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-input:focus\"\nset = { self = { border = { color = \"$woc_gold\", width = 2.0, radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-input:disabled\"\nset = { self = { background = { color = \"$woc_control_disabled\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-class-button\"\nset = { self = { background = { color = \"#11101d00\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 2.0, radius = 31.0 }, font = { size = 12.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-class-button:hover\"\nset = { self = { foreground = { color = \"$woc_text\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 31.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-class-button:pressed\"\nset = { self = { background = { color = \"$woc_control_pressed\" }, foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 31.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-class-button:focus\"\nset = { self = { border = { color = \"$woc_gold_light\", width = 3.0, radius = 31.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-class-button:checked\"\nset = { self = { foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold\", width = 3.0, radius = 31.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-class-button:selected\"\nset = { self = { foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold\", width = 3.0, radius = 31.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-class-button:disabled\"\nset = { self = { background = { color = \"$woc_control_disabled\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 31.0 } } }\n\n[[stylesheets.rules]]\nselector = \".class-warrior\"\nset = { self = { foreground = { color = \"#c79c6e\" } } }\n\n[[stylesheets.rules]]\nselector = \".class-paladin\"\nset = { self = { foreground = { color = \"#f58cba\" } } }\n\n[[stylesheets.rules]]\nselector = \".class-hunter\"\nset = { self = { foreground = { color = \"#abd473\" } } }\n\n[[stylesheets.rules]]\nselector = \".class-rogue\"\nset = { self = { foreground = { color = \"#fff569\" } } }\n\n[[stylesheets.rules]]\nselector = \".class-priest\"\nset = { self = { foreground = { color = \"#fffff0\" } } }\n\n[[stylesheets.rules]]\nselector = \".class-shaman\"\nset = { self = { foreground = { color = \"#0070de\" } } }\n\n[[stylesheets.rules]]\nselector = \".class-mage\"\nset = { self = { foreground = { color = \"#69ccf0\" } } }\n\n[[stylesheets.rules]]\nselector = \".class-warlock\"\nset = { self = { foreground = { color = \"#9482c9\" } } }\n\n[[stylesheets.rules]]\nselector = \".class-druid\"\nset = { self = { foreground = { color = \"#ff7d0a\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-skin-swatch\"\nset = { self = { background = { color = \"$woc_panel_bg_strong\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 2.0, radius = 8.0 }, font = { size = 12.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-skin-swatch:hover\"\nset = { self = { background = { color = \"$woc_control_hover\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-skin-swatch:pressed\"\nset = { self = { background = { color = \"$woc_control_pressed\" }, foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-skin-swatch:focus\"\nset = { self = { border = { color = \"$woc_gold_light\", width = 3.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-skin-swatch:checked\"\nset = { self = { foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold\", width = 3.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-skin-swatch:selected\"\nset = { self = { foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold\", width = 3.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-skin-swatch:disabled\"\nset = { self = { background = { color = \"$woc_control_disabled\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-primary-action\"\nset = { self = { background = { color = \"$woc_gold\" }, foreground = { color = \"#1a1608\" }, border = { color = \"$woc_border\", width = 1.0, radius = 6.0 }, font = { size = 16.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-primary-action:hover\"\nset = { self = { background = { color = \"$woc_gold_light\" }, border = { color = \"$woc_gold\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-primary-action:pressed\"\nset = { self = { background = { color = \"$woc_gold_dim\" }, border = { color = \"$woc_border\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-primary-action:focus\"\nset = { self = { border = { color = \"$woc_text\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-primary-action:disabled\"\nset = { self = { background = { color = \"#242431\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-secondary-action\"\nset = { self = { background = { color = \"$woc_panel_bg_strong\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border\", width = 1.0, radius = 6.0 }, font = { size = 14.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-secondary-action:hover\"\nset = { self = { background = { color = \"$woc_control_hover\" }, border = { color = \"$woc_gold_dim\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-secondary-action:pressed\"\nset = { self = { background = { color = \"$woc_control_pressed\" }, foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold_dim\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-secondary-action:focus\"\nset = { self = { border = { color = \"$woc_gold_light\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-secondary-action:disabled\"\nset = { self = { background = { color = \"$woc_control_disabled\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-discord-strip\"\nset = { self = { background = { color = \"$woc_panel_bg\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_discord\", width = 1.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-discord-badge\"\nset = { self = { background = { color = \"$woc_discord\" }, border = { color = \"$woc_discord_border\", width = 1.0, radius = 10.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-discord-action\"\nset = { self = { background = { color = \"$woc_discord\" }, foreground = { color = \"#ffffff\" }, border = { color = \"$woc_discord_border\", width = 1.0, radius = 5.0 }, font = { size = 13.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-ready-dot\"\nset = { self = { background = { color = \"$woc_success\" }, border = { color = \"$woc_success\", width = 1.0, radius = 4.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-preview-host\"\nset = { self = { background = { color = \"#090a12aa\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-roster-host\"\nset = { self = { background = { color = \"#090a1299\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-roster-row:selected\"\nset = { self = { background = { color = \"#3a301880\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-modal-card\"\nset = { self = { background = { color = \"$woc_panel_bg_strong\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border\", width = 2.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-danger-action\"\nset = { self = { background = { color = \"$woc_error\" }, foreground = { color = \"#ffffff\" }, border = { color = \"#8f343b\", width = 1.0, radius = 6.0 }, font = { size = 14.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-danger-action:disabled\"\nset = { self = { background = { color = \"#2b252d\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-mode-trigger\"\nset = { self = { background = { color = \"$woc_input_bg\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border\", width = 1.0, radius = 6.0 }, font = { size = 16.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-mode-option\"\nset = { self = { background = { color = \"#11101d00\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 5.0 }, font = { size = 15.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-mode-option:selected\"\nset = { self = { background = { color = \"#3a301880\" }, foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-play-action\"\nset = { self = { background = { color = \"$woc_gold\" }, foreground = { color = \"#1a1608\" }, border = { color = \"#fff2a8\", width = 2.0, radius = 6.0 }, font = { size = 20.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-contract-address\"\nset = { self = { background = { color = \"#090a12aa\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_gold_dim\", width = 1.0, radius = 6.0 }, font = { size = 11.0, weight = 600.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-auth-form\"\nset = { self = { border = { color = \"$woc_border\", width = 1.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-auth-link\"\nset = { self = { background = { color = \"#00000000\" }, foreground = { color = \"$woc_gold_dim\" }, border = { color = \"#00000000\", width = 1.0, radius = 4.0 }, font = { size = 14.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-auth-link:hover\"\nset = { self = { foreground = { color = \"$woc_gold_light\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-auth-link:pressed\"\nset = { self = { background = { color = \"$woc_control_pressed\" }, foreground = { color = \"$woc_gold\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-auth-link:focus\"\nset = { self = { border = { color = \"$woc_gold_light\", width = 2.0, radius = 4.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-auth-link:disabled\"\nset = { self = { background = { color = \"#00000000\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"#00000000\", width = 1.0, radius = 4.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-auth-provider-host\"\nset = { self = { background = { color = \"#090a1299\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-auth-status\"\nset = { self = { foreground = { color = \"$woc_text_muted\" }, font = { size = 12.0, weight = 600.0 } } }\n"

[asset]
kind = "style"
id = "res://ui/shell/shell_theme.zui"
version = 2
display_name = "World of ClaudeCraft Shell Theme"

[imports]
widgets = []
styles = []

[tokens]
woc_shell_bg = "#10121f"
woc_shell_scrim = "#00000066"
woc_panel_bg = "#11101ddd"
woc_panel_bg_strong = "#0d0d16ee"
woc_border = "#6f5a2a"
woc_border_soft = "#3b3547"
woc_gold = "#ffd100"
woc_gold_dim = "#c8a94d"
woc_gold_light = "#ffe46b"
woc_control_hover = "#282737"
woc_control_pressed = "#3a3018"
woc_control_disabled = "#1b1a24"
woc_text = "#f4ead3"
woc_text_muted = "#998d6a"
woc_input_bg = "#10101acc"
woc_discord = "#5865f2"
woc_discord_border = "#3c46b0"
woc_success = "#9fdc7f"
woc_error = "#e06c75"
woc_shadow = "#00000073"

[[stylesheets]]
id = "woc-shell"

[[stylesheets.rules]]
selector = ".woc-shell"

[stylesheets.rules.set.self.background]
color = "$woc_shell_bg"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[[stylesheets.rules]]
selector = ".woc-stage-scrim"

[stylesheets.rules.set.self.background]
color = "$woc_shell_scrim"

[[stylesheets.rules]]
selector = ".woc-panel"

[stylesheets.rules.set.self.background]
color = "$woc_panel_bg"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[stylesheets.rules.set.self.border]
color = "$woc_border_soft"
width = 1
radius = 8

[[stylesheets.rules]]
selector = ".woc-panel-strong"

[stylesheets.rules.set.self.background]
color = "$woc_panel_bg_strong"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[stylesheets.rules.set.self.border]
color = "$woc_border_soft"
width = 1
radius = 8

[[stylesheets.rules]]
selector = ".woc-screen-title"

[stylesheets.rules.set.self.foreground]
color = "$woc_gold"

[stylesheets.rules.set.self.font]
size = 22
weight = 700

[[stylesheets.rules]]
selector = ".woc-welcome-title"

[stylesheets.rules.set.self.foreground]
color = "$woc_gold"

[stylesheets.rules.set.self.font]
size = 27
weight = 700

[[stylesheets.rules]]
selector = ".woc-section-title"

[stylesheets.rules.set.self.foreground]
color = "$woc_gold_dim"

[stylesheets.rules.set.self.font]
size = 15
weight = 700

[[stylesheets.rules]]
selector = ".woc-label"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[stylesheets.rules.set.self.font]
size = 14
weight = 600

[[stylesheets.rules]]
selector = ".woc-muted"

[stylesheets.rules.set.self.foreground]
color = "$woc_text_muted"

[stylesheets.rules.set.self.font]
size = 12

[[stylesheets.rules]]
selector = ".woc-error"

[stylesheets.rules.set.self.foreground]
color = "$woc_error"

[stylesheets.rules.set.self.font]
size = 12
weight = 600

[[stylesheets.rules]]
selector = ".woc-input"

[stylesheets.rules.set.self.background]
color = "$woc_input_bg"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[stylesheets.rules.set.self.border]
color = "$woc_border_soft"
width = 1
radius = 5

[stylesheets.rules.set.self.font]
size = 14

[[stylesheets.rules]]
selector = ".woc-input:hover"

[stylesheets.rules.set.self.border]
color = "$woc_gold_dim"
width = 1
radius = 5

[[stylesheets.rules]]
selector = ".woc-input:focus"

[stylesheets.rules.set.self.border]
color = "$woc_gold"
width = 2
radius = 5

[[stylesheets.rules]]
selector = ".woc-input:disabled"

[stylesheets.rules.set.self.background]
color = "$woc_control_disabled"

[stylesheets.rules.set.self.foreground]
color = "$woc_text_muted"

[stylesheets.rules.set.self.border]
color = "$woc_border_soft"
width = 1
radius = 5

[[stylesheets.rules]]
selector = ".woc-class-button"

[stylesheets.rules.set.self.background]
color = "#11101d00"

[stylesheets.rules.set.self.foreground]
color = "$woc_text_muted"

[stylesheets.rules.set.self.border]
color = "$woc_border_soft"
width = 2
radius = 31

[stylesheets.rules.set.self.font]
size = 12
weight = 700

