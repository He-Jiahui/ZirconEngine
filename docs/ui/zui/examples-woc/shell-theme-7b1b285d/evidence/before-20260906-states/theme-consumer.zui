[asset]
kind = "view"
version = 2
id = "res://ui/shell/shell_theme.zui#review-host"
display_name = "World of ClaudeCraft Shell Theme"

[imports]
widgets = []
styles = [ "res://ui/shell/shell_theme.zui" ]

[root]
node = "review_theme_host"

[nodes.review_theme_host]
component = "Overlay"
classes = [ "woc-shell" ]

[nodes.review_theme_host.layout.container]
kind = "Overlay"

[nodes.review_theme_host.layout.width]
stretch = "Stretch"

[nodes.review_theme_host.layout.height]
stretch = "Stretch"

[[nodes.review_theme_host.children]]
node = "review_theme_title"

[[nodes.review_theme_host.children]]
node = "sample_0_label"

[[nodes.review_theme_host.children]]
node = "sample_0"

[[nodes.review_theme_host.children]]
node = "sample_1_label"

[[nodes.review_theme_host.children]]
node = "sample_1"

[[nodes.review_theme_host.children]]
node = "sample_2_label"

[[nodes.review_theme_host.children]]
node = "sample_2"

[[nodes.review_theme_host.children]]
node = "sample_3_label"

[[nodes.review_theme_host.children]]
node = "sample_3"

[[nodes.review_theme_host.children]]
node = "sample_4_label"

[[nodes.review_theme_host.children]]
node = "sample_4"

[[nodes.review_theme_host.children]]
node = "sample_5_label"

[[nodes.review_theme_host.children]]
node = "sample_5"

[nodes.review_theme_title]
component = "Label"
classes = [ "woc-screen-title" ]

[nodes.review_theme_title.props]
text = "World of ClaudeCraft Shell Theme"

[nodes.review_theme_title.layout.position]
x = 32
y = 24

[nodes.review_theme_title.layout.width]
preferred = 800
stretch = "Fixed"

[nodes.review_theme_title.layout.height]
preferred = 40
stretch = "Fixed"

[nodes.sample_0_label]
