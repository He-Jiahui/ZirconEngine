penpot_dependency_sources = [ "examples/woc/assets/ui/shell/shell_theme.zui" ]
penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/shell/realm_select.zui\"\nversion = 2\ndisplay_name = \"World of ClaudeCraft Realm Directory\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/shell/shell_theme.zui\"]\nresources = [\n  { kind = \"image\", uri = \"res://m8/env/vale_backdrop.webp\", fallback = { mode = \"optional\" } },\n]\n\n[root]\nnode = \"realm_select_root\"\n\n[nodes.stage_scrim]\ncomponent = \"Space\"\nclasses = [\"woc-stage-scrim\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.title_label]\ncomponent = \"Label\"\nclasses = [\"woc-screen-title\"]\nprops = { text = \"World List\" }\nlayout = { width = { min = 120.0, preferred = 150.0, max = 180.0, stretch = \"Fixed\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.account_name]\ncomponent = \"Label\"\ncontrol_id = \"RealmDirectoryAccountName\"\nclasses = [\"woc-section-title\"]\nprops = { text = \"\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.title_row]\ncomponent = \"HorizontalBox\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"title_label\" }, { node = \"account_name\" }]\n\n[nodes.loading]\ncomponent = \"Label\"\ncontrol_id = \"RealmDirectoryLoading\"\nclasses = [\"woc-muted\"]\nprops = { text = \"Loading worlds...\", text_align = \"center\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" } }\n\n[nodes.empty]\ncomponent = \"Label\"\ncontrol_id = \"RealmDirectoryEmpty\"\nclasses = [\"woc-muted\"]\nprops = { text = \"No worlds are available\", text_align = \"center\", visibility = \"collapsed\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" } }\n\n[nodes.error]\ncomponent = \"Label\"\ncontrol_id = \"RealmDirectoryError\"\nclasses = [\"woc-error\"]\nprops = { text = \"\", text_align = \"center\", visibility = \"collapsed\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 48.0, stretch = \"Fixed\" } }\n\n[nodes.realm_list_host]\ncomponent = \"ScrollBox\"\ncontrol_id = \"RealmDirectoryListHost\"\nclasses = [\"woc-roster-host\"]\nprops = { scroll_axis = \"vertical\", scroll_x = false, scroll_y = true, show_scrollbars = true, clip_content = true, dynamic_route_prefix = \"woc.shell.realms.row\", row_fields = [\"name\", \"type\", \"character_count\", \"status\", \"population\", \"recommended\"] }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 160.0, preferred = 420.0, max = 640.0, stretch = \"Stretch\" } }\n\n[nodes.back]\ncomponent = \"Button\"\ncontrol_id = \"RealmDirectoryBack\"\nclasses = [\"woc-secondary-action\"]\nprops = { text = \"Back\", button_variant = \"outlined\" }\nlayout = { width = { min = 120.0, preferred = 160.0, max = 220.0, stretch = \"Fixed\" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WocRealms/Back\", event = \"Click\", route = \"woc.shell.realms.back\" }]\n\n[nodes.panel]\ncomponent = \"VerticalBox\"\ncontrol_id = \"RealmDirectoryPanel\"\nclasses = [\"woc-panel-strong\"]\nlayout = { container = { kind = \"VerticalBox\", gap = 12.0 }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.5 }, padding = { left = 18.0, right = 18.0, top = 18.0, bottom = 18.0 }, width = { min = 300.0, preferred = 720.0, max = 860.0, stretch = \"Stretch\" }, height = { min = 300.0, preferred = 600.0, max = 760.0, stretch = \"Stretch\" } }\nchildren = [{ node = \"title_row\" }, { node = \"loading\" }, { node = \"empty\" }, { node = \"error\" }, { node = \"realm_list_host\" }, { node = \"back\" }]\n\n[nodes.realm_select_root]\ncomponent = \"Overlay\"\ncontrol_id = \"RealmDirectory\"\nclasses = [\"woc-shell\", \"woc-realm-directory\"]\nprops = { background_image = \"res://m8/env/vale_backdrop.webp\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"stage_scrim\" }, { node = \"panel\" }]\n"

[asset]
kind = "view"
id = "res://ui/shell/realm_select.zui"
version = 2
display_name = "World of ClaudeCraft Realm Directory"

[imports]
widgets = []
styles = []

[[imports.resources]]
kind = "image"
uri = "res://m8/env/vale_backdrop.webp"

[imports.resources.fallback]
mode = "optional"

[root]
node = "realm_select_root"

[nodes.stage_scrim]
component = "Space"
classes = [ "woc-stage-scrim" ]

[nodes.stage_scrim.layout.width]
stretch = "Stretch"

[nodes.stage_scrim.layout.height]
stretch = "Stretch"

[nodes.title_label]
component = "Label"
classes = [ "woc-screen-title" ]

[nodes.title_label.props]
text = "World List"

[nodes.title_label.layout.width]
min = 120
preferred = 150
max = 180
stretch = "Fixed"

[nodes.title_label.layout.height]
min = 32
preferred = 32
max = 32
stretch = "Fixed"

[nodes.account_name]
component = "Label"
control_id = "RealmDirectoryAccountName"
classes = [ "woc-section-title" ]

[nodes.account_name.props]
text = ""

[nodes.account_name.layout.width]
stretch = "Stretch"

[nodes.account_name.layout.height]
min = 32
preferred = 32
max = 32
stretch = "Fixed"

[nodes.title_row]
component = "HorizontalBox"

[nodes.title_row.layout.container]
kind = "HorizontalBox"
gap = 8

[nodes.title_row.layout.width]
stretch = "Stretch"

[nodes.title_row.layout.height]
min = 32
preferred = 32
max = 32
stretch = "Fixed"

[[nodes.title_row.children]]
node = "title_label"

[[nodes.title_row.children]]
node = "account_name"

[nodes.loading]
component = "Label"
control_id = "RealmDirectoryLoading"
classes = [ "woc-muted" ]

[nodes.loading.props]
text = "Loading worlds..."
text_align = "center"

[nodes.loading.layout.width]
stretch = "Stretch"

[nodes.loading.layout.height]
min = 44
preferred = 44
max = 44
stretch = "Fixed"

[nodes.empty]
component = "Label"
control_id = "RealmDirectoryEmpty"
classes = [ "woc-muted" ]

[nodes.empty.props]
text = "No worlds are available"
text_align = "center"
visibility = "collapsed"

[nodes.empty.layout.width]
stretch = "Stretch"

[nodes.empty.layout.height]
min = 44
preferred = 44
max = 44
stretch = "Fixed"

[nodes.error]
component = "Label"
control_id = "RealmDirectoryError"
classes = [ "woc-error" ]

[nodes.error.props]
text = ""
text_align = "center"
visibility = "collapsed"

[nodes.error.layout.width]
stretch = "Stretch"

[nodes.error.layout.height]
min = 24
preferred = 24
max = 48
stretch = "Fixed"

[nodes.realm_list_host]
component = "ScrollBox"
control_id = "RealmDirectoryListHost"
classes = [ "woc-roster-host" ]

[nodes.realm_list_host.props]
scroll_axis = "vertical"
scroll_x = false
scroll_y = true
show_scrollbars = true
clip_content = true
dynamic_route_prefix = "woc.shell.realms.row"
row_fields = [ "name", "type", "character_count", "status", "population", "recommended" ]

[nodes.realm_list_host.layout.container]
kind = "VerticalBox"
gap = 8

[nodes.realm_list_host.layout.width]
stretch = "Stretch"

[nodes.realm_list_host.layout.height]
min = 160
preferred = 420
max = 640
stretch = "Stretch"

[nodes.back]
component = "Button"
control_id = "RealmDirectoryBack"
classes = [ "woc-secondary-action" ]

[nodes.back.props]
text = "Back"
button_variant = "outlined"

[nodes.back.layout.width]
min = 120
preferred = 160
max = 220
stretch = "Fixed"

[nodes.back.layout.height]
min = 44
preferred = 44
max = 44
stretch = "Fixed"

[[nodes.back.events]]
id = "WocRealms/Back"
event = "Click"
route = "woc.shell.realms.back"

[nodes.panel]
component = "VerticalBox"
control_id = "RealmDirectoryPanel"
classes = [ "woc-panel-strong" ]

[nodes.panel.layout.container]
kind = "VerticalBox"
gap = 12

[nodes.panel.layout.anchor]
x = 0.5
y = 0.5

[nodes.panel.layout.pivot]
x = 0.5
y = 0.5

[nodes.panel.layout.padding]
left = 18
right = 18
top = 18
bottom = 18

[nodes.panel.layout.width]
min = 300
preferred = 720
max = 860
stretch = "Stretch"

[nodes.panel.layout.height]
min = 300
preferred = 600
max = 760
stretch = "Stretch"

[[nodes.panel.children]]
node = "title_row"

[[nodes.panel.children]]
node = "loading"

[[nodes.panel.children]]
node = "empty"

[[nodes.panel.children]]
node = "error"

[[nodes.panel.children]]
node = "realm_list_host"

[[nodes.panel.children]]
node = "back"

[nodes.realm_select_root]
component = "Overlay"
control_id = "RealmDirectory"
classes = [ "woc-shell", "woc-realm-directory" ]

[nodes.realm_select_root.props]
background_image = "res://m8/env/vale_backdrop.webp"

[nodes.realm_select_root.layout]
clip = true

[nodes.realm_select_root.layout.container]
kind = "Overlay"

[nodes.realm_select_root.layout.width]
stretch = "Stretch"

[nodes.realm_select_root.layout.height]
stretch = "Stretch"

[[nodes.realm_select_root.children]]
node = "stage_scrim"

[[nodes.realm_select_root.children]]
node = "panel"

[nodes.realm_select_root.penpot_image]
uri = "res://m8/env/vale_backdrop.webp"
name = "vale_backdrop.webp"
mime = "image/webp"
base64 = ""

[tokens]
woc_shell_bg = "#10121f"
woc_shell_scrim = "#00000066"
woc_panel_bg = "#11101ddd"
woc_panel_bg_strong = "#0d0d16ee"
woc_border = "#6f5a2a"
woc_border_soft = "#3b3547"
woc_gold = "#ffd100"
woc_gold_dim = "#c8a94d"
woc_gold_light = "#ffe46b"
woc_control_hover = "#282737"
woc_control_pressed = "#3a3018"
woc_control_disabled = "#1b1a24"
woc_text = "#f4ead3"
woc_text_muted = "#998d6a"
woc_input_bg = "#10101acc"
woc_discord = "#5865f2"
woc_discord_border = "#3c46b0"
woc_success = "#9fdc7f"
woc_error = "#e06c75"
woc_shadow = "#00000073"

[[stylesheets]]
id = "woc-shell"

[[stylesheets.rules]]
selector = ".woc-shell"

[stylesheets.rules.set.self.background]
color = "$woc_shell_bg"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[[stylesheets.rules]]
selector = ".woc-stage-scrim"

[stylesheets.rules.set.self.background]
color = "$woc_shell_scrim"

[[stylesheets.rules]]
selector = ".woc-panel"

[stylesheets.rules.set.self.background]
color = "$woc_panel_bg"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[stylesheets.rules.set.self.border]
color = "$woc_border_soft"
width = 1
radius = 8

