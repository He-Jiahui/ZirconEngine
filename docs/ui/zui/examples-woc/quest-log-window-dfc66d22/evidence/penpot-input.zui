penpot_dependency_sources = [ "examples/woc/assets/ui/shell/shell_theme.zui", "examples/woc/assets/ui/hud/hud_theme.zui" ]
penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/windows/quest_log_window.zui\"\nversion = 2\ndisplay_name = \"World of ClaudeCraft Quest Log Window\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/shell/shell_theme.zui\", \"res://ui/hud/hud_theme.zui\"]\nresources = []\n\n[root]\nnode = \"quest_root\"\n\n[nodes.quest_title]\ncomponent = \"Label\"\ncontrol_id = \"QuestLogTitle\"\nclasses = [\"woc-screen-title\"]\nprops = { text = \"Quest Log\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.quest_summary]\ncomponent = \"Label\"\ncontrol_id = \"QuestLogSummary\"\nclasses = [\"woc-muted\"]\nprops = { text = \"0 active / 0 completed\", text_align = \"right\" }\nlayout = { width = { min = 160.0, preferred = 220.0, max = 260.0, stretch = \"Fixed\" }, height = { min = 24.0, preferred = 24.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.quest_close]\ncomponent = \"Button\"\ncontrol_id = \"QuestLogClose\"\nclasses = [\"woc-secondary-action\"]\nprops = { text = \"Close\" }\nlayout = { width = { min = 64.0, preferred = 72.0, max = 88.0, stretch = \"Fixed\" }, height = { min = 40.0, preferred = 40.0, max = 44.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WocQuestLog/Close\", event = \"Click\", route = \"woc.window.quest_log.close\" }]\n\n[nodes.quest_header]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"QuestLogHeader\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 10.0 }, width = { stretch = \"Stretch\" }, height = { min = 40.0, preferred = 40.0, max = 44.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"quest_title\" }, { node = \"quest_summary\" }, { node = \"quest_close\" }]\n\n[nodes.quest_desktop_list_host]\ncomponent = \"VerticalBox\"\ncontrol_id = \"QuestDesktopListHost\"\nlayout = { container = { kind = \"VerticalBox\", gap = 4.0 }, width = { stretch = \"Stretch\" }, height = { min = 360.0, preferred = 500.0, max = 660.0, stretch = \"Stretch\" } }\nchildren = []\n\n[nodes.quest_desktop_empty]\ncomponent = \"Label\"\ncontrol_id = \"QuestDesktopEmpty\"\nclasses = [\"woc-muted\"]\nprops = { text = \"Your quest log is empty.\", visibility = \"collapsed\", overflow = \"wrap\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 60.0, preferred = 80.0, max = 100.0, stretch = \"Fixed\" } }\n\n[nodes.quest_desktop_list]\ncomponent = \"ScrollBox\"\ncontrol_id = \"QuestDesktopList\"\nclasses = [\"woc-panel-strong\"]\nprops = { scroll_axis = \"vertical\", scroll_x = false, scroll_y = true, show_scrollbars = true, clip_content = true }\nlayout = { container = { kind = \"VerticalBox\", gap = 6.0 }, padding = { left = 8.0, right = 8.0, top = 8.0, bottom = 8.0 }, width = { min = 260.0, preferred = 300.0, max = 340.0, stretch = \"Fixed\" }, height = { min = 440.0, preferred = 580.0, max = 720.0, stretch = \"Stretch\" } }\nchildren = [{ node = \"quest_desktop_list_host\" }, { node = \"quest_desktop_empty\" }]\n\n[nodes.quest_desktop_detail_title]\ncomponent = \"Label\"\ncontrol_id = \"QuestDesktopDetailTitle\"\nclasses = [\"woc-screen-title\"]\nprops = { text = \"\", overflow = \"wrap\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 40.0, max = 72.0, stretch = \"Fixed\" } }\n\n[nodes.quest_desktop_group]\ncomponent = \"Label\"\ncontrol_id = \"QuestDesktopGroupHint\"\nclasses = [\"woc-muted\"]\nprops = { text = \"\", visibility = \"collapsed\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 22.0, preferred = 22.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.quest_desktop_narrative]\ncomponent = \"Label\"\ncontrol_id = \"QuestDesktopNarrative\"\nclasses = [\"woc-label\"]\nprops = { text = \"\", overflow = \"wrap\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 72.0, preferred = 104.0, max = 180.0, stretch = \"Fixed\" } }\n\n[nodes.quest_desktop_objectives_title]\ncomponent = \"Label\"\nclasses = [\"woc-section-title\"]\nprops = { text = \"Objectives\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.quest_desktop_objectives]\ncomponent = \"VerticalBox\"\ncontrol_id = \"QuestDesktopObjectiveHost\"\nlayout = { container = { kind = \"VerticalBox\", gap = 6.0 }, width = { stretch = \"Stretch\" }, height = { min = 80.0, preferred = 132.0, max = 240.0, stretch = \"Fixed\" } }\nchildren = []\n\n[nodes.quest_desktop_rewards_title]\ncomponent = \"Label\"\nclasses = [\"woc-section-title\"]\nprops = { text = \"Rewards\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.quest_desktop_rewards]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"QuestDesktopRewardHost\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 52.0, preferred = 64.0, max = 88.0, stretch = \"Fixed\" } }\nchildren = []\n\n[nodes.quest_desktop_turn_in]\ncomponent = \"Label\"\ncontrol_id = \"QuestDesktopTurnIn\"\nclasses = [\"woc-muted\"]\nprops = { text = \"\", overflow = \"wrap\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 36.0, max = 56.0, stretch = \"Fixed\" } }\n\n[nodes.quest_desktop_abandon]\ncomponent = \"Button\"\ncontrol_id = \"QuestDesktopAbandon\"\nclasses = [\"woc-secondary-action\"]\nprops = { text = \"Abandon\" }\nlayout = { width = { min = 92.0, preferred = 108.0, max = 132.0, stretch = \"Fixed\" }, height = { min = 40.0, preferred = 40.0, max = 44.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WocQuestLog/DesktopAbandon\", event = \"Click\", route = \"woc.window.quest_log.abandon\" }]\n\n[nodes.quest_desktop_share]\ncomponent = \"Button\"\ncontrol_id = \"QuestDesktopShare\"\nclasses = [\"woc-primary-action\"]\nprops = { text = \"Share\" }\nlayout = { width = { min = 84.0, preferred = 96.0, max = 120.0, stretch = \"Fixed\" }, height = { min = 40.0, preferred = 40.0, max = 44.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WocQuestLog/DesktopShare\", event = \"Click\", route = \"woc.window.quest_log.share\" }]\n\n[nodes.quest_desktop_actions]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"QuestDesktopActions\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 40.0, preferred = 40.0, max = 44.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"quest_desktop_abandon\" }, { node = \"quest_desktop_share\" }]\n\n[nodes.quest_desktop_detail]\ncomponent = \"ScrollBox\"\ncontrol_id = \"QuestDesktopDetail\"\nclasses = [\"woc-panel-strong\"]\nprops = { scroll_axis = \"vertical\", scroll_x = false, scroll_y = true, show_scrollbars = true, clip_content = true }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, padding = { left = 14.0, right = 14.0, top = 12.0, bottom = 12.0 }, width = { min = 360.0, preferred = 500.0, max = 620.0, stretch = \"Stretch\" }, height = { min = 440.0, preferred = 580.0, max = 720.0, stretch = \"Stretch\" } }\nchildren = [{ node = \"quest_desktop_detail_title\" }, { node = \"quest_desktop_group\" }, { node = \"quest_desktop_narrative\" }, { node = \"quest_desktop_objectives_title\" }, { node = \"quest_desktop_objectives\" }, { node = \"quest_desktop_rewards_title\" }, { node = \"quest_desktop_rewards\" }, { node = \"quest_desktop_turn_in\" }, { node = \"quest_desktop_actions\" }]\n\n[nodes.quest_desktop_columns]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"QuestDesktopColumns\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 10.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"quest_desktop_list\" }, { node = \"quest_desktop_detail\" }]\n\n[nodes.quest_desktop]\ncomponent = \"Container\"\ncontrol_id = \"QuestDesktopLayout\"\nprops = { visibility = { xs = \"collapsed\", md = \"visible\" } }\nlayout = { container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"quest_desktop_columns\" }]\n\n[nodes.quest_compact_list_host]\ncomponent = \"VerticalBox\"\ncontrol_id = \"QuestCompactListHost\"\nlayout = { container = { kind = \"VerticalBox\", gap = 4.0 }, width = { stretch = \"Stretch\" }, height = { min = 120.0, preferred = 180.0, max = 260.0, stretch = \"Stretch\" } }\nchildren = []\n\n[nodes.quest_compact_list]\ncomponent = \"ScrollBox\"\ncontrol_id = \"QuestCompactList\"\nclasses = [\"woc-panel-strong\"]\nprops = { scroll_axis = \"vertical\", scroll_x = false, scroll_y = true, show_scrollbars = true, clip_content = true }\nlayout = { container = { kind = \"VerticalBox\", gap = 4.0 }, padding = { left = 8.0, right = 8.0, top = 8.0, bottom = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 140.0, preferred = 200.0, max = 280.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"quest_compact_list_host\" }]\n\n[nodes.quest_compact_detail_title]\ncomponent = \"Label\"\ncontrol_id = \"QuestCompactDetailTitle\"\nclasses = [\"woc-section-title\"]\nprops = { text = \"\", overflow = \"wrap\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 36.0, max = 64.0, stretch = \"Fixed\" } }\n\n[nodes.quest_compact_narrative]\ncomponent = \"Label\"\ncontrol_id = \"QuestCompactNarrative\"\nclasses = [\"woc-label\"]\nprops = { text = \"\", overflow = \"wrap\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 64.0, preferred = 92.0, max = 160.0, stretch = \"Fixed\" } }\n\n[nodes.quest_compact_objectives]\ncomponent = \"VerticalBox\"\ncontrol_id = \"QuestCompactObjectiveHost\"\nlayout = { container = { kind = \"VerticalBox\", gap = 6.0 }, width = { stretch = \"Stretch\" }, height = { min = 72.0, preferred = 112.0, max = 220.0, stretch = \"Fixed\" } }\nchildren = []\n\n[nodes.quest_compact_rewards]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"QuestCompactRewardHost\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 52.0, preferred = 60.0, max = 84.0, stretch = \"Fixed\" } }\nchildren = []\n\n[nodes.quest_compact_turn_in]\ncomponent = \"Label\"\ncontrol_id = \"QuestCompactTurnIn\"\nclasses = [\"woc-muted\"]\nprops = { text = \"\", overflow = \"wrap\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 36.0, max = 56.0, stretch = \"Fixed\" } }\n\n[nodes.quest_compact_abandon]\ncomponent = \"Button\"\ncontrol_id = \"QuestCompactAbandon\"\nclasses = [\"woc-secondary-action\"]\nprops = { text = \"Abandon\" }\nlayout = { width = { min = 92.0, preferred = 108.0, max = 132.0, stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 48.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WocQuestLog/CompactAbandon\", event = \"Click\", route = \"woc.window.quest_log.abandon\" }]\n\n[nodes.quest_compact_share]\ncomponent = \"Button\"\ncontrol_id = \"QuestCompactShare\"\nclasses = [\"woc-primary-action\"]\nprops = { text = \"Share\" }\nlayout = { width = { min = 84.0, preferred = 96.0, max = 120.0, stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 48.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WocQuestLog/CompactShare\", event = \"Click\", route = \"woc.window.quest_log.share\" }]\n\n[nodes.quest_compact_actions]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"QuestCompactActions\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 48.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"quest_compact_abandon\" }, { node = \"quest_compact_share\" }]\n\n[nodes.quest_compact_detail]\ncomponent = \"ScrollBox\"\ncontrol_id = \"QuestCompactDetail\"\nclasses = [\"woc-panel-strong\"]\nprops = { scroll_axis = \"vertical\", scroll_x = false, scroll_y = true, show_scrollbars = true, clip_content = true }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, padding = { left = 10.0, right = 10.0, top = 10.0, bottom = 10.0 }, width = { stretch = \"Stretch\" }, height = { min = 280.0, preferred = 380.0, max = 520.0, stretch = \"Stretch\" } }\nchildren = [{ node = \"quest_compact_detail_title\" }, { node = \"quest_compact_narrative\" }, { node = \"quest_compact_objectives\" }, { node = \"quest_compact_rewards\" }, { node = \"quest_compact_turn_in\" }, { node = \"quest_compact_actions\" }]\n\n[nodes.quest_compact_stack]\ncomponent = \"VerticalBox\"\ncontrol_id = \"QuestCompactStack\"\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"quest_compact_list\" }, { node = \"quest_compact_detail\" }]\n\n[nodes.quest_compact]\ncomponent = \"Container\"\ncontrol_id = \"QuestCompactLayout\"\nprops = { visibility = { xs = \"visible\", md = \"collapsed\" } }\nlayout = { container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"quest_compact_stack\" }]\n\n[nodes.quest_root]\ncomponent = \"Container\"\ncontrol_id = \"QuestLogWindow\"\nclasses = [\"woc-panel\"]\nprops = { visibility = \"collapsed\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 10.0 }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.5 }, position = { x = 0.0, y = 0.0 }, padding = { left = 14.0, right = 14.0, top = 12.0, bottom = 14.0 }, width = { min = 340.0, preferred = 900.0, max = 980.0, stretch = \"Fixed\" }, height = { min = 560.0, preferred = 700.0, max = 840.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"quest_header\" }, { node = \"quest_desktop\" }, { node = \"quest_compact\" }]\n"

[asset]
kind = "view"
id = "res://ui/windows/quest_log_window.zui"
version = 2
display_name = "World of ClaudeCraft Quest Log Window"

[imports]
widgets = []
styles = []
resources = []

[root]
node = "quest_root"

[nodes.quest_title]
component = "Label"
control_id = "QuestLogTitle"
classes = [ "woc-screen-title" ]

[nodes.quest_title.props]
text = "Quest Log"
overflow = "elide"

[nodes.quest_title.layout.width]
stretch = "Stretch"

[nodes.quest_title.layout.height]
min = 28
preferred = 28
max = 32
stretch = "Fixed"

[nodes.quest_summary]
component = "Label"
control_id = "QuestLogSummary"
classes = [ "woc-muted" ]

[nodes.quest_summary.props]
text = "0 active / 0 completed"
text_align = "right"

[nodes.quest_summary.layout.width]
min = 160
preferred = 220
max = 260
stretch = "Fixed"

[nodes.quest_summary.layout.height]
min = 24
preferred = 24
max = 28
stretch = "Fixed"

[nodes.quest_close]
component = "Button"
control_id = "QuestLogClose"
classes = [ "woc-secondary-action" ]

[nodes.quest_close.props]
text = "Close"

[nodes.quest_close.layout.width]
min = 64
preferred = 72
max = 88
stretch = "Fixed"

[nodes.quest_close.layout.height]
min = 40
preferred = 40
max = 44
stretch = "Fixed"

[[nodes.quest_close.events]]
id = "WocQuestLog/Close"
event = "Click"
route = "woc.window.quest_log.close"

[nodes.quest_header]
component = "HorizontalBox"
control_id = "QuestLogHeader"

[nodes.quest_header.layout.container]
kind = "HorizontalBox"
gap = 10

[nodes.quest_header.layout.width]
stretch = "Stretch"

[nodes.quest_header.layout.height]
min = 40
preferred = 40
max = 44
stretch = "Fixed"

[[nodes.quest_header.children]]
node = "quest_title"

[[nodes.quest_header.children]]
node = "quest_summary"

[[nodes.quest_header.children]]
node = "quest_close"

[nodes.quest_desktop_list_host]
component = "VerticalBox"
control_id = "QuestDesktopListHost"
children = []

[nodes.quest_desktop_list_host.layout.container]
