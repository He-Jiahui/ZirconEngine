classes = [ "woc-pause-scrim" ]

[nodes.pause_scrim.layout.width]
stretch = "Stretch"

[nodes.pause_scrim.layout.height]
stretch = "Stretch"

[nodes.pause_layer]
component = "Overlay"
control_id = "PauseLayer"

[nodes.pause_layer.props]
