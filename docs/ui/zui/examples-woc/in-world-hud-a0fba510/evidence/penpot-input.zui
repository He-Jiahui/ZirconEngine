classes = [ "woc-hud-root" ]

[nodes.hud_root.layout]
clip = true

[nodes.hud_root.layout.container]
kind = "Overlay"

[nodes.hud_root.layout.width]
stretch = "Stretch"

[nodes.hud_root.layout.height]
stretch = "Stretch"

