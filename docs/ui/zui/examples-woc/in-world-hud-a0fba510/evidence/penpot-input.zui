[nodes.pause_logout.layout.height]
min = 42
preferred = 42
max = 42
stretch = "Fixed"

[[nodes.pause_logout.events]]
id = "WocHud/Pause/Logout"
event = "Click"
route = "woc.hud.pause.logout"

[nodes.pause_return]
component = "Button"
control_id = "PauseReturnToGame"
classes = [ "woc-primary-action" ]

[nodes.pause_return.props]
text = "Return to Game"
button_variant = "contained"

[nodes.pause_return.layout.width]
stretch = "Stretch"

[nodes.pause_return.layout.height]
min = 44
preferred = 44
max = 44
stretch = "Fixed"

[[nodes.pause_return.events]]
id = "WocHud/Pause/Return"
event = "Click"
route = "woc.hud.pause.return_to_game"

[nodes.pause_menu]
component = "VerticalBox"
control_id = "PauseMenu"
classes = [ "woc-pause-menu" ]

[nodes.pause_menu.layout.container]
kind = "VerticalBox"
gap = 7

[nodes.pause_menu.layout.padding]
left = 20
right = 20
top = 20
bottom = 20

[nodes.pause_menu.layout.anchor]
x = 0.5
y = 0.5

[nodes.pause_menu.layout.pivot]
x = 0.5
y = 0.5

[nodes.pause_menu.layout.position]
x = 0
y = 0

[nodes.pause_menu.layout.width]
min = 300
preferred = 340
max = 380
stretch = "Fixed"

[nodes.pause_menu.layout.height]
min = 392
preferred = 448
max = 520
stretch = "Fixed"

[[nodes.pause_menu.children]]
node = "pause_keybinds"

[[nodes.pause_menu.children]]
node = "pause_controller"

[[nodes.pause_menu.children]]
node = "pause_graphics"

[[nodes.pause_menu.children]]
node = "pause_interface"

[[nodes.pause_menu.children]]
node = "pause_audio"

[[nodes.pause_menu.children]]
