penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/hud/in_world_hud.zui\"\nversion = 2\ndisplay_name = \"World of ClaudeCraft In-World HUD\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/shell/shell_theme.zui\", \"res://ui/hud/hud_theme.zui\"]\nresources = []\n\n[root]\nnode = \"hud_root\"\n\n[nodes.combat_live]\ncomponent = \"Label\"\ncontrol_id = \"CombatLiveRegion\"\nclasses = [\"woc-live-region\"]\nprops = { text = \"\", overflow = \"elide\" }\nlayout = { width = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" } }\n\n[nodes.target_live]\ncomponent = \"Label\"\ncontrol_id = \"TargetLiveRegion\"\nclasses = [\"woc-live-region\"]\nprops = { text = \"\", overflow = \"elide\" }\nlayout = { width = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" } }\n\n[nodes.chat_live]\ncomponent = \"Label\"\ncontrol_id = \"ChatLiveRegion\"\nclasses = [\"woc-live-region\"]\nprops = { text = \"\", overflow = \"elide\" }\nlayout = { width = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" } }\n\n[nodes.live_regions]\ncomponent = \"VerticalBox\"\ncontrol_id = \"HudLiveRegions\"\nlayout = { container = { kind = \"VerticalBox\", gap = 0.0 }, anchor = { x = 0.0, y = 0.0 }, pivot = { x = 1.0, y = 1.0 }, position = { x = -8.0, y = -8.0 }, width = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" }, height = { min = 3.0, preferred = 3.0, max = 3.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"combat_live\" }, { node = \"target_live\" }, { node = \"chat_live\" }]\n\n[nodes.target_portrait]\ncomponent = \"Space\"\ncontrol_id = \"TargetPortraitHost\"\nclasses = [\"woc-portrait\"]\nlayout = { width = { min = 60.0, preferred = 60.0, max = 60.0, stretch = \"Fixed\" }, height = { min = 60.0, preferred = 60.0, max =