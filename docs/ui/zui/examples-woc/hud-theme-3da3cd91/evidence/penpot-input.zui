[penpot_original_imports]
widgets = []
styles = [ "res://ui/shell/shell_theme.zui" ]

[penpot_review_host.asset]
kind = "view"
version = 2
id = "res://ui/hud/hud_theme.zui#review-host"
display_name = "World of ClaudeCraft HUD Theme"

[penpot_review_host.imports]
widgets = []
styles = []

[penpot_review_host.root]
node = "review_theme_host"

[penpot_review_host.nodes.review_theme_host]
component = "Overlay"
classes = [ "woc-shell" ]

