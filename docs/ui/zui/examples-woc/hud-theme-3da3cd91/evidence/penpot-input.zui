width = 1
radius = 4

[[penpot_review_host.stylesheets.rules]]
selector = ".woc-lockpick-timer-fill"

[penpot_review_host.stylesheets.rules.set.self.background]
color = "$woc_gold"

[penpot_review_host.stylesheets.rules.set.self.border]
radius = 3

[[penpot_review_host.stylesheets.rules]]
selector = ".woc-lockpick-action"

[penpot_review_host.stylesheets.rules.set.self.background]
color = "$woc_hud_slot"

[penpot_review_host.stylesheets.rules.set.self.foreground]
color = "$woc_text"

[penpot_review_host.stylesheets.rules.set.self.border]
color = "$woc_hud_slot_border"
width = 2
radius = 5

[penpot_review_host.stylesheets.rules.set.self.font]
size = 12
weight = 700

[[penpot_review_host.stylesheets.rules]]
selector = ".woc-lockpick-action:focus"

[penpot_review_host.stylesheets.rules.set.self.border]
color = "$woc_hud_focus"
width = 3
radius = 5

[[penpot_review_host.stylesheets.rules]]
selector = ".woc-lockpick-feedback"

[penpot_review_host.stylesheets.rules.set.self.foreground]
color = "$woc_gold"

[penpot_review_host.stylesheets.rules.set.self.font]
size = 13
weight = 700

[[penpot_review_host.stylesheets.rules]]
