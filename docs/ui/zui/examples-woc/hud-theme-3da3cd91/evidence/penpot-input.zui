penpot_dependency_sources = [ "examples/woc/assets/ui/shell/shell_theme.zui", "examples/woc/assets/ui/hud/in_world_hud.zui", "examples/woc/assets/ui/hud/lockpick_window.zui" ]
penpot_original_source = "[asset]\nkind = \"style\"\nid = \"res://ui/hud/hud_theme.zui\"\nversion = 2\ndisplay_name = \"World of ClaudeCraft HUD Theme\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/shell/shell_theme.zui\"]\n\n[tokens]\nwoc_hud_panel = \"#11101dee\"\nwoc_hud_panel_soft = \"#17151ecc\"\nwoc_hud_rail = \"#09090fcc\"\nwoc_hud_slot = \"#17151f\"\nwoc_hud_slot_border = \"#5b4618\"\nwoc_hud_health = \"#3fa65a\"\nwoc_hud_absorb = \"#d9e4f2aa\"\nwoc_hud_mana = \"#2476d3\"\nwoc_hud_rage = \"#a63838\"\nwoc_hud_energy = \"#d5c536\"\nwoc_hud_cooldown = \"#000000b8\"\nwoc_hud_danger = \"#c73535\"\nwoc_hud_touch = \"#282a3b\"\nwoc_hud_touch_border = \"#8a6c2a\"\nwoc_hud_vignette = \"#8d101066\"\nwoc_hud_focus = \"#f7d45c\"\n\n[[stylesheets]]\nid = \"woc-hud\"\n\n[[stylesheets.rules]]\nselector = \".woc-hud-root\"\nset = { self = { background = { color = \"#00000000\" }, foreground = { color = \"$woc_text\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-live-region\"\nset = { self = { foreground = { color = \"#00000000\" }, font = { size = 1.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-unit-frame\"\nset = { self = { background = { color = \"$woc_hud_panel\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-unit-frame-target\"\nset = { self = { border = { color = \"$woc_gold_dim\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-unit-frame-dead\"\nset = { self = { foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_hud_danger\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-portrait\"\nset = { self = { background = { color = \"$woc_hud_panel_soft\" }, border = { color = \"$woc_border\", width = 3.0, radius = 31.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-level-chip\"\nset = { self = { background = { color = \"$woc_hud_slot\" }, foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 12.0 }, font = { size = 11.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-unit-name\"\nset = { self = { foreground = { color = \"$woc_text\" }, font = { size = 13.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-bar-rail\"\nset = { self = { background = { color = \"$woc_hud_rail\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 3.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-health-fill\"\nset = { self = { background = { color = \"$woc_hud_health\" }, border = { radius = 2.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-absorb-fill\"\nset = { self = { background = { color = \"$woc_hud_absorb\" }, border = { radius = 2.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-resource-fill\"\nset = { self = { background = { color = \"$woc_hud_mana\" }, border = { radius = 2.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-resource-rage\"\nset = { self = { background = { color = \"$woc_hud_rage\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-resource-energy\"\nset = { self = { background = { color = \"$woc_hud_energy\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-bar-text\"\nset = { self = { foreground = { color = \"#ffffff\" }, font = { size = 10.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-cast-fill\"\nset = { self = { background = { color = \"$woc_gold_dim\" }, border = { radius = 2.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-xp-fill\"\nset = { self = { background = { color = \"#8e3bc1\" }, border = { radius = 2.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-xp-rested\"\nset = { self = { background = { color = \"#438ed0aa\" }, border = { radius = 2.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-action-bar\"\nset = { self = { background = { color = \"$woc_hud_panel\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 7.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-action-slot\"\nset = { self = { background = { color = \"$woc_hud_slot\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_hud_slot_border\", width = 2.0, radius = 6.0 }, font = { size = 10.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-action-slot:hover\"\nset = { self = { border = { color = \"$woc_gold\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-action-slot:pressed\"\nset = { self = { background = { color = \"$woc_control_pressed\" }, foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-action-slot:focus\"\nset = { self = { border = { color = \"$woc_hud_focus\", width = 3.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-action-slot:disabled\"\nset = { self = { background = { color = \"$woc_hud_rail\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-action-slot-queued\"\nset = { self = { border = { color = \"$woc_gold\", width = 3.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-action-slot-out-of-range\"\nset = { self = { border = { color = \"$woc_hud_danger\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-action-slot-proc\"\nset = { self = { foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold\", width = 3.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-cooldown-overlay\"\nset = { self = { background = { color = \"$woc_hud_cooldown\" }, border = { radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-keybind\"\nset = { self = { foreground = { color = \"$woc_text_muted\" }, font = { size = 9.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-tracker\"\nset = { self = { background = { color = \"$woc_hud_panel_soft\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-minimap\"\nset = { self = { background = { color = \"#18362f\" }, border = { color = \"$woc_gold_dim\", width = 3.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-touch-action\"\nset = { self = { background = { color = \"$woc_hud_touch\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_hud_touch_border\", width = 2.0, radius = 8.0 }, font = { size = 11.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-touch-action:hover\"\nset = { self = { border = { color = \"$woc_gold\", width = 2.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-touch-action:pressed\"\nset = { self = { background = { color = \"$woc_control_pressed\" }, foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-touch-action:focus\"\nset = { self = { border = { color = \"$woc_hud_focus\", width = 3.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-touch-action:disabled\"\nset = { self = { background = { color = \"$woc_control_disabled\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-touch-zone\"\nset = { self = { background = { color = \"#20222a22\" }, border = { color = \"#a6b2c244\", width = 1.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-pause-scrim\"\nset = { self = { background = { color = \"#05050acc\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-pause-menu\"\nset = { self = { background = { color = \"$woc_hud_panel\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border\", width = 2.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-pause-action\"\nset = { self = { background = { color = \"$woc_hud_panel_soft\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 5.0 }, font = { size = 14.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-pause-action:hover\"\nset = { self = { background = { color = \"$woc_control_hover\" }, border = { color = \"$woc_gold_dim\", width = 1.0, radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-pause-action:pressed\"\nset = { self = { background = { color = \"$woc_control_pressed\" }, foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold_dim\", width = 1.0, radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-pause-action:focus\"\nset = { self = { border = { color = \"$woc_hud_focus\", width = 2.0, radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-pause-action:disabled\"\nset = { self = { background = { color = \"$woc_control_disabled\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-low-health-vignette\"\nset = { self = { background = { color = \"$woc_hud_vignette\" } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-window\"\nset = { self = { background = { color = \"$woc_hud_panel\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 8.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-ante\"\nset = { self = { background = { color = \"$woc_hud_panel_soft\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_hud_slot_border\", width = 2.0, radius = 6.0 }, font = { size = 13.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-ante:hover\"\nset = { self = { background = { color = \"$woc_control_hover\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-ante:pressed\"\nset = { self = { background = { color = \"$woc_control_pressed\" }, foreground = { color = \"$woc_gold\" }, border = { color = \"$woc_gold_dim\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-ante:focus\"\nset = { self = { border = { color = \"$woc_hud_focus\", width = 3.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-ante:disabled\"\nset = { self = { background = { color = \"$woc_control_disabled\" }, foreground = { color = \"$woc_text_muted\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-board\"\nset = { self = { background = { color = \"$woc_hud_rail\" }, border = { color = \"$woc_hud_slot_border\", width = 2.0, radius = 6.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-timer\"\nset = { self = { background = { color = \"$woc_hud_rail\" }, border = { color = \"$woc_border_soft\", width = 1.0, radius = 4.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-timer-fill\"\nset = { self = { background = { color = \"$woc_gold\" }, border = { radius = 3.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-action\"\nset = { self = { background = { color = \"$woc_hud_slot\" }, foreground = { color = \"$woc_text\" }, border = { color = \"$woc_hud_slot_border\", width = 2.0, radius = 5.0 }, font = { size = 12.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-action:focus\"\nset = { self = { border = { color = \"$woc_hud_focus\", width = 3.0, radius = 5.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-feedback\"\nset = { self = { foreground = { color = \"$woc_gold\" }, font = { size = 13.0, weight = 700.0 } } }\n\n[[stylesheets.rules]]\nselector = \".woc-lockpick-coffer\"\nset = { self = { foreground = { color = \"$woc_gold\" }, font = { size = 13.0, weight = 700.0 } } }\n"

[asset]
kind = "style"
id = "res://ui/hud/hud_theme.zui"
version = 2
display_name = "World of ClaudeCraft HUD Theme"

[imports]
widgets = []
styles = []

[tokens]
woc_shell_bg = "#10121f"
woc_shell_scrim = "#00000066"
woc_panel_bg = "#11101ddd"
woc_panel_bg_strong = "#0d0d16ee"
woc_border = "#6f5a2a"
woc_border_soft = "#3b3547"
woc_gold = "#ffd100"
woc_gold_dim = "#c8a94d"
woc_gold_light = "#ffe46b"
woc_control_hover = "#282737"
woc_control_pressed = "#3a3018"
woc_control_disabled = "#1b1a24"
woc_text = "#f4ead3"
woc_text_muted = "#998d6a"
woc_input_bg = "#10101acc"
woc_discord = "#5865f2"
woc_discord_border = "#3c46b0"
woc_success = "#9fdc7f"
woc_error = "#e06c75"
woc_shadow = "#00000073"
woc_hud_panel = "#11101dee"
woc_hud_panel_soft = "#17151ecc"
woc_hud_rail = "#09090fcc"
woc_hud_slot = "#17151f"
woc_hud_slot_border = "#5b4618"
woc_hud_health = "#3fa65a"
woc_hud_absorb = "#d9e4f2aa"
woc_hud_mana = "#2476d3"
woc_hud_rage = "#a63838"
woc_hud_energy = "#d5c536"
woc_hud_cooldown = "#000000b8"
woc_hud_danger = "#c73535"
woc_hud_touch = "#282a3b"
woc_hud_touch_border = "#8a6c2a"
woc_hud_vignette = "#8d101066"
woc_hud_focus = "#f7d45c"

[[stylesheets]]
id = "woc-shell"

[[stylesheets.rules]]
selector = ".woc-shell"

[stylesheets.rules.set.self.background]
color = "$woc_shell_bg"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[[stylesheets.rules]]
selector = ".woc-stage-scrim"

[stylesheets.rules.set.self.background]
color = "$woc_shell_scrim"

[[stylesheets.rules]]
selector = ".woc-panel"

[stylesheets.rules.set.self.background]
color = "$woc_panel_bg"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[stylesheets.rules.set.self.border]
color = "$woc_border_soft"
width = 1
radius = 8

[[stylesheets.rules]]
selector = ".woc-panel-strong"

[stylesheets.rules.set.self.background]
color = "$woc_panel_bg_strong"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[stylesheets.rules.set.self.border]
color = "$woc_border_soft"
width = 1
radius = 8

[[stylesheets.rules]]
selector = ".woc-screen-title"

[stylesheets.rules.set.self.foreground]
color = "$woc_gold"

[stylesheets.rules.set.self.font]
size = 22
weight = 700

[[stylesheets.rules]]
selector = ".woc-welcome-title"

[stylesheets.rules.set.self.foreground]
color = "$woc_gold"

[stylesheets.rules.set.self.font]
size = 27
weight = 700

[[stylesheets.rules]]
selector = ".woc-section-title"

[stylesheets.rules.set.self.foreground]
color = "$woc_gold_dim"

[stylesheets.rules.set.self.font]
size = 15
weight = 700

[[stylesheets.rules]]
selector = ".woc-label"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[stylesheets.rules.set.self.font]
size = 14
weight = 600

[[stylesheets.rules]]
selector = ".woc-muted"

[stylesheets.rules.set.self.foreground]
color = "$woc_text_muted"

[stylesheets.rules.set.self.font]
size = 12

[[stylesheets.rules]]
selector = ".woc-error"

[stylesheets.rules.set.self.foreground]
color = "$woc_error"

[stylesheets.rules.set.self.font]
size = 12
weight = 600

[[stylesheets.rules]]
selector = ".woc-input"

[stylesheets.rules.set.self.background]
color = "$woc_input_bg"

[stylesheets.rules.set.self.foreground]
color = "$woc_text"

[stylesheets.rules.set.self.border]
color = "$woc_border_soft"
width = 1
radius = 5

[stylesheets.rules.set.self.font]
size = 14

[[stylesheets.rules]]
selector = ".woc-input:hover"

[stylesheets.rules.set.self.border]
color = "$woc_gold_dim"
width = 1
radius = 5

[[stylesheets.rules]]
selector = ".woc-input:focus"

[stylesheets.rules.set.self.border]
color = "$woc_gold"
width = 2
radius = 5

[[stylesheets.rules]]
selector = ".woc-input:disabled"

[stylesheets.rules.set.self.background]
