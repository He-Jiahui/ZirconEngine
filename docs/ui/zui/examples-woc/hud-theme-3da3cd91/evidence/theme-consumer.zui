[asset]
kind = "view"
version = 2
id = "res://ui/hud/hud_theme.zui#review-host"
display_name = "World of ClaudeCraft HUD Theme"

[imports]
widgets = []
styles = [ "res://ui/hud/hud_theme.zui" ]

[root]
node = "review_theme_host"

[nodes.review_theme_host]
component = "Overlay"
classes = [ "woc-shell" ]

[nodes.review_theme_host.layout.container]
kind = "Overlay"

[nodes.review_theme_host.layout.width]
stretch = "Stretch"

[nodes.review_theme_host.layout.height]
stretch = "Stretch"

[[nodes.review_theme_host.children]]
node = "review_theme_title"

[[nodes.review_theme_host.children]]
node = "sample_0_label"

[[nodes.review_theme_host.children]]
node = "sample_0"

[[nodes.review_theme_host.children]]
node = "sample_1_label"

[[nodes.review_theme_host.children]]
node = "sample_1"

[[nodes.review_theme_host.children]]
node = "sample_2_label"

[[nodes.review_theme_host.children]]
node = "sample_2"

[[nodes.review_theme_host.children]]
node = "sample_3_label"

[[nodes.review_theme_host.children]]
node = "sample_3"

[nodes.review_theme_title]
component = "Label"
classes = [ "woc-screen-title" ]

[nodes.review_theme_title.props]
text = "World of ClaudeCraft HUD Theme"

[nodes.review_theme_title.layout.position]
x = 32
y = 24

[nodes.review_theme_title.layout.width]
preferred = 800
stretch = "Fixed"

[nodes.review_theme_title.layout.height]
preferred = 40
stretch = "Fixed"

[nodes.sample_0_label]
component = "Label"
classes = [ "woc-section-title" ]

[nodes.sample_0_label.props]
text = "Action slot"

[nodes.sample_0_label.layout.position]
x = 32
y = 104

[nodes.sample_0_label.layout.width]
preferred = 344
stretch = "Fixed"

[nodes.sample_0_label.layout.height]
preferred = 24
stretch = "Fixed"

[nodes.sample_0]
component = "Button"
control_id = "ActionSlot0"
classes = [ "woc-action-slot" ]

[nodes.sample_0.props]
text = "Attack"
button_variant = "outlined"

[nodes.sample_0.layout.width]
min = 46
preferred = 46
max = 46
stretch = "Fixed"

[nodes.sample_0.layout.height]
min = 46
preferred = 46
max = 46
stretch = "Fixed"

[nodes.sample_0.layout.anchor]
x = 0
y = 0

[nodes.sample_0.layout.pivot]
x = 0
y = 0

[nodes.sample_0.layout.position]
x = 32
y = 140

[[nodes.sample_0.events]]
id = "WocHud/Action/0"
event = "Click"
route = "woc.hud.action.activate.0"

