penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/runtime/fixtures/inventory_list.zui\"\nversion = 2\ndisplay_name = \"Runtime Inventory List\"\n\n[imports]\nwidgets = []\nstyles = []\n\n[root]\nnode = \"inventory_root\"\n\n[nodes.inventory_root]\ncomponent = \"Overlay\"\ncontrol_id = \"InventoryRoot\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"Overlay\" } }\nchildren = [{ node = \"inventory_panel\" }, { node = \"inventory_header\" }, { node = \"inventory_list\" }]\n\n[nodes.inventory_panel]\ncomponent = \"Container\"\ncontrol_id = \"InventoryPanel\"\nprops = { background = { color = \"#1d2330\" }, border = { color = \"#7aa3d0\", width = 2.0, radius = 16.0 } }\nlayout = { width = { min = 540.0, preferred = 540.0, max = 540.0, stretch = \"Fixed\" }, height = { min = 380.0, preferred = 380.0, max = 380.0, stretch = \"Fixed\" }, anchor = { x = 1.0, y = 0.5 }, pivot = { x = 1.0, y = 0.5 }, position = { x = -36.0, y = 0.0 } }\n\n[nodes.inventory_header]\ncomponent = \"Container\"\ncontrol_id = \"InventoryHeader\"\nprops = { text = \"Field Inventory\", background = { color = \"#7a4e23\" }, border = { color = \"#f2d1a0\", width = 1.0, radius = 12.0 }, foreground = { color = \"#fff2de\" } }\nlayout = { width = { min = 476.0, preferred = 476.0, max = 476.0, stretch = \"Fixed\" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = \"Fixed\" }, anchor = { x = 1.0, y = 0.5 }, pivot = { x = 1.0, y = 0.5 }, position = { x = -68.0, y = -140.0 } }\n\n[nodes.inventory_list]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"InventoryList\"\nlayout = { clip = true, width = { min = 476.0, preferred = 476.0, max = 476.0, stretch = \"Fixed\" }, height = { min = 260.0, preferred = 260.0, max = 260.0, stretch = \"Fixed\" }, anchor = { x = 1.0, y = 0.5 }, pivot = { x = 1.0, y = 0.5 }, position = { x = -68.0, y = 22.0 }, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 8.0, scrollbar_visibility = \"Always\", virtualization = { item_extent = 36.0, overscan = 2 } } }\nchildren = [\n  { node = \"row_00\" },\n  { node = \"row_01\" },\n  { node = \"row_02\" },\n  { node = \"row_03\" },\n  { node = \"row_04\" },\n  { node = \"row_05\" },\n  { node = \"row_06\" },\n  { node = \"row_07\" },\n  { node = \"row_08\" },\n  { node = \"row_09\" },\n  { node = \"row_10\" },\n  { node = \"row_11\" },\n]\n\n[nodes.row_00]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow00\"\nprops = { text = \"01  Pulse Cells x24\", background = { color = \"#30465e\" }, border = { color = \"#96c2e6\", width = 1.0, radius = 8.0 }, foreground = { color = \"#eef8ff\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.row_01]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow01\"\nprops = { text = \"02  Med Kit x4\", background = { color = \"#2c394c\" }, border = { color = \"#89b6d9\", width = 1.0, radius = 8.0 }, foreground = { color = \"#eef8ff\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.row_02]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow02\"\nprops = { text = \"03  Signal Beacon\", background = { color = \"#30465e\" }, border = { color = \"#96c2e6\", width = 1.0, radius = 8.0 }, foreground = { color = \"#eef8ff\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.row_03]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow03\"\nprops = { text = \"04  Alloy Plate x12\", background = { color = \"#2c394c\" }, border = { color = \"#89b6d9\", width = 1.0, radius = 8.0 }, foreground = { color = \"#eef8ff\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.row_04]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow04\"\nprops = { text = \"05  Repair Foam x3\", background = { color = \"#30465e\" }, border = { color = \"#96c2e6\", width = 1.0, radius = 8.0 }, foreground = { color = \"#eef8ff\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.row_05]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow05\"\nprops = { text = \"06  Cryo Charge x2\", background = { color = \"#2c394c\" }, border = { color = \"#89b6d9\", width = 1.0, radius = 8.0 }, foreground = { color = \"#eef8ff\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.row_06]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow06\"\nprops = { text = \"07  Survey Drone\", background = { color = \"#30465e\" }, border = { color = \"#96c2e6\", width = 1.0, radius = 8.0 }, foreground = { color = \"#eef8ff\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.row_07]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow07\"\nprops = { text = \"08  Circuit Weave x7\", background = { color = \"#2c394c\" }, border = { color = \"#89b6d9\", width = 1.0, radius = 8.0 }, foreground = { color = \"#eef8ff\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.row_08]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow08\"\nprops = { text = \"09  Field Rations x9\", background = { color = \"#30465e\" }, border = { color = \"#96c2e6\", width = 1.0, radius = 8.0 }, foreground = { color = \"#eef8ff\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.row_09]\ncomponent = \"Button\"\ncontrol_id = \"InventoryRow09\"\nprops = { text = \"10  Archive Key\", background = { color = \"#2c394c\" }, border = { color = \"#89b6d