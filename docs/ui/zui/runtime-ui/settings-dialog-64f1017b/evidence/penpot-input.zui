r = \"#243241\" }, border = { color = \"#99cce8\", width = 1.0, radius = 12.0 } }\nlayout = { width = { min = 420.0, preferred = 420.0, max = 420.0, stretch = \"Fixed\" }, height = { min = 360.0, preferred = 360.0, max = 360.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.0, y = 0.5 }, position = { x = -130.0, y = -12.0 } }\n\n[nodes.audio_row]\ncomponent = \"Button\"\ncontrol_id = \"AudioVolume\"\nprops = { text = \"Master Volume    78%\", background = { color = \"#31465c\" }, border = { color = \"#a7d4f0\", width = 1.0, radius = 10.0 }, foreground = { color = \"#f3fbff\" } }\nlayout = { width = { min = 360.0, preferred = 360.0, max = 360.0, stretch = \"Fixed\" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.0, y = 0.0 }, position = { x = -100.0, y = -130.0 } }\n\n[nodes.graphics_row]\ncomponent = \"Button\"\ncontrol_id = \"GraphicsQuality\"\nprops = { text = \"Graphics Quality    Epic\", background = { color = \"#31465c\" }, border = { color = \"#a7d4f0\", width = 1.0, radius = 10.0 }, foreground = { color = \"#f3fbff\" } }\nlayout = { width = { min = 360.0, preferred = 360.0, max = 360.0, stretch = \"Fixed\" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.0, y = 0.0 }, position = { x = -100.0, y = -56.0 } }\n\n[nodes.apply_button]\ncomponent = \"Button\"\ncontrol_id = \"ApplySettings\"\nprops = { text = \"Apply\", background = { color = \"#2f5d34\" }, border = { color = \"#c7ebb0\", width = 1.0, radius = 10.0 }, foreground = { color = \"#f6fff0\" } }\nlayout = { width = { min = 168.0, preferred = 168.0, max = 168.0, stretch = \"Fixed\" }, height = { min = 46.0, preferred = 46.0, max = 46.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 1.0, y = 1.0 }, position = { x = 278.0, y = 194.0 } }\n\n[nodes.cancel_button]\ncomponent = \"Button\"\ncontrol_id = \"CancelSetti