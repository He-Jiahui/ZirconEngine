penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/runtime/fixtures/pause_menu.zui\"\nversion = 2\ndisplay_name = \"Runtime Pause Menu\"\n\n[imports]\nwidgets = []\nstyles = []\n\n[root]\nnode = \"pause_root\"\n\n[nodes.pause_root]\ncomponent = \"Overlay\"\ncontrol_id = \"PauseMenuRoot\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"Overlay\" } }\nchildren = [{ node = \"scrim\" }, { node = \"dialog\" }, { node = \"title\" }, { node = \"resume_button\" }, { node = \"settings_button\" }, { node = \"quit_button\" }, { node = \"hint_label\" }]\n\n[nodes.scrim]\ncomponent = \"Container\"\ncontrol_id = \"PauseScrim\"\nprops = { background = { color = \"#10141dcc\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.dialog]\ncomponent = \"Container\"\ncontrol_id = \"PauseDialog\"\nprops = { opacity = 0.96, background = { color = \"#b13d3d\" }, border = { color = \"#f6d2a6\", width = 3.0, radius = 18.0 } }\nlayout = { width = { min = 420.0, preferred = 420.0, max = 420.0, stretch = \"Fixed\" }, height = { min = 320.0, preferred = 320.0, max = 320.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.5 }, position = { x = 0.0, y = 0.0 } }\n\n[nodes.title]\ncomponent = \"Label\"\ncontrol_id = \"PauseTitle\"\nprops = { text = \"Paused\", foreground = { color = \"#fff4e0\" } }\nlayout = { width = { min = 220.0, preferred = 220.0, max = 220.0, stretch = \"Fixed\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.0 }, position = { x = 0.0, y = -114.0 } }\n\n[nodes.resume_button]\ncomponent = \"Button\"\ncontrol_id = \"ResumeButton\"\nprops = { text = \"Resume Mission\", background = { color = \"#272c38\" }, border = { color = \"#f7d58d\", width = 1.0, radius = 10.0 }, foreground = { color = \"#fff7ea\" } }\nlayout = { width = { min = 280.0, preferred = 280.0, max = 280.0, stretch = \"Fixed\" }, height = { min = 52.0, preferred = 52.0, max = 52.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.0 }, position = { x = 0.0, y = -32.0 } }\n\n[nodes.settings_button]\ncomponent = \"Button\"\ncontrol_id = \"SettingsButton\"\nprops = { text = \"Settings\", background = { color = \"#272c38\" }, border = { color = \"#9ab3ce\", width = 1.0, radius = 10.0 }, foreground = { color = \"#eef3f7\" } }\nlayout = { width = { min = 280.0, preferred = 280.0, max = 280.0, stretch = \"Fixed\" }, height = { min = 52.0, preferred = 52.0, max = 52.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.0 }, position = { x = 0.0, y = 36.0 } }\n\n[nodes.quit_button]\ncomponent = \"Button\"\ncontrol_id = \"QuitButton\"\nprops = { text = \"Return To Title\", background = { color = \"#341f24\" }, border = { color = \"#ff9787\", width = 1.0, radius = 10.0 }, foreground = { color = \"#fff0ec\" } }\nlayout = { width = { min = 280.0, preferred = 280.0, max = 280.0, stretch = \"Fixed\" }, height = { min = 52.0, preferred = 52.0, max = 52.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.0 }, position = { x = 0.0, y = 104.0 } }\n\n[nodes.hint_label]\ncomponent = \"Label\"\ncontrol_id = \"PauseHint\"\nprops = { text = \"Press Esc to close\", opacity = 0.85, foreground = { color = \"#f7dfc3\" } }\nlayout = { width = { min = 240.0, preferred = 240.0, max = 240.0, stretch = \"Fixed\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" }, anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.0 }, position = { x = 0.0, y = 188.0 } }\n"

