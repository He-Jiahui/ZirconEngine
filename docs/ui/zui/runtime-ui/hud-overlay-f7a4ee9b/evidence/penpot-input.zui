penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/runtime/fixtures/hud_overlay.zui\"\nversion = 2\ndisplay_name = \"Runtime HUD Overlay\"\n\n[imports]\nwidgets = []\nstyles = []\n\n[root]\nnode = \"hud_root\"\n\n[nodes.hud_root]\ncomponent = \"Overlay\"\ncontrol_id = \"HudRoot\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"Overlay\" } }\nchildren = [{ node = \"health_panel\" }, { node = \"quest_label\" }, { node = \"weapon_icon\" }, { node = \"ammo_panel\" }]\n\n[nodes.health_panel]\ncomponent = \"Container\"\ncontrol_id = \"HealthPanel\"\nprops = { text = \"HP 87 / 100\", background = { color = \"#8e2f2f\" }, border = { color = \"#f4c37d\", width = 2.0, radius = 12.0 }, foreground = { color = \"#fff4de\" } }\nlayout = { width = { min = 240.0, preferred = 240.0, max = 240.0, stretch = \"Fixed\" }, height = { min = 72.0, preferred = 72.0, max = 72.0, stretch = \"Fixed\" }, anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 24.0, y = 24.0 } }\n\n[nodes.quest_label]\ncomponent = \"Label\"\ncontrol_id = \"QuestLabel\"\nprops = { text = \"Reach the relay before sunrise\", opacity = 0.95, foreground = { color = \"#f7f1d0\" } }\nlayout = { width = { min = 260.0, preferred = 260.0, max = 260.0, stretch = \"Fixed\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, anchor = { x = 1.0, y = 0.0 }, pivot = { x = 1.0, y = 0.0 }, position = { x = -28.0, y = 28.0 } }\n\n[nodes.weapon_icon]\ncomponent = \"Icon\"\ncontrol_id = \"WeaponIcon\"\nprops = { icon = \"pulse-rifle\", foreground = { color = \"#d8eefc\" } }\nlayout = { width = { min = 56.0, preferred = 56.0, max = 56.0, stretch = \"Fixed\" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = \"Fixed\" }, anchor = { x = 1.0, y = 1.0 }, pivot = { x = 1.0, y = 1.0 }, position = { x = -28.0, y = -28.0 } }\n\n[nodes.ammo_panel]\ncomponent = \"Container\"\ncontrol_id = \"AmmoPanel\"\nprops = { text = \"24 / 120\", background = { color = \"#20384b\" }, border = { color = \"#6dc5ff\", width = 1.0, radius = 10.0 }, foreground = { color = \"#e6f5ff\" } }\nlayout = { width = { min = 180.0, preferred = 180.0, max = 180.0, stretch = \"Fixed\" }, height = { min = 52.0, preferred = 52.0, max = 52.0, stretch = \"Fixed\" }, anchor = { x = 1.0, y = 1.0 }, pivot = { x = 1.0, y = 1.0 }, position = { x = -96.0, y = -30.0 } }\n"

