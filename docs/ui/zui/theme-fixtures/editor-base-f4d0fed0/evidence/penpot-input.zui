penpot_dependency_sources = [ "zircon_editor/src/tests/fixtures/ui_zui/theme/editor_material.zui" ]
penpot_original_source = "[asset]\nkind = \"style\"\nid = \"ui.theme.editor_base\"\nversion = 1\ndisplay_name = \"Editor Base\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/theme/editor_material.zui\"]\n\n[tokens]\naccent = \"#4d89ff\"\npanel_bg = \"#20252d\"\nshell_bg = \"#171a20\"\ntitle = \"#eef3ff\"\n\n[components]\n\n[[stylesheets]]\nid = \"editor_base\"\n\n[[stylesheets.rules]]\nselector = \".editor-shell\"\n\n[stylesheets.rules.set.self.background]\ncolor = \"$shell_bg\"\n\n[stylesheets.rules.set.slot]\n\n[[stylesheets.rules]]\nselector = \".panel\"\n\n[stylesheets.rules.set.self.background]\ncolor = \"$panel_bg\"\n\n[stylesheets.rules.set.slot]\n\n[[stylesheets.rules]]\nselector = \".section-title\"\n\n[stylesheets.rules.set.self]\ntext = \"$title\"\n\n[stylesheets.rules.set.slot]\n\n[[stylesheets.rules]]\nselector = \".toolbar > Button.toolbar-primary\"\n\n[stylesheets.rules.set.self.background]\ncolor = \"$accent\"\n\n[stylesheets.rules.set.slot]\n\n[[stylesheets.rules]]\nselector = \"#DesignerLabel\"\n\n[stylesheets.rules.set.self]\ntext = \"Canvas Preview\"\n\n[stylesheets.rules.set.slot]\n"

