penpot_original_source = "[asset]\r\nkind = \"view\"\r\nid = \"particles.preview\"\r\nversion = 2\r\ndisplay_name = \"Particle Preview\"\r\n\r\n[imports]\r\nstyles = [\"res://ui/theme/editor_base.zui\"]\r\n\r\n[root]\r\nnode = \"particles_preview_root\"\r\n\r\n[nodes.particles_preview_viewport]\r\ncomponent = \"Space\"\r\ncontrol_id = \"ParticlesPreviewViewport\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.particles_preview_transport]\r\ncomponent = \"Space\"\r\ncontrol_id = \"ParticlesPreviewTransport\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.particles_preview_stats]\r\ncomponent = \"Space\"\r\ncontrol_id = \"ParticlesPreviewStats\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 64.0, preferred = 64.0, max = 64.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.particles_preview_root]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"ParticlesPreviewRoot\"\r\nclasses = [\"editor-shell\"]\r\nlayout = { container = { kind = \"VerticalBox\", gap = 8 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"particles_preview_viewport\" }, { node = \"particles_preview_transport\" }, { node = \"particles_preview_stats\" }]\r\n"

[asset]
kind = "view"
id = "particles.preview"
version = 2
display_name = "Particle Preview"

[imports]
styles = [ "res://ui/theme/editor_base.zui" ]

[root]
node = "particles_preview_root"

[nodes.particles_preview_viewport]
component = "Space"
control_id = "ParticlesPreviewViewport"

[nodes.particles_preview_viewport.layout.width]
stretch = "Stretch"

[nodes.particles_preview_viewport.layout.height]
stretch = "Stretch"

[nodes.particles_preview_transport]
component = "Space"
control_id = "ParticlesPreviewTransport"

[nodes.particles_preview_transport.layout.width]
stretch = "Stretch"

[nodes.particles_preview_transport.layout.height]
min = 36
preferred = 36
max = 36
stretch = "Fixed"

[nodes.particles_preview_stats]
component = "Space"
control_id = "ParticlesPreviewStats"

[nodes.particles_preview_stats.layout.width]
stretch = "Stretch"

[nodes.particles_preview_stats.layout.height]
min = 64
preferred = 64
max = 64
stretch = "Fixed"

[nodes.particles_preview_root]
component = "VerticalGroup"
control_id = "ParticlesPreviewRoot"
classes = [ "editor-shell" ]

[nodes.particles_preview_root.layout.container]
kind = "VerticalBox"
gap = 8

[nodes.particles_preview_root.layout.width]
stretch = "Stretch"

[nodes.particles_preview_root.layout.height]
stretch = "Stretch"

[[nodes.particles_preview_root.children]]
node = "particles_preview_viewport"

[[nodes.particles_preview_root.children]]
node = "particles_preview_transport"

[[nodes.particles_preview_root.children]]
node = "particles_preview_stats"
