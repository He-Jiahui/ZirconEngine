fixture_data_only = true
reference_primary = "https://pro.reactbits.dev/docs/app-ui/app-shell/app-shell-4"
reference_supporting = [ "https://pro.reactbits.dev/docs/app-ui/ai-chat/ai-chat-1", "https://pro.reactbits.dev/docs/app-ui/agent-activity/agent-activity-2", "https://pro.reactbits.dev/docs/app-ui/tool-calls/tool-calls-2", "https://pro.reactbits.dev/docs/app-ui/agent-approval" ]
