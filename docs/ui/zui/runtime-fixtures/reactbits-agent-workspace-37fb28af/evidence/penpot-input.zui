control_id = "ReactBitsAgentApprovalBody"

[nodes.approval_body.props]
text = "The agent wants to write the generated layout into the project."
foreground_color = "$text.primary"
font_size = 10
wrap = "word"
text_overflow = "clip"

[nodes.approval_body.layout.width]
stretch = "Stretch"

[nodes.approval_body.layout.height]
min = 26
preferred = 32
max = 42
stretch = "Fixed"

[nodes.approval_scope]
component = "Label"
control_id = "ReactBitsAgentApprovalScope"

[nodes.approval_scope.props]
text = "Scope: zircon_runtime/tests/fixtures/ui  ·  reversible"
foreground_color = "$text.secondary"
font_size = 10
wrap = "word"
text_overflow = "clip"

[nodes.approval_scope.layout.width]
stretch = "Stretch"

[nodes.approval_scope.layout.height]
min = 26
preferred = 30
max = 38
stretch = "Fixed"

[nodes.approval_actions]
component = "HorizontalBox"
control_id = "ReactBitsAgentApprovalActions"

[nodes.approval_actions.layout.width]
stretch = "Stretch"

[nodes.approval_actions.layout.height]
min = 32
preferred = 34
max = 38
stretch = "Fixed"

[nodes.approval_actions.layout.container]
kind = "HorizontalBox"
gap = 6

[[nodes.approval_actions.children]]
node = "approval_reject"

[[nodes.approval_actions.children]]
node = "approval_spacer"

[[nodes.approval_actions.children]]
node = "approval_allow"

[nodes.approval_reject]
component = "Button"
control_id = "ReactBitsAgentApprovalReject"

[nodes.approval_reject.props]
text = "Deny"
button_variant = "outlined"
foreground_color = "$text.secondary"
border_color = "$border.strong"
border_width = 1
corner_radius = 5
input_interactive = true
input_focusable = true
accessibility_label = "Deny agent write"

[nodes.approval_reject.layout.width]
min = 54
preferred = 60
max = 70
stretch = "Fixed"

[nodes.approval_reject.layout.height]
stretch = "Stretch"

[[nodes.approval_reject.events]]
id = "ReactBitsAgent/ApprovalDeny"
event = "Click"
route = "agent.approval.deny"

[nodes.approval_spacer]
component = "Space"
control_id = "ReactBitsAgentApprovalSpacer"

[nodes.approval_spacer.layout.width]
stretch = "Stretch"

[nodes.approval_spacer.layout.height]
stretch = "Stretch"

[nodes.approval_allow]
component = "Button"
control_id = "ReactBitsAgentApprovalAllow"

[nodes.approval_allow.props]
text = "Allow write"
button_variant = "contained"
background_color = "$status.warning"
foreground_color = "$surface.canvas"
corner_radius = 5
input_interactive = true
input_focusable = true
accessibility_label = "Allow agent write"

[nodes.approval_allow.layout.width]
min = 86
preferred = 98
max = 112
stretch = "Fixed"

[nodes.approval_allow.layout.height]
stretch = "Stretch"

[[nodes.approval_allow.events]]
id = "ReactBitsAgent/ApprovalAllow"
event = "Click"
route = "agent.approval.allow"

[nodes.usage_card]
component = "VerticalBox"
control_id = "ReactBitsAgentUsageCard"
classes = [ "rb-card", "rb-usage" ]

[nodes.usage_card.props]
background_color = "$surface.elevated"
border_color = "$border.default"
border_width = 1
corner_radius = 8

[nodes.usage_card.layout.width]
stretch = "Stretch"

[nodes.usage_card.layout.height]
min = 76
preferred = 88
max = 104
stretch = "Fixed"

[nodes.usage_card.layout.container]
kind = "VerticalBox"
gap = 6

[nodes.usage_card.layout.padding]
left = 10
right = 10
top = 10
bottom = 10

[[nodes.usage_card.children]]
node = "usage_title"

[[nodes.usage_card.children]]
node = "usage_bar"

[[nodes.usage_card.children]]
node = "usage_detail"

[nodes.usage_title]
component = "Label"
control_id = "ReactBitsAgentUsageTitle"

[nodes.usage_title.props]
text = "AI usage"
foreground_color = "$text.primary"
font_size = 11
font_weight = 650

[nodes.usage_title.layout.width]
stretch = "Stretch"

[nodes.usage_title.layout.height]
min = 18
preferred = 18
max = 18
stretch = "Fixed"

[nodes.usage_bar]
component = "HorizontalBox"
control_id = "ReactBitsAgentUsageBar"

[nodes.usage_bar.props]
background_color = "$surface.inset"
border_color = "$border.default"
border_width = 1
corner_radius = 4

[nodes.usage_bar.layout.width]
stretch = "Stretch"

[nodes.usage_bar.layout.height]
min = 8
preferred = 8
max = 8
stretch = "Fixed"

[nodes.usage_bar.layout.container]
kind = "HorizontalBox"
gap = 0

[[nodes.usage_bar.children]]
node = "usage_bar_fill"

[[nodes.usage_bar.children]]
node = "usage_bar_rest"

[nodes.usage_bar_fill]
component = "Space"
control_id = "ReactBitsAgentUsageBarFill"

[nodes.usage_bar_fill.props]
background_color = "$accent.primary"
corner_radius = 4

[nodes.usage_bar_fill.layout.width]
min = 0
preferred = 38
weight = 0.39
stretch = "Stretch"

[nodes.usage_bar_fill.layout.height]
stretch = "Stretch"

[nodes.usage_bar_rest]
component = "Space"
control_id = "ReactBitsAgentUsageBarRest"

[nodes.usage_bar_rest.props]
background_color = "$surface.inset"

[nodes.usage_bar_rest.layout.width]
min = 0
preferred = 60
weight = 0.61
stretch = "Stretch"

[nodes.usage_bar_rest.layout.height]
stretch = "Stretch"

[nodes.usage_detail]
component = "Label"
control_id = "ReactBitsAgentUsageDetail"

[nodes.usage_detail.props]
text = "12.4k used  ·  19.6k remaining  ·  $0.08"
foreground_color = "$text.secondary"
font_size = 10
text_overflow = "elide"

[nodes.usage_detail.layout.width]
stretch = "Stretch"

[nodes.usage_detail.layout.height]
min = 18
preferred = 18
max = 18
stretch = "Fixed"

[[stylesheets]]
id = "reactbits-ui-typography"

[[stylesheets.rules]]
selector = "*"

[stylesheets.rules.set.self.font]
asset = "res://fonts/editor-ui.font.toml"
family = "Fira Sans"

[penpot_original_imports]
[imports]
widgets = []
styles = []
