r = \"$status.warning\", font_size = 11, font_weight = 700 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" } }\n\n[nodes.approval_body]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentApprovalBody\"\nprops = { text = \"The agent wants to write the generated layout into the project.\", foreground_color = \"$text.primary\", font_size = 10, wrap = \"word\", text_overflow = \"clip\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 26, preferred = 32, max = 42, stretch = \"Fixed\" } }\n\n[nodes.approval_scope]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentApprovalScope\"\nprops = { text = \"Scope: zircon_runtime/tests/fixtures/ui  ·  reversible\", foreground_color = \"$text.secondary\", font_size = 10, wrap = \"word\", text_overflow = \"clip\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 26, preferred = 30, max = 38, stretch = \"Fixed\" } }\n\n[nodes.approval_actions]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAgentApprovalActions\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 34, max = 38, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 6 } }\nchildren = [{ node = \"approval_reject\" }, { node = \"approval_spacer\" }, { node = \"approval_allow\" }]\n\n[nodes.approval_reject]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentApprovalReject\"\nprops = { text = \"Deny\", button_variant = \"outlined\", foreground_color = \"$text.secondary\", border_color = \"$border.strong\", border_width = 1, corner_radius = 5, input_interactive = true, input_focusable = true, accessibility_label = \"Deny agent write\" }\nlayout = { width = { min = 54, preferred = 60, max = 70, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ReactBitsAgent/ApprovalDeny\", event = \"Click\", route = \"agent.approval.deny\" }]\n\n[nodes.approval_spacer]\ncomponent = \"Space\"\ncontrol_id = \"ReactBitsAgentApprovalSpacer\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.approval_allow]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentApprovalAllow\"\nprops = { text = \"Allow write\", button_variant = \"contained\", background_color = \"$status.warning\", foreground_color = \"$surface.canvas\", corner_radius = 5, input_interactive = true, input_focusable = true, accessibility_label = \"Allow agent write\" }\nlayout = { width = { min = 86, preferred = 98, max = 112, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ReactBitsAgent/ApprovalAllow\", event = \"Click\", route = \"agent.approval.allow\" }]\n\n[nodes.usage_card]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentUsageCard\"\nclasses = [\"rb-card\", \"rb-usage\"]\nprops = { background_color = \"$surface.elevated\", border_color = \"$border.default\", border_width = 1, corner_radius = 8 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 76, preferred = 88, max = 104, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 6 }, padding = { left = 10, right = 10, top = 10, bottom = 10 } }\nchildren = [{ node = \"usage_title\" }, { node = \"usage_bar\" }, { node = \"usage_detail\" }]\n\n[nodes.usage_title]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentUsageTitle\"\nprops = { text = \"AI usage\", foreground_color = \"$text.primary\", font_size = 11, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" } }\n\n[nodes.usage_bar]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAgentUsageBar\"\nprops = { background_color = \"$surface.inset\", border_color = \"$border.default\", border_width = 1, corner_radius = 4 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 8, preferred = 8, max = 8, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 0 } }\nchildren = [{ node