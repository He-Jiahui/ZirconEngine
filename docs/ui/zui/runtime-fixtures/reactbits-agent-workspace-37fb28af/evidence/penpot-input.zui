penpot_dependency_sources = []
penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/tests/reactbits_agent_workspace.zui\"\nversion = 2\ndisplay_name = \"ReactBits Agent Workspace\"\n\n[tokens]\n\"surface.canvas\" = \"#0f1117\"\n\"surface.panel\" = \"#171b24\"\n\"surface.elevated\" = \"#1d2330\"\n\"surface.inset\" = \"#11151d\"\n\"border.default\" = \"#2a3342\"\n\"border.strong\" = \"#3a4658\"\n\"text.primary\" = \"#f4f7fb\"\n\"text.secondary\" = \"#a9b4c5\"\n\"text.muted\" = \"#718096\"\n\"accent.primary\" = \"#8b7cff\"\n\"accent.info\" = \"#5da9ff\"\n\"status.success\" = \"#55d6a0\"\n\"status.warning\" = \"#f4bd62\"\n\"status.error\" = \"#ff7d8a\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\ncomponent = \"Stack\"\ncontrol_id = \"ReactBitsAgentWorkspaceRoot\"\nclasses = [\"rb-shell\"]\nprops = {\n  background_color = \"$surface.canvas\",\n  foreground_color = \"$text.primary\",\n  fixture_data_only = true,\n  direction = { xs = \"column\", md = \"row\" },\n  spacing = { xs = 1.5, md = 1.5 },\n  reference_primary = \"https://pro.reactbits.dev/docs/app-ui/app-shell/app-shell-4\",\n  reference_supporting = [\n    \"https://pro.reactbits.dev/docs/app-ui/ai-chat/ai-chat-1\",\n    \"https://pro.reactbits.dev/docs/app-ui/agent-activity/agent-activity-2\",\n    \"https://pro.reactbits.dev/docs/app-ui/tool-calls/tool-calls-2\",\n    \"https://pro.reactbits.dev/docs/app-ui/agent-approval\",\n  ],\n  responsive_wide = \"sidebar + conversation + context panel\",\n  responsive_intermediate = \"icon rail + conversation + context drawer\",\n  responsive_compact = \"context panel moves below the conversation\",\n  responsive_mobile = \"sidebar collapses to a host-owned priority dock; composer stays primary\",\n  layout_modes = [\"full-shell\", \"adaptive-rail\", \"three-column\", \"master-detail\", \"mobile-bottom-actions\"],\n}\nlayout = {\n  clip = true,\n  input_policy = \"Receive\",\n  width = { min = 640, preferred = 1280, max = 1600, stretch = \"Stretch\" },\n  height = { min = 520, preferred = 800, max = 1000, stretch = \"Stretch\" },\n}\nchildren = [\n  { node = \"sidebar\", slot = { layout = { width = { min = 220, preferred = 232, max = 260, stretch = \"Fixed\" } } } },\n  { node = \"main\", slot = { layout = { width = { min = 440, preferred = 700, weight = 1, stretch = \"Stretch\" } } } },\n  { node = \"context\", slot = { layout = { width = { min = 280, preferred = 320, max = 360, stretch = \"Fixed\" } } } },\n]\n\n[nodes.sidebar]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentSidebar\"\nclasses = [\"rb-panel\", \"rb-sidebar\"]\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 10, responsive_min_tier = \"regular\", display = { xs = \"none\", md = \"flex\" } }\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 10 }, padding = { left = 14, right = 14, top = 14, bottom = 14 } }\nchildren = [\n  { node = \"sidebar_brand\" },\n  { node = \"new_session\" },\n  { node = \"sidebar_nav\" },\n  { node = \"sidebar_history\" },\n  { node = \"sidebar_footer\" },\n]\n\n[nodes.sidebar_brand]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAgentSidebarBrand\"\nprops = { background_color = \"$surface.elevated\", corner_radius = 8, border_color = \"$border.default\", border_width = 1 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 42, preferred = 42, max = 42, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 }, padding = { left = 10, right = 10, top = 8, bottom = 8 } }\nchildren = [\n  { node = \"brand_mark\" },\n  { node = \"brand_title\" },\n  { node = \"brand_status\" },\n]\n\n[nodes.brand_mark]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentBrandMark\"\nprops = { text = \"Z\", foreground_color = \"$accent.primary\", font_size = 18, font_weight = 700, accessibility_label = \"Zircon\" }\nlayout = { width = { min = 22, preferred = 22, max = 22, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.brand_title]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentBrandTitle\"\nprops = { text = \"Zircon Agent\", foreground_color = \"$text.primary\", font_size = 13, font_weight = 650, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.brand_status]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentBrandStatus\"\nprops = { text = \"●\", foreground_color = \"$status.success\", font_size = 12, accessibility_label = \"Connected\" }\nlayout = { width = { min = 16, preferred = 16, max = 16, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.new_session]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentNewSession\"\nclasses = [\"rb-primary-action\"]\nprops = { text = \"+  New session\", button_variant = \"contained\", background_color = \"$accent.primary\", foreground_color = \"$text.primary\", corner_radius = 8, border_width = 0, input_interactive = true, input_focusable = true, accessibility_label = \"Create new agent session\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 38, preferred = 38, max = 38, stretch = \"Fixed\" } }\nevents = [{ id = \"ReactBitsAgent/NewSession\", event = \"Click\", route = \"agent.session.create\" }]\n\n[nodes.sidebar_nav]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentSidebarNav\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 154, preferred = 154, max = 154, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 4 } }\nchildren = [\n  { node = \"nav_label\" },\n  { node = \"nav_home\" },\n  { node = \"nav_runs\" },\n  { node = \"nav_artifacts\" },\n  { node = \"nav_settings\" },\n]\n\n[nodes.nav_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentNavLabel\"\nprops = { text = \"WORKSPACE\", foreground_color = \"$text.muted\", font_size = 10, font_weight = 700, letter_spacing = 1.2 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" } }\n\n[nodes.nav_home]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentNavHome\"\nprops = { text = \"⌂  Overview\", button_variant = \"text\", background_color = \"$surface.elevated\", foreground_color = \"$text.primary\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30, preferred = 30, max = 30, stretch = \"Fixed\" } }\n\n[nodes.nav_runs]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentNavRuns\"\nprops = { text = \"◌  Agent runs\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30, preferred = 30, max = 30, stretch = \"Fixed\" } }\n\n[nodes.nav_artifacts]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentNavArtifacts\"\nprops = { text = \"◇  Artifacts\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30, preferred = 30, max = 30, stretch = \"Fixed\" } }\n\n[nodes.nav_settings]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentNavSettings\"\nprops = { text = \"⚙  Settings\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30, preferred = 30, max = 30, stretch = \"Fixed\" } }\n\n[nodes.sidebar_history]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"ReactBitsAgentConversationHistory\"\nprops = { background_color = \"$surface.inset\", border_color = \"$border.default\", border_width = 1, corner_radius = 8 }\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { min = 120, preferred = 240, weight = 1, stretch = \"Stretch\" }, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 4, scrollbar_visibility = \"Auto\" }, padding = { left = 8, right = 8, top = 8, bottom = 8 } }\nchildren = [\n  { node = \"history_label\" },\n  { node = \"history_current\" },\n  { node = \"history_previous\" },\n  { node = \"history_old\" },\n]\n\n[nodes.history_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentHistoryLabel\"\nprops = { text = \"RECENT SESSIONS\", foreground_color = \"$text.muted\", font_size = 10, font_weight = 700, letter_spacing = 1.1 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" } }\n\n[nodes.history_current]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentHistoryCurrent\"\nprops = { text = \"UI parity review\", button_variant = \"text\", background_color = \"$accent.primary\", foreground_color = \"$text.primary\", corner_radius = 6, text_align = \"left\", selected = true, input_interactive = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\n\n[nodes.history_previous]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentHistoryPrevious\"\nprops = { text = \"Penpot importer\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\n\n[nodes.history_old]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentHistoryOld\"\nprops = { text = \"Runtime layout audit\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\n\n[nodes.sidebar_footer]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentSidebarFooter\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 56, preferred = 56, max = 56, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 4 } }\nchildren = [{ node = \"connection_text\" }, { node = \"usage_text\" }]\n\n[nodes.connection_text]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentConnectionText\"\nprops = { text = \"Runtime connected · local\", foreground_color = \"$text.secondary\", font_size = 11, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 22, preferred = 22, max = 22, stretch = \"Fixed\" } }\n\n[nodes.usage_text]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentUsageText\"\nprops = { text = \"12.4k / 32k context tokens\", foreground_color = \"$text.muted\", font_size = 10, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 22, preferred = 22, max = 22, stretch = \"Fixed\" } }\n\n[nodes.main]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentMain\"\nclasses = [\"rb-main\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 12 } }\nchildren = [{ node = \"main_header\" }, { node = \"conversation\" }, { node = \"context_summary\" }, { node = \"composer\" }]\n\n[nodes.main_header]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAgentMainHeader\"\nclasses = [\"rb-panel\"]\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 10 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 52, preferred = 52, max = 52, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 10 }, padding = { left = 14, right = 10, top = 8, bottom = 8 } }\nchildren = [{ node = \"header_title_stack\" }, { node = \"model_picker\" }, { node = \"header_context\" }, { node = \"header_more\" }]\n\n[nodes.header_title_stack]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentHeaderTitleStack\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 2 } }\nchildren = [{ node = \"header_title\" }, { node = \"header_subtitle\" }]\n\n[nodes.header_title]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentHeaderTitle\"\nprops = { text = \"UI parity review\", foreground_color = \"$text.primary\", font_size = 14, font_weight = 650, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" } }\n\n[nodes.header_subtitle]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentHeaderSubtitle\"\nprops = { text = \"Agent run · 4 steps · streaming\", foreground_color = \"$text.secondary\", font_size = 10, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 16, max = 16, stretch = \"Fixed\" } }\n\n[nodes.model_picker]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentModelPicker\"\nprops = { text = \"Claude Sonnet 4  ▾\", button_variant = \"outlined\", background_color = \"$surface.elevated\", foreground_color = \"$text.secondary\", border_color = \"$border.strong\", border_width = 1, corner_radius = 6, input_interactive = true, input_focusable = true, accessibility_label = \"Choose model\" }\nlayout = { width = { min = 144, preferred = 168, max = 188, stretch = \"Fixed\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\n\n[nodes.header_context]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentHeaderContext\"\nprops = { text = \"12.4k tokens\", foreground_color = \"$accent.info\", font_size = 10, text_align = \"right\", text_overflow = \"elide\" }\nlayout = { width = { min = 72, preferred = 86, max = 104, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_more]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAgentHeaderMore\"\nprops = { text = \"···\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, input_interactive = true, input_focusable = true, accessibility_label = \"Conversation actions\" }\nlayout = { width = { min = 34, preferred = 34, max = 34, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.conversation]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"ReactBitsAgentConversation\"\nclasses = [\"rb-panel\", \"rb-conversation\"]\nprops = { background_color = \"$surface.inset\", border_color = \"$border.default\", border_width = 1, corner_radius = 10 }\nlayout = { clip = true, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { min = 300, preferred = 560, weight = 1, stretch = \"Stretch\" }, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 12, scrollbar_visibility = \"Auto\" }, padding = { left = 18, right = 18, top = 18, bottom = 18 } }\nchildren = [{ node = \"user_message\" }, { node = \"assistant_message\" }, { node = \"followup_message\" }]\n\n[nodes.user_message]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentUserMessage\"\nclasses = [\"rb-message\", \"rb-user-message\"]\nprops = { background_color = \"$surface.elevated\", border_color = \"$border.default\", border_width = 1, corner_radius = 8 }\nlayout = { width = { min = 0, stretch = \"Stretch\" }, height = { min = 64, preferred = 76, max = 96, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 6 }, padding = { left = 12, right = 12, top = 10, bottom = 10 } }\nchildren = [{ node = \"user_message_meta\" }, { node = \"user_message_text\" }]\n\n[nodes.user_message_meta]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentUserMeta\"\nprops = { text = \"You  ·  just now\", foreground_color = \"$text.muted\", font_size = 10, font_weight = 600 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 16, max = 16, stretch = \"Fixed\" } }\n\n[nodes.user_message_text]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentUserText\"\nprops = { text = \"Recreate the ReactBits agent workspace in ZUI and verify the layout in Penpot.\", foreground_color = \"$text.primary\", font_size = 13, wrap = \"word\", text_overflow = \"clip\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 38, max = 52, stretch = \"Fixed\" } }\n\n[nodes.assistant_message]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentAssistantMessage\"\nclasses = [\"rb-message\", \"rb-assistant-message\"]\nprops = { background_color = \"$surface.panel\", border_color = \"$border.strong\", border_width = 1, corner_radius = 8 }\nlayout = { width = { min = 0, stretch = \"Stretch\" }, height = { min = 290, preferred = 360, max = 440, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 10 }, padding = { left = 14, right = 14, top = 12, bottom = 12 } }\nchildren = [{ node = \"assistant_header\" }, { node = \"reasoning\" }, { node = \"tool_call\" }, { node = \"assistant_body\" }, { node = \"sources\" }]\n\n[nodes.assistant_header]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAgentAssistantHeader\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24, preferred = 24, max = 24, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 } }\nchildren = [{ node = \"assistant_avatar\" }, { node = \"assistant_name\" }, { node = \"assistant_streaming\" }]\n\n[nodes.assistant_avatar]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentAssistantAvatar\"\nprops = { text = \"✦\", foreground_color = \"$accent.primary\", font_size = 16, accessibility_label = \"Assistant\" }\nlayout = { width = { min = 22, preferred = 22, max = 22, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.assistant_name]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentAssistantName\"\nprops = { text = \"Zircon Agent\", foreground_color = \"$text.primary\", font_size = 12, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.assistant_streaming]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentAssistantStreaming\"\nprops = { text = \"STREAMING\", foreground_color = \"$accent.info\", font_size = 9, font_weight = 700, letter_spacing = 1 }\nlayout = { width = { min = 66, preferred = 66, max = 66, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.reasoning]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentReasoning\"\nclasses = [\"rb-disclosure\", \"rb-reasoning-expanded\"]\nprops = { background_color = \"$surface.inset\", border_color = \"$border.default\", border_width = 1, corner_radius = 6, disclosure_state = \"expanded\", accessible_role = \"group\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 58, preferred = 68, max = 84, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 5 }, padding = { left = 10, right = 10, top = 8, bottom = 8 } }\nchildren = [{ node = \"reasoning_summary\" }, { node = \"reasoning_detail\" }]\n\n[nodes.reasoning_summary]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentReasoningSummary\"\nprops = { text = \"⌄  Reasoning  ·  2.4s\", foreground_color = \"$text.secondary\", font_size = 10, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 16, max = 16, stretch = \"Fixed\" } }\n\n[nodes.reasoning_detail]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentReasoningDetail\"\nprops = { text = \"Comparing retained layout slots with the three-column reference and preserving a single scroll owner.\", foreground_color = \"$text.muted\", font_size = 10, wrap = \"word\", text_overflow = \"clip\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24, preferred = 30, max = 38, stretch = \"Fixed\" } }\n\n[nodes.tool_call]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentToolCall\"\nclasses = [\"rb-tool-call\", \"rb-tool-call-running\"]\nprops = { background_color = \"$surface.elevated\", border_color = \"$accent.info\", border_width = 1, corner_radius = 6, status = \"running\", disclosure_state = \"expanded\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 66, preferred = 76, max = 92, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 5 }, padding = { left = 10, right = 10, top = 8, bottom = 8 } }\nchildren = [{ node = \"tool_call_header\" }, { node = \"tool_call_output\" }]\n\n[nodes.tool_call_header]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAgentToolCallHeader\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 6 } }\nchildren = [{ node = \"tool_call_name\" }, { node = \"tool_call_status\" }, { node = \"tool_call_elapsed\" }]\n\n[nodes.tool_call_name]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentToolCallName\"\nprops = { text = \"▣  zui.inspect_layout\", foreground_color = \"$text.primary\", font_size = 11, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.tool_call_status]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentToolCallStatus\"\nprops = { text = \"running\", foreground_color = \"$accent.info\", font_size = 10, font_weight = 650 }\nlayout = { width = { min = 54, preferred = 54, max = 54, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.tool_call_elapsed]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentToolCallElapsed\"\nprops = { text = \"1.8s\", foreground_color = \"$text.muted\", font_size = 10, text_align = \"right\" }\nlayout = { width = { min = 34, preferred = 34, max = 34, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.tool_call_output]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentToolCallOutput\"\nprops = { text =