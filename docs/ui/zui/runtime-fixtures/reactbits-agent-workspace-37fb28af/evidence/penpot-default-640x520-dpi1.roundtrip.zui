layout = { width = { min = 0, preferred = 60, weight = 0.61, stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.usage_detail]
component = "Label"
control_id = "ReactBitsAgentUsageDetail"
props = { text = "12.4k used  ·  19.6k remaining  ·  $0.08", foreground_color = "$text.secondary", font_size = 10, text_overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 18, preferred = 18, max = 18, stretch = "Fixed" } }

[nodes.root.zircon_extension]
owner = "reactbits-reference-slice"
reference_profile = "reactbits-app-ui-agent-workspace-v1"
source_of_truth = "zui"
penpot_visual_check = "required"

[[stylesheets]]
id = "reactbits-ui-typography"

[[stylesheets.rules]]
selector = "*"
set = { self = { font = { asset = "res://fonts/editor-ui.font.toml", family = "Fira Sans" } } }
