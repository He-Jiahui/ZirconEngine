[asset]
kind = "view"
id = "res://ui/tests/reactbits_agent_workspace.zui"
version = 2
display_name = "ReactBits Agent Workspace"

[tokens]
"surface.canvas" = "#0f1117"
"surface.panel" = "#171b24"
"surface.elevated" = "#1d2330"
"surface.inset" = "#11151d"
"border.default" = "#2a3342"
"border.strong" = "#3a4658"
"text.primary" = "#f4f7fb"
"text.secondary" = "#a9b4c5"
"text.muted" = "#718096"
"accent.primary" = "#8b7cff"
"accent.info" = "#5da9ff"
"status.success" = "#55d6a0"
"status.warning" = "#f4bd62"
"status.error" = "#ff7d8a"

[root]
node = "root"

[nodes.root]
component = "Stack"
control_id = "ReactBitsAgentWorkspaceRoot"
classes = ["rb-shell"]
props = {
  background_color = "$surface.canvas",
  foreground_color = "$text.primary",
  fixture_data_only = true,
  direction = { xs = "column", md = "row" },
  spacing = { xs = 1.5, md = 1.5 },
  reference_primary = "https://pro.reactbits.dev/docs/app-ui/app-shell/app-shell-4",
  reference_supporting = [
    "https://pro.reactbits.dev/docs/app-ui/ai-chat/ai-chat-1",
    "https://pro.reactbits.dev/docs/app-ui/agent-activity/agent-activity-2",
    "https://pro.reactbits.dev/docs/app-ui/tool-calls/tool-calls-2",
    "https://pro.reactbits.dev/docs/app-ui/agent-approval",
  ],
  responsive_wide = "sidebar + conversation + context panel",
  responsive_intermediate = "icon rail + conversation + context drawer",
  responsive_compact = "context panel moves below the conversation",
  responsive_mobile = "sidebar collapses to a host-owned priority dock; composer stays primary",
  layout_modes = ["full-shell", "adaptive-rail", "three-column", "master-detail", "mobile-bottom-actions"],
}
layout = {
  clip = true,
  input_policy = "Receive",
  width = { min = 640, preferred = 1280, max = 1600, stretch = "Stretch" },
  height = { min = 520, preferred = 800, max = 1000, stretch = "Stretch" },
}
children = [
  { node = "sidebar", slot = { layout = { width = { min = 220, preferred = 232, max = 260, stretch = "Fixed" } } } },
  { node = "main", slot = { layout = { width = { min = 440, preferred = 700, weight = 1, stretch = "Stretch" } } } },
  { node = "context", slot = { layout = { width = { min = 280, preferred = 320, max = 360, stretch = "Fixed" } } } },
]

[nodes.sidebar]
component = "VerticalBox"
control_id = "ReactBitsAgentSidebar"
classes = ["rb-panel", "rb-sidebar"]
props = { background_color = "$surface.panel", border_color = "$border.default", border_width = 1, corner_radius = 10, responsive_min_tier = "regular", display = { xs = "none", md = "flex" } }
layout = { clip = true, width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "VerticalBox", gap = 10 }, padding = { left = 14, right = 14, top = 14, bottom = 14 } }
children = [
  { node = "sidebar_brand" },
  { node = "new_session" },
  { node = "sidebar_nav" },
  { node = "sidebar_history" },
  { node = "sidebar_footer" },
]

[nodes.sidebar_brand]
component = "HorizontalBox"
control_id = "ReactBitsAgentSidebarBrand"
props = { background_color = "$surface.elevated", corner_radius = 8, border_color = "$border.default", border_width = 1 }
layout = { width = { stretch = "Stretch" }, height = { min = 42, preferred = 42, max = 42, stretch = "Fixed" }, container = { kind = "HorizontalBox", gap = 8 }, padding = { left = 10, right = 10, top = 8, bottom = 8 } }
children = [
  { node = "brand_mark" },
  { node = "brand_title" },
  { node = "brand_status" },
]

[nodes.brand_mark]
component = "Label"
control_id = "ReactBitsAgentBrandMark"
props = { text = "Z", foreground_color = "$accent.primary", font_size = 18, font_weight = 700, accessibility_label = "Zircon" }
layout = { width = { min = 22, preferred = 22, max = 22, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.brand_title]
component = "Label"
control_id = "ReactBitsAgentBrandTitle"
props = { text = "Zircon Agent", foreground_color = "$text.primary", font_size = 13, font_weight = 650, text_overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.brand_status]
component = "Label"
control_id = "ReactBitsAgentBrandStatus"
props = { text = "●", foreground_color = "$status.success", font_size = 12, accessibility_label = "Connected" }
layout = { width = { min = 16, preferred = 16, max = 16, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.new_session]
component = "Button"
control_id = "ReactBitsAgentNewSession"
classes = ["rb-primary-action"]
props = { text = "+  New session", button_variant = "contained", background_color = "$accent.primary", foreground_color = "$text.primary", corner_radius = 8, border_width = 0, input_interactive = true, input_focusable = true, accessibility_label = "Create new agent session" }
layout = { width = { stretch = "Stretch" }, height = { min = 38, preferred = 38, max = 38, stretch = "Fixed" } }
events = [{ id = "ReactBitsAgent/NewSession", event = "Click", route = "agent.session.create" }]

[nodes.sidebar_nav]
component = "VerticalBox"
control_id = "ReactBitsAgentSidebarNav"
layout = { width = { stretch = "Stretch" }, height = { min = 154, preferred = 154, max = 154, stretch = "Fixed" }, container = { kind = "VerticalBox", gap = 4 } }
children = [
  { node = "nav_label" },
  { node = "nav_home" },
  { node = "nav_runs" },
  { node = "nav_artifacts" },
  { node = "nav_settings" },
]

[nodes.nav_label]
component = "Label"
control_id = "ReactBitsAgentNavLabel"
props = { text = "WORKSPACE", foreground_color = "$text.muted", font_size = 10, font_weight = 700, letter_spacing = 1.2 }
layout = { width = { stretch = "Stretch" }, height = { min = 18, preferred = 18, max = 18, stretch = "Fixed" } }

[nodes.nav_home]
component = "Button"
control_id = "ReactBitsAgentNavHome"
props = { text = "⌂  Overview", button_variant = "text", background_color = "$surface.elevated", foreground_color = "$text.primary", corner_radius = 6, text_align = "left", input_interactive = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30, preferred = 30, max = 30, stretch = "Fixed" } }

[nodes.nav_runs]
component = "Button"
control_id = "ReactBitsAgentNavRuns"
props = { text = "◌  Agent runs", button_variant = "text", foreground_color = "$text.secondary", corner_radius = 6, text_align = "left", input_interactive = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30, preferred = 30, max = 30, stretch = "Fixed" } }

[nodes.nav_artifacts]
component = "Button"
control_id = "ReactBitsAgentNavArtifacts"
props = { text = "◇  Artifacts", button_variant = "text", foreground_color = "$text.secondary", corner_radius = 6, text_align = "left", input_interactive = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30, preferred = 30, max = 30, stretch = "Fixed" } }

[nodes.nav_settings]
component = "Button"
control_id = "ReactBitsAgentNavSettings"
props = { text = "⚙  Settings", button_variant = "text", foreground_color = "$text.secondary", corner_radius = 6, text_align = "left", input_interactive = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30, preferred = 30, max = 30, stretch = "Fixed" } }

[nodes.sidebar_history]
component = "ScrollableBox"
control_id = "ReactBitsAgentConversationHistory"
props = { background_color = "$surface.inset", border_color = "$border.default", border_width = 1, corner_radius = 8 }
layout = { clip = true, width = { stretch = "Stretch" }, height = { min = 120, preferred = 240, weight = 1, stretch = "Stretch" }, container = { kind = "ScrollableBox", axis = "Vertical", gap = 4, scrollbar_visibility = "Auto" }, padding = { left = 8, right = 8, top = 8, bottom = 8 } }
children = [
  { node = "history_label" },
  { node = "history_current" },
  { node = "history_previous" },
  { node = "history_old" },
]

[nodes.history_label]
component = "Label"
control_id = "ReactBitsAgentHistoryLabel"
props = { text = "RECENT SESSIONS", foreground_color = "$text.muted", font_size = 10, font_weight = 700, letter_spacing = 1.1 }
layout = { width = { stretch = "Stretch" }, height = { min = 18, preferred = 18, max = 18, stretch = "Fixed" } }

[nodes.history_current]
component = "Button"
control_id = "ReactBitsAgentHistoryCurrent"
props = { text = "UI parity review", button_variant = "text", background_color = "$accent.primary", foreground_color = "$text.primary", corner_radius = 6, text_align = "left", selected = true, input_interactive = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }

[nodes.history_previous]
component = "Button"
control_id = "ReactBitsAgentHistoryPrevious"
props = { text = "Penpot importer", button_variant = "text", foreground_color = "$text.secondary", corner_radius = 6, text_align = "left", input_interactive = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }

[nodes.history_old]
component = "Button"
control_id = "ReactBitsAgentHistoryOld"
props = { text = "Runtime layout audit", button_variant = "text", foreground_color = "$text.secondary", corner_radius = 6, text_align = "left", input_interactive = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }

[nodes.sidebar_footer]
component = "VerticalBox"
control_id = "ReactBitsAgentSidebarFooter"
layout = { width = { stretch = "Stretch" }, height = { min = 56, preferred = 56, max = 56, stretch = "Fixed" }, container = { kind = "VerticalBox", gap = 4 } }
children = [{ node = "connection_text" }, { node = "usage_text" }]

[nodes.connection_text]
component = "Label"
control_id = "ReactBitsAgentConnectionText"
props = { text = "Runtime connected · local", foreground_color = "$text.secondary", font_size = 11, text_overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 22, preferred = 22, max = 22, stretch = "Fixed" } }

[nodes.usage_text]
component = "Label"
control_id = "ReactBitsAgentUsageText"
props = { text = "12.4k / 32k context tokens", foreground_color = "$text.muted", font_size = 10, text_overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 22, preferred = 22, max = 22, stretch = "Fixed" } }

[nodes.main]
component = "VerticalBox"
control_id = "ReactBitsAgentMain"
classes = ["rb-main"]
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "VerticalBox", gap = 12 } }
children = [{ node = "main_header" }, { node = "conversation" }, { node = "context_summary" }, { node = "composer" }]

[nodes.main_header]
component = "HorizontalBox"
control_id = "ReactBitsAgentMainHeader"
classes = ["rb-panel"]
props = { background_color = "$surface.panel", border_color = "$border.default", border_width = 1, corner_radius = 10 }
layout = { width = { stretch = "Stretch" }, height = { min = 52, preferred = 52, max = 52, stretch = "Fixed" }, container = { kind = "HorizontalBox", gap = 10 }, padding = { left = 14, right = 10, top = 8, bottom = 8 } }
children = [{ node = "header_title_stack" }, { node = "model_picker" }, { node = "header_context" }, { node = "header_more" }]

[nodes.header_title_stack]
component = "VerticalBox"
control_id = "ReactBitsAgentHeaderTitleStack"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "VerticalBox", gap = 2 } }
children = [{ node = "header_title" }, { node = "header_subtitle" }]

[nodes.header_title]
component = "Label"
control_id = "ReactBitsAgentHeaderTitle"
props = { text = "UI parity review", foreground_color = "$text.primary", font_size = 14, font_weight = 650, text_overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 18, preferred = 18, max = 18, stretch = "Fixed" } }

[nodes.header_subtitle]
component = "Label"
control_id = "ReactBitsAgentHeaderSubtitle"
props = { text = "Agent run · 4 steps · streaming", foreground_color = "$text.secondary", font_size = 10, text_overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 16, preferred = 16, max = 16, stretch = "Fixed" } }

[nodes.model_picker]
component = "Button"
control_id = "ReactBitsAgentModelPicker"
props = { text = "Claude Sonnet 4  ▾", button_variant = "outlined", background_color = "$surface.elevated", foreground_color = "$text.secondary", border_color = "$border.strong", border_width = 1, corner_radius = 6, input_interactive = true, input_focusable = true, accessibility_label = "Choose model" }
layout = { width = { min = 144, preferred = 168, max = 188, stretch = "Fixed" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }

[nodes.header_context]
component = "Label"
control_id = "ReactBitsAgentHeaderContext"
props = { text = "12.4k tokens", foreground_color = "$accent.info", font_size = 10, text_align = "right", text_overflow = "elide" }
layout = { width = { min = 72, preferred = 86, max = 104, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.header_more]
component = "Button"
control_id = "ReactBitsAgentHeaderMore"
props = { text = "···", button_variant = "text", foreground_color = "$text.secondary", corner_radius = 6, input_interactive = true, input_focusable = true, accessibility_label = "Conversation actions" }
layout = { width = { min = 34, preferred = 34, max = 34, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.conversation]
component = "ScrollableBox"
control_id = "ReactBitsAgentConversation"
classes = ["rb-panel", "rb-conversation"]
props = { background_color = "$surface.inset", border_color = "$border.default", border_width = 1, corner_radius = 10 }
layout = { clip = true, input_policy = "Receive", width = { stretch = "Stretch" }, height = { min = 300, preferred = 560, weight = 1, stretch = "Stretch" }, container = { kind = "ScrollableBox", axis = "Vertical", gap = 12, scrollbar_visibility = "Auto" }, padding = { left = 18, right = 18, top = 18, bottom = 18 } }
children = [{ node = "user_message" }, { node = "assistant_message" }, { node = "followup_message" }]

[nodes.user_message]
component = "VerticalBox"
control_id = "ReactBitsAgentUserMessage"
classes = ["rb-message", "rb-user-message"]
props = { background_color = "$surface.elevated", border_color = "$border.default", border_width = 1, corner_radius = 8 }
layout = { width = { min = 0, stretch = "Stretch" }, height = { min = 64, preferred = 76, max = 96, stretch = "Fixed" }, container = { kind = "VerticalBox", gap = 6 }, padding = { left = 12, right = 12, top = 10, bottom = 10 } }
children = [{ node = "user_message_meta" }, { node = "user_message_text" }]

[nodes.user_message_meta]
component = "Label"
control_id = "ReactBitsAgentUserMeta"
props = { text = "You  ·  just now", foreground_color = "$text.muted", font_size = 10, font_weight = 600 }
layout = { width = { stretch = "Stretch" }, height = { min = 16, preferred = 16, max = 16, stretch = "Fixed" } }

[nodes.user_message_text]
component = "Label"
control_id = "ReactBitsAgentUserText"
props = { text = "Recreate the ReactBits agent workspace in ZUI and verify the layout in Penpot.", foreground_color = "$text.primary", font_size = 13, wrap = "word", text_overflow = "clip" }
layout = { width = { stretch = "Stretch" }, height = { min = 32, preferred = 38, max = 52, stretch = "Fixed" } }

[nodes.assistant_message]
component = "VerticalBox"
control_id = "ReactBitsAgentAssistantMessage"
classes = ["rb-message", "rb-assistant-message"]
props = { background_color = "$surface.panel", border_color = "$border.strong", border_width = 1, corner_radius = 8 }
layout = { width = { min = 0, stretch = "Stretch" }, height = { min = 290, preferred = 360, max = 440, stretch = "Fixed" }, container = { kind = "VerticalBox", gap = 10 }, padding = { left = 14, right = 14, top = 12, bottom = 12 } }
children = [{ node = "assistant_header" }, { node = "reasoning" }, { node = "tool_call" }, { node = "assistant_body" }, { node = "sources" }]

[nodes.assistant_header]
component = "HorizontalBox"
control_id = "ReactBitsAgentAssistantHeader"
layout = { width = { stretch = "Stretch" }, height = { min = 24, preferred = 24, max = 24, stretch = "Fixed" }, container = { kind = "HorizontalBox", gap = 8 } }
children = [{ node = "assistant_avatar" }, { node = "assistant_name" }, { node = "assistant_streaming" }]

[nodes.assistant_avatar]
component = "Label"
control_id = "ReactBitsAgentAssistantAvatar"
props = { text = "✦", foreground_color = "$accent.primary", font_size = 16, accessibility_label = "Assistant" }
layout = { width = { min = 22, preferred = 22, max = 22, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.assistant_name]
component = "Label"
control_id = "ReactBitsAgentAssistantName"
props = { text = "Zircon Agent", foreground_color = "$text.primary", font_size = 12, font_weight = 650 }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.assistant_streaming]
component = "Label"
control_id = "ReactBitsAgentAssistantStreaming"
props = { text = "STREAMING", foreground_color = "$accent.info", font_size = 9, font_weight = 700, letter_spacing = 1 }
layout = { width = { min = 66, preferred = 66, max = 66, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.reasoning]
component = "VerticalBox"
control_id = "ReactBitsAgentReasoning"
classes = ["rb-disclosure", "rb-reasoning-expanded"]
props = { background_color = "$surface.inset", border_color = "$border.default", border_width = 1, corner_radius = 6, disclosure_state = "expanded", accessible_role = "group" }
layout = { width = { stretch = "Stretch" }, height = { min = 58, preferred = 68, max = 84, stretch = "Fixed" }, container = { kind = "VerticalBox", gap = 5 }, padding = { left = 10, right = 10, top = 8, bottom = 8 } }
children = [{ node = "reasoning_summary" }, { node = "reasoning_detail" }]

[nodes.reasoning_summary]
component = "Label"
control_id = "ReactBitsAgentReasoningSummary"
props = { text = "⌄  Reasoning  ·  2.4s", foreground_color = "$text.secondary", font_size = 10, font_weight = 650 }
layout = { width = { stretch = "Stretch" }, height = { min = 16, preferred = 16, max = 16, stretch = "Fixed" } }

[nodes.reasoning_detail]
component = "Label"
control_id = "ReactBitsAgentReasoningDetail"
props = { text = "Comparing retained layout slots with the three-column reference and preserving a single scroll owner.", foreground_color = "$text.muted", font_size = 10, wrap = "word", text_overflow = "clip" }
layout = { width = { stretch = "Stretch" }, height = { min = 24, preferred = 30, max = 38, stretch = "Fixed" } }

[nodes.tool_call]
component = "VerticalBox"
control_id = "ReactBitsAgentToolCall"
classes = ["rb-tool-call", "rb-tool-call-running"]
props = { background_color = "$surface.elevated", border_color = "$accent.info", border_width = 1, corner_radius = 6, status = "running", disclosure_state = "expanded" }
layout = { width = { stretch = "Stretch" }, height = { min = 66, preferred = 76, max = 92, stretch = "Fixed" }, container = { kind = "VerticalBox", gap = 5 }, padding = { left = 10, right = 10, top = 8, bottom = 8 } }
children = [{ node = "tool_call_header" }, { node = "tool_call_output" }]

[nodes.tool_call_header]
component = "HorizontalBox"
control_id = "ReactBitsAgentToolCallHeader"
layout = { width = { stretch = "Stretch" }, height = { min = 18, preferred = 18, max = 18, stretch = "Fixed" }, container = { kind = "HorizontalBox", gap = 6 } }
children = [{ node = "tool_call_name" }, { node = "tool_call_status" }, { node = "tool_call_elapsed" }]

[nodes.tool_call_name]
component = "Label"
control_id = "ReactBitsAgentToolCallName"
props = { text = "▣  zui.inspect_layout", foreground_color = "$text.primary", font_size = 11, font_weight = 650 }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.tool_call_status]
component = "Label"
control_id = "ReactBitsAgentToolCallStatus"
props = { text = "running", foreground_color = "$accent.info", font_size = 10, font_weight = 650 }
layout = { width = { min = 54, preferred = 54, max = 54, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.tool_call_elapsed]
component = "Label"
control_id = "ReactBitsAgentToolCallElapsed"
props = { text = "1.8s", foreground_color = "$text.muted", font_size = 10, text_align = "right" }
layout = { width = { min = 34, preferred = 34, max = 34, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.tool_call_output]
component = "Label"
control_id = "ReactBitsAgentToolCallOutput"
props = { text = "Reading 12 retained nodes · checking overflow bounds…", foreground_color = "$text.secondary", font_size = 10, wrap = "word", text_overflow = "clip" }
layout = { width = { stretch = "Stretch" }, height = { min = 24, preferred = 28, max = 36, stretch = "Fixed" } }

[nodes.assistant_body]
component = "Label"
control_id = "ReactBitsAgentAssistantBody"
props = { text = "The shell now has explicit sidebar, conversation, and context slots. I’m keeping the approval decision beside the destructive action and reserving a stable composer row for streaming input.", foreground_color = "$text.primary", font_size = 12, wrap = "word", text_overflow = "clip" }
layout = { width = { stretch = "Stretch" }, height = { min = 42, preferred = 52, max = 68, stretch = "Fixed" } }

[nodes.sources]
component = "HorizontalBox"
control_id = "ReactBitsAgentSources"
classes = ["rb-sources"]
layout = { width = { stretch = "Stretch" }, height = { min = 26, preferred = 30, max = 34, stretch = "Fixed" }, container = { kind = "HorizontalBox", gap = 6 } }
children = [{ node = "source_zui" }, { node = "source_penpot" }, { node = "source_reference" }]

[nodes.source_zui]
component = "Button"
control_id = "ReactBitsAgentSourceZui"
props = { text = "ZUI source", button_variant = "outlined", background_color = "$surface.elevated", foreground_color = "$accent.info", border_color = "$border.strong", border_width = 1, corner_radius = 5, font_size = 10, input_interactive = true, input_focusable = true, accessibility_label = "Open ZUI source" }
layout = { width = { min = 76, preferred = 82, max = 96, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.source_penpot]
component = "Button"
control_id = "ReactBitsAgentSourcePenpot"
props = { text = "Penpot board", button_variant = "outlined", background_color = "$surface.elevated", foreground_color = "$accent.info", border_color = "$border.strong", border_width = 1, corner_radius = 5, font_size = 10, input_interactive = true, input_focusable = true, accessibility_label = "Open Penpot board" }
layout = { width = { min = 88, preferred = 98, max = 112, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.source_reference]
component = "Button"
control_id = "ReactBitsAgentSourceReference"
props = { text = "ReactBits refs", button_variant = "outlined", background_color = "$surface.elevated", foreground_color = "$accent.info", border_color = "$border.strong", border_width = 1, corner_radius = 5, font_size = 10, input_interactive = true, input_focusable = true, accessibility_label = "Open design references" }
layout = { width = { min = 94, preferred = 106, max = 120, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.followup_message]
component = "VerticalBox"
control_id = "ReactBitsAgentFollowupMessage"
classes = ["rb-message", "rb-followup-message"]
props = { background_color = "$surface.elevated", border_color = "$border.default", border_width = 1, corner_radius = 8 }
layout = { width = { min = 0, stretch = "Stretch" }, height = { min = 56, preferred = 66, max = 84, stretch = "Fixed" }, container = { kind = "VerticalBox", gap = 5 }, padding = { left = 12, right = 12, top = 10, bottom = 10 } }
children = [{ node = "followup_meta" }, { node = "followup_text" }]

[nodes.followup_meta]
component = "Label"
control_id = "ReactBitsAgentFollowupMeta"
props = { text = "Next checkpoint", foreground_color = "$status.success", font_size = 10, font_weight = 650 }
layout = { width = { stretch = "Stretch" }, height = { min = 16, preferred = 16, max = 16, stretch = "Fixed" } }

[nodes.followup_text]
component = "Label"
control_id = "ReactBitsAgentFollowupText"
props = { text = "After the native baseline is green, compare wide, compact, and mobile captures against the same Penpot board.", foreground_color = "$text.secondary", font_size = 11, wrap = "word", text_overflow = "clip" }
