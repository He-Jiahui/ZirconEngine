penpot_dependency_sources = []
penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/tests/reactbits_settings_form_components.zui\"\nversion = 2\ndisplay_name = \"ReactBits Settings Form Components\"\n\n[tokens]\n\"surface.canvas\" = \"#0f1117\"\n\"surface.panel\" = \"#171b24\"\n\"surface.elevated\" = \"#1d2330\"\n\"surface.inset\" = \"#11151d\"\n\"border.default\" = \"#2a3342\"\n\"border.strong\" = \"#3a4658\"\n\"text.primary\" = \"#f4f7fb\"\n\"text.secondary\" = \"#a9b4c5\"\n\"text.muted\" = \"#718096\"\n\"accent.primary\" = \"#8b7cff\"\n\"accent.info\" = \"#5da9ff\"\n\"status.success\" = \"#55d6a0\"\n\"status.warning\" = \"#f4bd62\"\n\"status.error\" = \"#ff7d8a\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsSettingsFormRoot\"\nclasses = [\"rb-settings-form-fixture\"]\nprops = {\n  background_color = \"$surface.canvas\",\n  foreground_color = \"$text.primary\",\n  fixture_data_only = true,\n  reference_primary = \"https://pro.reactbits.dev/docs/app-ui/settings-form/settings-form-1\",\n  reference_supporting = [\n    \"https://pro.reactbits.dev/docs/app-ui/forms/forms-1\",\n    \"https://pro.reactbits.dev/docs/app-ui/app-dialog/app-dialog-1\",\n    \"https://pro.reactbits.dev/docs/app-ui/notifications/notifications-3\",\n  ],\n  responsive_wide = \"section navigation, a label-left form, and delivery feedback share one settings frame\",\n  responsive_compact = \"navigation yields width to the form; labels stay start-aligned and values remain in their row\",\n  responsive_mobile = \"navigation becomes a priority selector, the form owns the scroll, and the save bar remains reachable\",\n  layout_modes = [\"settings-shell\", \"section-navigation\", \"label-left-form\", \"sticky-save-bar\", \"confirmation-dialog\"],\n  accessibility_label = \"Settings form reference surface\",\n}\nlayout = {\n  clip = true,\n  input_policy = \"Receive\",\n  width = { min = 360, preferred = 1120, max = 1440, stretch = \"Stretch\" },\n  height = { min = 400, preferred = 760, max = 920, stretch = \"Stretch\" },\n  container = { kind = \"VerticalBox\", gap = 8 },\n  padding = { left = 14, right = 14, top = 14, bottom = 14 },\n}\nchildren = [\n  { node = \"header\" },\n  { node = \"body\" },\n  { node = \"save_bar\" },\n  { node = \"feedback_row\" },\n]\n\n[nodes.header]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsSettingsHeader\"\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 56, preferred = 56, max = 56, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 }, padding = { left = 12, right = 12, top = 8, bottom = 8 } }\nchildren = [{ node = \"header_title_stack\" }, { node = \"header_status\" }]\n\n[nodes.header_title_stack]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsSettingsHeaderTitleStack\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 2 } }\nchildren = [{ node = \"header_title\" }, { node = \"header_subtitle\" }]\n\n[nodes.header_title]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsTitle\"\nprops = { text = \"Workspace settings\", text_key = \"fixture.settings.title\", foreground_color = \"$text.primary\", font_size = 15, font_weight = 650, accessibility_label = \"Workspace settings\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 20, preferred = 20, max = 20, stretch = \"Fixed\" } }\n\n[nodes.header_subtitle]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsSubtitle\"\nprops = { text = \"Profile, preferences, integrations, and delivery controls\", text_key = \"fixture.settings.subtitle\", foreground_color = \"$text.secondary\", font_size = 10, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 16, max = 16, stretch = \"Fixed\" } }\n\n[nodes.header_status]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsStatus\"\nprops = { text = \"UNSAVED\", text_key = \"fixture.settings.status.unsaved\", foreground_color = \"$status.warning\", font_size = 9, font_weight = 700, letter_spacing = 0.8, text_align = \"right\" }\nlayout = { width = { min = 80, preferred = 96, max = 112, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.body]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsSettingsBody\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 220, stretch = \"Stretch\" }, container = { kind = \"HorizontalBox\", gap = 10 } }\nchildren = [{ node = \"nav\" }, { node = \"form\" }]\n\n[nodes.nav]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsSettingsSectionNav\"\nclasses = [\"rb-settings-nav\"]\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, display = { xs = \"none\", md = \"flex\" }, accessibility_label = \"Settings sections\" }\nlayout = { clip = true, width = { min = 156, preferred = 196, max = 228, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 5 }, padding = { left = 9, right = 9, top = 10, bottom = 10 } }\nchildren = [{ node = \"nav_heading\" }, { node = \"nav_profile\" }, { node = \"nav_preferences\" }, { node = \"nav_integrations\" }, { node = \"nav_danger\" }]\n\n[nodes.nav_heading]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsNavHeading\"\nprops = { text = \"SETTINGS\", text_key = \"fixture.settings.nav.heading\", foreground_color = \"$text.muted\", font_size = 9, font_weight = 700, letter_spacing = 1.0 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" } }\n\n[nodes.nav_profile]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsSettingsNavProfile\"\nprops = { text = \"Profile\", text_key = \"fixture.settings.nav.profile\", button_variant = \"text\", background_color = \"$surface.elevated\", foreground_color = \"$text.primary\", corner_radius = 6, text_align = \"left\", selected = true, input_interactive = true, input_focusable = true, accessibility_label = \"Open profile settings\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\n\n[nodes.nav_preferences]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsSettingsNavPreferences\"\nprops = { text = \"Preferences\", text_key = \"fixture.settings.nav.preferences\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true, accessibility_label = \"Open preference settings\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\n\n[nodes.nav_integrations]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsSettingsNavIntegrations\"\nprops = { text = \"Integrations\", text_key = \"fixture.settings.nav.integrations\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true, accessibility_label = \"Open integration settings\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\n\n[nodes.nav_danger]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsSettingsNavDanger\"\nprops = { text = \"Danger zone\", text_key = \"fixture.settings.nav.danger\", button_variant = \"text\", foreground_color = \"$status.error\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true, accessibility_label = \"Open danger zone settings\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\n\n[nodes.form]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"ReactBitsSettingsForm\"\nclasses = [\"rb-settings-form\"]\nprops = { background_color = \"$surface.inset\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, scroll_owner = \"settings-form\", accessibility_label = \"Settings form content\" }\nlayout = { clip = true, width = { min = 0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 10, scrollbar_visibility = \"Auto\" }, padding = { left = 12, right = 12, top = 12, bottom = 12 } }\nchildren = [{ node = \"profile_section\" }, { node = \"preferences_section\" }, { node = \"integrations_section\" }]\n\n[nodes.profile_section]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsSettingsProfileSection\"\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, section_id = \"profile\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 168, preferred = 184, max = 212, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 8 }, padding = { left = 12, right = 12, top = 10, bottom = 10 } }\nchildren = [{ node = \"profile_heading\" }, { node = \"profile_intro\" }, { node = \"display_name_row\" }, { node = \"locale_row\" }]\n\n[nodes.profile_heading]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsProfileHeading\"\nprops = { text = \"Profile\", text_key = \"fixture.settings.profile.heading\", foreground_color = \"$text.primary\", font_size = 13, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" } }\n\n[nodes.profile_intro]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsProfileIntro\"\nprops = { text = \"Update the identity shown in project activity and shared reviews.\", text_key = \"fixture.settings.profile.intro\", foreground_color = \"$text.secondary\", font_size = 10, wrap = \"word\", text_overflow = \"clip\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 22, preferred = 24, max = 36, stretch = \"Fixed\" } }\n\n[nodes.display_name_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsSettingsDisplayNameRow\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 46, preferred = 48, max = 56, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 10 } }\nchildren = [{ node = \"display_name_label\" }, { node = \"display_name_field\" }]\n\n[nodes.display_name_label]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsSettingsDisplayNameLabel\"\nlayout = { width = { min = 132, preferred = 188, max = 240, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 2 } }\nchildren = [{ node = \"display_name_label_text\" }, { node = \"display_name_help\" }]\n\n[nodes.display_name_label_text]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsDisplayNameLabelText\"\nprops = { text = \"Display name\", text_key = \"fixture.settings.profile.display_name.label\", foreground_color = \"$text.primary\", font_size = 11, font_weight = 600 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 16, max = 18, stretch = \"Fixed\" } }\n\n[nodes.display_name_help]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsDisplayNameHelp\"\nprops = { text = \"Shown to collaborators\", text_key = \"fixture.settings.profile.display_name.help\", foreground_color = \"$text.muted\", font_size = 9, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 14, preferred = 14, max = 16, stretch = \"Fixed\" } }\n\n[nodes.display_name_field]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsSettingsDisplayNameField\"\nprops = { component_role = \"settings-field\", value_text = \"Zircon Editor\", value_key = \"fixture.settings.profile.display_name.value\", placeholder = \"Enter a display name\", placeholder_key = \"fixture.settings.profile.display_name.placeholder\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true, accessibility_label = \"Display name\" }\nlayout = { width = { min = 168, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 8, right = 8, top = 5, bottom = 5 } }\n\n[nodes.locale_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsSettingsLocaleRow\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 42, preferred = 44, max = 52, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 10 } }\nchildren = [{ node = \"locale_label\" }, { node = \"locale_value\" }]\n\n[nodes.locale_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsLocaleLabel\"\nprops = { text = \"Language and direction\", text_key = \"fixture.settings.profile.locale.label\", foreground_color = \"$text.primary\", font_size = 11, font_weight = 600 }\nlayout = { width = { min = 132, preferred = 188, max = 240, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.locale_value]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsSettingsLocaleValue\"\nprops = { text = \"English (US) · LTR\", text_key = \"fixture.settings.profile.locale.value\", button_variant = \"outlined\", background_color = \"$surface.elevated\", foreground_color = \"$text.secondary\", border_color = \"$border.strong\", border_width = 1, corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true, accessibility_label = \"Choose language and text direction\" }\nlayout = { width = { min = 168, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 8, right = 8, top = 5, bottom = 5 } }\n\n[nodes.preferences_section]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsSettingsPreferencesSection\"\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, section_id = \"preferences\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 128, preferred = 142, max = 164, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 8 }, padding = { left = 12, right = 12, top = 10, bottom = 10 } }\nchildren = [{ node = \"preferences_heading\" }, { node = \"notification_row\" }, { node = \"quiet_hours_row\" }]\n\n[nodes.preferences_heading]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsPreferencesHeading\"\nprops = { text = \"Delivery preferences\", text_key = \"fixture.settings.preferences.heading\", foreground_color = \"$text.primary\", font_size = 13, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" } }\n\n[nodes.notification_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsSettingsNotificationRow\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36, preferred = 38, max = 44, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 } }\nchildren = [{ node = \"notification_label\" }, { node = \"notification_toggle\" }]\n\n[nodes.notification_label]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsSettingsNotificationLabel\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 2 } }\nchildren = [{ node = \"notification_label_text\" }, { node = \"notification_help\" }]\n\n[nodes.notification_label_text]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsNotificationLabelText\"\nprops = { text = \"Activity notifications\", text_key = \"fixture.settings.preferences.activity.label\", foreground_color = \"$text.primary\", font_size = 11, font_weight = 600 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 16, max = 18, stretch = \"Fixed\" } }\n\n[nodes.notification_help]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsNotificationHelp\"\nprops = { text = \"Keep the team informed about completed runs\", text_key = \"fixture.settings.preferences.activity.help\", foreground_color = \"$text.muted\", font_size = 9, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 14, preferred = 14, max = 16, stretch = \"Fixed\" } }\n\n[nodes.notification_toggle]\ncomponent = \"ToggleButton\"\ncontrol_id = \"ReactBitsSettingsNotificationToggle\"\nprops = { text = \"Enabled\", text_key = \"fixture.settings.preferences.activity.value\", checked = true, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true, accessibility_label = \"Activity notifications enabled\" }\nlayout = { width = { min = 92, preferred = 104, max = 116, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.quiet_hours_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsSettingsQuietHoursRow\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 34, preferred = 36, max = 42, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 } }\nchildren = [{ node = \"quiet_hours_label\" }, { node = \"quiet_hours_value\" }]\n\n[nodes.quiet_hours_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsQuietHoursLabel\"\nprops = { text = \"Quiet hours\", text_key = \"fixture.settings.preferences.quiet_hours.label\", foreground_color = \"$text.primary\", font_size = 11, font_weight = 600 }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.quiet_hours_value]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsQuietHoursValue\"\nprops = { text = \"22:00 – 07:00\", text_key = \"fixture.settings.preferences.quiet_hours.value\", foreground_color = \"$text.secondary\", font_size = 10, text_align = \"right\" }\nlayout = { width = { min = 120, preferred = 144, max = 168, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.integrations_section]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsSettingsIntegrationsSection\"\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, section_id = \"integrations\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 174, preferred = 190, max = 220, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 8 }, padding = { left = 12, right = 12, top = 10, bottom = 10 } }\nchildren = [{ node = \"integrations_heading\" }, { node = \"integrations_intro\" }, { node = \"api_keys\" }]\n\n[nodes.integrations_heading]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsIntegrationsHeading\"\nprops = { text = \"API keys and integrations\", text_key = \"fixture.settings.integrations.heading\", foreground_color = \"$text.primary\", font_size = 13, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 18, max = 18, stretch = \"Fixed\" } }\n\n[nodes.integrations_intro]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsIntegrationsIntro\"\nprops = { text = \"Rotate or revoke access without leaving the settings flow.\", text_key = \"fixture.settings.integrations.intro\", foreground_color = \"$text.secondary\", font_size = 10, wrap = \"word\", text_overflow = \"clip\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 20, max = 30, stretch = \"Fixed\" } }\n\n[nodes.api_keys]\ncomponent = \"DataGrid\"\ncontrol_id = \"ReactBitsSettingsApiKeys\"\nclasses = [\"MuiDataGrid-root\", \"rb-settings-api-keys\"]\nprops = {\n  component_role = \"mui-x-data-grid\",\n  collection_virtualization = \"windowed\",\n  viewport_start = 0,\n  visible_limit = 3,\n  collection_test_cases = [\"empty\", \"one\", \"normal\", \"overflow\", \"narrow\", \"long-locale\"],\n  long_locale_fixture_label = \"A deliberately long localized integration label for overflow coverage\",\n  text_key = \"fixture.settings.integrations.api_keys.title\",\n  options = [\"Name\", \"Last used\", \"State\"],\n  column_alignments = [\"left\", \"right\", \"center\"],\n  collection_items = [\n    \"selected|Editor bridge|2026-09-18|Active\",\n    \"normal|CI validation|2026-09-17|Active\",\n    \"warning|Legacy importer|2026-08-02|Rotate soon\",\n    \"normal|Localized integration|Never|Revoked\",\n  ],\n  overflow_fixture_label = \"A deliberately long localized integration label for overflow coverage\",\n  selected_row_id = \"Editor bridge\",\n  empty_text = \"No API keys\",\n  empty_text_key = \"fixture.settings.integrations.api_keys.empty\",\n  value_text = \"No API keys\",\n  background_color = \"$surface.elevated\",\n  foreground_color = \"$text.primary\",\n  border_color = \"$border.default\",\n  border_width = 1,\n  corner_radius = 6,\n  accessibility_label = \"API keys table\",\n}\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { min = 72, preferred = 82, max = 96, stretch = \"Fixed\" }, padding = { left = 7, right = 7, top = 6, bottom = 6 } }\n\n[nodes.save_bar]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsSettingsSaveBar\"\nclasses = [\"rb-sticky-save-bar\"]\nprops = { background_color = \"$surface.elevated\", border_color = \"$accent.primary\", border_width = 1, corner_radius = 8, sticky = true, accessibility_label = \"Unsaved changes actions\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 50, preferred = 54, max = 62, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 }, padding = { left = 10, right = 10, top = 7, bottom = 7 } }\nchildren = [{ node = \"save_text\" }, { node = \"save_actions\" }]\n\n[nodes.save_text]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsSettingsSaveText\"\nprops = { text = \"Changes are **not saved** until you apply them.\", text_key = \"fixture.settings.save.unsaved\", rich_text_format = \"markdown_inline_v1\", foreground_color = \"$text.primary\", font_size = 10, wrap = \"word\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.save_actions]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsSettingsSaveActions\"\nlayout = { width = { min = 188, preferred = 214, max = 240, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" }, container = { kind = \"HorizontalBox\", gap = 6 } }\nchildren = [{ node = \"save_reset\" }, { node = \"save_button\" }]\n\n[nodes.save_reset]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsSettingsReset\"\nprops = { text = \"Revert\", text_key = \"fixture.settings.save.revert\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, input_interactive = true, input_focusable = true, accessibility_label = \"Revert unsaved changes\" }\nlayout = { width = { min = 82, preferred = 92, max = 104, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.save_button]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsSettingsApply\"\nprops = { text = \"Apply changes\", text_key = \"fixture.settings.save.apply\", button_variant = \"contained\", background_color = \"$accent.primary\", foreground_color = \"$text.primary\", corner_radius = 6, input_interactive = true, input_focusable = true, accessibility_label = \"Apply settings changes\" }\nlayout = { width = { min = 98, preferred = 116, max = 132, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.feedback_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsSettingsFeedbackRow\"\nprops = { display = { xs = \"none\", md = \"flex\" } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 96, preferred = 108, max = 120, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 } }\nchildren = [{ node = \"notifications\" }, { node = \"confirm_dialog\" }]\n\n[nodes.notifications]\ncomponent = \"NotificationCenter\"\ncontrol_id = \"ReactBitsSettingsNotifications\"\nclasses = [\"rb-settings-notifications\"]\nprops = {\n  open = true,\n  popup_open = true,\n  title = \"Recent settings activity\",\n  title_key = \"fixture.settings.notifications.title\",\n  unread_count = 1,\n  overflow_count = 0,\n  notifications = [\n    \"save|title=Profile saved|message=The display name is ready for review|severity=success|unread=true\",\n    \"rotate|title=Key rotation suggested|message=Legacy importer has not been used recently|severity=warning|unread=false\",\n    \"delivery|title=Quiet hours updated|message=Delivery preferences are synchronized|severity=info|unread=false\",\n  ],\n  selected_notification_id = \"save\",\n  focused_index = 0,\n  visible_limit = 2,\n  empty_text = \"No recent settings activity\",\n  empty_text_key = \"fixture.settings.notifications.empty\",\n  input_interactive = true,\n  input_clickable = true,\n  input_hoverable = true,\n  input_focusable = true,\n  accessibility_label = \"Recent settings activity\",\n}\nlayout = { clip = true, width = { min = 0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\" }, padding = { left = 7, right = 7, top = 6, bottom = 6 } }\n\n[nodes.confirm_dialog]\ncomponent = \"ConfirmDialog\"\ncontrol_id = \"ReactBitsSettingsConfirmDialog\"\nclasses = [\"rb-settings-confirm\", \"rb-destructive\"]\nprops = {\n  open = true,\n  popup_open = true,\n  title = \"Revoke legacy importer key?\",\n  title_key = \"fixture.settings.dialog.title\",\n  text = \"Revoke legacy importer key?\",\n  message = \"This removes access for the importer and cannot be undone.\",\n  message_key = \"fixture.settings.dialog.message\",\n  confirm_text = \"Revoke key\",\n  confirm_text_key = \"fixture.settings.dialog.confirm\",\n  cancel_text = \"Keep key\",\n  cancel_text_key = \"fixture.settings.dialog.cancel\",\n  severity = \"error\",\n  destructive = true,\n  requires_explicit_action = true,\n  required_value = \"Legacy importer\",\n  input_interactive = true,\n  input_clickable = true,\n  input_hoverable = true,\n  input_focusable = true,\n  accessibility_label = \"Confirm legacy importer key revocation\",\n}\nlayout = { clip = true, width = { min = 0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\" }, padding = { left = 7, right = 7, top = 6, bottom = 6 } }\n\n[nodes.root.zircon_extension]\nowner = \"reactbits-reference-slice\"\nreference_profile = \"reactbits-settings-form-components-v1\"\nsource_of_truth = \"zui\"\npenpot_visual_check = \"required\"\n\n[[stylesheets]]\nid = \"reactbits-ui-typography\"\n\n[[stylesheets.rules]]\nselector = \"*\"\nset = { self = { font = { asset = \"res://fonts/editor-ui.font.toml\", family = \"Fira Sans\" } } }\n"

