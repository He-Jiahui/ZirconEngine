[nodes.api_keys]
component = "DataGrid"
control_id = "ReactBitsSettingsApiKeys"
classes = [ "MuiDataGrid-root", "rb-settings-api-keys" ]

[nodes.api_keys.props]
component_role = "mui-x-data-grid"
collection_virtualization = "windowed"
viewport_start = 0
visible_limit = 3
collection_test_cases = [ "empty", "one", "normal", "overflow", "narrow", "long-locale" ]
long_locale_fixture_label = "A deliberately long localized integration label for overflow coverage"
text_key = "fixture.settings.integrations.api_keys.title"
options = [ "Name", "Last used", "State" ]
column_alignments = [ "left", "right", "center" ]
collection_items = [ "selected|Editor bridge|2026-09-18|Active", "normal|CI validation|2026-09-17|Active", "warning|Legacy importer|2026-08-02|Rotate soon", "normal|Localized integration|Never|Revoked" ]
overflow_fixture_label = "A deliberately long localized integration label for overflow coverage"
selected_row_id = "Editor bridge"
empty_text = "No API keys"
empty_text_key = "fixture.settings.integrations.api_keys.empty"
value_text = "No API keys"
background_color = "$surface.elevated"
foreground_color = "$text.primary"
border_color = "$border.default"
border_width = 1
corner_radius = 6
accessibility_label = "API keys table"

[nodes.api_keys.layout]
clip = true

[nodes.api_keys.layout.width]
stretch = "Stretch"

[nodes.api_keys.layout.height]
min = 72
preferred = 82
max = 96
stretch = "Fixed"

[nodes.api_keys.layout.padding]
left = 7
right = 7
top = 6
bottom = 6

[nodes.save_bar]
component = "HorizontalBox"
control_id = "ReactBitsSettingsSaveBar"
classes = [ "rb-sticky-save-bar" ]

[nodes.save_bar.props]
background_color = "$surface.elevated"
border_color = "$accent.primary"
border_width = 1
corner_radius = 8
sticky = true
accessibility_label = "Unsaved changes actions"

[nodes.save_bar.layout.width]
stretch = "Stretch"

[nodes.save_bar.layout.height]
min = 50
preferred = 54
max = 62
stretch = "Fixed"

[nodes.save_bar.layout.container]
kind = "HorizontalBox"
gap = 8

[nodes.save_bar.layout.padding]
left = 10
right = 10
top = 7
bottom = 7

[[nodes.save_bar.children]]
node = "save_text"

[[nodes.save_bar.children]]
node = "save_actions"

[nodes.save_text]
component = "Label"
control_id = "ReactBitsSettingsSaveText"

[nodes.save_text.props]
text = "Changes are **not saved** until you apply them."
text_key = "fixture.settings.save.unsaved"
rich_text_format = "markdown_inline_v1"
foreground_color = "$text.primary"
font_size = 10
wrap = "word"

[nodes.save_text.layout.width]
stretch = "Stretch"

[nodes.save_text.layout.height]
stretch = "Stretch"

[nodes.save_actions]
component = "HorizontalBox"
control_id = "ReactBitsSettingsSaveActions"

[nodes.save_actions.layout.width]
min = 188
preferred = 214
max = 240
stretch = "Fixed"

[nodes.save_actions.layout.height]
stretch = "Stretch"

[nodes.save_actions.layout.container]
kind = "HorizontalBox"
gap = 6

[[nodes.save_actions.children]]
node = "save_reset"

[[nodes.save_actions.children]]
node = "save_button"

[nodes.save_reset]
component = "Button"
control_id = "ReactBitsSettingsReset"

[nodes.save_reset.props]
text = "Revert"
text_key = "fixture.settings.save.revert"
button_variant = "text"
foreground_color = "$text.secondary"
corner_radius = 6
input_interactive = true
input_focusable = true
accessibility_label = "Revert unsaved changes"

[nodes.save_reset.layout.width]
min = 82
preferred = 92
max = 104
stretch = "Fixed"

[nodes.save_reset.layout.height]
stretch = "Stretch"

[nodes.save_button]
