control_id = "ReactBitsSettingsApply"

[nodes.save_button.props]
text = "Apply changes"
text_key = "fixture.settings.save.apply"
button_variant = "contained"
background_color = "$accent.primary"
foreground_color = "$text.primary"
corner_radius = 6
input_interactive = true
input_focusable = true
accessibility_label = "Apply settings changes"

[nodes.save_button.layout.width]
min = 98
preferred = 116
max = 132
stretch = "Fixed"

[nodes.save_button.layout.height]
stretch = "Stretch"

[nodes.feedback_row]
