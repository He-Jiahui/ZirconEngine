version = 2
display_name = "ReactBits Settings Form Components"

[tokens]
"surface.canvas" = "#0f1117"
"surface.panel" = "#171b24"
"surface.elevated" = "#1d2330"
"surface.inset" = "#11151d"
"border.default" = "#2a3342"
"border.strong" = "#3a4658"
"text.primary" = "#f4f7fb"
"text.secondary" = "#a9b4c5"
"text.muted" = "#718096"
"accent.primary" = "#8b7cff"
"accent.info" = "#5da9ff"
"status.success" = "#55d6a0"
"status.warning" = "#f4bd62"
"status.error" = "#ff7d8a"

[root]
node = "root"

[nodes.root]
component = "VerticalBox"
control_id = "ReactBitsSettingsFormRoot"
classes = [ "rb-settings-form-fixture" ]

[nodes.root.props]
background_color = "$surface.canvas"
foreground_color = "$text.primary"
fixture_data_only = true
reference_primary = "https://pro.reactbits.dev/docs/app-ui/settings-form/settings-form-1"
reference_supporting = [ "https://pro.reactbits.dev/docs/app-ui/forms/forms-1", "https://pro.reactbits.dev/docs/app-ui/app-dialog/app-dialog-1", "https://pro.reactbits.dev/docs/app-ui/notifications/notifications-3" ]
responsive_wide = "section navigation, a label-left form, and delivery feedback share one settings frame"
responsive_compact = "navigation yields width to the form; labels stay start-aligned and values remain in their row"
responsive_mobile = "navigation becomes a priority selector, the form owns the scroll, and the save bar remains reachable"
layout_modes = [ "settings-shell", "section-navigation", "label-left-form", "sticky-save-bar", "confirmation-dialog" ]
accessibility_label = "Settings form reference surface"

[nodes.root.layout]
clip = true
input_policy = "Receive"

[nodes.root.layout.width]
min = 360
preferred = 1120
max = 1440
stretch = "Stretch"

[nodes.root.layout.height]
min = 400
preferred = 760
max = 920
stretch = "Stretch"

[nodes.root.layout.container]
kind = "VerticalBox"
gap = 8

[nodes.root.layout.padding]
left = 14
right = 14
top = 14
bottom = 14

[[nodes.root.children]]
node = "header"

[[nodes.root.children]]
node = "body"

[[nodes.root.children]]
node = "save_bar"

[[nodes.root.children]]
node = "feedback_row"

[nodes.root.zircon_extension]
owner = "reactbits-reference-slice"
reference_profile = "reactbits-settings-form-components-v1"
source_of_truth = "zui"
penpot_visual_check = "required"

