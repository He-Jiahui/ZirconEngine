[nodes.notifications]
component = "NotificationCenter"
control_id = "ReactBitsSettingsNotifications"
classes = [ "rb-settings-notifications" ]

[nodes.notifications.props]
open = true
popup_open = true
title = "Recent settings activity"
title_key = "fixture.settings.notifications.title"
unread_count = 1
overflow_count = 0
notifications = [ "save|title=Profile saved|message=The display name is ready for review|severity=success|unread=true", "rotate|title=Key rotation suggested|message=Legacy importer has not been used recently|severity=warning|unread=false", "delivery|title=Quiet hours updated|message=Delivery preferences are synchronized|severity=info|unread=false" ]
selected_notification_id = "save"
focused_index = 0
visible_limit = 2
