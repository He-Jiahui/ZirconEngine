[asset]
kind = "view"
id = "res://ui/tests/reactbits_kanban_scheduling_components.zui"
version = 2
display_name = "ReactBits Kanban And Scheduling Components"

[tokens]
"surface.canvas" = "#0f1117"
"surface.panel" = "#171b24"
"surface.elevated" = "#1d2330"
"surface.inset" = "#11151d"
"border.default" = "#2a3342"
"border.strong" = "#3a4658"
"text.primary" = "#f4f7fb"
"text.secondary" = "#a9b4c5"
"text.muted" = "#718096"
"accent.primary" = "#8b7cff"
"accent.info" = "#5da9ff"
"status.success" = "#55d6a0"
"status.warning" = "#f4bd62"
"status.error" = "#ff7d8a"

[root]
node = "root"

[nodes.root]
component = "VerticalBox"
control_id = "ReactBitsKanbanSchedulingRoot"
classes = ["rb-kanban-scheduling-fixture"]
props = {
  background_color = "$surface.canvas",
  foreground_color = "$text.primary",
  fixture_data_only = true,
  reference_primary = "https://pro.reactbits.dev/docs/app-ui/kanban/kanban-5",
  reference_supporting = [
    "https://pro.reactbits.dev/docs/app-ui/kanban/kanban-1",
    "https://pro.reactbits.dev/docs/app-ui/scheduling/scheduling-1",
    "https://pro.reactbits.dev/docs/app-ui/scheduling/scheduling-7",
  ],
  responsive_wide = "the sprint board and booking agenda share a balanced two-panel flow",
  responsive_compact = "columns wrap before card text becomes unreadable and the agenda keeps time values end-aligned",
  responsive_mobile = "one vertical scroll owner exposes board columns before the day agenda and keeps primary actions reachable",
  layout_modes = ["wip-board", "capacity-meter", "drag-state-card", "month-day-strip", "time-slot-agenda", "windowed-collections"],
  accessibility_label = "Kanban board and scheduling reference surface",
}
layout = {
  clip = true,
  input_policy = "Receive",
  width = { min = 360, preferred = 1160, max = 1440, stretch = "Stretch" },
  height = { min = 520, preferred = 820, max = 1040, stretch = "Stretch" },
  container = { kind = "VerticalBox", gap = 10 },
  padding = { left = 14, right = 14, top = 14, bottom = 14 },
}
children = [{ node = "header" }, { node = "body" }]

[nodes.header]
component = "HorizontalBox"
control_id = "ReactBitsKanbanSchedulingHeader"
props = { background_color = "$surface.panel", border_color = "$border.default", border_width = 1, corner_radius = 8 }
layout = { width = { stretch = "Stretch" }, height = { min = 54, preferred = 54, max = 54, stretch = "Fixed" }, container = { kind = "HorizontalBox", gap = 8 }, padding = { left = 12, right = 12, top = 8, bottom = 8 } }
children = [{ node = "header_title" }, { node = "header_range" }, { node = "header_add" }]

[nodes.header_title]
component = "VerticalBox"
control_id = "ReactBitsKanbanSchedulingHeaderTitle"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "VerticalBox", gap = 2 } }
children = [{ node = "title" }, { node = "subtitle" }]

[nodes.title]
component = "Label"
control_id = "ReactBitsKanbanSchedulingTitle"
props = { text = "Release operations", text_key = "fixture.kanban.title", foreground_color = "$text.primary", font_size = 15, font_weight = 650, text_overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 20, preferred = 20, max = 22, stretch = "Fixed" } }

[nodes.subtitle]
component = "Label"
control_id = "ReactBitsKanbanSchedulingSubtitle"
props = { text = "Sprint capacity and deployment windows", text_key = "fixture.kanban.subtitle", foreground_color = "$text.secondary", font_size = 10, text_overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 16, preferred = 16, max = 18, stretch = "Fixed" } }

[nodes.header_range]
component = "Button"
control_id = "ReactBitsKanbanSchedulingRange"
props = { text = "Sprint 24 · Sep 16–27", text_key = "fixture.kanban.header.range", icon = "chevron-down", icon_size = "s", button_variant = "outlined", foreground_color = "$text.secondary", border_color = "$border.strong", border_width = 1, corner_radius = 6, text_align = "right", input_interactive = true, input_focusable = true, accessibility_label = "Choose sprint range" }
layout = { width = { min = 154, preferred = 184, max = 214, stretch = "Fixed" }, height = { stretch = "Stretch" }, padding = { left = 8, right = 8, top = 5, bottom = 5 } }

[nodes.header_add]
component = "Button"
control_id = "ReactBitsKanbanSchedulingAdd"
props = { text = "New item", text_key = "fixture.kanban.header.add", icon = "plus", icon_size = "s", button_variant = "contained", background_color = "$accent.primary", foreground_color = "$text.primary", corner_radius = 6, text_align = "center", input_interactive = true, input_focusable = true, accessibility_label = "Create a board item" }
layout = { width = { min = 92, preferred = 112, max = 132, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.body]
component = "ScrollableBox"
control_id = "ReactBitsKanbanSchedulingBody"
props = { background_color = "$surface.inset", border_color = "$border.default", border_width = 1, corner_radius = 8, scroll_owner = "kanban-scheduling-body", accessibility_label = "Board and schedule content" }
layout = { clip = true, width = { stretch = "Stretch" }, height = { min = 0, stretch = "Stretch" }, container = { kind = "ScrollableBox", axis = "Vertical", gap = 10, scrollbar_visibility = "Auto" }, padding = { left = 12, right = 12, top = 12, bottom = 12 } }
children = [{ node = "panels" }]

[nodes.panels]
component = "FlowBox"
control_id = "ReactBitsKanbanSchedulingPanels"
props = { direction = "row", wrap = true, spacing = 10, accessibility_label = "Board and schedule panels" }
layout = { width = { stretch = "Stretch" }, height = { min = 600, preferred = 660, max = 820, stretch = "Stretch" }, container = { kind = "FlowBox", gap = 10 } }
children = [
  { node = "board_panel", slot = { layout = { width = { min = 272, preferred = 650, weight = 1, stretch = "Stretch" } } } },
  { node = "schedule_panel", slot = { layout = { width = { min = 272, preferred = 390, weight = 1, stretch = "Stretch" } } } },
]

[nodes.board_panel]
component = "VerticalBox"
control_id = "ReactBitsKanbanBoardPanel"
classes = ["rb-kanban-board"]
props = { background_color = "$surface.panel", border_color = "$border.default", border_width = 1, corner_radius = 9, accessibility_label = "Sprint kanban board" }
layout = { width = { min = 272, stretch = "Stretch" }, height = { min = 600, preferred = 660, max = 820, stretch = "Stretch" }, container = { kind = "VerticalBox", gap = 8 }, padding = { left = 10, right = 10, top = 10, bottom = 10 } }
children = [{ node = "board_toolbar" }, { node = "board_summary" }, { node = "columns" }]

