penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/tests/reactbits_kanban_scheduling_components.zui\"\nversion = 2\ndisplay_name = \"ReactBits Kanban And Scheduling Components\"\n\n[tokens]\n\"surface.canvas\" = \"#0f1117\"\n\"surface.panel\" = \"#171b24\"\n\"surface.elevated\" = \"#1d2330\"\n\"surface.inset\" = \"#11151d\"\n\"border.default\" = \"#2a3342\"\n\"border.strong\" = \"#3a4658\"\n\"text.primary\" = \"#f4f7fb\"\n\"text.secondary\" = \"#a9b4c5\"\n\"text.muted\" = \"#718096\"\n\"accent.primary\" = \"#8b7cff\"\n\"accent.info\" = \"#5da9ff\"\n\"status.success\" = \"#55d6a0\"\n\"status.warning\" = \"#f4bd62\"\n\"status.error\" = \"#ff7d8a\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsKanbanSchedulingRoot\"\nclasses = [\"rb-kanban-scheduling-fixture\"]\nprops = {\n  background_color = \"$surface.canvas\",\n  foreground_color = \"$text.primary\",\n  fixture_data_only = true,\n  reference_primary = \"https://pro.reactbits.dev/docs/app-ui/kanban/kanban-5\",\n  reference_supporting = [\n    \"https://pro.reactbits.dev/docs/app-ui/kanban/kanban-1\",\n    \"https://pro.reactbits.dev/docs/app-ui/scheduling/scheduling-1\",\n    \"https://pro.reactbits.dev/docs/app-ui/scheduling/scheduling-7\",\n  ],\n  responsive_wide = \"the sprint board and booking agenda share a balanced two-panel flow\",\n  responsive_compact = \"columns wrap before card text becomes unreadable and the agenda keeps time values end-aligned\",\n  responsive_mobile = \"one vertical scroll owner exposes board columns before the day agenda and keeps primary actions reachable\",\n  layout_modes = [\"wip-board\", \"capacity-meter\", \"drag-state-card\", \"month-day-strip\", \"time-slot-agenda\", \"windowed-collections\"],\n  accessibility_label = \"Kanban board and scheduling reference surface\",\n}\nlayout = {\n  clip = true,\n  input_policy = \"Receive\",\n  width = { min = 360, preferred = 1160, max = 1440, stretch = \"Stretch\" },\n  height = { min = 520, preferred = 820, max = 1040, stretch = \"Stretch\" },\n  container = { kind = \"VerticalBox\", gap = 10 },\n  padding = { left = 14, right = 14, top = 14, bottom = 14 },\n}\nchildren = [{ node = \"header\" }, { node = \"body\" }]\n\n[nodes.header]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsKanbanSchedulingHeader\"\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 54, preferred = 54, max = 54, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 }, padding = { left = 12, right = 12, top = 8, bottom = 8 } }\nchildren = [{ node = \"header_title\" }, { node = \"header_range\" }, { node = \"header_add\" }]\n\n[nodes.header_title]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsKanbanSchedulingHeaderTitle\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 2 } }\nchildren = [{ node = \"title\" }, { node = \"subtitle\" }]\n\n[nodes.title]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsKanbanSchedulingTitle\"\nprops = { text = \"Release operations\", text_key = \"fixture.kanban.title\", foreground_color = \"$text.primary\", font_size = 15, font_weight = 650, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 20, preferred = 20, max = 22, stretch = \"Fixed\" } }\n\n[nodes.subtitle]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsKanbanSchedulingSubtitle\"\nprops = { text = \"Sprint capacity and deployment windows\", text_key = \"fixture.kanban.subtitle\", foreground_color = \"$text.secondary\", font_size = 10, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 16, max = 18, stretch = \"Fixed\" } }\n\n[nodes.header_range]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsKanbanSchedulingRange\"\nprops = { text = \"Sprint 24 · Sep 16–27\", text_key = \"fixture.kanban.header.range\", icon = \"chevron-down\", icon_size = \"s\", button_variant = \"outlined\", foreground_color = \"$text.secondary\", border_color = \"$border.strong\", border_width = 1, corner_radius = 6, text_align = \"right\", input_interactive = true, input_focusable = true, accessibility_label = \"Choose sprint range\" }\nlayout = { width = { min = 154, preferred = 184, max = 214, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" }, padding = { left = 8, right = 8, top = 5, bottom = 5 } }\n\n[nodes.header_add]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsKanbanSchedulingAdd\"\nprops = { text = \"New item\", text_key = \"fixture.kanban.header.add\", icon = \"plus\", icon_size = \"s\", button_variant = \"contained\", background_color = \"$accent.primary\", foreground_color = \"$text.primary\", corner_radius = 6, text_align = \"center\", input_interactive = true, input_focusable = true, accessibility_label = \"Create a board item\" }\nlayout = { width = { min = 92, preferred = 112, max = 132, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.body]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"ReactBitsKanbanSchedulingBody\"\nprops = { background_color = \"$surface.inset\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, scroll_owner = \"kanban-scheduling-body\", accessibility_label = \"Board and schedule content\" }\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { min = 0, stretch = \"Stretch\" }, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 10, scrollbar_visibility = \"Auto\" }, padding = { left = 12, right = 12, top = 12, bottom = 12 } }\nchildren = [{ node = \"panels\" }]\n\n[nodes.panels]\ncomponent = \"FlowBox\"\ncontrol_id = \"ReactBitsKanbanSchedulingPanels\"\nprops = { direction = \"row\", wrap = true, spacing = 10, accessibility_label = \"Board and schedule panels\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 600, preferred = 660, max = 820, stretch = \"Stretch\" }, container = { kind = \"FlowBox\", gap = 10 } }\nchildren = [\n  { node = \"board_panel\", slot = { layout = { width = { min = 272, preferred = 650, weight = 1, stretch = \"Stretch\" } } } },\n  { node = \"schedule_panel\", slot = { layout = { width = { min = 272, preferred = 390, weight = 1, stretch = \"Stretch\" } } } },\n]\n\n[nodes.board_panel]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsKanbanBoardPanel\"\nclasses = [\"rb-kanban-board\"]\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 9, accessibility_label = \"Sprint kanban board\" }\nlayout = { width = { min = 272, stretch = \"Stretch\" }, height = { min = 600, preferred = 660, max = 820, stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 8 }, padding = { left = 10, right = 10, top = 10, bottom = 10 } }\nchildren = [{ node = \"board_toolbar\" }, { node = \"board_summary\" }, { node = \"columns\" }]\n\n[nodes.board_toolbar]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsKanbanBoardToolbar\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 34, preferred = 36, max = 40, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 6 } }\nchildren = [{ node = \"board_label\" }, { node = \"board_filter\" }]\n\n[nodes.board_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsKanbanBoardLabel\"\nprops = { text = \"Sprint board\", text_key = \"fixture.kanban.board.label\", foreground_color = \"$text.primary\", font_size = 12, font_weight = 650, text_align = \"left\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.board_filter]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsKanbanBoardFilter\"\nprops = { text = \"Filter\", text_key = \"fixture.kanban.board.filter\", icon = \"info\", icon_size = \"s\", button_variant = \"text\", foreground_color = \"$acc