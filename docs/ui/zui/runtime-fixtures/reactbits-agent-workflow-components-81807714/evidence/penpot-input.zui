penpot_dependency_sources = []
penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/tests/reactbits_agent_workflow_components.zui\"\nversion = 2\ndisplay_name = \"ReactBits Agent Workflow Components\"\n\n[tokens]\n\"surface.canvas\" = \"#0f1117\"\n\"surface.panel\" = \"#171b24\"\n\"surface.elevated\" = \"#1d2330\"\n\"surface.inset\" = \"#11151d\"\n\"border.default\" = \"#2a3342\"\n\"border.strong\" = \"#3a4658\"\n\"text.primary\" = \"#f4f7fb\"\n\"text.secondary\" = \"#a9b4c5\"\n\"text.muted\" = \"#718096\"\n\"accent.primary\" = \"#8b7cff\"\n\"accent.info\" = \"#5da9ff\"\n\"status.success\" = \"#55d6a0\"\n\"status.warning\" = \"#f4bd62\"\n\"status.error\" = \"#ff7d8a\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAgentWorkflowRoot\"\nclasses = [\"rb-agent-workflow-fixture\"]\nprops = {\n  background_color = \"$surface.canvas\",\n  foreground_color = \"$text.primary\",\n  fixture_data_only = true,\n  reference_primary = \"https://pro.reactbits.dev/docs/app-ui/agent-plan\",\n  reference_supporting = [\n    \"https://pro.reactbits.dev/docs/app-ui/tool-calls\",\n    \"https://pro.reactbits.dev/docs/app-ui/agent-approval\",\n    \"https://pro.reactbits.dev/docs/app-ui/ai-usage\",\n    \"https://pro.reactbits.dev/docs/app-ui/agent-activity/agent-activity-3\",\n  ],\n  responsive_wide = \"plan and tool-call cards share the workflow row; approval and usage remain visible below\",\n  responsive_compact = \"workflow cards retain status markers and wrap their authored labels\",\n  responsive_mobile = \"cards stack while approval actions remain reachable and usage stays bounded\",\n  accessibility_label = \"Agent workflow component reference\",\n}\nlayout = {\n  clip = true,\n  input_policy = \"Receive\",\n  width = { min = 360, preferred = 1080, max = 1440, stretch = \"Stretch\" },\n  height = { min = 520, preferred = 720, max = 920, stretch = \"Stretch\" },\n  container = { kind = \"VerticalBox\", gap = 8 },\n  padding = { left = 14, right = 14, top = 14, bottom = 14 },\n}\nchildren = [\n  { node = \"header\" },\n  { node = \"workflow_row\" },\n  { node = \"approval\" },\n  { node = \"usage\" },\n]\n\n[nodes.header]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAgentWorkflowHeader\"\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 42, preferred = 42, max = 42, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 }, padding = { left = 10, right = 10, top = 7, bottom = 7 } }\nchildren = [{ node = \"header_title\" }, { node = \"header_status\" }]\n\n[nodes.header_title]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentWorkflowTitle\"\nprops = { text = \"Agent workflow surfaces\", foreground_color = \"$text.primary\", font_size = 15, font_weight = 650, accessibility_label = \"Agent workflow surfaces\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_status]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAgentWorkflowStatus\"\nprops = { text = \"SEMANTIC STATES\", foreground_color = \"$status.success\", font_size = 9, font_weight = 700, letter_spacing = 0.8, text_align = \"right\" }\nlayout = { width = { min = 110, preferred = 128, max = 146, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.workflow_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAgentWorkflowCards\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 156, preferred = 164, max = 176, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 } }\nchildren = [{ node = \"plan\" }, { node = \"tool_calls\" }]\n\n[nodes.plan]\ncomponent = \"AgentPlan\"\ncontrol_id = \"ReactBitsAgentPlan\"\nclasses = [\"MuiAgentPlan-root\", \"MuiAgentPlan-running\"]\nprops = {\n  component_role = \"mui-x-agent-plan\",\n  collection_virtualization = \"windowed\",\n  viewport_start = 0,\n  visible_limit = 3,\n  text = \"Agent plan · 2/4 complete\",\n  collection_items = [\n    \"done|Map ReactBits references\",\n    \"active|Build retained ZUI surface\",\n    \"next|Compare native screenshots\",\n  ],\n  value = 0.5,\n  min = 0,\n  max = 1,\n  background_color = \"$surface.elevated\",\n  foreground_color = \"$text.primary\",\n  border_color = \"$border.default\",\n  border_width = 1,\n  corner_radius = 8,\n  accessibility_label = \"Agent plan progress\",\n}\nlayout = { width = { min = 160, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, clip = true }\n\n[nodes.tool_calls]\ncomponent = \"ToolCalls\"\ncontrol_id = \"ReactBitsToolCalls\"\nclasses = [\"MuiToolCalls-root\", \"MuiToolCalls-mixed\"]\nprops = {\n  component_role = \"mui-x-tool-calls\",\n  collection_virtualization = \"windowed\",\n  viewport_start = 0,\n  text = \"Tool calls · 3\",\n  collection_items = [\n    \"success|read_file|layout.zui\",\n    \"pending|search_web|ReactBits\",\n    \"failure|apply_patch|blocked\",\n  ],\n  visible_limit = 3,\n  background_color = \"$surface.elevated\",\n  foreground_color = \"$text.primary\",\n  border_color = \"$border.default\",\n  border_width = 1,\n  corner_radius = 8,\n  accessibility_label = \"Tool call status list\",\n}\nlayout = { width = { min = 160, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, clip = true }\n\n[nodes.approval]\ncomponent = \"AgentApproval\"\ncontrol_id = \"ReactBitsAgentApproval\"\nclasses = [\"MuiAgentApproval-root\", \"MuiAgentApproval-pending\", \"MuiAgentApproval-destructive\"]\nprops = {\n  component_role = \"mui-x-agent-approval\",\n  component_variant = \"pending destructive\",\n  text = \"Approval required\",\n  value_text = \"The agent wants to write the generated layout into the project.\",\n  label_text = \"Scope: zircon_runtime/tests/fixtures/ui · reversible\",\n  options = [\"Deny\", \"Allow write\"],\n  approval_state = \"pending\",\n  destructive = true,\n  background_color = \"$surface.elevated\",\n  foreground_color = \"$text.primary\",\n  border_color = \"$status.warning\",\n  border_width = 1,\n  corner_radius = 8,\n  accessibility_label = \"Approval required before writing the layout\",\n  input_interactive = true,\n  input_clickable = true,\n  input_focusable = true,\n}\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 136, preferred = 144, max = 156, stretch = \"Fixed\" }, clip = true, padding = { left = 8, right = 8, top = 6, bottom = 6 } }\nevents = [{ id = \"ReactBitsAgentWorkflow/ApprovalAllow\", event = \"Click\", route = \"agent.approval.allow\" }, { id = \"ReactBitsAgentWorkflow/ApprovalDeny\", event = \"Click\", route = \"agent.approval.deny\" }]\n\n[nodes.usage]\ncomponent = \"AIUsage\"\ncontrol_id = \"ReactBitsAIUsage\"\nclasses = [\"MuiAIUsage-root\", \"MuiAIUsage-bounded\"]\nprops = {\n  component_role = \"mui-x-ai-usage\",\n  component_variant = \"bounded\",\n  text = \"AI usage\",\n  value_text = \"12.4k used · 19.6k remaining · $0.08\",\n  value = 0.39,\n  min = 0,\n  max = 1,\n  background_color = \"$surface.elevated\",\n  foreground_color = \"$text.primary\",\n  border_color = \"$border.default\",\n  border_width = 1,\n  corner_radius = 8,\n  accessibility_label = \"AI usage budget\",\n}\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 84, preferred = 92, max = 104, stretch = \"Fixed\" }, clip = true, padding = { left = 8, right = 8, top = 6, bottom = 6 } }\n\n[nodes.root.zircon_extension]\nowner = \"reactbits-reference-slice\"\nreference_profile = \"reactbits-agent-workflow-components-v1\"\nsource_of_truth = \"zui\"\npenpot_visual_check = \"required\"\n\n[[stylesheets]]\nid = \"reactbits-ui-typography\"\n\n[[stylesheets.rules]]\nselector = \"*\"\nset = { self = { font = { asset = \"res://fonts/editor-ui.font.toml\", family = \"Fira Sans\" } } }\n"

[asset]
kind = "view"
id = "res://ui/tests/reactbits_agent_workflow_components.zui"
version = 2
display_name = "ReactBits Agent Workflow Components"

[tokens]
"surface.canvas" = "#0f1117"
"surface.panel" = "#171b24"
"surface.elevated" = "#1d2330"
