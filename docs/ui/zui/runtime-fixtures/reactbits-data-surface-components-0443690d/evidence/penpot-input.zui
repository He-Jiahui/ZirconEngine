stretch = "Stretch"

[nodes.metric_health_label.layout.height]
stretch = "Stretch"

[nodes.metric_health_value]
component = "Label"
control_id = "ReactBitsDataSurfaceMetricHealthValue"

[nodes.metric_health_value.props]
text = "98% healthy"
foreground_color = "$status.success"
font_size = 16
font_weight = 650

[nodes.metric_health_value.layout.width]
stretch = "Stretch"

[nodes.metric_health_value.layout.height]
stretch = "Stretch"

[nodes.content_row]
component = "HorizontalBox"
control_id = "ReactBitsDataSurfaceContent"

[nodes.content_row.layout.width]
stretch = "Stretch"

[nodes.content_row.layout.height]
min = 210
stretch = "Stretch"

[nodes.content_row.layout.container]
kind = "HorizontalBox"
gap = 8

[[nodes.content_row.children]]
node = "tree"

[[nodes.content_row.children]]
node = "grid"

[nodes.tree]
component = "TreeView"
control_id = "ReactBitsDataSurfaceTree"
classes = [ "MuiTreeView-root", "rb-file-tree" ]

[nodes.tree.props]
component_role = "mui-x-tree-view"
collection_virtualization = "windowed"
viewport_start = 0
visible_limit = 3
text = "Folders"
collection_items = [ "expanded|0|Assets", "selected|1|Meshes", "normal|1|Materials", "normal|0|Scenes" ]
selected_id = "Meshes"
empty_text = "No folders"
value_text = "No folders"
background_color = "$surface.elevated"
foreground_color = "$text.primary"
border_color = "$border.default"
border_width = 1
corner_radius = 8
accessibility_label = "Project asset folders"

[nodes.tree.layout]
clip = true

[nodes.tree.layout.width]
min = 156
preferred = 238
max = 280
stretch = "Fixed"

[nodes.tree.layout.height]
stretch = "Stretch"

[nodes.tree.layout.padding]
left = 8
right = 8
top = 8
bottom = 8

[nodes.grid]
component = "DataGrid"
control_id = "ReactBitsDataSurfaceGrid"
classes = [ "MuiDataGrid-root", "rb-asset-table" ]

[nodes.grid.props]
component_role = "mui-x-data-grid"
collection_virtualization = "windowed"
viewport_start = 0
visible_limit = 3
text = "Assets"
options = [ "Name", "Type", "Size", "Status" ]
column_alignments = [ "left", "left", "right", "center" ]
collection_items = [ "selected|SM_Tree_Oak_01|Static Mesh|2.4 MB|Ready", "normal|SM_Rock_Cliff|Static Mesh|3.1 MB|Ready", "warning|M_Bark_Master|Material|512 KB|Review", "success|T_Leaf_N|Texture|1.2 MB|Ready" ]
selected_row_id = "SM_Tree_Oak_01"
empty_text = "No assets match the current filters"
value_text = "No assets match the current filters"
background_color = "$surface.elevated"
foreground_color = "$text.primary"
border_color = "$border.default"
border_width = 1
corner_radius = 8
accessibility_label = "Project asset data table"

[nodes.grid.layout]
clip = true

[nodes.grid.layout.width]
min = 360
stretch = "Stretch"

[nodes.grid.layout.height]
stretch = "Stretch"

[nodes.grid.layout.padding]
left = 8
right = 8
top = 8
bottom = 8

[nodes.empty_notice]
component = "Alert"
control_id = "ReactBitsDataSurfaceEmptyNotice"
classes = [ "rb-empty-state", "rb-empty-state-info" ]

[nodes.empty_notice.props]
component_role = "alert"
text = "Collection feedback"
value_text = "No result state keeps the filter context and offers a clear recovery path."
validation_level = "info"
background_color = "$surface.panel"
foreground_color = "$text.secondary"
border_color = "$border.default"
border_width = 1
corner_radius = 8
accessibility_label = "Empty state guidance"

[nodes.empty_notice.layout]
clip = true

[nodes.empty_notice.layout.width]
stretch = "Stretch"

[nodes.empty_notice.layout.height]
min = 52
preferred = 56
max = 64
stretch = "Fixed"

[nodes.empty_notice.layout.padding]
left = 10
right = 10
top = 7
bottom = 7

