penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/tests/reactbits_data_surface_components.zui\"\nversion = 2\ndisplay_name = \"ReactBits Data Surface Components\"\n\n[tokens]\n\"surface.canvas\" = \"#0f1117\"\n\"surface.panel\" = \"#171b24\"\n\"surface.elevated\" = \"#1d2330\"\n\"surface.inset\" = \"#11151d\"\n\"border.default\" = \"#2a3342\"\n\"border.strong\" = \"#3a4658\"\n\"text.primary\" = \"#f4f7fb\"\n\"text.secondary\" = \"#a9b4c5\"\n\"text.muted\" = \"#718096\"\n\"accent.primary\" = \"#8b7cff\"\n\"accent.info\" = \"#5da9ff\"\n\"status.success\" = \"#55d6a0\"\n\"status.warning\" = \"#f4bd62\"\n\"status.error\" = \"#ff7d8a\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsDataSurfaceRoot\"\nclasses = [\"rb-data-surface-fixture\"]\nprops = {\n  background_color = \"$surface.canvas\",\n  foreground_color = \"$text.primary\",\n  fixture_data_only = true,\n  reference_primary = \"https://pro.reactbits.dev/docs/app-ui/data-table\",\n  reference_supporting = [\n    \"https://pro.reactbits.dev/docs/app-ui/filtering\",\n    \"https://pro.reactbits.dev/docs/app-ui/file-manager\",\n    \"https://pro.reactbits.dev/docs/app-ui/list\",\n    \"https://pro.reactbits.dev/docs/app-ui/empty-state\",\n    \"https://pro.reactbits.dev/docs/app-ui/dashboard\",\n    \"https://pro.reactbits.dev/docs/app-ui/card\",\n    \"https://pro.reactbits.dev/docs/app-ui/monitoring\",\n  ],\n  responsive_wide = \"filter toolbar, metric cards, folder tree, and data table share one workbench frame\",\n  responsive_compact = \"the table keeps its sticky header while the folder tree and filters preserve readable rows\",\n  responsive_mobile = \"cards stack, filters stay reachable, and empty feedback remains visible below the collection\",\n  accessibility_label = \"Data table and filtering reference surface\",\n}\nlayout = {\n  clip = true,\n  input_policy = \"Receive\",\n  width = { min = 560, preferred = 1160, max = 1440, stretch = \"Stretch\" },\n  height = { min = 520, preferred = 760, max = 900, stretch = \"Stretch\" },\n  container = { kind = \"VerticalBox\", gap = 8 },\n  padding = { left = 14, right = 14, top = 14, bottom = 14 },\n}\nchildren = [\n  { node = \"header\" },\n  { node = \"toolbar\" },\n  { node = \"metrics\" },\n  { node = \"content_row\" },\n  { node = \"empty_notice\" },\n]\n\n[nodes.header]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsDataSurfaceHeader\"\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 42, preferred = 42, max = 42, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 }, padding = { left = 10, right = 10, top = 7, bottom = 7 } }\nchildren = [{ node = \"header_title\" }, { node = \"header_status\" }]\n\n[nodes.header_title]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsDataSurfaceTitle\"\nprops = { text = \"Project assets\", foreground_color = \"$text.primary\", font_size = 15, font_weight = 650, accessibility_label = \"Project assets\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_status]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsDataSurfaceStatus\"\nprops = { text = \"DATA SURFACE\", foreground_color = \"$status.success\", font_size = 9, font_weight = 700, letter_spacing = 0.8, text_align = \"right\" }\nlayout = { width = { min = 104, preferred = 124, max = 140, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsDataSurfaceToolbar\"\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 48, preferred = 48, max = 48, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 6 }, padding = { left = 8, right = 8, top = 6, bottom = 6 } }\nchildren = [{ node = \"filter_query\" }, { node = \"filter_kind\" }, { node = \"filter_status\" }]\n\n[nodes.filter_query]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsDataSurfaceQuery\"\nclasses = [\"rb-filter-query\"]\nprops = {\n  component_role = \"search-field\",\n  value_text = \"mesh\",\n  placeholder = \"Filter assets\",\n  text = \"mesh\",\n  input_interactive = true,\n  input_clickable = true,\n  input_hoverable = true,\n  input_focusable = true,\n  accessibility_label = \"Filter project assets\",\n}\nlayout = { width = { min = 180, preferred = 420, max = 720, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 8, right = 8, top = 4, bottom = 4 } }\nevents = [{ id = \"ReactBitsDataSurface/QueryChange\", event = \"Change\", route = \"assets.filter.query\" }]\n\n[nodes.filter_kind]\ncomponent = \"Chip\"\ncontrol_id = \"ReactBitsDataSurfaceKindFilter\"\nclasses = [\"rb-filter-chip\", \"rb-filter-chip-selected\"]\nprops = { component_role = \"chip\", text = \"Mesh\", value_text = \"Mesh\", selected = true, accessibility_label = \"Filter by mesh assets\" }\nlayout = { width = { min = 72, preferred = 84, max = 96, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.filter_status]\ncomponent = \"Chip\"\ncontrol_id = \"ReactBitsDataSurfaceStatusFilter\"\nclasses = [\"rb-filter-chip\"]\nprops = { component_role = \"chip\", text = \"Ready\", value_text = \"Ready\", selected = false, accessibility_label = \"Filter by ready status\" }\nlayout = { width = { min = 72, preferred = 84, max = 96, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.metrics]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsDataSurfaceMetrics\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 72, preferred = 72, max = 80, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 } }\nchildren = [{ node = \"metric_assets\" }, { node = \"metric_size\" }, { node = \"metric_health\" }]\n\n[nodes.metric_assets]\ncomponent = \"Paper\"\ncontrol_id = \"ReactBitsDataSurfaceMetricAssets\"\nclasses = [\"rb-metric-card\"]\nprops = { component_role = \"paper\", background_color = \"$surface.elevated\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, accessibility_label = \"Asset count metric\" }\nlayout = { width = { min = 96, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 2 }, padding = { left = 9, right = 9, top = 8, bottom = 8 } }\nchildren = [{ node = \"metric_assets_label\" }, { node = \"metric_assets_value\" }]\n\n[nodes.metric_assets_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsDataSurfaceMetricAssetsLabel\"\nprops = { text = \"Assets\", foreground_color = \"$text.muted\", font_size = 10, accessibility_label = \"Assets\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.metric_assets_value]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsDataSurfaceMetricAssetsValue\"\nprops = { text = \"128\", foreground_color = \"$text.primary\", font_size = 18, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.metric_size]\ncomponent = \"Paper\"\ncontrol_id = \"ReactBitsDataSurfaceMetricSize\"\nclasses = [\"rb-metric-card\"]\nprops = { component_role = \"paper\", background_color = \"$surface.elevated\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, accessibility_label = \"Storage metric\" }\nlayout = { width = { min = 96, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 2 }, padding = { left = 9, right = 9, top = 8, bottom = 8 } }\nchildren = [{ node = \"metric_size_label\" }, { node = \"metric_size_value\" }]\n\n[nodes.metric_size_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsDataSurfaceMetricSizeLabel\"\nprops = { text = \"Storage\", foreground_color = \"$text.muted\", font_size = 10, accessibility_label = \"Storage\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.metric_size_value]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsDataSurfaceMetricSizeValue\"\nprops = { text = \"2.4 GB\", foreground_color = \"$text.primary\", font_size = 18, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.metric_health]\ncomponent = \"Paper\"\ncontrol_id = \"ReactBitsDataSurfaceMetricHealth\"\nclasses = [\"rb-metric-card\"]\nprops = { component_role = \"paper\", background_color = \"$surface.elevated\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, accessibility_label = \"Validation health metric\" }\nlayout = { width = { min = 96, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 2 }, padding = { left = 9, right = 9, top = 8, bottom = 8 } }\nchildren = [{ node = \"metric_health_label\" }, { node = \"metric_health_value\" }]\n\n[nodes.metric_health_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsDataSurfaceMetricHealthLabel\"\nprops = { text = \"Validation\", foreground_color = \"$text.muted\", font_size = 10, accessibility_label = \"Validation\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.metric_health_value]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsDataSurfaceMetricHealthValue\"\nprops = { text = \"98% healthy\", foreground_color = \"$status.success\", font_size = 16, font_weight = 650 }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.content_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsDataSurfaceContent\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 210, stretch = \"Stretch\" }, container = { kind = \"HorizontalBox\", gap = 8 } }\nchildren = [{ node = \"tree\" }, { node = \"grid\" }]\n\n[nodes.tree]\ncomponent = \"TreeView\"\ncontrol_id = \"ReactBitsDataSurfaceTree\"\nclasses = [\"MuiTreeView-root\", \"rb-file-tree\"]\nprops = {\n  component_role = \"mui-x-tree-view\",\n  collection_virtualization = \"windowed\",\n  viewport_start = 0,\n  visible_limit = 3,\n  text = \"Folders\",\n  collection_items = [\n    \"expanded|0|Assets\",\n    \"selected|1|Meshes\",\n    \"normal|1|Materials\",\n    \"normal|0|Scenes\",\n  ],\n  selected_id = \"Meshes\",\n  empty_text = \"No folders\",\n  value_text = \"No folders\",\n  background_color = \"$surface.elevated\",\n  foreground_color = \"$text.primary\",\n  border_color = \"$border.default\",\n  border_width = 1,\n  corner_radius = 8,\n  accessibility_label = \"Project asset folders\",\n}\nlayout = { width = { min = 156, preferred = 238, max = 280, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" }, clip = true, padding = { left = 8, right = 8, top = 8, bottom = 8 } }\n\n[nodes.grid]\ncomponent = \"DataGrid\"\ncontrol_id = \"ReactBitsDataSurfaceGrid\"\nclasses = [\"MuiDataGrid-root\", \"rb-asset-table\"]\nprops = {\n  component_role = \"mui-x-data-grid\",\n  collection_virtualization = \"windowed\",\n  viewport_start = 0,\n  visible_limit = 3,\n  text = \"Assets\",\n  options = [\"Name\", \"Type\", \"Size\", \"Status\"],\n  column_alignments = [\"left\", \"left\", \"right\", \"center\"],\n  collection_items = [\n    \"selected|SM_Tree_Oak_01|Static Mesh|2.4 MB|Ready\",\n    \"normal|SM_Rock_Cliff|Static Mesh|3.1 MB|Ready\",\n    \"warning|M_Bark_Master|Material|512 KB|Review\",\n    \"success|T_Leaf_N|Texture|1.2 MB|Ready\",\n  ],\n  selected_row_id = \"SM_Tree_Oak_01\",\n  empty_text = \"No assets match the current filters\",\n  value_text = \"No assets match the current filters\",\n  background_color = \"$surface.elevated\",\n  foreground_color = \"$text.primary\",\n  border_color = \"$border.default\",\n  border_width = 1,\n  corner_radius = 8,\n  accessibility_label = \"Project asset data table\",\n}\nlayout = { width = { min = 360, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, clip = true, padding = { left = 8, right = 8, top = 8, bottom = 8 } }\n\n[nodes.empty_notice]\ncomponent = \"Alert\"\ncontrol_id = \"ReactBitsDataSurfaceEmptyNotice\"\nclasses = [\"rb-empty-state\", \"rb-empty-state-info\"]\nprops = {\n  component_role = \"alert\",\n  text = \"Collection feedback\",\n  value_text = \"No result state keeps the filter context and offers a clear recovery path.\",\n  validation_level = \"info\",\n  background_color = \"$surface.panel\",\n  foreground_color = \"$text.secondary\",\n  border_color = \"$border.default\",\n  border_width = 1,\n  corner_radius = 8,\n  accessibility_label = \"Empty state guidance\",\n}\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 52, preferred = 56, max = 64, stretch = \"Fixed\" }, clip = true, padding = { left = 10, right = 10, top = 7, bottom = 7 } }\n\n[nodes.root.zircon_extension]\nowner = \"reactbits-reference-slice\"\nreference_profile = \"reactbits-data-surface-components-v1\"\nsource_of_truth = \"zui\"\npenpot_visual_check = \"required\"\n\n[[stylesheets]]\nid = \"reactbits-ui-typography\"\n\n[[stylesheets.rules]]\nselector = \"*\"\nset = { self = { font = { asset = \"res://fonts/editor-ui.font.toml\", family = \"Fira Sans\" } } }\n"

