classes = [ "rb-auth-onboarding-fixture" ]

[nodes.root.props]
background_color = "$surface.canvas"
foreground_color = "$text.primary"
fixture_data_only = true
reference_primary = "https://pro.reactbits.dev/docs/app-ui/authentication/authentication-1"
reference_supporting = [ "https://pro.reactbits.dev/docs/app-ui/authentication/authentication-6", "https://pro.reactbits.dev/docs/app-ui/onboarding/onboarding-7", "https://pro.reactbits.dev/docs/app-ui/onboarding/onboarding-4" ]
responsive_wide = "a centered sign-in card and a workspace onboarding form share a balanced two-column flow"
responsive_compact = "the cards yield width and stack while labels remain start-aligned and progress stays end-aligned"
responsive_mobile = "one scroll owner exposes the auth fields before the onboarding steps and preserves primary actions"
layout_modes = [ "centered-auth", "provider-row", "verification-code", "horizontal-stepper", "workspace-slug", "windowed-workspace-list" ]
accessibility_label = "Authentication and workspace onboarding reference surface"

