[nodes.workspace_picker]
component = "ScrollableBox"
control_id = "ReactBitsOnboardingWorkspacePicker"

[nodes.workspace_picker.props]
collection_virtualization = "windowed"
viewport_start = 0
visible_limit = 3
collection_items = [ "selected|Zircon Design Lab|owner", "normal|Runtime Tools|member", "normal|Penpot Bridge|member", "normal|Archive Workspace|viewer" ]
collection_test_cases = [ "empty", "one", "normal", "overflow", "narrow", "long-locale" ]
long_locale_fixture_label = "A deliberately long localized workspace label for overflow coverage"
empty_text = "No workspaces available"
empty_text_key = "fixture.onboarding.workspace_list.empty"
scroll_owner = "workspace-picker"
background_color = "$surface.inset"
border_color = "$border.default"
border_width = 1
corner_radius = 7
accessibility_label = "Choose an existing workspace"

