penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/tests/reactbits_auth_onboarding_components.zui\"\nversion = 2\ndisplay_name = \"ReactBits Authentication And Onboarding Components\"\n\n[tokens]\n\"surface.canvas\" = \"#0f1117\"\n\"surface.panel\" = \"#171b24\"\n\"surface.elevated\" = \"#1d2330\"\n\"surface.inset\" = \"#11151d\"\n\"border.default\" = \"#2a3342\"\n\"border.strong\" = \"#3a4658\"\n\"text.primary\" = \"#f4f7fb\"\n\"text.secondary\" = \"#a9b4c5\"\n\"text.muted\" = \"#718096\"\n\"accent.primary\" = \"#8b7cff\"\n\"accent.info\" = \"#5da9ff\"\n\"status.success\" = \"#55d6a0\"\n\"status.warning\" = \"#f4bd62\"\n\"status.error\" = \"#ff7d8a\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAuthOnboardingRoot\"\nclasses = [\"rb-auth-onboarding-fixture\"]\nprops = {\n  background_color = \"$surface.canvas\",\n  foreground_color = \"$text.primary\",\n  fixture_data_only = true,\n  reference_primary = \"https://pro.reactbits.dev/docs/app-ui/authentication/authentication-1\",\n  reference_supporting = [\n    \"https://pro.reactbits.dev/docs/app-ui/authentication/authentication-6\",\n    \"https://pro.reactbits.dev/docs/app-ui/onboarding/onboarding-7\",\n    \"https://pro.reactbits.dev/docs/app-ui/onboarding/onboarding-4\",\n  ],\n  responsive_wide = \"a centered sign-in card and a workspace onboarding form share a balanced two-column flow\",\n  responsive_compact = \"the cards yield width and stack while labels remain start-aligned and progress stays end-aligned\",\n  responsive_mobile = \"one scroll owner exposes the auth fields before the onboarding steps and preserves primary actions\",\n  layout_modes = [\"centered-auth\", \"provider-row\", \"verification-code\", \"horizontal-stepper\", \"workspace-slug\", \"windowed-workspace-list\"],\n  accessibility_label = \"Authentication and workspace onboarding reference surface\",\n}\nlayout = {\n  clip = true,\n  input_policy = \"Receive\",\n  width = { min = 360, preferred = 1120, max = 1440, stretch = \"Stretch\" },\n  height = { min = 520, preferred = 820, max = 1040, stretch = \"Stretch\" },\n  container = { kind = \"VerticalBox\", gap = 10 },\n  padding = { left = 14, right = 14, top = 14, bottom = 14 },\n}\nchildren = [{ node = \"header\" }, { node = \"body\" }]\n\n[nodes.header]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAuthHeader\"\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 8 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 52, preferred = 52, max = 52, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 }, padding = { left = 12, right = 12, top = 8, bottom = 8 } }\nchildren = [{ node = \"brand\" }, { node = \"header_context\" }, { node = \"locale\" }]\n\n[nodes.brand]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAuthBrand\"\nprops = { text = \"Zircon access\", text_key = \"fixture.auth.header.brand\", icon = \"package\", icon_size = \"m\", button_variant = \"text\", foreground_color = \"$text.primary\", corner_radius = 6, text_align = \"left\", input_interactive = true, input_focusable = true, accessibility_label = \"Zircon access home\" }\nlayout = { width = { min = 144, preferred = 176, max = 220, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_context]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthHeaderContext\"\nprops = { text = \"Sign in or create a workspace\", text_key = \"fixture.auth.header.context\", foreground_color = \"$text.secondary\", font_size = 10, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.locale]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAuthLocale\"\nprops = { text = \"English (US)\", text_key = \"fixture.auth.header.locale\", button_variant = \"outlined\", foreground_color = \"$text.secondary\", border_color = \"$border.strong\", border_width = 1, corner_radius = 6, text_align = \"right\", input_interactive = true, input_focusable = true, accessibility_label = \"Choose language\" }\nlayout = { width = { min = 104, preferred = 126, max = 148, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" }, padding = { left = 8, right = 8, top = 5, bottom = 5 } }\n\n[nodes.body]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"ReactBitsAuthBody\"\nprops = { background_color = \"$surface.inset\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, scroll_owner = \"auth-onboarding-body\", accessibility_label = \"Authentication and onboarding content\" }\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { min = 0, stretch = \"Stretch\" }, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 10, scrollbar_visibility = \"Auto\" }, padding = { left = 12, right = 12, top = 12, bottom = 12 } }\nchildren = [{ node = \"main\" }]\n\n[nodes.main]\ncomponent = \"Stack\"\ncontrol_id = \"ReactBitsAuthOnboardingMain\"\nprops = { direction = { xs = \"column\", md = \"row\" }, spacing = { xs = 2, md = 2 } }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 560 } }\nchildren = [\n  { node = \"auth_card\", slot = { layout = { width = { min = 0, preferred = 420, weight = 1, stretch = \"Stretch\" } } } },\n  { node = \"onboarding_card\", slot = { layout = { width = { min = 0, preferred = 620, weight = 1, stretch = \"Stretch\" } } } },\n]\n\n[nodes.auth_card]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAuthCard\"\nclasses = [\"rb-auth-card\"]\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 10, accessibility_label = \"Sign in form\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 560 }, container = { kind = \"VerticalBox\", gap = 10 }, padding = { left = 18, right = 18, top = 18, bottom = 18 } }\nchildren = [\n  { node = \"auth_mark\" },\n  { node = \"auth_heading\" },\n  { node = \"provider_row\" },\n  { node = \"auth_divider\" },\n  { node = \"email_field\" },\n  { node = \"password_field\" },\n  { node = \"auth_options\" },\n  { node = \"auth_actions\" },\n  { node = \"terms\" },\n  { node = \"verification\" },\n]\n\n[nodes.auth_mark]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthMark\"\nprops = { text = \"Z\", text_key = \"fixture.auth.mark\", foreground_color = \"$accent.primary\", font_size = 24, font_weight = 700, text_align = \"center\", accessibility_label = \"Zircon\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30, preferred = 34, max = 38, stretch = \"Fixed\" } }\n\n[nodes.auth_heading]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAuthHeading\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 60, preferred = 68, max = 80, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 4 } }\nchildren = [{ node = \"auth_title\" }, { node = \"auth_subtitle\" }]\n\n[nodes.auth_title]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthTitle\"\nprops = { text = \"Welcome back\", text_key = \"fixture.auth.signin.title\", foreground_color = \"$text.primary\", font_size = 17, font_weight = 650, text_align = \"center\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 22, preferred = 24, max = 28, stretch = \"Fixed\" } }\n\n[nodes.auth_subtitle]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthSubtitle\"\nprops = { text = \"Use your account to continue to the workspace.\", text_key = \"fixture.auth.signin.subtitle\", foreground_color = \"$text.secondary\", font_size = 10, wrap = \"word\", text_align = \"center\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30, preferred = 34, max = 42, stretch = \"Fixed\" } }\n\n[nodes.provider_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAuthProviderRow\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 38, preferred = 40, max = 44, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 6 } }\nchildren = [{ node = \"provider_google\" }, { node = \"provider_github\" }, { node = \"provider_sso\" }]\n\n[nodes.provider_google]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAuthProviderGoogle\"\nprops = { text = \"Google\", text_key = \"fixture.auth.provider.google\", icon = \"check-circle\", icon_size = \"m\", button_variant = \"outlined\", foreground_color = \"$text.primary\", border_color = \"$border.strong\", border_width = 1, corner_radius = 6, text_align = \"center\", input_interactive = true, input_focusable = true, accessibility_label = \"Continue with Google\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.provider_github]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAuthProviderGithub\"\nprops = { text = \"GitHub\", text_key = \"fixture.auth.provider.github\", icon = \"package\", icon_size = \"m\", button_variant = \"outlined\", foreground_color = \"$text.primary\", border_color = \"$border.strong\", border_width = 1, corner_radius = 6, text_align = \"center\", input_interactive = true, input_focusable = true, accessibility_label = \"Continue with GitHub\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.provider_sso]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAuthProviderSso\"\nprops = { text = \"SSO\", text_key = \"fixture.auth.provider.sso\", icon = \"info\", icon_size = \"m\", button_variant = \"outlined\", foreground_color = \"$text.primary\", border_color = \"$border.strong\", border_width = 1, corner_radius = 6, text_align = \"center\", input_interactive = true, input_focusable = true, accessibility_label = \"Continue with single sign-on\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.auth_divider]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthDivider\"\nprops = { text = \"or continue with email\", text_key = \"fixture.auth.divider\", foreground_color = \"$text.muted\", font_size = 9, text_align = \"center\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18, preferred = 20, max = 22, stretch = \"Fixed\" } }\n\n[nodes.email_field]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAuthEmailField\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 66, preferred = 70, max = 78, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 4 } }\nchildren = [{ node = \"email_label\" }, { node = \"email_input\" }]\n\n[nodes.email_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthEmailLabel\"\nprops = { text = \"Work email\", text_key = \"fixture.auth.email.label\", foreground_color = \"$text.primary\", font_size = 10, font_weight = 600, text_align = \"left\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 16, max = 18, stretch = \"Fixed\" } }\n\n[nodes.email_input]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsAuthEmailInput\"\nprops = { component_role = \"auth-field\", value_text = \"builder@example.com\", value_key = \"fixture.auth.email.value\", placeholder = \"you@example.com\", placeholder_key = \"fixture.auth.email.placeholder\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true, accessibility_label = \"Work email\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 9, right = 9, top = 6, bottom = 6 } }\n\n[nodes.password_field]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAuthPasswordField\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 66, preferred = 70, max = 78, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 4 } }\nchildren = [{ node = \"password_label\" }, { node = \"password_input\" }]\n\n[nodes.password_label]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthPasswordLabel\"\nprops = { text = \"Password\", text_key = \"fixture.auth.password.label\", foreground_color = \"$text.primary\", font_size = 10, font_weight = 600, text_align = \"left\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 16, max = 18, stretch = \"Fixed\" } }\n\n[nodes.password_input]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsAuthPasswordInput\"\nprops = { component_role = \"auth-field\", value_text = \"••••••••••\", value_key = \"fixture.auth.password.value\", placeholder = \"Enter your password\", placeholder_key = \"fixture.auth.password.placeholder\", secret = true, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true, accessibility_label = \"Password\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 9, right = 9, top = 6, bottom = 6 } }\n\n[nodes.auth_options]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAuthOptions\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 30, max = 34, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 } }\nchildren = [{ node = \"remember\" }, { node = \"forgot\" }]\n\n[nodes.remember]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAuthRemember\"\nprops = { text = \"Keep me signed in\", text_key = \"fixture.auth.remember\", button_variant = \"text\", selected = true, foreground_color = \"$text.secondary\", text_align = \"left\", input_interactive = true, input_focusable = true, accessibility_label = \"Keep me signed in\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.forgot]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAuthForgot\"\nprops = { text = \"Forgot password?\", text_key = \"fixture.auth.forgot\", button_variant = \"text\", foreground_color = \"$accent.info\", text_align = \"right\", input_interactive = true, input_focusable = true, accessibility_label = \"Recover password\" }\nlayout = { width = { min = 116, preferred = 132, max = 156, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.auth_actions]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAuthActions\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 76, preferred = 82, max = 90, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 6 } }\nchildren = [{ node = \"signin\" }, { node = \"create_account\" }]\n\n[nodes.signin]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAuthSignIn\"\nprops = { text = \"Sign in\", text_key = \"fixture.auth.action.signin\", button_variant = \"contained\", background_color = \"$accent.primary\", foreground_color = \"$text.primary\", corner_radius = 6, text_align = \"center\", input_interactive = true, input_focusable = true, accessibility_label = \"Sign in\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 34, preferred = 36, max = 40, stretch = \"Fixed\" } }\n\n[nodes.create_account]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsAuthCreateAccount\"\nprops = { text = \"Create an account\", text_key = \"fixture.auth.action.create\", button_variant = \"text\", foreground_color = \"$text.secondary\", corner_radius = 6, text_align = \"center\", input_interactive = true, input_focusable = true, accessibility_label = \"Create an account\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 34, max = 38, stretch = \"Fixed\" } }\n\n[nodes.terms]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthTerms\"\nprops = { text = \"By continuing, you agree to the **workspace terms** and privacy policy.\", text_key = \"fixture.auth.terms\", rich_text_format = \"markdown_inline_v1\", foreground_color = \"$text.muted\", font_size = 9, wrap = \"word\", text_align = \"center\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 32, max = 40, stretch = \"Fixed\" } }\n\n[nodes.verification]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsAuthVerification\"\nprops = { background_color = \"$surface.elevated\", border_color = \"$border.default\", border_width = 1, corner_radius = 8, display = { xs = \"none\", md = \"flex\" }, accessibility_label = \"Verification code follow-up\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 112, preferred = 124, max = 140, stretch = \"Fixed\" }, container = { kind = \"VerticalBox\", gap = 6 }, padding = { left = 10, right = 10, top = 8, bottom = 8 } }\nchildren = [{ node = \"verification_heading\" }, { node = \"otp_row\" }, { node = \"verification_note\" }]\n\n[nodes.verification_heading]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthVerificationHeading\"\nprops = { text = \"Verify your sign-in\", text_key = \"fixture.auth.verification.title\", foreground_color = \"$text.primary\", font_size = 11, font_weight = 650, text_align = \"left\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 18, max = 20, stretch = \"Fixed\" } }\n\n[nodes.otp_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsAuthOtpRow\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30, preferred = 34, max = 38, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 5 } }\nchildren = [{ node = \"otp_1\" }, { node = \"otp_2\" }, { node = \"otp_3\" }, { node = \"otp_4\" }, { node = \"otp_5\" }, { node = \"otp_6\" }]\n\n[nodes.otp_1]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsAuthOtp1\"\nprops = { value_text = \"4\", value_key = \"fixture.auth.otp.1\", input_interactive = true, input_focusable = true, text_align = \"center\", accessibility_label = \"Verification digit 1 of 6\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 4, right = 4, top = 4, bottom = 4 } }\n\n[nodes.otp_2]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsAuthOtp2\"\nprops = { value_text = \"8\", value_key = \"fixture.auth.otp.2\", input_interactive = true, input_focusable = true, text_align = \"center\", accessibility_label = \"Verification digit 2 of 6\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 4, right = 4, top = 4, bottom = 4 } }\n\n[nodes.otp_3]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsAuthOtp3\"\nprops = { value_text = \"2\", value_key = \"fixture.auth.otp.3\", input_interactive = true, input_focusable = true, text_align = \"center\", accessibility_label = \"Verification digit 3 of 6\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 4, right = 4, top = 4, bottom = 4 } }\n\n[nodes.otp_4]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsAuthOtp4\"\nprops = { value_text = \"0\", value_key = \"fixture.auth.otp.4\", input_interactive = true, input_focusable = true, text_align = \"center\", accessibility_label = \"Verification digit 4 of 6\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 4, right = 4, top = 4, bottom = 4 } }\n\n[nodes.otp_5]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsAuthOtp5\"\nprops = { value_text = \"1\", value_key = \"fixture.auth.otp.5\", input_interactive = true, input_focusable = true, text_align = \"center\", accessibility_label = \"Verification digit 5 of 6\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 4, right = 4, top = 4, bottom = 4 } }\n\n[nodes.otp_6]\ncomponent = \"TextField\"\ncontrol_id = \"ReactBitsAuthOtp6\"\nprops = { value_text = \"6\", value_key = \"fixture.auth.otp.6\", input_interactive = true, input_focusable = true, text_align = \"center\", accessibility_label = \"Verification digit 6 of 6\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, padding = { left = 4, right = 4, top = 4, bottom = 4 } }\n\n[nodes.verification_note]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsAuthVerificationNote\"\nprops = { text = \"Code sent to **builder@example.com** · resend in 00:24\", text_key = \"fixture.auth.verification.note\", rich_text_format = \"markdown_inline_v1\", foreground_color = \"$text.secondary\", font_size = 9, text_overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16, preferred = 18, max = 22, stretch = \"Fixed\" } }\n\n[nodes.onboarding_card]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsOnboardingCard\"\nclasses = [\"rb-onboarding-card\"]\nprops = { background_color = \"$surface.panel\", border_color = \"$border.default\", border_width = 1, corner_radius = 10, accessibility_label = \"Workspace onboarding form\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 560 }, container = { kind = \"VerticalBox\", gap = 9 }, padding = { left = 16, right = 16, top = 16, bottom = 16 } }\nchildren = [{ node = \"onboarding_heading\" }, { node = \"stepper\" }, { node = \"workspace_name_row\" }, { node = \"slug_row\" }, { node = \"use_case_heading\" }, { node = \"use_case_row\" }, { node = \"team_size_row\" }, { node = \"workspace_picker\" }, { node = \"onboarding_actions\" }]\n\n[nodes.onboarding_heading]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsOnboardingHeading\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 54, preferred = 58, max = 64, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 8 } }\nchildren = [{ node = \"onboarding_heading_stack\" }, { node = \"onboarding_progress\" }]\n\n[nodes.onboarding_heading_stack]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ReactBitsOnboardingHeadingStack\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = 2 } }\nchildren = [{ node = \"onboarding_title\" }, { node = \"onboarding_subtitle\" }]\n\n[nodes.onboarding_title]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsOnboardingTitle\"\nprops = { text = \"Create your workspace\", text_key = \"fixture.onboarding.title\", foreground_color = \"$text.primary\", font_size = 15, font_weight = 650, text_align = \"left\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 20, preferred = 22, max = 26, stretch = \"Fixed\" } }\n\n[nodes.onboarding_subtitle]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsOnboardingSubtitle\"\nprops = { text = \"A few details help your team find the right starting point.\", text_key = \"fixture.onboarding.subtitle\", foreground_color = \"$text.secondary\", font_size = 10, wrap = \"word\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 30, max = 34, stretch = \"Fixed\" } }\n\n[nodes.onboarding_progress]\ncomponent = \"Label\"\ncontrol_id = \"ReactBitsOnboardingProgress\"\nprops = { text = \"Step 2 of 4\", text_key = \"fixture.onboarding.progress\", foreground_color = \"$accent.info\", font_size = 10, text_align = \"right\" }\nlayout = { width = { min = 72, preferred = 88, max = 104, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.stepper]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ReactBitsOnboardingStepper\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 36, max = 40, stretch = \"Fixed\" }, container = { kind = \"HorizontalBox\", gap = 5 } }\nchildren = [{ node = \"step_profile\" }, { node = \"step_workspace\" }, { node = \"step_team\" }, { node = \"step_finish\" }]\n\n[nodes.step_profile]\ncomponent = \"Button\"\ncontrol_id = \"ReactBitsOnboardingStepProfile\"\nprops = { text = \"1  Profile\", text_key = \"fixture.onboarding.step.profile\", button_variant = \"text\", selected = true, foreground_color = \"$status.success\", text_align = \"left\", input_interactive = true, input_focusable = true, accessibility_label = \"Profile step complete\" }\nlayout = { width = { min = 0, weight = 1, stretch = \"Stretch\" }, height = 