[asset]
kind = "component"
id = "res://ui/editor/material_components/layout/material_masonry.zui"
version = 2
display_name = "Material Masonry Prototype"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption"]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.MaterialMasonryPrototype]
root = "root"
default_classes = ["material-lab-prototype", "material-surface"]

[nodes.title]
component = "WorkbenchLabel"
control_id = "masonry_Title"
classes = ["material-lab-title"]
props = { "text" = "Masonry", "text_tone" = "primary", "font_size" = "$editor.typography.title.size", "font_weight" = "$editor.typography.strong.weight", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 28, "preferred" = 28, "max" = 28, "stretch" = "Fixed" } }

[nodes.meta]
component = "GridBox"
control_id = "masonry_Meta"
classes = ["material-lab-meta-strip", "material-lab-meta"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 100, "preferred" = 100, "max" = 100, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 2, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "meta_group" },
  { node = "meta_response" },
  { node = "meta_variant" },
  { node = "meta_layout" },
]

[nodes.meta_group]
component = "WorkbenchCaption"
control_id = "masonry_MetaGroup"
classes = ["material-lab-meta-chip", "material-lab-meta-group"]
props = { "text" = "Layout", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_response]
component = "WorkbenchCaption"
control_id = "masonry_MetaResponse"
classes = ["material-lab-meta-chip", "material-lab-meta-response"]
props = { "text" = "static / display", "text_tone" = "success", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "response_mechanism" = "static / display", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.meta_variant]
component = "WorkbenchCaption"
control_id = "masonry_MetaVariant"
classes = ["material-lab-meta-chip", "material-lab-meta-variant"]
props = { "text" = "responsive / dense", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "variant" = "responsive / dense", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_layout]
component = "WorkbenchCaption"
control_id = "masonry_MetaLayout"
classes = ["material-lab-meta-chip", "material-lab-meta-layout"]
props = { "text" = "masonry flow", "text_tone" = "warning", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "layout_mode" = "masonry flow", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.sample]
component = "Masonry"
control_id = "masonry_Sample"
classes = ["material-control", "material-lab-sample", "MuiMasonry-root"]
props = { text = "Masonry", className = "material-masonry-sample", component = "div", columns = 4, spacing = "1", sequential = true, defaultColumns = 4, defaultHeight = "180", defaultSpacing = "1", surface_variant = "elevated", button_variant = "contained", text_tone = "primary", validation_level = "normal", hovered = true, pressed = false, focused = true, selected = true, checked = true, disabled = false, open = true, popup_open = true, corner_radius = 4, border_width = 1, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 180.0, preferred = 180.0, max = 180.0, stretch = "Fixed" }, container = { kind = "Masonry", columns = 4, gap = 8.0, sequential = true } }
children = [
  { node = "tile_alpha" },
  { node = "tile_beta" },
  { node = "tile_gamma" },
  { node = "tile_delta" },
  { node = "tile_epsilon" },
  { node = "tile_zeta" },
  { node = "tile_eta" },
  { node = "tile_theta" },
]

[nodes.tile_alpha]
component = "Label"
control_id = "masonry_TileAlpha"
classes = ["material-lab-state-pill", "material-masonry-tile", "MuiMasonry-item"]
props = { text = "1", text_tone = "primary", font_size = 12, surface_variant = "elevated", corner_radius = 8, border_width = 1 }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }

[nodes.tile_beta]
component = "Label"
control_id = "masonry_TileBeta"
classes = ["material-lab-state-pill", "material-masonry-tile", "MuiMasonry-item"]
props = { text = "2", text_tone = "secondary", font_size = 12, surface_variant = "elevated", corner_radius = 8, border_width = 1 }
layout = { width = { stretch = "Stretch" }, height = { min = 58.0, preferred = 58.0, max = 58.0, stretch = "Fixed" } }

[nodes.tile_gamma]
component = "Label"
control_id = "masonry_TileGamma"
classes = ["material-lab-state-pill", "material-masonry-tile", "MuiMasonry-item"]
props = { text = "3", text_tone = "success", font_size = 12, surface_variant = "elevated", corner_radius = 8, border_width = 1 }
layout = { width = { stretch = "Stretch" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" } }

[nodes.tile_delta]
component = "Label"
control_id = "masonry_TileDelta"
classes = ["material-lab-state-pill", "material-masonry-tile", "MuiMasonry-item"]
props = { text = "4", text_tone = "warning", font_size = 12, surface_variant = "elevated", corner_radius = 8, border_width = 1 }
layout = { width = { stretch = "Stretch" }, height = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" } }

[nodes.tile_epsilon]
component = "Label"
control_id = "masonry_TileEpsilon"
classes = ["material-lab-state-pill", "material-masonry-tile", "MuiMasonry-item"]
props = { text = "5", text_tone = "primary", font_size = 12, surface_variant = "elevated", corner_radius = 8, border_width = 1 }
layout = { width = { stretch = "Stretch" }, height = { min = 48.0, preferred = 48.0, max = 48.0, stretch = "Fixed" } }

[nodes.tile_zeta]
component = "Label"
control_id = "masonry_TileZeta"
classes = ["material-lab-state-pill", "material-masonry-tile", "MuiMasonry-item"]
props = { text = "6", text_tone = "info", font_size = 12, surface_variant = "elevated", corner_radius = 8, border_width = 1 }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.tile_eta]
component = "Label"
control_id = "masonry_TileEta"
classes = ["material-lab-state-pill", "material-masonry-tile", "MuiMasonry-item"]
props = { text = "7", text_tone = "primary", font_size = 12, surface_variant = "elevated", corner_radius = 8, border_width = 1 }
layout = { width = { stretch = "Stretch" }, height = { min = 64.0, preferred = 64.0, max = 64.0, stretch = "Fixed" } }

[nodes.tile_theta]
component = "Label"
control_id = "masonry_TileTheta"
classes = ["material-lab-state-pill", "material-masonry-tile", "MuiMasonry-item"]
props = { text = "8", text_tone = "error", font_size = 12, surface_variant = "elevated", corner_radius = 8, border_width = 1 }
layout = { width = { stretch = "Stretch" }, height = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" } }

[nodes.state_strip]
component = "GridBox"
control_id = "masonry_StateStrip"
classes = ["material-lab-state-strip"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 108, "preferred" = 108, "max" = 108, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "state_default" },
  { node = "state_hover" },
  { node = "state_pressed" },
  { node = "state_focus" },
  { node = "state_disabled" },
  { node = "state_selected" },
  { node = "state_open" },
  { node = "state_error" },
]
[nodes.state_default]
component = "WorkbenchCaption"
control_id = "masonry_StateDefault"
classes = ["material-lab-state-pill", "material-lab-state-default"]
props = { "text" = "Default", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
