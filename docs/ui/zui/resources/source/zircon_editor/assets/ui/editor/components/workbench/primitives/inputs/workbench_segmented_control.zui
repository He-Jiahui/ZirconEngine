[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_segmented_control.zui"
version = 2
display_name = "Workbench Segmented Control"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchSegmentedControl]
root = "root"
default_classes = ["workbench-segmented-control", "workbench-primitive"]

[nodes.root]
component = "SegmentedControl"
control_id = "WorkbenchSegmentedControlRoot"
classes = ["workbench-segmented-control"]
props = { value = "center", options = ["left", "center", "right"], selection_state = "single", background_color = "$editor.surface.2", hover_background_color = "$editor.surface.hover", pressed_background_color = "$editor.surface.3", selected_background_color = "$editor.surface.selected", disabled_background_color = "$editor.surface.disabled", border_color = "$editor.border", focus_border_color = "$editor.focus.ring", selected_border_color = "$editor.accent", selected_underline_color = "$editor.accent", foreground_color = "$editor.text.secondary", selected_foreground_color = "$editor.text.primary", label_color = "$editor.text.secondary", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_min_height = "$editor.control.height.dense", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
