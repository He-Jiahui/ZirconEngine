classes = ["woc-bar-rail"]
layout = { container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = "Fixed" } }
children = [{ node = "target_health_fill" }, { node = "target_absorb" }, { node = "target_health_text" }]

[nodes.target_resource_fill]
component = "Space"
