[asset]
kind = "view"
id = "res://ui/hud/in_world_hud.zui"
version = 2
display_name = "World of ClaudeCraft In-World HUD"

[imports]
widgets = []
styles = ["res://ui/shell/shell_theme.zui", "res://ui/hud/hud_theme.zui"]
resources = []

[root]
node = "hud_root"

[nodes.combat_live]
component = "Label"
control_id = "CombatLiveRegion"
classes = ["woc-live-region"]
props = { text = "", overflow = "elide" }
layout = { width = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" } }

[nodes.target_live]
component = "Label"
control_id = "TargetLiveRegion"
classes = ["woc-live-region"]
props = { text = "", overflow = "elide" }
layout = { width = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" } }

[nodes.chat_live]
component = "Label"
control_id = "ChatLiveRegion"
classes = ["woc-live-region"]
props = { text = "", overflow = "elide" }
layout = { width = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" } }

[nodes.live_regions]
component = "VerticalBox"
control_id = "HudLiveRegions"
layout = { container = { kind = "VerticalBox", gap = 0.0 }, anchor = { x = 0.0, y = 0.0 }, pivot = { x = 1.0, y = 1.0 }, position = { x = -8.0, y = -8.0 }, width = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" }, height = { min = 3.0, preferred = 3.0, max = 3.0, stretch = "Fixed" } }
children = [{ node = "combat_live" }, { node = "target_live" }, { node = "chat_live" }]

[nodes.target_portrait]
component = "Space"
control_id = "TargetPortraitHost"
classes = ["woc-portrait"]
layout = { width = { min = 60.0, preferred = 60.0, max = 60.0, stretch = "Fixed" }, height = { min = 60.0, preferred = 60.0, max = 60.0, stretch = "Fixed" } }

[nodes.target_level]
component = "Label"
control_id = "TargetLevel"
classes = ["woc-level-chip"]
props = { text = "", text_align = "center" }
layout = { anchor = { x = 1.0, y = 1.0 }, pivot = { x = 1.0, y = 1.0 }, position = { x = 2.0, y = 2.0 }, width = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }

[nodes.target_portrait_wrap]
component = "Overlay"
control_id = "TargetPortrait"
layout = { container = { kind = "Overlay" }, width = { min = 64.0, preferred = 64.0, max = 64.0, stretch = "Fixed" }, height = { min = 64.0, preferred = 64.0, max = 64.0, stretch = "Fixed" } }
children = [{ node = "target_portrait" }, { node = "target_level" }]

[nodes.target_name]
component = "Label"
control_id = "TargetName"
classes = ["woc-unit-name"]
props = { text = "", overflow = "elide", text_align = "right" }
layout = { width = { stretch = "Stretch" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = "Fixed" } }

[nodes.target_health_fill]
component = "Space"
control_id = "TargetHealthFill"
classes = ["woc-health-fill"]
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.target_absorb]
