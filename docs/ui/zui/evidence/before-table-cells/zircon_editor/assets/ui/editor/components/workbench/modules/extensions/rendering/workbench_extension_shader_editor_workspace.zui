[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/rendering/workbench_extension_shader_editor_workspace.zui"
version = 2
display_name = "Workbench Extension Shader Editor Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []
[components.WorkbenchExtensionShaderEditorWorkspace]
root = "shader_editor_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.shader_editor_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionShaderEditorWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "shader_workspace_main" },
  { node = "shader_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.shader_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "shader_rail_gap" }, { node = "shader_left" }, { node = "shader_center" }, { node = "shader_right_reserve" }]

[nodes.shader_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.shader_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionShaderRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.shader_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionShaderLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "shader_title" }, { node = "shader_left_content" }]

[nodes.shader_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionShaderLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "shader_source_row" }, { node = "shader_include_row" }, { node = "shader_permutation_row" }]

[nodes.shader_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionShaderTitle"
props = { text = "Shader Editor" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.shader_source_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionShaderSourceRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "lighting.wgsl", icon = "code", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorSourceRow", event = "Click", route = "workbench.extension.shader_editor.source_file" }]

[nodes.shader_include_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionShaderIncludeRow"
classes = ["workbench-list-row"]
props = { text = "common.wgsl", icon = "file", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorIncludeRow", event = "Click", route = "workbench.extension.shader_editor.include" }]

[nodes.shader_permutation_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionShaderPermutationRow"
classes = ["workbench-list-row"]
props = { text = "Permutation_SM5", icon = "grid", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorPermutationRow", event = "Click", route = "workbench.extension.shader_editor.permutation" }]

[nodes.shader_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionShaderCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "shader_center_header" }, { node = "shader_compile_table" }, { node = "shader_output" }]

[nodes.shader_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionShaderCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "shader_center_title" }, { node = "shader_header_fill" }, { node = "shader_preview_button" }, { node = "shader_compile_button" }]

[nodes.shader_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionShaderCenterTitle"
props = { text = "Shader Compile Workspace" }
layout = { width = { min = 220.0, preferred = 220.0, max = 260.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.shader_header_fill]
component = "Container"
control_id = "WorkbenchExtensionShaderHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.shader_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionShaderPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorPreview", event = "Click", route = "workbench.extension.shader_editor.preview" }]

[nodes.shader_compile_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionShaderCompileButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Compile", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 82.0, preferred = 82.0, max = 92.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorCompile", event = "Click", route = "workbench.extension.shader_editor.compile" }]

[nodes.shader_compile_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionShaderCompileTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "shader_vertex_row" }, { node = "shader_fragment_row" }, { node = "shader_compute_row" }, { node = "shader_common_row" }]

[nodes.shader_vertex_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionShaderVertexRow"
classes = ["workbench-table-row"]
props = { text = "Vertex", value_text = "vs_main   Camera   Ready", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorVertexRow", event = "Click", route = "workbench.extension.shader_editor.stage.vertex" }]

[nodes.shader_fragment_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionShaderFragmentRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Fragment", value_text = "fs_main   GBuffer   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorFragmentRow", event = "Click", route = "workbench.extension.shader_editor.stage.fragment" }]

[nodes.shader_compute_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionShaderComputeRow"
classes = ["workbench-table-row"]
props = { text = "Compute", value_text = "cs_tile   Lighting   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorComputeRow", event = "Click", route = "workbench.extension.shader_editor.stage.compute" }]

[nodes.shader_common_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionShaderCommonRow"
classes = ["workbench-table-row"]
props = { text = "Include", value_text = "common   BRDF   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorCommonRow", event = "Click", route = "workbench.extension.shader_editor.include.common" }]

[nodes.shader_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionShaderOutputRow"
classes = ["workbench-table-row"]
props = { text = "Compiler", value_text = "3 warnings   0 errors   0.31 ms", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.shader_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionShaderRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "shader_details_title" }, { node = "shader_right_content" }]

[nodes.shader_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionShaderRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "shader_target_dropdown_property_row" }, { node = "shader_entry_field_property_row" }, { node = "shader_live_compile_dropdown_property_row" }]

[nodes.shader_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionShaderDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.shader_target_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionShaderTargetDropdownPropertyRow"
props = { text = "Target" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "shader_target_dropdown", slot = { name = "value" } }]

[nodes.shader_target_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionShaderTargetDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "wgpu", value = "wgpu", options = ["wgpu", "spirv", "metal"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ShaderEditorTargetEdit", event = "Change", route = "workbench.extension.shader_editor.target.edit" },
  { id = "WorkbenchExtension/ShaderEditorTargetCommit", event = "Submit", route = "workbench.extension.shader_editor.target.commit" },
]

[nodes.shader_entry_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionShaderEntryFieldPropertyRow"
props = { text = "Entry" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "shader_entry_field", slot = { name = "value" } }]

[nodes.shader_entry_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionShaderEntryField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "fs_main" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ShaderEditorEntryEdit", event = "Change", route = "workbench.extension.shader_editor.entry.edit" },
  { id = "WorkbenchExtension/ShaderEditorEntryCommit", event = "Submit", route = "workbench.extension.shader_editor.entry.commit" },
]

[nodes.shader_live_compile_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionShaderLiveCompileDropdownPropertyRow"
props = { text = "Live Compile" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "shader_live_compile_dropdown", slot = { name = "value" } }]

[nodes.shader_live_compile_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionShaderLiveCompileDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "On", value = "on", options = ["on|label=On", "paused|label=Paused", "manual|label=Manual"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ShaderEditorLiveCompileEdit", event = "Change", route = "workbench.extension.shader_editor.live_compile.edit" },
  { id = "WorkbenchExtension/ShaderEditorLiveCompileCommit", event = "Submit", route = "workbench.extension.shader_editor.live_compile.commit" },
]
