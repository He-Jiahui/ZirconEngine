[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/world/workbench_extension_scatter_editor_workspace.zui"
version = 2
display_name = "Workbench Extension Scatter Editor Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionScatterEditorWorkspace]
root = "scatter_editor_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.scatter_editor_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionScatterEditorWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "scatter_editor_workspace_main" },
  { node = "scatter_editor_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.scatter_editor_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "scatter_editor_rail_gap" }, { node = "scatter_editor_left" }, { node = "scatter_editor_center" }, { node = "scatter_editor_right_reserve" }]

[nodes.scatter_editor_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.scatter_editor_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionScatterEditorRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.scatter_editor_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionScatterEditorLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "scatter_editor_title" }, { node = "scatter_editor_left_content" }]

[nodes.scatter_editor_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionScatterEditorLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "scatter_editor_set_row" }, { node = "scatter_editor_rocks_rule_row" }, { node = "scatter_editor_ferns_rule_row" }]

[nodes.scatter_editor_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionScatterEditorTitle"
props = { text = "Scatter Editor" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.scatter_editor_set_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionScatterEditorSetRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "SC_Forest", icon = "globe", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ScatterEditorSetRow", event = "Click", route = "workbench.extension.scatter_editor.set" }]

[nodes.scatter_editor_rocks_rule_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionScatterEditorRocksRuleRow"
classes = ["workbench-list-row"]
props = { text = "Rule_Rocks", icon = "grid", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ScatterEditorRocksRuleRow", event = "Click", route = "workbench.extension.scatter_editor.rule.rocks" }]

[nodes.scatter_editor_ferns_rule_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionScatterEditorFernsRuleRow"
classes = ["workbench-list-row"]
props = { text = "Rule_Ferns", icon = "layers", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ScatterEditorFernsRuleRow", event = "Click", route = "workbench.extension.scatter_editor.rule.ferns" }]

[nodes.scatter_editor_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionScatterEditorCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "scatter_editor_center_header" }, { node = "scatter_editor_rule_table" }, { node = "scatter_editor_output" }]

[nodes.scatter_editor_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionScatterEditorCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "scatter_editor_center_title" }, { node = "scatter_editor_header_fill" }, { node = "scatter_editor_generate_button" }, { node = "scatter_editor_validate_button" }]

[nodes.scatter_editor_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionScatterEditorCenterTitle"
props = { text = "Scatter Rule Graph" }
layout = { width = { min = 240.0, preferred = 240.0, max = 320.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.scatter_editor_header_fill]
component = "Container"
control_id = "WorkbenchExtensionScatterEditorHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.scatter_editor_generate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionScatterEditorGenerateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Generate", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 96.0, preferred = 96.0, max = 106.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ScatterEditorGenerate", event = "Click", route = "workbench.extension.scatter_editor.generate" }]

[nodes.scatter_editor_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionScatterEditorValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ScatterEditorValidate", event = "Click", route = "workbench.extension.scatter_editor.validate" }]

[nodes.scatter_editor_rule_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionScatterEditorRuleTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "scatter_editor_biome_mask_table_row" }, { node = "scatter_editor_slope_filter_table_row" }, { node = "scatter_editor_spawn_rule_table_row" }, { node = "scatter_editor_collision_test_table_row" }]

[nodes.scatter_editor_biome_mask_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionScatterEditorBiomeMaskTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Biome Mask", value_text = "Input   Forest   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ScatterEditorBiomeMaskTableRow", event = "Click", route = "workbench.extension.scatter_editor.rule.biome_mask" }]

[nodes.scatter_editor_slope_filter_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionScatterEditorSlopeFilterTableRow"
classes = ["workbench-table-row"]
props = { text = "Slope Filter", value_text = "Constraint   0-38 deg   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ScatterEditorSlopeFilterTableRow", event = "Click", route = "workbench.extension.scatter_editor.rule.slope_filter" }]

[nodes.scatter_editor_spawn_rule_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionScatterEditorSpawnRuleTableRow"
classes = ["workbench-table-row"]
props = { text = "Spawn Rule", value_text = "Rule   Rocks + Ferns   64K" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ScatterEditorSpawnRuleTableRow", event = "Click", route = "workbench.extension.scatter_editor.rule.spawn_rule" }]

[nodes.scatter_editor_collision_test_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionScatterEditorCollisionTestTableRow"
classes = ["workbench-table-row"]
props = { text = "Collision Test", value_text = "Validation   1 conflict   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ScatterEditorCollisionTestTableRow", event = "Click", route = "workbench.extension.scatter_editor.rule.collision_test" }]

[nodes.scatter_editor_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionScatterEditorOutputRow"
classes = ["workbench-table-row"]
props = { text = "Scatter Log", value_text = "18 rules   64K instances   1 conflict", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.scatter_editor_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionScatterEditorRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "scatter_editor_details_title" }, { node = "scatter_editor_right_content" }]

[nodes.scatter_editor_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionScatterEditorRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "scatter_editor_rule_set_dropdown_property_row" }, { node = "scatter_editor_seed_field_property_row" }, { node = "scatter_editor_density_field_property_row" }]

[nodes.scatter_editor_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionScatterEditorDetailsTitle"
props = { text = "Scatter Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.scatter_editor_rule_set_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionScatterEditorRuleSetDropdownPropertyRow"
props = { text = "Rule Set" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "scatter_editor_rule_set_dropdown", slot = { name = "value" } }]

[nodes.scatter_editor_rule_set_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionScatterEditorRuleSetDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "SC_Forest", value = "SC_Forest", options = ["SC_Forest", "SC_Riverbank", "SC_Cliff", "SC_Meadow"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ScatterEditorRuleSetEdit", event = "Change", route = "workbench.extension.scatter_editor.rule_set.edit" },
  { id = "WorkbenchExtension/ScatterEditorRuleSetCommit", event = "Submit", route = "workbench.extension.scatter_editor.rule_set.commit" },
]

[nodes.scatter_editor_seed_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionScatterEditorSeedFieldPropertyRow"
props = { text = "Seed" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "scatter_editor_seed_field", slot = { name = "value" } }]

[nodes.scatter_editor_seed_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionScatterEditorSeedField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Seed: 2026" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ScatterEditorSeedEdit", event = "Change", route = "workbench.extension.scatter_editor.seed.edit" },
  { id = "WorkbenchExtension/ScatterEditorSeedCommit", event = "Submit", route = "workbench.extension.scatter_editor.seed.commit" },
]

[nodes.scatter_editor_density_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionScatterEditorDensityFieldPropertyRow"
props = { text = "Density" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "scatter_editor_density_field", slot = { name = "value" } }]

[nodes.scatter_editor_density_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionScatterEditorDensityField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Density: 0.64" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ScatterEditorDensityEdit", event = "Change", route = "workbench.extension.scatter_editor.density.edit" },
  { id = "WorkbenchExtension/ScatterEditorDensityCommit", event = "Submit", route = "workbench.extension.scatter_editor.density.commit" },
]
