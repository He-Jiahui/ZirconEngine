[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/world/workbench_extension_weather_editor_workspace.zui"
version = 2
display_name = "Workbench Extension Weather Editor Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionWeatherEditorWorkspace]
root = "weather_editor_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.weather_editor_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionWeatherEditorWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "weather_editor_workspace_main" },
  { node = "weather_editor_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.weather_editor_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "weather_editor_rail_gap" }, { node = "weather_editor_left" }, { node = "weather_editor_center" }, { node = "weather_editor_right_reserve" }]

[nodes.weather_editor_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.weather_editor_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionWeatherEditorRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.weather_editor_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionWeatherEditorLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "weather_editor_title" }, { node = "weather_editor_left_content" }]

[nodes.weather_editor_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionWeatherEditorLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "weather_editor_storm_row" }, { node = "weather_editor_mountains_region_row" }, { node = "weather_editor_cloud_layer_row" }]

[nodes.weather_editor_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionWeatherEditorTitle"
props = { text = "Weather Editor" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.weather_editor_storm_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionWeatherEditorStormRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Weather_Storm", icon = "sun", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WeatherEditorStormRow", event = "Click", route = "workbench.extension.weather_editor.weather.storm" }]

[nodes.weather_editor_mountains_region_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionWeatherEditorMountainsRegionRow"
classes = ["workbench-list-row"]
props = { text = "Region_Mountains", icon = "globe", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WeatherEditorMountainsRegionRow", event = "Click", route = "workbench.extension.weather_editor.region.mountains" }]

[nodes.weather_editor_cloud_layer_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionWeatherEditorCloudLayerRow"
classes = ["workbench-list-row"]
props = { text = "Layer_Clouds", icon = "file", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WeatherEditorCloudLayerRow", event = "Click", route = "workbench.extension.weather_editor.layer.clouds" }]

[nodes.weather_editor_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionWeatherEditorCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "weather_editor_center_header" }, { node = "weather_editor_timeline_table" }, { node = "weather_editor_output" }]

[nodes.weather_editor_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionWeatherEditorCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "weather_editor_center_title" }, { node = "weather_editor_header_fill" }, { node = "weather_editor_preview_button" }, { node = "weather_editor_build_button" }]

[nodes.weather_editor_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionWeatherEditorCenterTitle"
props = { text = "Weather Timeline" }
layout = { width = { min = 250.0, preferred = 250.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.weather_editor_header_fill]
component = "Container"
control_id = "WorkbenchExtensionWeatherEditorHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.weather_editor_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionWeatherEditorPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WeatherEditorPreview", event = "Click", route = "workbench.extension.weather_editor.preview" }]

[nodes.weather_editor_build_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionWeatherEditorBuildButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Build", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WeatherEditorBuild", event = "Click", route = "workbench.extension.weather_editor.build" }]

[nodes.weather_editor_timeline_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionWeatherEditorTimelineTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "weather_editor_cloud_build_timeline_row" }, { node = "weather_editor_rain_burst_timeline_row" }, { node = "weather_editor_wind_gust_timeline_row" }, { node = "weather_editor_lightning_timeline_row" }]

[nodes.weather_editor_cloud_build_timeline_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWeatherEditorCloudBuildTimelineRow"
classes = ["workbench-table-row"]
props = { text = "Cloud Build", value_text = "00:00-02:00   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WeatherEditorCloudBuildTimelineRow", event = "Click", route = "workbench.extension.weather_editor.timeline.cloud_build" }]

[nodes.weather_editor_rain_burst_timeline_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWeatherEditorRainBurstTimelineRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Rain Burst", value_text = "02:00-04:00   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WeatherEditorRainBurstTimelineRow", event = "Click", route = "workbench.extension.weather_editor.timeline.rain_burst" }]

[nodes.weather_editor_wind_gust_timeline_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWeatherEditorWindGustTimelineRow"
classes = ["workbench-table-row"]
props = { text = "Wind Gust", value_text = "03:20-05:00   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WeatherEditorWindGustTimelineRow", event = "Click", route = "workbench.extension.weather_editor.timeline.wind_gust" }]

[nodes.weather_editor_lightning_timeline_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWeatherEditorLightningTimelineRow"
classes = ["workbench-table-row"]
props = { text = "Lightning", value_text = "04:00-04:30   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WeatherEditorLightningTimelineRow", event = "Click", route = "workbench.extension.weather_editor.timeline.lightning" }]

[nodes.weather_editor_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWeatherEditorOutputRow"
classes = ["workbench-table-row"]
props = { text = "Weather Log", value_text = "8 layers   5 regions   2 warnings", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.weather_editor_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionWeatherEditorRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "weather_editor_details_title" }, { node = "weather_editor_right_content" }]

[nodes.weather_editor_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionWeatherEditorRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "weather_editor_preset_dropdown_property_row" }, { node = "weather_editor_region_dropdown_property_row" }, { node = "weather_editor_blend_time_field_property_row" }]

[nodes.weather_editor_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionWeatherEditorDetailsTitle"
props = { text = "Weather Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.weather_editor_preset_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionWeatherEditorPresetDropdownPropertyRow"
props = { text = "Preset" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "weather_editor_preset_dropdown", slot = { name = "value" } }]

[nodes.weather_editor_preset_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionWeatherEditorPresetDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Storm", value = "Storm", options = ["Storm", "Clear", "Fog", "Snow"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/WeatherEditorPresetEdit", event = "Change", route = "workbench.extension.weather_editor.preset.edit" },
  { id = "WorkbenchExtension/WeatherEditorPresetCommit", event = "Submit", route = "workbench.extension.weather_editor.preset.commit" },
]

[nodes.weather_editor_region_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionWeatherEditorRegionDropdownPropertyRow"
props = { text = "Region" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "weather_editor_region_dropdown", slot = { name = "value" } }]

[nodes.weather_editor_region_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionWeatherEditorRegionDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Mountains", value = "Mountains", options = ["Mountains", "Coast", "City", "Interior"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/WeatherEditorRegionEdit", event = "Change", route = "workbench.extension.weather_editor.region.edit" },
  { id = "WorkbenchExtension/WeatherEditorRegionCommit", event = "Submit", route = "workbench.extension.weather_editor.region.commit" },
]

[nodes.weather_editor_blend_time_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionWeatherEditorBlendTimeFieldPropertyRow"
props = { text = "Blend Time" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "weather_editor_blend_time_field", slot = { name = "value" } }]

[nodes.weather_editor_blend_time_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionWeatherEditorBlendTimeField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Blend Time: 12.0" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/WeatherEditorBlendTimeEdit", event = "Change", route = "workbench.extension.weather_editor.blend_time.edit" },
  { id = "WorkbenchExtension/WeatherEditorBlendTimeCommit", event = "Submit", route = "workbench.extension.weather_editor.blend_time.commit" },
]
