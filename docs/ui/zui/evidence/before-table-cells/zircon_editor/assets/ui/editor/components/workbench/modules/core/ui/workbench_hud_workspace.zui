[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/core/ui/workbench_hud_workspace.zui"
version = 2
display_name = "Workbench HUD Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []
[components.WorkbenchHudWorkspace]
root = "hud_workspace"
default_classes = ["workbench-module-body"]

[nodes.hud_workspace]
component = "Overlay"
control_id = "WorkbenchModuleHudWorkspace"
classes = ["workbench-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "hud_workspace_main" },
  { node = "hud_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.hud_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "hud_rail_gap" }, { node = "hud_left" }, { node = "hud_center" }, { node = "hud_right_reserve" }]

[nodes.hud_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.hud_rail_gap]
component = "Container"
control_id = "WorkbenchHudRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.hud_left]
component = "VerticalGroup"
control_id = "WorkbenchHudLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "hud_title" }, { node = "hud_left_content" }]

[nodes.hud_left_content]
component = "ScrollableBox"
control_id = "WorkbenchHudLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "hud_widget_text_row" }, { node = "hud_widget_button_row" }]

[nodes.hud_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchHudTitle"
props = { text = "HUD Editor" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.hud_widget_text_row]
component = "WorkbenchListRow"
control_id = "WorkbenchHudWidgetTextRow"
classes = ["workbench-list-row"]
props = { text = "MatchTimer", icon = "image" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/HudWidgetText", event = "Click", route = "workbench.module.hud.widget.text" }]

[nodes.hud_widget_button_row]
component = "WorkbenchListRow"
control_id = "WorkbenchHudWidgetButtonRow"
classes = ["workbench-list-row"]
props = { text = "WeaponPanel", icon = "image" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/HudWidgetButton", event = "Click", route = "workbench.module.hud.widget.button" }]

[nodes.hud_center]
component = "VerticalGroup"
control_id = "WorkbenchHudCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "hud_center_header" }, { node = "hud_canvas" }, { node = "hud_validation_row" }]

[nodes.hud_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchHudCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "hud_center_title" }, { node = "hud_header_fill" }, { node = "hud_tools_button" }, { node = "hud_preview_button" }]

[nodes.hud_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchHudCenterTitle"
props = { text = "Gameplay HUD Canvas" }
layout = { width = { min = 190.0, preferred = 190.0, max = 210.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.hud_header_fill]
component = "Container"
control_id = "WorkbenchHudHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.hud_tools_button]
component = "WorkbenchButton"
control_id = "WorkbenchHudTools"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "HUD Tools", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 92.0, preferred = 92.0, max = 104.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/HudToolsOpen", event = "Click", route = "workbench.module.hud.tools.open" }]

[nodes.hud_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchHudPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 76.0, preferred = 76.0, max = 86.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/HudPreview", event = "Click", route = "workbench.module.hud.preview" }]

[nodes.hud_canvas]
component = "ScrollableBox"
control_id = "WorkbenchHudCanvas"
classes = ["workbench-panel", "workbench-module-graph"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.regular", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "hud_canvas_row_01" }, { node = "hud_canvas_row_02" }, { node = "hud_binding_row" }]

[nodes.hud_canvas_row_01]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchHudMinimapRow"
classes = ["workbench-property-row"]
props = { text = "Minimap", value_text = "Anchor Top Right   240 x 180" }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/HudMinimap", event = "Click", route = "workbench.module.hud.minimap" }]

[nodes.hud_canvas_row_02]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchHudAmmoPanelRow"
classes = ["workbench-property-row"]
props = { text = "AmmoPanel", value_text = "Anchor Bottom Right   bound" }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/HudAmmoPanel", event = "Click", route = "workbench.module.hud.ammo_panel" }]

[nodes.hud_binding_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchHudBindingRow"
classes = ["workbench-table-row"]
props = { text = "Ammo_Clip", value_text = "GetCurrentAmmo   OK" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/HudBindingAmmo", event = "Click", route = "workbench.module.hud.binding.ammo" }]

[nodes.hud_validation_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchHudValidationRow"
classes = ["workbench-table-row"]
props = { text = "Warning", value_text = "Text MatchTimer is not localized", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.hud_right]
component = "VerticalGroup"
control_id = "WorkbenchHudRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "hud_details_title" }, { node = "hud_right_content" }]

[nodes.hud_right_content]
component = "ScrollableBox"
control_id = "WorkbenchHudRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "hud_screen_property_row" }, { node = "hud_dpi_property_row" }, { node = "hud_locale_property_row" }]

[nodes.hud_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchHudDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.hud_screen_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchHudScreenPropertyRow"
props = { text = "Screen" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "hud_screen_dropdown", slot = { name = "value" } }]

[nodes.hud_screen_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchHudScreenDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value = "gameplay_hud", value_text = "Gameplay HUD", options = ["gameplay_hud|label=Gameplay HUD", "pause_menu|label=Pause Menu", "main_menu|label=Main Menu"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/HudScreenEdit", event = "Change", route = "workbench.module.hud.screen.edit" },
  { id = "WorkbenchModule/HudScreenCommit", event = "Submit", route = "workbench.module.hud.screen.commit" },
]

[nodes.hud_dpi_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchHudDpiPropertyRow"
props = { text = "DPI Scale" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "hud_dpi_field", slot = { name = "value" } }]

[nodes.hud_dpi_field]
component = "WorkbenchField"
control_id = "WorkbenchHudDpiField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "1.00" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/HudDpiEdit", event = "Change", route = "workbench.module.hud.dpi.edit" },
  { id = "WorkbenchModule/HudDpiCommit", event = "Submit", route = "workbench.module.hud.dpi.commit" },
]

[nodes.hud_locale_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchHudLocalePropertyRow"
props = { text = "Locale" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "hud_locale_field", slot = { name = "value" } }]

[nodes.hud_locale_field]
component = "WorkbenchField"
control_id = "WorkbenchHudLocaleField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "en-US" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/HudLocaleEdit", event = "Change", route = "workbench.module.hud.locale.edit" },
  { id = "WorkbenchModule/HudLocaleCommit", event = "Submit", route = "workbench.module.hud.locale.commit" },
]
