[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/gameplay/workbench_extension_spawn_rules_workspace.zui"
version = 2
display_name = "Workbench Extension Spawn Rules Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionSpawnRulesWorkspace]
root = "spawn_rules_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.spawn_rules_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionSpawnRulesWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "spawn_rules_workspace_main" },
  { node = "spawn_rules_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.spawn_rules_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "spawn_rules_rail_gap" }, { node = "spawn_rules_left" }, { node = "spawn_rules_center" }, { node = "spawn_rules_right_reserve" }]

[nodes.spawn_rules_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.spawn_rules_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionSpawnRulesRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.spawn_rules_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSpawnRulesLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "spawn_rules_title" }, { node = "spawn_rules_left_content" }]

[nodes.spawn_rules_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionSpawnRulesLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "spawn_rules_enemy_row" }, { node = "spawn_rules_zone_a_row" }, { node = "spawn_rules_condition_night_row" }]

[nodes.spawn_rules_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSpawnRulesTitle"
props = { text = "Spawn Rules" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.spawn_rules_enemy_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSpawnRulesEnemyRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "SpawnRules_Enemy", icon = "target", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SpawnRulesEnemyRow", event = "Click", route = "workbench.extension.spawn_rules.rules.enemy" }]

[nodes.spawn_rules_zone_a_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSpawnRulesZoneARow"
classes = ["workbench-list-row"]
props = { text = "Zone_A", icon = "globe", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SpawnRulesZoneARow", event = "Click", route = "workbench.extension.spawn_rules.zone.a" }]

[nodes.spawn_rules_condition_night_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSpawnRulesConditionNightRow"
classes = ["workbench-list-row"]
props = { text = "Condition_Night", icon = "file", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SpawnRulesConditionNightRow", event = "Click", route = "workbench.extension.spawn_rules.condition.night" }]

[nodes.spawn_rules_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSpawnRulesCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "spawn_rules_center_header" }, { node = "spawn_rules_stack_table" }, { node = "spawn_rules_output" }]

[nodes.spawn_rules_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionSpawnRulesCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "spawn_rules_center_title" }, { node = "spawn_rules_header_fill" }, { node = "spawn_rules_simulate_button" }, { node = "spawn_rules_validate_button" }]

[nodes.spawn_rules_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSpawnRulesCenterTitle"
props = { text = "Spawn Rule Stack" }
layout = { width = { min = 250.0, preferred = 250.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.spawn_rules_header_fill]
component = "Container"
control_id = "WorkbenchExtensionSpawnRulesHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.spawn_rules_simulate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionSpawnRulesSimulateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Simulate", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 96.0, preferred = 96.0, max = 106.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SpawnRulesSimulate", event = "Click", route = "workbench.extension.spawn_rules.simulate" }]

[nodes.spawn_rules_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionSpawnRulesValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 96.0, preferred = 96.0, max = 106.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SpawnRulesValidate", event = "Click", route = "workbench.extension.spawn_rules.validate" }]

[nodes.spawn_rules_stack_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionSpawnRulesStackTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "spawn_rules_zone_a_table_row" }, { node = "spawn_rules_condition_night_table_row" }, { node = "spawn_rules_tag_combat_table_row" }, { node = "spawn_rules_conflict_table_row" }]

[nodes.spawn_rules_zone_a_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSpawnRulesZoneATableRow"
classes = ["workbench-table-row"]
props = { text = "Zone_A", value_text = "Volume   12 probes" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SpawnRulesZoneATableRow", event = "Click", route = "workbench.extension.spawn_rules.stack.zone_a" }]

[nodes.spawn_rules_condition_night_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSpawnRulesConditionNightTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Condition_Night", value_text = "Condition   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SpawnRulesConditionNightTableRow", event = "Click", route = "workbench.extension.spawn_rules.stack.condition_night" }]

[nodes.spawn_rules_tag_combat_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSpawnRulesTagCombatTableRow"
classes = ["workbench-table-row"]
props = { text = "Tag_Combat", value_text = "Filter   strict tags" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SpawnRulesTagCombatTableRow", event = "Click", route = "workbench.extension.spawn_rules.stack.tag_combat" }]

[nodes.spawn_rules_conflict_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSpawnRulesConflictTableRow"
classes = ["workbench-table-row"]
props = { text = "Conflict", value_text = "Validation   1 warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SpawnRulesConflictTableRow", event = "Click", route = "workbench.extension.spawn_rules.stack.conflict" }]

[nodes.spawn_rules_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSpawnRulesOutputRow"
classes = ["workbench-table-row"]
props = { text = "Spawn Log", value_text = "18 rules   12 zones   1 conflict", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.spawn_rules_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSpawnRulesRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "spawn_rules_details_title" }, { node = "spawn_rules_right_content" }]

[nodes.spawn_rules_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionSpawnRulesRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "spawn_rules_rule_set_dropdown_property_row" }, { node = "spawn_rules_authority_dropdown_property_row" }, { node = "spawn_rules_seed_field_property_row" }]

[nodes.spawn_rules_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSpawnRulesDetailsTitle"
props = { text = "Spawn Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.spawn_rules_rule_set_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionSpawnRulesRuleSetDropdownPropertyRow"
props = { text = "Rule Set" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "spawn_rules_rule_set_dropdown", slot = { name = "value" } }]

[nodes.spawn_rules_rule_set_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionSpawnRulesRuleSetDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Enemy Spawn", value = "Enemy Spawn", options = ["Enemy Spawn", "Ambient Spawn", "Boss Spawn", "Debug Spawn"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SpawnRulesRuleSetEdit", event = "Change", route = "workbench.extension.spawn_rules.rule_set.edit" },
  { id = "WorkbenchExtension/SpawnRulesRuleSetCommit", event = "Submit", route = "workbench.extension.spawn_rules.rule_set.commit" },
]

[nodes.spawn_rules_authority_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionSpawnRulesAuthorityDropdownPropertyRow"
props = { text = "Authority" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "spawn_rules_authority_dropdown", slot = { name = "value" } }]

[nodes.spawn_rules_authority_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionSpawnRulesAuthorityDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Server", value = "Server", options = ["Server", "Client Preview", "Offline"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SpawnRulesAuthorityEdit", event = "Change", route = "workbench.extension.spawn_rules.authority.edit" },
  { id = "WorkbenchExtension/SpawnRulesAuthorityCommit", event = "Submit", route = "workbench.extension.spawn_rules.authority.commit" },
]

[nodes.spawn_rules_seed_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionSpawnRulesSeedFieldPropertyRow"
props = { text = "Seed" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "spawn_rules_seed_field", slot = { name = "value" } }]

[nodes.spawn_rules_seed_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionSpawnRulesSeedField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Seed: 2026" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SpawnRulesSeedEdit", event = "Change", route = "workbench.extension.spawn_rules.seed.edit" },
  { id = "WorkbenchExtension/SpawnRulesSeedCommit", event = "Submit", route = "workbench.extension.spawn_rules.seed.commit" },
]
