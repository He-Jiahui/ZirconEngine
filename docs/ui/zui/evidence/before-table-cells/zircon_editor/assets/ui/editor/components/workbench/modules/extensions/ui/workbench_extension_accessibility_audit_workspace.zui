[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/ui/workbench_extension_accessibility_audit_workspace.zui"
version = 2
display_name = "Workbench Extension Accessibility Audit Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionAccessibilityAuditWorkspace]
root = "accessibility_audit_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.accessibility_audit_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionAccessibilityAuditWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "accessibility_audit_workspace_main" },
  { node = "accessibility_audit_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.accessibility_audit_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_rail_gap" }, { node = "accessibility_audit_left" }, { node = "accessibility_audit_center" }, { node = "accessibility_audit_right_reserve" }]

[nodes.accessibility_audit_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.accessibility_audit_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionAccessibilityAuditRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.accessibility_audit_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_title" }, { node = "accessibility_audit_left_content" }]

[nodes.accessibility_audit_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionAccessibilityAuditLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_gameplay_hud_row" }, { node = "accessibility_audit_contrast_issue_row" }, { node = "accessibility_audit_focus_issue_row" }]

[nodes.accessibility_audit_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionAccessibilityAuditTitle"
props = { text = "Accessibility Audit" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.accessibility_audit_gameplay_hud_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionAccessibilityAuditGameplayHudRow"
classes = ["workbench-list-row"]
props = { text = "Gameplay_HUD", icon = "check", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditGameplayHudRow", event = "Click", route = "workbench.extension.accessibility_audit.screen.gameplay_hud" }]

[nodes.accessibility_audit_contrast_issue_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionAccessibilityAuditContrastIssueRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Issue_Contrast_04", icon = "alert", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditContrastIssueRow", event = "Click", route = "workbench.extension.accessibility_audit.issue.contrast" }]

[nodes.accessibility_audit_focus_issue_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionAccessibilityAuditFocusIssueRow"
classes = ["workbench-list-row"]
props = { text = "Issue_Focus_02", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditFocusIssueRow", event = "Click", route = "workbench.extension.accessibility_audit.issue.focus" }]

[nodes.accessibility_audit_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_center_header" }, { node = "accessibility_audit_table" }, { node = "accessibility_audit_output" }]

[nodes.accessibility_audit_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "accessibility_audit_center_title" }, { node = "accessibility_audit_header_fill" }, { node = "accessibility_audit_audit_button" }, { node = "accessibility_audit_preview_fix_button" }]

[nodes.accessibility_audit_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionAccessibilityAuditCenterTitle"
props = { text = "Accessibility Issues" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.accessibility_audit_header_fill]
component = "Container"
control_id = "WorkbenchExtensionAccessibilityAuditHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.accessibility_audit_audit_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionAccessibilityAuditAuditScreenButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Audit Screen", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 106.0, preferred = 106.0, max = 116.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditAuditScreen", event = "Click", route = "workbench.extension.accessibility_audit.audit_screen" }]

[nodes.accessibility_audit_preview_fix_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionAccessibilityAuditPreviewFixButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Preview Fix", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 104.0, preferred = 104.0, max = 114.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditPreviewFix", event = "Click", route = "workbench.extension.accessibility_audit.preview_fix" }]

[nodes.accessibility_audit_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionAccessibilityAuditTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_contrast_table_row" }, { node = "accessibility_audit_focus_table_row" }, { node = "accessibility_audit_target_table_row" }, { node = "accessibility_audit_motion_table_row" }]

[nodes.accessibility_audit_contrast_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditContrastTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Contrast", value_text = "AmmoText   High   Token" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditContrastTableRow", event = "Click", route = "workbench.extension.accessibility_audit.row.contrast" }]

[nodes.accessibility_audit_focus_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditFocusTableRow"
classes = ["workbench-table-row"]
props = { text = "Focus Order", value_text = "InventoryGrid   Medium   Reorder" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditFocusTableRow", event = "Click", route = "workbench.extension.accessibility_audit.row.focus" }]

[nodes.accessibility_audit_target_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditTargetSizeTableRow"
classes = ["workbench-table-row"]
props = { text = "Target Size", value_text = "MapButton   Low   Resize" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditTargetSizeTableRow", event = "Click", route = "workbench.extension.accessibility_audit.row.target_size" }]

[nodes.accessibility_audit_motion_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditMotionTableRow"
classes = ["workbench-table-row"]
props = { text = "Motion", value_text = "HitFlash   Medium   Reduce" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditMotionTableRow", event = "Click", route = "workbench.extension.accessibility_audit.row.motion" }]

[nodes.accessibility_audit_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditOutputRow"
classes = ["workbench-table-row"]
props = { text = "Accessibility Audit", value_text = "9 issues   1 critical   42 pass", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.accessibility_audit_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_details_title" }, { node = "accessibility_audit_right_content" }]

[nodes.accessibility_audit_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionAccessibilityAuditRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_screen_dropdown_property_row" }, { node = "accessibility_audit_rule_set_dropdown_property_row" }, { node = "accessibility_audit_breakpoint_field_property_row" }]

[nodes.accessibility_audit_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionAccessibilityAuditDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.accessibility_audit_screen_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionAccessibilityAuditScreenDropdownPropertyRow"
props = { text = "Screen" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "accessibility_audit_screen_dropdown", slot = { name = "value" } }]

[nodes.accessibility_audit_screen_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionAccessibilityAuditScreenDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Gameplay_HUD", value = "Gameplay_HUD", options = ["Gameplay_HUD", "Pause_Menu", "Rule_Set_A"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/AccessibilityAuditScreenEdit", event = "Change", route = "workbench.extension.accessibility_audit.screen.edit" },
  { id = "WorkbenchExtension/AccessibilityAuditScreenCommit", event = "Submit", route = "workbench.extension.accessibility_audit.screen.commit" },
]

[nodes.accessibility_audit_rule_set_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionAccessibilityAuditRuleSetDropdownPropertyRow"
props = { text = "Rule Set" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "accessibility_audit_rule_set_dropdown", slot = { name = "value" } }]

[nodes.accessibility_audit_rule_set_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionAccessibilityAuditRuleSetDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "WCAG AA", value = "WCAG AA", options = ["WCAG AA", "WCAG AAA", "Console Safe"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/AccessibilityAuditRuleSetEdit", event = "Change", route = "workbench.extension.accessibility_audit.rule_set.edit" },
  { id = "WorkbenchExtension/AccessibilityAuditRuleSetCommit", event = "Submit", route = "workbench.extension.accessibility_audit.rule_set.commit" },
]

[nodes.accessibility_audit_breakpoint_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionAccessibilityAuditBreakpointFieldPropertyRow"
props = { text = "Breakpoint" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "accessibility_audit_breakpoint_field", slot = { name = "value" } }]

[nodes.accessibility_audit_breakpoint_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionAccessibilityAuditBreakpointField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Breakpoint: Desktop" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/AccessibilityAuditBreakpointEdit", event = "Change", route = "workbench.extension.accessibility_audit.breakpoint.edit" },
  { id = "WorkbenchExtension/AccessibilityAuditBreakpointCommit", event = "Submit", route = "workbench.extension.accessibility_audit.breakpoint.commit" },
]
