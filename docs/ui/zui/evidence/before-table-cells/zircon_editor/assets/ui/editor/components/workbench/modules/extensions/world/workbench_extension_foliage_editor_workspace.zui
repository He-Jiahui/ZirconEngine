[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/world/workbench_extension_foliage_editor_workspace.zui"
version = 2
display_name = "Workbench Extension Foliage Editor Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionFoliageEditorWorkspace]
root = "foliage_editor_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.foliage_editor_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionFoliageEditorWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "foliage_editor_workspace_main" },
  { node = "foliage_editor_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.foliage_editor_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "foliage_editor_rail_gap" }, { node = "foliage_editor_left" }, { node = "foliage_editor_center" }, { node = "foliage_editor_right_reserve" }]

[nodes.foliage_editor_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.foliage_editor_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionFoliageEditorRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.foliage_editor_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionFoliageEditorLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "foliage_editor_title" }, { node = "foliage_editor_left_content" }]

[nodes.foliage_editor_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionFoliageEditorLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "foliage_editor_forest_row" }, { node = "foliage_editor_oak_row" }, { node = "foliage_editor_biome_row" }]

[nodes.foliage_editor_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionFoliageEditorTitle"
props = { text = "Foliage Editor" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.foliage_editor_forest_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionFoliageEditorForestRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "FOL_Forest", icon = "tree", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FoliageEditorForestRow", event = "Click", route = "workbench.extension.foliage_editor.forest" }]

[nodes.foliage_editor_oak_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionFoliageEditorOakRow"
classes = ["workbench-list-row"]
props = { text = "Oak_Tall", icon = "leaf", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FoliageEditorOakRow", event = "Click", route = "workbench.extension.foliage_editor.oak" }]

[nodes.foliage_editor_biome_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionFoliageEditorBiomeRow"
classes = ["workbench-list-row"]
props = { text = "Biome_Riverbank", icon = "layers", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FoliageEditorBiomeRow", event = "Click", route = "workbench.extension.foliage_editor.biome" }]

[nodes.foliage_editor_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionFoliageEditorCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "foliage_editor_center_header" }, { node = "foliage_editor_cluster_table" }, { node = "foliage_editor_output" }]

[nodes.foliage_editor_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionFoliageEditorCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "foliage_editor_center_title" }, { node = "foliage_editor_header_fill" }, { node = "foliage_editor_preview_button" }, { node = "foliage_editor_build_button" }]

[nodes.foliage_editor_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionFoliageEditorCenterTitle"
props = { text = "Foliage Cluster Workspace" }
layout = { width = { min = 240.0, preferred = 240.0, max = 320.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.foliage_editor_header_fill]
component = "Container"
control_id = "WorkbenchExtensionFoliageEditorHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.foliage_editor_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionFoliageEditorPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FoliageEditorPreview", event = "Click", route = "workbench.extension.foliage_editor.preview" }]

[nodes.foliage_editor_build_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionFoliageEditorBuildButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Build", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FoliageEditorBuild", event = "Click", route = "workbench.extension.foliage_editor.build" }]

[nodes.foliage_editor_cluster_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionFoliageEditorClusterTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "foliage_editor_forest_a12_row" }, { node = "foliage_editor_forest_a13_row" }, { node = "foliage_editor_river_02_row" }, { node = "foliage_editor_cliff_01_row" }]

[nodes.foliage_editor_forest_a12_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFoliageEditorForestA12Row"
classes = ["workbench-table-row"]
props = { text = "Forest_A12", value_text = "Oak   0.72   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FoliageEditorForestA12TableRow", event = "Click", route = "workbench.extension.foliage_editor.cluster.forest_a12" }]

[nodes.foliage_editor_forest_a13_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFoliageEditorForestA13Row"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Forest_A13", value_text = "Fern   0.58   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FoliageEditorForestA13TableRow", event = "Click", route = "workbench.extension.foliage_editor.cluster.forest_a13" }]

[nodes.foliage_editor_river_02_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFoliageEditorRiver02Row"
classes = ["workbench-table-row"]
props = { text = "River_02", value_text = "Grass   0.81   Queued" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FoliageEditorRiver02TableRow", event = "Click", route = "workbench.extension.foliage_editor.cluster.river02" }]

[nodes.foliage_editor_cliff_01_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFoliageEditorCliff01Row"
classes = ["workbench-table-row"]
props = { text = "Cliff_01", value_text = "Shrub   0.24   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FoliageEditorCliff01TableRow", event = "Click", route = "workbench.extension.foliage_editor.cluster.cliff01" }]

[nodes.foliage_editor_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFoliageEditorOutputRow"
classes = ["workbench-table-row"]
props = { text = "Paint Output", value_text = "84K instances   2 warnings", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.foliage_editor_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionFoliageEditorRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "foliage_editor_details_title" }, { node = "foliage_editor_right_content" }]

[nodes.foliage_editor_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionFoliageEditorRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "foliage_editor_type_dropdown_property_row" }, { node = "foliage_editor_density_field_property_row" }, { node = "foliage_editor_radius_field_property_row" }]

[nodes.foliage_editor_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionFoliageEditorDetailsTitle"
props = { text = "Brush Properties" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.foliage_editor_type_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionFoliageEditorTypeDropdownPropertyRow"
props = { text = "Type" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "foliage_editor_type_dropdown", slot = { name = "value" } }]

[nodes.foliage_editor_type_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionFoliageEditorTypeDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Oak_Tall", value = "Oak_Tall", options = ["Oak_Tall", "Fern_A", "Grass_Clump", "Bush_A"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/FoliageEditorTypeEdit", event = "Change", route = "workbench.extension.foliage_editor.type.edit" },
  { id = "WorkbenchExtension/FoliageEditorTypeCommit", event = "Submit", route = "workbench.extension.foliage_editor.type.commit" },
]

[nodes.foliage_editor_density_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionFoliageEditorDensityFieldPropertyRow"
props = { text = "Density" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "foliage_editor_density_field", slot = { name = "value" } }]

[nodes.foliage_editor_density_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionFoliageEditorDensityField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Density: 0.72" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/FoliageEditorDensityEdit", event = "Change", route = "workbench.extension.foliage_editor.density.edit" },
  { id = "WorkbenchExtension/FoliageEditorDensityCommit", event = "Submit", route = "workbench.extension.foliage_editor.density.commit" },
]

[nodes.foliage_editor_radius_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionFoliageEditorRadiusFieldPropertyRow"
props = { text = "Radius" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "foliage_editor_radius_field", slot = { name = "value" } }]

[nodes.foliage_editor_radius_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionFoliageEditorRadiusField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Radius: 480" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/FoliageEditorRadiusEdit", event = "Change", route = "workbench.extension.foliage_editor.radius.edit" },
  { id = "WorkbenchExtension/FoliageEditorRadiusCommit", event = "Submit", route = "workbench.extension.foliage_editor.radius.commit" },
]
