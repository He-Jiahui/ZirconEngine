[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/rendering/workbench_extension_lighting_bake_workspace.zui"
version = 2
display_name = "Workbench Extension Lighting Bake Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []
[components.WorkbenchExtensionLightingBakeWorkspace]
root = "lighting_bake_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.lighting_bake_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionLightingBakeWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "lighting_bake_workspace_main" },
  { node = "lighting_bake_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.lighting_bake_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_rail_gap" }, { node = "lighting_bake_left" }, { node = "lighting_bake_center" }, { node = "lighting_bake_right_reserve" }]

[nodes.lighting_bake_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.lighting_bake_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionLightingBakeRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.lighting_bake_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionLightingBakeLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_title" }, { node = "lighting_bake_left_content" }]

[nodes.lighting_bake_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionLightingBakeLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_scene_row" }, { node = "lighting_bake_interior_row" }, { node = "lighting_bake_reflection_probe_row" }]

[nodes.lighting_bake_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionLightingBakeTitle"
props = { text = "Lighting Bake" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.lighting_bake_scene_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionLightingBakeSceneBakeRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "City_Block_A", icon = "sun", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeSceneBakeRow", event = "Click", route = "workbench.extension.lighting_bake.level.city_block" }]

[nodes.lighting_bake_interior_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionLightingBakeInteriorBakeRow"
classes = ["workbench-list-row"]
props = { text = "Interior_Lab", icon = "cube", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeInteriorBakeRow", event = "Click", route = "workbench.extension.lighting_bake.level.interior" }]

[nodes.lighting_bake_reflection_probe_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionLightingBakeReflectionProbeRow"
classes = ["workbench-list-row"]
props = { text = "Reflection Probe Grid", icon = "grid", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeReflectionProbeRow", event = "Click", route = "workbench.extension.lighting_bake.probe_grid" }]

[nodes.lighting_bake_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionLightingBakeCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_center_header" }, { node = "lighting_bake_queue_table" }, { node = "lighting_bake_output" }]

[nodes.lighting_bake_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionLightingBakeCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "lighting_bake_center_title" }, { node = "lighting_bake_header_fill" }, { node = "lighting_bake_preview_button" }, { node = "lighting_bake_bake_button" }]

[nodes.lighting_bake_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionLightingBakeCenterTitle"
props = { text = "Bake Queue" }
layout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.lighting_bake_header_fill]
component = "Container"
control_id = "WorkbenchExtensionLightingBakeHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.lighting_bake_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionLightingBakePreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakePreview", event = "Click", route = "workbench.extension.lighting_bake.preview" }]

[nodes.lighting_bake_bake_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionLightingBakeBakeButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Bake", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 72.0, preferred = 72.0, max = 82.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeBake", event = "Click", route = "workbench.extension.lighting_bake.bake" }]

[nodes.lighting_bake_queue_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionLightingBakeQueueTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_shadow_map_row" }, { node = "lighting_bake_lightmap_uv_row" }, { node = "lighting_bake_probe_grid_row" }, { node = "lighting_bake_bleed_warning_row" }]

[nodes.lighting_bake_shadow_map_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeShadowMapTableRow"
classes = ["workbench-table-row"]
props = { text = "Shadow Maps", value_text = "4096 px   Stationary   Ready", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeShadowMapTableRow", event = "Click", route = "workbench.extension.lighting_bake.queue.shadow_map" }]

[nodes.lighting_bake_lightmap_uv_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeLightmapUvTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Lightmap UV", value_text = "87 assets   4 warnings   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeLightmapUvTableRow", event = "Click", route = "workbench.extension.lighting_bake.queue.lightmap_uv" }]

[nodes.lighting_bake_probe_grid_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeProbeGridTableRow"
classes = ["workbench-table-row"]
props = { text = "Probe Grid", value_text = "12 volumes   Adaptive   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeProbeGridTableRow", event = "Click", route = "workbench.extension.lighting_bake.queue.probe_grid" }]

[nodes.lighting_bake_bleed_warning_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeBleedWarningTableRow"
classes = ["workbench-table-row"]
props = { text = "Bleed Warning", value_text = "Interior_Lab   6 texels   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeBleedWarningTableRow", event = "Click", route = "workbench.extension.lighting_bake.queue.bleed_warning" }]

[nodes.lighting_bake_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeOutputRow"
classes = ["workbench-table-row"]
props = { text = "Lighting", value_text = "Preview ready   4 warnings   estimate 02:30", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.lighting_bake_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionLightingBakeRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_details_title" }, { node = "lighting_bake_right_content" }]

[nodes.lighting_bake_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionLightingBakeRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_quality_dropdown_property_row" }, { node = "lighting_bake_target_field_property_row" }, { node = "lighting_bake_denoise_dropdown_property_row" }]

[nodes.lighting_bake_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionLightingBakeDetailsTitle"
props = { text = "Bake Settings" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.lighting_bake_quality_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionLightingBakeQualityDropdownPropertyRow"
props = { text = "Quality" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "lighting_bake_quality_dropdown", slot = { name = "value" } }]

[nodes.lighting_bake_quality_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionLightingBakeQualityDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Production", value = "production", options = ["preview|label=Preview", "medium|label=Medium", "production|label=Production"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/LightingBakeQualityEdit", event = "Change", route = "workbench.extension.lighting_bake.quality.edit" },
  { id = "WorkbenchExtension/LightingBakeQualityCommit", event = "Submit", route = "workbench.extension.lighting_bake.quality.commit" },
]

[nodes.lighting_bake_target_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionLightingBakeTargetFieldPropertyRow"
props = { text = "Target" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "lighting_bake_target_field", slot = { name = "value" } }]

[nodes.lighting_bake_target_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionLightingBakeTargetField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "City_Block_A" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/LightingBakeTargetEdit", event = "Change", route = "workbench.extension.lighting_bake.target.edit" },
  { id = "WorkbenchExtension/LightingBakeTargetCommit", event = "Submit", route = "workbench.extension.lighting_bake.target.commit" },
]

[nodes.lighting_bake_denoise_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionLightingBakeDenoiseDropdownPropertyRow"
props = { text = "Denoise" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "lighting_bake_denoise_dropdown", slot = { name = "value" } }]

[nodes.lighting_bake_denoise_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionLightingBakeDenoiseDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "High", value = "high", options = ["off|label=Off", "medium|label=Medium", "high|label=High"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/LightingBakeDenoiseEdit", event = "Change", route = "workbench.extension.lighting_bake.denoise.edit" },
  { id = "WorkbenchExtension/LightingBakeDenoiseCommit", event = "Submit", route = "workbench.extension.lighting_bake.denoise.commit" },
]
