[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/animation/workbench_extension_pose_library_workspace.zui"
version = 2
display_name = "Workbench Extension Pose Library Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionPoseLibraryWorkspace]
root = "pose_library_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.pose_library_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionPoseLibraryWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "pose_library_workspace_main" },
  { node = "pose_library_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.pose_library_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "pose_library_rail_gap" }, { node = "pose_library_left" }, { node = "pose_library_center" }, { node = "pose_library_right_reserve" }]

[nodes.pose_library_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.pose_library_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionPoseLibraryRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.pose_library_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPoseLibraryLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "pose_library_title" }, { node = "pose_library_left_content" }]

[nodes.pose_library_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPoseLibraryLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "pose_library_combat_row" }, { node = "pose_library_locomotion_row" }, { node = "pose_library_emote_row" }]

[nodes.pose_library_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPoseLibraryTitle"
props = { text = "Pose Library" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.pose_library_combat_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPoseLibraryCombatRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Combat Poses", icon = "target", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryCombatRow", event = "Click", route = "workbench.extension.pose_library.set.combat" }]

[nodes.pose_library_locomotion_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPoseLibraryLocomotionRow"
classes = ["workbench-list-row"]
props = { text = "Locomotion", icon = "play", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryLocomotionRow", event = "Click", route = "workbench.extension.pose_library.set.locomotion" }]

[nodes.pose_library_emote_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPoseLibraryEmoteRow"
classes = ["workbench-list-row"]
props = { text = "Emotes", icon = "history", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryEmoteRow", event = "Click", route = "workbench.extension.pose_library.set.emote" }]

[nodes.pose_library_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPoseLibraryCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "pose_library_center_header" }, { node = "pose_library_pose_table" }, { node = "pose_library_output" }]

[nodes.pose_library_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionPoseLibraryCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "pose_library_center_title" }, { node = "pose_library_header_fill" }, { node = "pose_library_preview_button" }, { node = "pose_library_apply_button" }]

[nodes.pose_library_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPoseLibraryCenterTitle"
props = { text = "Pose Set" }
layout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.pose_library_header_fill]
component = "Container"
control_id = "WorkbenchExtensionPoseLibraryHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.pose_library_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPoseLibraryPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryPreview", event = "Click", route = "workbench.extension.pose_library.preview" }]

[nodes.pose_library_apply_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPoseLibraryApplyButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Apply", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 72.0, preferred = 72.0, max = 82.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryApply", event = "Click", route = "workbench.extension.pose_library.apply" }]

[nodes.pose_library_pose_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPoseLibraryPoseTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "pose_library_idle_pose_table_row" }, { node = "pose_library_aim_pose_table_row" }, { node = "pose_library_crouch_pose_table_row" }, { node = "pose_library_mirror_pose_table_row" }]

[nodes.pose_library_idle_pose_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPoseLibraryIdlePoseTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Idle Ready", value_text = "Full body   Combat   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryIdlePoseTableRow", event = "Click", route = "workbench.extension.pose_library.pose.idle" }]

[nodes.pose_library_aim_pose_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPoseLibraryAimPoseTableRow"
classes = ["workbench-table-row"]
props = { text = "Aim Offset", value_text = "Upper body   Weapon   Tagged" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryAimPoseTableRow", event = "Click", route = "workbench.extension.pose_library.pose.aim" }]

[nodes.pose_library_crouch_pose_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPoseLibraryCrouchPoseTableRow"
classes = ["workbench-table-row"]
props = { text = "Crouch Cover", value_text = "Lower body   Cover   Needs mirror" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryCrouchPoseTableRow", event = "Click", route = "workbench.extension.pose_library.pose.crouch" }]

[nodes.pose_library_mirror_pose_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPoseLibraryMirrorPoseTableRow"
classes = ["workbench-table-row"]
props = { text = "Mirror Candidate", value_text = "Left hand   pair missing   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryMirrorPoseTableRow", event = "Click", route = "workbench.extension.pose_library.pose.mirror" }]

[nodes.pose_library_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPoseLibraryOutputRow"
classes = ["workbench-table-row"]
props = { text = "Pose Library", value_text = "PL_Combat   42 poses   6 tags", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.pose_library_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPoseLibraryRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "pose_library_details_title" }, { node = "pose_library_right_content" }]

[nodes.pose_library_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPoseLibraryRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "pose_library_asset_dropdown_property_row" }, { node = "pose_library_tag_field_property_row" }, { node = "pose_library_mirror_dropdown_property_row" }]

[nodes.pose_library_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPoseLibraryDetailsTitle"
props = { text = "Pose Settings" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.pose_library_asset_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPoseLibraryAssetDropdownPropertyRow"
props = { text = "Asset" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "pose_library_asset_dropdown", slot = { name = "value" } }]

[nodes.pose_library_asset_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPoseLibraryAssetDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "PL_Combat", value = "PL_Combat", options = ["PL_Combat", "PL_Locomotion", "PL_Emotes"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PoseLibraryAssetEdit", event = "Change", route = "workbench.extension.pose_library.asset.edit" },
  { id = "WorkbenchExtension/PoseLibraryAssetCommit", event = "Submit", route = "workbench.extension.pose_library.asset.commit" },
]

[nodes.pose_library_tag_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPoseLibraryTagFieldPropertyRow"
props = { text = "Tag" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "pose_library_tag_field", slot = { name = "value" } }]

[nodes.pose_library_tag_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionPoseLibraryTagField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Tag: Combat.Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PoseLibraryTagEdit", event = "Change", route = "workbench.extension.pose_library.tag.edit" },
  { id = "WorkbenchExtension/PoseLibraryTagCommit", event = "Submit", route = "workbench.extension.pose_library.tag.commit" },
]

[nodes.pose_library_mirror_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPoseLibraryMirrorDropdownPropertyRow"
props = { text = "Mirror" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "pose_library_mirror_dropdown", slot = { name = "value" } }]

[nodes.pose_library_mirror_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPoseLibraryMirrorDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Left/Right", value = "LeftRight", options = ["LeftRight|label=Left/Right", "UpperLower|label=Upper/Lower", "Disabled|label=Disabled"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PoseLibraryMirrorEdit", event = "Change", route = "workbench.extension.pose_library.mirror.edit" },
  { id = "WorkbenchExtension/PoseLibraryMirrorCommit", event = "Submit", route = "workbench.extension.pose_library.mirror.commit" },
]
