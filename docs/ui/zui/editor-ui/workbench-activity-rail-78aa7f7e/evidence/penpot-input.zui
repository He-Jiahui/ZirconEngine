[asset]
kind = "component"
id = "res://ui/editor/components/workbench/shell/workbench_activity_rail.zui"
version = 2
display_name = "Workbench Activity Rail"

[imports]
widgets = []
styles = []

[components.WorkbenchActivityRail]
root = "activity_rail"
default_classes = [ "workbench-rail" ]

[nodes.activity_rail]
component = "VerticalGroup"
control_id = "WorkbenchWindowActivityRail"
classes = [ "workbench-rail" ]

[nodes.activity_rail.props]
border_width = 0
separator_color = "$editor.separator.soft"
separator_edge = "right"
separator_thickness = "$editor.control.border_width"

[nodes.activity_rail.layout]
clip = true

[nodes.activity_rail.layout.container]
kind = "ScrollableBox"
axis = "Vertical"
gap = "$editor.density.gap.medium"
scrollbar_visibility = "Auto"

[nodes.activity_rail.layout.width]
min = "$editor.chrome.activity_rail.width"
preferred = "$editor.chrome.activity_rail.width"
max = "$editor.chrome.activity_rail.width"
stretch = "Fixed"

[nodes.activity_rail.layout.height]
stretch = "Stretch"

[[nodes.activity_rail.children]]
node = "rail_scene"

[[nodes.activity_rail.children]]
node = "rail_cube"

[[nodes.activity_rail.children]]
node = "rail_graph"

[[nodes.activity_rail.children]]
node = "rail_image"

[[nodes.activity_rail.children]]
node = "rail_audio"

[[nodes.activity_rail.children]]
node = "rail_code"

