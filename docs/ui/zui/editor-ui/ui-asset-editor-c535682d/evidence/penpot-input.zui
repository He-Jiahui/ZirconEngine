penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_button.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/data/workbench_tree_row.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/data/workbench_caption.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/data/workbench_label.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui", "zircon_editor/assets/ui/editor/components/workbench/composites/chrome/workbench_ui_asset_action_bar.zui", "zircon_editor/assets/icons/zircon_editor_shell/controls/search.svg", "zircon_editor/assets/icons/ionicons/close-outline.svg", "zircon_editor/assets/icons/zircon_editor_shell/controls/field-stepper.svg" ]
penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/ui_asset_editor.zui\"\nversion = 2\ndisplay_name = \"UI Asset Editor Projection\"\n\n[root]\nnode = \"ui_asset_editor_root\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_tree_row.zui#WorkbenchTreeRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/composites/chrome/workbench_ui_asset_action_bar.zui#WorkbenchUiAssetActionBar\",\n]\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[tokens]\nsurface = \"$editor.surface.0\"\npanel = \"$editor.surface.1\"\npanel_inset = \"$editor.surface.recessed\"\noutline = \"$editor.border\"\ntext = \"$editor.text.primary\"\nmuted = \"$editor.text.secondary\"\naccent = \"$editor.accent\"\n\n[[stylesheets]]\nid = \"ui_asset_editor_projection_workbench\"\n\n[[stylesheets.rules]]\nselector = \".ui-asset-shell\"\n[stylesheets.rules.set.self]\nbackground_color = \"$surface\"\nforeground_color = \"$text\"\n\n[[stylesheets.rules]]\nselector = \".ui-asset-panel\"\n[stylesheets.rules.set.self]\nbackground_color = \"$panel\"\nborder_color = \"$outline\"\nforeground_color = \"$text\"\nsurface_variant = \"panel\"\nradius = \"$editor.control.radius.panel\"\ncorner_radius = \"$editor.control.radius.panel\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".ui-asset-inset\"\n[stylesheets.rules.set.self]\nbackground_color = \"$panel_inset\"\nborder_color = \"$outline\"\nforeground_color = \"$text\"\nsurface_variant = \"inset\"\nradius = \"$editor.control.radius.control\"\ncorner_radius = \"$editor.control.radius.control\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".ui-asset-row\"\n[stylesheets.rules.set.self]\nforeground_color = \"$text\"\n\n[[stylesheets.rules]]\nselector = \".ui-asset-section\"\n[stylesheets.rules.set.self]\nforeground_color = \"$text\"\n\n[[stylesheets.rules]]\nselector = \".ui-asset-muted\"\n[stylesheets.rules.set.self]\nforeground_color = \"$muted\"\nfont_size = \"$editor.typography.caption.size\"\n\n[nodes.ui_asset_editor_root]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"UiAssetEditorRoot\"\npixel_snapping = \"disabled\"\nclasses = [\"ui-asset-shell\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\"}, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"header_panel\" },\n  { node = \"body\" },\n]\n\n[nodes.header_panel]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"HeaderPanel\"\nclasses = [\"ui-asset-panel\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\"}, width = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"header_asset_row\", slot = { layout = { padding = { left = \"$editor.density.panel_padding\", right = \"$editor.density.panel_padding\" } } } },\n  { node = \"header_status_row\", slot = { layout = { padding = { left = \"$editor.density.panel_padding\", right = \"$editor.density.panel_padding\" } } } },\n  { node = \"header_action_row\", slot = { layout = { padding = { left = \"$editor.density.panel_padding\", right = \"$editor.density.panel_padding\" } } } },\n]\n\n[nodes.header_asset_row]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"HeaderAssetRow\"\nclasses = [\"ui-asset-row\"]\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.regular\"}, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nchildren = [\n  { node = \"header_asset_title\" },\n  { node = \"header_asset_kind\" },\n]\n\n[nodes.header_asset_title]\ncomponent = \"WorkbenchLabel\"\ncontrol_id = \"HeaderAssetTitle\"\nprops = { text = \"UI Asset\", text_tone = \"primary\", text_overflow = \"ellipsis\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_asset_kind]\ncomponent = \"WorkbenchCaption\"\ncontrol_id = \"HeaderAssetKind\"\nprops = { text = \"DESIGNER\", text_overflow = \"ellipsis\" }\nlayout = { width = { min = \"$editor.density.ui_asset.header_kind.min_width\", preferred = \"$editor.density.ui_asset.header_kind.preferred_width\", max = \"$editor.density.ui_asset.header_kind.max_width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_status_row]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"HeaderStatusRow\"\nclasses = [\"ui-asset-row\", \"ui-asset-muted\"]\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.regular\"}, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nchildren = [\n  { node = \"header_status_caption\" },\n]\n\n[nodes.header_status_caption]\ncomponent = \"WorkbenchCaption\"\ncontrol_id = \"HeaderStatusCaption\"\nprops = { text = \"Prototype cache valid\", text_overflow = \"ellipsis\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_action_row]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"HeaderActionRow\"\nclasses = [\"ui-asset-row\"]\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.regular\"}, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nchildren = [\n  { node = \"header_save_button\" },\n  { node = \"header_undo_button\" },\n  { node = \"header_redo_button\" },\n  { node = \"header_action_fill\" },\n]\n\n[nodes.header_save_button]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"HeaderSaveButton\"\nprops = { icon = \"zircon_editor_shell/toolbar/save.svg\", label = \"Save\", action_id = \"save\" }\nevents = [{ id = \"UiAssetEditor/HeaderSave\", event = \"Click\", route = \"save\" }]\nlayout = { width = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.default\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_undo_button]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"HeaderUndoButton\"\nprops = { icon = \"zircon_editor_shell/toolbar/undo.svg\", label = \"Undo\", action_id = \"undo\" }\nevents = [{ id = \"UiAssetEditor/HeaderUndo\", event = \"Click\", route = \"undo\" }]\nlayout = { width = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.default\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_redo_button]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"HeaderRedoButton\"\nprops = { icon = \"zircon_editor_shell/toolbar/redo.svg\", label = \"Redo\", action_id = \"redo\" }\nevents = [{ id = \"UiAssetEditor/HeaderRedo\", event = \"Click\", route = \"redo\" }]\nlayout = { width = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.default\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_action_fill]\ncomponent = \"Space\"\ncontrol_id = \"HeaderActionFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.body]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"UiAssetEditorBody\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\"}, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"left_column\" },\n  { node = \"center_column\" },\n  { node = \"right_column\" },\n]\n\n[nodes.left_column]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"LeftColumn\"\nclasses = [\"ui-asset-panel\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\"}, width = { min = \"$editor.density.ui_asset.side.min_width\", preferred = \"$editor.density.ui_asset.side.preferred_width\", stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"left_scroll_region\", slot = { layout = { padding = { left = \"$editor.density.panel_padding\", right = \"$editor.density.panel_padding\" } } } },\n]\n\n[nodes.left_scroll_region]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"LeftScrollRegion\"\nprops = { input_hoverable = true }\nlayout = { container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"palette_panel\" },\n  { node = \"hierarchy_panel\" },\n]\n\n[nodes.palette_panel]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"PalettePanel\"\nclasses = [\"ui-asset-section\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\"}, width = { stretch = \"Stretch\" }, height = { min = 180.0, preferred = 220.0, max = 260.0, stretch = \"Stretch\" } }\nchildren = [\n  { node = \"palette_title\" },\n  { node = \"palette_search\" },\n  { node = \"palette_common_caption\" },\n  { node = \"palette_component_grid\" },\n]\n\n[nodes.palette_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"PaletteTitle\"\nprops = { text = \"Palette\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" } }\n\n[nodes.palette_search]\ncomponent = \"WorkbenchSearchInput\"\ncontrol_id = \"PaletteSearchInput\"\nprops = { query = \"\", placeholder = \"Search widgets\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\n\n[nodes.palette_common_caption]\ncomponent = \"WorkbenchCaption\"\ncontrol_id = \"PaletteCommonCaption\"\nprops = { text = \"COMMON\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18.0, preferred = 20.0, max = 22.0, stretch = \"Fixed\" } }\n\n[nodes.palette_component_grid]\ncomponent = \"GridGroup\"\ncontrol_id = \"PaletteComponentGrid\"\nclasses = [\"ui-asset-row\"]\nlayout = { container = { kind = \"GridBox\", columns = 2, rows = 2, column_gap = \"$editor.density.gap.small\", row_gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 64.0, preferred = 68.0, max = 72.0, stretch = \"Fixed\" } }\nchildren = [\n  { node = \"palette_button\", slot = { layout = { column = 0, row = 0 } } },\n  { node = \"palette_label\", slot = { layout = { column = 1, row = 0 } } },\n  { node = \"palette_image\", slot = { layout = { column = 0, row = 1 } } },\n  { node = \"palette_container\", slot = { layout = { column = 1, row = 1 } } },\n]\n\n[nodes.palette_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"PaletteButton\"\nprops = { text = \"Button\", button_variant = \"outlined\", button_color = \"secondary\", button_size = \"small\", disabled = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.palette_label]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"PaletteLabel\"\nprops = { text = \"Label\", button_variant = \"outlined\", button_color = \"secondary\", button_size = \"small\", disabled = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.palette_image]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"PaletteImage\"\nprops = { text = \"Image\", button_variant = \"outlined\", button_color = \"secondary\", button_size = \"small\", disabled = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.palette_container]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"PaletteContainer\"\nprops = { text = \"Container\", button_variant = \"outlined\", button_color = \"secondary\", button_size = \"small\", disabled = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.hierarchy_panel]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"HierarchyPanel\"\nclasses = [\"ui-asset-section\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\"}, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"hierarchy_title\" },\n  { node = \"hierarchy_search\" },\n  { node = \"hierarchy_root_row\" },\n  { node = \"hierarchy_safe_area_row\" },\n  { node = \"hierarchy_content_row\" },\n]\n\n[nodes.hierarchy_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"HierarchyTitle\"\nprops = { text = \"Hierarchy\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" } }\n\n[nodes.hierarchy_search]\ncomponent = \"WorkbenchSearchInput\"\ncontrol_id = \"HierarchySearchInput\"\nprops = { query = \"\", placeholder = \"Search hierarchy\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\n\n[nodes.hierarchy_root_row]\ncomponent = \"WorkbenchTreeRow\"\ncontrol_id = \"HierarchyRootRow\"\nprops = { text = \"MainView\", expanded = true, selected = true, tree_depth = 0 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\n\n[nodes.hierarchy_safe_area_row]\ncomponent = \"WorkbenchTreeRow\"\ncontrol_id = \"HierarchySafeAreaRow\"\nprops = { text = \"Safe Area\", expanded = true, tree_depth = 1 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\n\n[nodes.hierarchy_content_row]\ncomponent = \"WorkbenchTreeRow\"\ncontrol_id = \"HierarchyContentRow\"\nprops = { text = \"Content\", expanded = false, tree_depth = 1 }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\n\n[nodes.center_column]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"CenterColumn\"\nclasses = [\"ui-asset-panel\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\"}, width = { min = \"$editor.density.ui_asset.center.min_width\", preferred = \"$editor.density.ui_asset.center.preferred_width\", stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"center_scroll_region\", slot = { layout = { padding = { left = \"$editor.density.panel_padding\", right = \"$editor.density.panel_padding\" } } } },\n]\n\n[nodes.center_scroll_region]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"CenterScrollRegion\"\nprops = { input_hoverable = true }\nlayout = { container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"designer_panel\" },\n  { node = \"action_bar_panel\" },\n  { node = \"source_panel\" },\n]\n\n[nodes.designer_panel]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"DesignerPanel\"\nclasses = [\"ui-asset-section\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\"}, width = { stretch = \"Stretch\" }, height = { min = 320.0, preferred = 360.0, max = 420.0, stretch = \"Stretch\" } }\nchildren = [\n  { node = \"designer_tool_mode_row\" },\n  { node = \"designer_canvas_panel\" },\n  { node = \"designer_diagnostic_overlay_panel\" },\n  { node = \"emergency_shell_panel\" },\n  { node = \"render_stack_panel\" },\n]\n\n[nodes.designer_tool_mode_row]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"DesignerToolModeRow\"\nclasses = [\"ui-asset-row\"]\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.regular\"}, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" } }\nchildren = [\n  { node = \"designer_select_button\" },\n  { node = \"designer_resize_slot_button\" },\n  { node = \"designer_preview_interact_button\" },\n  { node = \"designer_tool_fill\" },\n]\n\n[nodes.designer_select_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"DesignerSelectButton\"\nprops = { text = \"Select\", button_variant = \"text\", button_color = \"secondary\", button_size = \"small\", action_id = \"designer.tool.select\", selected = true, checked = true }\nevents = [{ id = \"UiAssetEditor/DesignerSelect\", event = \"Click\", route = \"designer.tool.select\" }]\nlayout = { width = { min = \"$editor.density.ui_asset.tool.min_width\", preferred = \"$editor.density.ui_asset.tool.preferred_width\", max = \"$editor.density.ui_asset.tool.max_width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.designer_resize_slot_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"DesignerResizeSlotButton\"\nprops = { text = \"Resize\", button_variant = \"text\", button_color = \"secondary\", button_size = \"small\", action_id = \"designer.tool.resize_slot\" }\nevents = [{ id = \"UiAssetEditor/DesignerResizeSlot\", event = \"Click\", route = \"designer.tool.resize_slot\" }]\nlayout = { width = { min = \"$editor.density.ui_asset.tool.min_width\", preferred = \"$editor.density.ui_asset.tool.preferred_width\", max = \"$editor.density.ui_asset.tool.max_width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.designer_preview_interact_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"DesignerPreviewInteractButton\"\nprops = { text = \"Preview\", button_variant = \"text\", button_color = \"secondary\", button_size = \"small\", action_id = \"designer.tool.preview_interact\" }\nevents = [{ id = \"UiAssetEditor/DesignerPreviewInteract\", event = \"Click\", route = \"designer.tool.preview_interact\" }]\nlayout = { width = { min = \"$editor.density.ui_asset.tool.min_width\", preferred = \"$editor.density.ui_asset.tool.preferred_width\", max = \"$editor.density.ui_asset.tool.max_width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.designer_tool_fill]\ncomponent = \"Space\"\ncontrol_id = \"DesignerToolFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.designer_canvas_panel]\ncomponent = \"CanvasBox\"\ncontrol_id = \"DesignerCanvasPanel\"\nclasses = [\"ui-asset-inset\"]\nlayout = { container = { kind = \"Free\" }, clip = true, width = { stretch = \"Stretch\" }, height = { min = 160.0, preferred = 210.0, max = 280.0, stretch = \"Stretch\" } }\n\n[nodes.designer_diagnostic_overlay_panel]\ncomponent 