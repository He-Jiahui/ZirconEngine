[asset]
kind = "view"
id = "res://ui/editor/windows/asset_window.zui#review-host"
version = 2
display_name = "Asset Window"

[imports]
widgets = [ "res://ui/editor/components/workbench/shell/activity_drawer_window.zui#ActivityDrawerWindow", "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown", "res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton", "res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput", "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab", "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton", "res://ui/editor/components/workbench/primitives/data/workbench_tree_row.zui#WorkbenchTreeRow", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption", "res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle", "res://ui/editor/components/workbench/composites/chrome/workbench_ui_asset_action_bar.zui#WorkbenchUiAssetActionBar", "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField", "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow" ]
styles = [ "res://ui/theme/editor_workbench_strict.zui", "res://ui/editor/theme/editor_tokens.zui" ]

[root]
node = "root"

[nodes.root]
component = "ActivityDrawerWindow"
control_id = "AssetWindowRoot"

[nodes.root.props]
shell_preset = "jetbrains_shell"
panel_preset = "fyrox_panel"
window_model = "unreal_window_model"

[[nodes.root.children]]
node = "tree"

[nodes.root.children.slot]
name = "left_top_activity"

[[nodes.root.children]]
node = "collections"

[nodes.root.children.slot]
name = "left_bottom_activity"

[[nodes.root.children]]
node = "details"

[nodes.root.children.slot]
name = "right_top_activity"

[[nodes.root.children]]
node = "preview"

[nodes.root.children.slot]
name = "right_bottom_activity"

[[nodes.root.children]]
node = "import_log"

[nodes.root.children.slot]
name = "bottom_left_activity"

[[nodes.root.children]]
node = "dependency"

[nodes.root.children.slot]
name = "bottom_right_activity"

[[nodes.root.children]]
node = "browser"

[nodes.root.children.slot]
name = "content"

[nodes.tree]
component = "Container"
control_id = "AssetWindowTreeActivity"

[nodes.tree.layout]
clip = true

[nodes.tree.layout.width]
stretch = "Stretch"

[nodes.tree.layout.height]
stretch = "Stretch"

[[nodes.tree.children]]
node = "review_tree__root"

[nodes.collections]
component = "Container"
control_id = "AssetWindowCollectionsActivity"

[nodes.collections.layout]
clip = true

[nodes.collections.layout.width]
stretch = "Stretch"

[nodes.collections.layout.height]
stretch = "Stretch"

[[nodes.collections.children]]
node = "review_collections__assets_activity_root"

[nodes.details]
component = "Container"
control_id = "AssetWindowDetailsActivity"

[nodes.details.layout]
clip = true

[nodes.details.layout.width]
stretch = "Stretch"

[nodes.details.layout.height]
stretch = "Stretch"

[[nodes.details.children]]
node = "review_details__root"

[nodes.preview]
component = "Container"
control_id = "AssetWindowPreviewActivity"

[nodes.preview.layout]
clip = true

[nodes.preview.layout.width]
stretch = "Stretch"

[nodes.preview.layout.height]
stretch = "Stretch"

[[nodes.preview.children]]
node = "review_preview__ui_asset_editor_root"

[nodes.import_log]
component = "Container"
control_id = "AssetWindowImportLogActivity"

[nodes.import_log.layout]
clip = true

[nodes.import_log.layout.width]
stretch = "Stretch"

[nodes.import_log.layout.height]
stretch = "Stretch"

[[nodes.import_log.children]]
node = "review_import_log__root"

[nodes.dependency]
component = "Container"
control_id = "AssetWindowDependencyActivity"

[nodes.dependency.layout]
clip = true

[nodes.dependency.layout.width]
stretch = "Stretch"

[nodes.dependency.layout.height]
stretch = "Stretch"

[[nodes.dependency.children]]
node = "review_dependency__root"

[nodes.browser]
component = "Container"
control_id = "AssetWindowBrowserContent"

[nodes.browser.layout]
clip = true

[nodes.browser.layout.width]
stretch = "Stretch"

[nodes.browser.layout.height]
stretch = "Stretch"

[[nodes.browser.children]]
node = "review_browser__asset_browser_root"

[nodes.review_tree__root]
pixel_snapping = "disabled"
component = "VerticalGroup"
control_id = "HierarchyPaneBodyRoot"
classes = [ "editor-pane", "hierarchy-pane", "panel" ]

[nodes.review_tree__root.layout.container]
kind = "VerticalBox"
gap = "$editor.density.gap.small"

[nodes.review_tree__root.layout.width]
stretch = "Stretch"

[nodes.review_tree__root.layout.height]
stretch = "Stretch"

[[nodes.review_tree__root.children]]
node = "review_tree__header"

[nodes.review_tree__header]
component = "HorizontalGroup"
control_id = "HierarchyHeader"

[nodes.review_tree__header.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.small"

[nodes.review_tree__header.layout.width]
stretch = "Stretch"

[nodes.review_tree__header.layout.height]
min = "$editor.control.height.dense"
preferred = "$editor.control.height.dense"
max = "$editor.control.height.dense"
stretch = "Fixed"

[[nodes.review_tree__header.children]]
node = "review_tree__select_root"

[nodes.review_tree__select_root]
component = "IconButton"
control_id = "SelectRoot"

[nodes.review_tree__select_root.props]
label = "Select Root"
icon = "editor_pages/hierarchy/entity/scene.svg"
icon_placement = "leading"

[nodes.review_tree__select_root.layout.width]
stretch = "Stretch"

[nodes.review_tree__select_root.layout.height]
stretch = "Stretch"

[[nodes.review_tree__select_root.events]]
id = "HierarchyPaneBody/SelectRoot"
event = "Click"
route = "workbench.selection.select_scene_node"

[nodes.review_collections__toolbar_title_text]
component = "Label"
control_id = "AssetsActivityTitleText"

[nodes.review_collections__toolbar_title_text.props]
text = "Assets"
font_size = "$editor.typography.overlay.size"
font_weight = "$editor.typography.emphasis.weight"

[nodes.review_collections__toolbar_title_text.layout.width]
stretch = "Stretch"

[nodes.review_collections__toolbar_title_text.layout.height]
stretch = "Stretch"

[nodes.review_collections__toolbar_open_browser_button]
component = "WorkbenchIconButton"
control_id = "OpenAssetBrowser"

[nodes.review_collections__toolbar_open_browser_button.props]
label = "Open Asset Browser"
icon = "folder-open-outline"
icon_placement = "icon_only"
dispatch_kind = "asset"

[nodes.review_collections__toolbar_open_browser_button.layout.width]
min = "$editor.control.height.dense"
preferred = "$editor.control.height.dense"
max = "$editor.control.height.dense"
stretch = "Fixed"

[nodes.review_collections__toolbar_open_browser_button.layout.height]
stretch = "Stretch"

[[nodes.review_collections__toolbar_open_browser_button.events]]
id = "Workbench/AssetsActivityOpenBrowser"
event = "Click"

[nodes.review_collections__toolbar_open_browser_button.events.action]
action = "view.asset_browser.open"

[nodes.review_collections__toolbar_title_row]
component = "HorizontalBox"
control_id = "AssetsActivityToolbarTitleRow"

[nodes.review_collections__toolbar_title_row.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.small"

[nodes.review_collections__toolbar_title_row.layout.width]
stretch = "Stretch"

[nodes.review_collections__toolbar_title_row.layout.height]
min = 20
preferred = 20
max = 20
stretch = "Fixed"

[[nodes.review_collections__toolbar_title_row.children]]
node = "review_collections__toolbar_title_text"

[nodes.review_collections__toolbar_search_field]
component = "WorkbenchSearchInput"
control_id = "SearchEdited"

[nodes.review_collections__toolbar_search_field.props]
placeholder = "Search"
dispatch_kind = "asset"

[nodes.review_collections__toolbar_search_field.layout.width]
stretch = "Stretch"

[nodes.review_collections__toolbar_search_field.layout.height]
stretch = "Stretch"

