penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/windows/asset_window.zui\"\nversion = 2\ndisplay_name = \"Asset Window\"\n\n[imports]\nwidgets = [\"res://ui/editor/components/workbench/shell/activity_drawer_window.zui#ActivityDrawerWindow\"]\n\n[root]\nnode = \"root\"\n\n[nodes.root]\ncomponent = \"ActivityDrawerWindow\"\ncontrol_id = \"AssetWindowRoot\"\nprops = { shell_preset = \"jetbrains_shell\", panel_preset = \"fyrox_panel\", window_model = \"unreal_window_model\" }\nchildren = [\n  { node = \"tree\", slot = { name = \"left_top_activity\" } },\n  { node = \"collections\", slot = { name = \"left_bottom_activity\" } },\n  { node = \"details\", slot = { name = \"right_top_activity\" } },\n  { node = \"preview\", slot = { name = \"right_bottom_activity\" } },\n  { node = \"import_log\", slot = { name = \"bottom_left_activity\" } },\n  { node = \"dependency\", slot = { name = \"bottom_right_activity\" } },\n  { node = \"browser\", slot = { name = \"content\" } },\n]\n\n[nodes.tree]\ncomponent = \"Container\"\ncontrol_id = \"AssetWindowTreeActivity\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.collections]\ncomponent = \"Container\"\ncontrol_id = \"AssetWindowCollectionsActivity\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.details]\ncomponent = \"Container\"\ncontrol_id = \"AssetWindowDetailsActivity\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.preview]\ncomponent = \"Container\"\ncontrol_id = \"AssetWindowPreviewActivity\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.import_log]\ncomponent = \"Container\"\ncontrol_id = \"AssetWindowImportLogActivity\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.dependency]\ncomponent = \"Container\"\ncontrol_id = \"AssetWindowDependencyActivity\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.browser]\ncomponent = \"Container\"\ncontrol_id = \"AssetWindowBrowserContent\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n"

[asset]
kind = "view"
id = "res://ui/editor/windows/asset_window.zui"
version = 2
display_name = "Asset Window"

[imports]
widgets = []
styles = []

[root]
node = "root"

[nodes.root]
component = "VerticalGroup"
control_id = "AssetWindowRoot"
pixel_snapping = "disabled"
classes = [ "activity-drawer-window" ]
events = []
