[penpot_review_host.asset]
kind = "view"
id = "res://ui/editor/windows/asset_window.zui#review-host"
version = 2
display_name = "Asset Window"

[penpot_review_host.imports]
widgets = []
styles = []

[penpot_review_host.root]
node = "root"

[penpot_review_host.nodes.root]
component = "VerticalGroup"
control_id = "AssetWindowRoot"
pixel_snapping = "disabled"
classes = [ "activity-drawer-window" ]
events = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/shell/activity_drawer_window.zui#ActivityDrawerWindow"

[penpot_review_host.nodes.root.layout]
clip = true

[penpot_review_host.nodes.root.layout.container]
kind = "VerticalBox"
gap = 0

[penpot_review_host.nodes.root.layout.width]
stretch = "Stretch"

[penpot_review_host.nodes.root.layout.height]
stretch = "Stretch"

[[penpot_review_host.nodes.root.children]]
