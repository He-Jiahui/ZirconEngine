[asset]
kind = "component"
id = "res://ui/editor/material_components/mui_x/material_mui_x_data_grid.zui"
version = 2
display_name = "Material MUI X Data Grid Prototype"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption"]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.MaterialMuiXDataGridPrototype]
root = "root"
default_classes = ["material-lab-prototype", "material-surface"]

[nodes.title]
component = "WorkbenchLabel"
control_id = "mui-x-data-grid_Title"
classes = ["material-lab-title"]
props = { "text" = "MUI X Data Grid", "text_tone" = "primary", "font_size" = "$editor.typography.title.size", "font_weight" = "$editor.typography.strong.weight", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 28, "preferred" = 28, "max" = 28, "stretch" = "Fixed" } }

[nodes.meta]
component = "GridBox"
control_id = "mui_x_data_grid_Meta"
classes = ["material-lab-meta-strip", "material-lab-meta"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 100, "preferred" = 100, "max" = 100, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 2, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "meta_group" },
  { node = "meta_response" },
  { node = "meta_variant" },
  { node = "meta_layout" },
]

[nodes.meta_group]
component = "WorkbenchCaption"
control_id = "mui_x_data_grid_MetaGroup"
classes = ["material-lab-meta-chip", "material-lab-meta-group"]
props = { "text" = "MUI X", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_response]
component = "WorkbenchCaption"
control_id = "mui_x_data_grid_MetaResponse"
classes = ["material-lab-meta-chip", "material-lab-meta-response"]
props = { "text" = "click / press", "text_tone" = "success", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "response_mechanism" = "click / press", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.meta_variant]
component = "WorkbenchCaption"
control_id = "mui_x_data_grid_MetaVariant"
classes = ["material-lab-meta-chip", "material-lab-meta-variant"]
props = { "text" = "sorted / selected", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "variant" = "sorted / selected", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_layout]
component = "WorkbenchCaption"
control_id = "mui_x_data_grid_MetaLayout"
classes = ["material-lab-meta-chip", "material-lab-meta-layout"]
props = { "text" = "data viewport", "text_tone" = "warning", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "layout_mode" = "data viewport", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.sample]
component = "DataGrid"
control_id = "mui-x-data-grid_Sample"
classes = ["material-control", "material-lab-sample", "MuiDataGrid-root"]
props = { rows = ["Alpha", "Beta"], columns = ["Name", "State"], density = "compact", loading = true, checkboxSelection = true, disableColumnMenu = false, disableRowSelectionOnClick = false, autoHeight = true, showToolbar = true, hideFooterPagination = true, hideFooterSelectedRowCount = true, showCellVerticalBorder = true, showColumnVerticalBorder = true, rowSpacingType = "border", scrollbarSize = 12, label = "Material grid", page = 1, pageSize = 25, rowCount = 100, rowHeight = 32, overscanCount = 4, disableVirtualization = true, viewport_start = 5, viewport_count = 20, requested_start = 4, requested_count = 24, scrollTop = 128, rowSelectionModel = ["Alpha"], sortingMode = "client", filterMode = "client", sortModel = ["Name:asc"], filterModel = { items = ["State=Ready"] }, paginationModel = { page = 1, pageSize = 25 }, quickFilterValues = ["Alpha"], editMode = "row", cellModesModel = { Alpha = "edit" }, rowModesModel = { Beta = "view" }, columnVisibilityModel = { State = false }, pinnedColumns = { left = ["Name"], right = ["State"] }, slotProps = { header = { className = "material-mui-x-header" }, columnHeader = { className = "material-mui-x-column-header" }, row = { className = "material-mui-x-row" }, cell = { className = "material-mui-x-cell" } }, text = "MUI X Data Grid", surface_variant = "elevated", button_variant = "contained", text_tone = "primary", validation_level = "normal", hovered = true, pressed = false, focused = true, selected = true, checked = true, disabled = false, open = true, popup_open = true, corner_radius = 4, border_width = 1, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "MaterialLab/MuiXDataGrid/Click", event = "Click", route = "material_lab.mui_x_data_grid.click" },
]

[nodes.state_strip]
component = "GridBox"
control_id = "mui_x_data_grid_StateStrip"
classes = ["material-lab-state-strip"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 108, "preferred" = 108, "max" = 108, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "state_default" },
  { node = "state_hover" },
  { node = "state_pressed" },
  { node = "state_focus" },
  { node = "state_disabled" },
  { node = "state_selected" },
  { node = "state_open" },
  { node = "state_error" },
]
