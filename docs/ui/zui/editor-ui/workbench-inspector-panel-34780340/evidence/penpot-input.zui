penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/shell/workbench_inspector_panel.zui\"\nversion = 2\ndisplay_name = \"Workbench Inspector Panel\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_axis_value_field.zui#WorkbenchAxisValueField\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_component_property_row.zui#WorkbenchComponentPropertyRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput\",\n]\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.WorkbenchInspectorPanel]\nroot = \"inspector_panel\"\ndefault_classes = [\"workbench-panel\", \"workbench-right-panel\"]\n\n[nodes.inspector_panel]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchInspectorPanel\"\nclasses = [\"workbench-panel\", \"workbench-right-panel\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { preferred = \"$editor.density.right_drawer_width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"inspector_header\", slot = { layout = { padding = { left = \"$editor.density.gap.large\", right = \"$editor.density.gap.large\", top = \"$editor.density.gap.small\", bottom = \"$editor.density.gap.small\" } } } },\n  { node = \"inspector_filter_row\", slot = { layout = { padding = { left = \"$editor.density.gap.large\", right = \"$editor.density.gap.large\" } } } },\n  { node = \"inspector_content\", slot = { layout = { padding = { left = \"$editor.density.gap.large\", right = \"$editor.density.gap.large\", top = \"$editor.density.gap.small\", bottom = \"$editor.density.gap.small\" } } } },\n  { node = \"inspector_add_component\", slot = { layout = { padding = { left = \"$editor.density.gap.large\", right = \"$editor.density.gap.large\", top = \"$editor.density.gap.medium\", bottom = \"$editor.density.gap.medium\" } } } },\n]\n\n[nodes.inspector_header]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"RightDrawerHeaderRoot\"\nclasses = [\"workbench-panel-header\"]\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nchildren = [{ node = \"inspector_title\" }]\n\n[nodes.inspector_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"RightDrawerContentRoot\"\nclasses = [\"workbench-right-drawer-content\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.large\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"inspector_metadata\" }, { node = \"inspector_transform\" }, { node = \"inspector_mesh\" }, { node = \"inspector_filter_empty\" }]\n\n[nodes.inspector_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchInspectorTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Props\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\n\n[nodes.inspector_filter_row]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchInspectorFilterRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nchildren = [{ node = \"inspector_filter_field\" }]\n\n[nodes.inspector_filter_field]\ncomponent = \"WorkbenchSearchInput\"\ncontrol_id = \"WorkbenchInspectorFilter\"\nclasses = [\"workbench-search-input\", \"workbench-muted\"]\nprops = { query = \"\", placeholder = \"Filter properties...\" }\nwidget = { value_property = \"query\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [\n  { id = \"Workbench/InspectorSearchEdit\", event = \"Change\", component_event = \"ValueChanged\", route = \"workbench.inspector.search.edit\" },\n  { id = \"Workbench/InspectorSearchCommit\", event = \"Submit\", component_event = \"Commit\", route = \"workbench.inspector.search.commit\" },\n]\n\n[nodes.inspector_filter_empty]\ncomponent = \"WorkbenchLabel\"\ncontrol_id = \"WorkbenchInspectorFilterEmpty\"\nclasses = [\"workbench-muted\"]\nprops = { text = \"No matching properties\", text_tone = \"muted\", visibility = \"collapsed\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\n\n[nodes.inspector_metadata]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchInspectorMetadata\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.large\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nchildren = [{ node = \"inspector_layer_label\" }, { node = \"inspector_layer_mask\" }]\n\n[nodes.inspector_layer_label]\ncomponent = \"WorkbenchLabel\"\ncontrol_id = \"WorkbenchInspectorRenderLayerLabel\"\nclasses = [\"workbench-transform-row-label\"]\nprops = { text = \"Layer mask\", text_tone = \"muted\", font_size = \"$editor.typography.body.size\" }\n# Keep the label's 14px text on one line beside the 96–120px field at compact\n# editor widths; the previous stretch-only slot collapsed to 64px and emitted\n# two text fragments outside its semantic node.\nlayout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.inspector_layer_mask]\ncomponent = \"WorkbenchAxisValueField\"\ncontrol_id = \"WorkbenchInspectorRenderLayerMask\"\nclasses = [\"workbench-field\"]\nprops = { value = \"1\", placeholder = \"1\" }\nlayout = { width = { min = 96.0, preferred = 112.0, max = 120.0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [\n  { id = \"Inspector/RenderLayerMaskEdit\", event = \"Change\", route = \"workbench.inspector.render_layer_mask.edit\" },\n  { id = \"Inspector/RenderLayerMaskCommit\", event = \"Submit\", route = \"workbench.inspector.render_layer_mask.commit\" },\n]\n\n[nodes.inspector_transform]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchInspectorTransform\"\nclasses = [\"workbench-property-section\", \"workbench-transform-section\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Fixed\" } }\nchildren = [{ node = \"transform_label\" }, { node = \"position_row\" }, { node = \"rotation_row\" }, { node = \"scale_row\" }]\n\n[nodes.transform_label]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchTransformLabel\"\nclasses = [\"workbench-section-title\", \"workbench-transform-title\"]\nprops = { text = \"Transform\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\n\n[nodes.position_row]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchTransformPosition\"\nclasses = [\"workbench-property-row\", \"workbench-transform-row\", \"workbench-transform-position-row\"]\nprops = { value = \"X 128.4   Y 64.2   Z -32.7\", layout_label_width = 83.0, layout_axis_width = 14.0, layout_primary_value_width = 61.0, layout_value_width = 68.0, layout_offset_x = 0.0, layout_offset_y = 12.0 }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Fixed\" } }\nchildren = [{ node = \"position_label\" }, { node = \"position_values\" }]\n\n[nodes.position_label]\ncomponent = \"WorkbenchLabel\"\ncontrol_id = \"WorkbenchTransformPositionLabel\"\nclasses = [\"workbench-transform-row-label\"]\nprops = { text = \"Position\", text_tone = \"muted\", font_size = \"$editor.typography.body.size\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\n\n[nodes.position_values]\ncomponent = \"WrapBox\"\ncontrol_id = \"WorkbenchTransformPositionValues\"\nlayout = { container = { kind = \"WrapBox\", horizontal_gap = \"$editor.density.gap.small\", vertical_gap = \"$editor.density.gap.small\", item_min_width = 96.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Fixed\" } }\nchildren = [{ node = \"position_value_x_group\" }, { node = \"position_value_y_group\" }, { node = \"position_value_z_group\" }]\n\n[nodes.position_value_x_group]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchTransformPositionXGroup\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { min = 96.0, preferred = 120.0, stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nchildren = [{ node = \"position_axis_x\" }, { node = \"position_value_x\" }]\n\n[nodes.position_axis_x]\ncomponent = \"WorkbenchLabel\"\ncontrol_id = \"WorkbenchTransformPositionAxisX\"\nclasses = [\"workbench-axis-label\", \"workbench-axis-x\"]\nprops = { text = \"X\", font_size = \"$editor.typography.caption.size\", label_color = \"$editor.text.disabled\" }\nlayout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.position_value_x]\ncomponent = \"WorkbenchAxisValueField\"\ncontrol_id = \"WorkbenchTransformPositionX\"\nclasses = [\"workbench-axis-value-field\"]\nprops = { value = \"128.4\", value_color = \"$editor.text.secondary\" }\nlayout = { width = { min = 70.0, preferred = 98.0, max = 130.0, stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nevents = [\n  { id = \"Inspector/TransformPositionXEdit\", event = \"Change\", route = \"workbench.inspector.transform.position_x.edit\" },\n  { id = \"Inspector/TransformPositionXCommit\", event = \"Submit\", route = \"workbench.inspector.transform.position_x.commit\" },\n]\n\n[nodes.position_axis_y]\ncomponent = \"WorkbenchLabel\"\ncontrol_id = \"WorkbenchTransformPositionAxisY\"\nclasses = [\"workbench-axis-label\", \"workbench-axis-y\"]\nprops = { text = \"Y\", font_size = \"$editor.typography.caption.size\", label_color = \"$editor.text.disabled\" }\nlayout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.position_value_y]\ncomponent = \"WorkbenchAxisValueField\"\ncontrol_id = \"WorkbenchTransformPositionY\"\nclasses = [\"workbench-axis-value-field\"]\nprops = { value = \"64.2\", value_color = \"$editor.text.secondary\" }\nlayout = { width = { min = 70.0, preferred = 98.0, max = 130.0, stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor