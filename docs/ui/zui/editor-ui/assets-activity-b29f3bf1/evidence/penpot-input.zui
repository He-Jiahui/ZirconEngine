[asset]
kind = "view"
id = "res://ui/editor/assets_activity.zui"
version = 2
display_name = "Assets Activity"

[imports]
widgets = []
styles = []

[root]
node = "assets_activity_root"

[nodes.toolbar_title_text]
component = "Label"
control_id = "AssetsActivityTitleText"

[nodes.toolbar_title_text.props]
text = "Assets"
font_size = "$editor.typography.overlay.size"
font_weight = "$editor.typography.emphasis.weight"

[nodes.toolbar_title_text.layout.width]
stretch = "Stretch"

[nodes.toolbar_title_text.layout.height]
stretch = "Stretch"

[nodes.toolbar_open_browser_button]
component = "IconButton"
control_id = "OpenAssetBrowser"
pixel_snapping = "disabled"
classes = [ "workbench-icon-button", "workbench-primitive" ]
children = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton"

[nodes.toolbar_open_browser_button.props]
icon = "folder-open-outline"
text = ""
label = "Open Asset Browser"
button_variant = "text"
button_color = "secondary"
button_size = "small"
button_interaction_state = "normal"
icon_placement = "icon_only"
selected = false
focused = false
hovered = false
pressed = false
disabled = false
background_color = "transparent"
hover_background_color = "$editor.surface.hover"
pressed_background_color = "$editor.surface.3"
selected_background_color = "$editor.surface.selected"
disabled_background_color = "$editor.surface.disabled"
border_color = "transparent"
focus_border_color = "$editor.focus.ring"
disabled_border_color = "$editor.border.disabled"
icon_color = "$editor.text.secondary"
selected_icon_color = "$editor.accent"
disabled_foreground_color = "$editor.text.disabled"
border_width = "$editor.control.border_width"
corner_radius = "$editor.control.radius.control"
layout_padding_left = "$editor.density.gap.medium"
layout_padding_right = "$editor.density.gap.medium"
layout_padding_top = "$editor.density.gap.small"
layout_padding_bottom = "$editor.density.gap.small"
layout_spacing = "$editor.density.gap.small"
layout_min_width = "$editor.control.height.default"
layout_min_height = "$editor.control.height.default"
input_interactive = true
input_clickable = true
input_hoverable = true
input_focusable = true
dispatch_kind = "asset"

[nodes.toolbar_open_browser_button.layout.width]
min = "$editor.control.height.dense"
preferred = "$editor.control.height.dense"
max = "$editor.control.height.dense"
stretch = "Fixed"

[nodes.toolbar_open_browser_button.layout.height]
min = "$editor.control.height.default"
preferred = "$editor.control.height.default"
max = "$editor.control.height.default"
stretch = "Stretch"

[[nodes.toolbar_open_browser_button.events]]
id = "Workbench/AssetsActivityOpenBrowser"
event = "Click"

[nodes.toolbar_open_browser_button.events.action]
action = "view.asset_browser.open"

[nodes.toolbar_open_browser_button.state]
[nodes.toolbar_open_browser_button.style.self]
[nodes.toolbar_open_browser_button.style.slot]
[nodes.toolbar_open_browser_button.slots]
[nodes.toolbar_title_row]
component = "HorizontalBox"
control_id = "AssetsActivityToolbarTitleRow"

[nodes.toolbar_title_row.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.small"

[nodes.toolbar_title_row.layout.width]
stretch = "Stretch"

[nodes.toolbar_title_row.layout.height]
min = 20
preferred = 20
max = 20
stretch = "Fixed"

[[nodes.toolbar_title_row.children]]
node = "toolbar_title_text"

[nodes.toolbar_subtitle_text]
component = "Label"
control_id = "AssetsActivitySubtitleText"

[nodes.toolbar_subtitle_text.props]
text = "Browse project assets"
text_tone = "muted"
font_size = "$editor.typography.caption.size"
overflow = "elide"

[nodes.toolbar_subtitle_text.layout.width]
stretch = "Stretch"

[nodes.toolbar_subtitle_text.layout.height]
stretch = "Stretch"

[nodes.toolbar_subtitle_row]
component = "HorizontalBox"
control_id = "AssetsActivityToolbarSubtitleRow"

[nodes.toolbar_subtitle_row.layout.container]
kind = "HorizontalBox"
gap = 0

[nodes.toolbar_subtitle_row.layout.width]
stretch = "Stretch"

[nodes.toolbar_subtitle_row.layout.height]
min = 13
preferred = 13
max = 13
stretch = "Fixed"

[[nodes.toolbar_subtitle_row.children]]
node = "toolbar_subtitle_text"

[nodes.toolbar_search_field]
component = "SearchField"
control_id = "SearchEdited"
classes = [ "workbench-field", "workbench-search-input", "workbench-primitive" ]
children = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput"

[nodes.toolbar_search_field.props]
query = ""
placeholder = "Search"
validation_level = "normal"
focused = false
hovered = false
disabled = false
editable_text = true
has_clear_action = true
background_color = "$editor.surface.recessed"
hover_background_color = "$editor.surface.hover"
pressed_background_color = "$editor.surface.3"
focused_background_color = "$editor.surface.recessed"
disabled_background_color = "$editor.surface.disabled"
border_color = "$editor.separator.soft"
hover_border_color = "$editor.border"
focus_border_color = "$editor.focus.ring"
disabled_border_color = "$editor.border.disabled"
foreground_color = "$editor.text.primary"
placeholder_color = "$editor.text.secondary"
disabled_foreground_color = "$editor.text.disabled"
border_width = "$editor.control.border_width"
corner_radius = "$editor.control.radius.control"
font_size = "$editor.typography.body.size"
line_height_ratio = "$editor.typography.line_height"
layout_padding_left = "$editor.control.height.dense"
layout_padding_right = "$editor.density.gap.large"
layout_padding_top = "$editor.density.gap.small"
layout_padding_bottom = "$editor.density.gap.small"
layout_min_height = "$editor.control.height.dense"
input_interactive = true
input_clickable = true
input_hoverable = true
input_focusable = true
dispatch_kind = "asset"

[nodes.toolbar_search_field.widget]
value_property = "query"

[nodes.toolbar_search_field.layout.width]
stretch = "Stretch"

[nodes.toolbar_search_field.layout.height]
min = "$editor.control.height.dense"
preferred = "$editor.control.height.compact"
max = "$editor.control.height.default"
stretch = "Stretch"

[[nodes.toolbar_search_field.events]]
id = "Workbench/AssetsActivitySearchEdited"
event = "Change"
route = "workbench.assets_activity.search.edit"

[nodes.toolbar_search_field.state]
[nodes.toolbar_search_field.style.self]
