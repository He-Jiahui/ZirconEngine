trol_id = \"AssetsActivityReferencesTabButton\"\nprops = { text = \"Refs\", dispatch_kind = \"asset\", action_id = \"workbench.asset.utility_tab.set\", value_text = \"references\" }\nlayout = { width = { min = 58.0, preferred = 58.0, max = 58.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetsActivityUtilityReferences\", event = \"Change\", route = \"workbench.assets_activity.utility.references\" }]\n\n[nodes.utility_tabs_spacer]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.utility_selection_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetsActivitySelectionText\"\nprops = { text = \"No asset selected\", text_tone = \"muted\", font_size = \"$editor.typography.caption.size\", text_align = \"right\", overflow = \"elide\" }\nlayout = { width = { min = 144.0, preferred = 144.0, max = 144.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.utility_tabs_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetsActivityUtilityTabsRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nchildren = [{ node = \"utility_preview_button\" }, { node = \"utility_references_button\" }, { node = \"utility_tabs_spacer\" }, { node = \"utility_selection_text\" }]\n\n[nodes.utility_tabs_divider]\ncomponent = \"Space\"\ncontrol_id = \"AssetsActivityUtilityDivider\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" } }\n\n[nodes.preview_visual_panel]\ncomponent = \"Overlay\"\ncontrol_id = \"AssetsActivityPreviewVisualPanel\"\nprops = { surface_variant = \"asset-preview-visual\", radius = \"$editor.control.radius.control\", border_width = \"$edit