penpot_original_source = "stylesheets = []\n\n[asset]\nkind = \"view\"\nid = \"res://ui/editor/assets_activity.zui\"\nversion = 2\ndisplay_name = \"Assets Activity\"\n\n[imports]\nwidgets = [\"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\", \"res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton\", \"res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput\", \"res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab\"]\nstyles = [\"res://ui/theme/editor_workbench_strict.zui\"]\n\n[root]\nnode = \"assets_activity_root\"\n\n[nodes.toolbar_title_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetsActivityTitleText\"\nprops = { text = \"Assets\", font_size = \"$editor.typography.overlay.size\", font_weight = \"$editor.typography.emphasis.weight\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_open_browser_button]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"OpenAssetBrowser\"\nprops = { label = \"Open Asset Browser\", icon = \"folder-open-outline\", icon_placement = \"icon_only\", dispatch_kind = \"asset\" }\nlayout = { width = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetsActivityOpenBrowser\", event = \"Click\", action = { action = \"view.asset_browser.open\" } }]\n\n[nodes.toolbar_title_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetsActivityToolbarTitleRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 20.0, preferred = 20.0, max = 20.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"toolbar_title_text\" }]\n\n[nodes.toolbar_subtitle_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetsActivitySubtitleText\"\nprops = { text = \"Browse project assets\", text_tone = \"muted\", font_size = \"$editor.typography.caption.size\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_subtitle_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetsActivityToolbarSubtitleRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"toolbar_subtitle_text\" }]\n\n[nodes.toolbar_search_field]\ncomponent = \"WorkbenchSearchInput\"\ncontrol_id = \"SearchEdited\"\nprops = { placeholder = \"Search\", dispatch_kind = \"asset\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetsActivitySearchEdited\", event = \"Change\", route = \"workbench.assets_activity.search.edit\" }]\n\n[nodes.toolbar_view_mode_list_button]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"AssetsActivityViewModeListButton\"\nprops = { label = \"List view\", icon = \"list-outline\", icon_placement = \"icon_only\", dispatch_kind = \"asset\", action_id = \"workbench.asset.view_mode.set\", value = \"list\" }\nlayout = { width = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetsActivityViewModeList\", event = \"Change\", route = \"workbench.assets_activity.view_mode.list\" }]\n\n[nodes.toolbar_view_mode_thumb_button]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"AssetsActivityViewModeThumbButton\"\nprops = { label = \"Thumbnail view\", icon = \"grid-outline\", icon_placement = \"icon_only\", dispatch_kind = \"asset\", action_id = \"workbench.asset.view_mode.set\", value = \"thumbnail\" }\nlayout = { width = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetsActivityViewModeThumbnail\", event = \"Change\", route = \"workbench.assets_activity.view_mode.thumbnail\" }]\n\n[nodes.toolbar_search_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetsActivityToolbarSearchRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" } }\nchildren = [{ node = \"toolbar_search_field\" }, { node = \"toolbar_open_browser_button\" }]\n\n[nodes.toolbar_kind_filter_dropdown]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"AssetsActivityKindFilterDropdown\"\nprops = { value = \"All\", value_text = \"All Types\", options = [\"All|label=All Types\", \"Texture|label=Textures\", \"Material|label=Materials\", \"Scene|label=Scenes\", \"Model|label=Models\", \"Mesh|label=Meshes\", \"Shader|label=Shaders\", \"PhysicsMaterial|label=Physics Materials\", \"AnimationSkeleton|label=Animation Skeletons\", \"AnimationClip|label=Animation Clips\", \"AnimationSequence|label=Animation Sequences\", \"AnimationGraph|label=Animation Graphs\", \"AnimationStateMachine|label=Animation State Machines\", \"UiLayout|label=UI Layouts\", \"UiWidget|label=UI Widgets\", \"UiStyle|label=UI Styles\"], dispatch_kind = \"asset\" }\nlayout = { width = { min = 148.0, preferred = 220.0, max = 300.0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetsActivityKindFilterChanged\", event = \"Change\", route = \"workbench.assets_activity.kind_filter.change\" }]\n\n[nodes.toolbar_filter_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetsActivityToolbarFilterRow\