[asset]
kind = "component"
id = "res://ui/editor/material_components/inputs/material_toggle_button.zui"
version = 2
display_name = "Material Toggle Button Prototype"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption"]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.MaterialToggleButtonPrototype]
root = "root"
default_classes = ["material-lab-prototype", "material-surface"]

[nodes.title]
component = "WorkbenchLabel"
control_id = "toggle-button_Title"
classes = ["material-lab-title"]
props = { "text" = "Toggle Button", "text_tone" = "primary", "font_size" = "$editor.typography.title.size", "font_weight" = "$editor.typography.strong.weight", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 28, "preferred" = 28, "max" = 28, "stretch" = "Fixed" } }

[nodes.meta]
component = "GridBox"
control_id = "toggle_button_Meta"
classes = ["material-lab-meta-strip", "material-lab-meta"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 100, "preferred" = 100, "max" = 100, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 2, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "meta_group" },
  { node = "meta_response" },
  { node = "meta_variant" },
  { node = "meta_layout" },
]

[nodes.meta_group]
component = "WorkbenchCaption"
control_id = "toggle_button_MetaGroup"
classes = ["material-lab-meta-chip", "material-lab-meta-group"]
props = { "text" = "Inputs", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_response]
component = "WorkbenchCaption"
control_id = "toggle_button_MetaResponse"
classes = ["material-lab-meta-chip", "material-lab-meta-response"]
props = { "text" = "toggle / checked", "text_tone" = "success", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "response_mechanism" = "toggle / checked", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.meta_variant]
component = "WorkbenchCaption"
control_id = "toggle_button_MetaVariant"
classes = ["material-lab-meta-chip", "material-lab-meta-variant"]
props = { "text" = "exclusive / multiple", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "variant" = "exclusive / multiple", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_layout]
component = "WorkbenchCaption"
control_id = "toggle_button_MetaLayout"
classes = ["material-lab-meta-chip", "material-lab-meta-layout"]
props = { "text" = "inline controls", "text_tone" = "warning", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "layout_mode" = "inline controls", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.sample]
component = "HorizontalBox"
control_id = "toggle-button_Sample"
classes = ["material-control", "material-lab-sample", "material-toggle-button-row"]
props = { "text" = "", "surface_variant" = "elevated", "button_variant" = "contained", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "none", "text_tone" = "primary", "validation_level" = "normal", "selection_state" = "exclusive", "hovered" = true, "pressed" = false, "focused" = true, "selected" = true, "checked" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "input_interactive" = true, "input_clickable" = true, "input_hoverable" = true, "input_focusable" = true, "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 152, "preferred" = 152, "max" = 152, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 1, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.medium" } }
children = [
  { node = "toggle_exclusive_selected" },
  { node = "toggle_exclusive_hover" },
  { node = "toggle_multi_checked" },
  { node = "toggle_disabled" },
]
events = [
  { id = "MaterialLab/ToggleButton/Toggle", event = "Toggle", route = "material_lab.toggle_button.toggle" },
]

[nodes.toggle_exclusive_selected]
component = "ToggleButton"
control_id = "toggle-button_ExclusiveSelected"
classes = ["material-control", "material-toggle-button", "material-toggle-button-selected"]
props = { "text" = "Solo", "surface_variant" = "elevated", "button_variant" = "outlined", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "none", "selection_state" = "exclusive", "text_tone" = "primary", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = true, "selected" = true, "checked" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "button_variant" = "outlined", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "none", "button_interaction_state" = "focused", "background" = { "color" = "$editor.accent.soft" }, "foreground" = { "color" = "material.text" }, "border" = { "color" = "material.focus_ring", "width" = 1, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.toggle_exclusive_hover]
component = "ToggleButton"
control_id = "toggle-button_ExclusiveHover"
classes = ["material-control", "material-toggle-button", "material-toggle-button-hover"]
props = { "text" = "Hover", "surface_variant" = "elevated", "button_variant" = "outlined", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "none", "selection_state" = "exclusive", "text_tone" = "primary", "validation_level" = "normal", "hovered" = true, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "button_variant" = "outlined", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "none", "button_interaction_state" = "hover", "background" = { "color" = "material.surface_hover" }, "foreground" = { "color" = "material.text" }, "border" = { "color" = "$editor.accent", "width" = 1, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.toggle_multi_checked]
component = "ToggleButton"
control_id = "toggle-button_MultiChecked"
classes = ["material-control", "material-toggle-button", "material-toggle-button-multiple"]
props = { "text" = "Multi", "surface_variant" = "elevated", "button_variant" = "outlined", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "none", "selection_state" = "multiple", "text_tone" = "primary", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = true, "checked" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "button_variant" = "outlined", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "none", "background" = { "color" = "material.surface_selected" }, "foreground" = { "color" = "material.text" }, "border" = { "color" = "$editor.accent", "width" = 1, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.toggle_disabled]
component = "ToggleButton"
control_id = "toggle-button_Disabled"
classes = ["material-control", "material-toggle-button", "material-toggle-button-disabled"]
props = { "text" = "Off", "surface_variant" = "elevated", "button_variant" = "outlined", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "none", "selection_state" = "exclusive", "text_tone" = "disabled", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = true, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "button_variant" = "outlined", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "none", "button_interaction_state" = "disabled", "background" = { "color" = "material.disabled" }, "foreground" = { "color" = "material.text_disabled" }, "border" = { "color" = "material.outline", "width" = 1, "radius" = "$editor.control.radius.control" }, "opacity" = 0.38 } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.state_strip]
component = "GridBox"
control_id = "toggle_button_StateStrip"
classes = ["material-lab-state-strip"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 108, "preferred" = 108, "max" = 108, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "state_default" },
  { node = "state_hover" },
  { node = "state_pressed" },
  { node = "state_focus" },
  { node = "state_disabled" },
  { node = "state_selected" },
  { node = "state_open" },
  { node = "state_error" },
]
