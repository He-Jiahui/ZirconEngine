penpot_original_source = "[asset]\r\nkind = \"component\"\r\nid = \"res://ui/editor/components/workbench/modules/core/ai/workbench_perception_workspace.zui\"\r\nversion = 2\r\ndisplay_name = \"Workbench Perception Workspace\"\r\n\r\n[imports]\r\nwidgets = [\r\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\r\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\r\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\r\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\r\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\r\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\r\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\r\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\r\n]\r\nstyles = []\r\n[components.WorkbenchPerceptionWorkspace]\r\nroot = \"perception_workspace\"\r\ndefault_classes = [\"workbench-module-body\"]\r\n\r\n[nodes.perception_workspace]\r\ncomponent = \"Overlay\"\r\ncontrol_id = \"WorkbenchModulePerceptionWorkspace\"\r\nclasses = [\"workbench-module-body\"]\r\nprops = { visibility = \"collapsed\" }\r\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [\r\n  { node = \"perception_workspace_main\" },\r\n  { node = \"perception_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\r\n]\r\n\r\n[nodes.perception_workspace_main]\r\ncomponent = \"HorizontalGroup\"\r\nclasses = [\"workbench-module-layout-main\"]\r\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"perception_rail_gap\" }, { node = \"perception_left\" }, { node = \"perception_center\" }, { node = \"perception_right_reserve\" }]\r\n\r\n[nodes.perception_right_reserve]\r\ncomponent = \"Container\"\r\nclasses = [\"workbench-module-details-reserve\"]\r\nprops = { responsive_min_tier = \"wide\" }\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.perception_rail_gap]\r\ncomponent = \"Container\"\r\ncontrol_id = \"WorkbenchPerceptionRailGap\"\r\nprops = { responsive_min_tier = \"narrow\" }\r\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.perception_left]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchPerceptionLeftPanel\"\r\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\r\nprops = { responsive_min_tier = \"narrow\" }\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"perception_title\" }, { node = \"perception_left_content\" }]\r\n\r\n[nodes.perception_left_content]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchPerceptionLeftContent\"\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"perception_guard_row\" }, { node = \"perception_sniper_row\" }]\r\n\r\n[nodes.perception_title]\r\ncomponent = \"WorkbenchSectionTitle\"\r\ncontrol_id = \"WorkbenchPerceptionTitle\"\r\nprops = { text = \"AI Perception\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.perception_guard_row]\r\ncomponent = \"WorkbenchListRow\"\r\ncontrol_id = \"WorkbenchPerceptionGuardRow\"\r\nclasses = [\"workbench-list-row\"]\r\nprops = { text = \"AI_Guard_01\", icon = \"eye\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/PerceptionGuard\", event = \"Click\", route = \"workbench.module.perception.agent.guard\" }]\r\n\r\n[nodes.perception_sniper_row]\r\ncomponent = \"WorkbenchListRow\"\r\ncontrol_id = \"WorkbenchPerceptionSniperRow\"\r\nclasses = [\"workbench-list-row\"]\r\nprops = { text = \"Sniper_Perception\", icon = \"eye\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/PerceptionSniper\", event = \"Click\", route = \"workbench.module.perception.agent.sniper\" }]\r\n\r\n[nodes.perception_center]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchPerceptionCenterPanel\"\r\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"perception_center_header\" }, { node = \"perception_map_canvas\" }, { node = \"perception_event_row\" }]\r\n\r\n[nodes.perception_center_header]\r\ncomponent = \"HorizontalGroup\"\r\ncontrol_id = \"WorkbenchPerceptionCenterHeader\"\r\nclasses = [\"workbench-panel-toolbar\"]\r\nlayout = { container = { kind = \"HorizontalBox\", gap = \