rception_map_row_01]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchPerceptionSightConeRow\"\nclasses = [\"workbench-property-row\"]\nprops = { text = \"Sight Cone\", value_text = \"AI_Guard_01   74 deg   target visible\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 48.0, preferred = 48.0, max = 48.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/PerceptionSightCone\", event = \"Click\", route = \"workbench.module.perception.sight_cone\" }]\r\n\r\n[nodes.perception_map_row_02]\r\ncomponent = \"WorkbenchPropertyRow\"\r\ncontrol_id = \"WorkbenchPerceptionHearingPulseRow\"\r\nclasses = [\"workbench-property-row\"]\r\nprops = { text = \"Hearing Pulse\", value_text = \"Noise_Maker_BP   1200 cm\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/PerceptionHearingPulse\", event = \"Click\", route = \"workbench.module.perception.hearing_pulse\" }]\r\n\r\n[nodes.perception_map_row_03]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchPerceptionStimulusRow\"\r\nclasses = [\"workbench-table-row\"]\r\nprops = { text = \"00:12.345\", value_text = \"Noise_Maker_BP   Hearing   Purple\", options = [\"00:12.345\",\"Noise_Maker_BP\",\"Hearing\",\"Purple\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/PerceptionStimulus\", event = \"Click\", route = \"workbench.module.perception.stimulus\" }]\r\n\r\n[nodes.perception_event_row]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchPerceptionEventRow\"\r\nclasses = [\"workbench-table-row\"]\r\nprops = { text = \"Event\", value_text = \"AI_Guard_01   Hearing stimulus   00:11.8\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, options = [\"Event\",\"AI_Guard_01\",\"Hearing stimulus\",\"00:11.8\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.perception_right]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchPerceptionRightPanel\"\r\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\r\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"perception_details_title\" }, { node = \"perception_right_content\" }]\r\n\r\n[nodes.perception_right_content]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchPerceptionRightContent\"\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"perception_config_property_row\" }, { node = \"perception_los_property_row\" }, { node = \"perception_team_property_row\" }]\r\n\r\n[nodes.perception_details_title]\r\ncomponent = \"WorkbenchSectionTitle\"\r\ncontrol_id = \"WorkbenchPerceptionDetailsTitle\"\r\nprops = { text = \"Details\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.perception_config_property_row]\r\ncomponent = \"WorkbenchPropertyEditorRow\"\r\ncontrol_id = \"WorkbenchPerceptionConfigPropertyRow\"\r\nprops = { text = \"Configuration\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\nchildren = [{ node = \"perception_config_dropdown\", slot = { name = \"value\" } }]\r\n\r\n[nodes.perception_config_dropdown]\r\ncomponent = \"WorkbenchDropdown\"\r\ncontrol_id = \"WorkbenchPerceptionConfigDropdown\"\r\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\r\nprops = { value = \"Guard_Perception\", value_text = \"Guard Perception\", options = [\"Guard_Perception|label=Guard Perception\", \"Sniper_Perception|label=Sniper Perception\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\r\nevents = [\r\n  { id = \"WorkbenchModule/PerceptionConfigEdit\", event = \"Change\", route = \"workbench.module.perception.config.edit\" },\r\n  { id = \"WorkbenchModule/PerceptionConfigCommit\", event = \"Submit\", route = \"workbench.module.perception.config.commit\" },\r\n]\r\n\r\n[nodes.perception_los_property_row]\r\ncomponent = \"WorkbenchPropertyEditorRow\"\r\ncontrol_id = \"WorkbenchPerceptionLosPropertyRow\"\r\nprops = { text = \"Line of Sight\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\nchildren = [{ node = \"perception_los_field\", slot = { name = \"value\" } }]\r\n\r\n[nodes.perception_los_field]\r\ncomponent = \"WorkbenchField\"\r\ncontrol_id = \"WorkbenchPerceptionLosField\"\r\nclasses = [\"workbench-field\", \"workbench-component-field\"]\r\nprops = { value = \"On\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\r\nevents = [\r\n  { id = \"WorkbenchModule/PerceptionLosEdit\", event = \"Change\", route = \"workbench.module.perception.los.edit\" },\r\n  { id = \"WorkbenchModule/PerceptionLosCommit\", event = \"Submit\", route = \"workbench.module.perception.los.commit\" },\r\n]\r\n\r\n[nodes.perception_team_property_row]\r\ncomponent = \"WorkbenchPropertyEditorRow\"\r\ncontrol_id = \"WorkbenchPerceptionTeamPropertyRow\"\r\nprops = { text = \"Team Filter\" }\r\nlayout = { width = { stretch = \"Stretch