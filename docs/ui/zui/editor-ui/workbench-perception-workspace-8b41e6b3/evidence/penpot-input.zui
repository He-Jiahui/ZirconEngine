styles = []

[components.WorkbenchPerceptionWorkspace]
root = "perception_workspace"
default_classes = [ "workbench-module-body" ]

[nodes.perception_workspace]
component = "Overlay"
control_id = "WorkbenchModulePerceptionWorkspace"
