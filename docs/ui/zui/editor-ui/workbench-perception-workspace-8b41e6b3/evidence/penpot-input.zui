[nodes.perception_workspace.layout.container]
kind = "Overlay"

[nodes.perception_workspace.layout.width]
stretch = "Stretch"

[nodes.perception_workspace.layout.height]
stretch = "Stretch"

[[nodes.perception_workspace.children]]
