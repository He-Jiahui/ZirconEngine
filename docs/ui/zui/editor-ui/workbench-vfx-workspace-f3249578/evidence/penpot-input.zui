[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/core/rendering/workbench_vfx_workspace.zui"
version = 2
display_name = "Workbench VFX Workspace"

[imports]
widgets = []
styles = []

[components.WorkbenchVfxWorkspace]
root = "vfx_workspace"
default_classes = [ "workbench-module-body" ]

[nodes.vfx_workspace]
component = "Overlay"
control_id = "WorkbenchModuleVfxWorkspace"
classes = [ "workbench-module-body" ]

[nodes.vfx_workspace.props]
visibility = "visible"

[nodes.vfx_workspace.layout]
clip = true

[nodes.vfx_workspace.layout.container]
kind = "Overlay"

[nodes.vfx_workspace.layout.width]
stretch = "Stretch"

[nodes.vfx_workspace.layout.height]
stretch = "Stretch"

[[nodes.vfx_workspace.children]]
node = "vfx_workspace_main"

[[nodes.vfx_workspace.children]]
