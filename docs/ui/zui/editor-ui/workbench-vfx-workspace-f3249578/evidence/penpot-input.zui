penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/core/rendering/workbench_vfx_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench VFX Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n]\nstyles = []\n\n[components.WorkbenchVfxWorkspace]\nroot = \"vfx_workspace\"\ndefault_classes = [\"workbench-module-body\"]\n\n[nodes.vfx_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchModuleVfxWorkspace\"\nclasses = [\"workbench-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"vfx_workspace_main\" },\n  { node = \"vfx_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.vfx_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"vfx_rail_gap\" }, { node = \"vfx_left\" }, { node = \"vfx_center\" }, { node = \"vfx_right_reserve\" }]\n\n[nodes.vfx_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.vfx_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchVfxRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.vfx_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchVfxLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"vfx_title\" }, { node = \"vfx_left_content\" }]\n\n[nodes.vfx_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchVfxLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"vfx_emitter_row\" }, { node = \"vfx_curve_row\" }]\n\n[nodes.vfx_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchVfxTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"VFX\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.vfx_emitter_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchVfxEmitterRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Emitter: Sparks\", value = \"sparks\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/VfxEmitterRow\", event = \"Click\", route = \"workbench.module.vfx.emitter\" }]\n\n[nodes.vfx_curve_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchVfxCurveRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Curve: Spawn Rate\", value = \"spawn_rate\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/VfxCurveRow\", event = \"Click\", route = \"workbench.module.vfx.curve\" }]\n\n[nodes.vfx_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchVfxCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"vfx_center_header\" }, { node = \"vfx_canvas\" }, { node = \"vfx_output\" }]\n\n[nodes.vfx_center_header]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchVfxCenterHeader\"\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Never\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { min = 38.0, preferred = 38.0, max = 40.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"vfx_center_title\" }, { node = \"vfx_header_fill\" }, { node = \"vfx_particle_library_button\" }, { node = \"vfx_simulate_button\" }]\n\n[nodes.vfx_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchVfxCenterTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"P_Bolt_01\" }\nlayout = { width = { min = 180.0, preferred = 180.0, max = 240.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.vfx_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchVfxHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.vfx_particle_library_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchVfxParticleLibraryButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Particle Library\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 126, preferred = 126, max = 136, stretch = \"Fixed\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/ParticleLibraryOpen\", event = \"Click\", route = \"workbench.extension.particle_library.open\" }]\n\n[nodes.vfx_simulate_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchVfxSimulateButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Simulate\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 90, preferred = 90, max = 100, stretch = \"Fixed\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/VfxSimulate\", event = \"Click\", route = \"workbench.module.vfx.simulate\" }]\n\n[nodes.vfx_canvas]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchVfxCanvas\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.regular\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"vfx_spawn_row\" }, { node = \"vfx_lifetime_row\" }, { node = \"vfx_material_row\" }]\n\n[nodes.vfx_spawn_row]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchVfxSpawnRow\"\nclasses = [\"workbench-property-row\"]\nprops = { text = \"Spawn Rate\", value = \"280 / sec\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/VfxSpawnRow\", event = \"Click\", route = \"workbench.module.vfx.spawn\" }]\n\n[nodes.vfx_lifetime_row]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchVfxLifetimeRow\"\nclasses = [\"workbench-property-row\"]\nprops = { text = \"Lifetime\", value = \"0.65 s\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/VfxLifetimeRow\", event = \"Click\", route = \"workbench.module.vfx.lifetime\" }]\n\n[nodes.vfx_material_row]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchVfxMaterialRow\"\nclasses = [\"workbench-property-row\"]\nprops = { text = \"Material\", value = \"M_Bolt_01\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/VfxMaterialRow\", event = \"Click\", route = \"workbench.module.vfx.material\" }]\n\n[nodes.vfx_output]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchVfxOutputRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Compile Output: 60 fps preview, no errors\", value = \"vfx_output\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.vfx_right]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchVfxRightPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"vfx_details_title\" }, { node = \"vfx_right_content\" }]\n\n[nodes.vfx_right_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchVfxRightContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"vfx_system_property_row\" }, { node = \"vfx_bounds_property_row\" }, { node = \"vfx_sort_property_row\" }]\n\n[nodes.vfx_details_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchVfxDetailsTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Details\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.vfx_system_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchVfxSystemPropertyRow\"\nprops = { text = \"System\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"vfx_system_field\", slot = { name = \"value\" } }]\n\n[nodes.vfx_system_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchVfxSystemField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"P_Bolt_01\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/VfxSystemEdit\", event = \"Change\", route = \"workbench.module.vfx.system.edit\" },\n  { id = \"WorkbenchModule/VfxSystemCommit\", event = \"Submit\", route = \"workbench.module.vfx.system.commit\" },\n]\n\n[nodes.vfx_bounds_property_row]\ncomponent =