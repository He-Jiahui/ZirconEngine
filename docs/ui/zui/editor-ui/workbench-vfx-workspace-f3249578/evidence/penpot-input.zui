z_order = 20

[nodes.vfx_workspace.children.slot.layout.alignment]
horizontal = "End"
vertical = "Fill"

[nodes.vfx_workspace_main]
component = "HorizontalGroup"
classes = [ "workbench-module-layout-main" ]

[nodes.vfx_workspace_main.layout]
clip = true

[nodes.vfx_workspace_main.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.medium"

[nodes.vfx_workspace_main.layout.width]
stretch = "Stretch"

[nodes.vfx_workspace_main.layout.height]
