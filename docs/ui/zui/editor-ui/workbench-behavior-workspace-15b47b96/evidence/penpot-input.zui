penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/core/ai/workbench_behavior_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Behavior Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n]\nstyles = []\n\n[components.WorkbenchBehaviorWorkspace]\nroot = \"behavior_workspace\"\ndefault_classes = [\"workbench-module-body\"]\n\n[nodes.behavior_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchModuleBehaviorWorkspace\"\nclasses = [\"workbench-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"behavior_workspace_main\" },\n  { node = \"behavior_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.behavior_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"behavior_rail_gap\" }, { node = \"behavior_left\" }, { node = \"behavior_center\" }, { node = \"behavior_right_reserve\" }]\n\n[nodes.behavior_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.behavior_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchBehaviorRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.behavior_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchBehaviorLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"behavior_title\" }, { node = \"behavior_left_content\" }]\n\n[nodes.behavior_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchBehaviorLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"behavior_selector_row\" }, { node = \"behavior_attack_row\" }]\n\n[nodes.behavior_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchBehaviorTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Behavior Tree\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.behavior_selector_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchBehaviorSelectorRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Selector: Combat Root\", value = \"selector\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/BehaviorSelectorRow\", event = \"Click\", route = \"workbench.module.behavior.selector\" }]\n\n[nodes.behavior_attack_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchBehaviorAttackRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Task: Attack Target\", value = \"attack\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/BehaviorAttackRow\", event = \"Click\", route = \"workbench.module.behavior.attack\" }]\n\n[nodes.behavior_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchBehaviorCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"behavior_center_header\" }, { node = \"behavior_graph_canvas\" }, { node = \"behavior_output\" }]\n\n[nodes.behavior_center_header]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchBehaviorCenterHeader\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { min = 38.0, preferred = 38.0, max = 40.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"behavior_center_title\" }, { node = \"behavior_header_fill\" }, { node = \"behavior_validate_button\" }]\n\n[nodes.behavior_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchBehaviorCenterTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"BT_Enemy\" }\nlayout = { width = { min = 180.0, preferred = 180.0, max = 240.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.behavior_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchBehaviorHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.behavior_validate_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchBehaviorValidateButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Validate\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 86, preferred = 86, max = 96, stretch = \"Fixed\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/BehaviorValidate\", event = \"Click\", route = \"workbench.module.behavior.validate\" }]\n\n[nodes.behavior_graph_canvas]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchBehaviorGraphCanvas\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.regular\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"behavior_node_row_01\" }, { node = \"behavior_node_row_02\" }, { node = \"behavior_node_row_03\" }]\n\n[nodes.behavior_node_row_01]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchBehaviorNodeRow01\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Selector        Success      Running\", value = \"node_01\", options = [\"Selector\", \"Success\", \"Running\", \"root\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/BehaviorNodeSelector\", event = \"Click\", route = \"workbench.module.behavior.node.selector\" }]\n\n[nodes.behavior_node_row_02]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchBehaviorNodeRow02\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Sequence        Attack       Pending\", value = \"node_02\", options = [\"Sequence\", \"Attack\", \"Pending\", \"child\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/BehaviorNodeAttack\", event = \"Click\", route = \"workbench.module.behavior.node.attack\" }]\n\n[nodes.behavior_node_row_03]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchBehaviorNodeRow03\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Decorator       Cooldown     0.8 s\", value = \"node_03\", options = [\"Decorator\", \"Cooldown\", \"0.8 s\", \"guard\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/BehaviorNodeCooldown\", event = \"Click\", route = \"workbench.module.behavior.node.cooldown\" }]\n\n[nodes.behavior_output]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchBehaviorOutputRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Runtime Trace: branch changed to Attack\", value = \"behavior_output\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.behavior_right]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchBehaviorRightPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"behavior_details_title\" }, { node = \"behavior_right_content\" }]\n\n[nodes.behavior_right_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchBehaviorRightContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"behavior_blackboard_property_row\" }, { node = \"behavior_ai_property_row\" }, { node = \"behavior_state_property_row\" }]\n\n[nodes.behavior_details_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchBehaviorDetailsTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Details\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.behavior_blackboard_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchBehaviorBlackboardPropertyRow\"\nprops = { text = \"Blackboard\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"behavior_blackboard_field\", slot = { name = \"value\" } }]\n\n[nodes.behavior_blackboard_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchBehaviorBlackboardField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"BB_Enemy\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/BehaviorBlackboardEdit\", event = \"Change\", route = \"workbench.module.behavior.blackboard.edit\" },\n  { id = \"WorkbenchModule/BehaviorBlackboardCommit\", event = \"Submit\", route = \"workbench.module.behavior.blackboard.commit\" },\n]\n\n[nodes.behavior_ai_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchBehaviorAiPropertyRow\"\nprops = { text = \"AI Controller\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"behavior_ai_field\", slot = { name = \"value\" } }]\n\n[nodes.behavior_ai_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchBehaviorAiField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"AIController_Enemy\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/BehaviorAiEdit\", event = \"Change\", route = \"workbench.module.behavior.ai.edit\" },\n  { id = \"WorkbenchModule/BehaviorAiCommit\", event = \"Submit\", route = \"workbench.module.behavior.ai.commit\" },\n]\n\n[nodes.behavior_state_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchBehaviorStatePropertyRow\"\nprops = { text = \"Preview State\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"behavior_state_field\", slot = { name = \"value\" } }]\n\n[nodes.behavior_state_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchBehaviorStateField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"Running\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/BehaviorStateEdit\", event = \"Change\", route = \"workbench.module.behavior.state.edit\"