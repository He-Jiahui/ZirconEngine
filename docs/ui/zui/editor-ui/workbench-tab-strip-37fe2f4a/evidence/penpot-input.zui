penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/primitives/inputs/workbench_tab_strip.zui\"\nversion = 2\ndisplay_name = \"Workbench Tab Strip\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.WorkbenchTabStrip]\nroot = \"root\"\ndefault_classes = [\"workbench-tab-strip\", \"workbench-primitive\"]\nslots = { default = { multiple = true, kind = \"linear\", accepts = [\"WorkbenchTab\"] } }\n\n[nodes.root]\ncomponent = \"Tabs\"\ncontrol_id = \"WorkbenchTabStripRoot\"\nclasses = [\"workbench-tabs\", \"workbench-tab-strip\"]\nprops = { value = \"overview\", selected_index = 0.0, options = [\"overview\", \"details\", \"stats\"], orientation = \"horizontal\", selection_state = \"single\", selection_follows_focus = true, layout_gap = 0.0, layout_min_height = \"$editor.control.height.dense\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nchildren = [{ node = \"default_slot\" }]\n\n[nodes.default_slot]\ncomponent = \"Slot\"\nprops = { name = \"default\" }\n"

