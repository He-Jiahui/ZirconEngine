[[penpot_review_host.stylesheets]]
id = "workbench-tab-states"

[[penpot_review_host.stylesheets.rules]]
selector = ".workbench-tab:selected, .workbench-tab:checked"

[penpot_review_host.stylesheets.rules.set.self]
background_color = "$editor.surface.selected"

[[penpot_review_host.stylesheets.rules]]
selector = ".workbench-tab:focus, .workbench-tab:focus-visible"

[penpot_review_host.stylesheets.rules.set.self]
background_color = "$editor.accent.soft"
hover_background_color = "$editor.accent.soft"
foreground_color = "$editor.text.primary"

[penpot_review_host.penpot_original_imports]
widgets = [ "res://ui/editor/components/workbench/primitives/inputs/workbench_tab_strip.zui", "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui" ]
styles = []
