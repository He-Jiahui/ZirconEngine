penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
stylesheets = []
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui" ]
penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/showcase/showcase_state_panel.zui\"\nversion = 2\ndisplay_name = \"Showcase State Panel\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.ShowcaseStatePanel]\nroot = \"state_panel_root\"\ndefault_classes = [\"showcase-panel\"]\n\n[nodes.state_title]\ncomponent = \"Label\"\ncontrol_id = \"ComponentShowcaseStateTitle\"\nclasses = [\"showcase-title\"]\nprops = { text = \"Runtime State and Events\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.selected_category]\ncomponent = \"PropertyRow\"\ncontrol_id = \"ComponentShowcaseSelectedCategory\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Category\", value = \"All\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.last_control]\ncomponent = \"PropertyRow\"\ncontrol_id = \"ComponentShowcaseLastControl\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Last Control\", value = \"No component event yet\" }\n# Status values remain readable at the 240px compact showcase width. The two-line\n# content-driven row is the narrow translation of the ReactBits app-shell detail\n# panel; it avoids clipping the retained event state while preserving 14px body text.\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 48.0, max = 48.0, stretch = \"Fixed\" } }\n\n[nodes.last_action]\ncomponent = \"PropertyRow\"\ncontrol_id = \"ComponentShowcaseLastAction\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Last Action\", value = \"Waiting for Runtime UI event\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 48.0, max = 48.0, stretch = \"Fixed\" } }\n\n[nodes.current_value]\ncomponent = \"PropertyRow\"\ncontrol_id = \"ComponentShowcaseCurrentValue\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Current Value\", value = \"Select or edit a control\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 48.0, max = 48.0, stretch = \"Fixed\" } }\n\n[nodes.validation]\ncomponent = \"PropertyRow\"\ncontrol_id = \"ComponentShowcaseValidation\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Validation\", value = \"normal\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.drag_payload]\ncomponent = \"PropertyRow\"\ncontrol_id = \"ComponentShowcaseDragPayload\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Drag / Drop\", value = \"No retained drop payload\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 48.0, max = 48.0, stretch = \"Fixed\" } }\n\n[nodes.event_log]\ncomponent = \"Label\"\ncontrol_id = \"ComponentShowcaseEventLog\"\nclasses = [\"showcase-muted\"]\nprops = { text = \"Registered events: NumberField drag/commit, popup open/close, Dropdown change, Foldout toggle, Array/Map change, reference drop\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 64.0, preferred = 64.0, max = 64.0, stretch = \"Fixed\" } }\n\n[nodes.state_panel_root]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ComponentShowcaseStatePanel\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" } }\nchildren = [\n  { node = \"state_title\" },\n  { node = \"selected_category\" },\n  { node = \"last_control\" },\n  { node = \"last_action\" },\n  { node = \"current_value\" },\n  { node = \"validation\" },\n  { node = \"drag_payload\" },\n  { node = \"event_log\" },\n]\n"

[asset]
kind = "component"
id = "res://ui/editor/components/showcase/showcase_state_panel.zui"
version = 2
display_name = "Showcase State Panel"

[imports]
