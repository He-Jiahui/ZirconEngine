e = \"prefab_editor_mesh_component_row\" }, { node = \"prefab_editor_loot_socket_row\" }]\n\n[nodes.prefab_editor_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionPrefabEditorTitle\"\nprops = { text = \"Prefab Editor\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.prefab_editor_root_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionPrefabEditorPrefabRootRow\"\nclasses = [\"workbench-list-row\", \"workbench-row-selected\"]\nprops = { text = \"PF_Chest\", icon = \"cube\", selected = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PrefabEditorPrefabRootRow\", event = \"Click\", route = \"workbench.extension.prefab_editor.hierarchy.root\" }]\n\n[nodes.prefab_editor_mesh_component_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionPrefabEditorMeshComponentRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Mesh_Chest\", icon = \"box\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PrefabEditorMeshComponentRow\", event = \"Click\", route = \"workbench.extension.prefab_editor.hierarchy.mesh\" }]\n\n[nodes.prefab_editor_loot_socket_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionPrefabEditorLootSocketRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"LootSocket\", icon = \"target\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PrefabEditorLootSocketRow\", event = \"Click\", route = \"workbench.extension.prefab_editor.hierarchy.socket\" }]\n\n[nodes.prefab_editor_center]\ncompone