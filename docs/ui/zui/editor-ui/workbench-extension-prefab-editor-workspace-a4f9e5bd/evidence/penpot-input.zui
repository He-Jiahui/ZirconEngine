max = 96, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PrefabEditorApply\", event = \"Click\", route = \"workbench.extension.prefab_editor.apply\" }]\n\n[nodes.prefab_editor_validate_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionPrefabEditorValidateButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Validate\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 86, preferred = 86, max = 96, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PrefabEditorValidate\", event = \"Click\", route = \"workbench.extension.prefab_editor.validate\" }]\n\n[nodes.prefab_editor_composition_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionPrefabEditorCompositionTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"prefab_editor_mesh_table_row\" }, { node = \"prefab_editor_loot_socket_table_row\" }, { node = \"prefab_editor_light_table_row\" }, { node = \"prefab_editor_override_table_row\" }]\n\n[nodes.prefab_editor_mesh_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPrefabEditorMeshTableRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Mesh_Chest\", value_text = \"Component   Static Mesh   Selected\", selected = true, options = [\"Mesh_Chest\",\"Component\",\"Static Mesh\",\"Selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" }