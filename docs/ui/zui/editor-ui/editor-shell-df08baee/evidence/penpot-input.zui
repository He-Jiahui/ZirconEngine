[[stylesheets.rules]]
selector = ".unreal-viewport"

[stylesheets.rules.set.self]
background_color = "$unreal_recessed"
foreground_color = "$unreal_foreground"
border_width = 0
corner_radius = 0

[[stylesheets.rules]]
selector = ".unreal-viewport-toolbar"

[stylesheets.rules.set.self]
background_color = "$unreal_background"
foreground_color = "$unreal_foreground"
font_family = "$unreal_font_family"
font_size = "$unreal_font_size"
border_width = 0
corner_radius = 0

[[stylesheets.rules]]
selector = ".unreal-viewport-overlay-toolbar"

[stylesheets.rules.set.self]
background_color = "$unreal_background"
foreground_color = "$unreal_foreground"
font_family = "$unreal_font_family"
font_size = "$unreal_font_size"
font_weight = "$unreal_font_weight"
line_height_ratio = 1.2
border_width = 0
corner_radius = 0

[[stylesheets.rules]]
selector = ".unreal-status-bar"

[stylesheets.rules.set.self]
background_color = "$unreal_panel"
foreground_color = "$unreal_foreground"
font_family = "$unreal_font_family"
font_size = "$unreal_font_small_size"
font_weight = "$unreal_font_weight"
line_height_ratio = 1.2
border_width = 0
corner_radius = 0

[[stylesheets.rules]]
selector = ".unreal-content-drawer"

[stylesheets.rules.set.self]
background_color = "$unreal_panel"
foreground_color = "$unreal_foreground"
border_color = "$unreal_input_outline"
border_width = 1
corner_radius = 0

[[stylesheets.rules]]
selector = ".unreal-popup-menu"

[stylesheets.rules.set.self]
background_color = "$unreal_dropdown"
foreground_color = "$unreal_foreground"
border_color = "$unreal_dropdown_outline"
border_width = 1
corner_radius = 4
font_family = "$unreal_font_family"
font_size = "$unreal_font_size"

[penpot_original_imports]
widgets = []
styles = [ "res://ui/editor/unreal/starship.zui" ]

[penpot_i18n_tables.editor]
locale = "en"

