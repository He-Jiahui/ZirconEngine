penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/editor/unreal/starship.zui", "zircon_editor/assets/i18n/en.toml" ]
penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/unreal/editor_shell.zui\"\nversion = 2\ndisplay_name = \"Unreal Editor Shell\"\n\n[root]\nnode = \"host\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/editor/unreal/starship.zui\"]\n\n[nodes.host]\ncomponent = \"UiHostWindow\"\ncontrol_id = \"UiHostWindowRoot\"\npixel_snapping = \"disabled\"\nclasses = [\"unreal-editor-shell\"]\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"UiHostWindow/ActivateMainPage\", event = \"Change\", route = \"workbench.dock.activate_main_page\" }]\nchildren = [{ node = \"document_host\" }]\n\n[nodes.document_host]\ncomponent = \"DocumentHost\"\ncontrol_id = \"DocumentHostRoot\"\nclasses = [\"unreal-editor-shell\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"pane_surface\" }]\n\n[nodes.pane_surface]\ncomponent = \"PaneSurface\"\ncontrol_id = \"PaneSurfaceRoot\"\nclasses = [\"unreal-editor-shell\"]\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n"

[asset]
kind = "view"
id = "res://ui/editor/unreal/editor_shell.zui"
version = 2
display_name = "Unreal Editor Shell"

[root]
node = "host"

[imports]
widgets = []
styles = []

[nodes.host]
component = "UiHostWindow"
control_id = "UiHostWindowRoot"
pixel_snapping = "disabled"
classes = [ "unreal-editor-shell" ]
penpot_review_source_path = "zircon_editor/assets/ui/editor/unreal/editor_shell.zui"
penpot_review_source_node_id = "host"
penpot_review_instance_path = "[]"

[nodes.host.layout]
clip = true

[nodes.host.layout.container]
kind = "Overlay"

[nodes.host.layout.width]
stretch = "Stretch"

[nodes.host.layout.height]
stretch = "Stretch"

[[nodes.host.events]]
id = "UiHostWindow/ActivateMainPage"
event = "Change"
route = "workbench.dock.activate_main_page"

[[nodes.host.children]]
node = "document_host"

[nodes.document_host]
component = "DocumentHost"
control_id = "DocumentHostRoot"
classes = [ "unreal-editor-shell" ]
penpot_review_source_path = "zircon_editor/assets/ui/editor/unreal/editor_shell.zui"
penpot_review_source_node_id = "document_host"
penpot_review_instance_path = "[]"

[nodes.document_host.layout]
clip = true

[nodes.document_host.layout.container]
kind = "VerticalBox"
gap = 0

[nodes.document_host.layout.width]
stretch = "Stretch"

[nodes.document_host.layout.height]
stretch = "Stretch"

[[nodes.document_host.children]]
node = "pane_surface"

[nodes.pane_surface]
component = "PaneSurface"
control_id = "PaneSurfaceRoot"
classes = [ "unreal-editor-shell" ]
penpot_review_source_path = "zircon_editor/assets/ui/editor/unreal/editor_shell.zui"
penpot_review_source_node_id = "pane_surface"
penpot_review_instance_path = "[]"

[nodes.pane_surface.layout]
clip = true

[nodes.pane_surface.layout.width]
stretch = "Stretch"

[nodes.pane_surface.layout.height]
stretch = "Stretch"

