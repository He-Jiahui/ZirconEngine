ch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/LightingBakeShadowMapTableRow\", event = \"Click\", route = \"workbench.extension.lighting_bake.queue.shadow_map\" }]\n\n[nodes.lighting_bake_lightmap_uv_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionLightingBakeLightmapUvTableRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Lightmap UV\", value_text = \"87 assets   4 warnings   Selected\", selected = true, options = [\"Lightmap UV\",\"87 assets\",\"4 warnings\",\"Selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/LightingBakeLightmapUvTableRow\", event = \"Click\", route = \"workbench.extension.lighting_bake.queue.lightmap_uv\" }]\n\n[nodes.lighting_bake_probe_grid_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionLightingBakeProbeGridTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Probe Grid\", value_text = \"12 volumes   Adaptive   Ready\", options = [\"Probe Grid\",\"12 volumes\",\"Adaptive\",\"Ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/LightingBakeProbeGridTableRow\", event = \"Click\", route = \"workbench.extension.lighting_bake.queue.probe_grid\" }]\n\n[nodes.lighting_bake_bleed_warning_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionLightingBakeBleedWarningTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Bleed Warning\", value_text = \"Interior_Lab   6 texels   Warning\", options = [\"Bleed Warning\",\"Interior_Lab\",\"6 texels\",\"Warning\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/LightingBakeBleedWarningTableRow\", eve