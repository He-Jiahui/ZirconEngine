xt = \"Validate\", button_variant = \"outlined\", button_color = \"secondary\" }\r\nlayout = { width = { min = 86, preferred = 86, max = 96, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/DataTableValidate\", event = \"Click\", route = \"workbench.extension.data_table.validate\" }]\r\n\r\n[nodes.data_table_save_button]\r\ncomponent = \"WorkbenchButton\"\r\ncontrol_id = \"WorkbenchExtensionDataTableSaveButton\"\r\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\r\nprops = { text = \"Save Table\", button_variant = \"filled\", button_color = \"accent\" }\r\nlayout = { width = { min = 96, preferred = 96, max = 110, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/DataTableSave\", event = \"Click\", route = \"workbench.extension.data_table.save\" }]\r\n\r\n[nodes.data_table_rows]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchExtensionDataTableRows\"\r\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"data_table_potion_row\" }, { node = \"data_table_sword_row\" }, { node = \"data_table_armor_row\" }, { node = \"data_table_debug_row\" }]\r\n\r\n[nodes.data_table_potion_row]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchExtensionDataTablePotionRow\"\r\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\r\nprops = { text = \"Potion_Health\", value_text = \"Consumable   +50 HP   Selected\", options = [\"Potion_Health\",\"Consumable\",\"+50 HP\",\"Selected\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, pre