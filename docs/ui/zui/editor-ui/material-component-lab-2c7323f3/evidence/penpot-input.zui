[asset]
kind = "view"
id = "res://ui/editor/material_component_lab.zui"
version = 2
display_name = "Material Component Lab"

[root]
node = "material_lab_root"

[imports]
widgets = []
styles = []

[[stylesheets]]
id = "editor_material"

[[stylesheets.rules]]
selector = ".showcase-shell"

[stylesheets.rules.set.self.background]
color = "$field_bg"

[[stylesheets.rules]]
selector = ".showcase-panel"

[stylesheets.rules.set.self.background]
color = "$panel_bg"

[stylesheets.rules.set.self.border]
color = "$border"
width = "$material_border_width"
radius = "$material_radius_surface"

[[stylesheets.rules]]
selector = ".showcase-field"

[stylesheets.rules.set.self.background]
color = "$panel_bg_soft"

[stylesheets.rules.set.self.border]
color = "$border"
width = "$material_border_width"
radius = "$material_radius_small"

[[stylesheets.rules]]
selector = ".showcase-title"

[stylesheets.rules.set.self.foreground]
color = "$text"

[stylesheets.rules.set.self.font]
size = "$material_font_size_title"

[[stylesheets.rules]]
selector = ".showcase-muted"

[stylesheets.rules.set.self.foreground]
color = "$muted"

[stylesheets.rules.set.self.font]
size = "$material_font_size_meta"

[[stylesheets.rules]]
selector = ".material-state-layer"

[stylesheets.rules.set.self.background]
color = "$material_surface_inset"

[stylesheets.rules.set.self.border]
color = "$material_border"
width = "$material_border_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-control"

[stylesheets.rules.set.self.background]
color = "$material_surface"

[stylesheets.rules.set.self.foreground]
color = "$material_text"

[stylesheets.rules.set.self.border]
color = "$material_border"
width = "$material_border_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-control:hover"

[stylesheets.rules.set.self.background]
color = "$material_surface_hover"

[stylesheets.rules.set.self.border]
color = "$material_accent"
width = "$material_border_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-control:pressed"

[stylesheets.rules.set.self.background]
color = "$material_surface_pressed"

[stylesheets.rules.set.self.border]
color = "$material_focus_ring"
width = "$material_focus_ring_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-control:focus"

[stylesheets.rules.set.self.border]
color = "$material_focus_ring"
width = "$material_focus_ring_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-control:selected"

[stylesheets.rules.set.self.background]
color = "$material_surface_selected"

[stylesheets.rules.set.self.border]
color = "$material_focus_ring"
width = "$material_focus_ring_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-control:disabled"

[stylesheets.rules.set.self]
opacity = "$material_disabled_opacity"

[stylesheets.rules.set.self.background]
color = "$material_surface_disabled"

[stylesheets.rules.set.self.foreground]
color = "$material_text_disabled"

[stylesheets.rules.set.self.border]
color = "$material_outline_variant"
width = "$material_border_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-surface-success"

[stylesheets.rules.set.self.background]
color = "$material_success_container"

[stylesheets.rules.set.self.foreground]
color = "$material_success"

[stylesheets.rules.set.self.border]
color = "$material_success"
width = "$material_border_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-surface-info"

[stylesheets.rules.set.self.background]
color = "$material_info_container"

[stylesheets.rules.set.self.foreground]
color = "$material_info"

[stylesheets.rules.set.self.border]
color = "$material_info"
width = "$material_border_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-surface-warning"

[stylesheets.rules.set.self.background]
color = "$material_warning_container"

[stylesheets.rules.set.self.foreground]
color = "$material_warning"

[stylesheets.rules.set.self.border]
color = "$material_warning"
width = "$material_border_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-surface-error"

[stylesheets.rules.set.self.background]
color = "$material_error_container"

[stylesheets.rules.set.self.foreground]
color = "$material_error"

[stylesheets.rules.set.self.border]
color = "$material_error"
width = "$material_border_width"
radius = "$material_radius_control"

[[stylesheets.rules]]
selector = ".material-button"

[stylesheets.rules.set.self]
button_size = "medium"

[stylesheets.rules.set.self.background]
color = "$material_surface_hover"

[[stylesheets.rules]]
selector = ".material-button:hover"

[stylesheets.rules.set.self]
button_interaction_state = "hover"

[stylesheets.rules.set.self.background]
color = "$material_surface_container_high"

[[stylesheets.rules]]
selector = ".material-button:pressed"

[stylesheets.rules.set.self]
button_interaction_state = "pressed"

[stylesheets.rules.set.self.background]
color = "$material_surface_pressed"

[[stylesheets.rules]]
selector = ".material-button-primary"

[stylesheets.rules.set.self]
button_variant = "contained"
