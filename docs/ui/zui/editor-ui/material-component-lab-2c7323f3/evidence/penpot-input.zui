[nodes.appbar]
component = "HorizontalBox"
classes = [ "material-lab-card" ]

[nodes.appbar.layout.width]
stretch = "Stretch"

[nodes.appbar.layout.height]
min = 56
preferred = 56
max = 56
stretch = "Fixed"

[nodes.appbar.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.medium"

[[nodes.appbar.children]]
node = "appbar_title"

[[nodes.appbar.children]]
node = "appbar_scope"

[[nodes.appbar.children]]
node = "appbar_count"

[[nodes.appbar.children]]
node = "appbar_status"

[[nodes.appbar.children]]
node = "appbar_capture"

[nodes.appbar_title]
component = "Label"
classes = [ "material-lab-appbar-title" ]

[nodes.appbar_title.props]
text = "Material Component Lab"
text_tone = "primary"
font_size = "$editor.typography.title.size"
font_weight = "$editor.typography.emphasis.weight"

[nodes.appbar_title.layout.width]
stretch = "Stretch"

[nodes.appbar_title.layout.height]
min = 32
preferred = 32
max = 32
stretch = "Fixed"

[nodes.appbar_scope]
component = "Label"
classes = [ "material-lab-appbar-chip", "material-lab-appbar-primary" ]

[nodes.appbar_scope.props]
text = "MUI + MUI X"
text_tone = "primary"
surface_variant = "elevated"
selected = true
focused = true
corner_radius = "$editor.control.radius.pill"
border_width = 1

[nodes.appbar_scope.layout.width]
min = 104
preferred = 104
max = 104
stretch = "Fixed"

[nodes.appbar_scope.layout.height]
min = 28
preferred = 28
max = 28
stretch = "Fixed"

[nodes.appbar_count]
