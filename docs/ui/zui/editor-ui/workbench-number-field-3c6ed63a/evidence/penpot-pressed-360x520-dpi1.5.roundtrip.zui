[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_number_field.zui"
version = 2
display_name = "Workbench Number Field"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchNumberField]
root = "root"
default_classes = ["workbench-number-field", "workbench-primitive"]

[nodes.root]
component = "NumberField"
control_id = "WorkbenchNumberFieldRoot"
classes = ["workbench-field", "workbench-number-field"]
props = { value = 42.0, value_text = "42", placeholder = "0", min = 0.0, max = 100.0, step = 1.0, large_step = 10.0, precision = 0.0, validation_level = "normal", editable_text = true, layout_stepper = true, background_color = "$editor.surface.recessed", hover_background_color = "$editor.surface.hover", pressed_background_color = "$editor.surface.3", focused_background_color = "$editor.surface.recessed", disabled_background_color = "$editor.surface.disabled", border_color = "$editor.separator.soft", hover_border_color = "$editor.border", focus_border_color = "$editor.focus.ring", disabled_border_color = "$editor.border.disabled", foreground_color = "$editor.text.primary", placeholder_color = "$editor.text.secondary", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_min_height = "$editor.control.height.dense", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
