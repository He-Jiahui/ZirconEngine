penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/theme/editor_workbench_strict.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_button.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_field.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_tab.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/data/workbench_table_row.zui", "zircon_editor/assets/icons/zircon_editor_shell/controls/search.svg", "zircon_editor/assets/icons/ionicons/close-outline.svg", "zircon_editor/assets/icons/zircon_editor_shell/controls/field-stepper.svg" ]
penpot_original_source = "stylesheets = []\n\n[asset]\nkind = \"view\"\nid = \"res://ui/editor/asset_browser.zui\"\nversion = 2\ndisplay_name = \"Asset Browser\"\n\n[imports]\nwidgets = [\"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\", \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\", \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\", \"res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton\", \"res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput\", \"res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab\", \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\"]\nstyles = [\"res://ui/theme/editor_workbench_strict.zui\"]\n\n[root]\nnode = \"asset_browser_root\"\n\n[nodes.toolbar_title_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserTitleText\"\nprops = { text = \"Asset Browser\", font_weight = \"$editor.typography.emphasis.weight\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_locate_button]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"LocateSelectedAsset\"\nprops = { label = \"Locate selected asset\", icon = \"editor_pages/asset_browser/navigation/search.svg\", icon_placement = \"icon_only\", dispatch_kind = \"asset:browser\" }\nlayout = { width = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetBrowserLocateSelected\", event = \"Click\", route = \"workbench.asset_browser.locate_selected\" }]\n\n[nodes.toolbar_title_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserToolbarTitleRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"toolbar_title_text\" }]\n\n[nodes.toolbar_subtitle_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserSubtitleText\"\nprops = { text = \"Project/assets\", text_tone = \"muted\", font_size = \"$editor.typography.caption.size\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_subtitle_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserToolbarSubtitleRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"toolbar_subtitle_text\" }]\n\n[nodes.toolbar_search_field]\ncomponent = \"WorkbenchSearchInput\"\ncontrol_id = \"SearchEdited\"\nprops = { placeholder = \"Search\", dispatch_kind = \"asset:browser\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetBrowserSearchEdited\", event = \"Change\", route = \"workbench.asset_browser.search.edit\" }]\n\n[nodes.toolbar_search_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserToolbarSearchRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nchildren = [{ node = \"toolbar_search_field\" }]\n\n[nodes.toolbar_kind_filter_dropdown]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"AssetBrowserKindFilterDropdown\"\nprops = { value = \"All\", value_text = \"All Types\", options = [\"All|label=All Types\", \"Texture|label=Textures\", \"Material|label=Materials\", \"Scene|label=Scenes\", \"Model|label=Models\", \"Mesh|label=Meshes\", \"Shader|label=Shaders\", \"PhysicsMaterial|label=Physics Materials\", \"AnimationSkeleton|label=Animation Skeletons\", \"AnimationClip|label=Animation Clips\", \"AnimationSequence|label=Animation Sequences\", \"AnimationGraph|label=Animation Graphs\", \"AnimationStateMachine|label=Animation State Machines\", \"UiLayout|label=UI Layouts\", \"UiWidget|label=UI Widgets\", \"UiStyle|label=UI Styles\"], dispatch_kind = \"asset:browser\" }\nlayout = { width = { min = 124.0, preferred = 168.0, max = 220.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetBrowserKindFilterChanged\", event = \"Change\", route = \"workbench.asset_browser.kind_filter.change\" }]\n\n[nodes.toolbar_kind_primary_spacer]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.toolbar_view_mode_list_button]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"AssetBrowserViewModeListButton\"\nprops = { label = \"List view\", icon = \"list-outline\", icon_placement = \"icon_only\", dispatch_kind = \"asset:browser\", action_id = \"workbench.asset.view_mode.set\", value = \"list\" }\nlayout = { width = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetBrowserViewModeList\", event = \"Change\", route = \"workbench.asset_browser.view_mode.list\" }]\n\n[nodes.toolbar_view_mode_thumb_button]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"AssetBrowserViewModeThumbButton\"\nprops = { label = \"Thumbnail view\", icon = \"grid-outline\", icon_placement = \"icon_only\", dispatch_kind = \"asset:browser\", action_id = \"workbench.asset.view_mode.set\", value = \"thumbnail\" }\nlayout = { width = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"Workbench/AssetBrowserViewModeThumbnail\", event = \"Change\", route = \"workbench.asset_browser.view_mode.thumbnail\" }]\n\n[nodes.toolbar_kind_primary_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserToolbarKindPrimaryRow\"\nprops = { surface_variant = \"inset\", radius = \"$editor.control.radius.small\", border_width = \"$editor.control.border_width\", z_index = -1 }\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" } }\nchildren = [{ node = \"toolbar_kind_filter_dropdown\" }, { node = \"toolbar_kind_primary_spacer\" }, { node = \"toolbar_view_mode_list_button\" }, { node = \"toolbar_view_mode_thumb_button\" }, { node = \"toolbar_locate_button\" }]\n\n[nodes.toolbar_panel]\ncomponent = \"VerticalBox\"\ncontrol_id = \"AssetBrowserToolbarPanel\"\nprops = { surface_variant = \"frame_only\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 112.0, preferred = 112.0, max = 112.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"toolbar_title_row\" }, { node = \"toolbar_subtitle_row\" }, { node = \"toolbar_search_row\" }, { node = \"toolbar_kind_primary_row\" }]\n\n[nodes.import_left_space]\ncomponent = \"Space\"\nlayout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.import_label]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserImportLabel\"\nprops = { text = \"Quick Import\", text_tone = \"muted\" }\nlayout = { width = { min = 86.0, preferred = 86.0, max = 86.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.import_path_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"AssetBrowserImportPathField\"\nprops = { placeholder = \"Drop or paste asset source path\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nevents = [{ id = \"AssetsView/MeshImportPathEdited\", event = \"Change\", route = \"workbench.asset.mesh_import.path.set\" }]\n\n[nodes.import_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ImportModel\"\nprops = { text = \"Import\", button_variant = \"filled\", button_color = \"accent\", dispatch_kind = \"asset:browser\" }\nlayout = { width = { min = 96, preferred = 96, max = 96, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"Workbench/AssetBrowserImportModel\", event = \"Click\", route = \"workbench.asset_browser.import_model\" }]\n\n[nodes.import_right_space]\ncomponent = \"Space\"\nlayout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.import_panel]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserImportPanel\"\nprops = { surface_variant = \"frame_only\" }\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"import_left_space\" }, { node = \"import_label\" }, { node = \"import_path_field\" }, { node = \"import_button\" }, { node = \"import_right_space\" }]\n\n[nodes.sources_title_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserSourcesTitleText\"\nprops = { text = \"Sources\", font_weight = \"$editor.typography.emphasis.weight\" }\nlayout = { position = { x = 12.0, y = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.sources_subtitle_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserSourcesSubtitleText\"\nprops = { text = \"Project/assets\", text_tone = \"muted\", overflow = \"elide\" }\nlayout = { position = { x = 12.0, y = 32.0 }, width = { stretch = \"Stretch\" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = \"Fixed\" } }\n\n[nodes.sources_header_panel]\ncomponent = \"Overlay\"\ncontrol_id = \"AssetBrowserSourcesHeaderPanel\"\nprops = { surface_variant = \"panel\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { min = 48.0, preferred = 48.0, max = 48.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"sources_title_text\" }, { node = \"sources_subtitle_text\" }]\n\n[nodes.sources_divider]\ncomponent = \"Space\"\ncontrol_id = \"AssetBrowserSourcesDivider\"\nprops = { surface_variant = \"divider\" }\nlayout = { position = { x = 0.0, y = 48.0 }, width = { stretch = \"Stretch\" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" } }\n\n[nodes.sources_row_icon]\ncomponent = \"Space\"\ncontrol_id = \"AssetBrowserSourcesRowIcon\"\nlayout = { position = { x = 8.0, y = 7.0 }, width = { min = 14.0, preferred = 14.0, max = 14.0, stretch = \"Fixed\" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = \"Fixed\" } }\n\n[nodes.sources_row_name_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserSourcesRowNameText\"\nprops = { text = \"Assets\", overflow = \"elide\" }\nlayout = { position = { x = 30.0, y = 6.0 }, width = { stretch = \"Stretch\" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = \"Fixed\" } }\n\n[nodes.sources_row_count_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserSourcesRowCountText\"\nprops = { text = \"0\", text_tone = \"muted\", text_align = \"right\" }\nlayout = { position = { x = 104.0, y = 5.0 }, width = { min = 20.0, preferred = 20.0, max = 20.0, stretch = \"Fixed\" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = \"Fixed\" } }\n\n[nodes.sources_row_panel]\ncomponent = \"Overlay\"\ncontrol_id = \"AssetBrowserSourcesRowPanel\"\nprops = { surface_variant = \"asset-tree-row\", radius = \"$editor.control.radius.small\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, position = { x = 8.0, y = 8.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"sources_row_icon\" }, { node = \"sources_row_name_text\" }, { node = \"sources_row_count_text\" }]\n\n[nodes.sources_scroll_body]\ncomponent = \"Overlay\"\ncontrol_id = \"AssetBrowserSourcesScrollBody\"\nprops = { surface_variant = \"scroll-body\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, position = { x = 0.0, y = 49.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"sources_row_panel\" }]\n\n[nodes.sources_panel]\ncomponent = \"Overlay\"\ncontrol_id = \"AssetBrowserSourcesPanel\"\nprops = { surface_variant = \"panel\", border_width = \"$editor.control.border_width\", responsive_min_tier = \"narrow\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { min = 188.0, preferred = 220.0, max = 250.0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"sources_header_panel\" }, { node = \"sources_divider\" }, { node = \"sources_scroll_body\" }]\n\n[nodes.content_header_title_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserContentHeaderTitleText\"\nprops = { text = \"Content Browser\", font_weight = \"$editor.typography.emphasis.weight\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.content_header_path_text]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserContentHeaderPathText\"\nprops = { text = \"All assets\", text_tone = \"muted\", text_align = \"right\", overflow = \"elide\", responsive_min_tier = \"wide\" }\nlayout = { width = { min = 92.0, preferred = 92.0, max = 92.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.content_header_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"AssetBrowserContentHeaderRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"content_header_title_text\" }, { node = \"content_header_path_text\" }]\n\n[nodes.content_asset_table_header]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAssetBrowserTableHeader\"\nprops = { text = \"Name Type Size Rev\", surface_variant = \"asset-table\", border_width = \"$editor.control.border_width\", options = [\"Name\",\"Type\",\"Size\",\"Revision\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\n\n[nodes.content_asset_row_01]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAssetBrowserAssetRow01\"\nprops = { text = \"Host UI 12K r42\", surface_variant = \"asset-table\", border_width = \"$editor.control.border_width\", options = [\"Host\",\"UI\",\"12 KB\",\"rev 42\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" } }\n\n[nodes.content_asset_row_02]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAssetBrowserAssetRow02\"\nprops = { text = \"Base Style 8K r41\", surface_variant = \"asset-table\", border_width = \"$editor.control.border_width\", options = [\"Base\",\"Style\",\"8 KB\",\"rev 41\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" } }\n\n[nodes.content_asset_row_03]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAssetBrowserAssetRow03\"\nprops = { text = \"Folder Tex 4K r40\", surface_variant = \"asset-table\", border_width = \"$editor.control.border_width\", options = [\"Folder\",\"Texture\",\"4 KB\",\"rev 40\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" } }\n\n[nodes.content_asset_row_04]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAssetBrowserAssetRow04\"\nprops = { text = \"A11y Widget 16K r39\", surface_variant = \"asset-table\", border_width = \"$editor.control.border_width\", options = [\"A11y\",\"Widget\",\"16 KB\",\"rev 39\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.compact\", preferred = \"$editor.control.height.compact\", max = \"$editor.control.height.compact\", stretch = \"Fixed\" } }\n\n[nodes.content_asset_table]\ncomponent = \"VerticalBox\"\ncontrol_id = \"AssetBrowserAssetTablePanel\"\nprops = { surface_variant = \"asset-table\", radius = \"$editor.control.radius.control\", border_width = \"$editor.control.border_width\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 0.0 }, width = { min = 360.0, preferred = 640.0, stretch = \"Stretch\" }, height = { min = 156.0, preferred = 156.0, max = 156.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"content_asset_table_header\" }, { node = \"content_asset_row_01\" }, { node = \"content_asset_row_02\" }, { node = \"content_asset_row_03\" }, { node = \"content_asset_row_04\" }]\n\n[nodes.content_asset_table_scroll]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"AssetBrowserAssetTableScroll\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { min = 156.0, preferred = 156.0, max = 156.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"content_asset_table\" }]\n\n[nodes.content_preview_card_visual]\ncomponent = \"Overlay\"\ncontrol_id = \"AssetBrowserContentPreviewVisual\"\nprops = { surface_variant = \"asset-placeholder-visual\", radius = \"$editor.control.radius.control\", border_width = 0.0 }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { min = 42.0, preferred = 42.0, max = 42.0, stretch = \"Fixed\" } }\n\n[nodes.content_preview_card_name]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserContentPreviewName\"\nprops = { text = \"workbench_page_chrome.zui\", font_weight = \"$editor.typography.strong.weight\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = \"Fixed\" } }\n\n[nodes.content_preview_card_meta]\ncomponent = \"Label\"\ncontrol_id = \"AssetBrowserContentPreviewMeta\"\nprops = { text = \"UiLayout • Ready\", text_tone = \"muted\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = \"Fixed\" } }\n\n[nodes.content_preview_card]\ncomponent = \"VerticalBox\"\ncontrol_id = \"AssetBrowserContentPreviewCard\"\nprops = { surface_variant = \"asset-placeholder\", radius = \"$editor.control.radius.control\", border_width = 0.0 }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 80.0, preferred = 80.0, max = 80.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"content_preview_card_visual\" }, { node = \"content_preview_card_name\" }, { node = \"content_preview_ca