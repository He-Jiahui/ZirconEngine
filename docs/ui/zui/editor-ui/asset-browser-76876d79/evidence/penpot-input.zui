[[stylesheets]]
id = "editor_workbench_strict"

[[stylesheets.rules]]
selector = ".editor-workbench"

[stylesheets.rules.set.self]
background_color = "$workbench_shell"
foreground_color = "$workbench_text"

[[stylesheets.rules]]
selector = ".workbench-shell-root"

[stylesheets.rules.set.self]
background_color = "$workbench_shell"
foreground_color = "$workbench_text"

[[stylesheets.rules]]
selector = ".workbench-window-root"

[stylesheets.rules.set.self]
background_color = "$workbench_shell"
foreground_color = "$workbench_text"

[[stylesheets.rules]]
selector = ".workbench-topbar"

[stylesheets.rules.set.self]
background_color = "$workbench_surface"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = 0
radius = 0

[[stylesheets.rules]]
selector = ".workbench-strip"

[stylesheets.rules.set.self]
background_color = "$workbench_surface"
border_color = "$workbench_border_soft"
border_width = "$editor.control.border_width"
radius = 0

[[stylesheets.rules]]
selector = ".workbench-divider"

[stylesheets.rules.set.self]
background_color = "$workbench_border"

[[stylesheets.rules]]
selector = ".workbench-toolbar-group"

[stylesheets.rules.set.self]
background_color = "$workbench_surface"
foreground_color = "$workbench_text"

[[stylesheets.rules]]
selector = ".workbench-panel-header"

[stylesheets.rules.set.self]
background_color = "$workbench_panel_raised"
foreground_color = "$workbench_text"
border_color = "$workbench_border_soft"
border_width = 0
radius = 0

[[stylesheets.rules]]
selector = ".workbench-icon-button"

[stylesheets.rules.set.self]
background_color = "$workbench_panel"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-toolbar-button"

[stylesheets.rules.set.self]
background_color = "$workbench_panel"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-icon-button:hovered"

[stylesheets.rules.set.self]
background_color = "$workbench_hover"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-toolbar-button:hovered"

[stylesheets.rules.set.self]
background_color = "$workbench_hover"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-rail"

[stylesheets.rules.set.self]
background_color = "$workbench_inset"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = 0
radius = 0

[[stylesheets.rules]]
selector = ".workbench-rail-button"

[stylesheets.rules.set.self]
background_color = "$workbench_inset"
foreground_color = "$workbench_text_muted"
border_color = "$workbench_border_soft"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-rail-button:hovered"

[stylesheets.rules.set.self]
background_color = "$workbench_hover"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-icon-button:selected"

[stylesheets.rules.set.self]
background_color = "$workbench_selected"
foreground_color = "$workbench_accent"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-rail-button:selected"

[stylesheets.rules.set.self]
background_color = "$workbench_selected"
foreground_color = "$workbench_accent"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-tab:hovered"

[stylesheets.rules.set.self]
background_color = "$workbench_hover"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".workbench-field:hovered"

[stylesheets.rules.set.self]
background_color = "$workbench_field_hot"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".workbench-component-property-row"

[stylesheets.rules.set.self]
background_color = "$workbench_panel"
foreground_color = "$workbench_text"
border_color = "$workbench_panel"
border_width = 0
radius = 0

[[stylesheets.rules]]
selector = ".workbench-component-property-row:hovered"

[stylesheets.rules.set.self]
background_color = "$workbench_hover"
foreground_color = "$workbench_text"
border_color = "$workbench_hover"
border_width = 0
radius = 0

[[stylesheets.rules]]
selector = ".workbench-component-field:hovered"

[stylesheets.rules.set.self]
background_color = "$workbench_field_hot"
foreground_color = "$workbench_text"
border_color = "$workbench_field_component_border"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".workbench-dropdown:hovered"

[stylesheets.rules.set.self]
background_color = "$workbench_field_hot"
