penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/extensions/rendering/workbench_extension_post_process_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Extension Post Process Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n]\nstyles = []\n[components.WorkbenchExtensionPostProcessWorkspace]\nroot = \"post_process_workspace\"\ndefault_classes = [\"workbench-module-body\", \"workbench-extension-module-body\"]\n\n[nodes.post_process_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchExtensionPostProcessWorkspace\"\nclasses = [\"workbench-module-body\", \"workbench-extension-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"post_process_workspace_main\" },\n  { node = \"post_process_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.post_process_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"post_process_rail_gap\" }, { node = \"post_process_left\" }, { node = \"post_process_center\" }, { node = \"post_process_right_reserve\" }]\n\n[nodes.post_process_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.post_process_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionPostProcessRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.post_process_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionPostProcessLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"post_process_title\" }, { node = \"post_process_left_content\" }]\n\n[nodes.post_process_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionPostProcessLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"post_process_global_row\" }, { node = \"post_process_cinematic_row\" }, { node = \"post_process_volume_row\" }]\n\n[nodes.post_process_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionPostProcessTitle\"\nprops = { text = \"Post Process\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.post_process_global_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessGlobalStackRow\"\nclasses = [\"workbench-list-row\", \"workbench-row-selected\"]\nprops = { text = \"Global Stack\", icon = \"renderer\", selected = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PostProcessGlobalStackRow\", event = \"Click\", route = \"workbench.extension.post_process.stack.global\" }]\n\n[nodes.post_process_cinematic_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessCinematicStackRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Cinematic Grade\", icon = \"sun\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PostProcessCinematicStackRow\", event = \"Click\", route = \"workbench.extension.post_process.stack.cinematic\" }]\n\n[nodes.post_process_volume_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessVolumeBlendRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Volume Blend\", icon = \"cube\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PostProcessVolumeBlendRow\", event = \"Click\", route = \"workbench.extension.post_process.volume_blend\" }]\n\n[nodes.post_process_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionPostProcessCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"post_process_center_header\" }, { node = \"post_process_pass_table\" }, { node = \"post_process_output\" }]\n\n[nodes.post_process_center_header]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionPostProcessCenterHeader\"\nclasses = [\"workbench-panel-toolbar\"]\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Never\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"post_process_center_title\" }, { node = \"post_process_header_fill\" }, { node = \"post_process_preview_button\" }, { node = \"post_process_apply_button\" }]\n\n[nodes.post_process_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionPostProcessCenterTitle\"\nprops = { text = \"Post Process Stack\" }\nlayout = { width = { min = 220.0, preferred = 220.0, max = 260.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.post_process_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionPostProcessHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.post_process_preview_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionPostProcessPreviewButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Preview\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 78, preferred = 78, max = 88, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PostProcessPreview\", event = \"Click\", route = \"workbench.extension.post_process.preview\" }]\n\n[nodes.post_process_apply_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionPostProcessApplyButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Apply\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 78, preferred = 78, max = 88, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PostProcessApply\", event = \"Click\", route = \"workbench.extension.post_process.apply\" }]\n\n[nodes.post_process_pass_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionPostProcessPassTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"post_process_bloom_row\" }, { node = \"post_process_tonemap_row\" }, { node = \"post_process_lut_row\" }, { node = \"post_process_exposure_warning_row\" }]\n\n[nodes.post_process_bloom_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessBloomTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Bloom\", value_text = \"0.65 intensity   threshold 1.0   Ready\", selected = false, options = [\"Bloom\",\"0.65 intensity\",\"threshold 1.0\",\"Ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PostProcessBloomTableRow\", event = \"Click\", route = \"workbench.extension.post_process.pass.bloom\" }]\n\n[nodes.post_process_tonemap_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessTonemapTableRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Tonemap\", value_text = \"Filmic   exposure +0.4   Selected\", selected = true, options = [\"Tonemap\",\"Filmic\",\"exposure +0.4\",\"Selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PostProcessTonemapTableRow\", event = \"Click\", route = \"workbench.extension.post_process.pass.tonemap\" }]\n\n[nodes.post_process_lut_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessLutTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Color LUT\", value_text = \"LUT_CityWarm   33 cube   Ready\", options = [\"Color LUT\",\"LUT_CityWarm\",\"33 cube\",\"Ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PostProcessLutTableRow\", event = \"Click\", route = \"workbench.extension.post_process.pass.lut\" }]\n\n[nodes.post_process_exposure_warning_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessExposureWarningTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Exposure Warning\", value_text = \"Interior volume   EV +2.1   Warning\", options = [\"Exposure Warning\",\"Interior volume\",\"EV +2.1\",\"Warning\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PostProcessExposureWarningTableRow\", event = \"Click\", route = \"workbench.extension.post_process.pass.exposure_warning\" }]\n\n[nodes.post_process_output]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessOutputRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Post Process\", value_text = \"Preview ready   1 warning   stack active\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, options = [\"Post Process\",\"Preview ready\",\"1 warning\",\"stack active\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\n\n[nodes.post_process_right]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionPostProcessRightPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"post_process_details_title\" }, { node = \"post_process_right_content\" }]\n\n[nodes.post_process_right_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionPostProcessRightContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"post_process_profile_dropdown_property_row\" }, { node = \"post_process_volume_field_property_row\" }, { node = \"post_process_blend_dropdown_property_row\" }]\n\n[nodes.post_process_details_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionPostProcessDetailsTitle\"\nprops = { text = \"Stack Settings\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.post_process_profile_dropdown_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessProfileDropdownPropertyRow\"\nprops = { text = \"Profile\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"post_process_profile_dropdown\", slot = { name = \"value\" } }]\n\n[nodes.post_process_profile_dropdown]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchExtensionPostProcessProfileDropdown\"\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\nprops = { value_text = \"Cinematic\", value = \"cinematic\", options = [\"gameplay|label=Gameplay\", \"cinematic|label=Cinematic\", \"debug|label=Debug\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/PostProcessProfileEdit\", event = \"Change\", route = \"workbench.extension.post_process.profile.edit\" },\n  { id = \"WorkbenchExtension/PostProcessProfileCommit\", event = \"Submit\", route = \"workbench.extension.post_process.profile.commit\" },\n]\n\n[nodes.post_process_volume_field_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessVolumeFieldPropertyRow\"\nprops = { text = \"Volume\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"post_process_volume_field\", slot = { name = \"value\" } }]\n\n[nodes.post_process_volume_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchExtensionPostProcessVolumeField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"PPV_CityGlobal\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/PostProcessVolumeEdit\", event = \"Change\", route = \"workbench.extension.post_process.volume.edit\" },\n  { id = \"WorkbenchExtension/PostProcessVolumeCommit\", event = \"Submit\", route = \"workbench.extension.post_process.volume.commit\" },\n]\n\n[nodes.post_process_blend_dropdown_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionPostProcessBlendDropdownPropertyRow\"\nprops = { text = \"Blend\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"post_process_blend_dropdown\", slot = { name = \"value\" } }]\n\n[nodes.post_process_blend_dropdown]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchExtensionPostProcessBlendDropdown\"\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\nprops = { value_text = \"Weighted\", value = \"weighted\", options = [\"override|label=Override\", \"weighted|label=Weighted\", \"additive|label=Additive\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/PostProcessBlendEdit\", event = \"Change\", route = \"workbench.extension.post_process.blend.edit\" },\n  { id = \"WorkbenchExtension/PostProcessBlendCommit\", event = \"Submit\", route = \"workbench.extension.post_process.blend.commit\" },\n]\n"

