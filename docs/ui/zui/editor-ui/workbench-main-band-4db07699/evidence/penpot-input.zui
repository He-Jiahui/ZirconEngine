penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/shell/workbench_main_band.zui\"\nversion = 2\ndisplay_name = \"Workbench Main Band\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/shell/workbench_activity_rail.zui#WorkbenchActivityRail\",\n  \"res://ui/editor/components/workbench/shell/workbench_inspector_panel.zui#WorkbenchInspectorPanel\",\n  \"res://ui/editor/components/workbench/modules/core/index/workbench_module_workspace.zui#WorkbenchModuleWorkspace\",\n  \"res://ui/editor/components/workbench/shell/workbench_scene_tree_panel.zui#WorkbenchSceneTreePanel\",\n  \"res://ui/editor/components/workbench/shell/workbench_viewport_panel.zui#WorkbenchViewportPanel\",\n]\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.WorkbenchMainBand]\nroot = \"main_band\"\ndefault_classes = [\"workbench-main-band\"]\n\n[nodes.main_band]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchMainBand\"\nclasses = [\"workbench-main-band\"]\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"scene_workspace\" }, { node = \"module_workspace\" }]\n\n[nodes.scene_workspace]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchSceneWorkspace\"\nclasses = [\"workbench-main-band\", \"workbench-scene-workspace\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.xsmall\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"activity_rail\", slot = { layout = { linear_size = { rule = \"Auto\", shrink_value = 0.0 } } } },\n  { node = \"left_drawer_shell\", slot = { layout = { linear_size = { rule = \"StretchContent\", value = 1.0, shrink_value = 1.0 } } } },\n  { node = \"viewport_panel\", slot = { layout = { linear_size = { rule = \"Stretch\", value = 4.0, shrink_value = 0.0 } } } },\n  { node = \"right_drawer_shell\", slot = { layout = { linear_size = { rule = \"StretchContent\", value = 1.0, shrink_value = 1.0 } } } },\n]\n\n[nodes.activity_rail]\ncomponent = \"WorkbenchActivityRail\"\ncontrol_id = \"WorkbenchMainBandActivityRail\"\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", priority = 80, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.left_drawer_shell]\ncomponent = \"Container\"\ncontrol_id = \"LeftDrawerShellRoot\"\nclasses = [\"workbench-left-drawer-shell\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { min = \"$editor.density.compact_side_min_width\", preferred = \"$editor.density.left_drawer_width\", max = \"$editor.density.compact_left_drawer_max_width\", priority = 50, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"scene_tree_panel\" }]\n\n[nodes.scene_tree_panel]\ncomponent = \"WorkbenchSceneTreePanel\"\ncontrol_id = \"WorkbenchMainBandSceneTreePanel\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.viewport_panel]\ncomponent = \"WorkbenchViewportPanel\"\ncontrol_id = \"WorkbenchMainBandViewportPanel\"\nlayout = { width = { min = 0.0, priority = 100, weight = 4.0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.right_drawer_shell]\ncomponent = \"Container\"\ncontrol_id = \"RightDrawerShellRoot\"\nclasses = [\"workbench-right-drawer-shell\"]\nprops = { responsive_min_tier = \"regular\" }\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { min = \"$editor.density.compact_side_min_width\", preferred = \"$editor.density.right_drawer_width\", max = \"$editor.density.right_drawer_width\", priority = 40, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"inspector_panel\" }]\n\n[nodes.inspector_panel]\ncomponent = \"WorkbenchInspectorPanel\"\ncontrol_id = \"WorkbenchMainBandInspectorPanel\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.module_workspace]\ncomponent = \"WorkbenchModuleWorkspace\"\ncontrol_id = \"WorkbenchMainBandModuleWorkspace\"\nprops = { visibility = \"visible\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n"

