[[stylesheets]]
id = "workbench-tab-states"

[[stylesheets.rules]]
selector = ".workbench-tab:selected, .workbench-tab:checked"

[stylesheets.rules.set.self]
background_color = "$editor.surface.selected"

[[stylesheets.rules]]
selector = ".workbench-tab:focus, .workbench-tab:focus-visible"

[stylesheets.rules.set.self]
background_color = "$editor.accent.soft"
hover_background_color = "$editor.accent.soft"
foreground_color = "$editor.text.primary"

