[asset]
kind = "view"
version = 2
id = "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#review-host"
display_name = "Workbench Property Editor Row"

[imports]
widgets = [ "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui", "res://ui/editor/components/workbench/primitives/inputs/workbench_number_field.zui" ]
styles = []

[root]
node = "review_component"

[nodes.review_component]
component = "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow"

[[nodes.review_component.children]]
node = "review_value"

[nodes.review_component.children.slot]
name = "value"

[nodes.review_value]
component = "res://ui/editor/components/workbench/primitives/inputs/workbench_number_field.zui#WorkbenchNumberField"
