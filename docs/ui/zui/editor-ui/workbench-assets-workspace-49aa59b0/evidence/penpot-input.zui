penpot_original_source = "[asset]\r\nkind = \"component\"\r\nid = \"res://ui/editor/components/workbench/modules/core/assets/workbench_assets_workspace.zui\"\r\nversion = 2\r\ndisplay_name = \"Workbench Assets Workspace\"\r\n\r\n[imports]\r\nwidgets = [\r\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\r\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\r\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\r\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\r\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\r\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\r\n]\r\nstyles = []\r\n\r\n[components.WorkbenchAssetsWorkspace]\r\nroot = \"assets_workspace\"\r\ndefault_classes = [\"workbench-module-body\"]\r\n\r\n[nodes.assets_workspace]\r\ncomponent = \"Overlay\"\r\ncontrol_id = \"WorkbenchModuleAssetsWorkspace\"\r\nclasses = [\"workbench-module-body\"]\r\nprops = { visibility = \"collapsed\" }\r\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [\r\n  { node = \"assets_workspace_main\" },\r\n  { node = \"assets_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\r\n  { node = \"assets_production_tools_menu\", slot = { layout = { alignment = { horizontal = \"Start\", vertical = \"Start\" }, z_order = 30 } } },\r\n  { node = \"assets_gameplay_tools_menu\", slot = { layout = { alignment = { horizontal = \"Start\", vertical = \"Start\" }, z_order = 30 } } },\r\n  { node = \"assets_world_tools_menu\", slot = { layout = { alignment = { horizontal = \"Start\", vertical = \"Start\" }, z_order = 30 } } },\r\n]\r\n\r\n[nodes.assets_workspace_main]\r\ncomponent = \"HorizontalGroup\"\r\nclasses = [\"workbench-module-layout-main\"]\r\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.chrome.separator.thickness\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"assets_rail_gap\" }, { node = \"assets_left\" }, { node = \"assets_center\" }, { node = \"assets_right_reserve\" }]\r\n\r\n[nodes.assets_right_reserve]\r\ncomponent = \"Container\"\r\nclasses = [\"workbench-module-details-reserve\"]\r\nprops = { responsive_min_tier = \"wide\" }\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 210.0, preferred = 260.0, max = 310.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.assets_rail_gap]\r\ncomponent = \"Container\"\r\ncontrol_id = \"WorkbenchAssetsRailGap\"\r\nprops = { responsive_min_tier = \"narrow\" }\r\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.assets_left]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchAssetsLeftPanel\"\r\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\r\nprops = { responsive_min_tier = \"narrow\" }\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 188.0, preferred = 220.0, max = 250.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"assets_title\" }, { node = \"assets_left_content\" }]\r\n\r\n[nodes.assets_left_content]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchAssetsLeftContent\"\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"assets_forest_row\" }, { node = \"assets_material_row\" }]\r\n\r\n[nodes.assets_title]\r\ncomponent = \"WorkbenchSectionTitle\"\r\ncontrol_id = \"WorkbenchAssetsTitle\"\r\nclasses = [\"workbench-section-title\"]\r\nprops = { text = \"Assets\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.assets_forest_row]\r\ncomponent = \"WorkbenchListRow\"\r\ncontrol_id = \"WorkbenchAssetsForestRow\"\r\nclasses = [\"workbench-list-row\"]\r\nprops = { text = \"Forest\", value = \"forest\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/AssetsForestRow\", event = \"Click\", route = \"workbench.module.assets.forest_row.select\" }]\r\n\r\n[nodes.assets_material_row]\r\ncomponent = \"WorkbenchListRow\"\r\ncontrol_id = \"WorkbenchAssetsMaterialRow\"\r\nclasses = [\"workbench-list-row\"]\r\nprops = { text = \"Materials\", value = \"materials\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/AssetsMaterialRow\", event = \"Click\", route = \"workbench.module.assets.material_row.select\" }]\r\n\r\n[nodes.assets_center]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchAssetsCenterPanel\"\r\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\r\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"assets_center_header\" }, { node = \"assets_table\" }, { node = \"assets_output\" }]\r\n\r\n[nodes.assets_center_header]\r\ncomponent = \"HorizontalGroup\"\r\ncontrol_id = \"WorkbenchAssetsCenterHeader\"\r\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nchildren = [{ node = \"assets_center_title\" }, { node = \"assets_header_fill\" }, { node = \"assets_import_button\" }]\r\n\r\n[nodes.assets_center_title]\r\ncomponent = \"WorkbenchSectionTitle\"\r\ncontrol_id = \"WorkbenchAssetsCenterTitle\"\r\nclasses = [\"workbench-section-title\"]\r\nprops = { text = \"Content/Environment/Forest\" }\r\n# Keep the breadcrumb-like asset scope as one semantic title in the wide and\r\n# compact editor tiers; the 220px slot is the measured width of the full path.\r\nlayout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.assets_header_fill]\r\ncomponent = \"Container\"\r\ncontrol_id = \"WorkbenchAssetsHeaderFill\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.assets_import_button]\r\ncomponent = \"WorkbenchButton\"\r\ncontrol_id = \"WorkbenchAssetsImportButton\"\r\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\r\nprops = { text = \"Import\", button_variant = \"filled\", button_color = \"accent\" }\r\nlayout = { width = { min = 66, preferred = 72, max = 80, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/AssetsImport\", event = \"Click\", route = \"workbench.module.assets.import.invoke\" }]\r\n\r\n[nodes.assets_table]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchAssetsTable\"\r\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"assets_table_row_01\" }, { node = \"assets_table_row_02\" }, { node = \"assets_table_row_03\" }]\r\n\r\n[nodes.assets_table_row_01]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchAssetsTableRow01\"\r\nclasses = [\"workbench-table-row\"]\r\nprops = { text = \"SM_Tree_Oak_01     Static Mesh     2.4 MB     Today\", value = \"asset_01\", options = [\"SM_Tree_Oak_01\", \"Static Mesh\", \"2.4 MB\", \"Today\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/AssetsTableTree\", event = \"Click\", route = \"workbench.module.assets.table_tree.select\" }]\r\n\r\n[nodes.assets_table_row_02]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchAssetsTableRow02\"\r\nclasses = [\"workbench-table-row\"]\r\nprops = { text = \"M_Bark_Master      Material        512 KB     10m ago\", value = \"asset_02\", options = [\"M_Bark_Master\", \"Material\", \"512 KB\", \"10m ago\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/AssetsTableMaterial\", event = \"Click\", route = \"workbench.module.assets.table_material.select\" }]\r\n\r\n[nodes.assets_table_row_03]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchAssetsTableRow03\"\r\nclasses = [\"workbench-table-row\"]\r\nprops = { text = \"T_Leaf_N           Texture         1.2 MB     1h ago\", value = \"asset_03\", options = [\"T_Leaf_N\", \"Texture\", \"1.2 MB\", \"1h ago\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchModule/AssetsTableTexture\", event = \"Click\", route = \"workbench.module.assets.table_texture.select\" }]\r\n\r\n[nodes.assets_output]\r\ncomponent = \"WorkbenchListRow\"\r\ncontrol_id = \"WorkbenchAssetsOutputRow\"\r\nclasses = [\"workbench-list-row\"]\r\nprops = { text = \"Validation: 19 issues across imported content\", value = \"assets_output\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.assets_right]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchAssetsRightPanel\"\r\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\r\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 210.0, preferred = 260.0, max = 310.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"assets_details_title\" }, { node = \"assets_right_content\" }]\r\n\r\n[nodes.assets_right_content]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchAssetsRightContent\"\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"assets_type_property_row\" }, { node = \"assets_path_property_row\" }, { node = \"assets_owner_property_row\" }, { node = \"assets_tools_title\" }, { node = \"assets_world_tools\" }, { node = \"assets_gameplay_tools\" }, { node = \"assets_production_tools\" }]\r\n\r\n[nodes.assets_details_title]\r\ncomponent = \"WorkbenchSectionTitle\"\r\ncontrol_id = \"WorkbenchAssetsDetailsTitle\"\r\nclasses = [\"workbench-section-title\"]\r\nprops = { text = \"Details\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.assets_type_property_row]\r\ncomponent = \"WorkbenchPropertyEditorRow\"\r\ncontrol_id = \"WorkbenchAssetsTypePropertyRow\"\r\nprops = { text = \"Type\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nchildren = [{ node = \"assets_type_field\", slot = { name = \"value\" } }]\r\n\r\n[nodes.assets_type_field]\r\ncomponent = \"WorkbenchField\"\r\ncontrol_id = \"WorkbenchAssetsTypeField\"\r\nclasses = [\"workbench-field\", \"workbench-component-field\"]\r\nprops = { value = \"Static Mesh\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\nevents = [\r\n  { id = \"WorkbenchModule/AssetsTypeEdit\", event = \"Change\", route = \"workbench.module.assets.type.edit\" },\r\n  { id = \"WorkbenchModule/AssetsTypeCommit\", event = \"Submit\", route = \"workbench.module.assets.type.commit\" },\r\n]\r\n\r\n[nodes.assets_path_property_row]\r\ncomponent = \"WorkbenchPropertyEditorRow\"\r\ncontrol_id = \"WorkbenchAssetsPathPropertyRow\"\r\nprops = { text = \"Path\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nchildren = [{ node = \"assets_path_field\", slot = { name = \"value\" } }]\r\n\r\n[nodes.assets_path_field]\r\ncomponent = \"WorkbenchField\"\r\ncontrol_id = \"WorkbenchAssetsPathField\"\r\nclasses = [\"workbench-field\", \"workbench-component-field\"]\r\nprops = { value = \"/Game/Environment/Forest\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\nevents = [\r\n  { id = \"WorkbenchModule/AssetsPathEdit\", event = \"Change\", route = \"workbench.module.assets.path.edit\" },\r\n  { id = \"WorkbenchModule/AssetsPathCommit\", event = \"Submit\", route = \"workbench.module.assets.path.commit\" },\r\n]\r\n\r\n[n