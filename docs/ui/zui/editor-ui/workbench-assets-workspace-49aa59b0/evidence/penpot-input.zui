stylesheets = []
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_button.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_field.zui", "zircon_editor/assets/ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/data/workbench_list_row.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/data/workbench_table_row.zui", "zircon_editor/assets/icons/zircon_editor_shell/controls/search.svg", "zircon_editor/assets/icons/ionicons/close-outline.svg", "zircon_editor/assets/icons/zircon_editor_shell/controls/field-stepper.svg" ]
penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/core/assets/workbench_assets_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Assets Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n]\nstyles = []\n\n[components.WorkbenchAssetsWorkspace]\nroot = \"assets_workspace\"\ndefault_classes = [\"workbench-module-body\"]\n\n[nodes.assets_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchModuleAssetsWorkspace\"\nclasses = [\"workbench-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"assets_workspace_main\" },\n  { node = \"assets_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.assets_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.chrome.separator.thickness\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"assets_rail_gap\" }, { node = \"assets_left\" }, { node = \"assets_center\" }, { node = \"assets_right_reserve\" }]\n\n[nodes.assets_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 210.0, preferred = 260.0, max = 310.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.assets_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchAssetsRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.assets_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchAssetsLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 188.0, preferred = 220.0, max = 250.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"assets_title\" }, { node = \"assets_left_content\" }]\n\n[nodes.assets_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchAssetsLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"assets_forest_row\" }, { node = \"assets_material_row\" }]\n\n[nodes.assets_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchAssetsTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Assets\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.assets_forest_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchAssetsForestRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Forest\", value = \"forest\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AssetsForestRow\", event = \"Click\", route = \"workbench.module.assets.forest_row.select\" }]\n\n[nodes.assets_material_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchAssetsMaterialRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Materials\", value = \"materials\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AssetsMaterialRow\", event = \"Click\", route = \"workbench.module.assets.material_row.select\" }]\n\n[nodes.assets_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchAssetsCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"assets_center_header\" }, { node = \"assets_table\" }, { node = \"assets_output\" }]\n\n[nodes.assets_center_header]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchAssetsCenterHeader\"\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"assets_center_title\" }, { node = \"assets_header_fill\" }, { node = \"assets_import_button\" }]\n\n[nodes.assets_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchAssetsCenterTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Content/Environment/Forest\" }\n# Keep the breadcrumb-like asset scope as one semantic title in the wide and\n# compact editor tiers; the 220px slot is the measured width of the full path.\nlayout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.assets_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchAssetsHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.assets_import_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchAssetsImportButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Import\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 66, preferred = 72, max = 80, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AssetsImport\", event = \"Click\", route = \"workbench.module.assets.import.invoke\" }]\n\n[nodes.assets_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchAssetsTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"assets_table_row_01\" }, { node = \"assets_table_row_02\" }, { node = \"assets_table_row_03\" }]\n\n[nodes.assets_table_row_01]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAssetsTableRow01\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"SM_Tree_Oak_01     Static Mesh     2.4 MB     Today\", value = \"asset_01\", options = [\"SM_Tree_Oak_01\", \"Static Mesh\", \"2.4 MB\", \"Today\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AssetsTableTree\", event = \"Click\", route = \"workbench.module.assets.table_tree.select\" }]\n\n[nodes.assets_table_row_02]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAssetsTableRow02\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"M_Bark_Master      Material        512 KB     10m ago\", value = \"asset_02\", options = [\"M_Bark_Master\", \"Material\", \"512 KB\", \"10m ago\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AssetsTableMaterial\", event = \"Click\", route = \"workbench.module.assets.table_material.select\" }]\n\n[nodes.assets_table_row_03]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAssetsTableRow03\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"T_Leaf_N           Texture         1.2 MB     1h ago\", value = \"asset_03\", options = [\"T_Leaf_N\", \"Texture\", \"1.2 MB\", \"1h ago\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AssetsTableTexture\", event = \"Click\", route = \"workbench.module.assets.table_texture.select\" }]\n\n[nodes.assets_output]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchAssetsOutputRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Validation: 19 issues across imported content\", value = \"assets_output\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.assets_right]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchAssetsRightPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 210.0, preferred = 260.0, max = 310.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"assets_details_title\" }, { node = \"assets_right_content\" }]\n\n[nodes.assets_right_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchAssetsRightContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"assets_type_property_row\" }, { node = \"assets_path_property_row\" }, { node = \"assets_owner_property_row\" }, { node = \"assets_tools_title\" }, { node = \"assets_world_tools\" }, { node = \"assets_gameplay_tools\" }, { node = \"assets_production_tools\" }]\n\n[nodes.assets_details_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchAssetsDetailsTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Details\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.assets_type_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchAssetsTypePropertyRow\"\nprops = { text = \"Type\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"assets_type_field\", slot = { name = \"value\" } }]\n\n[nodes.assets_type_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchAssetsTypeField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"Static Mesh\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/AssetsTypeEdit\", event = \"Change\", route = \"workbench.module.assets.type.edit\" },\n  { id = \"WorkbenchModule/AssetsTypeCommit\", event = \"Submit\", route = \"workbench.module.assets.type.commit\" },\n]\n\n[nodes.assets_path_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchAssetsPathPropertyRow\"\nprops = { text = \"Path\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"assets_path_field\", slot = { name = \"value\" } }]\n\n[nodes.assets_path_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchAssetsPathField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"/Game/Environment/Forest\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/AssetsPathEdit\", event = \"Change\", route = \"workbench.module.assets.path.edit\" },\n  { id = \"WorkbenchModule/AssetsPathCommit\", event = \"Submit\", route = \"workbench.module.assets.path.commit\" },\n]\n\n[nodes.assets_owner_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchAssetsOwnerPropertyRow\"\nprops = { text = \"Source\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"assets_owner_field\", slot = { name = \"value\" } }]\n\n[nodes.assets_owner_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchAssetsOwnerField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"glTF importer\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/AssetsOwnerEdit\", event = \"Change\", route = \"workbench.module.assets.owner.edit\" },\n  { id = \"WorkbenchModule/AssetsOwnerCommit\", event = \"Submit\", route = \"workbench.module.assets.owner.commit\" },\n]\n\n[nodes.assets_tools_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchAssetsToolsTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Open Tool\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.assets_world_tools]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchAssetsWorldTools\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\", \"workbench-menu-trigger\"]\nprops = { text = \"World Editors\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AssetsWorldToolsOpen\", event = \"Click\", route = \"workbench.module.assets.world_tools.open\" }]\n\n[nodes.assets_gameplay_tools]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchAssetsGameplayTools\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\", \"workbench-menu-trigger\"]\nprops = { text = \"Gameplay & Simulation\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AssetsGameplayToolsOpen\", event = \"Click\", route = \"workbench.module.assets.gameplay_tools.open\" }]\n\n[nodes.assets_production_tools]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchAssetsProductionTools\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\", \"workbench-menu-trigger\"]\nprops = { text = \"Production Tools\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AssetsProductionTool