[asset]
kind = "component"
id = "res://ui/editor/material_components/inputs/material_radio_buttons.zui"
version = 2
display_name = "Material Radio Buttons Prototype"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption"]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.MaterialRadioButtonsPrototype]
root = "root"
default_classes = ["material-lab-prototype", "material-surface"]

[nodes.title]
component = "WorkbenchLabel"
control_id = "radio-buttons_Title"
classes = ["material-lab-title"]
props = { "text" = "Radio Buttons", "text_tone" = "primary", "font_size" = "$editor.typography.title.size", "font_weight" = "$editor.typography.strong.weight", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 28, "preferred" = 28, "max" = 28, "stretch" = "Fixed" } }

[nodes.meta]
component = "GridBox"
control_id = "radio_buttons_Meta"
classes = ["material-lab-meta-strip", "material-lab-meta"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 100, "preferred" = 100, "max" = 100, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 2, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "meta_group" },
  { node = "meta_response" },
  { node = "meta_variant" },
  { node = "meta_layout" },
]

[nodes.meta_group]
component = "WorkbenchCaption"
control_id = "radio_buttons_MetaGroup"
classes = ["material-lab-meta-chip", "material-lab-meta-group"]
props = { "text" = "Inputs", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_response]
component = "WorkbenchCaption"
control_id = "radio_buttons_MetaResponse"
classes = ["material-lab-meta-chip", "material-lab-meta-response"]
props = { "text" = "change / commit", "text_tone" = "success", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "response_mechanism" = "change / commit", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.meta_variant]
component = "WorkbenchCaption"
control_id = "radio_buttons_MetaVariant"
classes = ["material-lab-meta-chip", "material-lab-meta-variant"]
props = { "text" = "checked / unchecked", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "variant" = "checked / unchecked", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_layout]
component = "WorkbenchCaption"
control_id = "radio_buttons_MetaLayout"
classes = ["material-lab-meta-chip", "material-lab-meta-layout"]
props = { "text" = "inline controls", "text_tone" = "warning", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "layout_mode" = "inline controls", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.sample]
component = "HorizontalBox"
control_id = "radio-buttons_Sample"
classes = ["material-control", "material-lab-sample", "material-radio-group-row"]
props = { "text" = "", "group_value" = "editor", "option_id" = "editor", "options" = ["editor", "runtime", "disabled", "qa"], "disabled_options" = ["disabled"], "label_click_selects" = true, "exclusive_group" = true, "keyboard_navigation" = true, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "primary", "validation_level" = "normal", "hovered" = true, "pressed" = false, "focused" = true, "selected" = true, "checked" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "input_interactive" = true, "input_clickable" = true, "input_hoverable" = true, "input_focusable" = true, "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 152, "preferred" = 152, "max" = 152, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 1, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.medium" } }
children = [
  { node = "radio_selected" },
  { node = "radio_unselected" },
  { node = "radio_disabled" },
  { node = "radio_error" },
]
events = [
  { id = "MaterialLab/RadioButtons/Change", event = "Change", route = "material_lab.radio_buttons.change" },
]

[nodes.radio_selected]
component = "Radio"
control_id = "radio_buttons_Selected"
classes = ["material-control", "material-radio", "material-radio-selected"]
props = { "text" = "Editor", "group_value" = "editor", "option_id" = "editor", "options" = ["editor", "runtime", "disabled", "qa"], "disabled_options" = ["disabled"], "label_click_selects" = true, "exclusive_group" = true, "keyboard_navigation" = true, "checked" = true, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "primary", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = true, "selected" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 2, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "background" = { "color" = "$editor.accent.soft" }, "foreground" = { "color" = "material.text" }, "border" = { "color" = "material.focus_ring", "width" = 2, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.radio_unselected]
component = "Radio"
control_id = "radio_buttons_Unselected"
classes = ["material-control", "material-radio", "material-radio-unselected"]
props = { "text" = "Runtime", "group_value" = "editor", "option_id" = "runtime", "options" = ["editor", "runtime", "disabled", "qa"], "disabled_options" = ["disabled"], "label_click_selects" = true, "exclusive_group" = true, "keyboard_navigation" = true, "checked" = false, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "secondary", "validation_level" = "normal", "hovered" = true, "pressed" = false, "focused" = false, "selected" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "background" = { "color" = "material.surface_inset" }, "foreground" = { "color" = "material.text_muted" }, "border" = { "color" = "material.outline", "width" = 1, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.radio_disabled]
component = "Radio"
control_id = "radio_buttons_Disabled"
classes = ["material-control", "material-radio", "material-radio-disabled"]
props = { "text" = "Disabled", "group_value" = "editor", "option_id" = "disabled", "options" = ["editor", "runtime", "disabled", "qa"], "disabled_options" = ["disabled"], "label_click_selects" = true, "exclusive_group" = true, "keyboard_navigation" = true, "checked" = false, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "disabled", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "disabled" = true, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "background" = { "color" = "material.disabled" }, "foreground" = { "color" = "material.text_disabled" }, "border" = { "color" = "material.outline", "width" = 1, "radius" = "$editor.control.radius.control" }, "opacity" = 0.38 } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.radio_error]
component = "Radio"
control_id = "radio_buttons_Error"
classes = ["material-control", "material-radio", "material-radio-error"]
props = { "text" = "Error", "group_value" = "editor", "option_id" = "qa", "options" = ["editor", "runtime", "disabled", "qa"], "disabled_options" = ["disabled"], "label_click_selects" = true, "exclusive_group" = true, "keyboard_navigation" = true, "checked" = false, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "error", "validation_level" = "error", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "background" = { "color" = "$editor.semantic.error.container" }, "foreground" = { "color" = "material.error" }, "border" = { "color" = "material.error", "width" = 1, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.state_strip]
component = "GridBox"
control_id = "radio_buttons_StateStrip"
classes = ["material-lab-state-strip"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 108, "preferred" = 108, "max" = 108, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "state_default" },
  { node = "state_hover" },
  { node = "state_pressed" },
  { node = "state_focus" },
  { node = "state_disabled" },
  { node = "state_selected" },
  { node = "state_open" },
  { node = "state_error" },
]
[nodes.state_default]
