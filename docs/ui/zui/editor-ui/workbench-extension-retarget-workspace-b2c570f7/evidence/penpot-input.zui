penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/extensions/animation/workbench_extension_retarget_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Extension Retarget Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n]\nstyles = []\n\n[components.WorkbenchExtensionRetargetWorkspace]\nroot = \"retarget_workspace\"\ndefault_classes = [\"workbench-module-body\", \"workbench-extension-module-body\"]\n\n[nodes.retarget_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchExtensionRetargetWorkspace\"\nclasses = [\"workbench-module-body\", \"workbench-extension-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"retarget_workspace_main\" },\n  { node = \"retarget_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.retarget_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"retarget_rail_gap\" }, { node = \"retarget_left\" }, { node = \"retarget_center\" }, { node = \"retarget_right_reserve\" }]\n\n[nodes.retarget_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.retarget_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionRetargetRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.retarget_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionRetargetLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"retarget_title\" }, { node = \"retarget_left_content\" }]\n\n[nodes.retarget_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionRetargetLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"retarget_mannequin_row\" }, { node = \"retarget_robot_row\" }, { node = \"retarget_quadruped_row\" }]\n\n[nodes.retarget_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionRetargetTitle\"\nprops = { text = \"Retarget\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.retarget_mannequin_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionRetargetMannequinRow\"\nclasses = [\"workbench-list-row\", \"workbench-row-selected\"]\nprops = { text = \"SK_Mannequin\", icon = \"target\", selected = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/RetargetMannequinRow\", event = \"Click\", route = \"workbench.extension.retarget.rig.mannequin\" }]\n\n[nodes.retarget_robot_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionRetargetRobotRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"SK_Robot\", icon = \"gear\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/RetargetRobotRow\", event = \"Click\", route = \"workbench.extension.retarget.rig.robot\" }]\n\n[nodes.retarget_quadruped_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionRetargetQuadrupedRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Creature Proxy\", icon = \"history\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/RetargetQuadrupedRow\", event = \"Click\", route = \"workbench.extension.retarget.rig.quadruped\" }]\n\n[nodes.retarget_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionRetargetCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"retarget_center_header\" }, { node = \"retarget_chain_table\" }, { node = \"retarget_output\" }]\n\n[nodes.retarget_center_header]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionRetargetCenterHeader\"\nclasses = [\"workbench-panel-toolbar\"]\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Never\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"retarget_center_title\" }, { node = \"retarget_header_fill\" }, { node = \"retarget_preview_button\" }, { node = \"retarget_apply_button\" }]\n\n[nodes.retarget_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionRetargetCenterTitle\"\nprops = { text = \"Chain Map\" }\nlayout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.retarget_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionRetargetHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.retarget_preview_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionRetargetPreviewButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Preview\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 78, preferred = 78, max = 88, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/RetargetPreview\", event = \"Click\", route = \"workbench.extension.retarget.preview\" }]\n\n[nodes.retarget_apply_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionRetargetApplyButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Apply\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 72, preferred = 72, max = 82, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/RetargetApply\", event = \"Click\", route = \"workbench.extension.retarget.apply\" }]\n\n[nodes.retarget_chain_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionRetargetChainTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"retarget_root_chain_table_row\" }, { node = \"retarget_spine_chain_table_row\" }, { node = \"retarget_arm_chain_table_row\" }, { node = \"retarget_leg_chain_table_row\" }]\n\n[nodes.retarget_root_chain_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionRetargetRootChainTableRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Root\", value_text = \"pelvis -> root   Locked   Selected\", selected = true, options = [\"Root\",\"pelvis -> root\",\"Locked\",\"Selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/RetargetRootChainTableRow\", event = \"Click\", route = \"workbench.extension.retarget.chain.root\" }]\n\n[nodes.retarget_spine_chain_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionRetargetSpineChainTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Spine\", value_text = \"spine_01..neck_01   FK   Clean\", options = [\"Spine\",\"spine_01..neck_01\",\"FK\",\"Clean\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/RetargetSpineChainTableRow\", event = \"Click\", route = \"workbench.extension.retarget.chain.spine\" }]\n\n[nodes.retarget_arm_chain_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionRetargetArmChainTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Arms\", value_text = \"clavicle..hand   IK   Mirror pair\", options = [\"Arms\",\"clavicle..hand\",\"IK\",\"Mirror pair\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/RetargetArmChainTableRow\", event = \"Click\", route = \"workbench.extension.retarget.chain.arm\" }]\n\n[nodes.retarget_leg_chain_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionRetargetLegChainTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Legs\", value_text = \"thigh..ball   IK   Foot lock warning\", options = [\"Legs\",\"thigh..ball\",\"IK\",\"Foot lock warning\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/RetargetLegChainTableRow\", event = \"Click\", route = \"workbench.extension.retarget.chain.leg\" }]\n\n[nodes.retarget_output]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionRetargetOutputRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Retarget\", value_text = \"SK_Mannequin -> SK_Robot   4 chains   Ready\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, options = [\"Retarget\",\"SK_Mannequin -> SK_Robot\",\"4 chains\",\"Ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\n\n[nodes.retarget_right]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionRetargetRightPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"retarget_details_title\" }, { node = \"retarget_right_content\" }]\n\n[nodes.retarget_right_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionRetargetRightContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"retarget_source_dropdown_property_row\" }, { node = \"retarget_target_field_property_row\" }, { node = \"retarget_solver_dropdown_property_row\" }]\n\n[nodes.retarget_details_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionRetargetDetailsTitle\"\nprops = { text = \"Retarget Settings\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.retarget_source_dropdown_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionRetargetSourceDropdownPropertyRow\"\nprops = { text = \"Source\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"retarget_source_dropdown\", slot = { name = \"value\" } }]\n\n[nodes.retarget_source_dropdown]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchExtensionRetargetSourceDropdown\"\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\nprops = { value_text = \"SK_Mannequin\", value = \"SK_Mannequin\", options = [\"SK_Mannequin\", \"SK_MetaHuman\", \"Creature_Source\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/RetargetSourceEdit\", event = \"Change\", route = \"workbench.extension.retarget.source.edit\" },\n  { id = \"WorkbenchExtension/RetargetSourceCommit\", event = \"Submit\", route = \"workbench.extension.retarget.source.commit\" },\n]\n\n[nodes.retarget_target_field_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionRetargetTargetFieldPropertyRow\"\nprops = { text = \"Target\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"retarget_target_field\", slot = { name = \"value\" } }]\n\n[nodes.retarget_target_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchExtensionRetargetTargetField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"Target: SK_Robot\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/RetargetTargetEdit\", event = \"Change\", route = \"workbench.extension.retarget.target.edit\" },\n  { id = \"WorkbenchExtension/RetargetTargetCommit\", event = \"Submit\", route = \"workbench.extension.retarget.target.commit\" },\n]\n\n[nodes.retarget_solver_dropdown_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionRetargetSolverDropdownPropertyRow\"\nprops = { text = \"Solver\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"retarget_solver_dropdown\", sl