penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/theme/editor_workbench_strict.zui" ]
penpot_original_source = "stylesheets = []\r\n\r\n[asset]\r\nkind = \"view\"\r\nid = \"res://ui/editor/workbench_page_chrome.zui\"\r\nversion = 2\r\ndisplay_name = \"workbench page chrome\"\r\n\r\n[imports]\r\nwidgets = []\r\nstyles = [\"res://ui/theme/editor_workbench_strict.zui\"]\r\n\r\n[root]\r\nnode = \"workbench_page_chrome_root\"\r\n\r\n[nodes.workbench_page_chrome_root]\r\ncomponent = \"Overlay\"\r\ncontrol_id = \"WorkbenchPageChromeRoot\"\r\npixel_snapping = \"disabled\"\r\nclasses = [\"page-chrome\", \"editor-shell\", \"workbench-shell-root\"]\r\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [\r\n  { node = \"workbench_page_bar\" },\r\n  { node = \"workbench_page_project_path\" },\r\n  { node = \"workbench_page_tab_0\" },\r\n  { node = \"workbench_page_tab_close_0\" },\r\n  { node = \"workbench_page_tab_1\" },\r\n  { node = \"workbench_page_tab_close_1\" },\r\n  { node = \"workbench_page_tab_2\" },\r\n  { node = \"workbench_page_tab_close_2\" },\r\n]\r\n\r\n[nodes.workbench_page_bar]\r\ncomponent = \"Container\"\r\ncontrol_id = \"WorkbenchPageBar\"\r\nclasses = [\"workbench-tabs\"]\r\nprops = { surface_variant = \"panel\", radius = 0.0, border_width = 0.0 }\r\nlayout = { position = { x = 0.0, y = 26.0 }, width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.workbench_page_project_path]\r\ncomponent = \"Label\"\r\ncontrol_id = \"PageProjectPath\"\r\nprops = { text = \"No project open\", text_tone = \"muted\", font_size = \"$editor.typography.caption.size\", text_align = \"right\", overflow = \"elide\" }\r\nlayout = { anchor = { x = 1.0, y = 0.0 }, pivot = { x = 1.0, y = 0.0 }, position = { x = -12.0, y = 35.0 }, width = { min = 280.0, preferred = 280.0, max = 280.0, stretch = \"Fixed\" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.workbench_page_tab_0]\r\ncomponent = \"Label\"\r\ncontrol_id = \"PageTab0\"\r\nclasses = [\"workbench-tab\"]\r\nprops = { text = \"Workbench\", surface_variant = \"transparent\", radius = \"$editor.control.radius.small\", text_tone = \"default\", font_size = \"$editor.typography.body.size\", text_align = \"center\", overflow = \"elide\" }\r\nlayout = { position = { x = 8.0, y = 27.0 }, width = { min = 108.0, preferred = 108.0, max = 108.0, stretch = \"Fixed\" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.workbench_page_tab_close_0]\r\ncomponent = \"IconButton\"\r\ncontrol_id = \"PageTabClose0\"\r\nclasses = [\"workbench-icon-button\", \"workbench-quiet-action\"]\r\nprops = { surface_variant = \"transparent\", icon = \"editor_pages/workbench/tabs/close-tab.svg\", text_tone = \"muted\", radius = \"$editor.control.radius.small\", border_width = 0.0 }\r\nlayout = { position = { x = 90, y = 32 }, width = { min = 20, preferred = 20, max = 20, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\n\r\n[nodes.workbench_page_tab_1]\r\ncomponent = \"Label\"\r\ncontrol_id = \"PageTab1\"\r\nclasses = [\"workbench-tab\"]\r\nprops = { text = \"Asset\", surface_variant = \"transparent\", radius = \"$editor.control.radius.small\", text_tone = \"subtle\", font_size = \"$editor.typography.body.size\", text_align = \"center\", overflow = \"elide\" }\r\nlayout = { position = { x = 120.0, y = 27.0 }, width = { min = 108.0, preferred = 108.0, max = 108.0, stretch = \"Fixed\" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.workbench_page_tab_close_1]\r\ncomponent = \"IconButton\"\r\ncontrol_id = \"PageTabClose1\"\r\nclasses = [\"workbench-icon-button\", \"workbench-quiet-action\"]\r\nprops = { surface_variant = \"transparent\", icon = \"editor_pages/workbench/tabs/close-tab.svg\", text_tone = \"muted\", radius = \"$editor.control.radius.small\", border_width = 0.0 }\r\nlayout = { position = { x = 202, y = 32 }, width = { min = 20, preferred = 20, max = 20, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\n\r\n[nodes.workbench_page_tab_2]\r\ncomponent = \"Label\"\r\ncontrol_id = \"PageTab2\"\r\nclasses = [\"workbench-tab\"]\r\nprops = { text = \"UI\", surface_variant = \"transparent\", radius = \"$editor.control.radius.small\", text_tone = \"subtle\", font_size = \"$editor.typography.body.size\", text_align = \"center\", overflow = \"elide\" }\r\nlayout = { position = { x = 232.0, y = 27.0 }, width = { min = 108.0, preferred = 108.0, max = 108.0, stretch = \"Fixed\" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.workbench_page_tab_close_2]\r\ncomponent = \"IconButton\"\r\ncontrol_id = \"PageTabClose2\"\r\nclasses = [\"workbench-icon-button\", \"workbench-quiet-action\"]\r\nprops = { surface_variant = \"transparent\", icon = \"editor_pages/workbench/tabs/close-tab.svg\", text_tone = \"muted\", radius = \"$editor.control.radius.small\", border_width = 0.0 }\r\nlayout = { position = { x = 314, y = 32 }, width = { min = 20, preferred = 20, max = 20, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\n"

