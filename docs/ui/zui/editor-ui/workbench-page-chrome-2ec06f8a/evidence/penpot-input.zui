[asset]
kind = "view"
id = "res://ui/editor/workbench_page_chrome.zui"
version = 2
display_name = "workbench page chrome"

[imports]
widgets = []
styles = []

[root]
node = "workbench_page_chrome_root"

[nodes.workbench_page_chrome_root]
component = "Overlay"
control_id = "WorkbenchPageChromeRoot"
pixel_snapping = "disabled"
classes = [ "page-chrome", "editor-shell", "workbench-shell-root" ]

[nodes.workbench_page_chrome_root.layout]
clip = true

[nodes.workbench_page_chrome_root.layout.container]
kind = "Overlay"

[nodes.workbench_page_chrome_root.layout.width]
stretch = "Stretch"

[nodes.workbench_page_chrome_root.layout.height]
stretch = "Stretch"

[[nodes.workbench_page_chrome_root.children]]
node = "workbench_page_bar"

[[nodes.workbench_page_chrome_root.children]]
node = "workbench_page_project_path"

[[nodes.workbench_page_chrome_root.children]]
node = "workbench_page_tab_0"

[[nodes.workbench_page_chrome_root.children]]
node = "workbench_page_tab_close_0"

[[nodes.workbench_page_chrome_root.children]]
node = "workbench_page_tab_1"

[[nodes.workbench_page_chrome_root.children]]
node = "workbench_page_tab_close_1"

[[nodes.workbench_page_chrome_root.children]]
node = "workbench_page_tab_2"

[[nodes.workbench_page_chrome_root.children]]
node = "workbench_page_tab_close_2"

[nodes.workbench_page_bar]
component = "Container"
control_id = "WorkbenchPageBar"
classes = [ "workbench-tabs" ]

[nodes.workbench_page_bar.props]
surface_variant = "panel"
radius = 0
border_width = 0

[nodes.workbench_page_bar.layout.position]
x = 0
y = 26

[nodes.workbench_page_bar.layout.width]
stretch = "Stretch"

[nodes.workbench_page_bar.layout.height]
min = 32
preferred = 32
max = 32
stretch = "Fixed"

[nodes.workbench_page_project_path]
component = "Label"
control_id = "PageProjectPath"

[nodes.workbench_page_project_path.props]
text = "No project open"
text_tone = "muted"
font_size = "$editor.typography.caption.size"
text_align = "right"
overflow = "elide"

[nodes.workbench_page_project_path.layout.anchor]
x = 1
y = 0

[nodes.workbench_page_project_path.layout.pivot]
x = 1
y = 0

[nodes.workbench_page_project_path.layout.position]
x = -12
y = 35

[nodes.workbench_page_project_path.layout.width]
min = 280
preferred = 280
max = 280
stretch = "Fixed"

[nodes.workbench_page_project_path.layout.height]
min = 14
preferred = 14
max = 14
stretch = "Fixed"

[nodes.workbench_page_tab_0]
component = "Label"
control_id = "PageTab0"
classes = [ "workbench-tab" ]

[nodes.workbench_page_tab_0.props]
text = "Workbench"
surface_variant = "transparent"
radius = "$editor.control.radius.small"
text_tone = "default"
font_size = "$editor.typography.body.size"
text_align = "center"
overflow = "elide"

[nodes.workbench_page_tab_0.layout.position]
