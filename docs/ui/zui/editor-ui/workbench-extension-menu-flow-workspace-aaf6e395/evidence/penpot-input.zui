_flow\" }]\n\n[nodes.menu_flow_validate_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionMenuFlowValidateFocusButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { responsive_min_tier = \"narrow\", text = \"Validate Focus\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 120, preferred = 120, max = 130, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/MenuFlowValidateFocus\", event = \"Click\", route = \"workbench.extension.menu_flow.validate_focus\" }]\n\n[nodes.menu_flow_graph]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionMenuFlowGraph\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"menu_flow_start_node_row\" }, { node = \"menu_flow_options_node_row\" }, { node = \"menu_flow_match_node_row\" }, { node = \"menu_flow_exit_route_row\" }]\n\n[nodes.menu_flow_start_node_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionMenuFlowStartNodeRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Start\", value_text = \"Screen   12,34   selected\", options = [\"Start\",\"Screen\",\"12,34\",\"selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/MenuFlowStartNodeRow\", event = \"Click\", route = \"workbench.extension.menu_flow.node.start\" }]\n\n[nodes.menu_flow_options_node_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionMenuFlowOptionsNodeRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Options\", value_text = \"Screen   focus cycle   OK\", options = [\"Options\",\"Screen\",\"focus cycle\",\"OK\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/MenuFlowOptionsNodeRow\", event = \"Click\", route = \"workbench.extension.menu_flow.node.options\" }]\n\n[nodes.menu_flow_match_node_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionMenuFlowMatchNodeRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Match\", value_text = \"Screen   Route_Play   ready\", options = [\"Match\",\"Screen\",\"Route_Play\",\"ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/MenuFlowMatchNodeRow\", event = \"Click\", route = \"workbench.extension.menu_flow.node.match\" }]\n\n[nodes.menu_flow_exit_route_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionMenuFlowExitRouteRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Exit\", value_text = \"Route   escape/back   warning\", options = [\"Exit\",\"Route\",\"escape/back\",\"warning\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/MenuFlowExitRouteRow\", event = \"Click\", route = \"workbench.extension.menu_flow.route.exit\" }]\n\n[nodes.menu_flow_output]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionMenuFlowOutputRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Menu Flow\", value_text = \"12 screens   28 routes   2 issues\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, options = [\"Menu Flow\",\"12 screens\",\"28 routes\",\"2 issues\"] }\nlayout = { width = { stretch = \"Stretch