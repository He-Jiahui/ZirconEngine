penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/primitives/data/workbench_weight_heatmap.zui\"\nversion = 2\ndisplay_name = \"Workbench Weight Heatmap\"\n\n[imports]\nwidgets = []\nstyles = []\n\n[components.WorkbenchWeightHeatmap]\nroot = \"root\"\ndefault_classes = [\"workbench-weight-heatmap\", \"workbench-primitive\"]\n\n[nodes.root]\ncomponent = \"Canvas\"\ncontrol_id = \"WorkbenchWeightHeatmapRoot\"\nclasses = [\"workbench-weight-heatmap\"]\nprops = { component_variant = \"weight-heatmap\", heatmap_columns = 12, heatmap_rows = 8, low_label = \"0.0\", high_label = \"1.0\", heat_sources = [], input_interactive = false, input_clickable = false, input_focusable = false }\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n"

[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/data/workbench_weight_heatmap.zui"
version = 2
display_name = "Workbench Weight Heatmap"

[imports]
widgets = []
styles = []

[components.WorkbenchWeightHeatmap]
root = "root"
default_classes = [ "workbench-weight-heatmap", "workbench-primitive" ]

[nodes.root]
component = "Canvas"
control_id = "WorkbenchWeightHeatmapRoot"
classes = [ "workbench-weight-heatmap" ]

[nodes.root.props]
component_variant = "weight-heatmap"
heatmap_columns = 12
heatmap_rows = 8
low_label = "0.0"
high_label = "1.0"
heat_sources = []
input_interactive = false
input_clickable = false
input_focusable = false

[nodes.root.layout]
clip = true

[nodes.root.layout.width]
stretch = "Stretch"

[nodes.root.layout.height]
stretch = "Stretch"

