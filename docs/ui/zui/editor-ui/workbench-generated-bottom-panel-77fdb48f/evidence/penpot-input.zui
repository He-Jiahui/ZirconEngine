[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/generated/workbench_generated_bottom_panel.zui"
version = 2
display_name = "Workbench Generated Bottom Panel"

[imports]
widgets = []
styles = []

[components.WorkbenchGeneratedBottomPanel]
root = "generated_bottom_panel"
default_classes = [ "workbench-generated-bottom-panel", "workbench-panel" ]

[nodes.generated_bottom_panel]
component = "VerticalGroup"
control_id = "WorkbenchGeneratedBottomPanel"
classes = [ "workbench-generated-bottom-panel", "workbench-panel" ]

[nodes.generated_bottom_panel.props]
visibility = "visible"

[nodes.generated_bottom_panel.layout]
clip = true

[nodes.generated_bottom_panel.layout.container]
kind = "VerticalBox"
gap = "$editor.density.gap.medium"

[nodes.generated_bottom_panel.layout.width]
stretch = "Stretch"

[nodes.generated_bottom_panel.layout.height]
stretch = "Stretch"

[[nodes.generated_bottom_panel.children]]
node = "generated_bottom_header"

[[nodes.generated_bottom_panel.children]]
node = "generated_bottom_body"

[nodes.generated_bottom_header]
component = "HorizontalGroup"
control_id = "WorkbenchGeneratedBottomHeader"
classes = [ "workbench-panel-toolbar" ]

[nodes.generated_bottom_header.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.medium"

[nodes.generated_bottom_header.layout.width]
stretch = "Stretch"

[nodes.generated_bottom_header.layout.height]
min = "$editor.chrome.workbench_toolbar.command_row.height"
preferred = "$editor.chrome.workbench_toolbar.command_row.height"
max = 36
stretch = "Fixed"

[[nodes.generated_bottom_header.children]]
node = "generated_bottom_title"

[[nodes.generated_bottom_header.children]]
node = "generated_bottom_modes"

[[nodes.generated_bottom_header.children]]
node = "generated_bottom_filter_field"

[[nodes.generated_bottom_header.children]]
node = "generated_bottom_open_button"

[[nodes.generated_bottom_header.children]]
node = "generated_bottom_pin_button"

[nodes.generated_bottom_title]
component = "Label"
control_id = "WorkbenchGeneratedBottomTitle"
classes = [ "workbench-section-title", "workbench-primitive" ]
events = []
children = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle"

[nodes.generated_bottom_title.props]
text = "Generated Bottom Panels"
text_overflow = "ellipsis"
component_variant = "section-title"
font_size = "$editor.typography.heading.size"
font_weight = "$editor.typography.strong.weight"
line_height_ratio = "$editor.typography.line_height"
text_tone = "primary"
responsive_min_tier = "narrow"

[nodes.generated_bottom_title.layout.width]
stretch = "Fixed"
min = 160
preferred = 196
max = 220

[nodes.generated_bottom_title.layout.height]
min = "$editor.control.height.dense"
preferred = "$editor.control.height.dense"
max = "$editor.control.height.compact"
stretch = "Stretch"

[nodes.generated_bottom_title.state]
[nodes.generated_bottom_title.style.self]
[nodes.generated_bottom_title.style.slot]
[nodes.generated_bottom_title.slots]
[nodes.generated_bottom_open_button]
component = "Button"
control_id = "WorkbenchGeneratedBottomOpenButton"
classes = [ "workbench-control-button", "workbench-primitive", "workbench-module-command" ]
children = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton"

[nodes.generated_bottom_open_button.props]
text = "Open"
text_overflow = "ellipsis"
text_align = "center"
button_variant = "filled"
button_color = "accent"
button_size = "small"
button_interaction_state = "normal"
validation_level = "normal"
selected = false
focused = false
hovered = false
pressed = false
disabled = false
background_color = "$editor.surface.1"
hover_background_color = "$editor.surface.hover"
pressed_background_color = "$editor.surface.3"
selected_background_color = "$editor.surface.selected"
