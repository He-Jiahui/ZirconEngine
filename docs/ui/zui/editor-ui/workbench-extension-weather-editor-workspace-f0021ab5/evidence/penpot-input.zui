penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/extensions/world/workbench_extension_weather_editor_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Extension Weather Editor Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n]\nstyles = []\n\n[components.WorkbenchExtensionWeatherEditorWorkspace]\nroot = \"weather_editor_workspace\"\ndefault_classes = [\"workbench-module-body\", \"workbench-extension-module-body\"]\n\n[nodes.weather_editor_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorWorkspace\"\nclasses = [\"workbench-module-body\", \"workbench-extension-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"weather_editor_workspace_main\" },\n  { node = \"weather_editor_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.weather_editor_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"weather_editor_rail_gap\" }, { node = \"weather_editor_left\" }, { node = \"weather_editor_center\" }, { node = \"weather_editor_right_reserve\" }]\n\n[nodes.weather_editor_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.weather_editor_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.weather_editor_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"weather_editor_title\" }, { node = \"weather_editor_left_content\" }]\n\n[nodes.weather_editor_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"weather_editor_storm_row\" }, { node = \"weather_editor_mountains_region_row\" }, { node = \"weather_editor_cloud_layer_row\" }]\n\n[nodes.weather_editor_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorTitle\"\nprops = { text = \"Weather Editor\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.weather_editor_storm_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorStormRow\"\nclasses = [\"workbench-list-row\", \"workbench-row-selected\"]\nprops = { text = \"Weather_Storm\", icon = \"sun\", selected = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/WeatherEditorStormRow\", event = \"Click\", route = \"workbench.extension.weather_editor.weather.storm\" }]\n\n[nodes.weather_editor_mountains_region_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorMountainsRegionRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Region_Mountains\", icon = \"globe\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/WeatherEditorMountainsRegionRow\", event = \"Click\", route = \"workbench.extension.weather_editor.region.mountains\" }]\n\n[nodes.weather_editor_cloud_layer_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorCloudLayerRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Layer_Clouds\", icon = \"file\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/WeatherEditorCloudLayerRow\", event = \"Click\", route = \"workbench.extension.weather_editor.layer.clouds\" }]\n\n[nodes.weather_editor_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"weather_editor_center_header\" }, { node = \"weather_editor_timeline_table\" }, { node = \"weather_editor_output\" }]\n\n[nodes.weather_editor_center_header]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorCenterHeader\"\nclasses = [\"workbench-panel-toolbar\"]\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Never\" }, input_policy = \"Receive\", width = { min = 0.0, stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"weather_editor_center_title\" }, { node = \"weather_editor_header_fill\" }, { node = \"weather_editor_preview_button\" }, { node = \"weather_editor_build_button\" }]\n\n[nodes.weather_editor_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorCenterTitle\"\nprops = { text = \"Weather Timeline\" }\nlayout = { width = { min = 250.0, preferred = 250.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.weather_editor_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.weather_editor_preview_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorPreviewButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { responsive_min_tier = \"narrow\", text = \"Preview\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 86, preferred = 86, max = 96, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/WeatherEditorPreview\", event = \"Click\", route = \"workbench.extension.weather_editor.preview\" }]\n\n[nodes.weather_editor_build_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorBuildButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Build\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 86, preferred = 86, max = 96, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/WeatherEditorBuild\", event = \"Click\", route = \"workbench.extension.weather_editor.build\" }]\n\n[nodes.weather_editor_timeline_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorTimelineTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"weather_editor_cloud_build_timeline_row\" }, { node = \"weather_editor_rain_burst_timeline_row\" }, { node = \"weather_editor_wind_gust_timeline_row\" }, { node = \"weather_editor_lightning_timeline_row\" }]\n\n[nodes.weather_editor_cloud_build_timeline_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorCloudBuildTimelineRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Cloud Build\", value_text = \"00:00-02:00   Ready\", options = [\"Cloud Build\",\"00:00-02:00\",\"Ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred 