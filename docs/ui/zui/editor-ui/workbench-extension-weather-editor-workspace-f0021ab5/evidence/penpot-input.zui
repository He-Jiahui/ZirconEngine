r Details\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.weather_editor_preset_dropdown_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorPresetDropdownPropertyRow\"\nprops = { text = \"Preset\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"weather_editor_preset_dropdown\", slot = { name = \"value\" } }]\n\n[nodes.weather_editor_preset_dropdown]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorPresetDropdown\"\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\nprops = { value_text = \"Storm\", value = \"Storm\", options = [\"Storm\", \"Clear\", \"Fog\", \"Snow\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/WeatherEditorPresetEdit\", event = \"Change\", route = \"workbench.extension.weather_editor.preset.edit\" },\n  { id = \"WorkbenchExtension/WeatherEditorPresetCommit\", event = \"Submit\", route = \"workbench.extension.weather_editor.preset.commit\" },\n]\n\n[nodes.weather_editor_region_dropdown_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorRegionDropdownPropertyRow\"\nprops = { text = \"Region\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"weather_editor_region_dropdown\", slot = { name = \"value\" } }]\n\n[nodes.weather_editor_region_dropdown]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchExtensionWeatherEditorRegionDropdown\"\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\nprops = { value_text = \"Mountains\", value = \"Mountains\", options = [\"Moun