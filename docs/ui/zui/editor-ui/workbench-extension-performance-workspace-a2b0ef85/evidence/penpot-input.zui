 = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PerformanceCaptureFrame\", event = \"Click\", route = \"workbench.extension.performance.capture_frame\" }]\n\n[nodes.performance_filter_samples_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionPerformanceFilterSamplesButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { responsive_min_tier = \"narrow\", text = \"Filter Samples\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 120, preferred = 120, max = 134, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PerformanceFilterSamples\", event = \"Click\", route = \"workbench.extension.performance.filter_samples\" }]\n\n[nodes.performance_timeline]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionPerformanceTimeline\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"performance_game_thread_table_row\" }, { node = \"performance_render_thread_table_row\" }, { node = \"performance_gpu_lighting_table_row\" }, { node = \"performance_texture_upload_table_row\" }]\n\n[nodes.performance_game_thread_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPerformanceGameThreadTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Game Thread\", value_text = \"7.1 ms   Ready\", options = [\"Game Thread\",\"7.1 ms\",\"Ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PerformanceGameThreadTableRow\", event = \"Click\", route = \"workbench.extension.performance.sample.game_thread\" }]\n\n[nodes.performance_render_thread_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPerformanceRenderThreadTableRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Render Thread\", value_text = \"4.8 ms   Selected\", selected = true, options = [\"Render Thread\",\"4.8 ms\",\"Selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PerformanceRenderThreadTableRow\", event = \"Click\", route = \"workbench.extension.performance.sample.render_thread\" }]\n\n[nodes.performance_gpu_lighting_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPerformanceGpuLightingTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"GPU Lighting\", value_text = \"3.2 ms   Hotspot\", options = [\"GPU Lighting\",\"3.2 ms\",\"Hotspot\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PerformanceGpuLightingTableRow\", event = \"Click\", route = \"workbench.extension.performance.sample.gpu_lighting\" }]\n\n[nodes.performance_texture_upload_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionPerformanceTextureUploadTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Texture Upload\", value_text = \"1.4 ms   Warning\", options = [\"Texture Upload\",\"1.4 ms\",\"Warning\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PerformanceTextureUploadTableRow\", event = \"Click\", route = \"workbench.extension.performance.sample.texture_upload\" }]\n\n[nodes.performance_output]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"Workben