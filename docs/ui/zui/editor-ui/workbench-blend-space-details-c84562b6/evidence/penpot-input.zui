penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/composites/animation/workbench_blend_space_details.zui\"\nversion = 2\ndisplay_name = \"Workbench Blend Space Details\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n]\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.WorkbenchBlendSpaceDetails]\nroot = \"root\"\ndefault_classes = [\"workbench-blend-space-details\", \"workbench-composite\"]\n\n[nodes.root]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchBlendSpaceDetailsRoot\"\nclasses = [\"workbench-blend-space-details\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.xsmall\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"samples_title\" }, { node = \"run_forward\" }, { node = \"strafe_left\" }, { node = \"strafe_right\" }, { node = \"idle\" }, { node = \"axes_title\" }, { node = \"horizontal_axis\" }, { node = \"vertical_axis\" }, { node = \"grid_divisions\" }, { node = \"sample_title\" }, { node = \"asset_row\" }, { node = \"x_axis_row\" }, { node = \"interpolation_row\" }, { node = \"sample_position\" }, { node = \"rate_scale\" }, { node = \"fill\" }]\n\n[nodes.samples_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSamplesTitle\"\nprops = { text = \"SAMPLES (8)\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.run_forward]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSampleRunForwardRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Run_Fwd  0  600  1.00\", value = \"run_forward\", options = [\"Run_Fwd\", \"0\", \"600\", \"1.00\"], selected = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceRunSampleTableRow\", event = \"Click\", route = \"workbench.extension.blend_space.run_sample_table_row.select\" }]\n\n[nodes.strafe_left]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSampleStrafeLeftRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Strafe_L  -90  240  0.34\", value = \"strafe_left\", options = [\"Strafe_L\", \"-90\", \"240\", \"0.34\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceWalkSampleTableRow\", event = \"Click\", route = \"workbench.extension.blend_space.walk_sample_table_row.select\" }]\n\n[nodes.strafe_right]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSampleStrafeRightRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Strafe_R  90  240  0.32\", value = \"strafe_right\", options = [\"Strafe_R\", \"90\", \"240\", \"0.32\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceDiagonalSampleTableRow\", event = \"Click\", route = \"workbench.extension.blend_space.diagonal_sample_table_row.select\" }]\n\n[nodes.idle]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSampleIdleRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Idle  0  0  0.18\", value = \"idle\", options = [\"Idle\", \"0\", \"0\", \"0.18\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceIdleSampleTableRow\", event = \"Click\", route = \"workbench.extension.blend_space.idle_sample_table_row.select\" }]\n\n[nodes.axes_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceAxisGroupTitle\"\nprops = { text = \"AXIS SETTINGS\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.horizontal_axis]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceXAxisProperty\"\nprops = { text = \"Horizontal\", value = \"Speed  0 - 620\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.vertical_axis]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceYAxisProperty\"\nprops = { text = \"Vertical\", value = \"Direction  -180 - 180\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.grid_divisions]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceGridDivisionsProperty\"\nprops = { text = \"Grid divisions\", value = \"4 x 4\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.sample_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSampleDetailTitle\"\nprops = { text = \"SAMPLE\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.asset_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceAssetPropertyRow\"\nprops = { text = \"Asset\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"asset\", slot = { name = \"value\" } }]\n\n[nodes.asset]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceAssetDropdown\"\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\nprops = { value_text = \"BS_Locomotion\", value = \"BS_Locomotion\", options = [\"BS_Locomotion\", \"BS_Idle_Run\", \"BS_Strafe_Grid\", \"BS_Sprint_Lean\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/BlendSpaceAssetEdit\", event = \"Change\", route = \"workbench.extension.blend_space.asset.edit\" },\n  { id = \"WorkbenchExtension/BlendSpaceAssetCommit\", event = \"Submit\", route = \"workbench.extension.blend_space.asset.commit\" },\n]\n\n[nodes.x_axis_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceXAxisPropertyRow\"\nprops = { text = \"X Axis\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"x_axis\", slot = { name = \"value\" } }]\n\n[nodes.x_axis]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceXAxisField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"Speed 0-620\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/BlendSpaceXAxisEdit\", event = \"Change\", route = \"workbench.extension.blend_space.x_axis.edit\" },\n  { id = \"WorkbenchExtension/BlendSpaceXAxisCommit\", event = \"Submit\", route = \"workbench.extension.blend_space.x_axis.commit\" },\n]\n\n[nodes.interpolation_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceInterpolationPropertyRow\"\nprops = { text = \"Interpolation\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"interpolation\", slot = { name = \"value\" } }]\n\n[nodes.interpolation]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceInterpolationDropdown\"\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\nprops = { value_text = \"Triangulated\", value = \"Triangulated\", options = [\"Triangulated\", \"Grid\", \"Weighted\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/BlendSpaceInterpolationEdit\", event = \"Change\", route = \"workbench.extension.blend_space.interpolation.edit\" },\n  { id = \"WorkbenchExtension/BlendSpaceInterpolationCommit\", event = \"Submit\", route = \"workbench.extension.blend_space.interpolation.commit\" },\n]\n\n[nodes.sample_position]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSamplePositionProperty\"\nprops = { text = \"Sample position\", value = \"420, 0\" }\n# The 14px label wraps at the compact property-row width. Reserve a second\n# line in flow so the semantic label is never painted outside its scroll row.\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 48.0, max = 48.0, stretch = \"Fixed\" } }\n\n[nodes.rate_scale]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSampleRateProperty\"\nprops = { text = \"Rate scale\", value = \"1.00\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceRightFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n"

