stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.details_library_row]\ncomponent = \"HorizontalBox\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"details_library_label\" }, { node = \"details_library_value\" }]\n\n[nodes.details_catalog_gap]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.medium\", preferred = \"$editor.density.gap.medium\", max = \"$editor.density.gap.medium\", stretch = \"Fixed\" } }\n\n[nodes.catalog_panel]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ProjectOverviewCatalogPanel\"\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 132.0, preferred = 132.0, max = 132.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"catalog_top_space\" }, { node = \"catalog_label\" }, { node = \"catalog_summary_value\" }, { node = \"catalog_open_assets_button\" }, { node = \"catalog_open_browser_button\" }, { node = \"catalog_bottom_space\" }]\n\n[nodes.catalog_top_space]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.small\", preferred = \"$editor.density.gap.small\", max = \"$editor.density.gap.small\", stretch = \"Fixed\" } }\n\n[nodes.catalog_bottom_space]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.small\", preferred = \"$editor.density.gap.small\", max = \"$editor.density.gap.small\", stretch = \"Fixed\" } }\n\n[nodes.catalog_label]\ncomponent = \"Label\"\nprops = { text = \"Content\", text_tone = \"muted\", font_weight = \"$editor.typography.strong.weight\", overflow = \"elide\" }\nlayout = { width = { st