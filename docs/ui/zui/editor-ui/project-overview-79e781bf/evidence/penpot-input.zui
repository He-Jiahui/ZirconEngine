anel\" }, { node = \"right_space\" }]\n\n[nodes.outer_panel]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ProjectOverviewOuterPanel\"\nlayout = { container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"content_stack\" }]\n\n[nodes.header_title_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ProjectOverviewHeaderTitleRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"header_title_text\" }]\n\n[nodes.header_title_text]\ncomponent = \"Label\"\ncontrol_id = \"ProjectOverviewTitleText\"\nprops = { text = \"Project\", font_weight = \"$editor.typography.strong.weight\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_path_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"ProjectOverviewHeaderPathRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"header_path_text\" }]\n\n[nodes.header_path_text]\ncomponent = \"Label\"\ncontrol_id = \"ProjectOverviewPathText\"\nprops = { text = \"\", text_tone = \"muted\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.header_details_gap]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.large\", preferred = \"$editor.density.gap.large\", max = \"$editor.density.gap.large\", stretch = \"Fixed\" } }\n\n[nodes.details_panel]\ncomponent = \"VerticalBox\"\ncontrol_id = \"ProjectOverviewDetailsPanel\"\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 144.0, preferred = 144.0, max = 144.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"details_top_space\" }, { node = \"details_title\" }, { node = \"details_default_scene_row\" }, { node = \"details_assets_root_row\" }, { node = \"details_library_row\" }, { node = \"details_bottom_space\" }]\n\n[nodes.details_top_space]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.small\", preferred = \"$editor.density.gap.small\", max = \"$editor.density.gap.small\", stretch = \"Fixed\" } }\n\n[nodes.details_bottom_space]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.small\", preferred = \"$editor.density.gap.small\", max = \"$editor.density.gap.small\", stretch = \"Fixed\" } }\n\n[nodes.details_title]\ncomponent = \"Label\"\nprops = { text = \"Project Settings\", text_tone = \"muted\", font_weight = \"$editor.typography.strong.weight\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = \"Fixed\" } }\n\n[nodes.details_default_scene_label]\ncomponent = \"Label\"\nprops = { text = \"Default Scene\", text_tone = \"muted\", overflow = \"elide\" }\nlayout = { width = { min = 0.0, preferred = 92.0, max = 92.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.details_default_scene_value]\ncomponent = \"Overlay\"\ncontrol_id = \"ProjectOverviewDefaultSceneValue\"\nprops = { surface_variant = \"inset\", radius = \"$editor.control.radius.small\", border_width = \"$editor.control.border_width\", overflow = \"elide\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.details_default_scene_row]\ncomponent = \"HorizontalBox\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.g