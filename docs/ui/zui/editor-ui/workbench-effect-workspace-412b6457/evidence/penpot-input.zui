[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/core/gameplay/workbench_effect_workspace.zui"
version = 2
display_name = "Workbench Effect Workspace"

[imports]
widgets = []
styles = []

[components.WorkbenchEffectWorkspace]
root = "effect_workspace"
default_classes = [ "workbench-module-body" ]

[nodes.effect_workspace]
component = "Overlay"
control_id = "WorkbenchModuleEffectWorkspace"
classes = [ "workbench-module-body" ]

[nodes.effect_workspace.layout]
clip = true

[nodes.effect_workspace.layout.container]
kind = "Overlay"

[nodes.effect_workspace.layout.width]
stretch = "Stretch"

[nodes.effect_workspace.layout.height]
stretch = "Stretch"

[[nodes.effect_workspace.children]]
node = "effect_workspace_main"

[[nodes.effect_workspace.children]]
node = "effect_right"

[nodes.effect_workspace.children.slot.layout]
z_order = 20

[nodes.effect_workspace.children.slot.layout.alignment]
horizontal = "End"
vertical = "Fill"

[nodes.effect_workspace.props]
visibility = "visible"

[nodes.effect_workspace_main]
component = "HorizontalGroup"
classes = [ "workbench-module-layout-main" ]

