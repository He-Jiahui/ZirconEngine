" }, { node = \"effect_apply_button\" }]\n\n[nodes.effect_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchEffectCenterTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"GE_HealthRegen\" }\nlayout = { width = { min = 180.0, preferred = 180.0, max = 240.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.effect_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchEffectHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.effect_apply_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchEffectApplyButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Apply\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 76, preferred = 76, max = 86, stretch = \"Fixed\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/EffectApply\", event = \"Click\", route = \"workbench.module.effect.apply\" }]\n\n[nodes.effect_canvas]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchEffectCanvas\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.regular\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"effect_duration_row\" }, { node = \"effect_period_row\" }, { node = \"effect_policy_row\" }, { node = \"effect_mod_table\" }, { node = \"effect_mod_health_row\" }, { node = \"effect_mod_healing_row\" }, { node = \"effect_mod_cap_row\" }, { node = \"effect_graph_title\" }, { node = \"effect_graph_row\" }]\n\n[nodes.effect_duration_row]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchEffectDurationRow\"\nclasses = [\"workbench-property-row\"]\nprops = { text = \"Duration\", value = \"10.0 s\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/EffectDurationRow\", event = \"Click\", route = \"workbench.module.effect.duration\" }]\n\n[nodes.effect_period_row]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchEffectPeriodRow\"\nclasses = [\"workbench-property-row\"]\nprops = { text = \"Period\", value = \"1.0 s\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/EffectPeriodRow\", event = \"Click\", route = \"workbench.module.effect.period\" }]\n\n[nodes.effect_policy_row]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchEffectPolicyDropdown\"\nclasses = [\"workbench-field\", \"workbench-dropdown\"]\nprops = { value = \"has_duration\", value_text = \"Has Duration\", options = [\"instant|label=Instant\", \"has_duration|label=Has Duration\", \"infinite|label=Infinite\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/EffectPolicyEdit\", event = \"Change\", route = \"workbench.module.effect.policy.edit\" },\n  { id = \"WorkbenchModule/EffectPolicyCommit\", event = \"Submit\", route = \"workbench.module.effect.policy.commit\" },\n]\n\n[nodes.effect_mod_table]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchEffectModifierTable\"\nclasses = [\"workbench-table-row\", \"workbench-table-header\"]\nprops = { text = \"Attribute     Op       Value       Source\", value = \"modifier\", options = [\"Health\", \"Add\", \"+5.0\", \"Periodic\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.effect_mod_health_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchEffectModifierHealthRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"HealthRegen     Health        Additive       Scalable Float\", value = \"health_regen\", options = [\"HealthRegen\", \"Health\", \"Additive\", \"Scalable Float\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/EffectModifierHealth\", event = \"Click\", route = \"workbench.module.effect.modifier.health_regen\" }]\n\n[nodes.effect_mod_healing_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchEffectModifierHealingRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"IncomingHealing Healing       Multiply       Scalable Float\", value = \"incoming_healing\", options = [\"IncomingHealing\", \"Healing\", \"Multiply\", \"Scalable Float\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/EffectModifierHealing\", event = \"Click\", route = \"workbench.module.effect.modifier.incoming_healing\" }]\n\n[nodes.effect_mod_cap_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchEffectModifierCapRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"MaxHealthCap    Max Health    Additive       Captured Attribute\", value = \"max_health_cap\", options = [\"MaxHealthCap\", \"Max Health\", \"Additive\", \"Captured Attribute\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/EffectModifierCap\", event = \"Click\", route = \"workbench.module.effect.modifier.max_health_cap\" }]\n\n[nodes.effect_graph_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchEffectGraphTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Dependency Graph\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.effect_graph_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchEffectGraphRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Source HealthRegen  ->  Health Attribute  ->  Clamp Health\", value = \"effect_graph\", options = [\"Source HealthRegen\", \"Health Attribute\", \"Clamp Health\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/EffectGraphSelect\", event = \"Click\", route = \"workbench.module.effect.graph.select\" }]\n\n[nodes.effect_output]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchEffectOutputRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Simulation Output: +50 health over 10 seconds\", value = \"effect_output\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.effect_right]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchEffectRightPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"effect_details_title\" }, { node = \"effect_right_content\" }]\n\n[nodes.effect_right_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchEffectRightContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"effect_name_property_row\" }, { node = \"effect_tag_property_row\" }, { node = \"effect_stack_property_row\" }, { node = \"effect_magnitude_property_row\" }, { node = \"effect_attribute_preview_row\" }]\n\n[nodes.effect_details_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchEffectDetailsTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Details\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.effect_name_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchEffectNamePropertyRow\"\nprops = { text = \"Name\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"effect_name_field\", slot = { name = \"value\" } }]\n\n[nodes.effect_name_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchEffectNameField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"GE_HealthRegen\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/EffectNameEdit\", event = \"Change\", route = \"workbench.module.effect.name.edit\" },\n  { id = \"WorkbenchModule/EffectNameCommit\", event = \"Submit\", route = \"workbench.module.effect.name.commit\" },\n]\n\n[nodes.effect_tag_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchEffectTagPropertyRow\"\nprops = { text = \"Gameplay Tag\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"effect_tag_field\", slot = { name = \"value\" } }]\n\n[nodes.effect_tag_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchEffectT