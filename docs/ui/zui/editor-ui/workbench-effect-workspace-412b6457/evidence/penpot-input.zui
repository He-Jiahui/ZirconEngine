[nodes.effect_workspace_main.layout.height]
stretch = "Stretch"

[[nodes.effect_workspace_main.children]]
node = "effect_rail_gap"

[[nodes.effect_workspace_main.children]]
node = "effect_left"

[[nodes.effect_workspace_main.children]]
node = "effect_center"

[[nodes.effect_workspace_main.children]]
