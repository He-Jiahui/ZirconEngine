penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/core/gameplay/workbench_effect_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Effect Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n]\nstyles = []\n\n[components.WorkbenchEffectWorkspace]\nroot = \"effect_workspace\"\ndefault_classes = [\"workbench-module-body\"]\n\n[nodes.effect_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchModuleEffectWorkspace\"\nclasses = [\"workbench-module-body\"]\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"effect_workspace_main\" },\n  { node = \"effect_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.effect_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"effect_rail_gap\" }, { node = \"effect_left\" }, { node = \"effect_center\" }, { node = \"effect_right_reserve\" }]\n\n[nodes.effect_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.effect_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchEffectRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.effect_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchEffectLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"effect_title\" }, { node = \"effect_left_content\" }]\n\n[nodes.effect_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchEffectLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"effect_asset_search\" }, { node = \"effect_health_regen_row\" }, { node = \"effect_damage_fire_row\" }, { node = \"effect_search_empty\" }, { node = \"effect_stack_row\" }, { node = \"effect_cue_row\" }]\n\n[nodes.effect_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchEffectTitle\"\nclasses = [\"workbench-section-title\"]\nprops = { text = \"Gameplay Effect\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.effect_asset_search]\ncomponent = \"WorkbenchSearchInput\"\ncontrol_id = \"WorkbenchEffectAssetSearch\"\nprops = { query = \"\", placeholder = \"Search effects\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/EffectSearchEdit\", event = \"Change\", route = \"workbench.module.effect.search.edit\" },\n  { id = \"WorkbenchModule/EffectSearchCommit\", event = \"Submit\", route = \"workbench.module.effect.search.commit\" },\n]\n\n[nodes.effect_health_regen_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchEffectHealthRegenRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"GE_HealthRegen\", value = \"ge_health_regen\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/EffectHealthRegenRow\", event = \"Click\", route = \"workbench.module.effect.asset.health_regen\" }]\n\n[nodes.effect_damage_fire_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchEffectDamageFireRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"GE_DamageFire\", value = \"ge_damage_fire\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/EffectDamageFireRow\", event = \"Click\", route = \"workbench.module.effect.asset.damage_fire\" }]\n\n[nodes.effect_sea