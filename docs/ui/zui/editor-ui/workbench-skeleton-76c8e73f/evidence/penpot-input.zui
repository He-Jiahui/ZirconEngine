penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/shell/workbench_skeleton.zui\"\nversion = 2\ndisplay_name = \"Workbench Skeleton\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/shell/workbench_top_toolbar.zui#WorkbenchTopToolbar\",\n  \"res://ui/editor/components/workbench/shell/workbench_activity_rail.zui#WorkbenchActivityRail\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_tab_strip.zui#WorkbenchTabStrip\",\n  \"res://ui/editor/components/workbench/shell/workbench_main_band.zui#WorkbenchMainBand\",\n  \"res://ui/editor/components/workbench/shell/workbench_status_bar.zui#WorkbenchStatusBar\",\n]\nstyles = [\n  \"res://ui/theme/editor_workbench_spatial.zui\",\n]\n\n[components.WorkbenchSkeleton]\nroot = \"skeleton\"\ndefault_classes = [\"workbench-skeleton\"]\n\n[nodes.skeleton]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchSkeleton\"\nclasses = [\"workbench-skeleton\"]\nstyle = { self = { background = { color = \"$editor.surface.0\" }, foreground = { color = \"$editor.text.primary\" }, border = { color = \"$editor.border\", width = 0.0, radius = 0.0 } } }\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"top_toolbar\" }, { node = \"document_tabs\" }, { node = \"main_band\" }, { node = \"status_bar\" }]\n\n[nodes.top_toolbar]\ncomponent = \"WorkbenchTopToolbar\"\ncontrol_id = \"WorkbenchSkeletonTopToolbar\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.chrome.workbench_toolbar.height\", preferred = \"$editor.chrome.workbench_toolbar.height\", max = \"$editor.chrome.workbench_toolbar.height\", stretch = \"Fixed\" } }\n\n[nodes.document_tabs]\ncomponent = \"WorkbenchTabStrip\"\ncontrol_id = \"WorkbenchSkeletonDocumentTabs\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\n\n[nodes.main_band]\ncomponent = \"WorkbenchMainBand\"\ncontrol_id = \"WorkbenchSkeletonMainBand\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.status_bar]\ncomponent = \"WorkbenchStatusBar\"\ncontrol_id = \"WorkbenchSkeletonStatusBar\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.chrome.status_bar.height\", preferred = \"$editor.chrome.status_bar.height\", max = \"$editor.chrome.status_bar.height\", stretch = \"Fixed\" } }\n"

[asset]
kind = "component"
id = "res://ui/editor/components/workbench/shell/workbench_skeleton.zui"
version = 2
display_name = "Workbench Skeleton"

[imports]
widgets = []
styles = []

[components.WorkbenchSkeleton]
root = "skeleton"
default_classes = [ "workbench-skeleton" ]

[nodes.skeleton]
component = "VerticalGroup"
control_id = "WorkbenchSkeleton"
classes = [ "workbench-skeleton" ]

[nodes.skeleton.style.self.background]
color = "$editor.surface.0"

[nodes.skeleton.style.self.foreground]
color = "$editor.text.primary"

[nodes.skeleton.style.self.border]
color = "$editor.border"
width = 0
radius = 0

[nodes.skeleton.layout]
clip = true

[nodes.skeleton.layout.container]
kind = "VerticalBox"
gap = 0

[nodes.skeleton.layout.width]
stretch = "Stretch"

[nodes.skeleton.layout.height]
stretch = "Stretch"

[[nodes.skeleton.children]]
node = "top_toolbar"

[[nodes.skeleton.children]]
node = "document_tabs"

[[nodes.skeleton.children]]
node = "main_band"

[[nodes.skeleton.children]]
node = "status_bar"

[nodes.top_toolbar]
component = "VerticalGroup"
control_id = "WorkbenchSkeletonTopToolbar"
classes = [ "workbench-topbar" ]
events = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/shell/workbench_top_toolbar.zui#WorkbenchTopToolbar"

[nodes.top_toolbar.props]
background_color = "$editor.surface.2"
hover_background_color = "$editor.surface.hover"
pressed_background_color = "$editor.surface.3"
selected_background_color = "$editor.surface.selected"
disabled_background_color = "$editor.surface.disabled"
border_color = "$editor.border"
border_width = 0
focus_border_color = "$editor.focus.ring"
separator_edge = "bottom"
separator_color = "$editor.separator.soft"
separator_thickness = "$editor.control.border_width"
foreground_color = "$editor.text.secondary"
active_foreground_color = "$editor.text.primary"
disabled_foreground_color = "$editor.text.disabled"
icon_color = "$editor.text.secondary"
active_icon_color = "$editor.accent"
font_size = "$editor.typography.body.size"
line_height_ratio = "$editor.typography.line_height"
layout_padding_left = "$editor.density.gap.medium"
layout_padding_right = "$editor.density.gap.medium"
layout_padding_vertical = "$editor.density.gap.small"
layout_spacing = "$editor.density.gap.small"

[nodes.top_toolbar.layout.container]
kind = "VerticalBox"
gap = "$editor.density.gap.small"

[nodes.top_toolbar.layout.width]
stretch = "Stretch"

[nodes.top_toolbar.layout.height]
min = "$editor.chrome.workbench_toolbar.height"
preferred = "$editor.chrome.workbench_toolbar.height"
max = "$editor.chrome.workbench_toolbar.height"
stretch = "Fixed"

[[nodes.top_toolbar.children]]
node = "top_toolbar__toolbar_command_row"

[[nodes.top_toolbar.children]]
node = "top_toolbar__toolbar_module_tabs"

[nodes.top_toolbar.state]
[nodes.top_toolbar.style.self]
[nodes.top_toolbar.style.slot]
[nodes.top_toolbar.slots]
[nodes.document_tabs]
component = "Tabs"
control_id = "WorkbenchSkeletonDocumentTabs"
classes = [ "workbench-tabs", "workbench-tab-strip", "workbench-primitive" ]
children = []
events = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_tab_strip.zui#WorkbenchTabStrip"

[nodes.document_tabs.props]
value = "overview"
selected_index = 0
options = [ "overview", "details", "stats" ]
orientation = "horizontal"
selection_state = "single"
selection_follows_focus = true
layout_gap = 0
layout_min_height = "$editor.control.height.dense"
input_interactive = true
input_clickable = true
input_hoverable = true
input_focusable = true

[nodes.document_tabs.layout.container]
