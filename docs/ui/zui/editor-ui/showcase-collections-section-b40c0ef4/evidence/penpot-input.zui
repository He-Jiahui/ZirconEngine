penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui" ]
penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/showcase/showcase_collections_section.zui\"\nversion = 2\ndisplay_name = \"Showcase Collections Section\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.ShowcaseCollectionsSection]\nroot = \"collections_section_root\"\ndefault_classes = [\"showcase-panel\", \"material-surface\"]\n\n[nodes.section_title]\ncomponent = \"Label\"\ncontrol_id = \"ComponentShowcaseCollectionsSectionTitle\"\nclasses = [\"showcase-section-title\"]\nprops = { text = \"Collections and Inspector Structures\", font_size = \"$editor.typography.body.size\", font_weight = \"$editor.typography.emphasis.weight\" }\n# The compact App Shell main slot wraps this title; reserve two body lines so\n# the collection surface keeps its full semantic heading in flow.\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" } }\n\n[nodes.group_demo]\ncomponent = \"Group\"\ncontrol_id = \"GroupDemo\"\nclasses = [\"showcase-panel\", \"material-control\"]\nprops = { text = \"Foldout Group\", expanded = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 96.0, preferred = 96.0, max = 96.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/GroupToggled\", event = \"Toggle\", component_event = \"ToggleExpanded\", route = \"component_lab.showcase.toggle_expanded.group\" },\n]\n\n[nodes.foldout_demo]\ncomponent = \"Foldout\"\ncontrol_id = \"FoldoutDemo\"\nclasses = [\"showcase-panel\", \"material-control\"]\nprops = { text = \"Foldout\", expanded = false, validation_level = \"normal\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/FoldoutToggled\", event = \"Toggle\", component_event = \"ToggleExpanded\", route = \"component_lab.showcase.toggle_expanded.foldout\" },\n]\n\n[nodes.property_row_demo]\ncomponent = \"PropertyRow\"\ncontrol_id = \"PropertyRowDemo\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Property Row\", value = \"Label + Field\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.inspector_section_demo]\ncomponent = \"InspectorSection\"\ncontrol_id = \"InspectorSectionDemo\"\nclasses = [\"showcase-panel\", \"material-control\"]\nprops = { text = \"Inspector Section\", expanded = true, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/InspectorSectionToggled\", event = \"Toggle\", component_event = \"ToggleExpanded\", route = \"component_lab.showcase.toggle_expanded.inspector_section\" },\n]\n\n[nodes.array_field_demo]\ncomponent = \"ArrayField\"\ncontrol_id = \"ArrayFieldDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { items = [\"Label\", \"NumberField\", \"AssetField\"], value_text = \"3 elements\", element_type = \"UiComponentRef\", validation_level = \"normal\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/ArrayFieldChanged\", event = \"Change\", component_event = \"ValueChanged\", route = \"component_lab.showcase.value_changed.array_field\" },\n  { id = \"UiComponentShowcase/ArrayFieldAddElement\", event = \"Submit\", component_event = \"AddElement\", route = \"component_lab.showcase.add_element.array_field\" },\n  { id = \"UiComponentShowcase/ArrayFieldSetElement\", event = \"Submit\", component_event = \"SetElement\", route = \"component_lab.showcase.set_element.array_field\" },\n  { id = \"UiComponentShowcase/ArrayFieldRemoveElement\", event = \"Submit\", component_event = \"RemoveElement\", route = \"component_lab.showcase.remove_element.array_field\" },\n  { id = \"UiComponentShowcase/ArrayFieldMoveElement\", event = \"DragEnd\", component_event = \"MoveElement\", route = \"component_lab.showcase.move_element.array_field\" },\n]\n\n[nodes.map_field_demo]\ncomponent = \"MapField\"\ncontrol_id = \"MapFieldDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { entries = { speed = 1.0, visible = true }, value_text = \"2 entries\", key_type = \"String\", value_type = \"UiValue\", validation_level = \"normal\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/MapFieldChanged\", event = \"Change\", component_event = \"ValueChanged\", route = \"component_lab.showcase.value_changed.map_field\" },\n  { id = \"UiComponentShowcase/MapFieldAddEntry\", event = \"Submit\", component_event = \"AddMapEntry\", route = \"component_lab.showcase.add_map_entry.map_field\" },\n  { id = \"UiComponentShowcase/MapFieldSetEntry\", event = \"Submit\", component_event = \"SetMapEntry\", route = \"component_lab.showcase.set_map_entry.map_field\" },\n  { id = \"UiComponentShowcase/MapFieldRemoveEntry\", event = \"Submit\", component_event = \"RemoveMapEntry\", route = \"component_lab.showcase.remove_map_entry.map_field\" },\n]\n\n[nodes.list_row_demo]\ncomponent = \"ListRow\"\ncontrol_id = \"ListRowDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { text = \"List Row\", value = \"selected\", selected = true, focused = true, hovered = true, pressed = false, layout_padding_left = \"$editor.density.gap.medium\", layout_padding_right = \"$editor.density.gap.medium\", layout_spacing = \"$editor.density.gap.small\", layout_min_height = \"$editor.control.height.default\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/ListRowClicked\", event = \"Click\", route = \"component_lab.showcase.select.list_row\" },\n  { id = \"UiComponentShowcase/ListRowHovered\", event = \"Hover\", component_event = \"Hover\", route = \"component_lab.showcase.hover.list_row\" },\n  { id = \"UiComponentShowcase/ListRowPressed\", event = \"Press\", component_event = \"Press\", route = \"component_lab.showcase.press.list_row\" },\n]\n\n[nodes.table_row_demo]\ncomponent = \"TableRow\"\ncontrol_id = \"TableRowDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { text = \"Table Row\", value = \"row-42\", selected = true, focused = true, hovered = false, pressed = false, layout_padding_left = \"$editor.density.gap.medium\", layout_padding_right = \"$editor.density.gap.medium\", layout_spacing = \"$editor.density.gap.small\", layout_min_height = \"$editor.control.height.default\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.virtual_list_demo]\ncomponent = \"VirtualList\"\ncontrol_id = \"VirtualListDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { items = [\"Row 0\", \"Row 1\", \"Row 2\", \"Row 3\", \"Row 4\", \"Row 5\", \"Row 6\", \"Row 7\"], total_count = 10000, viewport_start = 0, viewport_count = 25, item_extent = 28.0, layout_padding_left = \"$editor.density.gap.medium\", layout_padding_right = \"$editor.density.gap.medium\", layout_spacing = \"$editor.density.gap.small\", layout_min_height = \"$editor.control.height.default\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 104.0, preferred = 104.0, max = 104.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/VirtualListScrolled\", event = \"Scroll\", component_event = \"SetVisibleRange\", route = \"component_lab.showcase.set_visible_range.virtual_list\" },\n]\n\n[nodes.paged_list_demo]\ncomponent = \"PagedList\"\ncontrol_id = \"PagedListDemo\"\nclasses = [\"showcase-field\"]\nprops = { data_source = \"showcase.large_items\", total_count = 10000, page_index = 0, page_size = 100, page_count = 100, items = [\"Page row 0\", \"Page row 1\", \"Page row 2\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/PagedListNextPage\", event = \"Click\", component_event = \"SetPage\", route = \"component_lab.showcase.set_page.paged_list\" },\n]\n\n[nodes.world_space_surface_demo]\ncomponent = \"WorldSpaceSurface\"\ncontrol_id = \"WorldSpaceSurfaceDemo\"\nclasses = [\"showcase-field\"]\nprops = { world_position = [0.0, 1.5, 3.0], world_rotation = [0.0, 180.0, 0.0], world_scale = [1.0, 1.0, 1.0], world_size = [2.0, 1.0], pixels_per_meter = 256.0, billboard = true, depth_test = true, render_order = 0, camera_target = \"viewport-main\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/WorldSpaceSurfaceMoved\", event = \"DragEnd\", component_event = \"SetWorldTransform\", route = \"component_lab.showcase.set_world_transform.world_space_surface\" },\n  { id = \"UiComponentShowcase/WorldSpaceSurfaceConfigured\", event = \"Submit\", component_event = \"SetWorldSurface\", route = \"component_lab.showcase.set_world_surface.world_space_surface\" },\n]\n\n[nodes.tree_row_demo]\ncomponent = \"TreeRow\"\ncontrol_id = \"TreeRowDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { text = \"Tree Row\", expanded = true, tree_depth = 2, tree_indent_px = 24.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/TreeRowToggled\", event = \"Toggle\", component_event = \"ToggleExpanded\", route = \"component_lab.showcase.toggle_expanded.tree_row\" },\n]\n\n[nodes.context_action_menu_demo]\ncomponent = \"ContextActionMenu\"\ncontrol_id = \"ContextActionMenuDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { value = \"Inspect\", menu_items = [\"Inspect|checked,focused|Ctrl+I\", \"---\", \"Duplicate|hovered,pressed|Ctrl+D\", \"Delete|disabled|Del\"], popup_open = true, popup_anchor_x = 156.0, popup_anchor_y = 24.0, layout_padding_left = \"$editor.density.gap.medium\", layout_padding_right = \"$editor.density.gap.medium\", layout_spacing = \"$editor.density.gap.small\", layout_min_height = \"$editor.control.height.default\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 132.0, preferred = 132.0, max = 132.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/ContextActionMenuChanged\", event = \"Change\", component_event = \"SelectOption\", route = \"component_lab.showcase.select_option.context_action_menu\" },\n  { id = \"UiComponentShowcase/ContextActionMenuOpenPopup\", event = \"Click\", component_event = \"OpenPopup\", route = \"component_lab.showcase.open_popup.context_action_menu\" },\n  { id = \"UiComponentShowcase/ContextActionMenuOpenAt\", event = \"Press\", component_event = \"OpenPopupAt\", route = \"component_lab.showcase.open_popup_at.context_action_menu\" },\n  { id = \"UiComponentShowcase/ContextActionMenuClosePopup\", event = \"Click\", component_event = \"ClosePopup\", route = \"component_lab.showcase.close_popup.context_action_menu\" },\n]\n\n[nodes.collections_section_root]\ncomponent = \"ScrollableBox\"\nclasses = [\"showcase-panel\", \"material-surface\"]\nlayout = { width = { min = 0, stretch = \"Stretch\" }, clip = true, input_policy = \"Receive\", container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Auto\" }, height = { min = 0, stretch = \"Stretch\" } }\nchildren = [\n  { node = \"section_title\" },\n  { node = \"group_demo\", slot = { name = \"content\" } },\n  { node = \"foldout_demo\", slot = { name = \"content\" } },\n  { node = \"property_row_demo\", slot = { name = \"content\" } },\n  { node = \"inspector_section_demo\", slot = { name = \"content\" } },\n  { node = \"array_field_demo\", slot = { name = \"content\" } },\n  { node = \"map_field_demo\", slot = { name = \"content\" } },\n  { node = \"list_row_demo\", slot = { name = \"content\" } },\n  { node = \"table_row_demo\", slot = { name = \"content\" } },\n  { node = \"virtual_list_demo\", slot = { name = \"content\" } },\n  { node = \"paged_list_demo\", slot = { name = \"content\" } },\n  { node = \"world_space_surface_demo\", slot = { name = \"content\" } },\n  { node = \"tree_row_demo\", slot = { name = \"content\" } },\n  { node = \"context_action_menu_demo\", slot = { name = \"content\" } },\n]\n"

[asset]
kind = "component"
id = "res://ui/editor/components/showcase/showcase_collections_section.zui"
version = 2
display_name = "Showcase Collections Section"

[imports]
