[asset]
kind = "component"
id = "res://ui/editor/material_components/inputs/material_buttons.zui"
version = 2
display_name = "Material Buttons Prototype"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption"]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.MaterialButtonsPrototype]
root = "root"
default_classes = ["material-lab-prototype", "material-surface"]

[nodes.title]
component = "WorkbenchLabel"
control_id = "buttons_Title"
classes = ["material-lab-title"]
props = { "text" = "Buttons", "text_tone" = "primary", "font_size" = "$editor.typography.title.size", "font_weight" = "$editor.typography.strong.weight", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 28, "preferred" = 28, "max" = 28, "stretch" = "Fixed" } }

[nodes.meta]
component = "GridBox"
control_id = "buttons_Meta"
classes = ["material-lab-meta-strip", "material-lab-meta"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 156, "preferred" = 156, "max" = 156, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 2, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "meta_group" },
  { node = "meta_response" },
  { node = "meta_variant" },
  { node = "meta_layout" },
]

[nodes.meta_group]
component = "WorkbenchCaption"
control_id = "buttons_MetaGroup"
classes = ["material-lab-meta-chip", "material-lab-meta-group"]
props = { "text" = "Inputs", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 56, "preferred" = 56, "max" = 56, "stretch" = "Fixed" } }

[nodes.meta_response]
component = "WorkbenchCaption"
control_id = "buttons_MetaResponse"
classes = ["material-lab-meta-chip", "material-lab-meta-response"]
props = { "text" = "click / press", "text_tone" = "success", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "response_mechanism" = "click / press", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 56, "preferred" = 56, "max" = 56, "stretch" = "Fixed" } }
[nodes.meta_variant]
component = "WorkbenchCaption"
control_id = "buttons_MetaVariant"
classes = ["material-lab-meta-chip", "material-lab-meta-variant"]
props = { "text" = "filled / outlined / text / tonal / elevated", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "variant" = "filled / outlined / text / tonal / elevated", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 96, "preferred" = 96, "max" = 96, "stretch" = "Fixed" } }

[nodes.meta_layout]
component = "WorkbenchCaption"
control_id = "buttons_MetaLayout"
classes = ["material-lab-meta-chip", "material-lab-meta-layout"]
props = { "text" = "inline controls", "text_tone" = "warning", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "layout_mode" = "inline controls", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 96, "preferred" = 96, "max" = 96, "stretch" = "Fixed" } }
[nodes.sample]
component = "Button"
control_id = "buttons_Sample"
classes = ["material-control", "material-lab-sample", "material-button-primary"]
props = { text = "Filled Button", surface_variant = "elevated", button_variant = "contained", slint_material_button_variant = "filled", button_color = "primary", button_size = "medium", icon_placement = "none", text_tone = "primary", validation_level = "normal", hovered = true, pressed = false, focused = true, selected = true, checked = true, disabled = false, open = true, popup_open = true, corner_radius = 4, border_width = 1, button_horizontal_padding = 24, button_vertical_padding = 10, button_spacing = 8, min_layout_width = 40, min_layout_height = 40, icon_size = 18, hover_elevation = 1, state_layer_enabled = true, ripple_enabled = true, clip_ripple = true, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
style = { self = { button_variant = "contained", button_color = "primary", button_size = "medium", icon_placement = "none", background = { color = "material.primary" }, foreground = { color = "material.on_primary" }, border = { color = "material.focus_ring", width = 2.0, radius = 10.0 } } }
layout = { width = { stretch = "Stretch" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }
events = [
  { id = "MaterialLab/Buttons/Click", event = "Click", route = "material_lab.buttons.click" },
]

[nodes.state_strip]
component = "GridBox"
control_id = "buttons_StateStrip"
classes = ["material-lab-state-strip"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 108, "preferred" = 108, "max" = 108, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "state_default" },
  { node = "state_hover" },
  { node = "state_pressed" },
  { node = "state_focus" },
  { node = "state_disabled" },
  { node = "state_selected" },
  { node = "state_open" },
  { node = "state_error" },
]
[nodes.state_default]
component = "WorkbenchCaption"
control_id = "buttons_StateDefault"
classes = ["material-lab-state-pill", "material-lab-state-default"]
props = { "text" = "Default", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "default", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
style = { "self" = { "button_variant" = "default", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "border" = { "color" = "material.outline", "width" = 0, "radius" = 0 }, "background" = { "color" = "transparent" } } }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.state_hover]
component = "WorkbenchCaption"
control_id = "buttons_StateHover"
classes = ["material-lab-state-pill", "material-lab-state-hover"]
props = { "text" = "Hover", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "validation_level" = "normal", "hovered" = true, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
style = { "self" = { "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "background" = { "color" = "transparent" }, "border" = { "color" = "material.focus_ring", "width" = 0, "radius" = 0 } } }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.state_pressed]
component = "WorkbenchCaption"
control_id = "buttons_StatePressed"
classes = ["material-lab-state-pill", "material-lab-state-pressed"]
props = { "text" = "Pressed", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "validation_level" = "normal", "hovered" = true, "pressed" = true, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
style = { "self" = { "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "button_interaction_state" = "pressed", "background" = { "color" = "transparent" }, "border" = { "color" = "material.focus_ring", "width" = 0, "radius" = 0 } } }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.state_focus]
component = "WorkbenchCaption"
control_id = "buttons_StateFocus"
classes = ["material-lab-state-pill", "material-lab-state-focus"]
props = { "text" = "Focus", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = true, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
style = { "self" = { "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "button_interaction_state" = "focused", "background" = { "color" = "transparent" }, "border" = { "color" = "material.focus_ring", "width" = 0, "radius" = 0 } } }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.state_disabled]
component = "WorkbenchCaption"
control_id = "buttons_StateDisabled"
classes = ["material-lab-state-pill", "material-lab-state-disabled"]
props = { "text" = "Disabled", "text_tone" = "disabled", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = true, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
style = { "self" = { "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "button_interaction_state" = "disabled", "background" = { "color" = "transparent" }, "foreground" = { "color" = "material.text_disabled" }, "border" = { "color" = "material.outline", "width" = 0, "radius" = 0 } } }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.state_selected]
component = "WorkbenchCaption"
control_id = "buttons_StateSelected"
classes = ["material-lab-state-pill", "material-lab-state-selected"]
props = { "text" = "Selected", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = true, "checked" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
style = { "self" = { "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "background" = { "color" = "transparent" }, "border" = { "color" = "material.focus_ring", "width" = 0, "radius" = 0 } } }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.state_open]
component = "WorkbenchCaption"
control_id = "buttons_StateOpen"
classes = ["material-lab-state-pill", "material-lab-state-open"]
props = { "text" = "Open", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = true, "checked" = false, "disabled" = false, "open" = true, "popup_open" = true, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
style = { "self" = { "button_variant" = "text", "button_color" = "primary", "button_size" = "small", "icon_placement" = "none", "background" = { "color" = "transparent" }, "border" = { "color" = "material.focus_ring", "width" = 0, "radius" = 0 } } }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.state_error]
component = "WorkbenchCaption"
control_id = "buttons_StateError"
classes = ["material-lab-state-pill", "material-lab-state-error"]
props = { "text" = "Error", "text_tone" = "error", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "button_color" = "error", "button_size" = "small", "icon_placement" = "none", "validation_level" = "error", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
style = { "self" = { "button_variant" = "text", "button_color" = "error", "button_size" = "small", "icon_placement" = "none", "background" = { "color" = "transparent" }, "foreground" = { "color" = "material.error" }, "border" = { "color" = "material.error", "width" = 0, "radius" = 0 } } }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.root]
component = "VerticalBox"
control_id = "buttons_Root"
classes = ["material-lab-card", "material-surface", "material-buttons"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 360, "preferred" = 360, "max" = 360, "stretch" = "Fixed" }, "container" = { "kind" = "VerticalBox", "gap" = "$editor.density.gap.large" } }
children = [
  { node = "title" },
  { node = "meta" },
  { node = "sample" },
