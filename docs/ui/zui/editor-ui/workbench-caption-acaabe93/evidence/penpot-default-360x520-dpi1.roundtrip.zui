[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui"
version = 2
display_name = "Workbench Caption"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchCaption]
root = "root"
default_classes = ["workbench-caption", "workbench-primitive"]

[nodes.root]
component = "Label"
control_id = "WorkbenchCaptionRoot"
classes = ["workbench-caption"]
props = { text = "Caption", text_overflow = "ellipsis", font_size = "$editor.typography.caption.size", font_weight = "$editor.typography.strong.weight", line_height_ratio = "$editor.typography.line_height", text_tone = "secondary", layout_padding_top = "$editor.density.gap.xsmall", layout_padding_bottom = "$editor.density.gap.xsmall" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.caption.min_height", preferred = "$editor.density.caption.preferred_height", max = "$editor.density.caption.max_height", stretch = "Fixed" } }
