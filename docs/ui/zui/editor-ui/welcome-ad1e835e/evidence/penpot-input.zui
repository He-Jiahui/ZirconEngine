elcomeStatusPanel\"\nlayout = { width = { max = 680.0, stretch = \"Stretch\" }, height = { min = 0.0, preferred = 0.0, max = 0.0, stretch = \"Fixed\" } }\n\n[nodes.actions_optional_gap]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 0.0, preferred = 0.0, max = 0.0, stretch = \"Fixed\" } }\n\n[nodes.new_project_header_panel]\ncomponent = \"Space\"\ncontrol_id = \"WelcomeNewProjectHeaderPanel\"\nlayout = { width = { max = 680.0, stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.new_project_name_gap]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.medium\", preferred = \"$editor.density.gap.medium\", max = \"$editor.density.gap.medium\", stretch = \"Fixed\" } }\n\n[nodes.project_name_label]\ncomponent = \"Label\"\ncontrol_id = \"WelcomeProjectNameLabel\"\nprops = { text = \"Project name\", text_tone = \"muted\", font_size = \"$editor.typography.caption.size\", overflow = \"elide\" }\nlayout = { width = { max = 680.0, stretch = \"Stretch\" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = \"Fixed\" } }\n\n[nodes.project_name_label_gap]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.small\", preferred = \"$editor.density.gap.small\", max = \"$editor.density.gap.small\", stretch = \"Fixed\" } }\n\n[nodes.project_name_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WelcomeProjectNameField\"\nclasses = [\"workbench-field\"]\nprops = { value = \"ZirconProject\", placeholder = \"Project name\", validation_level = \"normal\", height = \"$editor.control.height.default\" }\nlayout = { width = { max = 680.0, stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\n\n[nodes.project_name_location_gap]\nco