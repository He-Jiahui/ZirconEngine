background_color = "$workbench_accent_dim"
foreground_color = "$workbench_text"
border_color = "$workbench_accent"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-alert"

[stylesheets.rules.set.self]
background_color = "$workbench_panel_raised"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.control"

[[stylesheets.rules]]
selector = ".workbench-toast"

[stylesheets.rules.set.self]
background_color = "$workbench_toast_surface"
foreground_color = "$workbench_toast_text"
border_color = "$workbench_toast_border"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.panel"

[[stylesheets.rules]]
selector = ".workbench-info"

[stylesheets.rules.set.self]
background_color = "$workbench_info_surface"
foreground_color = "$workbench_info"
border_color = "$workbench_info"

[[stylesheets.rules]]
selector = ".workbench-success"

[stylesheets.rules.set.self]
background_color = "$workbench_success_surface"
foreground_color = "$workbench_success"
border_color = "$workbench_success"

[[stylesheets.rules]]
selector = ".workbench-warning"

[stylesheets.rules.set.self]
background_color = "$workbench_warning_surface"
foreground_color = "$workbench_warning"
border_color = "$workbench_warning"

[[stylesheets.rules]]
selector = ".workbench-error"

[stylesheets.rules.set.self]
background_color = "$workbench_error_surface"
foreground_color = "$workbench_error"
border_color = "$workbench_error"

[[stylesheets.rules]]
selector = ".workbench-danger"

[stylesheets.rules.set.self]
foreground_color = "$workbench_error"
border_color = "$workbench_error"

[[stylesheets.rules]]
selector = ".workbench-status"

[stylesheets.rules.set.self]
background_color = "$workbench_surface"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = 0
radius = 0

[[stylesheets.rules]]
selector = ".workbench-status-item"

[stylesheets.rules.set.self]
foreground_color = "$workbench_text"

[[stylesheets.rules]]
selector = ".workbench-status-right-control"

[stylesheets.rules.set.self]
background_color = "transparent"
foreground_color = "$workbench_status_right_text"
border_color = "transparent"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".workbench-status-right-icon"

[stylesheets.rules.set.self]
background_color = "transparent"
border_color = "transparent"
border_width = "$editor.control.border_width"
radius = "$editor.control.radius.small"

[[stylesheets.rules]]
selector = ".workbench-overlay-region"

[stylesheets.rules.set.self]
background_color = "$workbench_panel"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = 0

[[stylesheets.rules]]
selector = ".workbench-primitive"

[stylesheets.rules.set.self]
foreground_color = "$workbench_text"

[penpot_original_imports]
widgets = [ "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton", "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField" ]
styles = [ "res://ui/theme/editor_workbench_strict.zui" ]

[penpot_field_icons]
search = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Search\">\n  <circle cx=\"10.5\" cy=\"10.5\" r=\"5.4\" fill=\"none\" stroke=\"#cbd2dc\" stroke-width=\"1.8\"/>\n  <path fill=\"none\" stroke=\"#cbd2dc\" stroke-linecap=\"round\" stroke-width=\"1.9\" d=\"m14.5 14.5 4.5 4.5\"/>\n</svg>\n"
clear = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"512\" height=\"512\" viewBox=\"0 0 512 512\"><line x1=\"368\" y1=\"368\" x2=\"144\" y2=\"144\" style=\"fill:none;stroke:#000;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px\"/><line x1=\"368\" y1=\"144\" x2=\"144\" y2=\"368\" style=\"fill:none;stroke:#000;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px\"/></svg>"
stepper = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Field stepper\">\n  <path fill=\"none\" stroke=\"#cbd2dc\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" d=\"m7 9 5-5 5 5M7 15l5 5 5-5\"/>\n</svg>\n"
