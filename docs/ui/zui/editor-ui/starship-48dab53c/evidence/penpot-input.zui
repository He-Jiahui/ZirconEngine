penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui" ]
penpot_original_source = "[asset]\nkind = \"style\"\nid = \"res://ui/editor/unreal/starship.zui\"\nversion = 2\ndisplay_name = \"Unreal Starship Editor\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[tokens]\nunreal_background = \"#151515\"\nunreal_panel = \"#242424\"\nunreal_header = \"#2F2F2F\"\nunreal_recessed = \"#1A1A1A\"\nunreal_input = \"#0F0F0F\"\nunreal_input_outline = \"#383838\"\nunreal_dropdown = \"#383838\"\nunreal_dropdown_outline = \"#4C4C4C\"\nunreal_primary = \"#0070E0\"\nunreal_primary_hover = \"#0E86FF\"\nunreal_primary_press = \"#0050A0\"\nunreal_foreground = \"#C0C0C0\"\nunreal_foreground_header = \"#C8C8C8\"\nunreal_foreground_hover = \"#FFFFFF\"\nunreal_foreground_disabled = \"#808080\"\nunreal_font_family = \"Roboto\"\nunreal_font_size = 13.333333\nunreal_font_small_size = 10.666667\nunreal_font_weight = 400\nunreal_heading_weight = 700\nunreal_status_bar_height = 32.0\nunreal_splitter_width = 4.0\n\n[[stylesheets]]\nid = \"unreal_starship_editor\"\n\n[[stylesheets.rules]]\nselector = \".unreal-editor-window\"\nset = { self = { background_color = \"$unreal_background\", foreground_color = \"$unreal_foreground\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\", font_weight = \"$unreal_font_weight\", line_height_ratio = 1.2 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-editor-shell\"\nset = { self = { background_color = \"$unreal_background\", foreground_color = \"$unreal_foreground\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-editor-toolbar\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-level-editor-toolbar\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\", font_weight = \"$unreal_font_weight\", line_height_ratio = 1.2, border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-menu-bar\"\nset = { self = { background_color = \"$unreal_background\", foreground_color = \"$unreal_foreground\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\", font_weight = \"$unreal_font_weight\", line_height_ratio = 1.2, border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-control\"\nset = { self = { foreground_color = \"$unreal_foreground\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\", font_weight = \"$unreal_font_weight\", line_height_ratio = 1.2, border_color = \"$unreal_input_outline\", border_width = 0.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-toolbar-control\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground\", border_color = \"$unreal_input_outline\", border_width = 0.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-icon-control\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground\", border_color = \"$unreal_input_outline\", border_width = 0.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-menu-control\"\n# StarshipCoreStyle: WindowMenuBar.MenuBar.Padding = FMargin(12, 4).\nset = { self = { background_color = \"$unreal_background\", foreground_color = \"$unreal_foreground\", border_color = \"$unreal_background\", border_width = 0.0, corner_radius = 0.0, layout_padding_left = 12.0, layout_padding_right = 12.0, layout_padding_top = 4.0, layout_padding_bottom = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-status-control\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground\", border_color = \"$unreal_panel\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-control:hovered\"\nset = { self = { background_color = \"#575757\", foreground_color = \"$unreal_foreground_hover\", border_color = \"$unreal_input_outline\", border_width = 1.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-control:pressed\"\nset = { self = { background_color = \"$unreal_primary_press\", foreground_color = \"$unreal_foreground_hover\", border_color = \"$unreal_primary\", border_width = 1.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-control:selected\"\nset = { self = { background_color = \"$unreal_primary\", foreground_color = \"$unreal_foreground_hover\", border_color = \"$unreal_primary\", border_width = 1.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-control:checked\"\nset = { self = { background_color = \"$unreal_primary\", foreground_color = \"$unreal_foreground_hover\", border_color = \"$unreal_primary\", border_width = 1.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-control:popup_open\"\nset = { self = { background_color = \"$unreal_primary\", foreground_color = \"$unreal_foreground_hover\", border_color = \"$unreal_primary\", border_width = 1.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-control:disabled\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground_disabled\", border_color = \"$unreal_panel\", border_width = 0.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-control:focus-visible\"\nset = { self = { border_color = \"$unreal_primary\", border_width = 1.0, corner_radius = 4.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-menu-control:hovered\"\nset = { self = { background_color = \"#575757\", foreground_color = \"$unreal_foreground_hover\", border_color = \"#575757\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-menu-control:pressed\"\nset = { self = { background_color = \"$unreal_primary_press\", foreground_color = \"$unreal_foreground_hover\", border_color = \"$unreal_primary_press\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-menu-control:disabled\"\nset = { self = { background_color = \"$unreal_background\", foreground_color = \"$unreal_foreground_disabled\", border_color = \"$unreal_background\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-status-control:hovered\"\nset = { self = { background_color = \"#575757\", foreground_color = \"$unreal_foreground_hover\", border_color = \"#575757\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-status-control:pressed\"\nset = { self = { background_color = \"$unreal_primary_press\", foreground_color = \"$unreal_foreground_hover\", border_color = \"$unreal_primary_press\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-status-control:disabled\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground_disabled\", border_color = \"$unreal_panel\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-status-label\"\nset = { self = { foreground_color = \"$unreal_foreground\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_small_size\", font_weight = \"$unreal_font_weight\", line_height_ratio = 1.2 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-editor-main\"\nset = { self = { background_color = \"$unreal_background\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-dock\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-dock-tab\"\nset = { self = { background_color = \"$unreal_header\", foreground_color = \"$unreal_foreground_header\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\", font_weight = \"$unreal_font_weight\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-property-row\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\", font_weight = \"$unreal_font_weight\" } }\n\n[[stylesheets.rules]]\nselector = \".unreal-field\"\nset = { self = { background_color = \"$unreal_input\", foreground_color = \"$unreal_foreground\", border_color = \"$unreal_input_outline\", border_width = 1.0, corner_radius = 4.0, font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\", font_weight = \"$unreal_font_weight\" } }\n\n[[stylesheets.rules]]\nselector = \".unreal-viewport\"\nset = { self = { background_color = \"$unreal_recessed\", foreground_color = \"$unreal_foreground\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-viewport-toolbar\"\nset = { self = { background_color = \"$unreal_background\", foreground_color = \"$unreal_foreground\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\", border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-viewport-overlay-toolbar\"\nset = { self = { background_color = \"$unreal_background\", foreground_color = \"$unreal_foreground\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\", font_weight = \"$unreal_font_weight\", line_height_ratio = 1.2, border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-status-bar\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground\", font_family = \"$unreal_font_family\", font_size = \"$unreal_font_small_size\", font_weight = \"$unreal_font_weight\", line_height_ratio = 1.2, border_width = 0.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-content-drawer\"\nset = { self = { background_color = \"$unreal_panel\", foreground_color = \"$unreal_foreground\", border_color = \"$unreal_input_outline\", border_width = 1.0, corner_radius = 0.0 } }\n\n[[stylesheets.rules]]\nselector = \".unreal-popup-menu\"\nset = { self = { background_color = \"$unreal_dropdown\", foreground_color = \"$unreal_foreground\", border_color = \"$unreal_dropdown_outline\", border_width = 1.0, corner_radius = 4.0, font_family = \"$unreal_font_family\", font_size = \"$unreal_font_size\" } }\n"

