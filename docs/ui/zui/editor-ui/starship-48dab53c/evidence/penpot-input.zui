[[stylesheets]]
id = "unreal_starship_editor"

[[stylesheets.rules]]
selector = ".unreal-editor-window"

[stylesheets.rules.set.self]
background_color = "$unreal_background"
foreground_color = "$unreal_foreground"
font_family = "$unreal_font_family"
font_size = "$unreal_font_size"
font_weight = "$unreal_font_weight"
line_height_ratio = 1.2

