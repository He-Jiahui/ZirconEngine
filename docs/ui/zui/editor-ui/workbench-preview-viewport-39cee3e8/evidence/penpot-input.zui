penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/primitives/data/workbench_preview_viewport.zui\"\nversion = 2\ndisplay_name = \"Workbench Preview Viewport\"\n\n[imports]\nwidgets = []\nstyles = []\n\n[components.WorkbenchPreviewViewport]\nroot = \"root\"\ndefault_classes = [\"workbench-preview-viewport\", \"workbench-primitive\"]\n\n[nodes.root]\ncomponent = \"Image\"\ncontrol_id = \"WorkbenchPreviewViewportRoot\"\nclasses = [\"workbench-preview-viewport\", \"workbench-surface-inset\"]\nprops = { image = \"ui/editor/workbench/preview/animation_mannequin_viewport.svg\", preserve_aspect = true, input_interactive = false, input_clickable = false, input_focusable = false }\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n"

