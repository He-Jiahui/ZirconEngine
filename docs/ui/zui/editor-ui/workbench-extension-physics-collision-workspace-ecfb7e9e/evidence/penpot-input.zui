ensionPhysicsCollisionSimulateButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Simulate Physics\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 132, preferred = 132, max = 144, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PhysicsCollisionSimulate\", event = \"Click\", route = \"workbench.extension.physics_collision.simulate\" }]\n\n[nodes.physics_collision_validate_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionPhysicsCollisionValidateButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { responsive_min_tier = \"narrow\", text = \"Validate Contacts\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 136, preferred = 136, max = 148, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/PhysicsCollisionValidate\", event = \"Click\", route = \"workbench.extension.physics_collision.validate\" }]\n\n[nodes.physics_collision_matrix_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionPhysicsCollisionMatrixTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"physics_collision_player_capsule_table_row\" }, { node = \"physics_collision_ice_material_table_row\" }, { node = \"physics_collision_wall_contact_table_row\" }, { node = \"physics_collision_ccd_warning_table_row\" }]\n\n[nodes.physics_collision_player_capsule_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtension