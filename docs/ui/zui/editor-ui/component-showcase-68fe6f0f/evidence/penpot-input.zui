slint_material_elevation_level5_light_outer_blur = 12
slint_material_elevation_level5_light_outer_alpha = "$slint_material_shadow_15_alpha"
slint_material_elevation_level5_light_inner_offset_y = 4
slint_material_elevation_level5_light_inner_blur = 4
slint_material_elevation_level5_light_inner_alpha = "$slint_material_shadow_30_alpha"
slint_material_elevation_level1_dark_outer_offset_y = 1
slint_material_elevation_level1_dark_outer_blur = 3
slint_material_elevation_level1_dark_outer_alpha = "$slint_material_shadow_15_alpha"
slint_material_elevation_level1_dark_inner_offset_y = 1
slint_material_elevation_level1_dark_inner_blur = 2
slint_material_elevation_level1_dark_inner_alpha = "$slint_material_shadow_30_alpha"
slint_material_elevation_level2_dark_outer_offset_y = 2
slint_material_elevation_level2_dark_outer_blur = 6
slint_material_elevation_level2_dark_outer_alpha = "$slint_material_shadow_15_alpha"
slint_material_elevation_level2_dark_inner_offset_y = 1
slint_material_elevation_level2_dark_inner_blur = 2
slint_material_elevation_level2_dark_inner_alpha = "$slint_material_shadow_30_alpha"
slint_material_elevation_level3_dark_outer_offset_y = 4
slint_material_elevation_level3_dark_outer_blur = 8
slint_material_elevation_level3_dark_outer_alpha = "$slint_material_shadow_15_alpha"
slint_material_elevation_level3_dark_inner_offset_y = 1
slint_material_elevation_level3_dark_inner_blur = 3
slint_material_elevation_level3_dark_inner_alpha = "$slint_material_shadow_30_alpha"
slint_material_elevation_level4_dark_outer_offset_y = 6
slint_material_elevation_level4_dark_outer_blur = 10
slint_material_elevation_level4_dark_outer_alpha = "$slint_material_shadow_15_alpha"
slint_material_elevation_level4_dark_inner_offset_y = 2
slint_material_elevation_level4_dark_inner_blur = 3
slint_material_elevation_level4_dark_inner_alpha = "$slint_material_shadow_30_alpha"
