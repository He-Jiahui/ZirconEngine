[nodes.component_showcase_header]
component = "Label"
control_id = "UiComponentShowcaseHeader"
classes = [ "showcase-title" ]

[nodes.component_showcase_header.props]
text = "Runtime UI Component Showcase"

[nodes.component_showcase_header.layout.width]
stretch = "Stretch"

[nodes.component_showcase_header.layout.height]
min = 36
preferred = 36
max = 36
stretch = "Fixed"

[nodes.component_showcase_nav]
component = "VerticalBox"
control_id = "ComponentShowcaseCategoryNav"
classes = [ "showcase-panel" ]
events = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/showcase/showcase_category_nav.zui#ShowcaseCategoryNav"

[nodes.component_showcase_nav.layout.width]
stretch = "Fixed"
min = 120
preferred = 160
max = 180

[nodes.component_showcase_nav.layout.height]
stretch = "Stretch"

[nodes.component_showcase_nav.layout.container]
kind = "VerticalBox"
gap = "$editor.density.gap.small"

[[nodes.component_showcase_nav.children]]
