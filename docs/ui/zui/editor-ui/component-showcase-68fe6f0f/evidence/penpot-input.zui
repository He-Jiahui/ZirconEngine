slint_material_elevation_level5_dark_outer_alpha = "$slint_material_shadow_15_alpha"
slint_material_elevation_level5_dark_inner_offset_y = 4
slint_material_elevation_level5_dark_inner_blur = 4
slint_material_elevation_level5_dark_inner_alpha = "$slint_material_shadow_30_alpha"
slint_material_state_layer_priority = "disabled>pressed>drag>focus>hover>default"
slint_material_state_layer_disabled_uses_focus_opacity = "true"
slint_material_hover_disable_token = "disable_hover"
slint_material_ripple_pressed_x_attr = "pressed_x"
slint_material_ripple_pressed_y_attr = "pressed_y"
slint_material_ripple_clip_attr = "clip_ripple"
slint_material_ripple_static_pulse_contract = "pressed_or_enter_pressed_static_circle"
slint_material_elevation_retained_painter_contract = "retained_template_elevation_shadow"
slint_material_button_variants = "filled,outlined,text,tonal,elevated"
slint_material_base_button_horizontal_padding = 24
slint_material_base_button_vertical_padding = 10
slint_material_base_button_spacing = 8
slint_material_base_button_min_layout_width = 40
slint_material_base_button_min_layout_height = 40
slint_material_base_button_icon_size = 18
slint_material_button_radius_policy = "height_half"
slint_material_button_hover_elevations = "filled=1,tonal=2,elevated=3"
slint_material_icon_button_display_background = "false"
slint_material_icon_button_inline_icon_size = 18
slint_material_icon_button_default_icon_size = 24
slint_material_icon_button_inline_min_layout = 18
slint_material_icon_button_default_min_layout = 40
slint_material_icon_button_clip_ripple_contract = "clip_unless_inline"
slint_material_fab_styles = "small,standard,large"
slint_material_fab_small_min_layout = 40
slint_material_fab_standard_min_layout = 56
slint_material_fab_large_min_layout = 96
slint_material_fab_small_radius = 12
slint_material_fab_standard_radius = 16
slint_material_fab_large_radius = 28
slint_material_fab_elevation_level = 3
slint_material_fab_hover_elevation_level = 4
shell_bg = "$theme.palette.surface.1"
surface_bg = "$theme.palette.surface.3"
surface_inset = "$theme.palette.surface.0"
surface_hover = "$theme.palette.surface.3"
surface_selected = "$material_surface_selected"
text_muted = "$theme.palette.text.secondary"
text_subtle = "$theme.palette.text.disabled"
danger = "$theme.palette.error"
title = "$text"

[penpot_original_imports]
widgets = [ "res://ui/editor/components/showcase/showcase_command_toolbar.zui#ShowcaseCommandToolbar", "res://ui/editor/components/showcase/showcase_bottom_log.zui#ShowcaseBottomLog", "res://ui/editor/components/showcase/showcase_category_nav.zui#ShowcaseCategoryNav", "res://ui/editor/components/showcase/showcase_state_panel.zui#ShowcaseStatePanel", "res://ui/editor/components/showcase/showcase_visual_section.zui#ShowcaseVisualSection", "res://ui/editor/components/showcase/showcase_input_section.zui#ShowcaseInputSection", "res://ui/editor/components/showcase/showcase_selection_section.zui#ShowcaseSelectionSection", "res://ui/editor/components/showcase/showcase_collections_section.zui#ShowcaseCollectionsSection" ]
styles = [ "res://ui/theme/editor_base.zui", "res://ui/editor/theme/editor_tokens.zui" ]

[penpot_field_icons]
search = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Search\">\n  <circle cx=\"10.5\" cy=\"10.5\" r=\"5.4\" fill=\"none\" stroke=\"#cbd2dc\" stroke-width=\"1.8\"/>\n  <path fill=\"none\" stroke=\"#cbd2dc\" stroke-linecap=\"round\" stroke-width=\"1.9\" d=\"m14.5 14.5 4.5 4.5\"/>\n</svg>\n"
clear = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"512\" height=\"512\" viewBox=\"0 0 512 512\"><line x1=\"368\" y1=\"368\" x2=\"144\" y2=\"144\" style=\"fill:none;stroke:#000;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px\"/><line x1=\"368\" y1=\"144\" x2=\"144\" y2=\"368\" style=\"fill:none;stroke:#000;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px\"/></svg>"
stepper = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Field stepper\">\n  <path fill=\"none\" stroke=\"#cbd2dc\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" d=\"m7 9 5-5 5 5M7 15l5 5 5-5\"/>\n</svg>\n"
