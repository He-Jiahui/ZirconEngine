penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/theme/editor_base.zui", "zircon_editor/assets/ui/theme/editor_material.zui", "zircon_editor/assets/ui/editor/components/showcase/showcase_command_toolbar.zui", "zircon_editor/assets/ui/editor/components/showcase/showcase_bottom_log.zui", "zircon_editor/assets/ui/editor/components/showcase/showcase_category_nav.zui", "zircon_editor/assets/ui/editor/components/showcase/showcase_state_panel.zui", "zircon_editor/assets/ui/editor/components/showcase/showcase_visual_section.zui", "zircon_editor/assets/ui/editor/components/showcase/showcase_input_section.zui", "zircon_editor/assets/ui/editor/components/showcase/showcase_selection_section.zui", "zircon_editor/assets/ui/editor/components/showcase/showcase_collections_section.zui", "zircon_editor/assets/icons/zircon_editor_shell/controls/search.svg", "zircon_editor/assets/icons/ionicons/close-outline.svg", "zircon_editor/assets/icons/zircon_editor_shell/controls/field-stepper.svg" ]
penpot_original_source = "[asset]\r\nkind = \"view\"\r\nid = \"res://ui/editor/component_showcase.zui\"\nversion = 2\r\ndisplay_name = \"UI Component Showcase\"\n\n# Rust contract action id markers:\n# ui_component_showcase.number_field_drag_update\n# ui_component_showcase.slider_drag_update\n# ui_component_showcase.slider_changed\n# ui_component_showcase.range_slider_drag_update\n# ui_component_showcase.range_slider_changed\n# ui_component_showcase.tab_changed\n# ui_component_showcase.tab_strip_changed\n# ui_component_showcase.input_field_changed\n\n[root]\nnode = \"component_showcase_root\"\n\r\n[imports]\nwidgets = [\n  \"res://ui/editor/components/showcase/showcase_command_toolbar.zui#ShowcaseCommandToolbar\",\n  \"res://ui/editor/components/showcase/showcase_bottom_log.zui#ShowcaseBottomLog\",\n  \"res://ui/editor/components/showcase/showcase_category_nav.zui#ShowcaseCategoryNav\",\n  \"res://ui/editor/components/showcase/showcase_state_panel.zui#ShowcaseStatePanel\",\n  \"res://ui/editor/components/showcase/showcase_visual_section.zui#ShowcaseVisualSection\",\n  \"res://ui/editor/components/showcase/showcase_input_section.zui#ShowcaseInputSection\",\n  \"res://ui/editor/components/showcase/showcase_selection_section.zui#ShowcaseSelectionSection\",\n  \"res://ui/editor/components/showcase/showcase_collections_section.zui#ShowcaseCollectionsSection\",\n]\nstyles = [\"res://ui/theme/editor_base.zui\", \"res://ui/editor/theme/editor_tokens.zui\"]\n\r\n[[stylesheets]]\r\nid = \"component_showcase_material\"\r\n\r\n[[stylesheets.rules]]\r\nselector = \".showcase-shell\"\r\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.0\"\nforeground_color = \"$editor.text.primary\"\n\r\n[[stylesheets.rules]]\r\nselector = \".showcase-panel\"\r\n[stylesheets.rules.set.self]\r\nbackground_color = \"$editor.surface.2\"\nborder_color = \"$editor.border\"\nforeground_color = \"$editor.text.primary\"\nradius = \"$editor.control.radius.panel\"\nborder_width = \"$editor.control.border_width\"\n\r\n[[stylesheets.rules]]\nselector = \".showcase-section-title\"\n[stylesheets.rules.set.self]\nforeground_color = \"$editor.text.primary\"\nfont_size = \"$editor.typography.body.size\"\nfont_weight = \"$editor.typography.emphasis.weight\"\n\n[[stylesheets.rules]]\nselector = \".showcase-field\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.1\"\nforeground_color = \"$editor.text.primary\"\nborder_color = \"$editor.border\"\nradius = \"$editor.control.radius.small\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".showcase-title\"\n[stylesheets.rules.set.self]\nforeground_color = \"$editor.text.primary\"\nfont_size = \"$editor.typography.title.size\"\nfont_weight = \"$editor.typography.strong.weight\"\n\n[[stylesheets.rules]]\nselector = \".showcase-muted\"\n[stylesheets.rules.set.self]\nforeground_color = \"$editor.text.secondary\"\nfont_size = \"$editor.typography.caption.size\"\n\n[[stylesheets.rules]]\nselector = \".material-control\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.1\"\nforeground_color = \"$editor.text.primary\"\nborder_color = \"$editor.border\"\nradius = \"$editor.control.radius.control\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".material-control:hover\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.hover\"\nborder_color = \"$editor.accent\"\nradius = \"$editor.control.radius.control\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".material-control:pressed\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.3\"\nborder_color = \"$editor.focus.ring\"\nradius = \"$editor.control.radius.control\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".material-control:focus\"\n[stylesheets.rules.set.self]\nborder_color = \"$editor.focus.ring\"\nradius = \"$editor.control.radius.control\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".material-control:selected\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.selected\"\nborder_color = \"$editor.focus.ring\"\nradius = \"$editor.control.radius.control\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".material-control:disabled\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.disabled\"\nforeground_color = \"$editor.text.disabled\"\nborder_color = \"$editor.border.disabled\"\nradius = \"$editor.control.radius.control\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".showcase-toolbar\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.1\"\nforeground_color = \"$editor.text.primary\"\nborder_color = \"$editor.border\"\nradius = \"$editor.control.radius.small\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".showcase-bottom-log\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.recessed\"\nforeground_color = \"$editor.text.secondary\"\nborder_color = \"$editor.separator.soft\"\nradius = \"$editor.control.radius.small\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".unreal-panel\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.1\"\nforeground_color = \"$editor.text.primary\"\nborder_color = \"$editor.border\"\nradius = \"$editor.control.radius.panel\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".unreal-command\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.surface.2\"\nforeground_color = \"$editor.text.primary\"\nborder_color = \"$editor.border\"\nradius = \"$editor.control.radius.small\"\nborder_width = \"$editor.control.border_width\"\n\n[[stylesheets.rules]]\nselector = \".unreal-accent\"\n[stylesheets.rules.set.self]\nbackground_color = \"$editor.accent\"\nforeground_color = \"$editor.surface.0\"\nborder_color = \"$editor.accent\"\nradius = \"$editor.control.radius.small\"\nborder_width = \"$editor.control.border_width\"\n\n[nodes.component_showcase_header]\ncomponent = \"Label\"\r\ncontrol_id = \"UiComponentShowcaseHeader\"\r\nclasses = [\"showcase-title\"]\r\nprops = { text = \"Runtime UI Component Showcase\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.component_showcase_nav]\ncomponent = \"ShowcaseCategoryNav\"\ncontrol_id = \"ComponentShowcaseCategoryNav\"\nclasses = [\"showcase-panel\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\r\n[nodes.component_showcase_visual_section]\ncomponent = \"ShowcaseVisualSection\"\nclasses = [\"showcase-panel\", \"material-surface\"]\nlayout = { width = { stretch = \"Stretch\" } }\n\r\n[nodes.component_showcase_input_section]\ncomponent = \"ShowcaseInputSection\"\nclasses = [\"showcase-panel\", \"material-surface\"]\nlayout = { width = { stretch = \"Stretch\" } }\n\r\n[nodes.component_showcase_selection_section]\ncomponent = \"ShowcaseSelectionSection\"\nclasses = [\"showcase-panel\", \"material-surface\"]\nlayout = { width = { stretch = \"Stretch\" } }\n\r\n[nodes.component_showcase_collections_section]\ncomponent = \"ShowcaseCollectionsSection\"\nclasses = [\"showcase-panel\", \"material-surface\"]\nlayout = { width = { stretch = \"Stretch\" } }\n\r\n[nodes.component_showcase_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"ComponentShowcaseScroll\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Auto\" } }\nchildren = [\n  { node = \"component_showcase_visual_section\" },\r\n  { node = \"component_showcase_input_section\" },\r\n  { node = \"component_showcase_selection_section\" },\r\n  { node = \"component_showcase_collections_section\" },\r\n]\r\n\r\n[nodes.component_showcase_state_panel]\ncomponent = \"ShowcaseStatePanel\"\ncontrol_id = \"ComponentShowcaseStatePanel\"\nclasses = [\"showcase-panel\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\r\n[nodes.component_showcase_body]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"UiComponentShowcaseBody\"\nlayout = { clip = true, input_policy = \"Receive\", width = { min = 0.0, stretch = \"Stretch\" }, height = { min = 0.0, stretch = \"Stretch\" }, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Auto\" } }\nchildren = [\n  # ReactBits App Shell 4 keeps navigation and context bounded so the main\n  # work area remains the dominant, readable slot at the 640px tier.\n  { node = \"component_showcase_nav\", slot = { layout = { width = { min = 120.0, preferred = 160.0, max = 180.0, stretch = \"Fixed\" } } } },\n  { node = \"component_showcase_content\", slot = { layout = { width = { min = 220.0, preferred = 360.0, stretch = \"Stretch\" } } } },\n  { node = \"component_showcase_state_panel\", slot = { layout = { width = { min = 160.0, preferred = 240.0, max = 260.0, stretch = \"Fixed\" } } } },\n]\n\n[nodes.component_showcase_toolbar]\ncomponent = \"ShowcaseCommandToolbar\"\ncontrol_id = \"ComponentShowcaseCommandToolbar\"\nclasses = [\"showcase-toolbar\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = \"Fixed\" } }\n\n[nodes.component_showcase_bottom_log]\ncomponent = \"ShowcaseBottomLog\"\ncontrol_id = \"ComponentShowcaseBottomLog\"\nclasses = [\"showcase-bottom-log\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = \"Fixed\" } }\n\n[nodes.component_showcase_root]\ncomponent = \"VerticalBox\"\ncontrol_id = \"UiComponentShowcaseRoot\"\npixel_snapping = \"disabled\"\nclasses = [\"showcase-shell\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" } }\nchildren = [\n  { node = \"component_showcase_header\" },\n  { node = \"component_showcase_toolbar\" },\n  { node = \"component_showcase_body\" },\n  { node = \"component_showcase_bottom_log\" },\n]\n"

[asset]
kind = "view"
id = "res://ui/editor/component_showcase.zui"
version = 2
display_name = "UI Component Showcase"

[root]
node = "component_showcase_root"

[imports]
widgets = []
styles = []

[[stylesheets]]
id = "editor_material"

[[stylesheets.rules]]
selector = ".showcase-shell"

[stylesheets.rules.set.self.background]
color = "$field_bg"

[[stylesheets.rules]]
selector = ".showcase-panel"

[stylesheets.rules.set.self.background]
color = "$panel_bg"

[stylesheets.rules.set.self.border]
color = "$border"
width = "$material_border_width"
radius = "$material_radius_surface"

[[stylesheets.rules]]
selector = ".showcase-field"

[stylesheets.rules.set.self.background]
color = "$panel_bg_soft"

[stylesheets.rules.set.self.border]
color = "$border"
width = "$material_border_width"
radius = "$material_radius_small"

[[stylesheets.rules]]
selector = ".showcase-title"

[stylesheets.rules.set.self.foreground]
color = "$text"

[stylesheets.rules.set.self.font]
size = "$material_font_size_title"

[[stylesheets.rules]]
selector = ".showcase-muted"

[stylesheets.rules.set.self.foreground]
color = "$muted"

[stylesheets.rules.set.self.font]
size = "$material_font_size_meta"

[[stylesheets.rules]]
selector = ".material-state-layer"

[stylesheets.rules.set.self.background]
