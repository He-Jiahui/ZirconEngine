[nodes.root]
component = "VerticalBox"
control_id = "switches_Root"
classes = ["material-lab-card", "material-surface", "material-switches"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 464, "preferred" = 464, "max" = 464, "stretch" = "Fixed" }, "container" = { "kind" = "VerticalBox", "gap" = "$editor.density.gap.large" } }
