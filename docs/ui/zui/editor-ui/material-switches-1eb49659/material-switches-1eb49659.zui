[asset]
kind = "component"
id = "res://ui/editor/material_components/inputs/material_switches.zui"
version = 2
display_name = "Material Switches Prototype"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption"]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.MaterialSwitchesPrototype]
root = "root"
default_classes = ["material-lab-prototype", "material-surface"]

[nodes.title]
component = "WorkbenchLabel"
control_id = "switches_Title"
classes = ["material-lab-title"]
props = { "text" = "Switches", "text_tone" = "primary", "font_size" = "$editor.typography.title.size", "font_weight" = "$editor.typography.strong.weight", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 28, "preferred" = 28, "max" = 28, "stretch" = "Fixed" } }

[nodes.meta]
component = "GridBox"
control_id = "switches_Meta"
classes = ["material-lab-meta-strip", "material-lab-meta"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 100, "preferred" = 100, "max" = 100, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 2, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "meta_group" },
  { node = "meta_response" },
  { node = "meta_variant" },
  { node = "meta_layout" },
]

[nodes.meta_group]
component = "WorkbenchCaption"
control_id = "switches_MetaGroup"
classes = ["material-lab-meta-chip", "material-lab-meta-group"]
props = { "text" = "Inputs", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_response]
component = "WorkbenchCaption"
control_id = "switches_MetaResponse"
classes = ["material-lab-meta-chip", "material-lab-meta-response"]
props = { "text" = "toggle / checked", "text_tone" = "success", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "response_mechanism" = "toggle / checked", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.meta_variant]
component = "WorkbenchCaption"
control_id = "switches_MetaVariant"
classes = ["material-lab-meta-chip", "material-lab-meta-variant"]
props = { "text" = "checked / unchecked", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "variant" = "checked / unchecked", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_layout]
component = "WorkbenchCaption"
control_id = "switches_MetaLayout"
classes = ["material-lab-meta-chip", "material-lab-meta-layout"]
props = { "text" = "inline controls", "text_tone" = "warning", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "layout_mode" = "inline controls", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.sample]
component = "HorizontalBox"
control_id = "switches_Sample"
classes = ["material-control", "material-lab-sample", "material-switch-row"]
props = { "text" = "", "checked" = true, "switch_size" = "medium", "switch_color" = "primary", "label_click_toggles" = true, "track_click_toggles" = true, "thumb_draggable" = false, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "primary", "validation_level" = "normal", "hovered" = true, "pressed" = false, "focused" = true, "selected" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "input_interactive" = true, "input_clickable" = true, "input_hoverable" = true, "input_focusable" = true, "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 192, "preferred" = 192, "max" = 192, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 1, "rows" = 5, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.medium" } }
children = [
  { node = "switch_on" },
  { node = "switch_off" },
  { node = "switch_small" },
  { node = "switch_disabled" },
  { node = "switch_error" },
]
events = [
  { id = "MaterialLab/Switches/Toggle", event = "Toggle", route = "material_lab.switches.toggle" },
]

[nodes.switch_on]
component = "Switch"
control_id = "switches_On"
classes = ["material-control", "material-switch", "material-switch-on"]
props = { "text" = "On", "checked" = true, "switch_size" = "medium", "switch_color" = "primary", "label_click_toggles" = true, "track_click_toggles" = true, "thumb_draggable" = false, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "primary", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = true, "selected" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 2, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "background" = { "color" = "$editor.accent.soft" }, "foreground" = { "color" = "material.text" }, "border" = { "color" = "material.focus_ring", "width" = 2, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.switch_off]
component = "Switch"
control_id = "switches_Off"
classes = ["material-control", "material-switch", "material-switch-off"]
props = { "text" = "Off", "checked" = false, "switch_size" = "medium", "switch_color" = "default", "label_click_toggles" = true, "track_click_toggles" = true, "thumb_draggable" = false, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "secondary", "validation_level" = "normal", "hovered" = true, "pressed" = false, "focused" = false, "selected" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "background" = { "color" = "material.surface_inset" }, "foreground" = { "color" = "material.text_muted" }, "border" = { "color" = "material.outline", "width" = 1, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.switch_small]
component = "Switch"
control_id = "switches_Small"
classes = ["material-control", "material-switch", "material-switch-small"]
props = { "text" = "Small", "checked" = true, "switch_size" = "small", "switch_color" = "primary", "label_click_toggles" = true, "track_click_toggles" = true, "thumb_draggable" = false, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "primary", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "background" = { "color" = "material.surface_selected" }, "foreground" = { "color" = "material.text" }, "border" = { "color" = "$editor.accent", "width" = 1, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.switch_disabled]
component = "Switch"
control_id = "switches_Disabled"
classes = ["material-control", "material-switch", "material-switch-disabled"]
props = { "text" = "Disabled", "checked" = true, "switch_size" = "medium", "switch_color" = "primary", "label_click_toggles" = true, "track_click_toggles" = true, "thumb_draggable" = false, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "disabled", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "disabled" = true, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "background" = { "color" = "material.disabled" }, "foreground" = { "color" = "material.text_disabled" }, "border" = { "color" = "material.outline", "width" = 1, "radius" = "$editor.control.radius.control" }, "opacity" = 0.38 } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.switch_error]
component = "Switch"
control_id = "switches_Error"
classes = ["material-control", "material-switch", "material-switch-error"]
props = { "text" = "Error", "checked" = false, "switch_size" = "medium", "switch_color" = "error", "label_click_toggles" = true, "track_click_toggles" = true, "thumb_draggable" = false, "surface_variant" = "elevated", "button_variant" = "contained", "text_tone" = "error", "validation_level" = "error", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 1, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
style = { "self" = { "background" = { "color" = "$editor.semantic.error.container" }, "foreground" = { "color" = "material.error" }, "border" = { "color" = "material.error", "width" = 1, "radius" = "$editor.control.radius.control" } } }
layout = { "width" = { "min" = 0, "stretch" = "Stretch" }, "height" = { "min" = 32, "preferred" = 32, "max" = 32, "stretch" = "Fixed" } }

[nodes.state_strip]
component = "GridBox"
control_id = "switches_StateStrip"
classes = ["material-lab-state-strip"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 108, "preferred" = 108, "max" = 108, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "state_default" },
  { node = "state_hover" },
  { node = "state_pressed" },
  { node = "state_focus" },
  { node = "state_disabled" },
  { node = "state_selected" },
  { node = "state_open" },
  { node = "state_error" },
]
[nodes.state_default]
component = "WorkbenchCaption"
control_id = "switches_StateDefault"
classes = ["material-lab-state-pill", "material-lab-state-default"]
props = { "text" = "Default", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.state_hover]
component = "WorkbenchCaption"
control_id = "switches_StateHover"
classes = ["material-lab-state-pill", "material-lab-state-hover"]
props = { "text" = "Hover", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "validation_level" = "normal", "hovered" = true, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
