etch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceStrafeRow\", event = \"Click\", route = \"workbench.extension.blend_space.strafe_row.select\" }]\n\n[nodes.blend_space_sprint_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSprintRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"BS_Sprint_Lean\", icon = \"history\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceSprintRow\", event = \"Click\", route = \"workbench.extension.blend_space.sprint_row.select\" }]\n\n[nodes.blend_space_search_empty]\ncomponent = \"WorkbenchCaption\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSearchEmpty\"\nprops = { text = \"No matching blend assets\", visibility = \"collapsed\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18.0, preferred = 20.0, max = 22.0, stretch = \"Fixed\" } }\n\n[nodes.blend_space_left_divider]\ncomponent = \"WorkbenchDivider\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceLeftDivider\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" } }\n\n[nodes.blend_space_files_title]\ncomponent = \"WorkbenchCaption\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceFilesTitle\"\nprops = { text = \"FILES\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 20.0, preferred = 20.0, max = 22.0, stretch = \"Fixed\" } }\n\n[nodes.blend_space_characters_tree_row]\ncomponent = \"WorkbenchTreeRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceCharactersTreeRow\"\nprops = { text = \"Characters\", expanded = true, tree_depth = 0, input_interactive = false, input_clickable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.blend_space_locomotion_tree_row]\ncomponent = \"WorkbenchTreeRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceLocomotionTreeRow\"\nprops = { text = \"Locomotion\", expanded = true, tree_depth = 1, input_interactive = false, input_clickable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.blend_space_clips_tree_row]\ncomponent = \"WorkbenchTreeRow\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceClipsTreeRow\"\nprops = { text = \"Animation Clips\", expanded = false, tree_depth = 2, input_interactive = false, input_clickable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\n\n[nodes.blend_space_left_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceLeftFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.blend_space_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_center_header\" }, { node = \"blend_space_center_work_area\" }, { node = \"blend_space_bottom_composite_row\" }]\n\n[nodes.blend_space_center_header]\ncomponent = \"WorkbenchPanelHeader\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceCenterHeader\"\nlayout = { width = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_center_title\", slot = { name = \"title\" } }, { node = \"blend_space_asset_summary\", slot = { name = \"actions\" } }, { node = \"blend_space_preview_button\", slot = { name = \"actions\" } }, { node = \"blend_space_apply_button\", slot = { name = \"actions\" } }]\n\n[nodes.blend_space_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceCenterTitle\"\nprops = { text = \"Blend Space\" }\nlayout = { width = { min = 92.0, preferred = 112.0, max = 132.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.blend_space_asset_summary]\ncomponent = \"WorkbenchCaption\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceAssetSummary\"\nprops = { text = \"BS_Locomotion  |  8 samples\", responsive_min_tier = \"wide\" }\nlayout = { width = { min = 122.0, preferred = 164.0, max = 190.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.blend_space_preview_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionBlendSpacePreviewButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Preview\", button_variant = \"outlined\", button_color = \"secondary\", responsive_min_tier = \"wide\" }\nlayout = { width = { min = 68, preferred = 74, max = 82, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpacePreview\", event = \"Click\", route = \"workbench.extension.blend_space.preview.invoke\" }]\n\n[nodes.blend_space_apply_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceApplyButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Apply\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 62, preferred = 68, max = 76, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceApply\", event = \"Click\", route = \"workbench.extension.blend_space.apply.invoke\" }]\n\n[nodes.blend_space_center_work_area]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceCenterWorkArea\"\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.chrome.separator.thickness\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_sample_canvas\" }, { node = \"blend_space_preview_card\" }]\n\n[nodes.blend_space_sample_canvas]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSampleCanvas\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\", \"workbench-surface-inset\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_canvas_toolbar\" }, { node = \"blend_space_sample_grid\" }]\n\n[nodes.blend_space_canvas_toolbar]\ncomponent = \"WorkbenchPanelHeader\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceCanvasToolbar\"\nlayout = { width = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_canvas_title\", slot = { name = \"title\" } }, { node = \"blend_space_canvas_status\", slot = { name = \"actions\" } }]\n\n[nodes.blend_space_canvas_title]\ncomponent = \"WorkbenchCaption\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceCanvasTitle\"\nprops = { text = \"SAMPLE GRID\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.blend_space_canvas_status]\ncomponent = \"WorkbenchCaption\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceCanvasStatus\"\nprops = { text = \"Speed x Direction\" }\nlayout = { width = { min = 92.0, preferred = 112.0, max = 132.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.blend_space_sample_grid]\ncomponent = \"WorkbenchSampleGrid\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceSampleGrid\"\nprops = { component_variant = \"sample-grid\", x_axis_label = \"Direction (deg)\", y_axis_label = \"Speed (cm/s)\", x_min = -180.0, x_max = 180.0, y_min = 0.0, y_max = 600.0, x_ticks = [-180.0, -135.0, -90.0, -45.0, 0.0, 45.0, 90.0, 135.0, 180.0], y_ticks = [0.0, 120.0, 240.0, 360.0, 480.0, 600.0], sample_points = [{ x = 0.0, y = 0.0, label = \"Idle\", selected = false }, { x = -90.0, y = 240.0, label = \"Strafe_L\", selected = false }, { x = 90.0, y = 240.0, label = \"Strafe_R\", selected = false }, { x = 0.0, y = 300.0, label = \"Walk_Fwd\", selected = false }, { x = -135.0, y = 520.0, label = \"Run_Left\", selected = false }, { x = 0.0, y = 600.0, label = \"Run_Fwd\", selected = true }, { x = 135.0, y = 520.0, label = \"Run_Right\", selected = false }, { x = 180.0, y = 180.0, label = \"Backpedal\", selected = false }] }\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.blend_space_preview_card]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionBlendSpacePreviewCard\"\nclasses = [\"workbench-panel\", \"workbench-module-side\", \"workbench-surface-inset\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { min = 176.0, preferred = 208.0, max = 240.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_preview_header\" }, { node = \"blend_space_preview_content\" }]\n\n[nodes.blend_space_preview_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionBlendSpacePreviewContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_preview_viewport\" }, { node = \"blend_space_preview_divider\" }, { node = \"blend_space_heatmap_header\" }, { node = \"blend_space_weight_heatmap\" }, { node = \"blend_space_preview_asset\" }]\n\n[nodes.blend_space_preview_header]\ncomponent = \"WorkbenchPanelHeader\"\n