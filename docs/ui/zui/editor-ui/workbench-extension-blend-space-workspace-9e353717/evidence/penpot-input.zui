penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/extensions/animation/workbench_extension_blend_space_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Extension Blend Space Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_divider.zui#WorkbenchDivider\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_preview_viewport.zui#WorkbenchPreviewViewport\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_sample_grid.zui#WorkbenchSampleGrid\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_weight_heatmap.zui#WorkbenchWeightHeatmap\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_timeline_strip.zui#WorkbenchTimelineStrip\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_tree_row.zui#WorkbenchTreeRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_chip.zui#WorkbenchChip\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/composites/chrome/workbench_panel_header.zui#WorkbenchPanelHeader\",\n  \"res://ui/editor/components/workbench/composites/animation/workbench_transport_controls.zui#WorkbenchTransportControls\",\n  \"res://ui/editor/components/workbench/composites/animation/workbench_blend_space_details.zui#WorkbenchBlendSpaceDetails\",\n  \"res://ui/editor/components/workbench/composites/animation/workbench_sample_weights.zui#WorkbenchSampleWeights\",\n  \"res://ui/editor/components/workbench/composites/feedback/workbench_validation_log.zui#WorkbenchValidationLog\",\n]\nstyles = []\n\n[components.WorkbenchExtensionBlendSpaceWorkspace]\nroot = \"blend_space_workspace\"\ndefault_classes = [\"workbench-module-body\", \"workbench-extension-module-body\"]\n\n[nodes.blend_space_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceWorkspace\"\nclasses = [\"workbench-module-body\", \"workbench-extension-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"blend_space_workspace_main\" },\n  { node = \"blend_space_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.blend_space_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.chrome.separator.thickness\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_rail_gap\" }, { node = \"blend_space_left\" }, { node = \"blend_space_center\" }, { node = \"blend_space_right_reserve\" }]\n\n[nodes.blend_space_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { min = 210.0, preferred = 260.0, max = 310.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.blend_space_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.blend_space_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 188.0, preferred = 220.0, max = 250.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_title\" }, { node = \"blend_space_search\" }, { node = \"blend_space_left_content\" }]\n\n[nodes.blend_space_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionBlendSpaceLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"blend_space_assets_title\" }, { node = \"blend_space_idle_run_row\" }, { node = \"blend_space_strafe_row\" }, { node = \"blend_space_sprint_row\" }, { node = \"blend_space_search_empty\" }, { node = \"blend_space_left_divider\" }, { node = \"blend_space_files_title\" }, { node = \"blend_space_characters_tree_row\" }, { node = \"blend_space_locomotion_tree_row\" }, { node = \"blend_space_clips_tree_row\" }, { node = \"blend_space_left_fill\" }]\n\n[nodes.blend_space_title]