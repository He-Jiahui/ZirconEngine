penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/theme/editor_material.zui", "zircon_editor/assets/icons/zircon_editor_shell/controls/search.svg", "zircon_editor/assets/icons/ionicons/close-outline.svg", "zircon_editor/assets/icons/zircon_editor_shell/controls/field-stepper.svg" ]
penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/fyrox_panel_demo_window.zui\"\nversion = 2\ndisplay_name = \"Fyrox Panel Component Demo\"\n\n[imports]\nstyles = [\"res://ui/theme/editor_material.zui\"]\n\n[root]\nnode = \"workbench_shell\"\n\n[nodes.workbench_shell]\ncomponent = \"WorkbenchShell\"\ncontrol_id = \"FyroxPanelDemoShell\"\nclasses = [\"material_dark\", \"fyrox-panel-demo\", \"jetbrains-shell\"]\nlayout = { clip = true, input_policy = \"Receive\", width = { min = 0.0, stretch = \"Stretch\" }, height = { min = 0.0, stretch = \"Stretch\" }, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" } }\nchildren = [{ node = \"content_scroll\" }]\n\n[nodes.content_scroll]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"FyroxPanelContentScroll\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 12.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"scene_view\" },\n  { node = \"hierarchy_view\" },\n  { node = \"inspector_view\" },\n  { node = \"asset_browser_view\" },\n  { node = \"console_view\" },\n  { node = \"plugin_manager_view\" },\n  { node = \"material_editor_view\" },\n  { node = \"ui_asset_editor_view\" },\n  { node = \"animation_editor_view\" },\n]\n\n[nodes.scene_view]\ncomponent = \"View\"\ncontrol_id = \"FyroxSceneView\"\nprops = { view_id = \"editor.scene\", text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"scene_title\" },\n  { node = \"scene_toolbar\" },\n  { node = \"scene_viewport\" },\n  { node = \"scene_gizmos\" },\n]\n\n[nodes.scene_title]\ncomponent = \"Label\"\ncontrol_id = \"FyroxSceneViewTitle\"\nclasses = [\"fyrox-view-title\"]\nprops = { text = \"Scene\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.scene_toolbar]\ncomponent = \"PaneToolbar\"\ncontrol_id = \"ScenePaneToolbar\"\nchildren = [{ node = \"scene_toolbar_action\" }]\n\n[nodes.scene_toolbar_action]\ncomponent = \"IconButton\"\ncontrol_id = \"SceneToolbarAction\"\nclasses = [\"material-control\"]\nprops = { icon = \"move\", text = \"Move\" }\nlayout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.scene_viewport]\ncomponent = \"ViewportHost\"\ncontrol_id = \"SceneViewportHost\"\nprops = { camera_target = \"editor.camera.scene\" }\n\n[nodes.scene_gizmos]\ncomponent = \"GizmoControls\"\ncontrol_id = \"SceneGizmoControls\"\nprops = { mode = \"translate\" }\n\n[nodes.hierarchy_view]\ncomponent = \"View\"\ncontrol_id = \"FyroxHierarchyView\"\nprops = { view_id = \"editor.hierarchy\", text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"hierarchy_title\" },\n  { node = \"hierarchy_search\" },\n  { node = \"hierarchy_tree\" },\n  { node = \"hierarchy_context_menu\" },\n]\n\n[nodes.hierarchy_title]\ncomponent = \"Label\"\ncontrol_id = \"FyroxHierarchyViewTitle\"\nclasses = [\"fyrox-view-title\"]\nprops = { text = \"Hierarchy\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.hierarchy_search]\ncomponent = \"SearchField\"\ncontrol_id = \"HierarchySearch\"\nprops = { query = \"\" }\n\n[nodes.hierarchy_tree]\ncomponent = \"TreeView\"\ncontrol_id = \"HierarchyTree\"\nprops = { query = \"\" }\n\n[nodes.hierarchy_context_menu]\ncomponent = \"ContextMenu\"\ncontrol_id = \"HierarchyContextMenu\"\n\n[nodes.inspector_view]\ncomponent = \"View\"\ncontrol_id = \"FyroxInspectorView\"\nprops = { view_id = \"editor.inspector\", text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [{ node = \"inspector_title\" }, { node = \"inspector_grid\" }]\n\n[nodes.inspector_title]\ncomponent = \"Label\"\ncontrol_id = \"FyroxInspectorViewTitle\"\nclasses = [\"fyrox-view-title\"]\nprops = { text = \"Inspector\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.inspector_grid]\ncomponent = \"PropertyGrid\"\ncontrol_id = \"InspectorPropertyGrid\"\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [{ node = \"transform_section\" }]\n\n[nodes.transform_section]\ncomponent = \"InspectorSection\"\ncontrol_id = \"TransformSection\"\nprops = { text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [{ node = \"transform_title\" }, { node = \"field_editor\" }]\n\n[nodes.transform_title]\ncomponent = \"Label\"\ncontrol_id = \"TransformSectionTitle\"\nclasses = [\"fyrox-section-title\"]\nprops = { text = \"Transform\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.field_editor]\ncomponent = \"FieldEditor\"\ncontrol_id = \"PositionFieldEditor\"\nprops = { text = \"Position\", value_text = \"0, 0, 0\" }\n\n[nodes.asset_browser_view]\ncomponent = \"View\"\ncontrol_id = \"FyroxAssetBrowserView\"\nprops = { view_id = \"editor.assets\", text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"asset_browser_title\" },\n  { node = \"asset_folder_tree\" },\n  { node = \"asset_grid\" },\n  { node = \"asset_list\" },\n  { node = \"asset_preview\" },\n  { node = \"asset_metadata\" },\n]\n\n[nodes.asset_browser_title]\ncomponent = \"Label\"\ncontrol_id = \"FyroxAssetBrowserViewTitle\"\nclasses = [\"fyrox-view-title\"]\nprops = { text = \"Asset Browser\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.asset_folder_tree]\ncomponent = \"FolderTree\"\ncontrol_id = \"AssetFolderTree\"\nprops = { root_path = \"res://\", query = \"\" }\n\n[nodes.asset_grid]\ncomponent = \"AssetGrid\"\ncontrol_id = \"AssetGrid\"\nprops = { item_count = 64, query = \"\" }\n\n[nodes.asset_list]\ncomponent = \"AssetList\"\ncontrol_id = \"AssetList\"\nprops = { item_count = 64, query = \"\" }\n\n[nodes.asset_preview]\ncomponent = \"PreviewPane\"\ncontrol_id = \"AssetPreviewPane\"\nprops = { asset_id = \"res://materials/grid.zmat\" }\n\n[nodes.asset_metadata]\ncomponent = \"MetadataPane\"\ncontrol_id = \"AssetMetadataPane\"\nprops = { asset_id = \"res://materials/grid.zmat\" }\n\n[nodes.console_view]\ncomponent = \"View\"\ncontrol_id = \"FyroxConsoleView\"\nprops = { view_id = \"editor.console\", text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"console_title\" },\n  { node = \"console_filter\" },\n  { node = \"console_severity\" },\n  { node = \"console_logs\" },\n]\n\n[nodes.console_title]\ncomponent = \"Label\"\ncontrol_id = \"FyroxConsoleViewTitle\"\nclasses = [\"fyrox-view-title\"]\nprops = { text = \"Console\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.console_filter]\ncomponent = \"FilterBar\"\ncontrol_id = \"ConsoleFilterBar\"\nprops = { query = \"\", severity = \"all\" }\n\n[nodes.console_severity]\ncomponent = \"SeverityChips\"\ncontrol_id = \"ConsoleSeverityChips\"\nprops = { selected_severity = \"warning\" }\n\n[nodes.console_logs]\ncomponent = \"VirtualList\"\ncontrol_id = \"ConsoleVirtualList\"\nprops = { item_count = 10000, item_extent = 24.0, overscan = 4 }\n\n[nodes.plugin_manager_view]\ncomponent = \"View\"\ncontrol_id = \"FyroxPluginManagerView\"\nprops = { view_id = \"editor.module_plugins\", text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"plugin_manager_title\" },\n  { node = \"plugin_categories\" },\n  { node = \"plugin_actions\" },\n]\n\n[nodes.plugin_manager_title]\ncomponent = \"Label\"\ncontrol_id = \"FyroxPluginManagerViewTitle\"\nclasses = [\"fyrox-view-title\"]\nprops = { text = \"Plugin Manager\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.plugin_categories]\ncomponent = \"CategorizedList\"\ncontrol_id = \"PluginCategorizedList\"\nprops = { query = \"\" }\n\n[nodes.plugin_actions]\ncomponent = \"StatusActionControls\"\ncontrol_id = \"PluginStatusActions\"\nprops = { status = \"enabled\" }\n\n[nodes.material_editor_view]\ncomponent = \"View\"\ncontrol_id = \"FyroxMaterialEditorView\"\nprops = { view_id = \"editor.material.graph\", text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [{ node = \"material_title\" }, { node = \"material_graph\" }]\n\n[nodes.material_title]\ncomponent = \"Label\"\ncontrol_id = \"FyroxMaterialEditorViewTitle\"\nclasses = [\"fyrox-view-title\"]\nprops = { text = \"Material\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.material_graph]\ncomponent = \"GraphCanvas\"\ncontrol_id = \"MaterialGraphCanvas\"\n\n[nodes.ui_asset_editor_view]\ncomponent = \"View\"\ncontrol_id = \"FyroxUiAssetEditorView\"\nprops = { view_id = \"editor.ui.designer\", text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"ui_asset_title\" },\n  { node = \"ui_visual_designer\" },\n  { node = \"ui_source_editor\" },\n]\n\n[nodes.ui_asset_title]\ncomponent = \"Label\"\ncontrol_id = \"FyroxUiAssetEditorViewTitle\"\nclasses = [\"fyrox-view-title\"]\nprops = { text = \"UI Asset\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.ui_visual_designer]\ncomponent = \"VisualDesigner\"\ncontrol_id = \"UiVisualDesigner\"\n\n[nodes.ui_source_editor]\ncomponent = \"SourceEditor\"\ncontrol_id = \"UiSourceEditor\"\nprops = { text = \"[nodes.root]\" }\n\n[nodes.animation_editor_view]\ncomponent = \"View\"\ncontrol_id = \"FyroxAnimationEditorView\"\nprops = { view_id = \"editor.animation.timeline\", text = \"\" }\nlayout = { container = { kind = \"VerticalBox\", gap = 8.0 }, width = { stretch = \"Stretch\" } }\nchildren = [{ node = \"animation_title\" }, { node = \"animation_timeline\" }]\n\n[nodes.animation_title]\ncomponent = \"Label\"\ncontrol_id = \"FyroxAnimationEditorViewTitle\"\nclasses = [\"fyrox-view-title\"]\nprops = { text = \"Animation\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.animation_timeline]\ncomponent = \"Timeline\"\ncontrol_id = \"AnimationTimeline\"\nprops = { time = 1.25, duration = 4.0 }\n"

