[asset]
kind = "component"
id = "res://ui/editor/components/workbench/shell/workbench_viewport_panel.zui"
version = 2
display_name = "Workbench Viewport Panel"

[imports]
widgets = []
styles = []

[components.WorkbenchViewportPanel]
root = "viewport_panel"
default_classes = [ "workbench-viewport-panel" ]

[nodes.viewport_panel]
component = "VerticalGroup"
control_id = "WorkbenchViewportPanel"
classes = [ "workbench-viewport-panel" ]

[nodes.viewport_panel.layout]
clip = true

[nodes.viewport_panel.layout.container]
kind = "VerticalBox"
gap = 0

[nodes.viewport_panel.layout.width]
stretch = "Stretch"

[nodes.viewport_panel.layout.height]
stretch = "Stretch"

[[nodes.viewport_panel.children]]
node = "document_tabs"

[[nodes.viewport_panel.children]]
node = "viewport_toolbar"

[[nodes.viewport_panel.children]]
node = "viewport_surface"

[nodes.document_tabs]
component = "DocumentTabs"
control_id = "DocumentTabsRoot"
classes = [ "workbench-document-tabs", "workbench-tab-strip" ]

[nodes.document_tabs.layout.width]
stretch = "Stretch"

[nodes.document_tabs.layout.height]
min = "$editor.chrome.document_header.height"
preferred = "$editor.chrome.document_header.height"
max = "$editor.chrome.document_header.height"
stretch = "Fixed"

[[nodes.document_tabs.events]]
id = "Workbench/ActivateDocumentTab"
event = "Change"
route = "workbench.document_tabs.activate"

[[nodes.document_tabs.events]]
id = "Workbench/CloseDocumentTab"
event = "Submit"
route = "workbench.document_tabs.close"

[nodes.viewport_toolbar]
component = "ScrollableBox"
control_id = "WorkbenchViewportToolbar"
classes = [ "workbench-viewport-toolbar" ]

[nodes.viewport_toolbar.layout]
clip = true
input_policy = "Receive"

[nodes.viewport_toolbar.layout.container]
kind = "ScrollableBox"
axis = "Horizontal"
gap = "$editor.density.gap.medium"
scrollbar_visibility = "Never"

[nodes.viewport_toolbar.layout.width]
min = 0
stretch = "Stretch"

[nodes.viewport_toolbar.layout.height]
min = "$editor.chrome.viewport_toolbar.height"
preferred = "$editor.chrome.viewport_toolbar.height"
max = "$editor.chrome.viewport_toolbar.height"
stretch = "Fixed"

[[nodes.viewport_toolbar.children]]
node = "viewport_mode"

[[nodes.viewport_toolbar.children]]
node = "viewport_lit"

[[nodes.viewport_toolbar.children]]
node = "viewport_toolbar_fill"

[[nodes.viewport_toolbar.children]]
node = "viewport_angle"

[[nodes.viewport_toolbar.children]]
node = "viewport_speed"

[nodes.viewport_mode]
component = "Label"
control_id = "WorkbenchViewportMode"
pixel_snapping = "disabled"
classes = [ "workbench-chip", "workbench-primitive" ]
events = []
children = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/chrome/workbench_chip.zui#WorkbenchChip"

[nodes.viewport_mode.props]
text = "Perspective"
text_overflow = "ellipsis"
component_variant = "chip"
font_size = "$editor.typography.body.size"
line_height_ratio = "$editor.typography.line_height"
text_tone = "primary"
layout_padding_left = "$editor.density.gap.medium"
layout_padding_right = "$editor.density.gap.medium"
layout_padding_top = "$editor.density.gap.small"
layout_padding_bottom = "$editor.density.gap.small"
responsive_min_tier = "narrow"
layout_min_height = "$editor.chrome.viewport_toolbar.height"

[nodes.viewport_mode.layout.width]
min = 108
preferred = 108
max = 108
stretch = "Fixed"

[nodes.viewport_mode.layout.height]
min = "$editor.chrome.viewport_toolbar.height"
preferred = "$editor.chrome.viewport_toolbar.height"
max = "$editor.chrome.viewport_toolbar.height"
stretch = "Fixed"

[nodes.viewport_mode.state]
[nodes.viewport_mode.style.self]
[nodes.viewport_mode.style.slot]
[nodes.viewport_mode.slots]
[nodes.viewport_lit]
component = "Label"
control_id = "WorkbenchViewportLit"
pixel_snapping = "disabled"
classes = [ "workbench-chip", "workbench-primitive" ]
events = []
children = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/chrome/workbench_chip.zui#WorkbenchChip"

[nodes.viewport_lit.props]
text = "Lit"
text_overflow = "ellipsis"
component_variant = "chip"
font_size = "$editor.typography.body.size"
line_height_ratio = "$editor.typography.line_height"
text_tone = "primary"
layout_padding_left = "$editor.density.gap.medium"
layout_padding_right = "$editor.density.gap.medium"
layout_padding_top = "$editor.density.gap.small"
layout_padding_bottom = "$editor.density.gap.small"
layout_min_height = "$editor.chrome.viewport_toolbar.height"

[nodes.viewport_lit.layout.width]
min = 64
preferred = 64
max = 64
stretch = "Fixed"

[nodes.viewport_lit.layout.height]
min = "$editor.chrome.viewport_toolbar.height"
preferred = "$editor.chrome.viewport_toolbar.height"
max = "$editor.chrome.viewport_toolbar.height"
stretch = "Fixed"

[nodes.viewport_lit.state]
[nodes.viewport_lit.style.self]
[nodes.viewport_lit.style.slot]
[nodes.viewport_lit.slots]
[nodes.viewport_toolbar_fill]
component = "Container"
control_id = "WorkbenchViewportToolbarFill"

[nodes.viewport_toolbar_fill.layout.width]
stretch = "Stretch"

[nodes.viewport_toolbar_fill.layout.height]
stretch = "Stretch"

[nodes.viewport_angle]
component = "Label"
control_id = "WorkbenchViewportAngle"
pixel_snapping = "disabled"
classes = [ "workbench-chip", "workbench-primitive" ]
events = []
children = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/chrome/workbench_chip.zui#WorkbenchChip"

[nodes.viewport_angle.props]
text = "10 deg"
text_overflow = "ellipsis"
component_variant = "chip"
font_size = "$editor.typography.body.size"
line_height_ratio = "$editor.typography.line_height"
