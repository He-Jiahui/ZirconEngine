penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/shell/workbench_viewport_panel.zui\"\nversion = 2\ndisplay_name = \"Workbench Viewport Panel\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_chip.zui#WorkbenchChip\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel\",\n]\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.WorkbenchViewportPanel]\nroot = \"viewport_panel\"\ndefault_classes = [\"workbench-viewport-panel\"]\n\n[nodes.viewport_panel]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchViewportPanel\"\nclasses = [\"workbench-viewport-panel\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"document_tabs\" }, { node = \"viewport_toolbar\" }, { node = \"viewport_surface\" }]\n\n[nodes.document_tabs]\ncomponent = \"DocumentTabs\"\ncontrol_id = \"DocumentTabsRoot\"\nclasses = [\"workbench-document-tabs\", \"workbench-tab-strip\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.chrome.document_header.height\", preferred = \"$editor.chrome.document_header.height\", max = \"$editor.chrome.document_header.height\", stretch = \"Fixed\" } }\nevents = [\n  { id = \"Workbench/ActivateDocumentTab\", event = \"Change\", route = \"workbench.document_tabs.activate\" },\n  { id = \"Workbench/CloseDocumentTab\", event = \"Submit\", route = \"workbench.document_tabs.close\" },\n]\n\n[nodes.viewport_toolbar]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchViewportToolbar\"\nclasses = [\"workbench-viewport-toolbar\"]\n# Keep viewport controls at their authored hit-target sizes. At compact\n# widths the retained host exposes the same row as an independently\n# horizontally scrollable toolbar, instead of shrinking or overlapping the\n# Lit/angle controls.\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Never\" }, input_policy = \"Receive\", width = { min = 0.0, stretch = \"Stretch\" }, height = { min = \"$editor.chrome.viewport_toolbar.height\", preferred = \"$editor.chrome.viewport_toolbar.height\", max = \"$editor.chrome.viewport_toolbar.height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"viewport_mode\" }, { node = \"viewport_lit\" }, { node = \"viewport_toolbar_fill\" }, { node = \"viewport_angle\" }, { node = \"viewport_speed\" }]\n\n[nodes.viewport_mode]\ncomponent = \"WorkbenchChip\"\ncontrol_id = \"WorkbenchViewportMode\"\nclasses = [\"workbench-chip\"]\nprops = { text = \"Perspective\", responsive_min_tier = \"narrow\", layout_min_height = \"$editor.chrome.viewport_toolbar.height\" }\nlayout = { width = { min = 108.0, preferred = 108.0, max = 108.0, stretch = \"Fixed\" }, height = { min = \"$editor.chrome.viewport_toolbar.height\", preferred = \"$editor.chrome.viewport_toolbar.height\", max = \"$editor.chrome.viewport_toolbar.height\", stretch = \"Fixed\" } }\n\n[nodes.viewport_lit]\ncomponent = \"WorkbenchChip\"\ncontrol_id = \"WorkbenchViewportLit\"\nclasses = [\"workbench-chip\"]\nprops = { text = \"Lit\", layout_min_height = \"$editor.chrome.viewport_toolbar.height\" }\nlayout = { width = { min = 64.0, preferred = 64.0, max = 64.0, stretch = \"Fixed\" }, height = { min = \"$editor.chrome.viewport_toolbar.height\", preferred = \"$editor.chrome.viewport_toolbar.height\", max = \"$editor.chrome.viewport_toolbar.height\", stretch = \"Fixed\" } }\n\n[nodes.viewport_toolbar_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchViewportToolbarFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.viewport_angle]\ncomponent = \"WorkbenchChip\"\ncontrol_id = \"WorkbenchViewportAngle\"\nclasses = [\"workbench-chip\"]\nprops = { text = \"10 deg\", responsive_min_tier = \"regular\", layout_min_height = \"$editor.chrome.viewport_toolbar.height\" }\nlayout = { width = { min = 70.0, preferred = 70.0, max = 70.0, stretch = \"Fixed\" }, height = { min = \"$editor.chrome.viewport_toolbar.height\", preferred = \"$editor.chrome.viewport_toolbar.height\", max = \"$editor.chrome.viewport_toolbar.height\", stretch = \"Fixed\" } }\n\n[nodes.viewport_speed]\ncomponent = \"WorkbenchChip\"\ncontrol_id = \"WorkbenchViewportSpeed\"\nclasses = [\"workbench-chip\"]\nprops = { text = \"0.25\", responsive_min_tier = \"wide\", layout_min_height = \"$editor.chrome.viewport_toolbar.height\" }\nlayout = { width = { min = 70.0, preferred = 70.0, max = 70.0, stretch = \"Fixed\" }, height = { min = \"$editor.chrome.viewport_toolbar.height\", preferred = \"$editor.chrome.viewport_toolbar.height\", max = \"$editor.chrome.viewport_toolbar.height\", stretch = \"Fixed\" } }\n\n[nodes.viewport_surface]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchViewportSurface\"\nclasses = [\"workbench-viewport-surface\"]\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"viewport_backdrop\" },\n  { node = \"viewport_ceiling\" },\n  { node = \"viewport_back_wall\" },\n  { node = \"viewport_wall_detail_center_lines\" },\n  { node = \"viewport_side_left\" },\n  { node = \"viewport_side_left_stairs\" },\n  { node = \"viewport_side_right\" },\n  { node = \"viewport_back_door\" },\n  { node = \"viewport_door_core\" },\n  { node = \"viewport_wall_column_left\" },\n  { node = \"viewport_wall_column_right\" },\n  { node = \"viewport_wall_beacon_left\" },\n  { node = \"viewport_wall_beacon_right\" },\n  { node = \"viewport_lightwash_left\" },\n  { node = \"viewport_lightwash_center\" },\n  { node = \"viewport_shadow_top_bay\" },\n  { node = \"viewport_shadow_ceiling_left\" },\n  { node = \"viewport_shadow_ceiling_mid\" },\n  { node = \"viewport_lightwash_wall_right\" },\n  { node = \"viewport_lightwash_rear_walkway\" },\n  { node = \"viewport_rack_left\" },\n  { node = \"viewport_floor\" },\n  { node = \"viewport_floor_reflection\" },\n  { node = \"viewport_floor_grate_right\" },\n  { node = \"viewport_floor_panel_1\" },\n  { node = \"viewport_floor_panel_2\" },\n  { node = \"viewport_floor_panel_3\" },\n  { node = \"viewport_floor_grid_h0\" },\n  { node = \"viewport_floor_grid_h1\" },\n  { node = \"viewport_floor_grid_h2\" },\n  { node = \"viewport_floor_grid_h3\" },\n  { node = \"viewport_floor_grid_h4\" },\n  { node = \"viewport_floor_grid_h5\" },\n  { node = \"viewport_floor_grid_v0\" },\n  { node = \"viewport_floor_grid_v1\" },\n  { node = \"viewport_floor_grid_v2\" },\n  { node = \"viewport_floor_grid_v3\" },\n  { node = \"viewport_floor_grid_v4\" },\n  { node = \"viewport_floor_grid_v5\" },\n  { node = \"viewport_floor_grid_v6\" },\n  { node = \"viewport_floor_seam_right\" },\n  { node = \"viewport_lightwash_lower\" },\n  { node = \"viewport_lightwash_floor\" },\n  { node = \"viewport_lightwash_floor_cool\" },\n  { node = \"viewport_lightwash_floor_right\" },\n  { node = \"viewport_shadow_left_floor\" },\n  { node = \"viewport_shadow_right_floor\" },\n  { node = \"viewport_wall_light_left\" },\n  { node = \"viewport_wall_light_center\" },\n  { node = \"viewport_wall_light_right\" },\n  { node = \"viewport_wall_light_far_right\" },\n  { node = \"viewport_handrail_left\" },\n  { node = \"viewport_handrail_right\" },\n  { node = \"viewport_cargo_left\" },\n  { node = \"viewport_cargo_left_inner\" },\n  { node = \"viewport_cargo_right\" },\n  { node = \"viewport_cargo_right_inner\" },\n  { node = \"viewport_cargo_lower_left\" },\n  { node = \"viewport_cargo_lower_left_inner\" },\n  { node = \"viewport_cargo_far_right\" },\n  { node = \"viewport_cargo_far_right_inner\" },\n  { node = \"viewport_prop_shadow\" },\n  { node = \"viewport_prop_body\" },\n  { node = \"viewport_prop_top\" },\n  { node = \"viewport_prop_edge_top\" }