penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/host/generated_bottom_body.zui\"\nversion = 2\ndisplay_name = \"generated bottom pane body\"\n\n[root]\nnode = \"root\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/modules/generated/workbench_generated_bottom_panel.zui#WorkbenchGeneratedBottomPanel\",\n]\nstyles = []\n\n[nodes.root]\npixel_snapping = \"disabled\"\ncomponent = \"VerticalGroup\"\ncontrol_id = \"GeneratedBottomPaneBodyRoot\"\nclasses = [\"editor-pane\", \"generated-bottom-pane\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"panel_host\" }]\n\n[nodes.panel_host]\ncomponent = \"Overlay\"\ncontrol_id = \"GeneratedBottomPanePanelHost\"\nlayout = { container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"panel_body\" }]\n\n[nodes.panel_body]\ncomponent = \"WorkbenchGeneratedBottomPanel\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n"

[asset]
kind = "view"
id = "res://ui/editor/host/generated_bottom_body.zui"
version = 2
display_name = "generated bottom pane body"

[root]
