penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/host/scene_viewport_toolbar.zui\"\nversion = 2\ndisplay_name = \"scene viewport toolbar\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\npixel_snapping = \"disabled\"\ncomponent = \"SceneViewportToolbar\"\ncontrol_id = \"SceneViewportToolbarRoot\"\nclasses = [\"viewport-toolbar\"]\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nchildren = [\n  { node = \"left_group\" },\n  { node = \"fill\" },\n  { node = \"right_group\" },\n]\n\n[nodes.left_group]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"SceneViewportToolbarLeftGroup\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Never\" }, input_policy = \"Receive\", width = { min = 0.0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"activate_scene_mode\" },\n  { node = \"set_transform_space\" },\n  { node = \"set_pivot_mode\" },\n  { node = \"set_display_mode\" },\n  { node = \"set_grid_mode\" },\n  { node = \"set_translate_snap\" },\n  { node = \"set_rotate_snap\" },\n  { node = \"set_scale_snap\" },\n  { node = \"set_preview_lighting\" },\n  { node = \"set_preview_skybox\" },\n  { node = \"set_gizmos\" },\n  { node = \"frame_selection\" },\n  { node = \"enter_play\" },\n  { node = \"exit_play\" },\n]\n\n[nodes.fill]\ncomponent = \"Space\"\ncontrol_id = \"SceneViewportToolbarFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.right_group]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"SceneViewportToolbarRightGroup\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { min = 60.0, preferred = 60.0, max = 60.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"set_projection_mode\" }, { node = \"align_view\" }]\n\n[nodes.activate_scene_mode]\ncomponent = \"IconButton\"\ncontrol_id = \"ActivateSceneMode\"\nprops = { label = \"Tool\", icon = \"editor_pages/scene_viewport/tools/universal-transform.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/ActivateSceneMode\", event = \"Change\", route = \"workbench.viewport.activate_scene_mode\" }]\n\n[nodes.set_transform_space]\ncomponent = \"IconButton\"\ncontrol_id = \"SetTransformSpace\"\nprops = { label = \"Space\", icon = \"resize-outline\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetTransformSpace\", event = \"Change\", route = \"workbench.viewport.set_transform_space\" }]\n\n[nodes.set_pivot_mode]\ncomponent = \"IconButton\"\ncontrol_id = \"SetPivotMode\"\nprops = { label = \"Pivot\", icon = \"locate-outline\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetPivotMode\", event = \"Change\", route = \"workbench.viewport.set_pivot_mode\" }]\n\n[nodes.set_display_mode]\ncomponent = \"IconButton\"\ncontrol_id = \"SetDisplayMode\"\nprops = { label = \"Display\", icon = \"editor_pages/scene_viewport/display/lit.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetDisplayMode\", event = \"Change\", route = \"workbench.viewport.set_display_mode\" }]\n\n[nodes.set_grid_mode]\ncomponent = \"IconButton\"\ncontrol_id = \"SetGridMode\"\nprops = { label = \"Grid\", icon = \"editor_pages/scene_viewport/display/grid-overlay.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetGridMode\", event = \"Change\", route = \"workbench.viewport.set_grid_mode\" }]\n\n[nodes.set_translate_snap]\ncomponent = \"IconButton\"\ncontrol_id = \"SetTranslateSnap\"\nprops = { label = \"Move\", icon = \"editor_pages/scene_viewport/snapping/grid-snap.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetTranslateSnap\", event = \"Change\", route = \"workbench.viewport.set_translate_snap\" }]\n\n[nodes.set_rotate_snap]\ncomponent = \"IconButton\"\ncontrol_id = \"SetRotateSnapDegrees\"\nprops = { label = \"Rotate\", icon = \"editor_pages/scene_viewport/snapping/angle-snap.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetRotateSnapDegrees\", event = \"Change\", route = \"workbench.viewport.set_rotate_snap_degrees\" }]\n\n[nodes.set_scale_snap]\ncomponent = \"IconButton\"\ncontrol_id = \"SetScaleSnap\"\nprops = { label = \"Scale\", icon = \"editor_pages/scene_viewport/snapping/scale-snap.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetScaleSnap\", event = \"Change\", route = \"workbench.viewport.set_scale_snap\" }]\n\n[nodes.set_preview_lighting]\ncomponent = \"IconButton\"\ncontrol_id = \"SetPreviewLighting\"\nprops = { label = \"Light\", icon = \"editor_pages/scene_viewport/display/lit.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetPreviewLighting\", event = \"Change\", route = \"workbench.viewport.set_preview_lighting\" }]\n\n[nodes.set_preview_skybox]\ncomponent = \"IconButton\"\ncontrol_id = \"SetPreviewSkybox\"\nprops = { label = \"Sky\", icon = \"cloud-outline\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetPreviewSkybox\", event = \"Change\", route = \"workbench.viewport.set_preview_skybox\" }]\n\n[nodes.set_gizmos]\ncomponent = \"IconButton\"\ncontrol_id = \"SetGizmosEnabled\"\nprops = { label = \"Gizmo\", icon = \"editor_pages/scene_viewport/display/gizmo-visibility.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetGizmosEnabled\", event = \"Change\", route = \"workbench.viewport.set_gizmos_enabled\" }]\n\n[nodes.frame_selection]\ncomponent = \"IconButton\"\ncontrol_id = \"FrameSelection\"\nprops = { label = \"Frame\", icon = \"editor_pages/scene_viewport/camera/frame-selection.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/FrameSelection\", event = \"Click\", route = \"workbench.viewport.frame_selection\" }]\n\n[nodes.enter_play]\ncomponent = \"IconButton\"\ncontrol_id = \"EnterPlayMode\"\nprops = { label = \"Play\", icon = \"editor_pages/scene_viewport/play/play.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/EnterPlayMode\", event = \"Click\", action = { action = \"runtime.play_mode.enter\" } }]\n\n[nodes.exit_play]\ncomponent = \"IconButton\"\ncontrol_id = \"ExitPlayMode\"\nprops = { label = \"Stop\", icon = \"editor_pages/scene_viewport/play/stop.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/ExitPlayMode\", event = \"Click\", action = { action = \"runtime.play_mode.exit\" } }]\n\n[nodes.set_projection_mode]\ncomponent = \"IconButton\"\ncontrol_id = \"SetProjectionMode\"\nprops = { label = \"Camera\", icon = \"editor_pages/scene_viewport/camera/perspective.svg\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/SetProjectionMode\", event = \"Change\", route = \"workbench.viewport.set_projection_mode\" }]\n\n[nodes.align_view]\ncomponent = \"IconButton\"\ncontrol_id = \"AlignView\"\nprops = { label = \"Align\", icon = \"navigate-outline\", icon_placement = \"icon_only\" }\nlayout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ViewportToolbar/AlignView\", event = \"Change\", route = \"workbench.viewport.align_view\" }]\n"

[asset]
kind = "view"
id = "res://ui/editor/host/scene_viewport_toolbar.zui"
version = 2
display_name = "scene viewport toolbar"

[root]
node = "root"

[nodes.root]
pixel_snapping = "disabled"
component = "SceneViewportToolbar"
control_id = "SceneViewportToolbarRoot"
classes = [ "viewport-toolbar" ]

[nodes.root.layout.container]
