gap = "$editor.density.gap.small"

[nodes.root.layout.width]
stretch = "Stretch"

[nodes.root.layout.height]
min = 28
preferred = 28
max = 28
stretch = "Fixed"

[[nodes.root.children]]
node = "left_group"

[[nodes.root.children]]
node = "fill"

[[nodes.root.children]]
node = "right_group"

