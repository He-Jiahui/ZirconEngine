[nodes.enter_play]
component = "IconButton"
control_id = "EnterPlayMode"
penpot_icon_svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Play\"><circle cx=\"12\" cy=\"12\" r=\"8\" fill=\"#172033\" stroke=\"#cbd2dc\" stroke-width=\"1.4\"/><path fill=\"#63d489\" d=\"m10 8 7 4-7 4z\"/></svg>\n"

[nodes.enter_play.props]
label = "Play"
icon = "editor_pages/scene_viewport/play/play.svg"
icon_placement = "icon_only"

[nodes.enter_play.layout.width]
min = 28
preferred = 28
max = 28
stretch = "Fixed"

[nodes.enter_play.layout.height]
stretch = "Stretch"

[[nodes.enter_play.events]]
id = "ViewportToolbar/EnterPlayMode"
event = "Click"

[nodes.enter_play.events.action]
action = "runtime.play_mode.enter"

[nodes.exit_play]
component = "IconButton"
control_id = "ExitPlayMode"
penpot_icon_svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Stop\"><circle cx=\"12\" cy=\"12\" r=\"8\" fill=\"#172033\" stroke=\"#cbd2dc\" stroke-width=\"1.4\"/><rect x=\"8.5\" y=\"8.5\" width=\"7\" height=\"7\" rx=\"1\" fill=\"#e16666\"/></svg>\n"

[nodes.exit_play.props]
label = "Stop"
icon = "editor_pages/scene_viewport/play/stop.svg"
icon_placement = "icon_only"

[nodes.exit_play.layout.width]
min = 28
preferred = 28
max = 28
stretch = "Fixed"

[nodes.exit_play.layout.height]
stretch = "Stretch"

[[nodes.exit_play.events]]
id = "ViewportToolbar/ExitPlayMode"
event = "Click"

[nodes.exit_play.events.action]
action = "runtime.play_mode.exit"

[nodes.set_projection_mode]
component = "IconButton"
control_id = "SetProjectionMode"
penpot_icon_svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Perspective\"><path fill=\"#172033\" stroke=\"#cbd2dc\" stroke-linejoin=\"round\" stroke-width=\"1.4\" d=\"m5 17 7-10 7 10z\"/><path fill=\"none\" stroke=\"#26d8d1\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.3\" d=\"M12 7v10M8 17l4-10 4 10\"/><path fill=\"none\" stroke=\"#64748b\" stroke-linecap=\"round\" stroke-width=\"1.1\" d=\"M5 19h14\"/></svg>\n"

[nodes.set_projection_mode.props]
label = "Camera"
icon = "editor_pages/scene_viewport/camera/perspective.svg"
icon_placement = "icon_only"

[nodes.set_projection_mode.layout.width]
min = 28
preferred = 28
max = 28
stretch = "Fixed"

[nodes.set_projection_mode.layout.height]
stretch = "Stretch"

[[nodes.set_projection_mode.events]]
id = "ViewportToolbar/SetProjectionMode"
event = "Change"
route = "workbench.viewport.set_projection_mode"

[nodes.align_view]
component = "IconButton"
control_id = "AlignView"

[nodes.align_view.props]
