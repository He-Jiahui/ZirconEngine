penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/extensions/animation/workbench_extension_animation_compression_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Extension Animation Compression Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n]\nstyles = []\n\n[components.WorkbenchExtensionAnimationCompressionWorkspace]\nroot = \"animation_compression_workspace\"\ndefault_classes = [\"workbench-module-body\", \"workbench-extension-module-body\"]\n\n[nodes.animation_compression_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionWorkspace\"\nclasses = [\"workbench-module-body\", \"workbench-extension-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"animation_compression_workspace_main\" },\n  { node = \"animation_compression_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.animation_compression_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"animation_compression_rail_gap\" }, { node = \"animation_compression_left\" }, { node = \"animation_compression_center\" }, { node = \"animation_compression_right_reserve\" }]\n\n[nodes.animation_compression_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.animation_compression_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.animation_compression_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"animation_compression_title\" }, { node = \"animation_compression_left_content\" }]\n\n[nodes.animation_compression_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"animation_compression_locomotion_row\" }, { node = \"animation_compression_combat_row\" }, { node = \"animation_compression_cinematic_row\" }]\n\n[nodes.animation_compression_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionTitle\"\nprops = { text = \"Animation Compression\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.animation_compression_locomotion_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionLocomotionRow\"\nclasses = [\"workbench-list-row\", \"workbench-row-selected\"]\nprops = { text = \"AC_Locomotion\", icon = \"play\", selected = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/AnimationCompressionLocomotionRow\", event = \"Click\", route = \"workbench.extension.animation_compression.profile.locomotion\" }]\n\n[nodes.animation_compression_combat_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionCombatRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"AC_Combat\", icon = \"target\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/AnimationCompressionCombatRow\", event = \"Click\", route = \"workbench.extension.animation_compression.profile.combat\" }]\n\n[nodes.animation_compression_cinematic_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionCinematicRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"AC_Cinematic\", icon = \"component\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/AnimationCompressionCinematicRow\", event = \"Click\", route = \"workbench.extension.animation_compression.profile.cinematic\" }]\n\n[nodes.animation_compression_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"animation_compression_center_header\" }, { node = \"animation_compression_clip_table\" }, { node = \"animation_compression_output\" }]\n\n[nodes.animation_compression_center_header]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionCenterHeader\"\nclasses = [\"workbench-panel-toolbar\"]\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Never\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"animation_compression_center_title\" }, { node = \"animation_compression_header_fill\" }, { node = \"animation_compression_preview_button\" }, { node = \"animation_compression_compress_button\" }]\n\n[nodes.animation_compression_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionCenterTitle\"\nprops = { text = \"Clip Budget\" }\nlayout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.animation_compression_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.animation_compression_preview_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionPreviewButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Preview\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 78, preferred = 78, max = 88, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/AnimationCompressionPreview\", event = \"Click\", route = \"workbench.extension.animation_compression.preview\" }]\n\n[nodes.animation_compression_compress_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionCompressButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Compress\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 88, preferred = 88, max = 98, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/AnimationCompressionCompress\", event = \"Click\", route = \"workbench.extension.animation_compression.compress\" }]\n\n[nodes.animation_compression_clip_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionClipTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"animation_compression_run_clip_table_row\" }, { node = \"animation_compression_attack_clip_table_row\" }, { node = \"animation_compression_facial_clip_table_row\" }, { node = \"animation_compression_error_clip_table_row\" }]\n\n[nodes.animation_compression_run_clip_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionRunClipTableRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Run_Fwd\", value_text = \"ratio 8.2:1   max err 0.18 cm   selected\", selected = true, options = [\"Run_Fwd\",\"ratio 8.2:1\",\"max err 0.18 cm\",\"selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/AnimationCompressionRunClipTableRow\", event = \"Click\", route = \"workbench.extension.animation_compression.clip.run\" }]\n\n[nodes.animation_compression_attack_clip_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionAttackClipTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Attack_Light\", value_text = \"ratio 6.4:1   additive curves   Clean\", options = [\"Attack_Light\",\"ratio 6.4:1\",\"additive curves\",\"Clean\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/AnimationCompressionAttackClipTableRow\", event = \"Click\", route = \"workbench.extension.animation_compression.clip.attack\" }]\n\n[nodes.animation_compression_facial_clip_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionFacialClipTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Face_Talk_A\", value_text = \"ratio 4.1:1   curve rich   Review\", options = [\"Face_Talk_A\",\"ratio 4.1:1\",\"curve rich\",\"Review\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/AnimationCompressionFacialClipTableRow\", event = \"Click\", route = \"workbench.extension.animation_compression.clip.facial\" }]\n\n[nodes.animation_compression_error_clip_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionErrorClipTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Turn_180\", value_text = \"ratio 10.5:1   max err 1.8 cm   Warning\", options = [\"Turn_180\",\"ratio 10.5:1\",\"max err 1.8 cm\",\"Warning\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/AnimationCompressionErrorClipTableRow\", event = \"Click\", route = \"workbench.extension.animation_compression.clip.error\" }]\n\n[nodes.animation_compression_output]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionOutputRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Animation Compression\", value_text = \"AC_Locomotion   312 clips   3 warnings\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, options = [\"Animation Compression\",\"AC_Locomotion\",\"312 clips\",\"3 warnings\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\n\n[nodes.animation_compression_right]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionRightPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"animation_compression_details_title\" }, { node = \"animation_compression_right_content\" }]\n\n[nodes.animation_compression_right_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionRightContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"animation_compression_codec_dropdown_property_row\" }, { node = \"animation_compression_tolerance_field_property_row\" }, { node = \"animation_compression_rate_field_property_row\" }]\n\n[nodes.animation_compression_details_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionDetailsTitle\"\nprops = { text = \"Compression Settings\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.animation_compression_codec_dropdown_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionCodecDropdownPropertyRow\"\nprops = { text = \"Codec\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"animation_compression_codec_dropdown\", slot = { name = \"value\" } }]\n\n[nodes.animation_compression_codec_dropdown]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionCodecDropdown\"\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\nprops = { value_text = \"ACL Uniform\", value = \"ACL Uniform\", options = [\"ACL Uniform\", \"ACL Variable\", \"Per Track\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/AnimationCompressionCodecEdit\", event = \"Change\", route = \"workbench.extension.animation_compression.codec.edit\" },\n  { id = \"WorkbenchExtension/AnimationCompressionCodecCommit\", event = \"Submit\", route = \"workbench.extension.animation_compression.codec.commit\" },\n]\n\n[nodes.animation_compression_tolerance_field_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionToleranceFieldPropertyRow\"\nprops = { text = \"Tolerance\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"animation_compression_tolerance_field\", slot = { name = \"value\" } }]\n\n[nodes.animation_compression_tolerance_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionToleranceField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"Tolerance: 0.5 cm\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchExtension/AnimationCompressionToleranceEdit\", event = \"Change\", route = \"workbench.extension.animation_compression.tolerance.edit\" },\n  { id = \"WorkbenchExtension/AnimationCompressionToleranceCommit\", event = \"Submit\", route = \"workbench.extension.animation_compression.tolerance.commit\" },\n]\n\n[nodes.animation_compression_rate_field_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionRateFieldPropertyRow\"\nprops = { text = \"Rate\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"animation_compression_rate_field\", slot = { name = \"value\" } }]\n\n[nodes.animation_compression_rate_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchExtensionAnimationCompressionRateField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"Sample Rate: 30 Hz\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, m