penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/core/gameplay/workbench_ability_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Ability Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n]\nstyles = []\n[components.WorkbenchAbilityWorkspace]\nroot = \"ability_workspace\"\ndefault_classes = [\"workbench-module-body\"]\n\n[nodes.ability_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchModuleAbilityWorkspace\"\nclasses = [\"workbench-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"ability_workspace_main\" },\n  { node = \"ability_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.ability_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"ability_rail_gap\" }, { node = \"ability_left\" }, { node = \"ability_center\" }, { node = \"ability_right_reserve\" }]\n\n[nodes.ability_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.ability_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchAbilityRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.ability_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchAbilityLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"ability_title\" }, { node = \"ability_left_content\" }]\n\n[nodes.ability_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchAbilityLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"ability_task_row_01\" }, { node = \"ability_task_row_02\" }, { node = \"ability_asset_row\" }]\n\n[nodes.ability_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchAbilityTitle\"\nprops = { text = \"Gameplay Ability\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.ability_task_row_01]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchAbilityTaskActivateRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Activate Ability\", icon = \"play\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AbilityTaskActivate\", event = \"Click\", route = \"workbench.module.ability.task.activate\" }]\n\n[nodes.ability_task_row_02]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchAbilityTaskCostRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Apply Cost\", icon = \"gear\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AbilityTaskCost\", event = \"Click\", route = \"workbench.module.ability.task.cost\" }]\n\n[nodes.ability_asset_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchAbilityAssetRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"GA_DashAttack\", icon = \"play\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AbilityAssetDash\", event = \"Click\", route = \"workbench.module.ability.asset.dash\" }]\n\n[nodes.ability_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchAbilityCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"ability_center_header\" }, { node = \"ability_graph_canvas\" }, { node = \"ability_output\" }]\n\n[nodes.ability_center_header]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchAbilityCenterHeader\"\nclasses = [\"workbench-panel-toolbar\"]\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"ability_center_title\" }, { node = \"ability_header_fill\" }, { node = \"ability_playtest_button\" }]\n\n[nodes.ability_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchAbilityCenterTitle\"\nprops = { text = \"Ability Graph\" }\nlayout = { width = { min = 160.0, preferred = 160.0, max = 180.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.ability_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchAbilityHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.ability_playtest_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchAbilityPlaytestButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Playtest\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 82, preferred = 82, max = 92, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AbilityPlaytest\", event = \"Click\", route = \"workbench.module.ability.playtest\" }]\n\n[nodes.ability_graph_canvas]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchAbilityGraphCanvas\"\nclasses = [\"workbench-panel\", \"workbench-module-graph\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.regular\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"ability_phase_table\" }, { node = \"ability_phase_row_01\" }, { node = \"ability_phase_row_02\" }, { node = \"ability_graph_row\" }]\n\n[nodes.ability_phase_table]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchAbilityPhaseTable\"\nprops = { text = \"Phase Matrix\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.ability_phase_row_01]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAbilityPhaseActivateRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Activation\", value_text = \"Activate Ability   Server   Ready\", options = [\"Activation\",\"Activate Ability\",\"Server\",\"Ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AbilityPhaseActivate\", event = \"Click\", route = \"workbench.module.ability.phase.activate\" }]\n\n[nodes.ability_phase_row_02]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAbilityPhaseCostRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Cost\", value_text = \"GE_DashAttack_Cost   Predicted   Ready\", options = [\"Cost\",\"GE_DashAttack_Cost\",\"Predicted\",\"Ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AbilityPhaseCost\", event = \"Click\", route = \"workbench.module.ability.phase.cost\" }]\n\n[nodes.ability_graph_row]\ncomponent = \"WorkbenchPropertyRow\"\ncontrol_id = \"WorkbenchAbilityGraphRow\"\nclasses = [\"workbench-property-row\"]\nprops = { text = \"Graph\", value_text = \"Activate -> Cost -> Montage -> Damage -> End\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 48.0, preferred = 48.0, max = 48.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AbilityGraphSelect\", event = \"Click\", route = \"workbench.module.ability.graph.select\" }]\n\n[nodes.ability_output]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchAbilityOutputRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Timeline\", value_text = \"1.22s Ability Activated   OK   GA_DashAttack\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, options = [\"Timeline\",\"1.22s Ability Activated\",\"OK\",\"GA_DashAttack\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\n\n[nodes.ability_right]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchAbilityRightPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"ability_details_title\" }, { node = \"ability_right_content\" }]\n\n[nodes.ability_right_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchAbilityRightContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"ability_name_property_row\" }, { node = \"ability_net_policy_property_row\" }, { node = \"ability_cooldown_property_row\" }, { node = \"ability_animation_tools_button\" }]\n\n[nodes.ability_details_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchAbilityDetailsTitle\"\nprops = { text = \"Details\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.ability_name_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchAbilityNamePropertyRow\"\nprops = { text = \"Name\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"ability_name_field\", slot = { name = \"value\" } }]\n\n[nodes.ability_name_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchAbilityNameField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"GA_DashAttack\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/AbilityNameEdit\", event = \"Change\", route = \"workbench.module.ability.name.edit\" },\n  { id = \"WorkbenchModule/AbilityNameCommit\", event = \"Submit\", route = \"workbench.module.ability.name.commit\" },\n]\n\n[nodes.ability_net_policy_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchAbilityNetPolicyPropertyRow\"\nprops = { text = \"Net Policy\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"ability_net_policy_dropdown\", slot = { name = \"value\" } }]\n\n[nodes.ability_net_policy_dropdown]\ncomponent = \"WorkbenchDropdown\"\ncontrol_id = \"WorkbenchAbilityNetPolicyDropdown\"\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\nprops = { value = \"server_initiated\", value_text = \"Server Initiated\", options = [\"server_initiated|label=Server Initiated\", \"client_predicted|label=Client Predicted\", \"local_only|label=Local Only\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/AbilityNetPolicyEdit\", event = \"Change\", route = \"workbench.module.ability.net_policy.edit\" },\n  { id = \"WorkbenchModule/AbilityNetPolicyCommit\", event = \"Submit\", route = \"workbench.module.ability.net_policy.commit\" },\n]\n\n[nodes.ability_cooldown_property_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"WorkbenchAbilityCooldownPropertyRow\"\nprops = { text = \"Cooldown\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"ability_cooldown_field\", slot = { name = \"value\" } }]\n\n[nodes.ability_cooldown_field]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"WorkbenchAbilityCooldownField\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"4.00s\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\nevents = [\n  { id = \"WorkbenchModule/AbilityCooldownEdit\", event = \"Change\", route = \"workbench.module.ability.cooldown.edit\" },\n  { id = \"WorkbenchModule/AbilityCooldownCommit\", event = \"Submit\", route = \"workbench.module.ability.cooldown.commit\" },\n]\n\n[nodes.ability_animation_tools_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchAbilityAnimationTools\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Animation Tools\", icon = \"more\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchModule/AbilityAnimationToolsOpen\", event = \"Click\", route = \"workbench.module.ability.animation_tools.open\" }]\n"

