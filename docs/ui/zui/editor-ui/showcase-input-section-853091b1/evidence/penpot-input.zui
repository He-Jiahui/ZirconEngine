penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/showcase/showcase_input_section.zui\"\nversion = 2\ndisplay_name = \"Showcase Input Section\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.ShowcaseInputSection]\nroot = \"input_section_root\"\ndefault_classes = [\"showcase-panel\", \"material-surface\"]\n\n[nodes.section_title]\ncomponent = \"Label\"\ncontrol_id = \"ComponentShowcaseInputSectionTitle\"\nclasses = [\"showcase-section-title\"]\nprops = { text = \"Inputs and Numeric Fields\", font_size = \"$editor.typography.body.size\", font_weight = \"$editor.typography.emphasis.weight\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.button_demo]\ncomponent = \"Button\"\ncontrol_id = \"ButtonDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-button\"]\nprops = { text = \"Primary Button\", surface_variant = \"accent\", button_variant = \"primary\", button_color = \"primary\", button_size = \"medium\", icon_placement = \"none\", text_tone = \"primary\", validation_level = \"normal\", hovered = false, pressed = false, focused = false, selected = false, checked = false, disabled = false, corner_radius = \"$editor.control.radius.control\", border_width = \"$editor.control.border_width\", layout_padding_left = \"$editor.density.gap.large\", layout_padding_right = \"$editor.density.gap.large\", layout_padding_top = \"$editor.density.gap.small\", layout_padding_bottom = \"$editor.density.gap.small\", layout_spacing = \"$editor.density.gap.small\", layout_min_width = \"$editor.control.height.default\", layout_min_height = \"$editor.control.height.default\", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/ButtonCommit\", event = \"Click\", component_event = \"Commit\", route = \"component_lab.showcase.commit.button\" },\n]\n\n[nodes.button_outlined_demo]\ncomponent = \"Button\"\ncontrol_id = \"ButtonOutlinedDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-button\"]\nprops = { text = \"Outlined Button\", button_variant = \"outlined\", button_color = \"primary\", button_size = \"medium\", icon_placement = \"none\", text_tone = \"primary\", validation_level = \"normal\", hovered = false, pressed = false, focused = true, selected = false, checked = false, disabled = false, corner_radius = \"$editor.control.radius.control\", border_width = \"$editor.control.border_width\", layout_padding_left = \"$editor.density.gap.large\", layout_padding_right = \"$editor.density.gap.large\", layout_padding_top = \"$editor.density.gap.small\", layout_padding_bottom = \"$editor.density.gap.small\", layout_spacing = \"$editor.density.gap.small\", layout_min_width = \"$editor.control.height.default\", layout_min_height = \"$editor.control.height.default\", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.button_text_demo]\ncomponent = \"Button\"\ncontrol_id = \"ButtonTextDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-button\"]\nprops = { text = \"Text Button\", button_variant = \"text\", button_color = \"primary\", button_size = \"medium\", icon_placement = \"none\", text_tone = \"primary\", validation_level = \"normal\", hovered = true, pressed = false, focused = false, selected = false, checked = false, disabled = false, corner_radius = \"$editor.control.radius.control\", border_width = 0.0, layout_padding_left = \"$editor.density.gap.large\", layout_padding_right = \"$editor.density.gap.large\", layout_padding_top = \"$editor.density.gap.small\", layout_padding_bottom = \"$editor.density.gap.small\", layout_spacing = \"$editor.density.gap.small\", layout_min_width = \"$editor.control.height.default\", layout_min_height = \"$editor.control.height.default\", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.button_danger_demo]\ncomponent = \"Button\"\ncontrol_id = \"ButtonDangerDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-button\"]\nprops = { text = \"Danger Button\", button_variant = \"contained\", button_color = \"error\", button_size = \"medium\", icon_placement = \"none\", text_tone = \"danger\", validation_level = \"normal\", hovered = false, pressed = true, focused = false, selected = false, checked = false, disabled = false, corner_radius = \"$editor.control.radius.control\", border_width = \"$editor.control.border_width\", layout_padding_left = \"$editor.density.gap.large\", layout_padding_right = \"$editor.density.gap.large\", layout_padding_top = \"$editor.density.gap.small\", layout_padding_bottom = \"$editor.density.gap.small\", layout_spacing = \"$editor.density.gap.small\", layout_min_width = \"$editor.control.height.default\", layout_min_height = \"$editor.control.height.default\", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\n\n[nodes.button_disabled_demo]\ncomponent = \"Button\"\ncontrol_id = \"ButtonDisabledDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-button\"]\nprops = { text = \"Disabled Button\", button_variant = \"contained\", button_color = \"primary\