[asset]
kind = "component"
id = "res://ui/editor/components/showcase/showcase_input_section.zui"
version = 2
display_name = "Showcase Input Section"

[imports]
widgets = []
styles = []

[components.ShowcaseInputSection]
root = "input_section_root"
default_classes = [ "showcase-panel", "material-surface" ]

[nodes.section_title]
component = "Label"
control_id = "ComponentShowcaseInputSectionTitle"
classes = [ "showcase-section-title" ]

[nodes.section_title.props]
text = "Inputs and Numeric Fields"
font_size = "$editor.typography.body.size"
font_weight = "$editor.typography.emphasis.weight"

[nodes.section_title.layout.width]
stretch = "Stretch"

[nodes.section_title.layout.height]
min = 24
preferred = 24
max = 24
stretch = "Fixed"

[nodes.button_demo]
component = "Button"
control_id = "ButtonDemo"
classes = [ "showcase-field", "material-control", "material-button" ]

[nodes.button_demo.props]
text = "Primary Button"
surface_variant = "accent"
button_variant = "primary"
button_color = "primary"
button_size = "medium"
icon_placement = "none"
text_tone = "primary"
validation_level = "normal"
hovered = false
pressed = false
focused = false
selected = false
checked = false
disabled = false
corner_radius = "$editor.control.radius.control"
border_width = "$editor.control.border_width"
layout_padding_left = "$editor.density.gap.large"
layout_padding_right = "$editor.density.gap.large"
layout_padding_top = "$editor.density.gap.small"
layout_padding_bottom = "$editor.density.gap.small"
layout_spacing = "$editor.density.gap.small"
layout_min_width = "$editor.control.height.default"
layout_min_height = "$editor.control.height.default"
layout_icon_size = 16
input_interactive = true
input_clickable = true
input_hoverable = true
input_focusable = true

[nodes.button_demo.layout.width]
stretch = "Stretch"

[nodes.button_demo.layout.height]
min = 32
preferred = 32
max = 32
