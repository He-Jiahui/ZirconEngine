 = \"ToggleButton\"\ncontrol_id = \"ToggleButtonDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { text = \"Toggle Button\", checked = true, layout_padding_left = \"$editor.density.gap.large\", layout_padding_right = \"$editor.density.gap.large\", layout_padding_top = \"$editor.density.gap.small\", layout_padding_bottom = \"$editor.density.gap.small\", layout_spacing = \"$editor.density.gap.small\", layout_min_width = \"$editor.control.height.default\", layout_min_height = \"$editor.control.height.default\", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/ToggleButtonChanged\", event = \"Toggle\", route = \"component_lab.showcase.change.toggle_button\" },\n]\n\n[nodes.checkbox_demo]\ncomponent = \"Checkbox\"\ncontrol_id = \"CheckboxDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { text = \"Checkbox\", checked = true, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/CheckboxChanged\", event = \"Toggle\", route = \"component_lab.showcase.change.checkbox\" },\n]\n\n[nodes.radio_demo]\ncomponent = \"Radio\"\ncontrol_id = \"RadioDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { text = \"Radio\", value = false, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/RadioChanged\", event = \"Change\", route = \"component_lab.showcase.change.radio\" },\n]\n\n[nodes.segmented_control_demo]\ncomponent = \"SegmentedControl\"\ncontrol_id = \"SegmentedControlDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { value = \"move\", options = [\"select\", \"move\", \"rotate\", \"scale\"], selection_state = \"single\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/SegmentedControlChanged\", event = \"Change\", component_event = \"SelectOption\", route = \"component_lab.showcase.select_option.segmented_control\" },\n]\n\n[nodes.tab_demo]\ncomponent = \"Tab\"\ncontrol_id = \"TabDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { text = \"Scene\", label = \"Scene\", value = \"scene\", selected = true, focused = true, hovered = false, pressed = false, disabled = false, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/TabChanged\", event = \"Change\", component_event = \"ValueChanged\", route = \"component_lab.showcase.select_option.tab\" },\n]\n\n[nodes.tab_strip_demo]\ncomponent = \"Tabs\"\ncontrol_id = \"TabStripDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { value = \"scene\", options = [\"scene\", \"assets\", \"console\"], selected_index = 0, focused_index = 1, hovered_options = [\"assets\"], disabled_options = [\"console\"], variant = \"standard\", orientation = \"horizontal\", selection_follows_focus = true, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/TabStripChanged\", event = \"Change\", component_event = \"ValueChanged\", route = \"component_lab.showcase.select_option.tab_strip\" },\n]\n\n[nodes.text_field_demo]\ncomponent = \"InputField\"\ncontrol_id = \"InputFieldDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { value = \"Runtime retained text\", placeholder = \"Type here\", validation_level = \"normal\", layout_padding_left = \"$editor.density.gap.medium\", layout_padding_right = \"$editor.density.gap.medium\", layout_padding_top = \"$editor.density.gap.xsmall\", layout_padding_bottom = \"$editor.density.gap.xsmall\", layout_min_height = \"$editor.control.height.default\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/InputFieldChanged\", event = \"Change\", component_event = \"ValueChanged\", route = \"component_lab.showcase.value_changed.input_field\" },\n  { id = \"UiComponentShowcase/InputFieldCommitted\", event = \"Submit\", component_event = \"Commit\", route = \"component_lab.showcase.commit.input_field\" },\n]\n\n[nodes.text_area_demo]\ncomponent = \"TextField\"\ncontrol_id = \"TextFieldDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { value = \"Longer retained text field\", placeholder = \"Multi-line notes\", validation_level = \"normal\", height = 32, layout_padding_left = \"$editor.density.gap.medium\", layout_padding_right = \"$editor.density.gap.medium\", layout_padding_top = \"$editor.density.gap.xsmall\", layout_padding_bottom = \"$editor.density.gap.xsmall\", layout_min_height = \"$editor.control.height.default\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width =