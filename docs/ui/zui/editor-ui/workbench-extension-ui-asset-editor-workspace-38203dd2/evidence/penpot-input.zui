ents = [{ id = \"WorkbenchExtension/UiAssetEditorValidate\", event = \"Click\", route = \"workbench.extension.ui_asset_editor.validate\" }]\n\n[nodes.ui_asset_editor_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionUiAssetEditorTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"ui_asset_editor_root_panel_row\" }, { node = \"ui_asset_editor_inventory_grid_row\" }, { node = \"ui_asset_editor_selected_button_row\" }, { node = \"ui_asset_editor_binding_row\" }]\n\n[nodes.ui_asset_editor_root_panel_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionUiAssetEditorRootPanelRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Root Panel\", value_text = \"Container   desktop   ready\", options = [\"Root Panel\",\"Container\",\"desktop\",\"ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/UiAssetEditorRootPanelRow\", event = \"Click\", route = \"workbench.extension.ui_asset_editor.row.root_panel\" }]\n\n[nodes.ui_asset_editor_inventory_grid_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionUiAssetEditorInventoryGridRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Inventory Grid\", value_text = \"List   responsive   ready\", options = [\"Inventory Grid\",\"List\",\"responsive\",\"ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/UiAssetEditorInventoryGridRow\", event = \"Click\", route = \"workbench.extension.ui_asset_editor.row.inventor