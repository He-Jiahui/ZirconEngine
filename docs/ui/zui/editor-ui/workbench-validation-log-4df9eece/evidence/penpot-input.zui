ax = 24.0, stretch = \"Fixed\" } }\n\n[nodes.validation_log_filters]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchValidationLogFilters\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 26.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"validation_log_all\" }, { node = \"validation_log_errors\" }, { node = \"validation_log_warnings\" }, { node = \"validation_log_infos\" }, { node = \"validation_log_filters_fill\" }]\n\n[nodes.validation_log_all]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchValidationLogAll\"\nprops = { text = \"All\", icon = \"editor_pages/console_profiler/logs/filter-logs.svg\", icon_placement = \"leading\", component_variant = \"code compact_icon_text\", button_variant = \"text\", button_color = \"secondary\", text_tone = \"accent\" }\nlayout = { width = { min = 48.0, preferred = 54.0, max = 58.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceValidationFilterAll\", event = \"Click\", route = \"workbench.extension.blend_space.validation.filter_all\" }]\n\n[nodes.validation_log_errors]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchValidationLogErrors\"\nprops = { text = \"0\", icon = \"editor_pages/console_profiler/logs/log-error.svg\", icon_placement = \"leading\", component_variant = \"code compact_icon_text\", button_variant = \"text\", button_color = \"secondary\", text_tone = \"error\", validation_level = \"error\" }\nlayout = { width = { min = 42.0, preferred = 46.0, max = 48.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceValidationFilterErrors\", event = \"Click\", route = \"workbench.extension.blend_space.validation.filter_errors\" }]\n\n[nodes.validation_log_warnings]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchValidationLogWarnings\"\nprops = { text = \"1\", icon = \"editor_pages/console_profiler/logs/log-warning.svg\", icon_placement = \"leading\", component_variant = \"code compact_icon_text\", button_variant = \"text\", button_color = \"secondary\", text_tone = \"warning\", validation_level = \"warning\" }\nlayout = { width = { min = 42.0, preferred = 46.0, max = 48.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceValidationFilterWarnings\", event = \"Click\", route = \"workbench.extension.blend_space.validation.filter_warnings\" }]\n\n[nodes.validation_log_infos]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchValidationLogInfos\"\nprops = { text = \"3\", icon = \"editor_pages/console_profiler/logs/log-info.svg\", icon_placement = \"leading\", component_variant = \"code compact_icon_text\", button_variant = \"text\", button_color = \"secondary\", text_tone = \"info\", validation_level = \"info\" }\nlayout = { width = { min = 42.0, preferred = 46.0, max = 48.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceValidationFilterInfos\", event = \"Click\", route = \"workbench.extension.blend_space.validation.filter_infos\" }]\n\n[nodes.validation_log_filters_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchValidationLogFiltersFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.validation_log_diagnostics]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchValidationLogDiagnostics\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.xsmall\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"validation_log_info_axes\" }, { node = \"validation_log_warning\" }, { node = \"validation_log_info_range\" }, { nod