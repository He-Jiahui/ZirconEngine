WorkbenchValidationLogInfoDuplicatesMessage\"\nprops = { text = \"No duplicate samples found.\", foreground_color = \"$editor.text.primary\", text_tone = \"subtle\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.validation_log_footer]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchValidationLogFooter\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 26.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"validation_log_footer_fill\" }, { node = \"validation_log_clear\" }]\n\n[nodes.validation_log_footer_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchValidationLogFooterFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.validation_log_clear]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchValidationLogClear\"\nprops = { text = \"Clear\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 50.0, preferred = 58.0, max = 66.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WorkbenchExtension/BlendSpaceValidationClear\", event = \"Click\", route = \"workbench.extension.blend_space.validation.clear\" }]\n"

