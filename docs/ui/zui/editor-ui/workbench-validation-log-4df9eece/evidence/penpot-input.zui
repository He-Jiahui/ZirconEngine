font_weight = "$editor.typography.strong.weight"
font_size = "$editor.typography.body.size"
line_height_ratio = "$editor.typography.line_height"
layout_padding_left = "$editor.density.gap.large"
layout_padding_right = "$editor.density.gap.large"
layout_padding_top = "$editor.density.gap.small"
layout_padding_bottom = "$editor.density.gap.small"
layout_spacing = "$editor.density.gap.medium"
layout_min_width = "$editor.control.height.default"
layout_min_height = "$editor.control.height.dense"
input_interactive = true
input_clickable = true
input_hoverable = true
input_focusable = true

[nodes.validation_log_clear.layout.width]
stretch = "Fixed"
min = 50
preferred = 58
max = 66

[nodes.validation_log_clear.layout.height]
min = "$editor.control.height.dense"
preferred = "$editor.control.height.compact"
max = "$editor.control.height.default"
stretch = "Stretch"

[[nodes.validation_log_clear.events]]
id = "WorkbenchExtension/BlendSpaceValidationClear"
event = "Click"
route = "workbench.extension.blend_space.validation.clear"

[nodes.validation_log_clear.state]
[nodes.validation_log_clear.style.self]
[nodes.validation_log_clear.style.slot]
[nodes.validation_log_clear.slots]
