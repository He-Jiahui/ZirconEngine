[asset]
kind = "component"
id = "res://ui/editor/material_components/inputs/material_floating_action_button.zui"
version = 2
display_name = "Material Floating Action Button Prototype"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption"]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.MaterialFloatingActionButtonPrototype]
root = "root"
default_classes = ["material-lab-prototype", "material-surface"]

[nodes.title]
component = "WorkbenchLabel"
control_id = "floating-action-button_Title"
classes = ["material-lab-title"]
props = { "text" = "Floating Action Button", "text_tone" = "primary", "font_size" = "$editor.typography.title.size", "font_weight" = "$editor.typography.strong.weight", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 56, "preferred" = 56, "max" = 56, "stretch" = "Fixed" } }

[nodes.meta]
component = "GridBox"
control_id = "floating_action_button_Meta"
classes = ["material-lab-meta-strip", "material-lab-meta"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 100, "preferred" = 100, "max" = 100, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 2, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "meta_group" },
  { node = "meta_response" },
  { node = "meta_variant" },
  { node = "meta_layout" },
]

[nodes.meta_group]
component = "WorkbenchCaption"
control_id = "floating_action_button_MetaGroup"
classes = ["material-lab-meta-chip", "material-lab-meta-group"]
props = { "text" = "Inputs", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_response]
component = "WorkbenchCaption"
control_id = "floating_action_button_MetaResponse"
classes = ["material-lab-meta-chip", "material-lab-meta-response"]
props = { "text" = "click / press", "text_tone" = "success", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "response_mechanism" = "click / press", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.meta_variant]
component = "WorkbenchCaption"
control_id = "floating_action_button_MetaVariant"
classes = ["material-lab-meta-chip", "material-lab-meta-variant"]
props = { "text" = "small / standard / large", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "variant" = "small / standard / large", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }

[nodes.meta_layout]
component = "WorkbenchCaption"
control_id = "floating_action_button_MetaLayout"
classes = ["material-lab-meta-chip", "material-lab-meta-layout"]
props = { "text" = "inline controls", "text_tone" = "warning", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "layout_mode" = "inline controls", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip", "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 48, "preferred" = 48, "max" = 48, "stretch" = "Fixed" } }
[nodes.sample]
component = "HorizontalBox"
control_id = "floating-action-button_Sample"
classes = ["material-control", "material-lab-sample", "material-fab-row"]
props = { "text" = "", "surface_variant" = "elevated", "button_variant" = "contained", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "icon_only", "button_shape" = "circular", "text_tone" = "primary", "validation_level" = "normal", "hovered" = true, "pressed" = false, "focused" = true, "selected" = true, "checked" = true, "disabled" = false, "open" = true, "popup_open" = true, "corner_radius" = 0, "border_width" = 0, "elevation" = 0, "input_interactive" = true, "input_clickable" = true, "input_hoverable" = true, "input_focusable" = true, "background_color" = "transparent" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 56, "preferred" = 56, "max" = 56, "stretch" = "Fixed" }, "container" = { "kind" = "HorizontalBox", "gap" = "$editor.density.gap.medium" } }
children = [
  { node = "fab_circular" },
  { node = "fab_small" },
  { node = "fab_extended" },
]
events = [
  { id = "MaterialLab/FloatingActionButton/Click", event = "Click", route = "material_lab.floating_action_button.click" },
]

[nodes.fab_circular]
component = "IconButton"
control_id = "floating-action-button_Circular"
classes = ["material-control", "material-fab", "material-fab-circular"]
props = { text = "Add", icon = "add", surface_variant = "elevated", button_variant = "contained", button_color = "primary", button_size = "medium", icon_placement = "icon_only", button_shape = "circular", fab_style = "standard", text_tone = "primary", validation_level = "normal", hovered = true, pressed = false, focused = true, selected = true, checked = true, disabled = false, open = false, popup_open = false, corner_radius = 16.0, border_width = 0.0, elevation = 3.0, hover_elevation = 4.0, button_horizontal_padding = 14.0, button_vertical_padding = 14.0, min_layout_width = 56.0, min_layout_height = 56.0, icon_size = 24.0, state_layer_enabled = true, ripple_enabled = true, clip_ripple = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { min = 56, preferred = 56, max = 56, stretch = "Fixed" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }

[nodes.fab_small]
component = "IconButton"
control_id = "floating-action-button_Small"
classes = ["material-control", "material-fab", "material-fab-small", "material-fab-circular"]
props = { text = "Edit", icon = "edit", surface_variant = "elevated", button_variant = "contained", button_color = "primary", button_size = "small", icon_placement = "icon_only", button_shape = "circular", fab_style = "small", text_tone = "primary", validation_level = "normal", hovered = false, pressed = false, focused = false, selected = false, checked = false, disabled = false, open = false, popup_open = false, corner_radius = 12.0, border_width = 0.0, elevation = 3.0, hover_elevation = 4.0, button_horizontal_padding = 10.0, button_vertical_padding = 10.0, min_layout_width = 40.0, min_layout_height = 40.0, icon_size = 24.0, state_layer_enabled = true, ripple_enabled = true, clip_ripple = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { min = 40, preferred = 40, max = 40, stretch = "Fixed" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }

[nodes.fab_extended]
component = "Button"
control_id = "floating-action-button_Extended"
classes = ["material-control", "material-fab", "material-fab-extended"]
props = { "text" = "Create", "icon" = "add", "surface_variant" = "elevated", "button_variant" = "contained", "button_color" = "primary", "button_size" = "medium", "icon_placement" = "leading", "button_shape" = "extended", "fab_style" = "standard", "text_tone" = "primary", "validation_level" = "normal", "hovered" = true, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = "$editor.control.radius.control", "border_width" = 0, "elevation" = 3, "hover_elevation" = 4, "button_horizontal_padding" = 12, "button_vertical_padding" = 12, "min_layout_width" = 128, "min_layout_height" = 48, "icon_size" = 20, "state_layer_enabled" = true, "ripple_enabled" = true, "clip_ripple" = true, "input_interactive" = false, "input_clickable" = false, "input_hoverable" = false, "input_focusable" = false }
layout = { width = { min = 128, preferred = 128, max = 128, stretch = "Fixed" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }

[nodes.state_strip]
component = "GridBox"
control_id = "floating_action_button_StateStrip"
classes = ["material-lab-state-strip"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 108, "preferred" = 108, "max" = 108, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "state_default" },
  { node = "state_hover" },
  { node = "state_pressed" },
  { node = "state_focus" },
  { node = "state_disabled" },
  { node = "state_selected" },
  { node = "state_open" },
  { node = "state_error" },
]
