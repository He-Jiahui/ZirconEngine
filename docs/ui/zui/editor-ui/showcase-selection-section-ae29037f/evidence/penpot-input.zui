penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/showcase/showcase_selection_section.zui\"\nversion = 2\ndisplay_name = \"Showcase Selection Section\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.ShowcaseSelectionSection]\nroot = \"selection_section_root\"\ndefault_classes = [\"showcase-panel\", \"material-surface\"]\n\n[nodes.section_title]\ncomponent = \"Label\"\ncontrol_id = \"ComponentShowcaseSelectionSectionTitle\"\nclasses = [\"showcase-section-title\"]\nprops = { text = \"Selection and References\", font_size = \"$editor.typography.body.size\", font_weight = \"$editor.typography.emphasis.weight\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.dropdown_demo]\ncomponent = \"Dropdown\"\ncontrol_id = \"DropdownDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { value = \"runtime\", options = [\"runtime\", \"editor\", \"debug\"], disabled_options = [\"debug\"], special_options = [\"runtime\"], focused_options = [\"editor\"], hovered_options = [\"editor\"], pressed_options = [\"runtime\"], multiple = true, popup_open = true, selection_state = \"multi\", validation_level = \"normal\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/DropdownChanged\", event = \"Change\", component_event = \"SelectOption\", route = \"component_lab.showcase.select_option.dropdown\" },\n  { id = \"UiComponentShowcase/DropdownOpenPopup\", event = \"Click\", component_event = \"OpenPopup\", route = \"component_lab.showcase.open_popup.dropdown\" },\n  { id = \"UiComponentShowcase/DropdownClosePopup\", event = \"Click\", component_event = \"ClosePopup\", route = \"component_lab.showcase.close_popup.dropdown\" },\n]\n\n[nodes.combo_box_demo]\ncomponent = \"ComboBox\"\ncontrol_id = \"ComboBoxDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { value = \"material\", options = [\"material\", \"fluent\", \"native\"], multiple = false, selection_state = \"single\", layout_padding_left = \"$editor.density.gap.medium\", layout_padding_right = \"$editor.density.gap.medium\", layout_padding_top = \"$editor.density.gap.xsmall\", layout_padding_bottom = \"$editor.density.gap.xsmall\", layout_min_height = \"$editor.control.height.default\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/ComboBoxChanged\", event = \"Change\", component_event = \"SelectOption\", route = \"component_lab.showcase.select_option.combo_box\" },\n  { id = \"UiComponentShowcase/ComboBoxOpenPopup\", event = \"Click\", component_event = \"OpenPopup\", route = \"component_lab.showcase.open_popup.combo_box\" },\n  { id = \"UiComponentShowcase/ComboBoxClosePopup\", event = \"Click\", component_event = \"ClosePopup\", route = \"component_lab.showcase.close_popup.combo_box\" },\n]\n\n[nodes.enum_field_demo]\ncomponent = \"EnumField\"\ncontrol_id = \"EnumFieldDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { value = \"RiderDocking\", options = [\"RiderDocking\", \"UnityInspector\", \"RuntimeOverlay\"], selection_state = \"single\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/EnumFieldChanged\", event = \"Change\", component_event = \"SelectOption\", route = \"component_lab.showcase.select_option.enum_field\" },\n  { id = \"UiComponentShowcase/EnumFieldOpenPopup\", event = \"Click\", component_event = \"OpenPopup\", route = \"component_lab.showcase.open_popup.enum_field\" },\n  { id = \"UiComponentShowcase/EnumFieldClosePopup\", event = \"Click\", component_event = \"ClosePopup\", route = \"component_lab.showcase.close_popup.enum_field\" },\n]\n\n[nodes.flags_field_demo]\ncomponent = \"FlagsField\"\ncontrol_id = \"FlagsFieldDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { value = [\"Selectable\", \"Draggable\"], value_text = \"Selectable, Draggable\", options = [\"Selectable\", \"Draggable\", \"Disabled\"], multiple = true, selection_state = \"flags\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/FlagsFieldChanged\", event = \"Change\", component_event = \"SelectOption\", route = \"component_lab.showcase.select_option.flags_field\" },\n  { id = \"UiComponentShowcase/FlagsFieldOpenPopup\", event = \"Click\", component_event = \"OpenPopup\", route = \"component_lab.showcase.open_popup.flags_field\" },\n  { id = \"UiComponentShowcase/FlagsFieldClosePopup\", event = \"Click\", component_event = \"ClosePopup\", route = \"component_lab.showcase.close_popup.flags_field\" },\n]\n\n[nodes.search_select_demo]\ncomponent = \"SearchSelect\"\ncontrol_id = \"SearchSelectDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { value = \"runtime.ui.NumberField\", query = \"number\", options = [\"runtime.ui.NumberField\", \"runtime.ui.RangeField\", \"runtime.ui.Vector3Field\"], input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/SearchSelectChanged\", event = \"Change\", component_event = \"SelectOption\", route = \"component_lab.showcase.select_option.search_select\" },\n  { id = \"UiComponentShowcase/SearchSelectQueryChanged\", event = \"Change\", component_event = \"ValueChanged\", route = \"component_lab.showcase.value_changed.search_select_query\" },\n  { id = \"UiComponentShowcase/SearchSelectOpenPopup\", event = \"Click\", component_event = \"OpenPopup\", route = \"component_lab.showcase.open_popup.search_select\" },\n  { id = \"UiComponentShowcase/SearchSelectClosePopup\", event = \"Click\", component_event = \"ClosePopup\", route = \"component_lab.showcase.close_popup.search_select\" },\n]\n\n[nodes.context_menu_demo]\ncomponent = \"ContextMenu\"\ncontrol_id = \"ContextMenuDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { open = true, popup_open = true, options = [\"Inspect|checked,focused|Ctrl+I\", \"---\", \"Duplicate|hovered,pressed\", \"Archive|loading,disabled\"], menu_items = [\"Inspect|checked,focused|Ctrl+I\", \"---\", \"Duplicate|hovered,pressed\", \"Archive|loading,disabled\"], popup_anchor_x = 320.0, popup_anchor_y = 28.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 112.0, preferred = 112.0, max = 112.0, stretch = \"Fixed\" } }\n\n[nodes.dropdown_popup_demo]\ncomponent = \"DropdownPopup\"\ncontrol_id = \"DropdownPopupDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { value = \"scene\", open = true, popup_open = true, selected_options = [\"scene\"], options = [\"scene|label=Scene,selected\", \"assets|label=Assets,focused,hovered\", \"console|label=Console,disabled\", \"render|label=Render,loading\"], input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 112.0, preferred = 112.0, max = 112.0, stretch = \"Fixed\" } }\n\n[nodes.asset_field_demo]\ncomponent = \"AssetField\"\ncontrol_id = \"AssetFieldDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { value = \"res://textures/grid.albedo.png\", validation_level = \"normal\", drop_hovered = true, active_drag_target = true, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/AssetFieldDropped\", event = \"Drop\", component_event = \"DropReference\", route = \"component_lab.showcase.drop_reference.asset_field\" },\n  { id = \"UiComponentShowcase/AssetFieldDropHovered\", event = \"Hover\", component_event = \"DropHover\", route = \"component_lab.showcase.drop_hover.asset_field\" },\n  { id = \"UiComponentShowcase/AssetFieldActiveDragTarget\", event = \"DragBegin\", component_event = \"ActiveDragTarget\", route = \"component_lab.showcase.active_drag_target.asset_field\" },\n  { id = \"UiComponentShowcase/AssetFieldLocate\", event = \"Click\", component_event = \"LocateReference\", route = \"component_lab.showcase.locate_reference.asset_field\" },\n  { id = \"UiComponentShowcase/AssetFieldOpen\", event = \"Click\", component_event = \"OpenReference\", route = \"component_lab.showcase.open_reference.asset_field\" },\n  { id = \"UiComponentShowcase/AssetFieldClear\", event = \"Click\", component_event = \"ClearReference\", route = \"component_lab.showcase.clear_reference.asset_field\" },\n]\n\n[nodes.instance_field_demo]\ncomponent = \"InstanceField\"\ncontrol_id = \"InstanceFieldDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { value = \"scene://Root/CameraRig\", validation_level = \"normal\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/InstanceFieldDropped\", event = \"Drop\", component_event = \"DropReference\", route = \"component_lab.showcase.drop_reference.instance_field\" },\n  { id = \"UiComponentShowcase/InstanceFieldLocate\", event = \"Click\", component_event = \"LocateReference\", route = \"component_lab.showcase.locate_reference.instance_field\" },\n  { id = \"UiComponentShowcase/InstanceFieldOpen\", event = \"Click\", component_event = \"OpenReference\", route = \"component_lab.showcase.open_reference.instance_field\" },\n  { id = \"UiComponentShowcase/InstanceFieldClear\", event = \"Click\", component_event = \"ClearReference\", route = \"component_lab.showcase.clear_reference.instance_field\" },\n]\n\n[nodes.object_field_demo]\ncomponent = \"ObjectField\"\ncontrol_id = \"ObjectFieldDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { value = \"object://Selection/MainCamera\", validation_level = \"normal\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [\n  { id = \"UiComponentShowcase/ObjectFieldDropped\", event = \"Drop\", component_event = \"DropReference\", route = \"component_lab.showcase.drop_reference.object_field\" },\n  { id = \"UiComponentShowcase/ObjectFieldLocate\", event = \"Click\", component_event = \"LocateReference\", route = \"component_lab.showcase.locate_reference.object_field\" },\n  { id = \"UiComponentShowcase/ObjectFieldOpen\", event = \"Click\", component_event = \"OpenReference\", route = \"component_lab.showcase.open_reference.object_field\" },\n  { id = \"UiComponentShowcase/ObjectFieldClear\", event = \"Click\", component_event = \"ClearReference\", route = \"component_lab.showcase.clear_reference.object_field\" },\n]\n\n[nodes.selection_section_root]\ncomponent = \"ScrollableBox\"\nclasses = [\"showcase-panel\", \"material-surface\"]\nlayout = { width = { min = 0, stretch = \"Stretch\" }, clip = true, input_policy = \"Receive\", container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Auto\" }, height = { min = 0, stretch = \"Stretch\" } }\nchildren = [\n  { node = \"section_title\" },\n  { node = \"dropdown_demo\", slot = { name = \"content\" } },\n  { node = \"combo_box_demo\", slot = { name = \"content\" } },\n  { node = \"enum_field_demo\", slot = { name = \"content\" } },\n  { node = \"flags_field_demo\", slot = { name = \"content\" } },\n  { node = \"search_select_demo\", slot = { name = \"content\" } },\n  { node = \"context_menu_demo\", slot = { name = \"content\" } },\n  { node = \"dropdown_popup_demo\", slot = { name = \"content\" } },\n  { node = \"asset_field_demo\", slot = { name = \"content\" } },\n  { node = \"instance_field_demo\", slot = { name = \"content\" } },\n  { node = \"object_field_demo\", slot = { name = \"content\" } },\n]\n"

