penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/theme/editor_workbench_strict.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui", "zircon_editor/assets/icons/zircon_editor_shell/controls/search.svg", "zircon_editor/assets/icons/ionicons/close-outline.svg", "zircon_editor/assets/icons/zircon_editor_shell/controls/field-stepper.svg" ]
penpot_original_source = "stylesheets = []\n\n[asset]\nkind = \"view\"\nid = \"res://ui/editor/hierarchy.zui\"\nversion = 2\ndisplay_name = \"Hierarchy\"\n\n[imports]\nwidgets = [\"res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput\"]\nstyles = [\"res://ui/theme/editor_workbench_strict.zui\"]\n\n[root]\nnode = \"hierarchy_root\"\n\n[nodes.header_panel]\ncomponent = \"Overlay\"\ncontrol_id = \"HierarchyHeaderPanel\"\nprops = { text = \"Hierarchy\", surface_variant = \"transparent\", radius = 0.0, border_width = 0.0, text_tone = \"default\", text_align = \"left\", font_weight = \"$editor.typography.strong.weight\", layout_padding_left = \"$editor.density.gap.medium\", layout_padding_right = \"$editor.density.gap.medium\", overflow = \"elide\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\n\n[nodes.header_list_gap]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.small\", preferred = \"$editor.density.gap.small\", max = \"$editor.density.gap.small\", stretch = \"Fixed\" } }\n\n[nodes.search_field]\ncomponent = \"WorkbenchSearchInput\"\ncontrol_id = \"HierarchySearchQuery\"\nprops = { query = \"\", placeholder = \"Search hierarchy\" }\nwidget = { value_property = \"query\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [\n  { id = \"Workbench/SceneSearchEdit\", event = \"Change\", component_event = \"ValueChanged\", route = \"workbench.hierarchy.search.edit\" },\n  { id = \"Workbench/SceneSearchCommit\", event = \"Submit\", component_event = \"Commit\", route = \"workbench.hierarchy.search.commit\" },\n]\n\n[nodes.search_row]\ncomponent = \"HorizontalBox\"\ncontrol_id = \"HierarchySearchRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"search_field\" }]\n\n[nodes.search_left_inset]\ncomponent = \"Space\"\nlayout = { width = { min = \"$editor.density.gap.medium\", preferred = \"$editor.density.gap.medium\", max = \"$editor.density.gap.medium\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.search_right_inset]\ncomponent = \"Space\"\nlayout = { width = { min = \"$editor.density.gap.medium\", preferred = \"$editor.density.gap.medium\", max = \"$editor.density.gap.medium\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.search_inset_row]\ncomponent = \"HorizontalBox\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"search_left_inset\" }, { node = \"search_row\" }, { node = \"search_right_inset\" }]\n\n[nodes.search_list_gap]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.small\", preferred = \"$editor.density.gap.small\", max = \"$editor.density.gap.small\", stretch = \"Fixed\" } }\n\n[nodes.empty_state_message]\ncomponent = \"Label\"\ncontrol_id = \"HierarchyEmptyStateMessage\"\nprops = { text = \"\", text_tone = \"muted\", text_align = \"center\", overflow = \"elide\" }\nlayout = { anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.5 }, position = { x = 0.0, y = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = \"Fixed\" } }\n\n[nodes.list_panel]\ncomponent = \"Overlay\"\ncontrol_id = \"HierarchyListPanel\"\nprops = { surface_variant = \"transparent\", radius = 0.0, border_width = 0.0, overflow = \"elide\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"empty_state_message\" }]\n\n[nodes.hierarchy_root]\ncomponent = \"VerticalBox\"\ncontrol_id = \"HierarchyRoot\"\nclasses = [\"workbench-shell-root\"]\npixel_snapping = \"disabled\"\nlayout = { container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"header_panel\" }, { node = \"header_list_gap\" }, { node = \"search_inset_row\" }, { node = \"search_list_gap\" }, { node = \"list_panel\" }]\n"

