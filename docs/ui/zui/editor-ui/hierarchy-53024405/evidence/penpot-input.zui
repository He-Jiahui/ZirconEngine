[asset]
kind = "view"
id = "res://ui/editor/hierarchy.zui"
version = 2
display_name = "Hierarchy"

[imports]
widgets = []
styles = []

[root]
node = "hierarchy_root"

[nodes.header_panel]
component = "Overlay"
control_id = "HierarchyHeaderPanel"

[nodes.header_panel.props]
text = "Hierarchy"
surface_variant = "transparent"
radius = 0
border_width = 0
text_tone = "default"
text_align = "left"
font_weight = "$editor.typography.strong.weight"
layout_padding_left = "$editor.density.gap.medium"
layout_padding_right = "$editor.density.gap.medium"
overflow = "elide"

[nodes.header_panel.layout]
clip = true

[nodes.header_panel.layout.container]
kind = "Overlay"

[nodes.header_panel.layout.width]
stretch = "Stretch"

[nodes.header_panel.layout.height]
min = "$editor.density.row_height"
preferred = "$editor.density.row_height"
max = "$editor.density.row_height"
stretch = "Fixed"

[nodes.header_list_gap]
component = "Space"

[nodes.header_list_gap.layout.width]
stretch = "Stretch"

[nodes.header_list_gap.layout.height]
min = "$editor.density.gap.small"
preferred = "$editor.density.gap.small"
max = "$editor.density.gap.small"
stretch = "Fixed"

[nodes.search_field]
component = "SearchField"
control_id = "HierarchySearchQuery"
classes = [ "workbench-field", "workbench-search-input", "workbench-primitive" ]
children = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput"

[nodes.search_field.props]
query = ""
placeholder = "Search hierarchy"
validation_level = "normal"
focused = false
hovered = false
disabled = false
editable_text = true
has_clear_action = true
background_color = "$editor.surface.recessed"
hover_background_color = "$editor.surface.hover"
pressed_background_color = "$editor.surface.3"
focused_background_color = "$editor.surface.recessed"
disabled_background_color = "$editor.surface.disabled"
border_color = "$editor.separator.soft"
hover_border_color = "$editor.border"
focus_border_color = "$editor.focus.ring"
disabled_border_color = "$editor.border.disabled"
foreground_color = "$editor.text.primary"
placeholder_color = "$editor.text.secondary"
disabled_foreground_color = "$editor.text.disabled"
border_width = "$editor.control.border_width"
corner_radius = "$editor.control.radius.control"
font_size = "$editor.typography.body.size"
line_height_ratio = "$editor.typography.line_height"
layout_padding_left = "$editor.control.height.dense"
layout_padding_right = "$editor.density.gap.large"
layout_padding_top = "$editor.density.gap.small"
layout_padding_bottom = "$editor.density.gap.small"
layout_min_height = "$editor.control.height.dense"
input_interactive = true
input_clickable = true
input_hoverable = true
input_focusable = true

[nodes.search_field.widget]
value_property = "query"

[nodes.search_field.layout.width]
stretch = "Stretch"

[nodes.search_field.layout.height]
min = "$editor.control.height.dense"
preferred = "$editor.control.height.compact"
max = "$editor.control.height.default"
stretch = "Stretch"

[[nodes.search_field.events]]
id = "Workbench/SceneSearchEdit"
event = "Change"
component_event = "ValueChanged"
route = "workbench.hierarchy.search.edit"

[[nodes.search_field.events]]
id = "Workbench/SceneSearchCommit"
event = "Submit"
component_event = "Commit"
route = "workbench.hierarchy.search.commit"

[nodes.search_field.state]
[nodes.search_field.style.self]
[nodes.search_field.style.slot]
[nodes.search_field.slots]
[nodes.search_row]
component = "HorizontalBox"
control_id = "HierarchySearchRow"

[nodes.search_row.layout.container]
kind = "HorizontalBox"
gap = 0

[nodes.search_row.layout.width]
stretch = "Stretch"

[nodes.search_row.layout.height]
min = "$editor.density.row_height"
preferred = "$editor.density.row_height"
max = "$editor.density.row_height"
stretch = "Fixed"

[[nodes.search_row.children]]
node = "search_field"

[nodes.search_left_inset]
component = "Space"

[nodes.search_left_inset.layout.width]
min = "$editor.density.gap.medium"
preferred = "$editor.density.gap.medium"
max = "$editor.density.gap.medium"
stretch = "Fixed"

[nodes.search_left_inset.layout.height]
stretch = "Stretch"

[nodes.search_right_inset]
component = "Space"

[nodes.search_right_inset.layout.width]
min = "$editor.density.gap.medium"
preferred = "$editor.density.gap.medium"
max = "$editor.density.gap.medium"
stretch = "Fixed"

[nodes.search_right_inset.layout.height]
stretch = "Stretch"

[nodes.search_inset_row]
component = "HorizontalBox"

[nodes.search_inset_row.layout.container]
kind = "HorizontalBox"
gap = 0

[nodes.search_inset_row.layout.width]
stretch = "Stretch"

[nodes.search_inset_row.layout.height]
min = "$editor.density.row_height"
preferred = "$editor.density.row_height"
max = "$editor.density.row_height"
stretch = "Fixed"

[[nodes.search_inset_row.children]]
node = "search_left_inset"

[[nodes.search_inset_row.children]]
node = "search_row"

[[nodes.search_inset_row.children]]
node = "search_right_inset"

[nodes.search_list_gap]
component = "Space"

[nodes.search_list_gap.layout.width]
stretch = "Stretch"

[nodes.search_list_gap.layout.height]
min = "$editor.density.gap.small"
preferred = "$editor.density.gap.small"
max = "$editor.density.gap.small"
stretch = "Fixed"

[nodes.empty_state_message]
component = "Label"
control_id = "HierarchyEmptyStateMessage"

[nodes.empty_state_message.props]
text = ""
text_tone = "muted"
text_align = "center"
overflow = "elide"

[nodes.empty_state_message.layout.anchor]
x = 0.5
y = 0.5

[nodes.empty_state_message.layout.pivot]
x = 0.5
y = 0.5

[nodes.empty_state_message.layout.position]
x = 0
y = 0

[nodes.empty_state_message.layout.width]
stretch = "Stretch"

[nodes.empty_state_message.layout.height]
min = 18
preferred = 18
max = 18
stretch = "Fixed"

[nodes.list_panel]
component = "Overlay"
control_id = "HierarchyListPanel"

[nodes.list_panel.props]
surface_variant = "transparent"
radius = 0
border_width = 0
overflow = "elide"

[nodes.list_panel.layout]
clip = true

[nodes.list_panel.layout.container]
kind = "Overlay"

[nodes.list_panel.layout.width]
stretch = "Stretch"

[nodes.list_panel.layout.height]
stretch = "Stretch"

[[nodes.list_panel.children]]
node = "empty_state_message"

[nodes.hierarchy_root]
component = "VerticalBox"
control_id = "HierarchyRoot"
classes = [ "workbench-shell-root" ]
pixel_snapping = "disabled"

[nodes.hierarchy_root.layout.container]
kind = "VerticalBox"
gap = 0

[nodes.hierarchy_root.layout.width]
stretch = "Stretch"

[nodes.hierarchy_root.layout.height]
stretch = "Stretch"

[[nodes.hierarchy_root.children]]
node = "header_panel"

[[nodes.hierarchy_root.children]]
node = "header_list_gap"

[[nodes.hierarchy_root.children]]
node = "search_inset_row"

[[nodes.hierarchy_root.children]]
node = "search_list_gap"

[[nodes.hierarchy_root.children]]
node = "list_panel"

[penpot_host_colors]
primary = "#60aeff"
accent = "#60aeff"
