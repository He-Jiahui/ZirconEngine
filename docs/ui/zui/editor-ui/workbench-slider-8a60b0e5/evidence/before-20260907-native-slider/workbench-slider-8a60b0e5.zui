[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_slider.zui"
version = 2
display_name = "Workbench Slider"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchSlider]
root = "root"
default_classes = ["workbench-slider", "workbench-primitive"]

[nodes.root]
component = "RangeField"
control_id = "WorkbenchSliderRoot"
pixel_snapping = "disabled"
classes = ["workbench-slider"]
props = { value = 50.0, min = 0.0, max = 100.0, step = 1.0, validation_level = "normal", track_color = "$editor.surface.0", disabled_track_color = "$editor.surface.disabled", value_background_color = "$editor.surface.0", disabled_background_color = "$editor.surface.disabled", value_color = "$editor.separator.strong", warning_color = "$editor.semantic.warning", error_color = "$editor.semantic.error", value_border_color = "$editor.border", disabled_border_color = "$editor.border.disabled", label_color = "$editor.text.secondary", foreground_color = "$editor.text.primary", disabled_foreground_color = "$editor.text.disabled", thumb_color = "$editor.text.primary", thumb_outline_color = "$editor.border", tick_color = "$editor.separator.soft", track_height = "$editor.density.gap.small", thumb_size = "$editor.density.gap.medium", horizontal_inset = "$editor.density.gap.medium", label_gap = "$editor.density.gap.large", value_text_inset = "$editor.density.gap.medium", border_width = "$editor.control.border_width", value_corner_radius = "$editor.control.radius.small", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_min_height = "$editor.control.height.dense", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
