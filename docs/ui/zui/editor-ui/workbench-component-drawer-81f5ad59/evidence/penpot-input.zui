penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/shell/workbench_component_drawer.zui\"\nversion = 2\ndisplay_name = \"Workbench Component Drawer\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_checkbox.zui#WorkbenchCheckbox\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_icon.zui#WorkbenchIcon\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_divider.zui#WorkbenchDivider\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/feedback/workbench_popup_menu.zui#WorkbenchPopupMenu\",\n  \"res://ui/editor/components/workbench/primitives/feedback/workbench_progress_bar.zui#WorkbenchProgressBar\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_radio.zui#WorkbenchRadio\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_segmented_control.zui#WorkbenchSegmentedControl\",\n  \"res://ui/editor/components/workbench/primitives/feedback/workbench_skeleton.zui#WorkbenchSkeleton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_range_slider.zui#WorkbenchRangeSlider\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_slider.zui#WorkbenchSlider\",\n  \"res://ui/editor/components/workbench/primitives/feedback/workbench_status_item.zui#WorkbenchStatusItem\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_tab_strip.zui#WorkbenchTabStrip\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n  \"res://ui/editor/components/workbench/primitives/feedback/workbench_toast.zui#WorkbenchToast\",\n  \"res://ui/editor/components/workbench/primitives/feedback/workbench_tooltip.zui#WorkbenchTooltip\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_toggle.zui#WorkbenchToggle\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_number_field.zui#WorkbenchNumberField\",\n]\nstyles = [\n  \"res://ui/editor/theme/editor_tokens.zui\",\n]\n\n[components.WorkbenchComponentDrawer]\nroot = \"component_drawer\"\ndefault_classes = [\"workbench-component-drawer\"]\n\n[nodes.component_drawer]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchComponentDrawer\"\nclasses = [\"workbench-component-drawer\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"drawer_tabs\" }, { node = \"component_drawer_content\" }]\n\n[nodes.drawer_tabs]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"BottomDrawerHeaderRoot\"\nclasses = [\"workbench-tabs\"]\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.chrome.panel_header.height\", preferred = \"$editor.chrome.panel_header.height\", max = \"$editor.chrome.panel_header.height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"retired_showcase_tabs\" }]\n\n[nodes.component_drawer_content]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"BottomDrawerContentRoot\"\nclasses = [\"workbench-bottom-drawer-content\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"retired_showcase_content\" }]\n\n[nodes.retired_showcase_tabs]\ncomponent = \"HorizontalGroup\"\nprops = { visibility = \"hidden\" }\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"drawer_tab_components\" }, { node = \"drawer_tab_console\" }]\n\n[nodes.retired_showcase_content]\ncomponent = \"VerticalGroup\"\nprops = { visibility = \"hidden\" }\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"component_body\" }, { node = \"console_body\" }]\n\n[nodes.drawer_tab_components]\ncomponent = \"WorkbenchTab\"\ncontrol_id = \"WorkbenchDrawerTabComponents\"\nclasses = [\"workbench-tab\"]\nprops = { text = \"UI Components\", layout_min_height = \"$editor.chrome.panel_header.height\" }\nlayout = { width = { min = 150.0, preferred = 150.0, max = 170.0, stretch = \"Fixed\" }, height = { min = \"$editor.chrome.panel_header.height\", preferred = \"$editor.chrome.panel_header.height\", max = \"$editor.chrome.panel_header.height\", stretch = \"Fixed\" } }\nevents = [{ id = \"PanelTab/ComponentDrawerComponents\", event = \"Click\", route = \"workbench.panel_tab.select.component_drawer_components\" }]\n\n[nodes.drawer_tab_console]\ncomponent = \"WorkbenchTab\"\ncontrol_id = \"WorkbenchDrawerTabConsole\"\nclasses = [\"workbench-tab\"]\nprops = { text = \"Console\", layout_min_height = \"$editor.chrome.panel_header.height\" }\nlayout = { width = { min = 110.0, preferred = 110.0, max = 130.0, stretch = \"Fixed\" }, height = { min = \"$editor.chrome.panel_header.height\", preferred = \"$editor.chrome.panel_header.height\", max = \"$editor.chrome.panel_header.height\", stretch = \"Fixed\" } }\nevents = [{ id = \"PanelTab/ComponentDrawerConsole\", event = \"Click\", route = \"workbench.panel_tab.select.component_drawer_console\" }]\n\n[nodes.component_body]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchComponentDrawerBody\"\nclasses = [\"workbench-component-drawer-body\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.large\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"component_top_row\" }, { node = \"component_lower_row\" }]\n\n[nodes.component_top_row]\ncomponent = \"MasonryBox\"\ncontrol_id = \"WorkbenchComponentTopRow\"\nclasses = [\"workbench-component-grid-row\"]\nlayout = { container = { kind = \"MasonryBox\", columns = 2, gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Fixed\" } }\nchildren = [{ node = \"component_buttons\" }, { node = \"component_icon_buttons\" }, { node = \"component_inputs\" }, { node = \"component_selection\" }, { node = \"component_sliders\" }, { node = \"component_labs\" }, { node = \"component_list\" }]\n\n[nodes.component_lower_row]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchComponentLowerRow\"\nclasses = [\"workbench-lower-demo\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { min = 547.0, preferred = 547.0, max = 547.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"component_table\" }, { node = \"component_feedback\" }]\n\n[nodes.console_body]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchComponentDrawerConsoleBody\"\nclasses = [\"workbench-panel\", \"workbench-console-panel\"]\nlayout = { container = { kind =