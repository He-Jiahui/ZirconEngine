ium\", layout_padding_vertical = \"$editor.density.gap.small\", layout_spacing = \"$editor.density.gap.small\" }\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.chrome.status_bar.height\", preferred = \"$editor.chrome.status_bar.height\", max = \"$editor.chrome.status_bar.height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"status_ready\" }, { node = \"status_errors\" }, { node = \"status_warnings\" }, { node = \"status_messages\" }, { node = \"status_task\" }, { node = \"status_grid\" }, { node = \"status_snap\" }, { node = \"status_snap_icon\" }, { node = \"status_world_icon\" }, { node = \"status_target_icon\" }, { node = \"status_zoom\" }]\n\n[nodes.status_ready]\ncomponent = \"WorkbenchStatusItem\"\ncontrol_id = \"WorkbenchStatusReady\"\nclasses = [\"workbench-status-item\"]\nprops = { text = \"Ready\", component_variant = \"semantic_status_signal\", text_tone = \"primary\" }\nlayout = { width = { min = 128.0, preferred = 160.0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.status_errors]\ncomponent = \"WorkbenchStatusItem\"\ncontrol_id = \"WorkbenchStatusErrors\"\nclasses = [\"workbench-status-item\"]\nprops = { text = \"No Errors\", component_variant = \"semantic_status_signal\", text_tone = \"muted\", responsive_min_tier = \"regular\" }\nlayout = { width = { min = 92.0, preferred = 92.0, max = 92.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.status_warnings]\ncomponent = \"WorkbenchStatusItem\"\ncontrol_id = \"WorkbenchStatusWarnings\"\nclasses = [\"workbench-status-item\"]\nprops = { text = \"2 Warnings\", component_variant = \"semantic_status_signal\", text_tone = \"muted\", responsive_min_tier = \"regular\" }\nlayout = { width = { min = 96.0, preferred = 96.0, max = 96.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.status_messages]\ncomponent = \"WorkbenchStatusItem\"\ncontrol_id = \"WorkbenchStatusMessages\"\nclasses = [\"workbench-status-item\"]\nprops = { text = \"0 Messages\", component_variant = \"semantic_status_signal\", text_tone = \"muted\", responsive_min_tier = \"regular\" }\nlayout = { width = { min = 100.0, preferred = 100.0, max = 100.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.status_task]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchStatusTaskProgress\"\nclasses = [\"workbench-status-task\", \"workbench-status-right-control\"]\nprops = { text = \"\", value_text = \"\", value = 0.0, min = 0.0, max = 100.0, variant = \"linear\", visibility = \"collapsed\", visible = false, text_tone = \"info\" }\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 160.0, preferred = 224.0, max = 224.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"status_task_label\" }, { node = \"status_task_bar\" }]\n\n[nodes.status_task_label]\ncomponent = \"WorkbenchChip\"\ncontrol_id = \"WorkbenchStatusTaskLabel\"\nclasses = [\"workbench-chip\", \"workbench-status-task-label\"]\nprops = { text = \"\", value_text = \"\", text_tone = \"info\", layout_min_height = \"$editor.chrome.status_bar.height\" }\nlayout = { width = { min = 100.0, preferred = 132.0, max = 132.0, stretch = \"Fixed\" }, height = { min = \"$editor.chrome.status_bar.height\", preferred = \"$editor.chrome.status_bar.height\", max = \"$editor.chrome.status_bar.height\", stretch = \"Fixed\" } }\n\n[nodes.status_task_bar]\ncomponent = \"WorkbenchProgressBar\"\ncontrol_id = \"WorkbenchStatusTaskBar\"\nclasses = [\"workbench-progress-bar\", \"workbench-status-task-bar\"]\nprops = { value = 0.0, value_percent = 0.0, min = 0.0, max = 100.0, variant = \"linear\", label_text = \"\", show_label = false, text_tone = \"info\" }\nlayout = { width = { min = 52.0, preferred = 84.0, max = 84.0, stretch = \"Fixed\" }, height = { min = 18.0, preferred = 18.0, max = 20.0, stretch = \"Fixed\" 