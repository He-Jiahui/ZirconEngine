ents = [{ id = \"Workbench/ToggleSnapFromStatus\", event = \"Click\", route = \"workbench.status.toggle_snap\" }]\n\n[nodes.status_world_icon]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"WorkbenchStatusWorld\"\nclasses = [\"workbench-icon-button\", \"workbench-status-right-icon\"]\nprops = { icon = \"zircon_editor_shell/viewport/globe.svg\", label = \"World\", responsive_min_tier = \"wide\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, layout_min_width = \"$editor.chrome.status_bar.height\", layout_min_height = \"$editor.chrome.status_bar.height\" }\nlayout = { width = { min = \"$editor.chrome.status_bar.height\", preferred = \"$editor.chrome.status_bar.height\", max = \"$editor.chrome.status_bar.height\", stretch = \"Fixed\" }, height = { min = \"$editor.chrome.status_bar.height\", preferred = \"$editor.chrome.status_bar.height\", max = \"$editor.chrome.status_bar.height\", stretch = \"Fixed\" } }\n\n[nodes.status_target_icon]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"WorkbenchStatusTarget\"\nclasses = [\"workbench-icon-button\", \"workbench-status-right-icon\", \"workbench-quiet-action\"]\nprops = { icon = \"zircon_editor_shell/viewport/crosshair.svg\", label = \"Target\", responsive_min_tier = \"wide\", layout_min_width = \"$editor.chrome.status_bar.height\", layout_min_height = \"$editor.chrome.status_bar.height\" }\nlayout = { width = { min = \"$editor.chrome.status_bar.height\", preferred = \"$editor.chrome.status_bar.height\", max = \"$editor.chrome.status_bar.height\", stretch = \"Fixed\" }, height = { min = \"$editor.chrome.status_bar.height\", preferred = \"$editor.chrome.status_bar.height\", max = \"$editor.chrome.status_bar.height\", stretch = \"Fixed\" } }\nevents = [{ id = \"Workbench/FrameSelectionFromStatus\", event = \"Click\", route = \"workbench.status.frame_selection\" }]\n\n[nodes.status_zoom]\ncomponent = \"WorkbenchChip\"\ncontrol_id = \"WorkbenchStatusZoom\"\nclasses = [\"workbench-chip\", \"workbench-status-right-control\"]\nprops = { text = \"100%\", responsive_min_tier = \"wide\", layout_min_height = \"$editor.chrome.status_bar.height\", layout_padding_top = 0.0, layout_padding_bottom = 0.0 }\nlayout = { width = { min = 56.0, preferred = 56.0, max = 56.0, stretch = \"Fixed\" }, height = { min = \"$editor.chrome.status_bar.height\", preferred = \"$editor.chrome.status_bar.height\", max = \"$editor.chrome.status_bar.height\", stretch = \"Fixed\" } }\n"

