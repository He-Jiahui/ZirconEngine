penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/host/floating_window_source.zui\"\nversion = 2\ndisplay_name = \"floating window source\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"FloatingWindowSourceRoot\"\npixel_snapping = \"disabled\"\nclasses = [\"floating-window-source\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"top_bar\" }, { node = \"center_band\" }, { node = \"status_bar\" }]\n\n[nodes.top_bar]\ncomponent = \"Container\"\ncontrol_id = \"FloatingWindowTopBarRoot\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.center_band]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"FloatingWindowCenterBandRoot\"\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"rail\" }, { node = \"document\" }]\n\n[nodes.rail]\ncomponent = \"Container\"\ncontrol_id = \"FloatingWindowRailRoot\"\nlayout = { clip = true, width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.document]\ncomponent = \"Container\"\ncontrol_id = \"FloatingWindowDocumentRoot\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.status_bar]\ncomponent = \"Container\"\ncontrol_id = \"FloatingWindowStatusBarRoot\"\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { min = 22.0, preferred = 22.0, max = 22.0, stretch = \"Fixed\" } }\n"

[asset]
kind = "view"
id = "res://ui/editor/host/floating_window_source.zui"
version = 2
display_name = "floating window source"

[root]
