[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_toast.zui"
version = 2
display_name = "Workbench Toast"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchToast]
root = "root"
default_classes = ["workbench-alert", "workbench-toast", "workbench-primitive"]

[nodes.root]
component = "Snackbar"
control_id = "WorkbenchToastRoot"
classes = ["workbench-alert", "workbench-toast"]
props = { text = "Operation completed successfully", severity = "info", variant = "outlined", color = "info", icon = "info", show_icon = true, closeText = "Close", background_color = "$editor.semantic.info.container", border_color = "$editor.semantic.info", foreground_color = "$editor.semantic.info", icon_color = "$editor.semantic.info", action_color = "$editor.semantic.info", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.panel", layout_offset_x = -15.0, layout_offset_y = 0.0, status_mark_size = 18.0, status_mark_color = "$editor.semantic.info" }
# Toast messages may wrap at the required 240px review width. Keep the
# semantic Snackbar host tall enough for two 14px lines instead of clipping
# the second line or positioning the first glyph above the host.
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.large", preferred = "$editor.control.height.large", max = "$editor.control.height.large", stretch = "Fixed" } }
