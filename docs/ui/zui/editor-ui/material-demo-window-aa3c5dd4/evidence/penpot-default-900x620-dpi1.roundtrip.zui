[asset]
kind = "view"
id = "res://ui/editor/material_demo_window.zui"
version = 2
display_name = "Material Primitive Demo"

[imports]
styles = ["res://ui/editor/theme/editor_tokens.zui", "res://ui/theme/editor_material.zui"]

[tokens]
"surface.window" = "$editor.surface.0"
"surface.panel" = "$editor.surface.1"
"surface.raised" = "$editor.surface.2"
"text.primary" = "$editor.text.primary"
"text.secondary" = "$editor.text.secondary"
"action.hover" = "$editor.surface.hover"
"action.pressed" = "$editor.surface.3"
"action.selected" = "$editor.surface.selected"
"action.disabled" = "$editor.text.disabled"
"focus.ring" = "$editor.focus.ring"
"palette.primary.main" = "$editor.accent"
"palette.warning.main" = "$editor.semantic.warning"
"palette.error.main" = "$editor.semantic.error"

[root]
node = "window"

[nodes.window]
component = "WindowFrame"
control_id = "MaterialPrimitiveDemoWindow"
pixel_snapping = "disabled"
classes = ["material_dark", "material-demo-window"]
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, padding = { left = 16.0, top = 16.0, right = 16.0, bottom = 16.0 }, container = { kind = "VerticalBox", gap = 16.0 } }
children = [{ node = "content" }]

[nodes.content]
component = "VerticalGroup"
control_id = "MaterialPrimitiveDemoContent"
classes = ["material-panel"]
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "VerticalBox", gap = 16.0 } }
children = [
  { node = "title" },
  { node = "toolbar" },
  { node = "form_panel" },
  { node = "selection_panel" },
  { node = "feedback_panel" },
]

[nodes.title]
component = "Label"
control_id = "MaterialPrimitiveTitle"
props = { text = "Material Primitive Demo", font_size = 20.0, font_weight = 600, foreground_color = "$editor.text.primary" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.toolbar]
component = "HorizontalGroup"
control_id = "MaterialPrimitiveToolbar"
classes = ["material-toolbar"]
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" }, container = { kind = "HorizontalBox", gap = 8.0 } }
children = [
  { node = "primary_button" },
  { node = "icon_button" },
  { node = "menu" },
  { node = "tooltip" },
]

[nodes.primary_button]
component = "Button"
control_id = "PrimaryButton"
classes = ["material-control", "primary"]
props = { text = "Apply", density = "compact" }
state = { hovered = true, focused = true }
layout = { width = { min = 96.0, preferred = 96.0, max = 96.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.icon_button]
component = "IconButton"
control_id = "IconButton"
classes = ["material-control"]
props = { icon = "save-outline", text = "Save", density = "compact" }
state = { pressed = true }
layout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.menu]
component = "Menu"
control_id = "Menu"
classes = ["material-control"]
props = { text = "Create" }
layout = { width = { min = 96.0, preferred = 112.0, max = 112.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.tooltip]
component = "Tooltip"
control_id = "Tooltip"
classes = ["material-control"]
props = { text = "Hover help" }
layout = { width = { min = 140.0, stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.form_panel]
component = "Panel"
control_id = "FormPanel"
classes = ["material-panel"]
layout = { width = { stretch = "Stretch" }, height = { min = 64.0, preferred = 64.0, max = 64.0, stretch = "Fixed" }, padding = { left = 12.0, top = 16.0, right = 12.0, bottom = 16.0 }, container = { kind = "HorizontalBox", gap = 12.0 } }
children = [
  { node = "text_field" },
  { node = "checkbox" },
  { node = "switch" },
]

[nodes.text_field]
component = "TextField"
control_id = "TextField"
classes = ["material-control"]
props = { text = "PlayerName", density = "compact" }
state = { warning = true }
layout = { width = { min = 160.0, stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.checkbox]
component = "Checkbox"
control_id = "Checkbox"
classes = ["material-control"]
props = { checked = true, text = "Visible", density = "compact" }
state = { selected = true }
layout = { width = { min = 108.0, preferred = 128.0, max = 128.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.switch]
component = "Switch"
control_id = "Switch"
classes = ["material-control"]
props = { checked = false, text = "Cast shadows", density = "compact" }
state = { disabled = true }
layout = { width = { min = 164.0, preferred = 164.0, max = 164.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.selection_panel]
component = "HorizontalGroup"
control_id = "SelectionPanel"
classes = ["material-panel"]
layout = { width = { stretch = "Stretch" }, height = { min = 64.0, preferred = 64.0, max = 64.0, stretch = "Fixed" }, padding = { left = 12.0, top = 16.0, right = 12.0, bottom = 16.0 }, container = { kind = "HorizontalBox", gap = 12.0 } }
children = [
  { node = "dropdown" },
  { node = "slider" },
  { node = "tabs" },
]

[nodes.dropdown]
component = "Dropdown"
control_id = "Dropdown"
classes = ["material-control"]
props = { value_text = "Shaded", options = ["Shaded", "Wireframe"], density = "compact" }
layout = { width = { min = 140.0, stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.slider]
component = "Slider"
control_id = "Slider"
classes = ["material-control"]
props = { value = 0.64, density = "compact" }
layout = { width = { min = 160.0, stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.tabs]
component = "Tabs"
control_id = "Tabs"
classes = ["material-control"]
props = { value_text = "Scene" }
state = { selected = true }
layout = { width = { min = 96.0, preferred = 112.0, max = 112.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.feedback_panel]
component = "HorizontalGroup"
control_id = "FeedbackPanel"
classes = ["material-panel"]
layout = { width = { stretch = "Stretch" }, height = { min = 64.0, preferred = 64.0, max = 64.0, stretch = "Fixed" }, padding = { left = 12.0, top = 16.0, right = 12.0, bottom = 16.0 }, container = { kind = "HorizontalBox", gap = 12.0 } }
children = [
  { node = "scrollbar" },
  { node = "splitter" },
  { node = "modal" },
]

[nodes.scrollbar]
component = "Scrollbar"
control_id = "Scrollbar"
classes = ["material-control"]
props = { value = 0.25, density = "compact" }
layout = { width = { min = 140.0, stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.splitter]
component = "Splitter"
control_id = "Splitter"
classes = ["material-control"]
props = { value = 0.5, density = "compact" }
layout = { width = { min = 140.0, stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.modal]
component = "Modal"
control_id = "Modal"
classes = ["material-control"]
props = { open = false, density = "compact" }
state = { error = true }
layout = { width = { min = 140.0, stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[[stylesheets]]
id = "material_demo"

[[stylesheets.rules]]
selector = ".material-control"
set = { self = { font = { family = "Fira Sans", size = "$editor.typography.body.size", weight = "$editor.typography.body.weight" }, border = { radius = "$editor.control.radius.control", width = "$editor.control.border_width", color = "$editor.border" }, foreground = { color = "$editor.text.primary" } } }

[[stylesheets.rules]]
selector = ".material-demo-window"
[stylesheets.rules.set.self]
background = "$surface.window"
fg = "$text.primary"

[[stylesheets.rules]]
selector = ".material-panel"
[stylesheets.rules.set.self]
background = "$surface.panel"
fg = "$text.secondary"

[[stylesheets.rules]]
selector = ".material-control:hover"
[stylesheets.rules.set.self]
background = "$action.hover"

[[stylesheets.rules]]
selector = ".material-control:selected"
[stylesheets.rules.set.self]
background = "$action.selected"

[[stylesheets.rules]]
selector = ".material-control:pressed"
[stylesheets.rules.set.self]
background = "$action.pressed"

[[stylesheets.rules]]
selector = ".material-control:disabled"
[stylesheets.rules.set.self]
fg = "$action.disabled"

[[stylesheets.rules]]
selector = "#PrimaryButton:focused"
[stylesheets.rules.set.self]
outline = "$focus.ring"

[[stylesheets.rules]]
selector = ".material-control:warning"
[stylesheets.rules.set.self]
fg = "$palette.warning.main"

[[stylesheets.rules]]
selector = ".material-control:error"
[stylesheets.rules.set.self]
fg = "$palette.error.main"
