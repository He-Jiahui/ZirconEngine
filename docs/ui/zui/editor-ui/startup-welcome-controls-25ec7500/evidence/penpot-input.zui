penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/host/startup_welcome_controls.zui\"\nversion = 2\ndisplay_name = \"startup welcome controls\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\npixel_snapping = \"disabled\"\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WelcomeSurfaceControls\"\nclasses = [\"editor-surface-controls\", \"welcome-controls\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"project_name\" }, { node = \"location\" }, { node = \"actions\" }, { node = \"recent_actions\" }]\n\n[nodes.project_name]\ncomponent = \"InputField\"\ncontrol_id = \"ProjectNameEdited\"\nprops = { label = \"Project\", placeholder = \"Project name\", value_text = \"\", surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\", layout_min_height = \"$editor.control.height.default\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nevents = [{ id = \"WelcomeSurface/ProjectNameEdited\", event = \"Change\", route = \"workbench.welcome.set_project_name\" }]\n\n[nodes.location]\ncomponent = \"InputField\"\ncontrol_id = \"LocationEdited\"\nprops = { label = \"Location\", placeholder = \"Project location\", value_text = \"\", surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\", layout_min_height = \"$editor.control.height.default\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nevents = [{ id = \"WelcomeSurface/LocationEdited\", event = \"Change\", route = \"workbench.welcome.set_location\" }]\n\n[nodes.actions]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WelcomePrimaryActions\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nchildren = [{ node = \"create\" }, { node = \"open_existing\" }]\n\n[nodes.create]\ncomponent = \"IconButton\"\ncontrol_id = \"CreateProject\"\nprops = { label = \"Create\", icon = \"add-circle-outline\", icon_placement = \"leading\", surface_variant = \"accent\", button_variant = \"primary\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WelcomeSurface/CreateProject\", event = \"Click\", route = \"workbench.welcome.surface.create_project\" }]\n\n[nodes.open_existing]\ncomponent = \"IconButton\"\ncontrol_id = \"OpenExistingProject\"\nprops = { label = \"Open\", icon = \"editor_pages/workbench/menu/open-project.svg\", icon_placement = \"leading\", surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WelcomeSurface/OpenExistingProject\", event = \"Click\", route = \"workbench.welcome.open_existing_project\" }]\n\n[nodes.recent_actions]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WelcomeRecentActions\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nchildren = [{ node = \"open_recent\" }, { node = \"safe_recent\" }, { node = \"recover_recent\" }, { node = \"remove_recent\" }]\n\n[nodes.open_recent]\ncomponent = \"IconButton\"\ncontrol_id = \"OpenRecentProject\"\nprops = { label = \"Open Recent\", icon = \"editor_pages/asset_browser/navigation/recent.svg\", icon_placement = \"leading\", surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WelcomeSurface/OpenRecentProject\", event = \"Click\", route = \"workbench.welcome.open_recent_project\" }]\n\n[nodes.safe_recent]\ncomponent = \"IconButton\"\ncontrol_id = \"SafeRecentProject\"\nprops = { label = \"Safe Mode\", icon = \"editor_pages/hierarchy/row_state/warning-state.svg\", icon_placement = \"icon_only\", surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\" }\nlayout = { width = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WelcomeSurface/SafeRecentProject\", event = \"Click\", route = \"workbench.welcome.safe_recent_project\" }]\n\n[nodes.recover_recent]\ncomponent = \"IconButton\"\ncontrol_id = \"RecoverRecentProject\"\nprops = { label = \"Recover\", icon = \"editor_pages/workbench/menu/undo-history.svg\", icon_placement = \"icon_only\", surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\" }\nlayout = { width = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WelcomeSurface/RecoverRecentProject\", event = \"Click\", route = \"workbench.welcome.recover_recent_project\" }]\n\n[nodes.remove_recent]\ncomponent = \"IconButton\"\ncontrol_id = \"RemoveRecentProject\"\nprops = { label = \"Remove\", icon = \"editor_pages/workbench/tabs/close-tab.svg\", icon_placement = \"icon_only\", surface_variant = \"danger\", text_tone = \"danger\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\" }\nlayout = { width = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WelcomeSurface/RemoveRecentProject\", event = \"Click\", route = \"workbench.welcome.remove_recent_project\" }]\n"

[asset]
kind = "view"
id = "res://ui/editor/host/startup_welcome_controls.zui"
version = 2
display_name = "startup welcome controls"

[root]
node = "root"

[nodes.root]
pixel_snapping = "disabled"
component = "VerticalGroup"
control_id = "WelcomeSurfaceControls"
classes = [ "editor-surface-controls", "welcome-controls" ]

[nodes.root.layout.container]
kind = "VerticalBox"
gap = "$editor.density.gap.small"

[nodes.root.layout.width]
stretch = "Stretch"

[nodes.root.layout.height]
stretch = "Stretch"

[[nodes.root.children]]
node = "project_name"

[[nodes.root.children]]
node = "location"

[[nodes.root.children]]
node = "actions"

[[nodes.root.children]]
node = "recent_actions"

[nodes.project_name]
component = "InputField"
control_id = "ProjectNameEdited"

[nodes.project_name.props]
label = "Project"
placeholder = "Project name"
value_text = ""
surface_variant = "inset"
border_width = "$editor.control.border_width"
corner_radius = "$editor.control.radius.control"
layout_min_height = "$editor.control.height.default"

[nodes.project_name.layout.width]
stretch = "Stretch"

[nodes.project_name.layout.height]
min = "$editor.control.height.default"
preferred = "$editor.control.height.default"
max = "$editor.control.height.default"
stretch = "Fixed"

[[nodes.project_name.events]]
id = "WelcomeSurface/ProjectNameEdited"
event = "Change"
route = "workbench.welcome.set_project_name"

[nodes.location]
component = "InputField"
control_id = "LocationEdited"

