penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/host/asset_surface_controls.zui\"\nversion = 2\ndisplay_name = \"asset surface controls\"\n\n[root]\nnode = \"root\"\n\n[nodes.root]\npixel_snapping = \"disabled\"\ncomponent = \"VerticalGroup\"\ncontrol_id = \"AssetSurfaceControls\"\nclasses = [\"editor-surface-controls\", \"asset-surface-controls\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"filter_row\" },\n  { node = \"display_row\" },\n  { node = \"navigation_row\" },\n  { node = \"pointer_routes\" },\n]\n\n[nodes.filter_row]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"AssetFilterRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nchildren = [\n  { node = \"search\" },\n  { node = \"kind_filter\" },\n]\n\n[nodes.display_row]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"AssetDisplayRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nchildren = [\n  { node = \"view_mode\" },\n  { node = \"utility_tab\" },\n]\n\n[nodes.navigation_row]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"AssetNavigationRow\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\nchildren = [\n  { node = \"open_browser\" },\n  { node = \"locate_asset\" },\n  { node = \"import_model\" },\n]\n\n[nodes.pointer_routes]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"AssetPointerRoutes\"\nprops = { visibility = \"collapsed\", visible = false }\nlayout = { clip = true, container = { kind = \"VerticalBox\" }, width = { stretch = \"Stretch\" }, height = { min = 0.0, preferred = 0.0, max = 0.0, stretch = \"Fixed\" } }\nchildren = [\n  { node = \"select_folder\" },\n  { node = \"select_item\" },\n  { node = \"activate_reference\" },\n]\n\n[nodes.select_folder]\ncomponent = \"IconButton\"\ncontrol_id = \"SelectFolder\"\nprops = { label = \"Folder\", icon = \"editor_pages/asset_browser/navigation/folder.svg\", icon_placement = \"leading\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/SelectFolder\", event = \"Change\", route = \"workbench.asset.select_folder\" }]\n\n[nodes.select_item]\ncomponent = \"IconButton\"\ncontrol_id = \"SelectItem\"\nprops = { label = \"Asset\", icon = \"cube-outline\", icon_placement = \"leading\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/SelectItem\", event = \"Change\", route = \"workbench.asset.select_item\" }]\n\n[nodes.search]\ncomponent = \"InputField\"\ncontrol_id = \"SearchEdited\"\nprops = { placeholder = \"Search\", value_text = \"\", surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\", layout_min_height = \"$editor.control.height.dense\", input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/SearchEdited\", event = \"Change\", route = \"workbench.asset.set_search_query\" }]\n\n[nodes.kind_filter]\ncomponent = \"ComboBox\"\ncontrol_id = \"SetKindFilter\"\nprops = { label = \"Kind\", value = \"All\", value_text = \"All Types\", options = [\"All|label=All Types\", \"Texture|label=Textures\", \"Material|label=Materials\", \"Scene|label=Scenes\", \"Model|label=Models\", \"Mesh|label=Meshes\", \"Shader|label=Shaders\", \"PhysicsMaterial|label=Physics Materials\", \"AnimationSkeleton|label=Animation Skeletons\", \"AnimationClip|label=Animation Clips\", \"AnimationSequence|label=Animation Sequences\", \"AnimationGraph|label=Animation Graphs\", \"AnimationStateMachine|label=Animation State Machines\", \"UiLayout|label=UI Layouts\", \"UiWidget|label=UI Widgets\", \"UiStyle|label=UI Styles\"], surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\", layout_min_height = \"$editor.control.height.dense\", input_focusable = true }\nlayout = { width = { min = 124.0, preferred = 168.0, max = 220.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/SetKindFilter\", event = \"Change\", route = \"workbench.asset.set_kind_filter\" }]\n\n[nodes.view_mode]\ncomponent = \"IconButton\"\ncontrol_id = \"SetViewMode\"\nprops = { label = \"View\", icon = \"list-outline\", icon_placement = \"leading\", surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\", layout_min_height = \"$editor.control.height.dense\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/SetViewMode\", event = \"Change\", route = \"workbench.asset.set_view_mode\" }]\n\n[nodes.utility_tab]\ncomponent = \"IconButton\"\ncontrol_id = \"SetUtilityTab\"\nprops = { label = \"Tools\", icon = \"editor_pages/asset_browser/import_pipeline/import-settings.svg\", icon_placement = \"leading\", surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\", layout_min_height = \"$editor.control.height.dense\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/SetUtilityTab\", event = \"Change\", route = \"workbench.asset.set_utility_tab\" }]\n\n[nodes.activate_reference]\ncomponent = \"IconButton\"\ncontrol_id = \"ActivateReference\"\nprops = { label = \"Use\", icon = \"editor_pages/asset_browser/references/reference.svg\", icon_placement = \"leading\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/ActivateReference\", event = \"Click\", route = \"workbench.asset.activate_reference\" }]\n\n[nodes.open_browser]\ncomponent = \"IconButton\"\ncontrol_id = \"OpenAssetBrowser\"\nprops = { label = \"Browser\", icon = \"editor_pages/asset_browser/navigation/folder.svg\", icon_placement = \"leading\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/OpenAssetBrowser\", event = \"Click\", action = { action = \"view.asset_browser.open\" } }]\n\n[nodes.locate_asset]\ncomponent = \"IconButton\"\ncontrol_id = \"LocateSelectedAsset\"\nprops = { label = \"Locate\", icon = \"editor_pages/asset_browser/navigation/search.svg\", icon_placement = \"leading\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/LocateSelectedAsset\", event = \"Click\", route = \"workbench.asset.locate_selected_asset\" }]\n\n[nodes.import_model]\ncomponent = \"IconButton\"\ncontrol_id = \"ImportModel\"\nprops = { label = \"Import\", icon = \"editor_pages/asset_browser/import_pipeline/import.svg\", icon_placement = \"leading\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"AssetSurface/ImportModel\", event = \"Click\", route = \"workbench.asset.import_model\" }]\n"

[asset]
kind = "view"
id = "res://ui/editor/host/asset_surface_controls.zui"
version = 2
display_name = "asset surface controls"

[root]
node = "root"

[nodes.root]
pixel_snapping = "disabled"
component = "VerticalGroup"
control_id = "AssetSurfaceControls"
classes = [ "editor-surface-controls", "asset-surface-controls" ]

[nodes.root.layout.container]
