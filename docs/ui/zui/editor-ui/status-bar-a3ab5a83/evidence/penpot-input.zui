penpot_original_source = "[asset]\r\nkind = \"component\"\r\nid = \"res://ui/editor/unreal/components/status_bar.zui\"\r\nversion = 2\r\ndisplay_name = \"Unreal editor status bar\"\r\n\r\n[imports]\r\nwidgets = []\r\nstyles = [\"res://ui/editor/unreal/starship.zui\"]\r\n\r\n[components.UnrealEditorStatusBar]\r\nroot = \"root\"\r\ndefault_classes = [\"unreal-status-bar\"]\r\n\r\n[nodes.root]\r\ncomponent = \"HorizontalGroup\"\r\ncontrol_id = \"UnrealEditorStatusBar\"\r\nclasses = [\"unreal-status-bar\"]\r\nprops = { background_color = \"#151515\", foreground_color = \"$editor.text.secondary\", font_size = 10.666667, line_height_ratio = 1.2, separator_edge = \"top\", separator_color = \"#383838\", separator_thickness = 1.0, layout_padding_left = 8.0, layout_padding_right = 8.0 }\r\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" } }\r\nchildren = [{ node = \"drawer_toggle\" }, { node = \"ready\" }, { node = \"errors\" }, { node = \"warnings\" }, { node = \"messages\" }, { node = \"fill\" }, { node = \"grid\" }, { node = \"snap\" }, { node = \"snap_toggle\" }, { node = \"world\" }, { node = \"target\" }, { node = \"zoom\" }, { node = \"task\" }]\r\n\r\n[nodes.ready]\r\ncomponent = \"Label\"\r\nclasses = [\"unreal-status-label\"]\r\ncontrol_id = \"WorkbenchStatusReady\"\r\nprops = { foreground_color = \"$unreal_foreground\", line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", text = \"Ready\", component_variant = \"semantic_status_signal\", text_tone = \"primary\" }\r\nlayout = { width = { min = 100.0, preferred = 160.0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.errors]\r\ncomponent = \"Label\"\r\nclasses = [\"unreal-status-label\"]\r\ncontrol_id = \"WorkbenchStatusErrors\"\r\nprops = { foreground_color = \"$unreal_foreground\", line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", text = \"No Errors\", component_variant = \"semantic_status_signal\", text_tone = \"muted\" }\r\nlayout = { width = { min = 80.0, preferred = 92.0, max = 92.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.warnings]\r\ncomponent = \"Label\"\r\nclasses = [\"unreal-status-label\"]\r\ncontrol_id = \"WorkbenchStatusWarnings\"\r\nprops = { foreground_color = \"$unreal_foreground\", line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", text = \"0 Warnings\", component_variant = \"semantic_status_signal\", text_tone = \"muted\" }\r\nlayout = { width = { min = 80.0, preferred = 96.0, max = 96.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.messages]\r\ncomponent = \"Label\"\r\nclasses = [\"unreal-status-label\"]\r\ncontrol_id = \"WorkbenchStatusMessages\"\r\nprops = { foreground_color = \"$unreal_foreground\", line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", text = \"0 Messages\", component_variant = \"semantic_status_signal\", text_tone = \"muted\" }\r\nlayout = { width = { min = 80.0, preferred = 100.0, max = 100.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.fill]\r\ncomponent = \"Space\"\r\ncontrol_id = \"UnrealStatusBarFill\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.grid]\r\ncomponent = \"Button\"\r\nclasses = [\"unreal-control\", \"unreal-status-control\"]\r\ncontrol_id = \"WorkbenchStatusGrid\"\r\nprops = { input_hoverable = false, input_clickable = false, input_focusable = false, line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", text = \"Grid: 10 cm\", button_variant = \"text\", input_interactive = false }\r\nlayout = { width = { min = 90.0, preferred = 96.0, max = 96.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.snap]\r\ncomponent = \"Button\"\r\nclasses = [\"unreal-control\", \"unreal-status-control\"]\r\ncontrol_id = \"WorkbenchStatusSnap\"\r\nprops = { input_hoverable = false, input_clickable = false, input_focusable = false, line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", text = \"Snap: On\", button_variant = \"text\", input_interactive = false }\r\nlayout = { width = { min = 76.0, preferred = 80.0, max = 80.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.snap_toggle]\r\ncomponent = \"IconButton\"\r\nclasses = [\"unreal-control\", \"unreal-status-control\", \"unreal-icon-control\"]\r\ncontrol_id = \"WorkbenchStatusSnapToggle\"\r\nprops = { input_hoverable = true, input_clickable = true, input_focusable = true, input_interactive = true, line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", label = \"Snap\", icon = \"zircon_editor_shell/viewport/magnet.svg\", icon_placement = \"icon_only\" }\r\nlayout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nevents = [{ id = \"Workbench/ToggleSnapFromStatus\", event = \"Click\", route = \"workbench.status.toggle_snap\" }]\r\n[nodes.world]\r\ncomponent = \"IconButton\"\r\nclasses = [\"unreal-control\", \"unreal-status-control\", \"unreal-icon-control\"]\r\ncontrol_id = \"WorkbenchStatusWorld\"\r\nprops = { input_hoverable = false, input_clickable = false, input_focusable = false, line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", label = \"World\", icon = \"zircon_editor_shell/viewport/globe.svg\", icon_placement = \"icon_only\", input_interactive = false }\r\nlayout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.target]\r\ncomponent = \"IconButton\"\r\nclasses = [\"unreal-control\", \"unreal-status-control\", \"unreal-icon-control\"]\r\ncontrol_id = \"WorkbenchStatusTarget\"\r\nprops = { input_hoverable = true, input_clickable = true, input_focusable = true, input_interactive = true, line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", label = \"Target\", icon = \"zircon_editor_shell/viewport/crosshair.svg\", icon_placement = \"icon_only\" }\r\nlayout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nevents = [{ id = \"Workbench/FrameSelectionFromStatus\", event = \"Click\", route = \"workbench.status.frame_selection\" }]\r\n[nodes.zoom]\r\ncomponent = \"Button\"\r\nclasses = [\"unreal-control\", \"unreal-status-control\"]\r\ncontrol_id = \"WorkbenchStatusZoom\"\r\nprops = { input_hoverable = false, input_clickable = false, input_focusable = false, input_interactive = false, line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", text = \"100%\", button_variant = \"text\" }\r\nlayout = { width = { min = 52.0, preferred = 56.0, max = 56.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.drawer_toggle]\r\ncomponent = \"Button\"\r\ncontrol_id = \"UnrealContentDrawerToggle\"\r\nclasses = [\"unreal-status-drawer-button\", \"unreal-control\", \"unreal-status-control\"]\r\nprops = { input_hoverable = true, input_clickable = true, input_interactive = true, line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", text = \"Content Drawer\", button_variant = \"text\", input_focusable = true }\r\nlayout = { width = { min = 120.0, preferred = 150.0, max = 180.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nevents = [{ id = \"Unreal/ToggleContentDrawer\", event = \"Click\", route = \"workbench.content_drawer.toggle\" }]\r\n[nodes.task]\r\ncomponent = \"HorizontalGroup\"\r\ncontrol_id = \"WorkbenchStatusTaskProgress\"\r\nprops = { text = \"\", value_text = \"\", value = 0.0, min = 0.0, max = 100.0, variant = \"linear\", visibility = \"collapsed\", visible = false }\r\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 160.0, preferred = 224.0, max = 224.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"task_label\" }, { node = \"task_bar\" }]\r\n[nodes.task_label]\r\ncomponent = \"Label\"\r\nclasses = [\"unreal-status-label\"]\r\ncontrol_id = \"WorkbenchStatusTaskLabel\"\r\nprops = { foreground_color = \"$unreal_foreground\", line_height_ratio = 1.2, font_weight = 400, font_size = 10.666667, font_family = \"Roboto\", text = \"\" }\r\nlayout = { width = { min = 100.0, preferred = 132.0, max = 132.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.task_bar]\r\ncomponent = \"ProgressBar\"\r\ncontrol_id = \"WorkbenchStatusTaskBar\"\r\nprops = { value = 0.0, value_percent = 0.0, min = 0.0, max = 100.0, variant = \"linear\", label_text = \"\", show_label = false }\r\nlayout = { width = { min = 52.0, preferred = 84.0, max = 84.0, stretch = \"Fixed\" }, height = { min = 18.0, preferred = 18.0, max = 20.0, stretch = \"Fixed\" } }\r\n"

