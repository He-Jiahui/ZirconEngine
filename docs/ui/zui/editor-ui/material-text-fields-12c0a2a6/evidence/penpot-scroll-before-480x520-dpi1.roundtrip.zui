[asset]
kind = "component"
id = "res://ui/editor/material_components/inputs/material_text_fields.zui"
version = 2
display_name = "Material Text Fields Prototype"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption"]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.MaterialTextFieldsPrototype]
root = "root"
default_classes = ["material-lab-prototype", "material-surface"]

[nodes.title]
component = "WorkbenchLabel"
control_id = "text-fields_Title"
classes = ["material-lab-title"]
props = { "text" = "Text Fields", "text_tone" = "primary", "font_size" = "$editor.typography.title.size", "font_weight" = "$editor.typography.strong.weight", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 28, "preferred" = 28, "max" = 28, "stretch" = "Fixed" } }

[nodes.meta]
component = "GridBox"
control_id = "text_fields_Meta"
classes = ["material-lab-meta-strip", "material-lab-meta"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 84, "preferred" = 84, "max" = 84, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 2, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "meta_group" },
  { node = "meta_response" },
  { node = "meta_variant" },
  { node = "meta_layout" },
]

[nodes.meta_group]
component = "WorkbenchCaption"
control_id = "text_fields_MetaGroup"
classes = ["material-lab-meta-chip", "material-lab-meta-group"]
props = { "text" = "Inputs", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 40, "preferred" = 40, "max" = 40, "stretch" = "Fixed" } }

[nodes.meta_response]
component = "WorkbenchCaption"
control_id = "text_fields_MetaResponse"
classes = ["material-lab-meta-chip", "material-lab-meta-response"]
props = { "text" = "change / commit", "text_tone" = "success", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "response_mechanism" = "change / commit", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 40, "preferred" = 40, "max" = 40, "stretch" = "Fixed" } }
[nodes.meta_variant]
component = "WorkbenchCaption"
control_id = "text_fields_MetaVariant"
classes = ["material-lab-meta-chip", "material-lab-meta-variant"]
props = { "text" = "outlined / filled / standard", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "variant" = "outlined / filled / standard", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 40, "preferred" = 40, "max" = 40, "stretch" = "Fixed" } }

[nodes.meta_layout]
component = "WorkbenchCaption"
control_id = "text_fields_MetaLayout"
classes = ["material-lab-meta-chip", "material-lab-meta-layout"]
props = { "text" = "inline controls", "text_tone" = "warning", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "layout_mode" = "inline controls", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 40, "preferred" = 40, "max" = 40, "stretch" = "Fixed" } }
[nodes.sample]
component = "HorizontalBox"
control_id = "text-fields_Sample"
classes = ["material-control", "material-lab-sample", "material-text-field-row"]
props = { label = "Name", value = "Material input", value_text = "Material input", placeholder = "Type here", helper_text = "Focus, edit, submit", variant = "outlined", surface_variant = "elevated", button_variant = "contained", text_tone = "primary", validation_level = "normal", hovered = true, pressed = false, focused = true, selected = true, checked = true, disabled = false, open = false, popup_open = false, corner_radius = 4, border_width = 1, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = 0.0, stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, clip = true, input_policy = "Receive", container = { kind = "ScrollableBox", axis = "Horizontal", gap = 4.0, scrollbar_visibility = "Auto" } }
children = [
  { node = "field_outlined_focus" },
  { node = "field_filled_helper" },
  { node = "field_standard" },
  { node = "field_error" },
  { node = "field_disabled" },
]
events = [
  { id = "MaterialLab/TextFields/Change", event = "Change", route = "material_lab.text_fields.change" },
]

[nodes.field_outlined_focus]
component = "TextField"
control_id = "text-fields_OutlinedFocus"
classes = ["material-control", "material-text-field", "material-text-field-outlined", "material-text-field-focused"]
props = { label = "Name", value = "Scene", value_text = "Scene", placeholder = "Name", helper_text = "Focused label", variant = "outlined", surface_variant = "elevated", button_variant = "contained", text_tone = "primary", validation_level = "normal", hovered = false, pressed = false, focused = true, selected = true, checked = false, disabled = false, open = false, popup_open = false, corner_radius = 4, border_width = 2, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
style = { self = { background = { color = "material.surface_inset" }, foreground = { color = "material.text" }, border = { color = "material.focus_ring", width = 2.0, radius = 10.0 } } }
layout = { width = { min = 56.0, preferred = 64.0, max = 82.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.field_filled_helper]
component = "TextField"
control_id = "text-fields_FilledHelper"
classes = ["material-control", "material-text-field", "material-text-field-filled"]
props = { label = "Count", value = "42", value_text = "42", placeholder = "Count", helper_text = "Helper", variant = "filled", surface_variant = "elevated", button_variant = "contained", text_tone = "primary", validation_level = "normal", hovered = true, pressed = false, focused = false, selected = false, checked = false, disabled = false, open = false, popup_open = false, corner_radius = 4, border_width = 1, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
style = { self = { background = { color = "material.surface_hover" }, foreground = { color = "material.text" }, border = { color = "$editor.accent", width = 1.0, radius = 10.0 } } }
layout = { width = { min = 44.0, preferred = 52.0, max = 70.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.field_standard]
component = "InputField"
control_id = "text-fields_Standard"
classes = ["material-control", "material-text-field", "material-text-field-standard"]
props = { label = "Value", value = "std", value_text = "std", placeholder = "Value", helper_text = "Underline", variant = "standard", surface_variant = "elevated", button_variant = "contained", text_tone = "primary", validation_level = "normal", hovered = false, pressed = false, focused = false, selected = false, checked = false, disabled = false, open = false, popup_open = false, corner_radius = 0.0, border_width = 1.0, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
style = { self = { background = { color = "material.surface" }, foreground = { color = "material.text" }, border = { color = "material.outline", width = 1.0, radius = 0.0 } } }
layout = { width = { min = 44.0, preferred = 52.0, max = 70.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.field_error]
component = "TextField"
control_id = "text-fields_Error"
classes = ["material-control", "material-text-field", "material-text-field-error"]
props = { label = "Slug", value = "bad", value_text = "bad", placeholder = "Slug", helper_text = "Required", variant = "outlined", surface_variant = "elevated", button_variant = "contained", text_tone = "error", validation_level = "error", hovered = false, pressed = false, focused = false, selected = false, checked = false, disabled = false, open = false, popup_open = false, corner_radius = 4, border_width = 1, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
style = { self = { background = { color = "material.error" }, foreground = { color = "material.text" }, border = { color = "material.error", width = 1.0, radius = 10.0 } } }
layout = { width = { min = 44.0, preferred = 52.0, max = 70.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.field_disabled]
component = "TextField"
control_id = "text-fields_Disabled"
classes = ["material-control", "material-text-field", "material-text-field-disabled"]
props = { label = "State", value = "Lock", value_text = "Lock", placeholder = "Disabled", helper_text = "No edit", variant = "outlined", surface_variant = "elevated", button_variant = "contained", text_tone = "disabled", validation_level = "normal", hovered = false, pressed = false, focused = false, selected = false, checked = false, disabled = true, open = false, popup_open = false, corner_radius = 4, border_width = 1, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
style = { self = { background = { color = "material.disabled" }, foreground = { color = "material.text_disabled" }, border = { color = "material.outline", width = 1.0, radius = 10.0 }, opacity = 0.38 } }
layout = { width = { min = 48.0, preferred = 56.0, max = 74.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.state_strip]
component = "GridBox"
control_id = "text_fields_StateStrip"
classes = ["material-lab-state-strip"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 108, "preferred" = 108, "max" = 108, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 4, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "state_default" },
  { node = "state_hover" },
  { node = "state_pressed" },
  { node = "state_focus" },
  { node = "state_disabled" },
  { node = "state_selected" },
  { node = "state_open" },
  { node = "state_error" },
]
[nodes.state_default]
component = "WorkbenchCaption"
control_id = "text_fields_StateDefault"
classes = ["material-lab-state-pill", "material-lab-state-default"]
props = { "text" = "Default", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = false, "checked" = false, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
