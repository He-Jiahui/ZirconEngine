classes = ["material-lab-state-pill", "material-lab-state-selected"]
props = { "text" = "Selected", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = true, "checked" = true, "disabled" = false, "open" = false, "popup_open" = false, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.state_open]
component = "WorkbenchCaption"
control_id = "text_fields_StateOpen"
classes = ["material-lab-state-pill", "material-lab-state-open"]
props = { "text" = "Open", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "button_variant" = "text", "validation_level" = "normal", "hovered" = false, "pressed" = false, "focused" = false, "selected" = true, "checked" = false, "disabled" = false, "open" = true, "popup_open" = true, "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
