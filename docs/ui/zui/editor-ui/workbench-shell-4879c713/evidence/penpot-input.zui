[asset]
kind = "view"
id = "res://ui/editor/host/workbench_shell.zui"
version = 2
display_name = "workbench shell"

[root]
node = "host"

[imports]
widgets = []
styles = []

[nodes.host]
component = "UiHostWindow"
control_id = "UiHostWindowRoot"
pixel_snapping = "disabled"
classes = [ "editor-workbench", "workbench-shell-root" ]

[nodes.host.layout]
clip = true

[nodes.host.layout.container]
kind = "Overlay"

[nodes.host.layout.width]
stretch = "Stretch"

[nodes.host.layout.height]
stretch = "Stretch"

[[nodes.host.events]]
id = "UiHostWindow/ActivateMainPage"
event = "Change"
route = "workbench.dock.activate_main_page"

[[nodes.host.children]]
