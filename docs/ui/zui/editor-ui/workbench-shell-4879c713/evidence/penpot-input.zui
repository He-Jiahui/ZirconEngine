penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/host/workbench_shell.zui\"\nversion = 2\ndisplay_name = \"workbench shell\"\n\n[root]\nnode = \"host\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_rail_button.zui#WorkbenchRailButton\",\n  \"res://ui/editor/components/workbench/primitives/feedback/workbench_status_item.zui#WorkbenchStatusItem\",\n]\nstyles = [\"res://ui/theme/editor_workbench_spatial.zui\"]\n\n[nodes.host]\ncomponent = \"UiHostWindow\"\ncontrol_id = \"UiHostWindowRoot\"\npixel_snapping = \"disabled\"\nclasses = [\"editor-workbench\", \"workbench-shell-root\"]\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"UiHostWindow/ActivateMainPage\", event = \"Change\", route = \"workbench.dock.activate_main_page\" }]\nchildren = [\n  { node = \"scaffold\" },\n  { node = \"left_drawer_shell\" },\n  { node = \"right_drawer_shell\" },\n  { node = \"bottom_drawer_shell\" },\n]\n\n[nodes.scaffold]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchScaffold\"\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"menu_bar\" },\n  { node = \"host_page_strip\" },\n  { node = \"host_page_separator\" },\n  { node = \"body\" },\n  { node = \"status_bar\" },\n]\n\n[nodes.menu_bar]\ncomponent = \"UiHostToolbar\"\ncontrol_id = \"WorkbenchMenuBarRoot\"\nclasses = [\"workbench-topbar\"]\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\nchildren = [{ node = \"open_project\" }, { node = \"save_project\" }, { node = \"reset_layout\" }]\n\n[nodes.open_project]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"OpenProject\"\nclasses = [\"workbench-toolbar-button\"]\nprops = { icon = \"editor_pages/workbench/menu/open-project.svg\", label = \"Open\", selected = false, focused = false, hovered = false, pressed = false, disabled = false, surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\" }\nlayout = { width = { min = \"$editor.density.toolbar_action_width\", preferred = \"$editor.density.toolbar_action_width\", max = \"$editor.density.toolbar_action_width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WorkbenchMenuBar/OpenProject\", event = \"Click\", action = { action = \"file.project.open\" } }]\n\n[nodes.save_project]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"SaveProject\"\nclasses = [\"workbench-toolbar-button\"]\nprops = { icon = \"editor_pages/workbench/menu/save-all.svg\", label = \"Save\", selected = false, focused = false, hovered = false, pressed = false, disabled = false, surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\" }\nlayout = { width = { min = \"$editor.density.toolbar_action_width\", preferred = \"$editor.density.toolbar_action_width\", max = \"$editor.density.toolbar_action_width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WorkbenchMenuBar/SaveProject\", event = \"Click\", action = { action = \"file.project.save\" } }]\n\n[nodes.reset_layout]\ncomponent = \"WorkbenchIconButton\"\ncontrol_id = \"ResetLayout\"\nclasses = [\"workbench-toolbar-button\"]\nprops = { icon = \"editor_pages/workbench/dock/reset-layout.svg\", label = \"Reset Layout\", selected = false, focused = false, hovered = false, pressed = false, disabled = false, surface_variant = \"inset\", border_width = \"$editor.control.border_width\", corner_radius = \"$editor.control.radius.control\" }\nlayout = { width = { min = \"$editor.density.toolbar_wide_action_width\", preferred = \"$editor.density.toolbar_wide_action_width\", max = \"$editor.density.toolbar_wide_action_width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"WorkbenchMenuBar/ResetLayout\", event = \"Click\", action = { action = \"window.layout.reset\" } }]\n\n[nodes.host_page_strip]\ncomponent = \"Container\"\ncontrol_id = \"HostPageStripRoot\"\nclasses = [\"workbench-strip\"]\nlayout = { clip = true, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\n\n[nodes.host_page_separator]\ncomponent = \"Container\"\ncontrol_id = \"HostPageStripSeparator\"\nclasses = [\"workbench-divider\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.border_width\", preferred = \"$editor.control.border_width\", max = \"$editor.control.border_width\", stretch = \"Fixed\" } }\n\n[nodes.body]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"WorkbenchBody\"\nlayout = { container = { kind = \"HorizontalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"activity_rail\" }, { node = \"document_host\" }]\n\n[nodes.activity_rail]\ncomponent = \"ActivityRail\"\ncontrol_id = \"ActivityRailRoot\"\nclasses = [\"workbench-rail\"]\nlayout = { clip = true, container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"hierarchy_toggle\" }, { node = \"assets_toggle\" }, { node = \"con