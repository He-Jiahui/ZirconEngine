workbench_segmented = "$editor.surface.2"
workbench_selection_label = "$editor.text.secondary"
workbench_selection_mark = "$editor.surface.1"
workbench_selection_mark_border = "$editor.separator.strong"
workbench_checkbox_checked = "$editor.surface.selected"
workbench_radio_checked = "$editor.surface.selected"
workbench_radio_checked_border = "$editor.accent"
workbench_toggle_track = "$editor.track"
workbench_toggle_track_border = "$editor.border"
workbench_toggle_thumb = "$editor.text.secondary"
workbench_toggle_checked_track = "$editor.surface.selected"
workbench_toggle_checked_border = "$editor.accent"
workbench_toggle_checked_thumb = "$editor.text.secondary"
workbench_warning_surface = "$editor.semantic.warning.container"
workbench_error_surface = "$editor.semantic.error.container"
workbench_success_surface = "$editor.semantic.success.container"
workbench_info_surface = "$editor.semantic.info.container"

[penpot_original_imports]
widgets = [ "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField", "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow" ]
styles = [ "res://ui/theme/editor_workbench_strict.zui" ]

[penpot_field_icons]
search = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Search\">\n  <circle cx=\"10.5\" cy=\"10.5\" r=\"5.4\" fill=\"none\" stroke=\"#cbd2dc\" stroke-width=\"1.8\"/>\n  <path fill=\"none\" stroke=\"#cbd2dc\" stroke-linecap=\"round\" stroke-width=\"1.9\" d=\"m14.5 14.5 4.5 4.5\"/>\n</svg>\n"
clear = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"512\" height=\"512\" viewBox=\"0 0 512 512\"><line x1=\"368\" y1=\"368\" x2=\"144\" y2=\"144\" style=\"fill:none;stroke:#000;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px\"/><line x1=\"368\" y1=\"144\" x2=\"144\" y2=\"368\" style=\"fill:none;stroke:#000;stroke-linecap:round;stroke-linejoin:round;stroke-width:32px\"/></svg>"
stepper = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" role=\"img\" aria-label=\"Field stepper\">\n  <path fill=\"none\" stroke=\"#cbd2dc\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" d=\"m7 9 5-5 5 5M7 15l5 5 5-5\"/>\n</svg>\n"
