[asset]
kind = "view"
id = "res://ui/editor/inspector.zui"
version = 2
display_name = "Inspector"

[imports]
widgets = []
styles = []

[root]
node = "inspector_root"

[nodes.header_panel]
component = "Overlay"
control_id = "InspectorHeaderPanel"

[nodes.header_panel.props]
text = "Inspector"
surface_variant = "transparent"
radius = 0
border_width = 0
text_tone = "default"
font_weight = "$editor.typography.strong.weight"
layout_padding_left = "$editor.density.gap.medium"
layout_padding_right = "$editor.density.gap.medium"
overflow = "elide"

[nodes.header_panel.layout]
clip = true

[nodes.header_panel.layout.container]
kind = "Overlay"

[nodes.header_panel.layout.width]
stretch = "Stretch"

[nodes.header_panel.layout.height]
min = "$editor.density.row_height"
preferred = "$editor.density.row_height"
max = "$editor.density.row_height"
stretch = "Fixed"

[nodes.header_name_gap]
component = "Space"

[nodes.header_name_gap.layout.width]
stretch = "Stretch"

[nodes.header_name_gap.layout.height]
min = "$editor.density.gap.small"
preferred = "$editor.density.gap.small"
max = "$editor.density.gap.small"
stretch = "Fixed"

[nodes.name_row]
component = "PropertyRow"
control_id = "InspectorNameRow"
classes = [ "workbench-property-editor-row", "workbench-composite" ]
events = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow"

[nodes.name_row.props]
text = "Name"

[nodes.name_row.layout]
clip = true

[nodes.name_row.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.small"

[nodes.name_row.layout.width]
stretch = "Stretch"

[nodes.name_row.layout.height]
min = "$editor.density.row_height"
preferred = "$editor.density.row_height"
max = "$editor.density.row_height"
stretch = "Fixed"

[[nodes.name_row.children]]
node = "name_row__name_column"

[[nodes.name_row.children]]
node = "name_value"

[nodes.name_row.children.slot]
name = "value"

[nodes.name_row.children.slot.layout.width]
stretch = "Stretch"

[nodes.name_row.children.slot.layout.height]
stretch = "Stretch"

[nodes.name_row.state]
[nodes.name_row.style.self]
[nodes.name_row.style.slot]
[nodes.name_row.slots]
[nodes.name_value]
component = "InputField"
control_id = "InspectorNameValue"
classes = [ "workbench-field", "workbench-primitive", "workbench-component-field" ]
events = []
children = []
penpot_prefab_source = "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField"

[nodes.name_value.props]
value = "-"
placeholder = ""
validation_level = "normal"
focused = false
hovered = false
disabled = false
editable_text = false
background_color = "$editor.surface.recessed"
hover_background_color = "$editor.surface.hover"
pressed_background_color = "$editor.surface.3"
focused_background_color = "$editor.surface.recessed"
disabled_background_color = "$editor.surface.disabled"
border_color = "$editor.separator.soft"
hover_border_color = "$editor.border"
focus_border_color = "$editor.focus.ring"
disabled_border_color = "$editor.border.disabled"
foreground_color = "$editor.text.primary"
placeholder_color = "$editor.text.secondary"
disabled_foreground_color = "$editor.text.disabled"
border_width = "$editor.control.border_width"
corner_radius = "$editor.control.radius.control"
font_size = "$editor.typography.body.size"
line_height_ratio = "$editor.typography.line_height"
layout_padding_left = "$editor.density.gap.medium"
layout_padding_right = "$editor.density.gap.medium"
layout_padding_top = "$editor.density.gap.small"
layout_padding_bottom = "$editor.density.gap.small"
layout_min_height = "$editor.control.height.dense"
input_interactive = false
input_clickable = false
input_hoverable = false
input_focusable = false

[nodes.name_value.layout.width]
stretch = "Stretch"

[nodes.name_value.layout.height]
min = "$editor.density.row_height"
preferred = "$editor.density.row_height"
max = "$editor.density.row_height"
stretch = "Stretch"

[nodes.name_value.state]
[nodes.name_value.style.self]
[nodes.name_value.style.slot]
[nodes.name_value.slots]
