penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/theme/editor_workbench_strict.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_field.zui", "zircon_editor/assets/ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui", "zircon_editor/assets/icons/zircon_editor_shell/controls/search.svg", "zircon_editor/assets/icons/ionicons/close-outline.svg", "zircon_editor/assets/icons/zircon_editor_shell/controls/field-stepper.svg" ]
penpot_original_source = "stylesheets = []\n\n[asset]\nkind = \"view\"\nid = \"res://ui/editor/inspector.zui\"\nversion = 2\ndisplay_name = \"Inspector\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n]\nstyles = [\"res://ui/theme/editor_workbench_strict.zui\"]\n\n[root]\nnode = \"inspector_root\"\n\n[nodes.header_panel]\ncomponent = \"Overlay\"\ncontrol_id = \"InspectorHeaderPanel\"\nprops = { text = \"Inspector\", surface_variant = \"transparent\", radius = 0.0, border_width = 0.0, text_tone = \"default\", font_weight = \"$editor.typography.strong.weight\", layout_padding_left = \"$editor.density.gap.medium\", layout_padding_right = \"$editor.density.gap.medium\", overflow = \"elide\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\n\n[nodes.header_name_gap]\ncomponent = \"Space\"\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.gap.small\", preferred = \"$editor.density.gap.small\", max = \"$editor.density.gap.small\", stretch = \"Fixed\" } }\n\n[nodes.name_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"InspectorNameRow\"\nprops = { text = \"Name\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"name_value\", slot = { name = \"value\" } }]\n\n[nodes.name_value]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"InspectorNameValue\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"-\", editable_text = false, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\n\n[nodes.parent_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"InspectorParentRow\"\nprops = { text = \"Parent\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"parent_value\", slot = { name = \"value\" } }]\n\n[nodes.parent_value]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"InspectorParentValue\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"-\", editable_text = false, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\n\n[nodes.position_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"InspectorPositionRow\"\nprops = { text = \"Position\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"position_value\", slot = { name = \"value\" } }]\n\n[nodes.position_value]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"InspectorPositionValue\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"-\", editable_text = false, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\n\n[nodes.separator_row]\ncomponent = \"Space\"\ncontrol_id = \"InspectorSeparatorRow\"\nclasses = [\"workbench-divider\"]\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = \"Fixed\" } }\n\n[nodes.actions_row]\ncomponent = \"WorkbenchPropertyEditorRow\"\ncontrol_id = \"InspectorActionsRow\"\nprops = { text = \"Components\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\nchildren = [{ node = \"components_value\", slot = { name = \"value\" } }]\n\n[nodes.components_value]\ncomponent = \"WorkbenchField\"\ncontrol_id = \"InspectorComponentsValue\"\nclasses = [\"workbench-field\", \"workbench-component-field\"]\nprops = { value = \"-\", editable_text = false, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.density.row_height\", preferred = \"$editor.density.row_height\", max = \"$editor.density.row_height\", stretch = \"Fixed\" } }\n\n[nodes.empty_state_message]\ncomponent = \"Label\"\ncontrol_id = \"InspectorEmptyStateMessage\"\nprops = { text = \"\", text_tone = \"muted\", text_align = \"center\", overflow = \"elide\" }\nlayout = { anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.5 }, position = { x = 0.0, y = 0.0 }, width = { stretch = \"Stretch\" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = \"Fixed\" } }\n\n[nodes.bottom_fill]\ncomponent = \"Overlay\"\ncontrol_id = \"InspectorEmptyState\"\nprops = { surface_variant = \"transparent\", radius = 0.0, border_width = 0.0 }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"empty_state_message\" }]\n\n[nodes.inspector_scroll_body]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"InspectorScrollBody\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"name_row\" }, { node = \"parent_row\" }, { node = \"position_row\" }, { node = \"separator_row\" }, { node = \"actions_row\" }]\n\n[nodes.body_overlay]\ncomponent = \"Overlay\"\ncontrol_id = \"InspectorBodyOverlay\"\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"inspector_scroll_body\" },\n  { node = \"bottom_fill\", slot = { layout = { alignment = { horizontal = \"Fill\", vertical = \"Fill\" }, z_order = 10 } } },\n]\n\n[nodes.inspector_root]\ncomponent = \"VerticalBox\"\ncontrol_id = \"InspectorRoot\"\nclasses = [\"workbench-shell-root\"]\npixel_snapping = \"disabled\"\nlayout = { container = { kind = \"VerticalBox\", gap = 0.0 }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"header_panel\" }, { node = \"header_name_gap\" }, { node = \"body_overlay\" }]\n"

