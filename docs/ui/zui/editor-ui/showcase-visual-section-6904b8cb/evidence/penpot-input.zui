penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui" ]
penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/showcase/showcase_visual_section.zui\"\nversion = 2\ndisplay_name = \"Showcase Visual Section\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[components.ShowcaseVisualSection]\nroot = \"visual_section_root\"\ndefault_classes = [\"showcase-panel\", \"material-surface\"]\n\n[nodes.section_title]\ncomponent = \"Label\"\ncontrol_id = \"ComponentShowcaseVisualSectionTitle\"\nclasses = [\"showcase-section-title\"]\nprops = { text = \"Visual and Feedback\", font_size = \"$editor.typography.body.size\", font_weight = \"$editor.typography.emphasis.weight\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.label_demo]\ncomponent = \"Label\"\ncontrol_id = \"LabelDemo\"\nprops = { text = \"Label, rich label, badge, icon, SVG icon and progress primitives\", wrap = \"word\", text_overflow = \"clip\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" } }\n\n[nodes.rich_label_demo]\ncomponent = \"RichLabel\"\ncontrol_id = \"RichLabelDemo\"\nprops = { text = \"RichLabel: supports emphasized inspector copy\", wrap = \"word\", text_overflow = \"clip\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" } }\n\n[nodes.image_demo]\ncomponent = \"Image\"\ncontrol_id = \"ImageDemo\"\nclasses = [\"showcase-field\"]\nprops = { value = \"ui/editor/showcase_checker.svg\", image = \"ui/editor/showcase_checker.svg\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = \"Fixed\" } }\n\n[nodes.icon_demo]\ncomponent = \"Icon\"\ncontrol_id = \"IconDemo\"\nclasses = [\"showcase-field\"]\nprops = { value = \"ionicons/options-outline.svg\", icon = \"options-outline\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = \"Fixed\" } }\n\n[nodes.svg_icon_demo]\ncomponent = \"SvgIcon\"\ncontrol_id = \"SvgIconDemo\"\nclasses = [\"showcase-field\"]\nprops = { source = \"ionicons/options-outline.svg\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = \"Fixed\" } }\n\n[nodes.separator_demo]\ncomponent = \"Separator\"\ncontrol_id = \"SeparatorDemo\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Separator\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 12.0, preferred = 12.0, max = 12.0, stretch = \"Fixed\" } }\n\n[nodes.progress_demo]\ncomponent = \"ProgressBar\"\ncontrol_id = \"ProgressBarDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { value = 0.62, indeterminate = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.skeleton_demo]\ncomponent = \"Skeleton\"\ncontrol_id = \"SkeletonDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { text = \"Skeleton\", variant = \"rounded\", animation = \"wave\", width = 180.0, height = 20.0, with_children = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.spinner_demo]\ncomponent = \"Spinner\"\ncontrol_id = \"SpinnerDemo\"\nclasses = [\"showcase-field\", \"material-control\"]\nprops = { text = \"Spinner\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = \"Fixed\" } }\n\n[nodes.badge_demo]\ncomponent = \"Badge\"\ncontrol_id = \"BadgeDemo\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Badge / Tag\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 22.0, preferred = 22.0, max = 22.0, stretch = \"Fixed\" } }\n\n[nodes.help_row_demo]\ncomponent = \"HelpRow\"\ncontrol_id = \"HelpRowDemo\"\nclasses = [\"showcase-field\"]\nprops = { text = \"Help row with inline validation guidance\", validation_level = \"warning\", validation_message = \"review\", wrap = \"word\", text_overflow = \"clip\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = \"Fixed\" } }\n\n[nodes.dialog_demo]\ncomponent = \"Dialog\"\ncontrol_id = \"DialogDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { open = true, popup_open = true, title = \"Scene Settings\", text = \"Scene Settings\", message = \"Review scene-level settings before applying them.\", action = \"Apply\", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 190.0, preferred = 190.0, max = 190.0, stretch = \"Fixed\" } }\n\n[nodes.confirm_dialog_demo]\ncomponent = \"ConfirmDialog\"\ncontrol_id = \"ConfirmDialogDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { open = true, popup_open = true, title = \"Delete selected prefab?\", text = \"Delete selected prefab?\", message = \"This removes the prefab reference from the scene.\", confirm_text = \"Delete\", cancel_text = \"Cancel\", severity = \"error\", validation_level = \"error\", destructive = true, confirm_enabled = false, requires_explicit_action = true, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 210.0, preferred = 210.0, max = 210.0, stretch = \"Fixed\" } }\n\n[nodes.command_palette_demo]\ncomponent = \"CommandPalette\"\ncontrol_id = \"CommandPaletteDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { open = true, popup_open = true, query = \"build\", placeholder = \"Search commands\", command_source = \"workbench\", commands = [\"open_scene|label=Open Scene|shortcut=Ctrl+O\", \"build_project|label=Build Project|shortcut=Ctrl+B\", \"toggle_console|label=Toggle Console|shortcut=Ctrl+`\"], filtered_commands = [\"build_project\"], recent_commands = [\"build_project\"], empty_text = \"No commands found\", selected_command_id = \"build_project\", focused_index = 0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 176.0, preferred = 176.0, max = 176.0, stretch = \"Fixed\" } }\n\n[nodes.notification_center_demo]\ncomponent = \"NotificationCenter\"\ncontrol_id = \"NotificationCenterDemo\"\nclasses = [\"showcase-field\", \"material-control\", \"material-outlined-field\"]\nprops = { open = true, popup_open = true, title = \"Notifications\", unread_count = 2, notifications = [\"build|title=Build failed|message=Shader compile error|severity=error|unread=true\", \"asset|title=Asset import complete|message=StoneWall.mesh ready|severity=success|unread=true\", \"source|title=Source control synced|message=No local conflicts|severity=info|unread=false\"], empty_text = \"No notifications\", selected_notification_id = \"build\", focused_index = 1, visible_limit = 2, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 172.0, preferred = 172.0, max = 172.0, stretch = \"Fixed\" } }\n\n[nodes.visual_section_root]\ncomponent = \"ScrollableBox\"\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { min = 0.0, stretch = \"Stretch\" }, height = { min = 0.0, stretch = \"Stretch\" } }\nchildren = [\n  { node = \"section_title\" },\n  { node = \"label_demo\", slot = { name = \"content\" } },\n  { node = \"rich_label_demo\", slot = { name = \"content\" } },\n  { node = \"image_demo\", slot = { name = \"content\" } },\n  { node = \"icon_demo\", slot = { name = \"content\" } },\n  { node = \"svg_icon_demo\", slot = { name = \"content\" } },\n  { node = \"separator_demo\", slot = { name = \"content\" } },\n  { node = \"progress_demo\", slot = { name = \"content\" } },\n  { node = \"skeleton_demo\", slot = { name = \"content\" } },\n  { node = \"spinner_demo\", slot = { name = \"content\" } },\n  { node = \"badge_demo\", slot = { name = \"content\" } },\n  { node = \"help_row_demo\", slot = { name = \"content\" } },\n  { node = \"dialog_demo\", slot = { name = \"content\" } },\n  { node = \"confirm_dialog_demo\", slot = { name = \"content\" } },\n  { node = \"command_palette_demo\", slot = { name = \"content\" } },\n  { node = \"notification_center_demo\", slot = { name = \"content\" } },\n]\n"

