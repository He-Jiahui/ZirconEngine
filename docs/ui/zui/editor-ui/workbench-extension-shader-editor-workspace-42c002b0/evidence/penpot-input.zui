penpot_original_source = "[asset]\r\nkind = \"component\"\r\nid = \"res://ui/editor/components/workbench/modules/extensions/rendering/workbench_extension_shader_editor_workspace.zui\"\r\nversion = 2\r\ndisplay_name = \"Workbench Extension Shader Editor Workspace\"\r\n\r\n[imports]\r\nwidgets = [\r\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\r\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\r\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\r\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\r\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\r\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\r\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\r\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\r\n]\r\nstyles = []\r\n[components.WorkbenchExtensionShaderEditorWorkspace]\r\nroot = \"shader_editor_workspace\"\r\ndefault_classes = [\"workbench-module-body\", \"workbench-extension-module-body\"]\r\n\r\n[nodes.shader_editor_workspace]\r\ncomponent = \"Overlay\"\r\ncontrol_id = \"WorkbenchExtensionShaderEditorWorkspace\"\r\nclasses = [\"workbench-module-body\", \"workbench-extension-module-body\"]\r\nprops = { visibility = \"collapsed\" }\r\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [\r\n  { node = \"shader_workspace_main\" },\r\n  { node = \"shader_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\r\n]\r\n\r\n[nodes.shader_workspace_main]\r\ncomponent = \"HorizontalGroup\"\r\nclasses = [\"workbench-module-layout-main\"]\r\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"shader_rail_gap\" }, { node = \"shader_left\" }, { node = \"shader_center\" }, { node = \"shader_right_reserve\" }]\r\n\r\n[nodes.shader_right_reserve]\r\ncomponent = \"Container\"\r\nclasses = [\"workbench-module-details-reserve\"]\r\nprops = { responsive_min_tier = \"wide\" }\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n[nodes.shader_rail_gap]\r\ncomponent = \"Container\"\r\ncontrol_id = \"WorkbenchExtensionShaderRailGap\"\r\nprops = { responsive_min_tier = \"narrow\" }\r\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.shader_left]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchExtensionShaderLeftPanel\"\r\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\r\nprops = { responsive_min_tier = \"narrow\" }\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"shader_title\" }, { node = \"shader_left_content\" }]\r\n\r\n[nodes.shader_left_content]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchExtensionShaderLeftContent\"\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"shader_source_row\" }, { node = \"shader_include_row\" }, { node = \"shader_permutation_row\" }]\r\n\r\n[nodes.shader_title]\r\ncomponent = \"WorkbenchSectionTitle\"\r\ncontrol_id = \"WorkbenchExtensionShaderTitle\"\r\nprops = { text = \"Shader Editor\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.shader_source_row]\r\ncomponent = \"WorkbenchListRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderSourceRow\"\r\nclasses = [\"workbench-list-row\", \"workbench-row-selected\"]\r\nprops = { text = \"lighting.wgsl\", icon = \"code\", selected = true }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/ShaderEditorSourceRow\", event = \"Click\", route = \"workbench.extension.shader_editor.source_file\" }]\r\n\r\n[nodes.shader_include_row]\r\ncomponent = \"WorkbenchListRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderIncludeRow\"\r\nclasses = [\"workbench-list-row\"]\r\nprops = { text = \"common.wgsl\", icon = \"file\", selected = false }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/ShaderEditorIncludeRow\", event = \"Click\", route = \"workbench.extension.shader_editor.include\" }]\r\n\r\n[nodes.shader_permutation_row]\r\ncomponent = \"WorkbenchListRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderPermutationRow\"\r\nclasses = [\"workbench-list-row\"]\r\nprops = { text = \"Permutation_SM5\", icon = \"grid\", selected = false }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/ShaderEditorPermutationRow\", event = \"Click\", route = \"workbench.extension.shader_editor.permutation\" }]\r\n\r\n[nodes.shader_center]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchExtensionShaderCenterPanel\"\r\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"shader_center_header\" }, { node = \"shader_compile_table\" }, { node = \"shader_output\" }]\r\n\r\n[nodes.shader_center_header]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchExtensionShaderCenterHeader\"\r\nclasses = [\"workbench-panel-toolbar\"]\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Never\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\r\nchildren = [{ node = \"shader_center_title\" }, { node = \"shader_header_fill\" }, { node = \"shader_preview_button\" }, { node = \"shader_compile_button\" }]\r\n\r\n[nodes.shader_center_title]\r\ncomponent = \"WorkbenchSectionTitle\"\r\ncontrol_id = \"WorkbenchExtensionShaderCenterTitle\"\r\nprops = { text = \"Shader Compile Workspace\" }\r\nlayout = { width = { min = 220.0, preferred = 220.0, max = 260.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.shader_header_fill]\r\ncomponent = \"Container\"\r\ncontrol_id = \"WorkbenchExtensionShaderHeaderFill\"\r\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.shader_preview_button]\r\ncomponent = \"WorkbenchButton\"\r\ncontrol_id = \"WorkbenchExtensionShaderPreviewButton\"\r\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\r\nprops = { text = \"Preview\", button_variant = \"outlined\", button_color = \"secondary\" }\r\nlayout = { width = { min = 78, preferred = 78, max = 88, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/ShaderEditorPreview\", event = \"Click\", route = \"workbench.extension.shader_editor.preview\" }]\r\n\r\n[nodes.shader_compile_button]\r\ncomponent = \"WorkbenchButton\"\r\ncontrol_id = \"WorkbenchExtensionShaderCompileButton\"\r\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\r\nprops = { text = \"Compile\", button_variant = \"filled\", button_color = \"accent\" }\r\nlayout = { width = { min = 82, preferred = 82, max = 92, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/ShaderEditorCompile\", event = \"Click\", route = \"workbench.extension.shader_editor.compile\" }]\r\n\r\n[nodes.shader_compile_table]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchExtensionShaderCompileTable\"\r\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"shader_vertex_row\" }, { node = \"shader_fragment_row\" }, { node = \"shader_compute_row\" }, { node = \"shader_common_row\" }]\r\n\r\n[nodes.shader_vertex_row]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderVertexRow\"\r\nclasses = [\"workbench-table-row\"]\r\nprops = { text = \"Vertex\", value_text = \"vs_main   Camera   Ready\", selected = false, options = [\"Vertex\",\"vs_main\",\"Camera\",\"Ready\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/ShaderEditorVertexRow\", event = \"Click\", route = \"workbench.extension.shader_editor.stage.vertex\" }]\r\n\r\n[nodes.shader_fragment_row]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderFragmentRow\"\r\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\r\nprops = { text = \"Fragment\", value_text = \"fs_main   GBuffer   Selected\", selected = true, options = [\"Fragment\",\"fs_main\",\"GBuffer\",\"Selected\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/ShaderEditorFragmentRow\", event = \"Click\", route = \"workbench.extension.shader_editor.stage.fragment\" }]\r\n\r\n[nodes.shader_compute_row]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderComputeRow\"\r\nclasses = [\"workbench-table-row\"]\r\nprops = { text = \"Compute\", value_text = \"cs_tile   Lighting   Warning\", options = [\"Compute\",\"cs_tile\",\"Lighting\",\"Warning\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/ShaderEditorComputeRow\", event = \"Click\", route = \"workbench.extension.shader_editor.stage.compute\" }]\r\n\r\n[nodes.shader_common_row]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderCommonRow\"\r\nclasses = [\"workbench-table-row\"]\r\nprops = { text = \"Include\", value_text = \"common   BRDF   Ready\", options = [\"Include\",\"common\",\"BRDF\",\"Ready\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\r\nevents = [{ id = \"WorkbenchExtension/ShaderEditorCommonRow\", event = \"Click\", route = \"workbench.extension.shader_editor.include.common\" }]\r\n\r\n[nodes.shader_output]\r\ncomponent = \"WorkbenchTableRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderOutputRow\"\r\nclasses = [\"workbench-table-row\"]\r\nprops = { text = \"Compiler\", value_text = \"3 warnings   0 errors   0.31 ms\", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, options = [\"Compiler\",\"3 warnings\",\"0 errors\",\"0.31 ms\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.shader_right]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchExtensionShaderRightPanel\"\r\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\r\nprops = { responsive_min_tier = \"wide\", responsive_compact_drawer = \"module_details\" }\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"shader_details_title\" }, { node = \"shader_right_content\" }]\r\n\r\n[nodes.shader_right_content]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"WorkbenchExtensionShaderRightContent\"\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"shader_target_dropdown_property_row\" }, { node = \"shader_entry_field_property_row\" }, { node = \"shader_live_compile_dropdown_property_row\" }]\r\n\r\n[nodes.shader_details_title]\r\ncomponent = \"WorkbenchSectionTitle\"\r\ncontrol_id = \"WorkbenchExtensionShaderDetailsTitle\"\r\nprops = { text = \"Details\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\r\n\r\n[nodes.shader_target_dropdown_property_row]\r\ncomponent = \"WorkbenchPropertyEditorRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderTargetDropdownPropertyRow\"\r\nprops =