\n\r\n[nodes.shader_live_compile_dropdown_property_row]\r\ncomponent = \"WorkbenchPropertyEditorRow\"\r\ncontrol_id = \"WorkbenchExtensionShaderLiveCompileDropdownPropertyRow\"\r\nprops = { text = \"Live Compile\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\r\nchildren = [{ node = \"shader_live_compile_dropdown\", slot = { name = \"value\" } }]\r\n\r\n[nodes.shader_live_compile_dropdown]\r\ncomponent = \"WorkbenchDropdown\"\r\ncontrol_id = \"WorkbenchExtensionShaderLiveCompileDropdown\"\r\nclasses = [\"workbench-dropdown\", \"workbench-component-dropdown\"]\r\nprops = { value_text = \"On\", value = \"on\", options = [\"on|label=On\", \"paused|label=Paused\", \"manual|label=Manual\"] }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32, preferred = 32, max = 32, stretch = \"Fixed\" } }\r\nevents = [\r\n  { id = \"WorkbenchExtension/ShaderEditorLiveCompileEdit\", event = \"Change\", route = \"workbench.extension.shader_editor.live_compile.edit\" },\r\n  { id = \"WorkbenchExtension/ShaderEditorLiveCompileCommit\", event = \"Submit\", route = \"workbench.extension.shader_editor.live_compile.commit\" },\r\n]\r\n"

[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/rendering/workbench_extension_shader_editor_workspace.zui"
version = 2
display_name = "Workbench Extension Shader Editor Workspace"

[imports]
widgets = []
styles = []

[components.WorkbenchExtensionShaderEditorWorkspace]
root = "shader_editor_workspace"
default_classes = [ "workbench-module-body", "workbench-extension-module-body" ]

[nodes.shader_editor_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionShaderEditorWorkspace"
classes = [ "workbench-module-body", "workbench-extension-module-body" ]

[nodes.shader_editor_workspace.props]
visibility = "visible"

[nodes.shader_editor_workspace.layout]
clip = true

[nodes.shader_editor_workspace.layout.container]
kind = "Overlay"

[nodes.shader_editor_workspace.layout.width]
stretch = "Stretch"

[nodes.shader_editor_workspace.layout.height]
stretch = "Stretch"

[[nodes.shader_editor_workspace.children]]
node = "shader_workspace_main"

[[nodes.shader_editor_workspace.children]]
node = "shader_right"

[nodes.shader_editor_workspace.children.slot.layout]
z_order = 20

[nodes.shader_editor_workspace.children.slot.layout.alignment]
horizontal = "End"
vertical = "Fill"

[nodes.shader_workspace_main]
component = "HorizontalGroup"
classes = [ "workbench-module-layout-main" ]

[nodes.shader_workspace_main.layout]
