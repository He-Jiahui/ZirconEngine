[nodes.shader_workspace_main.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.medium"

[nodes.shader_workspace_main.layout.width]
stretch = "Stretch"

[nodes.shader_workspace_main.layout.height]
stretch = "Stretch"

[[nodes.shader_workspace_main.children]]
