penpot_original_source = "[asset]\nkind = \"component\"\nid = \"res://ui/editor/components/workbench/modules/extensions/production/workbench_extension_build_export_workspace.zui\"\nversion = 2\ndisplay_name = \"Workbench Extension Build Export Workspace\"\n\n[imports]\nwidgets = [\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown\",\n  \"res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow\",\n  \"res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle\",\n  \"res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow\",\n  \"res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow\",\n]\nstyles = []\n\n[components.WorkbenchExtensionBuildExportWorkspace]\nroot = \"build_export_workspace\"\ndefault_classes = [\"workbench-module-body\", \"workbench-extension-module-body\"]\n\n[nodes.build_export_workspace]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchExtensionBuildExportWorkspace\"\nclasses = [\"workbench-module-body\", \"workbench-extension-module-body\"]\nprops = { visibility = \"collapsed\" }\nlayout = { clip = true, container = { kind = \"Overlay\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [\n  { node = \"build_export_workspace_main\" },\n  { node = \"build_export_right\", slot = { layout = { alignment = { horizontal = \"End\", vertical = \"Fill\" }, z_order = 20 } } },\n]\n\n[nodes.build_export_workspace_main]\ncomponent = \"HorizontalGroup\"\nclasses = [\"workbench-module-layout-main\"]\nlayout = { clip = true, container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"build_export_rail_gap\" }, { node = \"build_export_left\" }, { node = \"build_export_center\" }, { node = \"build_export_right_reserve\" }]\n\n[nodes.build_export_right_reserve]\ncomponent = \"Container\"\nclasses = [\"workbench-module-details-reserve\"]\nprops = { responsive_min_tier = \"wide\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n[nodes.build_export_rail_gap]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionBuildExportRailGap\"\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { width = { min = \"$editor.chrome.activity_rail.width\", preferred = \"$editor.chrome.activity_rail.width\", max = \"$editor.chrome.activity_rail.width\", stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.build_export_left]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionBuildExportLeftPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-side\"]\nprops = { responsive_min_tier = \"narrow\" }\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"build_export_title\" }, { node = \"build_export_left_content\" }]\n\n[nodes.build_export_left_content]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionBuildExportLeftContent\"\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = \"$editor.density.gap.small\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"build_export_shipping_row\" }, { node = \"build_export_development_row\" }, { node = \"build_export_patch_row\" }]\n\n[nodes.build_export_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionBuildExportTitle\"\nprops = { text = \"Build Export\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = \"Fixed\" } }\n\n[nodes.build_export_shipping_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionBuildExportShippingRow\"\nclasses = [\"workbench-list-row\", \"workbench-row-selected\"]\nprops = { text = \"Shipping Win64\", icon = \"package\", selected = true }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BuildExportShippingRow\", event = \"Click\", route = \"workbench.extension.build_export.profile.shipping\" }]\n\n[nodes.build_export_development_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionBuildExportDevelopmentRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Development QA\", icon = \"gear\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BuildExportDevelopmentRow\", event = \"Click\", route = \"workbench.extension.build_export.profile.development\" }]\n\n[nodes.build_export_patch_row]\ncomponent = \"WorkbenchListRow\"\ncontrol_id = \"WorkbenchExtensionBuildExportPatchRow\"\nclasses = [\"workbench-list-row\"]\nprops = { text = \"Patch 1.2\", icon = \"file\", selected = false }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BuildExportPatchRow\", event = \"Click\", route = \"workbench.extension.build_export.profile.patch\" }]\n\n[nodes.build_export_center]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"WorkbenchExtensionBuildExportCenterPanel\"\nclasses = [\"workbench-panel\", \"workbench-module-center\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.medium\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"build_export_center_header\" }, { node = \"build_export_queue\" }, { node = \"build_export_output\" }]\n\n[nodes.build_export_center_header]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionBuildExportCenterHeader\"\nclasses = [\"workbench-panel-toolbar\"]\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Horizontal\", gap = \"$editor.density.gap.medium\", scrollbar_visibility = \"Never\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"build_export_center_title\" }, { node = \"build_export_header_fill\" }, { node = \"build_export_validate_button\" }, { node = \"build_export_package_button\" }]\n\n[nodes.build_export_center_title]\ncomponent = \"WorkbenchSectionTitle\"\ncontrol_id = \"WorkbenchExtensionBuildExportCenterTitle\"\nprops = { text = \"Package Queue\" }\nlayout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.build_export_header_fill]\ncomponent = \"Container\"\ncontrol_id = \"WorkbenchExtensionBuildExportHeaderFill\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.build_export_validate_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionBuildExportValidateButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Validate\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 86, preferred = 86, max = 96, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BuildExportValidate\", event = \"Click\", route = \"workbench.extension.build_export.validate\" }]\n\n[nodes.build_export_package_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionBuildExportPackageButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Package\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 88, preferred = 88, max = 98, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BuildExportPackage\", event = \"Click\", route = \"workbench.extension.build_export.package\" }]\n\n[nodes.build_export_queue]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionBuildExportQueue\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"build_export_cook_step_row\" }, { node = \"build_export_pak_step_row\" }, { node = \"build_export_sign_step_row\" }, { node = \"build_export_publish_step_row\" }]\n\n[nodes.build_export_cook_step_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionBuildExportCookStepRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Cook Content\", value_text = \"Running   62%   Selected\", options = [\"Cook Content\",\"Running\",\"62%\",\"Selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BuildExportCookStepRow\", event = \"Click\", route = \"workbench.extension.build_export.step.cook\" }]\n\n[nodes.build_export_pak_step_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionBuildExportPakStepRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Package Paks\", value_text = \"Queued   0%   Waiting\", options = [\"Package Paks\",\"Queued\",\"0%\",\"Waiting\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BuildExportPakStepRow\", event = \"Click\", route = \"workbench.extension.build_export.step.pak\" }]\n\n[nodes.build_export_sign_step_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionBuildExportSignStepRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Sign Installer\", value_text = \"Ready   Cert OK   Waiting\", options = [\"Sign Installer\",\"Ready\",\"Cert OK\",\"Waiting\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BuildExportSignStepRow\", event = \"Click\", route = \"workbench.extension.build_export.step.sign\" }]\n\n[nodes.build_export_publish_step_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionBuildExportPublishStepRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Publish Build\", value_text = \"Waiting   CDN   Pending\", options = [\"Publish Build\",\"Waiting\",\"CDN\",\"Pending\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/BuildExportPublishStepRow\", event = \"Click\", route = \"workbench.extension.build_export.step.publish\" }]\n\n[nodes.build_export_output]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionBuildExportOutputRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Export\", valu