penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui" ]

[asset]
kind = "view"
id = "res://ui/editor/host/editor_main_frame.zui#review-host"
version = 2
display_name = "editor main frame"

[root]
node = "root"

[nodes.root]
component = "VerticalGroup"
control_id = "EditorMainFrameRoot"
pixel_snapping = "disabled"
classes = [ "editor-main-frame" ]

[nodes.root.layout]
clip = true

[nodes.root.layout.container]
kind = "VerticalBox"
gap = 0

[nodes.root.layout.width]
stretch = "Stretch"

[nodes.root.layout.height]
stretch = "Stretch"

[[nodes.root.children]]
node = "task_bar_slot"

[[nodes.root.children]]
node = "window_tab_strip_slot"

[[nodes.root.children]]
node = "active_window_host_slot"

[nodes.task_bar_slot]
component = "Container"
control_id = "EditorMainFrameTaskBarSlot"

[nodes.task_bar_slot.props]
name = "task_bar"

[nodes.task_bar_slot.layout.width]
stretch = "Stretch"

[nodes.task_bar_slot.layout.height]
min = 32
preferred = 32
max = 32
stretch = "Fixed"

[[nodes.task_bar_slot.children]]
node = "review_task_bar__host"

[nodes.window_tab_strip_slot]
component = "HorizontalGroup"
control_id = "EditorMainFrameWindowTabStripSlot"

[nodes.window_tab_strip_slot.props]
name = "window_tab_strip"

[nodes.window_tab_strip_slot.layout.width]
stretch = "Stretch"

[nodes.window_tab_strip_slot.layout.height]
min = 28
preferred = 28
max = 28
stretch = "Fixed"

[nodes.window_tab_strip_slot.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.xsmall"

[[nodes.window_tab_strip_slot.children]]
node = "review_main_frame_tab_workbench"

[[nodes.window_tab_strip_slot.children]]
node = "review_main_frame_tab_assets"

[nodes.active_window_host_slot]
component = "Container"
control_id = "EditorMainFrameActiveWindowHostSlot"

[nodes.active_window_host_slot.props]
name = "active_window_host"

[nodes.active_window_host_slot.layout]
clip = true

[nodes.active_window_host_slot.layout.width]
stretch = "Stretch"

[nodes.active_window_host_slot.layout.height]
stretch = "Stretch"

[[nodes.active_window_host_slot.children]]
node = "review_active_window__root"

[nodes.review_task_bar__host]
component = "UiHostWindow"
control_id = "UiHostWindowRoot"
pixel_snapping = "disabled"
classes = [ "editor-workbench", "workbench-shell-root" ]

[nodes.review_task_bar__host.layout]
clip = true

[nodes.review_task_bar__host.layout.container]
kind = "Overlay"

[nodes.review_task_bar__host.layout.width]
stretch = "Stretch"

[nodes.review_task_bar__host.layout.height]
stretch = "Stretch"

[[nodes.review_task_bar__host.events]]
id = "UiHostWindow/ActivateMainPage"
event = "Change"
route = "workbench.dock.activate_main_page"

[[nodes.review_task_bar__host.children]]
node = "review_task_bar__scaffold"

[nodes.review_task_bar__scaffold]
component = "VerticalGroup"
control_id = "WorkbenchScaffold"

[nodes.review_task_bar__scaffold.layout]
clip = true

[nodes.review_task_bar__scaffold.layout.container]
kind = "VerticalBox"
gap = 0

[nodes.review_task_bar__scaffold.layout.width]
stretch = "Stretch"

[nodes.review_task_bar__scaffold.layout.height]
stretch = "Stretch"

[[nodes.review_task_bar__scaffold.children]]
node = "review_task_bar__menu_bar"

[nodes.review_task_bar__menu_bar]
component = "UiHostToolbar"
control_id = "WorkbenchMenuBarRoot"
classes = [ "workbench-topbar" ]

[nodes.review_task_bar__menu_bar.layout.container]
kind = "HorizontalBox"
gap = "$editor.density.gap.small"

[nodes.review_task_bar__menu_bar.layout.width]
stretch = "Stretch"

[nodes.review_task_bar__menu_bar.layout.height]
min = "$editor.control.height.default"
preferred = "$editor.control.height.default"
max = "$editor.control.height.default"
stretch = "Fixed"

[[nodes.review_task_bar__menu_bar.children]]
node = "review_task_bar__open_project"

[[nodes.review_task_bar__menu_bar.children]]
node = "review_task_bar__save_project"

[[nodes.review_task_bar__menu_bar.children]]
node = "review_task_bar__reset_layout"

[nodes.review_task_bar__open_project]
component = "WorkbenchIconButton"
control_id = "OpenProject"
classes = [ "workbench-toolbar-button" ]

[nodes.review_task_bar__open_project.props]
icon = "editor_pages/workbench/menu/open-project.svg"
label = "Open"
selected = false
focused = false
hovered = false
pressed = false
disabled = false
surface_variant = "inset"
border_width = "$editor.control.border_width"
corner_radius = "$editor.control.radius.control"

[nodes.review_task_bar__open_project.layout.width]
min = "$editor.density.toolbar_action_width"
preferred = "$editor.density.toolbar_action_width"
max = "$editor.density.toolbar_action_width"
stretch = "Fixed"

[nodes.review_task_bar__open_project.layout.height]
stretch = "Stretch"

[[nodes.review_task_bar__open_project.events]]
id = "WorkbenchMenuBar/OpenProject"
event = "Click"

[nodes.review_task_bar__open_project.events.action]
action = "file.project.open"

[nodes.review_task_bar__save_project]
component = "WorkbenchIconButton"
control_id = "SaveProject"
classes = [ "workbench-toolbar-button" ]

[nodes.review_task_bar__save_project.props]
icon = "editor_pages/workbench/menu/save-all.svg"
label = "Save"
selected = false
focused = false
hovered = false
pressed = false
disabled = false
surface_variant = "inset"
border_width = "$editor.control.border_width"
corner_radius = "$editor.control.radius.control"

[nodes.review_task_bar__save_project.layout.width]
min = "$editor.density.toolbar_action_width"
preferred = "$editor.density.toolbar_action_width"
max = "$editor.density.toolbar_action_width"
stretch = "Fixed"

[nodes.review_task_bar__save_project.layout.height]
stretch = "Stretch"

[[nodes.review_task_bar__save_project.events]]
id = "WorkbenchMenuBar/SaveProject"
event = "Click"

[nodes.review_task_bar__save_project.events.action]
action = "file.project.save"

[nodes.review_task_bar__reset_layout]
component = "WorkbenchIconButton"
control_id = "ResetLayout"
classes = [ "workbench-toolbar-button" ]

[nodes.review_task_bar__reset_layout.props]
icon = "editor_pages/workbench/dock/reset-layout.svg"
label = "Reset Layout"
selected = false
focused = false
hovered = false
pressed = false
disabled = false
surface_variant = "inset"
border_width = "$editor.control.border_width"
corner_radius = "$editor.control.radius.control"

[nodes.review_task_bar__reset_layout.layout.width]
min = "$editor.density.toolbar_wide_action_width"
preferred = "$editor.density.toolbar_wide_action_width"
max = "$editor.density.toolbar_wide_action_width"
stretch = "Fixed"

[nodes.review_task_bar__reset_layout.layout.height]
stretch = "Stretch"

[[nodes.review_task_bar__reset_layout.events]]
id = "WorkbenchMenuBar/ResetLayout"
event = "Click"

[nodes.review_task_bar__reset_layout.events.action]
action = "window.layout.reset"

[nodes.review_main_frame_tab_workbench]
component = "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab"

[nodes.review_main_frame_tab_workbench.props]
text = "Workbench"
selected = true
checked = true

[nodes.review_main_frame_tab_workbench.layout.width]
min = 112
preferred = 132
max = 180
stretch = "Fixed"

[nodes.review_main_frame_tab_workbench.layout.height]
stretch = "Stretch"

[nodes.review_main_frame_tab_assets]
component = "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab"

[nodes.review_main_frame_tab_assets.props]
text = "Assets"
selected = false
checked = false

[nodes.review_main_frame_tab_assets.layout.width]
min = 88
preferred = 104
max = 160
stretch = "Fixed"

[nodes.review_main_frame_tab_assets.layout.height]
stretch = "Stretch"

[nodes.review_active_window__root]
component = "Overlay"
control_id = "WorkbenchWindowRoot"
pixel_snapping = "disabled"
classes = [ "editor-workbench", "workbench-window-root" ]

[nodes.review_active_window__root.layout]
clip = true

[nodes.review_active_window__root.layout.container]
kind = "Overlay"

[nodes.review_active_window__root.layout.width]
stretch = "Stretch"

[nodes.review_active_window__root.layout.height]
stretch = "Stretch"

[[nodes.review_active_window__root.children]]
node = "review_active_window__window_content"

[nodes.review_active_window__window_content]
component = "VerticalGroup"
control_id = "WorkbenchWindowContent"
classes = [ "editor-workbench", "workbench-window-content" ]

[nodes.review_active_window__window_content.layout.container]
kind = "VerticalBox"
gap = 0

[nodes.review_active_window__window_content.layout.width]
stretch = "Stretch"

[nodes.review_active_window__window_content.layout.height]
stretch = "Stretch"

[[nodes.review_active_window__window_content.children]]
node = "review_active_window__top_toolbar"

[nodes.review_active_window__window_content.children.slot.layout.linear_size]
rule = "Auto"
shrink_value = 0

[[nodes.review_active_window__window_content.children]]
node = "review_active_window__main_band"

[nodes.review_active_window__window_content.children.slot.layout.linear_size]
rule = "Stretch"
value = 4

[[nodes.review_active_window__window_content.children]]
node = "review_active_window__component_drawer_shell"

[nodes.review_active_window__window_content.children.slot.layout.linear_size]
rule = "StretchContent"
value = 1

[[nodes.review_active_window__window_content.children]]
node = "review_active_window__status_bar"

[nodes.review_active_window__window_content.children.slot.layout.linear_size]
rule = "Auto"
shrink_value = 0

[nodes.review_active_window__top_toolbar]
component = "WorkbenchTopToolbar"
control_id = "WorkbenchWindowTopToolbarRegion"

[nodes.review_active_window__top_toolbar.layout.width]
stretch = "Stretch"

[nodes.review_active_window__top_toolbar.layout.height]
min = "$editor.chrome.workbench_toolbar.height"
preferred = "$editor.chrome.workbench_toolbar.height"
max = "$editor.chrome.workbench_toolbar.height"
stretch = "Fixed"

[nodes.review_active_window__main_band]
component = "WorkbenchMainBand"
control_id = "WorkbenchWindowMainBandRegion"

[nodes.review_active_window__main_band.layout.width]
stretch = "Stretch"

[nodes.review_active_window__main_band.layout.height]
priority = 100
weight = 4
stretch = "Stretch"

[nodes.review_active_window__component_drawer_shell]
component = "Container"
control_id = "BottomDrawerShellRoot"
classes = [ "workbench-bottom-drawer-shell" ]

[nodes.review_active_window__component_drawer_shell.layout]
clip = true

[nodes.review_active_window__component_drawer_shell.layout.container]
kind = "VerticalBox"
gap = 0

[nodes.review_active_window__component_drawer_shell.layout.width]
stretch = "Stretch"

[nodes.review_active_window__component_drawer_shell.layout.height]
min = "$editor.chrome.panel_header.height"
preferred = "$editor.density.bottom_output_height"
max = "$editor.density.bottom_output_height"
priority = 20
stretch = "Fixed"

[[nodes.review_active_window__component_drawer_shell.children]]
node = "review_active_window__component_drawer"

[nodes.review_active_window__component_drawer]
component = "WorkbenchComponentDrawer"
control_id = "WorkbenchWindowComponentDrawerRegion"

[nodes.review_active_window__component_drawer.layout.width]
stretch = "Stretch"

[nodes.review_active_window__component_drawer.layout.height]
stretch = "Stretch"

[nodes.review_active_window__status_bar]
component = "WorkbenchStatusBar"
control_id = "WorkbenchWindowStatusBarRegion"

[nodes.review_active_window__status_bar.layout.width]
stretch = "Stretch"

[nodes.review_active_window__status_bar.layout.height]
min = "$editor.chrome.status_bar.height"
preferred = "$editor.chrome.status_bar.height"
max = "$editor.chrome.status_bar.height"
stretch = "Fixed"

