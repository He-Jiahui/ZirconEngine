d = 96, max = 106, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/ScatterEditorGenerate\", event = \"Click\", route = \"workbench.extension.scatter_editor.generate\" }]\n\n[nodes.scatter_editor_validate_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionScatterEditorValidateButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Validate\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 86, preferred = 86, max = 96, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/ScatterEditorValidate\", event = \"Click\", route = \"workbench.extension.scatter_editor.validate\" }]\n\n[nodes.scatter_editor_rule_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionScatterEditorRuleTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"scatter_editor_biome_mask_table_row\" }, { node = \"scatter_editor_slope_filter_table_row\" }, { node = \"scatter_editor_spawn_rule_table_row\" }, { node = \"scatter_editor_collision_test_table_row\" }]\n\n[nodes.scatter_editor_biome_mask_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionScatterEditorBiomeMaskTableRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Biome Mask\", value_text = \"Input   Forest   Selected\", selected = true, options = [\"Biome Mask\",\"Input\",\"Forest\",\"Selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/ScatterEditorBiomeMaskTableRow\", event = \"Click\", route = \"workbench.extension.scatter_editor.rule.biome_mask\" }]\n\n[nodes.scatter_editor_slope_filter_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionScatterEditorSlopeFilterTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Slope Filter\", value_text = \"Constraint   0-38 deg   Ready\", options = [\"Slope Filter\",\"Constraint\",\"0-38 deg\",\"Ready\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/ScatterEditorSlopeFilterTableRow\", event = \"Click\", route = \"workbench.extension.scatter_editor.rule.slope_filter\" }]\n\n[nodes.scatter_editor_spawn_rule_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionScatterEditorSpawnRuleTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Spawn Rule\", value_text = \"Rule   Rocks + Ferns   64K\", options = [\"Spawn Rule\",\"Rule\",\"Rocks + Ferns\",\"64K\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/ScatterEditorSpawnRuleTableRow\", event = \"Click\", route = \"workbench.extension.scatter_editor.rule.spawn_rule\" }]\n\n[nodes.scatter_editor_collision_test_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionScatterEditorCollisionTestTableRow\"\nclasses = [\"workbench-table-row\"]\nprops = { text = \"Collision Test\", value_text = \"Validation   1 conflict   Warning\", options = [\"Collision Test\",\"Validation\",\"1 conflict\",\"Warning\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/ScatterEditorCollisionTestTableRow\", event = \"Cli