[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_radio.zui"
version = 2
display_name = "Workbench Radio"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchRadio]
root = "root"
default_classes = ["workbench-radio", "workbench-primitive"]

[nodes.root]
component = "Radio"
control_id = "WorkbenchRadioRoot"
classes = ["workbench-radio"]
props = { text = "Radio option", value = false, checked = false, background_color = "$editor.surface.recessed", checked_background_color = "$editor.surface.2", selected_background_color = "$editor.surface.selected", disabled_background_color = "$editor.surface.disabled", border_color = "$editor.separator.strong", checked_border_color = "$editor.border", focus_border_color = "$editor.focus.ring", accent_color = "$editor.accent", disabled_border_color = "$editor.border.disabled", label_color = "$editor.text.secondary", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_spacing = "$editor.density.gap.medium", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.compact", stretch = "Fixed" } }
