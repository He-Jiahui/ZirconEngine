penpot_original_source = "[asset]\nkind = \"view\"\nid = \"res://ui/editor/host/console_body.zui\"\nversion = 2\ndisplay_name = \"console pane body\"\n\n[imports]\nwidgets = [\"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\"]\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[root]\nnode = \"root\"\n\n[nodes.root]\npixel_snapping = \"disabled\"\ncomponent = \"VerticalGroup\"\ncontrol_id = \"ConsolePaneBodyRoot\"\nclasses = [\"editor-pane\", \"console-pane\", \"panel\"]\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.regular\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"header\" }, { node = \"body\" }, { node = \"footer\" }]\n\n[nodes.header]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"ConsoleHeader\"\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.xsmall\" }, width = { stretch = \"Stretch\" }, height = { min = 88.0, preferred = 88.0, max = 88.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"level_counts\" }, { node = \"source_filters\" }]\n\n[nodes.level_counts]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"ConsoleLevelCounts\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { min = 186.0, preferred = 204.0, max = 214.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"level_all\" }, { node = \"level_error\" }, { node = \"level_warning\" }, { node = \"level_info\" }]\n\n[nodes.level_all]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleLevelAll\"\nprops = { text = \"All\", icon = \"editor_pages/console_profiler/logs/filter-logs.svg\", icon_placement = \"leading\", component_variant = \"code compact_icon_text\", button_variant = \"text\", button_color = \"secondary\", text_tone = \"accent\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 48.0, preferred = 54.0, max = 58.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/FilterAll\", event = \"Click\", action = { action = \"view.console.filter.all\" } }]\n\n[nodes.level_error]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleLevelError\"\nprops = { text = \"0\", icon = \"editor_pages/console_profiler/logs/log-error.svg\", icon_placement = \"leading\", component_variant = \"code compact_icon_text\", button_variant = \"text\", button_color = \"secondary\", text_tone = \"error\", validation_level = \"error\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 42.0, preferred = 46.0, max = 48.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/FilterError\", event = \"Click\", action = { action = \"view.console.filter.error\" } }]\n\n[nodes.level_warning]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleLevelWarning\"\nprops = { text = \"0\", icon = \"editor_pages/console_profiler/logs/log-warning.svg\", icon_placement = \"leading\", component_variant = \"code compact_icon_text\", button_variant = \"text\", button_color = \"secondary\", text_tone = \"warning\", validation_level = \"warning\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 42.0, preferred = 46.0, max = 48.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/FilterWarning\", event = \"Click\", action = { action = \"view.console.filter.warning\" } }]\n\n[nodes.level_info]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleLevelInfo\"\nprops = { text = \"0\", icon = \"editor_pages/console_profiler/logs/log-info.svg\", icon_placement = \"leading\", component_variant = \"code compact_icon_text\", button_variant = \"text\", button_color = \"secondary\", text_tone = \"info\", validation_level = \"info\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 42.0, preferred = 46.0, max = 48.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/FilterInfo\", event = \"Click\", action = { action = \"view.console.filter.info\" } }]\n\n[nodes.source_filters]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"ConsoleSourceFilters\"\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.xsmall\" }, width = { stretch = \"Stretch\" }, height = { min = 58.0, preferred = 58.0, max = 58.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"source_filters_primary\" }, { node = \"source_filters_secondary\" }]\n\n[nodes.source_filters_primary]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"ConsoleSourceFiltersPrimary\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"source_all\" }, { node = \"source_editor\" }, { node = \"source_runtime\" }, { node = \"source_play\" }]\n\n[nodes.source_filters_secondary]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"ConsoleSourceFiltersSecondary\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"source_plugin\" }, { node = \"source_import\" }, { node = \"source_script_build\" }]\n\n[nodes.source_all]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleSourceAll\"\nprops = { text = \"All\", component_variant = \"code\", button_variant = \"text\", button_color = \"secondary\", font_size = \"$editor.typography.caption.size\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 36.0, preferred = 38.0, max = 42.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/SourceAll\", event = \"Click\", action = { action = \"view.console.source.all\" } }]\n\n[nodes.source_editor]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleSourceEditor\"\nprops = { text = \"Editor\", component_variant = \"code\", button_variant = \"text\", button_color = \"secondary\", font_size = \"$editor.typography.caption.size\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 48.0, preferred = 52.0, max = 56.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/SourceEditor\", event = \"Click\", action = { action = \"view.console.source.editor\" } }]\n\n[nodes.source_runtime]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleSourceRuntime\"\nprops = { text = \"Runtime\", component_variant = \"code\", button_variant = \"text\", button_color = \"secondary\", font_size = \"$editor.typography.caption.size\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 56.0, preferred = 60.0, max = 64.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/SourceRuntime\", event = \"Click\", action = { action = \"view.console.source.runtime\" } }]\n\n[nodes.source_play]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleSourcePlay\"\nprops = { text = \"Play\", component_variant = \"code compact\", button_variant = \"text\", button_color = \"secondary\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 38.0, preferred = 42.0, max = 46.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/SourcePlay\", event = \"Click\", action = { action = \"view.console.source.play\" } }]\n\n[nodes.source_plugin]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleSourcePlugin\"\nprops = { text = \"Plugin\", component_variant = \"code compact\", button_variant = \"text\", button_color = \"secondary\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 48.0, preferred = 52.0, max = 56.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/SourcePlugin\", event = \"Click\", action = { action = \"view.console.source.plugin\" } }]\n\n[nodes.source_import]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleSourceImport\"\nprops = { text = \"Import\", component_variant = \"code compact\", button_variant = \"text\", button_color = \"secondary\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 48.0, preferred = 52.0, max = 56.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/SourceImport\", event = \"Click\", action = { action = \"view.console.source.import\" } }]\n\n[nodes.source_script_build]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ConsoleSourceScriptBuild\"\nprops = { text = \"Script\", component_variant = \"code compact\", button_variant = \"text\", button_color = \"secondary\", text_align = \"center\", overflow = \"elide\" }\nlayout = { width = { min = 48.0, preferred = 52.0, max = 56.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/SourceScriptBuild\", event = \"Click\", action = { action = \"view.console.source.script_build\" } }]\n\n[nodes.body]\ncomponent = \"VerticalGroup\"\ncontrol_id = \"ConsoleBodySection\"\nlayout = { container = { kind = \"VerticalBox\", gap = 0.0 }, clip = true, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" }, scroll = { vertical = true } }\nchildren = [{ node = \"output_line_prototype\", slot = { layout = { padding = { left = \"$editor.density.gap.medium\", right = \"$editor.density.gap.large\" } } } }]\n\n[nodes.output_line_prototype]\ncomponent = \"Label\"\ncontrol_id = \"ConsoleOutputLinePrototype\"\nprops = { text = \"No output yet\", component_variant = \"code\", font_size = \"$editor.typography.caption.size\", text_tone = \"muted\", overflow = \"elide\" }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = \"Fixed\" } }\n\n[nodes.footer]\ncomponent = \"HorizontalGroup\"\ncontrol_id = \"ConsoleFooter\"\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.regular\" }, width = { stretch = \"Stretch\" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = \"Fixed\" } }\nchildren = [{ node = \"footer_spacer\" }, { node = \"clear\" }]\n\n[nodes.footer_spacer]\ncomponent = \"Space\"\ncontrol_id = \"ConsoleFooterSpacer\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.clear]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"ClearConsole\"\nprops = { text = \"Clear\", button_variant = \"outlined\", button_color = \"secondary\" }\nlayout = { width = { min = 50.0, preferred = 58.0, max = 66.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\nevents = [{ id = \"ConsolePaneBody/ClearConsole\", event = \"Click\", action = { action = \"view.console.clear\" } }]\n"

