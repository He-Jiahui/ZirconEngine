penpot_host_theme_source = "zircon_editor/assets/ui/editor/theme/editor_tokens.zui"
penpot_dependency_sources = [ "zircon_editor/assets/ui/editor/theme/editor_tokens.zui", "zircon_editor/assets/ui/editor/unreal/starship.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/chrome/workbench_axis_value_field.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/data/workbench_component_property_row.zui", "zircon_editor/assets/ui/editor/components/workbench/primitives/inputs/workbench_button.zui", "zircon_editor/assets/icons/zircon_editor_shell/controls/search.svg", "zircon_editor/assets/icons/ionicons/close-outline.svg", "zircon_editor/assets/icons/zircon_editor_shell/controls/field-stepper.svg", "zircon_editor/assets/i18n/en.toml" ]
penpot_original_source = "# Unreal Engine Details dock. Core snapshot owns selected object and property values.\r\n[asset]\r\nkind = \"component\"\r\nid = \"res://ui/editor/unreal/components/details.zui\"\r\nversion = 2\r\ndisplay_name = \"Unreal Details Panel\"\r\n\r\n[imports]\r\nwidgets = [\"res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput\", \"res://ui/editor/components/workbench/primitives/chrome/workbench_axis_value_field.zui#WorkbenchAxisValueField\", \"res://ui/editor/components/workbench/primitives/data/workbench_component_property_row.zui#WorkbenchComponentPropertyRow\", \"res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton\"]\r\nstyles = [\"res://ui/editor/unreal/starship.zui\"]\r\n\r\n[components.UnrealDetailsPanel]\r\nroot = \"panel\"\r\ndefault_classes = [\"unreal-details\", \"unreal-dock-panel\"]\r\n\r\n[nodes.panel]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchInspectorPanel\"\r\nclasses = [\"unreal-details\", \"unreal-dock-panel\"]\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"tab\" }, { node = \"summary\" }, { node = \"add\" }, { node = \"search\" }, { node = \"content\" }]\r\n\r\n[nodes.tab]\r\ncomponent = \"HorizontalGroup\"\r\ncontrol_id = \"RightDrawerHeaderRoot\"\r\nclasses = [\"unreal-dock-tab\"]\r\nlayout = { container = { kind = \"HorizontalBox\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.chrome.panel_header.height\", preferred = \"$editor.chrome.panel_header.height\", max = \"$editor.chrome.panel_header.height\", stretch = \"Fixed\" } }\r\nchildren = [{ node = \"title\" }]\r\n\r\n[nodes.title]\r\ncomponent = \"Label\"\r\ncontrol_id = \"UnrealDetailsDockTitle\"\r\nprops = { foreground_color = \"$unreal_foreground_header\", text = { text_key = \"editor.workbench.details.title\", table = \"editor\" }, font_size = 13.333333, font = \"res://fonts/editor-ui.font.toml\", font_family = \"Roboto\", font_weight = 400, line_height_ratio = 1.2 }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.summary]\r\ncomponent = \"HorizontalGroup\"\r\ncontrol_id = \"UnrealDetailsNameArea\"\r\nclasses = [\"unreal-details-name-area\"]\r\nlayout = { container = { kind = \"HorizontalBox\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\r\nchildren = [{ node = \"name\" }]\r\n\r\n[nodes.name]\r\ncomponent = \"Label\"\r\ncontrol_id = \"WorkbenchInspectorTitle\"\r\nprops = { text = \"No Selection\", text_overflow = \"ellipsis\", font_size = 13.333333, font = \"res://fonts/editor-ui.font.toml\", font_family = \"Roboto\", font_weight = 400, line_height_ratio = 1.2 }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.add]\r\ncomponent = \"WorkbenchButton\"\r\ncontrol_id = \"WorkbenchAddComponent\"\r\nprops = { text = \"Add Component\", visibility = \"collapsed\", font = \"res://fonts/editor-ui.font.toml\", font_family = \"Roboto\", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\r\nevents = [{ id = \"Inspector/AddComponent\", event = \"Click\", route = \"workbench.inspector.add_component\" }]\r\n\r\n[nodes.search]\r\ncomponent = \"WorkbenchSearchInput\"\r\ncontrol_id = \"WorkbenchInspectorFilter\"\r\nclasses = [\"unreal-panel-search\"]\r\nprops = { query = \"\", placeholder = \"Search Details\", font = \"res://fonts/editor-ui.font.toml\", font_family = \"Roboto\", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }\r\nwidget = { value_property = \"query\" }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.default\", preferred = \"$editor.control.height.default\", max = \"$editor.control.height.default\", stretch = \"Fixed\" } }\r\nevents = [{ id = \"Workbench/InspectorSearchEdit\", event = \"Change\", component_event = \"ValueChanged\", route = \"workbench.inspector.search.edit\" }, { id = \"Workbench/InspectorSearchCommit\", event = \"Submit\", component_event = \"Commit\", route = \"workbench.inspector.search.commit\" }]\r\n\r\n[nodes.content]\r\ncomponent = \"ScrollableBox\"\r\ncontrol_id = \"RightDrawerContentRoot\"\r\nprops = { input_hoverable = true }\r\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nchildren = [{ node = \"metadata\" }, { node = \"transform\" }, { node = \"component\" }, { node = \"empty\" }]\r\n\r\n[nodes.metadata]\r\ncomponent = \"HorizontalGroup\"\r\ncontrol_id = \"WorkbenchInspectorMetadata\"\r\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\r\nchildren = [{ node = \"layer_label\" }, { node = \"layer\" }]\r\n\r\n[nodes.layer_label]\r\ncomponent = \"Label\"\r\ncontrol_id = \"WorkbenchInspectorRenderLayerLabel\"\r\nprops = { text = \"Layer mask\", font_size = 13.333333, font = \"res://fonts/editor-ui.font.toml\", font_family = \"Roboto\", font_weight = 400, line_height_ratio = 1.2 }\r\nlayout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.layer]\r\ncomponent = \"WorkbenchAxisValueField\"\r\ncontrol_id = \"WorkbenchInspectorRenderLayerMask\"\r\nprops = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = \"$unreal_foreground_disabled\", placeholder_color = \"$editor.text.secondary\", foreground_color = \"$unreal_foreground\", disabled_border_color = \"$editor.border.disabled\", focus_border_color = \"$unreal_primary\", hover_border_color = \"$unreal_input_outline\", border_color = \"$unreal_input_outline\", disabled_background_color = \"$editor.surface.disabled\", focused_background_color = \"$unreal_input\", pressed_background_color = \"$editor.surface.3\", hover_background_color = \"#575757\", background_color = \"$unreal_input\", value = \"\", placeholder = \"1\", font = \"res://fonts/editor-ui.font.toml\", font_family = \"Roboto\", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }\r\nlayout = { width = { min = 96.0, preferred = 112.0, max = 120.0, stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\r\nevents = [{ id = \"Inspector/RenderLayerMaskEdit\", event = \"Change\", route = \"workbench.inspector.render_layer_mask.edit\" }, { id = \"Inspector/RenderLayerMaskCommit\", event = \"Submit\", route = \"workbench.inspector.render_layer_mask.commit\" }]\r\n\r\n[nodes.transform]\r\ncomponent = \"VerticalGroup\"\r\ncontrol_id = \"WorkbenchInspectorTransform\"\r\nclasses = [\"unreal-property-category\"]\r\nlayout = { container = { kind = \"VerticalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { stretch = \"Fixed\" } }\r\nchildren = [{ node = \"transform_title\" }, { node = \"position\" }, { node = \"rotation\" }, { node = \"scale\" }]\r\n\r\n[nodes.transform_title]\r\ncomponent = \"Label\"\r\ncontrol_id = \"WorkbenchTransformLabel\"\r\nclasses = [\"unreal-category-header\"]\r\nprops = { corner_radius = 4.0, border_width = 1.0, border_color = \"$unreal_input_outline\", foreground_color = \"$unreal_foreground_header\", background_color = \"$unreal_header\", text = \"Transform\", font_size = 13.333333, font = \"res://fonts/editor-ui.font.toml\", font_family = \"Roboto\", font_weight = 700, line_height_ratio = 1.2 }\r\nlayout = { width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\r\n\r\n[nodes.position]\r\ncomponent = \"HorizontalGroup\"\r\ncontrol_id = \"WorkbenchTransformPosition\"\r\nprops = { value = \"\" }\r\nlayout = { container = { kind = \"HorizontalBox\", gap = \"$editor.density.gap.small\" }, width = { stretch = \"Stretch\" }, height = { min = \"$editor.control.height.dense\", preferred = \"$editor.control.height.dense\", max = \"$editor.control.height.dense\", stretch = \"Fixed\" } }\r\nchildren = [{ node = \"position_label\" }, { node = \"position_x\" }, { node = \"position_y\" }, { node = \"position_z\" }]\r\n\r\n[nodes.position_label]\r\ncomponent = \"Label\"\r\ncontrol_id = \"WorkbenchTransformPositionLabel\"\r\nprops = { text = \"Location\", font_size = 13.333333, font = \"res://fonts/editor-ui.font.toml\", font_family = \"Roboto\", font_weight = 400, line_height_ratio = 1.2 }\r\nlayout = { width = { min = 64.0, preferred = 72.0, max = 88.0, stretch = \"Fixed\" }, height = { stretch = \"Stretch\" } }\r\n\r\n[nodes.position_x]\r\ncomponent = \"WorkbenchAxisValueField\"\r\ncontrol_id = \"WorkbenchTransformPositionX\"\r\nprops = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = \"$unreal_foreground_disabled\", placeholder_color = \"$editor.text.secondary\", foreground_color = \"$unreal_foreground\", disabled_border_color = \"$editor.border.disabled\", focus_border_color = \"$unreal_primary\", hover_border_color = \"$unreal_input_outline\", border_color = \"$unreal_input_outline\", disabled_background_color = \"$editor.surface.disabled\", focused_background_color = \"$unreal_input\", pressed_background_color = \"$editor.surface.3\", hover_