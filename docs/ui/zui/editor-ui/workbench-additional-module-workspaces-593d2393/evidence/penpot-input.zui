y\"\ncontrol_id = \"WorkbenchTagsWorkspaceHost\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"tags_workspace_body\" }]\n\n[nodes.tags_workspace_body]\ncomponent = \"WorkbenchTagsWorkspace\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.perception_workspace_host]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchPerceptionWorkspaceHost\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"perception_workspace_body\" }]\n\n[nodes.perception_workspace_body]\ncomponent = \"WorkbenchPerceptionWorkspace\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.render_workspace_host]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchRenderWorkspaceHost\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"render_workspace_body\" }]\n\n[nodes.render_workspace_body]\ncomponent = \"WorkbenchRenderWorkspace\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n\n[nodes.hud_workspace_host]\ncomponent = \"Overlay\"\ncontrol_id = \"WorkbenchHudWorkspaceHost\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"hud_workspace_body\" }]\n\n[nodes.hud_workspace_body]\ncomponent = \"WorkbenchHudWorkspace\"\nlayout = { width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\n"

