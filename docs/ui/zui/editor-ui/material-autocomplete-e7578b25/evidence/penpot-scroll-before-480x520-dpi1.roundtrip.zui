props = { text = "Atlas", surface_variant = "elevated", text_tone = "success", validation_level = "success", hovered = false, pressed = false, focused = false, selected = true, checked = true, disabled = false, open = false, popup_open = false, corner_radius = 999.0, border_width = 1.0, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { min = 44.0, preferred = 52.0, max = 62.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.autocomplete_popup_indicator]
component = "Label"
control_id = "autocomplete_PopupIndicator"
classes = ["material-control", "material-autocomplete-popup-indicator"]
props = { text = "Open", surface_variant = "elevated", text_tone = "info", validation_level = "normal", hovered = true, pressed = false, focused = true, selected = false, checked = false, disabled = false, open = true, popup_open = true, corner_radius = 999.0, border_width = 1.0, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { min = 38.0, preferred = 44.0, max = 50.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.autocomplete_popper]
