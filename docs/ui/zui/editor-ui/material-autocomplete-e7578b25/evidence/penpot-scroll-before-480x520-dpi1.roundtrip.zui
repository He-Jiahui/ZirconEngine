[asset]
kind = "component"
id = "res://ui/editor/material_components/inputs/material_autocomplete.zui"
version = 2
display_name = "Material Autocomplete Prototype"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel", "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption"]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.MaterialAutocompletePrototype]
root = "root"
default_classes = ["material-lab-prototype", "material-surface"]

[nodes.title]
component = "WorkbenchLabel"
control_id = "autocomplete_Title"
classes = ["material-lab-title"]
props = { "text" = "Autocomplete", "text_tone" = "primary", "font_size" = "$editor.typography.title.size", "font_weight" = "$editor.typography.strong.weight", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 28, "preferred" = 28, "max" = 28, "stretch" = "Fixed" } }

[nodes.meta]
component = "GridBox"
control_id = "autocomplete_Meta"
classes = ["material-lab-meta-strip", "material-lab-meta"]
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 52, "preferred" = 52, "max" = 52, "stretch" = "Fixed" }, "container" = { "kind" = "GridBox", "columns" = 2, "rows" = 2, "column_gap" = "$editor.density.gap.medium", "row_gap" = "$editor.density.gap.small" } }
children = [
  { node = "meta_group" },
  { node = "meta_response" },
  { node = "meta_variant" },
  { node = "meta_layout" },
]

[nodes.meta_group]
component = "WorkbenchCaption"
control_id = "autocomplete_MetaGroup"
classes = ["material-lab-meta-chip", "material-lab-meta-group"]
props = { "text" = "Inputs", "text_tone" = "secondary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }

[nodes.meta_response]
component = "WorkbenchCaption"
control_id = "autocomplete_MetaResponse"
classes = ["material-lab-meta-chip", "material-lab-meta-response"]
props = { "text" = "change / commit", "text_tone" = "success", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "response_mechanism" = "change / commit", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.meta_variant]
component = "WorkbenchCaption"
control_id = "autocomplete_MetaVariant"
classes = ["material-lab-meta-chip", "material-lab-meta-variant"]
props = { "text" = "outlined / menu", "text_tone" = "primary", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "variant" = "outlined / menu", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }

[nodes.meta_layout]
component = "WorkbenchCaption"
control_id = "autocomplete_MetaLayout"
classes = ["material-lab-meta-chip", "material-lab-meta-layout"]
props = { "text" = "inline controls", "text_tone" = "warning", "font_size" = "$editor.typography.caption.size", "surface_variant" = "frame_only", "layout_mode" = "inline controls", "density" = "compact", "corner_radius" = 0, "border_width" = 0, "font_weight" = "$editor.typography.body.weight", "text_align" = "left", "wrap" = "word", "text_overflow" = "clip" }
layout = { "width" = { "stretch" = "Stretch" }, "height" = { "min" = 24, "preferred" = 24, "max" = 24, "stretch" = "Fixed" } }
[nodes.sample]
component = "Autocomplete"
control_id = "autocomplete_Sample"
classes = ["material-control", "material-lab-sample", "MuiAutocomplete-root"]
props = { query = "at", inputValue = "at", value = "atlas", value_text = "Atlas", selected_options = ["atlas"], selectedOptions = ["atlas"], options = ["atlas", "asset", "disabled"], filtered_options = ["atlas", "asset"], filteredOptions = ["atlas", "asset"], disabled_options = ["disabled"], disabledOptions = ["disabled"], focused_options = ["atlas"], focusedOptions = ["atlas"], hovered_options = ["atlas"], hoveredOptions = ["atlas"], pressed_options = [], pressedOptions = [], matched_options = ["atlas", "asset"], matchedOptions = ["atlas", "asset"], size = "small", multiple = true, free_solo = false, freeSolo = false, surface_variant = "elevated", button_variant = "contained", text_tone = "primary", validation_level = "normal", hovered = true, pressed = false, focused = true, selected = true, checked = true, disabled = false, open = true, popup_open = true, popupOpen = true, fullWidth = true, disableClearable = false, disablePortal = true, inputFocused = true, loading = false, readOnly = false, forcePopupIcon = "auto", className = "material-autocomplete-sample", slotProps = { inputRoot = { className = "material-autocomplete-input-root" }, input = { className = "material-autocomplete-input" }, tag = { className = "material-autocomplete-tag" }, popupIndicator = { className = "material-autocomplete-popup-indicator" }, popper = { className = "material-autocomplete-popper" }, paper = { className = "material-autocomplete-paper" }, listbox = { className = "material-autocomplete-listbox" }, option = { className = "material-autocomplete-option" } }, corner_radius = 4, border_width = 1, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = 0.0, stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, clip = true, input_policy = "Receive", container = { kind = "ScrollableBox", axis = "Horizontal", gap = 4.0, scrollbar_visibility = "Auto" } }
children = [
  { node = "autocomplete_input_root", slot = { name = "inputRoot" } },
  { node = "autocomplete_input", slot = { name = "input" } },
  { node = "autocomplete_tag", slot = { name = "tag" } },
  { node = "autocomplete_popup_indicator", slot = { name = "popupIndicator" } },
  { node = "autocomplete_popper", slot = { name = "popper" } },
  { node = "autocomplete_paper", slot = { name = "paper" } },
  { node = "autocomplete_listbox", slot = { name = "listbox" } },
  { node = "autocomplete_option", slot = { name = "option" } },
]
events = [
  { id = "MaterialLab/Autocomplete/Change", event = "Change", route = "material_lab.autocomplete.change" },
]

[nodes.autocomplete_input_root]
component = "HorizontalBox"
control_id = "autocomplete_InputRoot"
classes = ["material-control", "material-autocomplete-input-root"]
props = { text = "Search", surface_variant = "elevated", text_tone = "primary", validation_level = "normal", hovered = true, pressed = false, focused = true, selected = false, checked = false, disabled = false, open = true, popup_open = true, corner_radius = 4, border_width = 1, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { min = 56.0, preferred = 66.0, max = 76.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.autocomplete_input]
component = "Label"
control_id = "autocomplete_Input"
classes = ["material-control", "material-autocomplete-input"]
props = { text = "at", surface_variant = "elevated", text_tone = "primary", validation_level = "normal", hovered = false, pressed = false, focused = true, selected = false, checked = false, disabled = false, open = true, popup_open = true, corner_radius = 4, border_width = 1, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { min = 32.0, preferred = 36.0, max = 44.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

