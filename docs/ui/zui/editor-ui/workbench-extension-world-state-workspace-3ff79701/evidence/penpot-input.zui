events = [{ id = \"WorkbenchExtension/WorldStateSimulate\", event = \"Click\", route = \"workbench.extension.world_state.simulate\" }]\n\n[nodes.world_state_validate_button]\ncomponent = \"WorkbenchButton\"\ncontrol_id = \"WorkbenchExtensionWorldStateValidateButton\"\nclasses = [\"workbench-control-button\", \"workbench-module-command\"]\nprops = { text = \"Validate\", button_variant = \"filled\", button_color = \"accent\" }\nlayout = { width = { min = 96, preferred = 96, max = 106, stretch = \"Fixed\" }, height = { min = 28, preferred = 28, max = 28, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/WorldStateValidate\", event = \"Click\", route = \"workbench.extension.world_state.validate\" }]\n\n[nodes.world_state_key_table]\ncomponent = \"ScrollableBox\"\ncontrol_id = \"WorkbenchExtensionWorldStateKeyTable\"\nclasses = [\"workbench-panel\", \"workbench-module-canvas\"]\nprops = { input_hoverable = true }\nlayout = { clip = true, container = { kind = \"ScrollableBox\", axis = \"Vertical\", gap = 0.0, scrollbar_visibility = \"Auto\" }, input_policy = \"Receive\", width = { stretch = \"Stretch\" }, height = { stretch = \"Stretch\" } }\nchildren = [{ node = \"world_state_alarm_active_table_row\" }, { node = \"world_state_weather_mode_table_row\" }, { node = \"world_state_ai_alert_table_row\" }, { node = \"world_state_quest_flag_table_row\" }]\n\n[nodes.world_state_alarm_active_table_row]\ncomponent = \"WorkbenchTableRow\"\ncontrol_id = \"WorkbenchExtensionWorldStateAlarmActiveTableRow\"\nclasses = [\"workbench-table-row\", \"workbench-row-selected\"]\nprops = { text = \"Alarm.Active\", value_text = \"Global   true   Selected\", selected = true, options = [\"Alarm.Active\",\"Global\",\"true\",\"Selected\"] }\nlayout = { width = { stretch = \"Stretch\" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = \"Fixed\" } }\nevents = [{ id = \"WorkbenchExtension/WorldStateAlarmActiveTableRow\", event = \"Click\", route = \"workbench.extension.world