[nodes.review_theme_label_4.layout.position]
x = 32
y = 360

[nodes.review_theme_label_4.layout.width]
preferred = 280
stretch = "Fixed"

[nodes.review_theme_label_4.layout.height]
preferred = 20
stretch = "Fixed"

[nodes.review_theme_component_4]
component = "ToggleButton"
control_id = "review_theme_component_4Control"
classes = [ "showcase-field", "material-control" ]

[nodes.review_theme_component_4.props]
text = "Toggle Button"
checked = true
layout_padding_left = "$editor.density.gap.large"
layout_padding_right = "$editor.density.gap.large"
layout_padding_top = "$editor.density.gap.small"
layout_padding_bottom = "$editor.density.gap.small"
layout_spacing = "$editor.density.gap.small"
layout_min_width = "$editor.control.height.default"
layout_min_height = "$editor.control.height.default"
layout_icon_size = 16
input_interactive = true
input_clickable = true
input_hoverable = true
input_focusable = true

[nodes.review_theme_component_4.layout.width]
min = 280
preferred = 280
max = 280
stretch = "Fixed"

[nodes.review_theme_component_4.layout.height]
min = 32
preferred = 32
max = 32
stretch = "Fixed"

[nodes.review_theme_component_4.layout.position]
x = 32
y = 388

[[nodes.review_theme_component_4.events]]
id = "UiComponentShowcase/ToggleButtonChanged"
event = "Toggle"
route = "component_lab.showcase.change.toggle_button"

[nodes.review_theme_label_5]
component = "Label"
control_id = "review_theme_component_5Label"

[nodes.review_theme_label_5.props]
text = "Number field"
font_size = "$editor.typography.caption.size"
font_weight = "$editor.typography.medium.weight"
text_tone = "secondary"

[nodes.review_theme_label_5.layout.position]
x = 328
y = 360

[nodes.review_theme_label_5.layout.width]
preferred = 280
stretch = "Fixed"

[nodes.review_theme_label_5.layout.height]
preferred = 20
stretch = "Fixed"

[nodes.review_theme_component_5]
component = "NumberField"
control_id = "review_theme_component_5Control"
classes = [ "showcase-field", "material-control", "material-outlined-field" ]

[nodes.review_theme_component_5.props]
value = 42
min = 0
max = 100
step = 1
large_step = 10
layout_padding_left = "$editor.density.gap.medium"
layout_padding_right = "$editor.density.gap.medium"
layout_padding_top = "$editor.density.gap.xsmall"
layout_padding_bottom = "$editor.density.gap.xsmall"
layout_min_height = "$editor.control.height.default"
input_interactive = true
input_clickable = true
input_hoverable = true
input_focusable = true

[nodes.review_theme_component_5.layout.width]
min = 280
preferred = 280
max = 280
stretch = "Fixed"

[nodes.review_theme_component_5.layout.height]
min = 32
preferred = 32
max = 32
stretch = "Fixed"

[nodes.review_theme_component_5.layout.position]
x = 328
y = 388

[[nodes.review_theme_component_5.events]]
id = "UiComponentShowcase/NumberFieldDragBegin"
event = "DragBegin"
component_event = "BeginDrag"
route = "component_lab.showcase.begin_drag.number_field"

[[nodes.review_theme_component_5.events]]
id = "UiComponentShowcase/NumberFieldDragUpdate"
event = "DragUpdate"
component_event = "DragDelta"
route = "component_lab.showcase.drag_delta.number_field"

[[nodes.review_theme_component_5.events]]
id = "UiComponentShowcase/NumberFieldLargeDragUpdate"
event = "DragUpdate"
component_event = "LargeDragDelta"
route = "component_lab.showcase.large_drag_delta.number_field"

[[nodes.review_theme_component_5.events]]
id = "UiComponentShowcase/NumberFieldDragEnd"
event = "DragEnd"
component_event = "EndDrag"
route = "component_lab.showcase.end_drag.number_field"

[[nodes.review_theme_component_5.events]]
id = "UiComponentShowcase/NumberFieldChanged"
event = "Change"
component_event = "ValueChanged"
route = "component_lab.showcase.value_changed.number_field"

[[nodes.review_theme_component_5.events]]
id = "UiComponentShowcase/NumberFieldCommitted"
event = "Submit"
component_event = "Commit"
route = "component_lab.showcase.commit.number_field"
