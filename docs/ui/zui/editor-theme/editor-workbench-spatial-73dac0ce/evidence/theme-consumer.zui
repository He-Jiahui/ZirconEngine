[asset]
kind = "view"
version = 2
id = "res://ui/theme/editor_workbench_spatial.zui#review-host"
display_name = "Editor Workbench Spatial"

[imports]
widgets = []
styles = [ "res://ui/theme/editor_workbench_spatial.zui" ]

[root]
node = "review_theme_host"

[nodes.review_theme_host]
component = "Panel"
control_id = "EditorThemeReviewHost"
classes = [ "workbench-panel" ]

[nodes.review_theme_host.style.self.background]
color = "$editor.surface.0"

[nodes.review_theme_host.style.self.foreground]
color = "$editor.text.primary"

[nodes.review_theme_host.layout.container]
kind = "Overlay"

[nodes.review_theme_host.layout.width]
stretch = "Stretch"

[nodes.review_theme_host.layout.height]
stretch = "Stretch"

[[nodes.review_theme_host.children]]
node = "review_theme_title"

[[nodes.review_theme_host.children]]
node = "review_theme_label_0"

[[nodes.review_theme_host.children]]
node = "review_theme_component_0"

[[nodes.review_theme_host.children]]
node = "review_theme_label_1"

[[nodes.review_theme_host.children]]
node = "review_theme_component_1"

[[nodes.review_theme_host.children]]
node = "review_theme_label_2"

[[nodes.review_theme_host.children]]
node = "review_theme_component_2"

[[nodes.review_theme_host.children]]
node = "review_theme_label_3"

[[nodes.review_theme_host.children]]
node = "review_theme_component_3"

[[nodes.review_theme_host.children]]
node = "review_theme_label_4"

[[nodes.review_theme_host.children]]
node = "review_theme_component_4"

[nodes.review_theme_title]
component = "Label"
control_id = "EditorThemeReviewTitle"

[nodes.review_theme_title.props]
text = "Editor component states"
font_size = "$editor.typography.title.size"
font_weight = "$editor.typography.strong.weight"

[nodes.review_theme_title.layout.position]
x = 32
y = 32

[nodes.review_theme_title.layout.width]
preferred = 560
stretch = "Fixed"

[nodes.review_theme_title.layout.height]
preferred = 32
stretch = "Fixed"

[nodes.review_theme_label_0]
component = "Label"
control_id = "review_theme_component_0Label"

[nodes.review_theme_label_0.props]
text = "Button"
font_size = "$editor.typography.caption.size"
font_weight = "$editor.typography.medium.weight"
text_tone = "secondary"

[nodes.review_theme_label_0.layout.position]
x = 32
y = 120

[nodes.review_theme_label_0.layout.width]
preferred = 280
stretch = "Fixed"

[nodes.review_theme_label_0.layout.height]
preferred = 20
stretch = "Fixed"

[nodes.review_theme_component_0]
component = "Button"
control_id = "review_theme_component_0Control"
classes = [ "workbench-control-button" ]

[nodes.review_theme_component_0.props]
text = "Button"
text_overflow = "ellipsis"
text_align = "center"
button_variant = "outlined"
button_color = "secondary"
button_size = "small"
button_interaction_state = "normal"
validation_level = "normal"
selected = false
focused = false
hovered = false
pressed = false
disabled = false
background_color = "$editor.surface.1"
hover_background_color = "$editor.surface.hover"
pressed_background_color = "$editor.surface.3"
selected_background_color = "$editor.surface.selected"
selected_border_color = "$editor.accent"
selected_foreground_color = "$editor.text.primary"
disabled_background_color = "$editor.surface.disabled"
border_color = "$editor.border"
focus_border_color = "$editor.focus.ring"
disabled_border_color = "$editor.border.disabled"
foreground_color = "$editor.text.primary"
disabled_foreground_color = "$editor.text.disabled"
border_width = "$editor.control.border_width"
corner_radius = "$editor.control.radius.control"
font = "res://fonts/editor-ui.font.toml"
font_family = "Fira Sans"
font_weight = "$editor.typography.strong.weight"
font_size = "$editor.typography.body.size"
line_height_ratio = "$editor.typography.line_height"
