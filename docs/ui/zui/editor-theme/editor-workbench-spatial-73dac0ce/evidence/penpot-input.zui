"editor.density.ultra_minimum_window_width" = 420
"editor.density.ultra_minimum_window_height" = 360
"editor.state.default" = "surface_1"
"editor.state.hovered" = "surface_2"
"editor.state.pressed" = "surface_3"
"editor.state.selected" = "surface_selected"
"editor.state.focused" = "surface_1"
"editor.state.disabled" = "text_disabled"
"editor.state.loading" = "accent"
workbench_shell = "$editor.surface.0"
workbench_surface = "$editor.surface.1"
workbench_panel = "$editor.surface.2"
workbench_panel_raised = "$editor.surface.3"
