penpot_original_source = "[asset]\nkind = \"style\"\nid = \"res://ui/theme/editor_workbench_strict.zui\"\nversion = 2\ndisplay_name = \"Editor Workbench Strict\"\n\n[imports]\nwidgets = []\nstyles = [\"res://ui/editor/theme/editor_tokens.zui\"]\n\n[tokens]\nworkbench_shell = \"$editor.surface.0\"\nworkbench_surface = \"$editor.surface.1\"\nworkbench_panel = \"$editor.surface.2\"\nworkbench_panel_raised = \"$editor.surface.3\"\nworkbench_inset = \"$editor.surface.recessed\"\nworkbench_hover = \"$editor.surface.hover\"\nworkbench_active = \"$editor.surface.selected\"\nworkbench_selected = \"$editor.surface.selected\"\nworkbench_border = \"$editor.border\"\nworkbench_border_soft = \"$editor.separator.soft\"\nworkbench_accent = \"$editor.accent\"\nworkbench_accent_2 = \"$editor.accent\"\nworkbench_accent_soft = \"$editor.accent.soft\"\nworkbench_accent_dim = \"$editor.accent.soft\"\nworkbench_toast_surface = \"$editor.popup\"\nworkbench_toast_text = \"$editor.text.secondary\"\nworkbench_toast_border = \"$editor.accent.soft\"\nworkbench_button_disabled = \"$editor.surface.disabled\"\nworkbench_button_disabled_text = \"$editor.text.disabled\"\nworkbench_button_disabled_border = \"$editor.border.disabled\"\nworkbench_text = \"$editor.text.primary\"\nworkbench_text_muted = \"$editor.text.secondary\"\nworkbench_mesh_title_text = \"$editor.text.secondary\"\nworkbench_text_dim = \"$editor.text.disabled\"\nworkbench_status_right_text = \"$editor.text.secondary\"\nworkbench_status_no_errors_fill = \"$editor.semantic.success\"\nworkbench_table_header_text = \"$editor.text.secondary\"\nworkbench_success = \"$editor.semantic.success\"\nworkbench_warning = \"$editor.semantic.warning\"\nworkbench_error = \"$editor.semantic.error\"\nworkbench_info = \"$editor.semantic.info\"\nworkbench_field = \"$editor.surface.recessed\"\nworkbench_field_hot = \"$editor.surface.2\"\nworkbench_progress_fill = \"$editor.separator.strong\"\nworkbench_field_component = \"$editor.surface.recessed\"\nworkbench_field_component_border = \"$editor.border\"\nworkbench_field_component_focused = \"$editor.surface.1\"\nworkbench_field_component_focused_text = \"$editor.text.primary\"\nworkbench_field_component_focus_border = \"$editor.focus.ring\"\nworkbench_field_component_disabled = \"$editor.surface.disabled\"\nworkbench_field_component_disabled_text = \"$editor.text.disabled\"\nworkbench_field_component_disabled_border = \"$editor.border.disabled\"\nworkbench_segmented = \"$editor.surface.2\"\nworkbench_selection_label = \"$editor.text.secondary\"\nworkbench_selection_mark = \"$editor.surface.1\"\nworkbench_selection_mark_border = \"$editor.separator.strong\"\nworkbench_checkbox_checked = \"$editor.surface.selected\"\nworkbench_radio_checked = \"$editor.surface.selected\"\nworkbench_radio_checked_border = \"$editor.accent\"\nworkbench_toggle_track = \"$editor.track\"\nworkbench_toggle_track_border = \"$editor.border\"\nworkbench_toggle_thumb = \"$editor.text.secondary\"\nworkbench_toggle_checked_track = \"$editor.surface.selected\"\nworkbench_toggle_checked_border = \"$editor.accent\"\nworkbench_toggle_checked_thumb = \"$editor.text.secondary\"\nworkbench_warning_surface = \"$editor.semantic.warning.container\"\nworkbench_error_surface = \"$editor.semantic.error.container\"\nworkbench_success_surface = \"$editor.semantic.success.container\"\nworkbench_info_surface = \"$editor.semantic.info.container\"\n\n[[stylesheets]]\nid = \"editor_workbench_strict\"\n\n[[stylesheets.rules]]\nselector = \".editor-workbench\"\n[stylesheets.rules.set.self]\nbackground_color = \"$workbench_shell\"\nforeground_color = \"$workbench_text\"\n\n[[stylesheets.rules]]\nselector = \".workbench-shell-root\"\n[stylesheets.rules.set.self]\nbackground_color = \"$workbench_shell\"\nforeground_color = \"$workbench_text\"\n\n[[stylesheets.rules]]\nselector = \".workbench-window-root\"\n[stylesheets.rules.set.self]\nbackground_color = \"$workbench_shell\"\nforeground_color = \"$workbench_text\"\n\n[[st