  "insertions": [
    {
      "id": "R052-root-01",
      "before_offset": 1064,
      "before_line": 29,
      "length": 504,
      "sha256": "88d6c47ebe2338f8c0ab631732664308d59aca7794e55b68c82e4801a9b3ccdb",
      "exact_text": "    ///\n    /// # 参数\n    /// `route` 转为拥有的标识；`payload` 按具名参数移入记录，不验证目标存在或参数是否适配。\n    ///\n    /// # 返回值\n    /// 返回 Route 类目标的载体；空参数表在序列化时省略，缺少整个参数表字段时读取为空表。\n    ///\n    /// # 使用时机与参考\n    /// 供组件绑定投影在决定路由及参数后使用；目标解析和执行由消费者完成。\n    /// 无参数命令使用 [`Self::action`]。\n",
      "inserted_lines": 10,
      "reason": "Preserve the original English summary and document owned route/payload, wire omission/default and consumer execution boundary.",
      "after_offset": 1064
    },
    {
      "id": "R052-root-02",
      "before_offset": 1264,
      "before_line": 36,
      "length": 438,
      "sha256": "152e289a876f2bf91f289b046e6b891e0c8817349d1fa3181dbd0fbe05c497ae",
      "exact_text": "    /// 构造 Action 类目标，供消费方选择命令分支。\n    ///\n    /// # 参数与返回值\n    /// `action` 转为拥有的标识；返回时参数表为空，构造时不查找或执行该命令。\n    ///\n    /// # 约束与参考\n    /// Editor 的命令消费路径要求参数为空；公开参数表仍可被调用者修改，构造器不保持该约束。\n    /// 携带具名参数的路由使用 [`Self::route`]。\n",
      "inserted_lines": 8,
      "reason": "Explain the concrete Editor empty-payload contract and distinguish the constructor postcondition from a type invariant.",
      "after_offset": 1768
    },
    {
      "id": "R052-root-03",
      "before_offset": 4116,
      "before_line": 126,
      "length": 97,
      "sha256": "4a5635d8a274553541ab418efa816b1650b570794668dd0095bf69eea7a4568f",
      "exact_text": "    /// `node_id` 按值保留为发起节点；本构造器不检查它是否属于指定树。\n",
      "inserted_lines": 1,
      "reason": "Cover the node identity parameter and leave tree membership validation with the consumer.",
      "after_offset": 5058
    },
    {
      "id": "R052-root-04",
      "before_offset": 4312,
      "before_line": 128,
      "length": 131,
      "sha256": "0c334ffb6d77466b9bd355aa0e9d75963a9b94767d1bff3fe8ab9ee56a91dc71",
      "exact_text": "    ///\n    /// # 参考\n    /// [`Self::with_drag_metrics`]、[`Self::with_compiled_binding`]、[`Self::with_template_action`]。\n",
      "inserted_lines": 3,
      "reason": "Link the optional-origin builders from the event constructor without repeating their assignments.",
      "after_offset": 5351
    }
  ],
