    "insertions": [
      {
        "id": "R051-I007",
        "kind": "helper-doc",
        "anchor": "fn intrinsic_axis_constraint() -> AxisConstraint {\n",
        "position": "before",
        "reason": "补清intrinsic命名与显式Fixed模式、负上界哨兵之间的关系。",
        "before_byte_offset": 4031,
        "byte_length": 107,
        "inserted_bytes_sha256": "ef7e029adb73d91644a1cac3ae9aedf1e38bd40cd9331e331ab1370249548baa",
        "before_line": 117,
        "after_byte_offset": 5759,
        "after_line": 141,
        "exact_text": "/// 此处仍使用 Fixed 模式；负 max 在轴解析时成为无上界，供内容驱动夹具使用。\n",
        "path": "zircon_runtime/src/ui/tests/material_layout.rs"
      },
      {
        "id": "R051-I006",
        "kind": "helper-doc",
        "anchor": "fn intrinsic_constraints() -> BoxConstraints {\n",
        "position": "before",
        "reason": "说明两个轴共享配置的夹具职责。",
        "before_byte_offset": 3865,
        "byte_length": 86,
        "inserted_bytes_sha256": "19564c0c0b3e870c80e74d95a2a51a44a7da8e82197568f3db90c546cb2e74dc",
        "before_line": 110,
        "after_byte_offset": 5507,
        "after_line": 133,
        "exact_text": "/// 为宽高分别使用下方的无上界轴配置，供内容驱动夹具复用。\n",
        "path": "zircon_runtime/src/ui/tests/material_layout.rs"
      },
      {
        "id": "R051-I005",
        "kind": "helper-doc",
        "anchor": "fn fixed_constraint(size: f32) -> AxisConstraint {\n",
        "position": "before",
        "reason": "说明固定约束夹具的控制变量及不额外验证数值的边界。",
        "before_byte_offset": 3635,
        "byte_length": 200,
        "inserted_bytes_sha256": "87881782d696eef9f0e9bc1b1b2d3a2e8b4b6fabf6333564380db8b4ac0b0c01",
        "before_line": 99,
        "after_byte_offset": 5077,
        "after_line": 120,
        "exact_text": "/// 将最小、最大与首选尺寸绑定为同一输入，建立高优先级 Fixed 轴。\n/// 不另行验证输入数值；测试通过它隔离作者固定约束与内容尺寸的优先关系。\n",
        "path": "zircon_runtime/src/ui/tests/material_layout.rs"
      },
      {
        "id": "R051-I004",
        "kind": "helper-doc",
        "anchor": "fn render_material_leaf_command(\n",
        "position": "before",
        "reason": "明确独立表面、TOML输入、默认轴配置、命令所有权与缺失命令panic。",
        "before_byte_offset": 2365,
        "byte_length": 433,
        "inserted_bytes_sha256": "0f1c4b634706a113c22d0f542d4d47c90d5b526bf49806fe415d075c208f210c",
        "before_line": 65,
        "after_byte_offset": 3374,
        "after_line": 78,
        "exact_text": "/// 在新的临时表面上布局单个组件，并取出该节点的首个渲染命令。\n///\n/// # 参数\n/// `component` 与 TOML `attributes` 构造节点自有元数据，节点使用本模块的固有尺寸约束。\n///\n/// # 返回与生命周期\n/// 返回从列表移出的自有 `UiRenderCommand`，可在临时表面销毁后继续读取。\n/// 属性解析、构树、布局失败或缺少目标命令会触发 panic。\n",
        "path": "zircon_runtime/src/ui/tests/material_layout.rs"
      },
      {
        "id": "R051-I003",
        "kind": "helper-doc",
        "anchor": "fn measure_material_leaf(\n",
        "position": "before",
        "reason": "说明组件/属性/约束输入、固定根区域、原地布局与复制输出以及panic边界。",
        "before_byte_offset": 1251,
        "byte_length": 529,
        "inserted_bytes_sha256": "d0f8ce3329ceb912ff4a98cf0c487d6a4ac7ae33226502220c7b6da7530f8937",
        "before_line": 31,
        "after_byte_offset": 1731,
        "after_line": 35,
        "exact_text": "/// 在临时表面的内容驱动根下插入单个组件，执行完整布局后读取其期望尺寸。\n///\n/// # 参数\n/// `component` 与 TOML `attributes` 构造节点自有元数据；`constraints` 直接赋给被测节点。\n/// 根布局区域固定为 240×120；属性文本须能解析为 TOML 表。\n///\n/// # 返回与生命周期\n/// 返回复制出的 `DesiredSize`；本地表面在返回后释放，不保留树节点或元数据借用。\n/// 属性解析、构树或布局失败会在夹具中触发 panic。\n",
        "path": "zircon_runtime/src/ui/tests/material_layout.rs"
      },
      {
        "id": "R051-I002",
        "kind": "bug",
        "anchor": "    assert!(source.contains(\"let Some(metrics) = MaterialLayoutMetrics::resolve(metadata) else\"));\n",
        "position": "before",
        "reason": "保留旧TODO与断言，指出由真实include_str目标闭合的既有词法断言失配。",
        "before_byte_offset": 1149,
        "byte_length": 221,
        "inserted_bytes_sha256": "9b3fcd216d303b8527b6e51a4a0a44de13602a33c9ff4e6bbb0c41d5a08c43d4",
        "before_line": 28,
        "after_byte_offset": 1408,
        "after_line": 30,
        "exact_text": "    // BUG: [CR-ZCA-R051-0001] 材料测量已改用带 Dropdown 回退的链式解析，此处旧文本锚点不存在，\n    // 因而该包含断言会失败；这里只核对了静态源码，未执行 Rust 测试。\n",
        "path": "zircon_runtime/src/ui/tests/material_layout.rs"
      },
      {
        "id": "R051-I001",
        "kind": "module-doc",
        "anchor": "//! 这里搭建真实表面测量夹具；子测试从作者布局指标到期望尺寸和绘制命令验证 Material 约束。\n",
        "position": "after",
        "reason": "补清共享夹具与词法守卫的职责、状态所有者和返回值寿命。",
        "before_byte_offset": 129,
        "byte_length": 259,
        "inserted_bytes_sha256": "685fc17741589f3155f94598575a38745a2c5665fe5509d19a8188a117126111",
        "before_line": 2,
        "after_byte_offset": 129,
        "after_line": 2,
        "exact_text": "//! 共享夹具在本地表面执行完整布局，返回自有期望尺寸或渲染命令；表面由各次调用单独创建和释放。\n//! 子模块覆盖组件行为；父模块还保留源码文本守卫，不能据此推断实际属性扫描次数。\n",
        "path": "zircon_runtime/src/ui/tests/material_layout.rs"
      }
    ],
