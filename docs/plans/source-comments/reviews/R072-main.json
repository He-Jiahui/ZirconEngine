          "after_lines": [
            127,
            128
          ]
        },
        {
          "before_line": 125,
          "exact_text": "    /// 为节点及导航种类追加回调，供当前表面生成的导航路由调用。\n    /// `node_id`、`kind` 只作为注册键；本入口不检查目标存在性。\n    /// 回调借用当前导航上下文；捕获、路由借用和夹具切换约束同\n    /// [`Self::register_pointer_handler`]，返回的决议交给表面继续处理。\n",
          "reason": "连接导航回调、借用与后续表面提交，未把注册说成执行。",
          "before_offset": 4673,
          "after_offset": 6237,
          "byte_length": 356,
