  "authority": {"entry":"docs/plans/source-comments/assignments.json#metadata_tasks.R094","canonical_sha256":"cd7e80148fd90c5b8cc85ec000741d4a78d6676291a47d19a23cb8ee5fa694dd","fresh_receipt":"3c0c40","standard_sha256":"5671f048b79d8a5d6dc39cedbbfb7150bf111edf77726e03dd0ba568d41c85c3","source_scope":["zircon_runtime/src/text/hard_line.rs","zircon_runtime/src/text/tests/hard_line.rs"],"sole_metadata":"docs/plans/source-comments/reviews/R094.json","root_owns":"global ledgers/main/post; all other source/context/fixed records remain read-only","preregistration":{"registry":"E:/cargo-targets/zircon-local/reports/source-comments-20261014-01a13a81/artifacts.json","read_sha256":"a092114a04c9b111b7b8d125e3ef831ef79fd2462d17bea05486a7b3b149b6ac","entry":"retained[366]","state":"planned-not-created","receipt":"2bc8eb"}},
  "summary": {"source_count":2,"before_lf":328,"after_lf":414,"changed_sources":2,"unchanged_sources":0,"insertions":19,"added_lf":86,"deletions":0,"implementation_functions":14,"test_functions":9,"test_helpers":1,"total_functions":24,"structs":1,"members":2,"semantic_blocks":31,"normal_tests":9,"ignored_tests":0,"assertions":29,"assert_eq":21,"assert_boolean":8,"tests_executed":0,"new_issues":0},
  "sources": [{"id":"S1","path":"zircon_runtime/src/text/hard_line.rs","before":{"sha256":"bb85fc5924b3a3e46ee1cbfdbdb677d049823dad96482ebee80df914e4de0842","bytes":6109,"lf":192,"raw_HEAD_equal":true},"after":{"sha256":"e5261d39f57c6d69418a1ad374eb48481d6a025405e5b95ec12380de40a1183c","bytes":11891,"lf":272,"crlf":0,"bom":false},"insertions":[{"id":"I01","before_offset":0,"exact_text":"//! 共享文本服务的规范硬行扫描与源偏移导航。\n//!\n//! 硬行由源分隔符确定，软换行和成形分块不在这里产生新行。\n//! 行描述中的范围是 UTF-8 字节偏移，窗口参数则是从零开始的行序号范围。\n//! 返回值只拥有范围描述；据此切片时仍须使用生成这些范围的同一份源文本。\n//! 本模块执行扫描和范围物化，资源准入由调用方及缓存入口另行决定。\n\n","byte_length":463,"sha256":"339e0efbca7c69d46ae3f57f252b6eff4126214b06950767dcb5457bfebfbfae","lf":7,"after_offset":0},{"id":"I02","before_offset":22,"exact_text":"/// 一条规范硬行在源文本中的内容与分隔符位置。\n///\n/// # 约束与生命周期\n/// 扫描器生成的两个半开字节范围依次覆盖内容和紧随其后的分隔符。\n/// 本类型不持有源文本，也不校验 crate 内直接构造的字段；使用范围切片时须保留对应文本。\n/// 参见 [visit_hard_lines] 的顺序扫描及 [HardLine::source_range] 的范围合并。\n","byte_length":414,"sha256":"c5011dc02f1c6be82ea3ecbccc9c663ade6a29955a03ed05fa0ca87afe421521","lf":6,"after_offset":485},{"id":"I03","before_offset":90,"exact_text":"    /// 不含分隔符的内容字节范围；空源和末尾分隔符后的终止行允许为空。\n","byte_length":102,"sha256":"b4c0fd76d84af3c6eec9c1440d209dcb4f1f913f0558772850ec4223ac2f6807","lf":1,"after_offset":967},{"id":"I04","before_offset":128,"exact_text":"    /// 内容后分隔符的字节范围；扫描器将 CRLF 合为一段，终止行使用空范围。\n","byte_length":105,"sha256":"829fc91b73f53a6236cd405eeaa87e01c74fbb7fd3cf2131c877cfd282fca37e","lf":1,"after_offset":1107},{"id":"I05","before_offset":187,"exact_text":"    /// 合并本行内容与分隔符的覆盖范围，返回拥有式字节范围。\n    ///\n    /// 该计算取两个终点的较大值，不验证手工构造的端点或源文本边界。\n    /// 返回值不借用本行；将其用作切片仍依赖合法字段及对应源文本。\n","byte_length":290,"sha256":"1b1c64a354f1306a7c13e1b78cf6eca1f160b58950ab2fae6870e406f5b6a37b","lf":4,"after_offset":1271},{"id":"I06","before_offset":321,"exact_text":"/// 在调用方需要完整列表时，同步物化源文本的所有规范硬行。\n///\n/// # 参数、返回与资源\n/// `text` 仅在扫描期间借用；返回向量拥有范围值，不保留文本。\n/// 空文本产生一条终止行，末尾分隔符之后也保留一条空的终止行。\n/// 分配随行数增长；只需逐行处理时可使用 [visit_hard_lines]。\n","byte_length":381,"sha256":"c08fb08d0bc4777d58585ac04ec1d25f66978fb178236411c2fb790939a8b714","lf":6,"after_offset":1695},{"id":"I07","before_offset":572,"exact_text":"///\n/// 同步按源顺序调用 `visit`，每次移交一个拥有式范围描述。\n///\n/// # 调用约束与生命周期\n/// 回调按值接收并只在本次调用内同步执行，不存入模块状态；`text` 仅在调用期间借用。\n/// 回调没有停止返回值；扫描结束时会访问终止行，包括空文本或尾随分隔符产生的空行。\n/// 本入口不保留全量行向量；回调自行保留结果时仍会占用相应资源。\n","byte_length":461,"sha256":"e453acff328c7fcc3d9386191be7bbf851554a7986077b93faf44063120e3cdd","lf":7,"after_offset":2327},{"id":"I08","before_offset":806,"exact_text":"///\n/// 对借用的 `text` 完整扫描，返回包含终止行的硬行数，空文本的结果为一。\n/// 计数使用饱和加法；本入口不物化逐行向量，也不执行工作预算准入。\n","byte_length":205,"sha256":"65d1d3cf5038ff0cf7a6e319eb3d561dc429fb2896b22f4a1ab2e3fa1b04811c","lf":3,"after_offset":3022},{"id":"I09","before_offset":1287,"exact_text":"///\n/// 对 `text` 查找任一规范分隔符并提前返回；找到时结果为真。\n/// 即使分隔符位于文本末尾，它也会产生额外的终止行；长而无分隔符的文本仍为假。\n/// 调用方据此拒绝单硬行的虚拟化候选，具体虚拟化资格仍由上层决定。\n","byte_length":303,"sha256":"69424933fe2cfda01b41d480305da67a6ee150988ec8823af4df08c8db08095a","lf":4,"after_offset":3708},{"id":"I10","before_offset":1458,"exact_text":"///\n/// # 参数、返回与扫描边界\n/// `range` 是从零开始的半开行序号范围，不是源字节范围；空或反向范围直接返回空向量。\n/// 扫描到窗口上界或文本结尾即结束，结果仅保留实际存在且落入窗口的行描述。\n/// 返回范围不保留借用的 `text`；窗口大小仍由调用方决定，不构成分配峰值上限。\n/// 同时需要总行数时使用 [hard_line_count_and_window]。\n","byte_length":450,"sha256":"15980b0d4c9edf5b7c6e2c09c1ee9c394bd892d1bed3b763afdbc1194869e412","lf":6,"after_offset":4182},{"id":"I11","before_offset":2229,"exact_text":"///\n/// # 参数、返回与资源\n/// `text` 仅在调用期间借用；`range` 选择半开的硬行序号范围。\n/// 返回完整扫描得到的总行数及拥有式窗口；空或反向窗口仍扫描并返回总数。\n/// 仅窗口内的描述进入返回向量，扫描工作量和窗口分配不由本函数执行预算准入。\n/// 有键会话可由缓存入口保留索引，本函数自身不保留文本或索引状态。\n","byte_length":436,"sha256":"68738fa09af0ff22dbf06b5d9abc698b8cd153fd1bca57ce1b1cc467aeecc0d2","lf":6,"after_offset":5403},{"id":"I12","before_offset":2677,"exact_text":"///\n/// # 参数与返回\n/// `offset` 是源字节偏移；超长值夹到文本末尾，字符内部位置向前退至 UTF-8 边界。\n/// 返回前一个完整分隔符之后的位置，找不到时为零；位于 CRLF 的 LF 字节时仍归前一行。\n/// 结果只描述该 `text` 的位置，不保留文本或计算软换行边界。\n","byte_length":342,"sha256":"9314230dd1b4c38ea4284c131692ac6df0d8a3632e4ba5f339c646a9b6679bcd","lf":5,"after_offset":6287},{"id":"I13","before_offset":3210,"exact_text":"///\n/// # 参数与返回\n/// 按 [hard_line_start] 相同规则夹取字节偏移，再查找后续分隔符的起点；没有分隔符时返回文本长度。\n/// 若偏移正落在 CRLF 的 LF 字节，返回前一个 CR 的位置，避免把这一对分隔符拆入内容。\n/// 返回的是内容终点；需要下一行起点时可传给 [next_hard_line_start]。\n","byte_length":370,"sha256":"5f845c33365e30dd3c3ccb2d80de7ecadc68ea1c012dc9c826142535506bb5a7","lf":5,"after_offset":7162},{"id":"I14","before_offset":3764,"exact_text":"///\n/// # 参数、返回与约束\n/// `line_end` 通常来自 [hard_line_end]，按字节偏移夹到有效 UTF-8 边界后检查当前位置。\n/// 位于分隔符时返回其后的字节位置，CRLF 一起跨过；当前位置不是分隔符或已到文本末尾时返回空值。\n/// 本函数不会向后搜索分隔符，返回值与输入文本使用同一源偏移空间。\n","byte_length":383,"sha256":"567465d30a39fdc3842fe04c97fd8ff3da4f93c3c12e39a202e373df04c8b557","lf":5,"after_offset":8086},{"id":"I15","before_offset":4293,"exact_text":"/// 以字符索引维护源字节位置，将 CRLF 合并后向同步回调移交行描述。\n///\n/// 回调返回假时立即结束，不再访问剩余内容或终止行；否则扫描末尾再访问终止行。\n/// `line_start` 仅在分隔符回调允许继续后推进，终止行回调的返回值不再影响后续状态。\n/// 此内部停止协议用于窗口扫描；逐行访问与完整计数包装始终要求继续。\n","byte_length":433,"sha256":"90bbd907184d1c73eaa11b30270671a6897435ad899f131999664fa0c6536a8f","lf":5,"after_offset":8998},{"id":"I16","before_offset":5264,"exact_text":"/// 判断单个字符是否属于这里列出的规范硬行分隔符。\n///\n/// 此函数只识别字符；CRLF 配对由扫描与导航入口处理，其他字符不会因空白属性而自动成为分隔符。\n","byte_length":214,"sha256":"22f6e4c32769ba051fd4ee6ca87f7256ead66f945b38473db6e269674ffaf23a","lf":3,"after_offset":10402},{"id":"I17","before_offset":5627,"exact_text":"///\n/// 反向查找的前缀尚未包含 LF 时，阻止将已看到的 CR 作为完整分隔符。\n/// 输入位置来自同一文本的字符索引；此处只判断 CRLF 前缀关系，不替代偏移夹取。\n","byte_length":214,"sha256":"e0de28711621e416d7c16936eff3aa880acc55be051566fb2530c0aca158c1ab","lf":3,"after_offset":10979},{"id":"I18","before_offset":5850,"exact_text":"/// 将任意字节偏移夹在文本范围内，并向前退到最近的 UTF-8 字符边界。\n///\n/// 返回值可用于本次借用文本的切片端点；只处理编码边界，不处理字素或硬行归属。\n","byte_length":216,"sha256":"876750091f4f81c1e010555ca8d5e6b6a5c5722a21038bf2909ace740998ea5b","lf":3,"after_offset":11416}],"functions":[{"id":"F01","name":"source_range","lines":[29,31],"span_sha256":"9717762327019f5330647800f427824228e1d19f03e3d48a918ffcff572e9418","role":"以content.start和两终点最大值构造拥有式范围；不验证手工字段。","constraints":"字段须对应同一文本；返回值不借用self或保留文本。","refs":["C06","T01"],"doc":"I05","blocks":["B01"]},{"id":"F02","name":"hard_lines","lines":[40,46],"span_sha256":"ba5fe6a673f8f717445917930d446fe33323db9c2037e102739708a4ea4b87f6","role":"同步物化完整规范硬行列表。","constraints":"源仅借用，Vec拥有范围；空文本/尾分隔符生成终止行，分配随行数增长。","refs":["C06","C07","T01","T02"],"doc":"I06","blocks":["B02"]},{"id":"F03","name":"visit_hard_lines","lines":[56,61],"span_sha256":"5c48a8bc2421fb2d549d0e4038a5c08c74bea713163ec156685cf37eb2f91d38","role":"同步FnMut按值取得各行描述，包装始终继续。","constraints":"回调和文本不留在模块中；正常完成包含终止行，回调自行保留仍占资源。","refs":["C02","hard_lines","T09"],"doc":"I07","blocks":["B03"]},{"id":"F04","name":"hard_line_count","lines":[67,74],"span_sha256":"7c616d10f69bfe329e018383d971a319b0eb5a9da5417ed77186144ddfa5f84c","role":"完整扫描并饱和累计含终止行的总数。","constraints":"空源计一；无逐行Vec或工作/几何预算准入。","refs":["C05","T03"],"doc":"I08","blocks":["B04"]},{"id":"F05","name":"has_multiple_hard_lines","lines":[85,87],"span_sha256":"f4c783fa6bb507ec202224a3661d1bc1284591ca37b63e94702355f166b547cf","role":"对规范分隔符执行any，首命中提前返回。","constraints":"尾分隔符也产生终止空行；长无分隔符源仍单行，UI资格另判。","refs":["L01","T04"],"doc":"I09","blocks":["B05"]},{"id":"F06","name":"hard_line_window","lines":[96,112],"span_sha256":"d42cb07162b32c20daf361b74f1b29eca3ce17635b45a59cd84ce10668cfa5ce","role":"以半开行序号窗口收集范围，到上界即停止。","constraints":"空/反向范围不扫描；只返回存在部分，不限制窗口分配峰值。","refs":["C01","T05","T06"],"doc":"I10","blocks":["B06","B07"]},{"id":"F07","name":"hard_line_count_and_window","lines":[124,138],"span_sha256":"72805cbdf15a30a1789cf5b52e94f9d13cf8c1b5c6561619af960d0399e7cf2b","role":"完整计数并仅保留序号窗口。","constraints":"空/反向窗口仍扫描总数；不保留文本/持久索引，不执行预算准入。","refs":["C03","T07"],"doc":"I11","blocks":["B08"]},{"id":"F08","name":"hard_line_start","lines":[146,157],"span_sha256":"c048256dd0288b11a2772407461c7ed99d4cc1c1d9dc1110cc7039526e9c5366","role":"UTF-8夹取后反向找前一完整分隔符。","constraints":"CRLF的LF位置仍归前行；无匹配返回0，不处理软换行。","refs":["C04","T08"],"doc":"I12","blocks":["B09"]},{"id":"F09","name":"hard_line_end","lines":[165,178],"span_sha256":"f89c9c4c85961080031a1d20296d021b209c6a3bdd0a582f184f433793ff0e07","role":"求夹取字节偏移处内容的终点。","constraints":"LF属于CRLF先返回CR；否则找后续分隔符起点，无匹配返回len。","refs":["C04","T08"],"doc":"I13","blocks":["B10","B11"]},{"id":"F10","name":"next_hard_line_start","lines":[186,200],"span_sha256":"f58dace47158bb87632b680fd4ea836ed788eee76f0cbcbdb52a04ce8553dc6d","role":"只检查指定位置的分隔符并跨过。","constraints":"CRLF跨2；非分隔符或末尾None，不搜索更远位置。","refs":["C04","T08"],"doc":"I14","blocks":["B12","B13","B14"]},{"id":"F11","name":"for_each_hard_line","lines":[207,236],"span_sha256":"a0ef7db2d1073122b4cfb42f8e953d766d1d237de4111889a9638a8456f4507d","role":"统一扫描/CRLF配对并维护line_start。","constraints":"FnMut为false立即结束且无终止行；正常耗尽后忽略终止回调bool。","refs":["visit_hard_lines","hard_line_count","hard_line_window","hard_line_count_and_window"],"doc":"I15","blocks":["B15","B16","B17","B18"]},{"id":"F12","name":"is_hard_line_separator","lines":[241,246],"span_sha256":"0adfac7de556145c0a818e035be7fec4a915f6869ed771bf0bb0d2bbed314b3f","role":"匹配实码的七种分隔字符。","constraints":"不按通用空白属性扩展；CRLF配对由扫描/导航处理。","refs":["C08","for_each_hard_line","has_multiple_hard_lines","hard_line_start","hard_line_end","next_hard_line_start"],"doc":"I16","blocks":["B19"]},{"id":"F13","name":"is_crlf_prefix_boundary","lines":[253,257],"span_sha256":"5fe8d016ec2f9bac7819df8ae1bce75a0b97a26ab106f261ad3105180118fdea","role":"识别反向前缀只含CR而未含LF。","constraints":"输入是同文本字符索引；谓词不替代偏移夹取。","refs":["hard_line_start"],"doc":"I17","blocks":["B20"]},{"id":"F14","name":"clamp_utf8_boundary","lines":[262,268],"span_sha256":"a0f9205610bd72558c7d74b935b7c062e289f8aeb52c95d3dc89dd32452880f6","role":"先min(len)，再向前退到UTF-8边界。","constraints":"仅编码切片边界，不是字素或硬行归属计算。","refs":["hard_line_start","hard_line_end","next_hard_line_start"],"doc":"I18","blocks":["B21"]}],"members":[{"name":"content","line":19,"lines":[19,19],"hash_scope":"