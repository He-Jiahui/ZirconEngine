            13
          ],
          "after_offset_bytes": 366,
          "length_bytes": 383,
          "sha256": "31b6fa23734b95ad9791ff37a3a79e4f7a2dc8c86052a244bf9e9b05b080368a",
          "exact_text": "/// 组件事件在目标路由、输入检查或宿主写入阶段产生的错误。\n///\n/// # 使用与生命周期\n/// 适配器选择对应变体并填入上下文，调用者可显示或序列化该独立值；它不借用宿主状态。\n/// 字符串字段只保存诊断信息，不解析路径，也不执行回滚；错误显示由派生实现使用各变体格式生成。\n",
          "before_offset_bytes": 124
        },
        {
          "before_line": 8,
          "current_lines": [
            16,
            16
          ],
          "after_offset_bytes": 854,
          "length_bytes": 48,
          "sha256": "5224f9f52abfbe49a4248f262046700b32a8dd2f606129e5acfc0001debd7ec1",
          "exact_text": "    /// 目标域未被当前消费端支持。\n",
          "before_offset_bytes": 229
        },
        {
          "before_line": 10,
          "current_lines": [
            19,
