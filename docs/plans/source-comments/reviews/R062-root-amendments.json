        {
          "before_line": 1,
          "current_lines": [
            1,
            2
          ],
          "after_offset_bytes": 0,
          "length_bytes": 108,
          "sha256": "5723281c3487a25ae3b00360b99c432abd0feef59233249dab460f0ff91cd437",
          "exact_text": "//! 宿主呈现投影的局部更新值，分别保存控件属性与保留状态的自有键值集合。\n\n",
          "before_offset_bytes": 0
        },
        {
          "before_line": 9,
          "current_lines": [
            11,
            15
          ],
          "after_offset_bytes": 437,
          "length_bytes": 413,
          "sha256": "826686c34657f8561fa02ce49f573ece4517913fe0987f7bc983fbaf030ce59c",
          "exact_text": "///\n/// # 使用与生命周期\n/// 适配器把此值放入结果交给宿主，供宿主按控件标识更新投影；是否及何时应用由消费端决定。\n/// 两个集合分别拥有键和值；同名键可以在两个域中同时出现，不持有控件或源数据的借用。\n/// 构建器只修改该值，不查找控件、不执行源数据写入，也不自动设置适配结果的刷新标志。\n",
          "before_offset_bytes": 329
        },
        {
          "before_line": 19,
          "current_lines": [
            26,
            26
          ],
          "after_offset_bytes": 1251,
          "length_bytes": 105,
          "sha256": "890bc077168f0609582522f1cee23cea2ae128606993da26736d98449273d524",
          "exact_text": "    /// 接管控件标识并创建两个空集合；返回自有投影，不验证控件是否存在。\n",
          "before_offset_bytes": 730
        },
        {
          "before_line": 27,
          "current_lines": [
            35,
            35
          ],
          "after_offset_bytes": 1571,
          "length_bytes": 111,
          "sha256": "beacab17a7caa6ca204babda4b9621361dd149c711ebbb8ea62eaa9e284b3301",
          "exact_text": "    /// 接管属性键和值并返回投影；同一属性键替换旧值，保留状态集合保持原值。\n",
          "before_offset_bytes": 945
        },
        {
          "before_line": 32,
          "current_lines": [
            41,
            41
          ],
          "after_offset_bytes": 1839,
          "length_bytes": 111,
          "sha256": "46d83a86cf1e150935f5dbe5da2881bab6968182613c86bcce0f5b1e6a963e19",
          "exact_text": "    /// 接管保留状态键和值并返回投影；同一状态键替换旧值，属性集合保持原值。\n",
          "before_offset_bytes": 1102
        }
