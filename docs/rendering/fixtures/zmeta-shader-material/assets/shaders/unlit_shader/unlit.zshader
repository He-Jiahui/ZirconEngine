kind = "surface"
version = 2
name = "Unlit Shader"
shading_model = "unlit"
wgsl_files = ["unlit.wgsl"]

[[properties]]
name = "base_color"
kind = "vec4"
required = true
default = [1.0, 1.0, 1.0, 1.0]

[properties.editor]
display_name = "Base Color"
widget = "color"

[[texture_slots]]
name = "base_color"
kind = "texture2d"
default = "white"
sampler = "linear_repeat"
group = "Surface"
label = "Base Color Texture"

[editor]
category = "Surface"
preview = "quad"
