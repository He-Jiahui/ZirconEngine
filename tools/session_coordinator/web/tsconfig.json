{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "../../zircon_hub/web/src/theme", "../../zircon_hub/web/src/components/data/HubPanel.tsx", "../../zircon_hub/web/src/components/inputs/HubButton.tsx"],
  "exclude": ["src/__tests__"]
}
