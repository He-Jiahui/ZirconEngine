{
  "schemaVersion": 1,
  "enabled": true,
  "repositoryRoot": "E:/Git/ZirconEngine",
  "authorization": {
    "source": "user",
    "instruction": "2026-10-17：降低 Jenkins 验证要求，会话自由提交；先提交，验证作为非阻断反馈，错误交回原会话自行修正。任务继续在所属分支提交，主干通过 PR 同步。",
    "scope": "Any session may commit its scoped task files immediately; optional validation reports failures for owner repair and does not gate commits or PR integration"
  },
  "requireSessionGrant": false,
  "requireSourceDigest": false,
  "requireFormalAcceptance": false,
  "controlFiles": [".codex/config.toml"],
  "pushAllowed": false,
  "notificationAllowed": false,
  "integration": {
    "mode": "branch-commit-then-scheduled-merge",
    "commitBeforeValidation": true,
    "mergeExecutor": "zircon-merge-queue",
    "mergeCron": "H/15 * * * *",
    "enabled": true,
    "sessions": "any",
    "targetBranch": "main",
    "validationRequired": false,
    "validationMode": "advisory",
    "blockCommitOnDirtyMain": false,
    "requireExpectedFileHashes": false,
    "requireRuntimeAcceptance": false,
    "repairOnValidationFailure": true,
    "requireCleanMain": true,
    "requirePullRequest": true,
    "pullRequestRepository": "He-Jiahui/ZirconEngine",
    "requireSeparateCommitApproval": false,
    "requireSeparateMergeApproval": false,
    "requireWholeWorkspaceAcceptance": false,
    "executor": "zircon-management"
  }
}
