[asset]
kind = "style"
id = "res://ui/theme/editor_workbench_strict.zui"
version = 2
display_name = "Editor Workbench Strict"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[tokens]
workbench_shell = "$editor.surface.0"
workbench_surface = "$editor.surface.1"
workbench_panel = "$editor.surface.2"
workbench_panel_raised = "$editor.surface.3"
workbench_inset = "$editor.surface.recessed"
workbench_hover = "$editor.surface.hover"
workbench_active = "$editor.surface.selected"
workbench_selected = "$editor.surface.selected"
workbench_border = "$editor.border"
workbench_border_soft = "$editor.separator.soft"
workbench_accent = "$editor.accent"
workbench_accent_2 = "$editor.accent"
workbench_accent_soft = "$editor.accent.soft"
workbench_accent_dim = "$editor.accent.soft"
workbench_toast_surface = "$editor.popup"
workbench_toast_text = "$editor.text.secondary"
workbench_toast_border = "$editor.accent.soft"
workbench_button_disabled = "$editor.surface.disabled"
workbench_button_disabled_text = "$editor.text.disabled"
workbench_button_disabled_border = "$editor.border.disabled"
workbench_text = "$editor.text.primary"
workbench_text_muted = "$editor.text.secondary"
workbench_mesh_title_text = "$editor.text.secondary"
workbench_text_dim = "$editor.text.disabled"
workbench_status_right_text = "$editor.text.secondary"
workbench_status_no_errors_fill = "$editor.semantic.success"
workbench_table_header_text = "$editor.text.secondary"
workbench_success = "$editor.semantic.success"
workbench_warning = "$editor.semantic.warning"
workbench_error = "$editor.semantic.error"
workbench_info = "$editor.semantic.info"
workbench_field = "$editor.surface.recessed"
workbench_field_hot = "$editor.surface.2"
workbench_progress_fill = "$editor.separator.strong"
workbench_field_component = "$editor.surface.recessed"
workbench_field_component_border = "$editor.border"
workbench_field_component_focused = "$editor.surface.1"
workbench_field_component_focused_text = "$editor.text.primary"
workbench_field_component_focus_border = "$editor.focus.ring"
workbench_field_component_disabled = "$editor.surface.disabled"
workbench_field_component_disabled_text = "$editor.text.disabled"
workbench_field_component_disabled_border = "$editor.border.disabled"
workbench_segmented = "$editor.surface.2"
workbench_selection_label = "$editor.text.secondary"
workbench_selection_mark = "$editor.surface.1"
workbench_selection_mark_border = "$editor.separator.strong"
workbench_checkbox_checked = "$editor.surface.selected"
workbench_radio_checked = "$editor.surface.selected"
workbench_radio_checked_border = "$editor.accent"
workbench_toggle_track = "$editor.track"
workbench_toggle_track_border = "$editor.border"
workbench_toggle_thumb = "$editor.text.secondary"
workbench_toggle_checked_track = "$editor.surface.selected"
workbench_toggle_checked_border = "$editor.accent"
workbench_toggle_checked_thumb = "$editor.text.secondary"
workbench_warning_surface = "$editor.semantic.warning.container"
workbench_error_surface = "$editor.semantic.error.container"
workbench_success_surface = "$editor.semantic.success.container"
workbench_info_surface = "$editor.semantic.info.container"

[[stylesheets]]
id = "editor_workbench_strict"

[[stylesheets.rules]]
selector = ".editor-workbench"
[stylesheets.rules.set.self]
background_color = "$workbench_shell"
foreground_color = "$workbench_text"

[[stylesheets.rules]]
selector = ".workbench-shell-root"
[stylesheets.rules.set.self]
background_color = "$workbench_shell"
foreground_color = "$workbench_text"

[[stylesheets.rules]]
selector = ".workbench-window-root"
[stylesheets.rules.set.self]
background_color = "$workbench_shell"
foreground_color = "$workbench_text"

[[stylesheets.rules]]
selector = ".workbench-topbar"
[stylesheets.rules.set.self]
background_color = "$workbench_surface"
foreground_color = "$workbench_text"
border_color = "$workbench_border"
border_width = "$editor.control.border_width"
radius = 0.0

[[stylesheets.rules]]
selector = ".workbench-strip"
[stylesheets.rules.set.self]
background_color = "$workbench_surface"
border_color = "$workbench_border_soft"
border_width = "$editor.control.border_width"
