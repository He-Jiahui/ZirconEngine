stylesheets = []

[asset]
kind = "view"
id = "res://ui/editor/inspector.zui"
version = 2
display_name = "Inspector"

[imports]
styles = ["res://ui/theme/editor_base.zui"]

[root]
node = "inspector_root"

[nodes.top_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" } }

[nodes.left_space]
component = "Space"
layout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.header_panel]
component = "Overlay"
control_id = "InspectorHeaderPanel"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width", font_weight = "$editor.typography.strong.weight", overflow = "elide" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }

[nodes.header_name_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 4.0, preferred = 4.0, max = 4.0, stretch = "Fixed" } }

[nodes.name_row]
component = "Overlay"
control_id = "InspectorNameRow"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width", text_tone = "muted", overflow = "elide" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }

[nodes.name_parent_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 4.0, preferred = 4.0, max = 4.0, stretch = "Fixed" } }

[nodes.parent_row]
component = "Overlay"
control_id = "InspectorParentRow"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width", text_tone = "muted", overflow = "elide" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }

[nodes.parent_position_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 4.0, preferred = 4.0, max = 4.0, stretch = "Fixed" } }

[nodes.position_row]
component = "Overlay"
control_id = "InspectorPositionRow"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width", text_tone = "muted", overflow = "elide" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }

[nodes.position_separator_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 4.0, preferred = 4.0, max = 4.0, stretch = "Fixed" } }

[nodes.separator_row]
component = "Space"
control_id = "InspectorSeparatorRow"
layout = { width = { stretch = "Stretch" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" } }

[nodes.separator_actions_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 4.0, preferred = 4.0, max = 4.0, stretch = "Fixed" } }

[nodes.actions_row]
component = "Overlay"
control_id = "InspectorActionsRow"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width", text_tone = "muted", overflow = "elide" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }

[nodes.empty_state_message]
component = "Label"
control_id = "InspectorEmptyStateMessage"
props = { text = "", text_tone = "muted", text_align = "center", overflow = "elide" }
layout = { anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.5 }, position = { x = 0.0, y = 0.0 }, width = { stretch = "Stretch" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = "Fixed" } }

[nodes.bottom_fill]
component = "Overlay"
control_id = "InspectorEmptyState"
props = { surface_variant = "frame_only", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "empty_state_message" }]

[nodes.content_panel]
component = "VerticalBox"
control_id = "InspectorContentPanel"
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "header_panel" }, { node = "header_name_gap" }, { node = "name_row" }, { node = "name_parent_gap" }, { node = "parent_row" }, { node = "parent_position_gap" }, { node = "position_row" }, { node = "position_separator_gap" }, { node = "separator_row" }, { node = "separator_actions_gap" }, { node = "actions_row" }, { node = "bottom_fill" }]

[nodes.right_space]
component = "Space"
layout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.content_row]
component = "HorizontalBox"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "left_space" }, { node = "content_panel" }, { node = "right_space" }]

[nodes.bottom_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" } }

[nodes.inspector_root]
component = "VerticalBox"
control_id = "InspectorRoot"
classes = ["editor-shell"]
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "top_space" }, { node = "content_row" }, { node = "bottom_space" }]
