control_id = "AssetBrowserReferenceRightScrollBody"
props = { surface_variant = "scroll-body" }
layout = { clip = true, container = { kind = "Overlay" }, anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 0.0, y = 20.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_right_empty_text" }, { node = "reference_right_row_panel" }]

[nodes.reference_right_panel]
component = "Overlay"
control_id = "AssetBrowserReferenceRightPanel"
props = { surface_variant = "frame_only" }
layout = { container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_right_title_text" }, { node = "reference_right_scroll_body" }]

[nodes.references_shell]
component = "HorizontalBox"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_left_panel" }, { node = "reference_right_panel" }]

[nodes.metadata_meta_path_label]
component = "Label"
control_id = "AssetBrowserMetaPathLabel"
props = { text = "Meta Path", text_tone = "muted" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 8.0, y = 6.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.metadata_meta_path_value]
component = "Label"
control_id = "AssetBrowserMetaPathValue"
props = { text = "", overflow = "elide" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 8.0, y = 21.0 }, width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.metadata_meta_path_panel]
component = "Overlay"
control_id = "AssetBrowserMetaPathPanel"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" } }
children = [{ node = "metadata_meta_path_label" }, { node = "metadata_meta_path_value" }]

[nodes.metadata_adapter_label]
component = "Label"
control_id = "AssetBrowserToolkitLabel"
props = { text = "Adapter", text_tone = "muted" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 8.0, y = 6.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.metadata_adapter_value]
component = "Label"
control_id = "AssetBrowserToolkitValue"
props = { text = "", overflow = "elide" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 8.0, y = 21.0 }, width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.metadata_adapter_panel]
component = "Overlay"
control_id = "AssetBrowserToolkitPanel"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" } }
children = [{ node = "metadata_adapter_label" }, { node = "metadata_adapter_value" }]

[nodes.metadata_diagnostics_label]
component = "Label"
control_id = "AssetBrowserDiagnosticsLabel"
props = { text = "Diagnostics", text_tone = "muted" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 8.0, y = 6.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.metadata_diagnostics_text]
component = "Label"
control_id = "AssetBrowserDiagnosticsText"
props = { text = "No active diagnostics" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 8.0, y = 21.0 }, width = { stretch = "Stretch" }, height = { min = 16.0, stretch = "Stretch" } }

[nodes.metadata_diagnostics_panel]
component = "Overlay"
control_id = "AssetBrowserDiagnosticsPanel"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "metadata_diagnostics_label" }, { node = "metadata_diagnostics_text" }]

[nodes.metadata_stack]
component = "VerticalBox"
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "metadata_meta_path_panel" }, { node = "metadata_adapter_panel" }, { node = "metadata_diagnostics_panel" }]

[nodes.plugins_text]
component = "Label"
control_id = "AssetBrowserPluginsText"
props = { text = "Plugin utility tabs can mount here.", text_tone = "muted", text_align = "center" }
layout = { anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.5 }, position = { x = 0.0, y = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.plugins_panel]
component = "Overlay"
control_id = "AssetBrowserPluginsPanel"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "plugins_text" }]

[nodes.utility_content_panel]
component = "Overlay"
control_id = "AssetBrowserUtilityContentPanel"
props = { surface_variant = "frame_only" }
layout = { container = { kind = "Overlay" }, anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 0.0, y = 28.0 }, width = { stretch = "Stretch" }, height = { min = 116.0, preferred = 116.0, max = 116.0, stretch = "Fixed" } }
children = [{ node = "preview_panel" }, { node = "references_shell" }, { node = "metadata_stack" }, { node = "plugins_panel" }]

[nodes.utility_panel]
component = "Overlay"
control_id = "AssetBrowserUtilityPanel"
props = { surface_variant = "frame_only" }
layout = { container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 144.0, preferred = 144.0, max = 144.0, stretch = "Fixed" } }
children = [{ node = "utility_tabs_row" }, { node = "utility_divider" }, { node = "utility_content_panel" }]

[nodes.asset_browser_root]
component = "VerticalBox"
control_id = "AssetBrowserRoot"
classes = ["workbench-shell-root"]
props = { surface_variant = "frame_only" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "toolbar_panel" }, { node = "import_panel" }, { node = "main_panel" }, { node = "utility_panel" }]
