stylesheets = []

[asset]
kind = "view"
id = "res://ui/editor/asset_browser.zui"
version = 2
display_name = "Asset Browser"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton", "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown", "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField", "res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton", "res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput", "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab", "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow"]
styles = ["res://ui/theme/editor_workbench_strict.zui"]

[root]
node = "asset_browser_root"

[nodes.toolbar_title_text]
component = "Label"
control_id = "AssetBrowserTitleText"
props = { text = "Asset Browser", font_weight = "$editor.typography.emphasis.weight", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_locate_button]
component = "WorkbenchIconButton"
control_id = "LocateSelectedAsset"
props = { label = "Locate selected asset", icon = "editor_pages/asset_browser/navigation/search.svg", icon_placement = "icon_only", dispatch_kind = "asset:browser" }
layout = { width = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetBrowserLocateSelected", event = "Click", route = "workbench.asset_browser.locate_selected" }]

[nodes.toolbar_title_row]
component = "HorizontalBox"
control_id = "AssetBrowserToolbarTitleRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 20.0, preferred = 20.0, max = 20.0, stretch = "Fixed" } }
children = [{ node = "toolbar_title_text" }]

[nodes.toolbar_subtitle_text]
component = "Label"
control_id = "AssetBrowserSubtitleText"
props = { text = "Project/assets", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_subtitle_row]
component = "HorizontalBox"
control_id = "AssetBrowserToolbarSubtitleRow"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }
children = [{ node = "toolbar_subtitle_text" }]

[nodes.toolbar_search_field]
component = "WorkbenchSearchInput"
control_id = "SearchEdited"
props = { placeholder = "Search", dispatch_kind = "asset:browser" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetBrowserSearchEdited", event = "Change", route = "workbench.asset_browser.search.edit" }]

[nodes.toolbar_search_row]
component = "HorizontalBox"
control_id = "AssetBrowserToolbarSearchRow"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "toolbar_search_field" }]

[nodes.toolbar_kind_filter_dropdown]
component = "WorkbenchDropdown"
control_id = "AssetBrowserKindFilterDropdown"
props = { value = "All", value_text = "All Types", options = ["All|label=All Types", "Texture|label=Textures", "Material|label=Materials", "Scene|label=Scenes", "Model|label=Models", "Mesh|label=Meshes", "Shader|label=Shaders", "PhysicsMaterial|label=Physics Materials", "AnimationSkeleton|label=Animation Skeletons", "AnimationClip|label=Animation Clips", "AnimationSequence|label=Animation Sequences", "AnimationGraph|label=Animation Graphs", "AnimationStateMachine|label=Animation State Machines", "UiLayout|label=UI Layouts", "UiWidget|label=UI Widgets", "UiStyle|label=UI Styles"], dispatch_kind = "asset:browser" }
layout = { width = { min = 124.0, preferred = 168.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetBrowserKindFilterChanged", event = "Change", route = "workbench.asset_browser.kind_filter.change" }]

[nodes.toolbar_kind_primary_spacer]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_view_mode_list_button]
component = "WorkbenchIconButton"
control_id = "AssetBrowserViewModeListButton"
props = { label = "List view", icon = "list-outline", icon_placement = "icon_only", dispatch_kind = "asset:browser", action_id = "workbench.asset.view_mode.set", value = "list" }
layout = { width = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetBrowserViewModeList", event = "Change", route = "workbench.asset_browser.view_mode.list" }]

[nodes.toolbar_view_mode_thumb_button]
component = "WorkbenchIconButton"
control_id = "AssetBrowserViewModeThumbButton"
props = { label = "Thumbnail view", icon = "grid-outline", icon_placement = "icon_only", dispatch_kind = "asset:browser", action_id = "workbench.asset.view_mode.set", value = "thumbnail" }
layout = { width = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetBrowserViewModeThumbnail", event = "Change", route = "workbench.asset_browser.view_mode.thumbnail" }]

[nodes.toolbar_kind_primary_row]
component = "HorizontalBox"
control_id = "AssetBrowserToolbarKindPrimaryRow"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width", z_index = -1 }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }
children = [{ node = "toolbar_kind_filter_dropdown" }, { node = "toolbar_kind_primary_spacer" }, { node = "toolbar_view_mode_list_button" }, { node = "toolbar_view_mode_thumb_button" }, { node = "toolbar_locate_button" }]

[nodes.toolbar_panel]
component = "VerticalBox"
control_id = "AssetBrowserToolbarPanel"
props = { surface_variant = "frame_only" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 100.0, preferred = 100.0, max = 100.0, stretch = "Fixed" } }
children = [{ node = "toolbar_title_row" }, { node = "toolbar_subtitle_row" }, { node = "toolbar_search_row" }, { node = "toolbar_kind_primary_row" }]

[nodes.import_left_space]
component = "Space"
layout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.import_label]
component = "Label"
control_id = "AssetBrowserImportLabel"
props = { text = "Quick Import", text_tone = "muted" }
layout = { width = { min = 86.0, preferred = 86.0, max = 86.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.import_path_field]
component = "WorkbenchField"
control_id = "AssetBrowserImportPathField"
props = { placeholder = "Drop or paste asset source path" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [{ id = "AssetsView/MeshImportPathEdited", event = "Change", route = "workbench.asset.mesh_import.path.set" }]

[nodes.import_button]
component = "WorkbenchButton"
control_id = "ImportModel"
props = { text = "Import", button_variant = "filled", button_color = "accent", dispatch_kind = "asset:browser" }
layout = { width = { min = 96.0, preferred = 96.0, max = 96.0, stretch = "Fixed" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = "Fixed" } }
events = [{ id = "Workbench/AssetBrowserImportModel", event = "Click", route = "workbench.asset_browser.import_model" }]

[nodes.import_right_space]
component = "Space"
layout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.import_panel]
component = "HorizontalBox"
control_id = "AssetBrowserImportPanel"
props = { surface_variant = "frame_only" }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" } }
children = [{ node = "import_left_space" }, { node = "import_label" }, { node = "import_path_field" }, { node = "import_button" }, { node = "import_right_space" }]

[nodes.sources_title_text]
component = "Label"
control_id = "AssetBrowserSourcesTitleText"
props = { text = "Sources", font_weight = "$editor.typography.emphasis.weight" }
layout = { position = { x = 12.0, y = 8.0 }, width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.sources_subtitle_text]
component = "Label"
control_id = "AssetBrowserSourcesSubtitleText"
props = { text = "Project/assets", text_tone = "muted", overflow = "elide" }
layout = { position = { x = 12.0, y = 27.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.sources_header_panel]
component = "Overlay"
control_id = "AssetBrowserSourcesHeaderPanel"
props = { surface_variant = "panel" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 48.0, preferred = 48.0, max = 48.0, stretch = "Fixed" } }
children = [{ node = "sources_title_text" }, { node = "sources_subtitle_text" }]

[nodes.sources_divider]
component = "Space"
control_id = "AssetBrowserSourcesDivider"
props = { surface_variant = "divider" }
layout = { position = { x = 0.0, y = 48.0 }, width = { stretch = "Stretch" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" } }

[nodes.sources_row_icon]
component = "Space"
control_id = "AssetBrowserSourcesRowIcon"
layout = { position = { x = 8.0, y = 7.0 }, width = { min = 14.0, preferred = 14.0, max = 14.0, stretch = "Fixed" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = "Fixed" } }

[nodes.sources_row_name_text]
component = "Label"
control_id = "AssetBrowserSourcesRowNameText"
props = { text = "Assets", overflow = "elide" }
layout = { position = { x = 30.0, y = 6.0 }, width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.sources_row_count_text]
component = "Label"
control_id = "AssetBrowserSourcesRowCountText"
props = { text = "0", text_tone = "muted", text_align = "right" }
layout = { position = { x = 104.0, y = 5.0 }, width = { min = 20.0, preferred = 20.0, max = 20.0, stretch = "Fixed" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.sources_row_panel]
component = "Overlay"
control_id = "AssetBrowserSourcesRowPanel"
props = { surface_variant = "asset-tree-row", radius = "$editor.control.radius.small" }
layout = { clip = true, container = { kind = "Overlay" }, position = { x = 8.0, y = 8.0 }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }
children = [{ node = "sources_row_icon" }, { node = "sources_row_name_text" }, { node = "sources_row_count_text" }]

[nodes.sources_scroll_body]
component = "Overlay"
control_id = "AssetBrowserSourcesScrollBody"
props = { surface_variant = "scroll-body" }
layout = { clip = true, container = { kind = "Overlay" }, position = { x = 0.0, y = 49.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "sources_row_panel" }]

[nodes.sources_panel]
component = "Overlay"
control_id = "AssetBrowserSourcesPanel"
props = { surface_variant = "panel", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "Overlay" }, width = { min = 188.0, preferred = 220.0, max = 250.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "sources_header_panel" }, { node = "sources_divider" }, { node = "sources_scroll_body" }]

[nodes.content_header_title_text]
component = "Label"
control_id = "AssetBrowserContentHeaderTitleText"
props = { text = "Content Browser", font_weight = "$editor.typography.emphasis.weight", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.content_header_path_text]
component = "Label"
control_id = "AssetBrowserContentHeaderPathText"
props = { text = "All assets", text_tone = "muted", text_align = "right", overflow = "elide" }
layout = { width = { min = 92.0, preferred = 92.0, max = 92.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.content_header_row]
component = "HorizontalBox"
control_id = "AssetBrowserContentHeaderRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }
children = [{ node = "content_header_title_text" }, { node = "content_header_path_text" }]

[nodes.content_asset_table_header]
component = "WorkbenchTableRow"
control_id = "WorkbenchAssetBrowserTableHeader"
props = { text = "Name Type Size Rev", surface_variant = "asset-table", border_width = "$editor.control.border_width" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }

[nodes.content_asset_row_01]
component = "WorkbenchTableRow"
control_id = "WorkbenchAssetBrowserAssetRow01"
props = { text = "Host UI 12K r42", surface_variant = "asset-table", border_width = "$editor.control.border_width" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }

[nodes.content_asset_row_02]
component = "WorkbenchTableRow"
control_id = "WorkbenchAssetBrowserAssetRow02"
props = { text = "Base Style 8K r41", surface_variant = "asset-table", border_width = "$editor.control.border_width" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }

[nodes.content_asset_row_03]
component = "WorkbenchTableRow"
control_id = "WorkbenchAssetBrowserAssetRow03"
props = { text = "Folder Tex 4K r40", surface_variant = "asset-table", border_width = "$editor.control.border_width" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }

[nodes.content_asset_row_04]
component = "WorkbenchTableRow"
control_id = "WorkbenchAssetBrowserAssetRow04"
props = { text = "A11y Widget 16K r39", surface_variant = "asset-table", border_width = "$editor.control.border_width" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }

[nodes.content_asset_table]
component = "VerticalBox"
control_id = "AssetBrowserAssetTablePanel"
props = { surface_variant = "asset-table", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = 148.0, preferred = 148.0, max = 148.0, stretch = "Fixed" } }
children = [{ node = "content_asset_table_header" }, { node = "content_asset_row_01" }, { node = "content_asset_row_02" }, { node = "content_asset_row_03" }, { node = "content_asset_row_04" }]

[nodes.content_preview_card_visual]
component = "Overlay"
control_id = "AssetBrowserContentPreviewVisual"
props = { surface_variant = "asset-placeholder-visual", radius = "$editor.control.radius.small", border_width = 0.0 }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 42.0, preferred = 42.0, max = 42.0, stretch = "Fixed" } }

[nodes.content_preview_card_name]
component = "Label"
control_id = "AssetBrowserContentPreviewName"
props = { text = "workbench_page_chrome.zui", font_weight = "$editor.typography.strong.weight", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.content_preview_card_meta]
component = "Label"
control_id = "AssetBrowserContentPreviewMeta"
props = { text = "UiLayout • Ready", text_tone = "muted", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.content_preview_card]
component = "VerticalBox"
control_id = "AssetBrowserContentPreviewCard"
props = { surface_variant = "asset-placeholder", radius = "$editor.control.radius.small", border_width = 0.0 }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" } }
children = [{ node = "content_preview_card_visual" }, { node = "content_preview_card_name" }, { node = "content_preview_card_meta" }]

[nodes.content_panel]
component = "VerticalBox"
control_id = "AssetBrowserContentPanel"
props = { surface_variant = "asset-content", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 640.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "content_header_row" }, { node = "content_asset_table" }, { node = "content_preview_card" }]

[nodes.details_header_title_text]
component = "Label"
control_id = "AssetBrowserDetailsHeaderTitleText"
props = { text = "Details", font_weight = "$editor.typography.emphasis.weight" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 12.0, y = 8.0 }, width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.details_header_selection_text]
component = "Label"
control_id = "AssetBrowserDetailsHeaderSelectionText"
props = { text = "No Asset Selected", text_tone = "muted", overflow = "elide" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 12.0, y = 27.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.details_header_panel]
component = "Overlay"
control_id = "AssetBrowserDetailsHeaderPanel"
props = { surface_variant = "inset", text_tone = "muted" }
layout = { container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 48.0, preferred = 48.0, max = 48.0, stretch = "Fixed" } }
children = [{ node = "details_header_title_text" }, { node = "details_header_selection_text" }]

[nodes.details_divider]
component = "Space"
control_id = "AssetBrowserDetailsDivider"
layout = { width = { stretch = "Stretch" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" } }

[nodes.details_left_gutter]
component = "Space"
layout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.details_preview_visual_panel]
component = "Overlay"
control_id = "AssetBrowserDetailsPreviewVisualPanel"
props = { surface_variant = "asset-placeholder-visual", radius = "$editor.control.radius.small", border_width = 0.0 }
layout = { clip = true, container = { kind = "Overlay" }, anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 8.0, y = 10.0 }, width = { min = 58.0, preferred = 58.0, max = 58.0, stretch = "Fixed" }, height = { min = 112.0, preferred = 112.0, max = 112.0, stretch = "Fixed" } }

[nodes.details_preview_name_text]
component = "Label"
control_id = "AssetBrowserDetailsPreviewNameText"
props = { text = "No Asset Selected", font_weight = "$editor.typography.emphasis.weight", overflow = "elide" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 74.0, y = 12.0 }, width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.details_preview_locator_text]
component = "Label"
control_id = "AssetBrowserDetailsPreviewLocatorText"
props = { text = "", text_tone = "subtle", overflow = "elide" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 74.0, y = 32.0 }, width = { stretch = "Stretch" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = "Fixed" } }

[nodes.details_preview_kind_text]
component = "Label"
control_id = "AssetBrowserDetailsPreviewKindText"
props = { text = "", text_tone = "muted", overflow = "elide" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 74.0, y = 50.0 }, width = { stretch = "Stretch" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = "Fixed" } }

[nodes.details_preview_identity_text]
component = "Label"
control_id = "AssetBrowserDetailsPreviewIdentityText"
props = { text = "", text_tone = "muted", overflow = "elide" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 74.0, y = 66.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.details_preview_adapter_text]
component = "Label"
control_id = "AssetBrowserDetailsPreviewToolkitText"
props = { text = "", text_tone = "muted", overflow = "elide" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 74.0, y = 82.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.details_preview_meta_path_text]
component = "Label"
control_id = "AssetBrowserDetailsPreviewMetaPathText"
props = { text = "", text_tone = "muted", overflow = "elide" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 74.0, y = 98.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.details_preview_diagnostics_text]
component = "Label"
control_id = "AssetBrowserDetailsPreviewDiagnosticsText"
props = { text = "" }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 74.0, y = 116.0 }, width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }

[nodes.details_preview_panel]
component = "Overlay"
control_id = "AssetBrowserDetailsPreviewPanel"
props = { surface_variant = "asset-placeholder", radius = "$editor.control.radius.large", border_width = 0.0 }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 150.0, preferred = 150.0, max = 150.0, stretch = "Fixed" } }
children = [{ node = "details_preview_visual_panel" }, { node = "details_preview_name_text" }, { node = "details_preview_locator_text" }, { node = "details_preview_kind_text" }, { node = "details_preview_identity_text" }, { node = "details_preview_adapter_text" }, { node = "details_preview_meta_path_text" }, { node = "details_preview_diagnostics_text" }]

[nodes.details_locator_label]
component = "Label"
