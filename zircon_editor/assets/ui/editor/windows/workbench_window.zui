[asset]
kind = "view"
id = "res://ui/editor/windows/workbench_window.zui"
version = 2
display_name = "Workbench Window"

[root]
node = "root"

[imports]
widgets = [
  "res://ui/editor/components/workbench/shell/workbench_activity_rail.zui#WorkbenchActivityRail",
  "res://ui/editor/components/workbench/modules/core/index/workbench_additional_module_workspaces.zui#WorkbenchAdditionalModuleWorkspaces",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_axis_value_field.zui#WorkbenchAxisValueField",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_checkbox.zui#WorkbenchCheckbox",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_chip.zui#WorkbenchChip",
  "res://ui/editor/components/workbench/shell/workbench_component_drawer.zui#WorkbenchComponentDrawer",
  "res://ui/editor/components/workbench/primitives/data/workbench_component_property_row.zui#WorkbenchComponentPropertyRow",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton",
  "res://ui/editor/components/workbench/shell/workbench_inspector_panel.zui#WorkbenchInspectorPanel",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/shell/workbench_main_band.zui#WorkbenchMainBand",
  "res://ui/editor/components/workbench/modules/core/index/workbench_module_workspace.zui#WorkbenchModuleWorkspace",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_alert.zui#WorkbenchAlert",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_command_palette.zui#WorkbenchCommandPalette",
  "res://ui/editor/components/workbench/floating/workbench_preferences.zui#WorkbenchPreferences",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_confirm_dialog.zui#WorkbenchConfirmDialog",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_context_menu.zui#WorkbenchContextMenu",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_dialog.zui#WorkbenchDialog",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_drag_overlay.zui#WorkbenchDragOverlay",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_notification_center.zui#WorkbenchNotificationCenter",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_popup_menu.zui#WorkbenchPopupMenu",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_radio.zui#WorkbenchRadio",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_rail_button.zui#WorkbenchRailButton",
  "res://ui/editor/components/workbench/shell/workbench_scene_tree_panel.zui#WorkbenchSceneTreePanel",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_segmented_control.zui#WorkbenchSegmentedControl",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_slider.zui#WorkbenchSlider",
  "res://ui/editor/components/workbench/shell/workbench_status_bar.zui#WorkbenchStatusBar",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_status_item.zui#WorkbenchStatusItem",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_toast.zui#WorkbenchToast",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_tooltip.zui#WorkbenchTooltip",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_toggle.zui#WorkbenchToggle",
  "res://ui/editor/components/workbench/shell/workbench_top_toolbar.zui#WorkbenchTopToolbar",
  "res://ui/editor/components/workbench/primitives/data/workbench_tree_row.zui#WorkbenchTreeRow",
  "res://ui/editor/components/workbench/shell/workbench_viewport_panel.zui#WorkbenchViewportPanel",
]
styles = ["res://ui/theme/editor_workbench_spatial.zui"]

[nodes.root]
component = "Overlay"
control_id = "WorkbenchWindowRoot"
pixel_snapping = "snap_to_pixel"
classes = ["editor-workbench", "workbench-window-root"]
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "window_content" },
  { node = "toolbar_main_menu" },
  { node = "toolbar_run_mode_menu" },
  { node = "toolbar_layout_menu" },
  { node = "toolbar_module_overflow_menu" },
  { node = "assets_world_tools_menu" },
  { node = "assets_gameplay_tools_menu" },
  { node = "assets_production_tools_menu" },
  { node = "ability_animation_tools_menu" },
  { node = "render_tools_menu" },
  { node = "hud_tools_menu" },
  { node = "notification_center" },
  { node = "toast_overlay", slot = { layout = { padding = { left = "$editor.density.gap.large", right = "$editor.density.gap.large" }, alignment = { horizontal = "End", vertical = "End" } } } },
  { node = "settings_window", slot = { layout = { padding = { left = "$editor.density.gap.large", top = "$editor.density.gap.large", right = "$editor.density.gap.large", bottom = "$editor.density.gap.large" }, alignment = { horizontal = "Center", vertical = "Center" } } } },
  { node = "command_palette" },
  { node = "context_menu" },
  { node = "host_chrome_tooltip_anchor" },
  { node = "icon_button_tooltip" },
]

[nodes.window_content]
component = "VerticalGroup"
control_id = "WorkbenchWindowContent"
classes = ["editor-workbench", "workbench-window-content"]
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "top_toolbar", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } },
  { node = "main_band", slot = { layout = { linear_size = { rule = "Stretch", value = 4.0 } } } },
  { node = "component_drawer_shell", slot = { layout = { linear_size = { rule = "StretchContent", value = 1.0 } } } },
  { node = "status_bar", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } },
]

[nodes.toolbar_main_menu]
component = "WorkbenchPopupMenu"
control_id = "WorkbenchToolbarMainMenu"
classes = ["workbench-popup-menu", "workbench-toolbar-menu"]
widget = { popup_anchor = { kind = "control", control_id = "WorkbenchToolbarMenu" }, open_property = "popup_open" }
props = { value = "Menu", value_text = "Menu", menu_items = ["Asset Browser|action=menu.item.asset_browser,icon=folder", "Open Project|action=menu.item.open_project,icon=folder", "Save Project|action=menu.item.save_project,icon=save", "---", "Command Palette|action=menu.item.command_palette,icon=search"], popup_open = false, visibility = "collapsed", placement = "bottom-start", popup_offset_y = "$editor.chrome.workbench_toolbar.popup.command_offset_y", layout_offset_y = 0.0, layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_spacing = "$editor.density.gap.small", layout_min_height = "$editor.control.height.compact", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 0.0, y = 0.0 }, width = { min = 190.0, preferred = 190.0, max = 190.0, stretch = "Fixed" }, height = { min = 160.0, preferred = 160.0, max = 160.0, stretch = "Fixed" }, z_index = 200 }

