[asset]
kind = "view"
id = "res://ui/editor/component_showcase.zui"
version = 2
display_name = "UI Component Showcase"

# Rust contract action id markers:
# ui_component_showcase.number_field_drag_update
# ui_component_showcase.slider_drag_update
# ui_component_showcase.slider_changed
# ui_component_showcase.range_slider_drag_update
# ui_component_showcase.range_slider_changed
# ui_component_showcase.tab_changed
# ui_component_showcase.tab_strip_changed
# ui_component_showcase.input_field_changed

[root]
node = "component_showcase_root"

[imports]
widgets = [
  "res://ui/editor/components/showcase/showcase_command_toolbar.zui#ShowcaseCommandToolbar",
  "res://ui/editor/components/showcase/showcase_bottom_log.zui#ShowcaseBottomLog",
  "res://ui/editor/components/showcase/showcase_category_nav.zui#ShowcaseCategoryNav",
  "res://ui/editor/components/showcase/showcase_state_panel.zui#ShowcaseStatePanel",
  "res://ui/editor/components/showcase/showcase_visual_section.zui#ShowcaseVisualSection",
  "res://ui/editor/components/showcase/showcase_input_section.zui#ShowcaseInputSection",
  "res://ui/editor/components/showcase/showcase_selection_section.zui#ShowcaseSelectionSection",
  "res://ui/editor/components/showcase/showcase_collections_section.zui#ShowcaseCollectionsSection",
]
styles = ["res://ui/theme/editor_base.zui", "res://ui/editor/theme/editor_tokens.zui"]

[[stylesheets]]
id = "component_showcase_material"

[[stylesheets.rules]]
selector = ".showcase-shell"
[stylesheets.rules.set.self]
background_color = "$editor.surface.0"
foreground_color = "$editor.text.primary"

[[stylesheets.rules]]
selector = ".showcase-panel"
[stylesheets.rules.set.self]
background_color = "$editor.surface.2"
border_color = "$editor.border"
foreground_color = "$editor.text.primary"
radius = "$editor.control.radius.panel"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".showcase-section-title"
[stylesheets.rules.set.self]
foreground_color = "$editor.text.primary"
font_size = "$editor.typography.body.size"
font_weight = "$editor.typography.emphasis.weight"

[[stylesheets.rules]]
selector = ".showcase-field"
[stylesheets.rules.set.self]
background_color = "$editor.surface.1"
foreground_color = "$editor.text.primary"
border_color = "$editor.border"
radius = "$editor.control.radius.small"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".showcase-title"
[stylesheets.rules.set.self]
foreground_color = "$editor.text.primary"
font_size = "$editor.typography.title.size"
font_weight = "$editor.typography.strong.weight"

[[stylesheets.rules]]
selector = ".showcase-muted"
[stylesheets.rules.set.self]
foreground_color = "$editor.text.secondary"
font_size = "$editor.typography.caption.size"

[[stylesheets.rules]]
selector = ".material-control"
[stylesheets.rules.set.self]
background_color = "$editor.surface.1"
foreground_color = "$editor.text.primary"
border_color = "$editor.border"
radius = "$editor.control.radius.control"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".material-control:hover"
[stylesheets.rules.set.self]
background_color = "$editor.surface.hover"
border_color = "$editor.accent"
radius = "$editor.control.radius.control"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".material-control:pressed"
[stylesheets.rules.set.self]
background_color = "$editor.surface.3"
border_color = "$editor.focus.ring"
radius = "$editor.control.radius.control"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".material-control:focus"
[stylesheets.rules.set.self]
border_color = "$editor.focus.ring"
radius = "$editor.control.radius.control"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".material-control:selected"
[stylesheets.rules.set.self]
background_color = "$editor.surface.selected"
border_color = "$editor.focus.ring"
radius = "$editor.control.radius.control"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".material-control:disabled"
[stylesheets.rules.set.self]
background_color = "$editor.surface.disabled"
foreground_color = "$editor.text.disabled"
border_color = "$editor.border.disabled"
radius = "$editor.control.radius.control"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".showcase-toolbar"
[stylesheets.rules.set.self]
background_color = "$editor.surface.1"
foreground_color = "$editor.text.primary"
border_color = "$editor.border"
radius = "$editor.control.radius.small"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".showcase-bottom-log"
[stylesheets.rules.set.self]
background_color = "$editor.surface.recessed"
foreground_color = "$editor.text.secondary"
border_color = "$editor.separator.soft"
radius = "$editor.control.radius.small"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".unreal-panel"
[stylesheets.rules.set.self]
background_color = "$editor.surface.1"
foreground_color = "$editor.text.primary"
border_color = "$editor.border"
radius = "$editor.control.radius.panel"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".unreal-command"
[stylesheets.rules.set.self]
background_color = "$editor.surface.2"
foreground_color = "$editor.text.primary"
border_color = "$editor.border"
radius = "$editor.control.radius.small"
border_width = "$editor.control.border_width"

[[stylesheets.rules]]
selector = ".unreal-accent"
[stylesheets.rules.set.self]
background_color = "$editor.accent"
foreground_color = "$editor.surface.0"
border_color = "$editor.accent"
radius = "$editor.control.radius.small"
border_width = "$editor.control.border_width"

[nodes.component_showcase_header]
component = "Label"
control_id = "UiComponentShowcaseHeader"
classes = ["showcase-title"]
props = { text = "Runtime UI Component Showcase" }
layout = { width = { stretch = "Stretch" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" } }

[nodes.component_showcase_nav]
component = "ShowcaseCategoryNav"
control_id = "ComponentShowcaseCategoryNav"
classes = ["showcase-panel"]
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.component_showcase_visual_section]
component = "ShowcaseVisualSection"
classes = ["showcase-panel", "material-surface"]
layout = { width = { stretch = "Stretch" } }

[nodes.component_showcase_input_section]
component = "ShowcaseInputSection"
classes = ["showcase-panel", "material-surface"]
layout = { width = { stretch = "Stretch" } }

[nodes.component_showcase_selection_section]
component = "ShowcaseSelectionSection"
classes = ["showcase-panel", "material-surface"]
layout = { width = { stretch = "Stretch" } }

[nodes.component_showcase_collections_section]
component = "ShowcaseCollectionsSection"
classes = ["showcase-panel", "material-surface"]
layout = { width = { stretch = "Stretch" } }

[nodes.component_showcase_content]
component = "ScrollableBox"
control_id = "ComponentShowcaseScroll"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.medium", scrollbar_visibility = "Auto" } }
children = [
  { node = "component_showcase_visual_section" },
  { node = "component_showcase_input_section" },
  { node = "component_showcase_selection_section" },
  { node = "component_showcase_collections_section" },
]

[nodes.component_showcase_state_panel]
component = "ShowcaseStatePanel"
control_id = "ComponentShowcaseStatePanel"
classes = ["showcase-panel"]
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.component_showcase_body]
component = "HorizontalBox"
control_id = "UiComponentShowcaseBody"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" } }
children = [
  { node = "component_showcase_nav", slot = { layout = { width = { min = 120.0, preferred = 180.0, max = 220.0, weight = 1.0, stretch = "Stretch" } } } },
  { node = "component_showcase_content", slot = { layout = { width = { min = "$editor.control.height.large", preferred = "$editor.control.height.default", weight = 4.0, stretch = "Stretch" } } } },
  { node = "component_showcase_state_panel", slot = { layout = { width = { min = 160.0, preferred = 260.0, max = 320.0, weight = 1.0, stretch = "Stretch" } } } },
]

[nodes.component_showcase_toolbar]
component = "ShowcaseCommandToolbar"
control_id = "ComponentShowcaseCommandToolbar"
classes = ["showcase-toolbar"]
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }

[nodes.component_showcase_bottom_log]
component = "ShowcaseBottomLog"
control_id = "ComponentShowcaseBottomLog"
classes = ["showcase-bottom-log"]
layout = { width = { stretch = "Stretch" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" } }

[nodes.component_showcase_root]
component = "VerticalBox"
control_id = "UiComponentShowcaseRoot"
classes = ["showcase-shell"]
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" } }
children = [
  { node = "component_showcase_header" },
  { node = "component_showcase_toolbar" },
  { node = "component_showcase_body" },
  { node = "component_showcase_bottom_log" },
]
