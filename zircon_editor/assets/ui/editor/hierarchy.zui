stylesheets = []

[asset]
kind = "view"
id = "res://ui/editor/hierarchy.zui"
version = 2
display_name = "Hierarchy"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput"]
styles = ["res://ui/theme/editor_workbench_strict.zui"]

[root]
node = "hierarchy_root"

[nodes.header_panel]
component = "Overlay"
control_id = "HierarchyHeaderPanel"
props = { text = "Hierarchy", surface_variant = "transparent", radius = 0.0, border_width = 0.0, text_tone = "default", text_align = "left", font_weight = "$editor.typography.strong.weight", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", overflow = "elide" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }

[nodes.header_list_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.small", preferred = "$editor.density.gap.small", max = "$editor.density.gap.small", stretch = "Fixed" } }

[nodes.search_field]
component = "WorkbenchSearchInput"
control_id = "HierarchySearchQuery"
props = { query = "", placeholder = "Search hierarchy" }
widget = { value_property = "query" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [
  { id = "Workbench/SceneSearchEdit", event = "Change", component_event = "ValueChanged", route = "workbench.hierarchy.search.edit" },
  { id = "Workbench/SceneSearchCommit", event = "Submit", component_event = "Commit", route = "workbench.hierarchy.search.commit" },
]

[nodes.search_row]
component = "HorizontalBox"
control_id = "HierarchySearchRow"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }
children = [{ node = "search_field" }]

[nodes.search_left_inset]
component = "Space"
layout = { width = { min = "$editor.density.gap.medium", preferred = "$editor.density.gap.medium", max = "$editor.density.gap.medium", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.search_right_inset]
component = "Space"
layout = { width = { min = "$editor.density.gap.medium", preferred = "$editor.density.gap.medium", max = "$editor.density.gap.medium", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.search_inset_row]
component = "HorizontalBox"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }
children = [{ node = "search_left_inset" }, { node = "search_row" }, { node = "search_right_inset" }]

[nodes.search_list_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.small", preferred = "$editor.density.gap.small", max = "$editor.density.gap.small", stretch = "Fixed" } }

[nodes.empty_state_message]
component = "Label"
control_id = "HierarchyEmptyStateMessage"
props = { text = "", text_tone = "muted", text_align = "center", overflow = "elide" }
layout = { anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.5 }, position = { x = 0.0, y = 0.0 }, width = { stretch = "Stretch" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = "Fixed" } }

[nodes.list_panel]
component = "Overlay"
control_id = "HierarchyListPanel"
props = { surface_variant = "transparent", radius = 0.0, border_width = 0.0, overflow = "elide" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "empty_state_message" }]

[nodes.hierarchy_root]
component = "VerticalBox"
control_id = "HierarchyRoot"
classes = ["workbench-shell-root"]
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "header_panel" }, { node = "header_list_gap" }, { node = "search_inset_row" }, { node = "search_list_gap" }, { node = "list_panel" }]
