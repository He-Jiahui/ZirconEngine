stylesheets = []

[asset]
kind = "view"
id = "res://ui/editor/hierarchy.zui"
version = 2
display_name = "Hierarchy"

[imports]
styles = ["res://ui/theme/editor_base.zui"]

[root]
node = "hierarchy_root"

[nodes.top_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 8.0, preferred = 8.0, max = 8.0, stretch = "Fixed" } }

[nodes.left_space]
component = "Space"
layout = { width = { min = 8.0, preferred = 8.0, max = 8.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.header_panel]
component = "Overlay"
control_id = "HierarchyHeaderPanel"
props = { surface_variant = "inset", radius = 4.0, border_width = 1.0, font_weight = 600, overflow = "elide" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.header_list_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 4.0, preferred = 4.0, max = 4.0, stretch = "Fixed" } }

[nodes.search_field]
component = "TextField"
control_id = "HierarchySearchQuery"
props = { value = "", placeholder = "Search hierarchy", edit_action_id = "HierarchySearchQuery", surface_variant = "inset", border_width = 1.0, corner_radius = 4.0 }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.search_row]
component = "HorizontalBox"
control_id = "HierarchySearchRow"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
children = [{ node = "search_field" }]

[nodes.search_list_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 4.0, preferred = 4.0, max = 4.0, stretch = "Fixed" } }

[nodes.empty_state_message]
component = "Label"
control_id = "HierarchyEmptyStateMessage"
props = { text = "", text_tone = "muted", text_align = "center", overflow = "elide" }
layout = { anchor = { x = 0.5, y = 0.5 }, pivot = { x = 0.5, y = 0.5 }, position = { x = 0.0, y = 0.0 }, width = { stretch = "Stretch" }, height = { min = 18.0, preferred = 18.0, max = 18.0, stretch = "Fixed" } }

[nodes.list_panel]
component = "Overlay"
control_id = "HierarchyListPanel"
props = { surface_variant = "inset", radius = 4.0, border_width = 1.0, overflow = "elide" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "empty_state_message" }]

[nodes.content_panel]
component = "VerticalBox"
control_id = "HierarchyContentPanel"
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "header_panel" }, { node = "header_list_gap" }, { node = "search_row" }, { node = "search_list_gap" }, { node = "list_panel" }]

[nodes.right_space]
component = "Space"
layout = { width = { min = 8.0, preferred = 8.0, max = 8.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.content_row]
component = "HorizontalBox"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "left_space" }, { node = "content_panel" }, { node = "right_space" }]

[nodes.bottom_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 8.0, preferred = 8.0, max = 8.0, stretch = "Fixed" } }

[nodes.hierarchy_root]
component = "VerticalBox"
control_id = "HierarchyRoot"
classes = ["editor-shell"]
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "top_space" }, { node = "content_row" }, { node = "bottom_space" }]
