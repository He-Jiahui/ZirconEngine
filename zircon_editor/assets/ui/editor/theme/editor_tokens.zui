[asset]
kind = "theme_tokens"
id = "zircon.editor.workbench"
version = 2
display_name = "Zircon Editor Workbench Tokens"

[palette]
surface = ["#111416", "#171a1d", "#1b1f23", "#252b31"]
surface_recessed = "#0f1316"
surface_hover = "#2a3036"
surface_selected = "#173942"
surface_disabled = "#22272b"
accent = "#2aa6b8"
accent_soft = "#17434d"
border = "#323a41"
border_disabled = "#2c3237"
separator_strong = "#414b54"
separator_soft = "#262d33"
text_primary = "#e8ecee"
text_secondary = "#a4aeb4"
text_disabled = "#656f76"
success = "#55be78"
success_container = "#1d472f"
info = "#5faae6"
info_container = "#18395b"
warning = "#dcac50"
warning_container = "#463112"
error = "#eb605c"
error_container = "#4c2427"
popup = "#141618"
track = "#2c3339"
focus_ring = "#38bdd0"
shadow = "#00000073"

[typography]
ui_family = "system-ui"
ui_strong_family = "system-ui"
code_family = "monospace"
utility_tab_text_role = "ui"
body_size = 10.0
caption_size = 8.5
title_size = 14.0
body_weight = 400
strong_weight = 600
code_weight = 400
line_height = 1.2

[controls]
default_height = 32.0
compact_height = 32.0
dense_height = 28.0
small_radius = 4.0
control_radius = 5.0
large_radius = 8.0
panel_radius = 8.0
border_width = 1.0

[density]
gap_small = 4.0
gap_medium = 8.0
gap_large = 12.0
drawer_padding = 12.0
panel_padding = 16.0
row_height = 28.0
left_drawer_width = 332.0
right_drawer_width = 404.0
bottom_output_height = 228.0
breakpoint_ultra_width = 480.0
breakpoint_narrow_width = 640.0
breakpoint_wide_width = 1260.0
compact_side_width = 1100.0
ultra_compact_side_width = 760.0
compact_left_drawer_max_width = 340.0
compact_right_drawer_max_width = 220.0
compact_side_min_width = 196.0
ultra_compact_left_drawer_max_width = 220.0
ultra_compact_right_drawer_max_width = 160.0
compact_bottom_available_height = 900.0
compact_bottom_max_height = 148.0
compact_bottom_max_available_fraction = 0.23
compact_bottom_min_height = 120.0
ultra_compact_bottom_available_height = 420.0
ultra_compact_bottom_max_height = 96.0
ultra_compact_bottom_max_available_fraction = 0.20
ultra_compact_bottom_min_height = 80.0
minimum_window_width = 640.0
minimum_window_height = 420.0
ultra_minimum_window_width = 420.0
ultra_minimum_window_height = 360.0

[state_roles]
default = "surface_1"
hovered = "surface_2"
pressed = "surface_3"
selected = "surface_selected"
focused = "surface_selected"
disabled = "text_disabled"
loading = "accent"

[names.palette]
surface_0 = "editor.surface.0"
surface_1 = "editor.surface.1"
surface_2 = "editor.surface.2"
surface_3 = "editor.surface.3"
surface_recessed = "editor.surface.recessed"
surface_hover = "editor.surface.hover"
surface_selected = "editor.surface.selected"
surface_disabled = "editor.surface.disabled"
accent = "editor.accent"
accent_soft = "editor.accent.soft"
border = "editor.border"
border_disabled = "editor.border.disabled"
separator_strong = "editor.separator.strong"
separator_soft = "editor.separator.soft"
text_primary = "editor.text.primary"
text_secondary = "editor.text.secondary"
text_disabled = "editor.text.disabled"
success = "editor.semantic.success"
success_container = "editor.semantic.success.container"
info = "editor.semantic.info"
info_container = "editor.semantic.info.container"
warning = "editor.semantic.warning"
warning_container = "editor.semantic.warning.container"
error = "editor.semantic.error"
error_container = "editor.semantic.error.container"
popup = "editor.popup"
track = "editor.track"
focus_ring = "editor.focus.ring"
shadow = "editor.shadow"

[names.controls]
default_height = "editor.control.height.default"
compact_height = "editor.control.height.compact"
dense_height = "editor.control.height.dense"
small_radius = "editor.control.radius.small"
control_radius = "editor.control.radius.control"
large_radius = "editor.control.radius.large"
panel_radius = "editor.control.radius.panel"
border_width = "editor.control.border_width"

[names.density]
gap_small = "editor.density.gap.small"
gap_medium = "editor.density.gap.medium"
gap_large = "editor.density.gap.large"
drawer_padding = "editor.density.drawer_padding"
panel_padding = "editor.density.panel_padding"
row_height = "editor.density.row_height"
left_drawer_width = "--left-drawer-width"
right_drawer_width = "--right-drawer-width"
bottom_output_height = "--bottom-output-height"
breakpoint_ultra_width = "--breakpoint-ultra-width"
breakpoint_narrow_width = "--breakpoint-narrow-width"
breakpoint_wide_width = "--breakpoint-wide-width"
compact_side_width = "--compact-side-width"
ultra_compact_side_width = "--ultra-compact-side-width"
compact_left_drawer_max_width = "--compact-left-drawer-max-width"
compact_right_drawer_max_width = "--compact-right-drawer-max-width"
compact_side_min_width = "--compact-side-min-width"
ultra_compact_left_drawer_max_width = "--ultra-compact-left-drawer-max-width"
ultra_compact_right_drawer_max_width = "--ultra-compact-right-drawer-max-width"
compact_bottom_available_height = "--compact-bottom-available-height"
compact_bottom_max_height = "--compact-bottom-max-height"
compact_bottom_max_available_fraction = "--compact-bottom-max-available-fraction"
compact_bottom_min_height = "--compact-bottom-min-height"
ultra_compact_bottom_available_height = "--ultra-compact-bottom-available-height"
ultra_compact_bottom_max_height = "--ultra-compact-bottom-max-height"
ultra_compact_bottom_max_available_fraction = "--ultra-compact-bottom-max-available-fraction"
ultra_compact_bottom_min_height = "--ultra-compact-bottom-min-height"
minimum_window_width = "--minimum-window-width"
minimum_window_height = "--minimum-window-height"
ultra_minimum_window_width = "--ultra-minimum-window-width"
ultra_minimum_window_height = "--ultra-minimum-window-height"
