[asset]
kind = "theme_tokens"
id = "res://ui/editor/theme/editor_tokens.zui"
version = 2
display_name = "Zircon Editor Workbench Tokens"

[palette]
surface = ["#111416", "#171a1d", "#1b1f23", "#252b31"]
surface_recessed = "#0f1316"
surface_hover = "#2a3036"
surface_selected = "#173942"
surface_disabled = "#22272b"
accent = "#3cc7d6"
accent_soft = "#17434d"
border = "#323a41"
border_disabled = "#2c3237"
separator_strong = "#414b54"
separator_soft = "#262d33"
text_primary = "#e8ecee"
text_secondary = "#a4aeb4"
text_disabled = "#656f76"
success = "#55be78"
success_container = "#1d472f"
info = "#5faae6"
info_container = "#18395b"
warning = "#dcac50"
warning_container = "#463112"
error = "#eb605c"
error_container = "#4c2427"
popup = "#141618"
track = "#2c3339"
focus_ring = "#38bdd0"
shadow = "#00000073"

[typography]
ui_family = "system-ui"
ui_strong_family = "system-ui"
code_family = "monospace"
utility_tab_text_role = "ui"
font_smoothing = "grayscale"
body_size = 13.333333
caption_size = 10.666667
overlay_size = 12.0
title_size = 18.666667
body_weight = 400
medium_weight = 500
strong_weight = 600
emphasis_weight = 700
code_weight = 400
line_height = 1.2

[controls]
large_height = 48.0
default_height = 32.0
compact_height = 30.0
dense_height = 28.0
small_radius = 6.0
control_radius = 8.0
large_radius = 10.0
panel_radius = 12.0
pill_radius = 999.0
border_width = 1.0

[chrome]
top_bar_height = 25.0
host_bar_height = 32.0
status_bar_height = 24.0
panel_header_height = 25.0
document_header_height = 31.0
viewport_toolbar_height = 28.0
activity_rail_width = 34.0
separator_thickness = 1.0
splitter_hit_size = 8.0

[density]
