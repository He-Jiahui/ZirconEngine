children = [{ node = "generated_bottom_route_table_horizontal_viewport" }, { node = "generated_bottom_detail_panel" }]

# Each supported ScrollableBox owns one offset. Compose perpendicular owners
# so route rows retain vertical scrolling while wide columns remain reachable.
[nodes.generated_bottom_route_table_horizontal_viewport]
component = "ScrollableBox"
control_id = "WorkbenchGeneratedBottomRouteTableHorizontalViewport"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Horizontal", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
