[asset]
kind = "component"
id = "res://ui/editor/modules/generated/generated_bottom_panel.zui"
version = 2
display_name = "Workbench Generated Bottom Panel"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/field.zui#WorkbenchField",
  "res://ui/editor/workbench/primitives/chrome/section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/inputs/tab.zui#WorkbenchTab",
  "res://ui/editor/workbench/primitives/data/table_row.zui#WorkbenchTableRow",
]
styles = ["res://ui/editor/unreal/starship.zui"]

[components.WorkbenchGeneratedBottomPanel]
root = "generated_bottom_panel"
default_classes = ["unreal-generated-bottom-panel", "unreal-dock"]

[nodes.generated_bottom_panel]
component = "VerticalGroup"
control_id = "WorkbenchGeneratedBottomPanel"
classes = ["unreal-generated-bottom-panel", "unreal-dock"]
props = { visibility = "visible" }
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "generated_bottom_header" }, { node = "generated_bottom_body" }]

[nodes.generated_bottom_header]
component = "HorizontalGroup"
control_id = "WorkbenchGeneratedBottomHeader"
classes = ["unreal-editor-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = "$editor.chrome.workbench_toolbar.command_row.height", preferred = "$editor.chrome.workbench_toolbar.command_row.height", max = 36.0, stretch = "Fixed" } }
children = [{ node = "generated_bottom_title" }, { node = "generated_bottom_modes" }, { node = "generated_bottom_filter_field" }, { node = "generated_bottom_open_button" }, { node = "generated_bottom_pin_button" }]

[nodes.generated_bottom_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchGeneratedBottomTitle"
classes = ["unreal-dock-tab"]
props = { text = "Developer Tools", responsive_min_tier = "narrow" }
style = { self = { foreground_color = "$unreal_foreground_header", font_family = "$unreal_font_family", font_size = "$unreal_font_size", font_weight = "$unreal_font_weight", line_height_ratio = 1.2 } }
layout = { width = { min = 160.0, preferred = 196.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.generated_bottom_open_button]
component = "WorkbenchButton"
control_id = "WorkbenchGeneratedBottomOpenButton"
classes = ["unreal-control", "unreal-toolbar-control"]
props = { text = "Open", button_variant = "filled", button_color = "accent" }
style = { self = { button_variant = "text", background_color = "$unreal_panel", hover_background_color = "#575757", pressed_background_color = "$unreal_primary_press", selected_background_color = "$unreal_primary", selected_border_color = "$unreal_primary", selected_foreground_color = "$unreal_foreground_hover", disabled_background_color = "$unreal_panel", border_color = "$unreal_input_outline", focus_border_color = "$unreal_primary", disabled_border_color = "$unreal_panel", foreground_color = "$unreal_foreground", disabled_foreground_color = "$unreal_foreground_disabled", border_width = 0.0, corner_radius = 4.0, layout_padding_left = 4.0, layout_padding_right = 4.0, layout_padding_top = 3.0, layout_padding_bottom = 4.0, font_family = "$unreal_font_family", font_size = "$unreal_font_size", font_weight = "$unreal_font_weight", line_height_ratio = 1.2 } }
layout = { width = { min = 76.0, preferred = 76.0, max = 86.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "WorkbenchGeneratedBottom/OpenPanel", event = "Click", route = "workbench.generated_bottom.command.open" }]

[nodes.generated_bottom_pin_button]
component = "WorkbenchButton"
control_id = "WorkbenchGeneratedBottomPinButton"
classes = ["unreal-control", "unreal-toolbar-control"]
props = { text = "Pin", button_variant = "outlined", button_color = "secondary" }
style = { self = { button_variant = "text", background_color = "$unreal_panel", hover_background_color = "#575757", pressed_background_color = "$unreal_primary_press", selected_background_color = "$unreal_primary", selected_border_color = "$unreal_primary", selected_foreground_color = "$unreal_foreground_hover", disabled_background_color = "$unreal_panel", border_color = "$unreal_input_outline", focus_border_color = "$unreal_primary", disabled_border_color = "$unreal_panel", foreground_color = "$unreal_foreground", disabled_foreground_color = "$unreal_foreground_disabled", border_width = 0.0, corner_radius = 4.0, layout_padding_left = 4.0, layout_padding_right = 4.0, layout_padding_top = 3.0, layout_padding_bottom = 4.0, font_family = "$unreal_font_family", font_size = "$unreal_font_size", font_weight = "$unreal_font_weight", line_height_ratio = 1.2 } }
layout = { width = { min = 68.0, preferred = 68.0, max = 78.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "WorkbenchGeneratedBottom/PinPanel", event = "Click", route = "workbench.generated_bottom.command.pin" }]

[nodes.generated_bottom_modes]
component = "ScrollableBox"
control_id = "WorkbenchGeneratedBottomModes"
classes = ["unreal-editor-toolbar"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Horizontal", gap = "$editor.density.gap.regular", scrollbar_visibility = "Never" }, input_policy = "Receive", width = { min = 0.0, stretch = "Stretch" }, height = { min = "$editor.chrome.workbench_toolbar.command_row.height", preferred = "$editor.chrome.workbench_toolbar.command_row.height", max = 36.0, stretch = "Fixed" } }
