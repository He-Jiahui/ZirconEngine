props = { text = "Output Log" }
style = { self = { background_color = "$unreal_background", hover_background_color = "$unreal_panel", pressed_background_color = "$unreal_panel", selected_background_color = "$unreal_panel", selected_border_color = "$unreal_primary", selected_underline_color = "$unreal_primary", selected_foreground_color = "$unreal_foreground_hover", disabled_background_color = "$unreal_background", border_color = "$unreal_background", focus_border_color = "$unreal_primary", disabled_border_color = "$unreal_background", foreground_color = "$unreal_foreground", disabled_foreground_color = "$unreal_foreground_disabled", border_width = 0.0, corner_radius = 0.0, tab_font_size = "$unreal_font_size", tab_line_height_ratio = 1.2, tab_text_inset_x = 4.0, layout_padding_left = 4.0, layout_padding_right = 10.0, layout_padding_top = 3.0, layout_padding_bottom = 4.0, font_family = "$unreal_font_family", font_size = "$unreal_font_size", font_weight = "$unreal_font_weight", line_height_ratio = 1.2 } }
layout = { width = { min = 94.0, preferred = 94.0, max = 112.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchGeneratedBottom/ModeOutput", event = "Click", route = "workbench.generated_bottom.mode.output" }]

