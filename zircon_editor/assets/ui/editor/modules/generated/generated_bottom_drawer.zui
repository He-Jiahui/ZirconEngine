[asset]
kind = "component"
id = "res://ui/editor/modules/generated/generated_bottom_drawer.zui"
version = 2
display_name = "Workbench Generated Bottom Drawer"

[imports]
widgets = [
  "res://ui/editor/modules/generated/generated_bottom_panel.zui#WorkbenchGeneratedBottomPanel",
]
styles = ["res://ui/editor/unreal/starship.zui"]

[components.WorkbenchGeneratedBottomDrawer]
root = "generated_bottom_drawer"
default_classes = ["unreal-content-drawer"]

[nodes.generated_bottom_drawer]
component = "Overlay"
control_id = "WorkbenchGeneratedBottomDrawer"
classes = ["unreal-content-drawer"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "generated_bottom_panel" }]

[nodes.generated_bottom_panel]
component = "WorkbenchGeneratedBottomPanel"
control_id = "WorkbenchGeneratedBottomPanelHost"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
