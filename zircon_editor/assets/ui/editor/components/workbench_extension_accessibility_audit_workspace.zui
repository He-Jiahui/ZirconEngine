[asset]
kind = "component"
id = "res://ui/editor/components/workbench_extension_accessibility_audit_workspace.zui"
version = 2
display_name = "Workbench Extension Accessibility Audit Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionAccessibilityAuditWorkspace]
root = "accessibility_audit_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.accessibility_audit_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_rail_gap" }, { node = "accessibility_audit_left" }, { node = "accessibility_audit_center" }, { node = "accessibility_audit_right" }]

[nodes.accessibility_audit_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionAccessibilityAuditRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.accessibility_audit_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_title" }, { node = "accessibility_audit_issues_tab" }, { node = "accessibility_audit_rules_tab" }, { node = "accessibility_audit_fixes_tab" }, { node = "accessibility_audit_gameplay_hud_row" }, { node = "accessibility_audit_contrast_issue_row" }, { node = "accessibility_audit_focus_issue_row" }]

[nodes.accessibility_audit_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionAccessibilityAuditTitle"
props = { text = "Accessibility Audit" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.accessibility_audit_issues_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionAccessibilityAuditIssuesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Issues", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditIssuesTab", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Issues" }]

[nodes.accessibility_audit_rules_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionAccessibilityAuditRulesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Rules", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditRulesTab", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Rules" }]

[nodes.accessibility_audit_fixes_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionAccessibilityAuditFixesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Fixes", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditFixesTab", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Fixes" }]

[nodes.accessibility_audit_gameplay_hud_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionAccessibilityAuditGameplayHudRow"
classes = ["workbench-list-row"]
props = { text = "Gameplay_HUD", icon = "check", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditGameplayHudRow", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Screen.GameplayHud" }]

[nodes.accessibility_audit_contrast_issue_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionAccessibilityAuditContrastIssueRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Issue_Contrast_04", icon = "alert", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditContrastIssueRow", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Issue.Contrast" }]

[nodes.accessibility_audit_focus_issue_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionAccessibilityAuditFocusIssueRow"
classes = ["workbench-list-row"]
props = { text = "Issue_Focus_02", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditFocusIssueRow", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Issue.Focus" }]

[nodes.accessibility_audit_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_center_header" }, { node = "accessibility_audit_table" }, { node = "accessibility_audit_output" }]

[nodes.accessibility_audit_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "accessibility_audit_center_title" }, { node = "accessibility_audit_header_fill" }, { node = "accessibility_audit_audit_button" }, { node = "accessibility_audit_preview_fix_button" }]

[nodes.accessibility_audit_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionAccessibilityAuditCenterTitle"
props = { text = "Accessibility Issues" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.accessibility_audit_header_fill]
component = "Container"
control_id = "WorkbenchExtensionAccessibilityAuditHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.accessibility_audit_audit_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionAccessibilityAuditAuditScreenButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Audit Screen", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 106.0, preferred = 106.0, max = 116.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditAuditScreen", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.AuditScreen" }]

[nodes.accessibility_audit_preview_fix_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionAccessibilityAuditPreviewFixButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview Fix", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 104.0, preferred = 104.0, max = 114.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditPreviewFix", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.PreviewFix" }]

[nodes.accessibility_audit_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_contrast_table_row" }, { node = "accessibility_audit_focus_table_row" }, { node = "accessibility_audit_target_table_row" }, { node = "accessibility_audit_motion_table_row" }]

[nodes.accessibility_audit_contrast_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditContrastTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Contrast", value_text = "AmmoText   High   Token" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditContrastTableRow", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Row.Contrast" }]

[nodes.accessibility_audit_focus_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditFocusTableRow"
classes = ["workbench-table-row"]
props = { text = "Focus Order", value_text = "InventoryGrid   Medium   Reorder" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditFocusTableRow", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Row.Focus" }]

[nodes.accessibility_audit_target_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditTargetSizeTableRow"
classes = ["workbench-table-row"]
props = { text = "Target Size", value_text = "MapButton   Low   Resize" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditTargetSizeTableRow", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Row.TargetSize" }]

[nodes.accessibility_audit_motion_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditMotionTableRow"
classes = ["workbench-table-row"]
props = { text = "Motion", value_text = "HitFlash   Medium   Reduce" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditMotionTableRow", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Row.Motion" }]

[nodes.accessibility_audit_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAccessibilityAuditOutputRow"
classes = ["workbench-table-row"]
props = { text = "Accessibility Audit", value_text = "9 issues   1 critical   42 pass" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AccessibilityAuditOutput", event = "Click", route = "WorkbenchExtension.AccessibilityAudit.Output" }]

[nodes.accessibility_audit_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAccessibilityAuditRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "accessibility_audit_details_title" }, { node = "accessibility_audit_screen_dropdown" }, { node = "accessibility_audit_rule_set_dropdown" }, { node = "accessibility_audit_breakpoint_field" }]

[nodes.accessibility_audit_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionAccessibilityAuditDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.accessibility_audit_screen_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionAccessibilityAuditScreenDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Gameplay_HUD", value = "Gameplay_HUD", options = ["Gameplay_HUD", "Pause_Menu", "Rule_Set_A"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/AccessibilityAuditScreenEdit", event = "Change", route = "WorkbenchExtension.AccessibilityAudit.Screen.Edit" },
  { id = "WorkbenchExtension/AccessibilityAuditScreenCommit", event = "Submit", route = "WorkbenchExtension.AccessibilityAudit.Screen.Commit" },
]

[nodes.accessibility_audit_rule_set_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionAccessibilityAuditRuleSetDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "WCAG AA", value = "WCAG AA", options = ["WCAG AA", "WCAG AAA", "Console Safe"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/AccessibilityAuditRuleSetEdit", event = "Change", route = "WorkbenchExtension.AccessibilityAudit.RuleSet.Edit" },
  { id = "WorkbenchExtension/AccessibilityAuditRuleSetCommit", event = "Submit", route = "WorkbenchExtension.AccessibilityAudit.RuleSet.Commit" },
]

[nodes.accessibility_audit_breakpoint_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionAccessibilityAuditBreakpointField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Breakpoint: Desktop" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/AccessibilityAuditBreakpointEdit", event = "Change", route = "WorkbenchExtension.AccessibilityAudit.Breakpoint.Edit" },
  { id = "WorkbenchExtension/AccessibilityAuditBreakpointCommit", event = "Submit", route = "WorkbenchExtension.AccessibilityAudit.Breakpoint.Commit" },
]
