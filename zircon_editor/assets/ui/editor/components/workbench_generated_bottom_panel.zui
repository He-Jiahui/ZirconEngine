[asset]
kind = "component"
id = "res://ui/editor/components/workbench_generated_bottom_panel.zui"
version = 2
display_name = "Workbench Generated Bottom Panel"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchGeneratedBottomPanel]
root = "generated_bottom_panel"
default_classes = ["workbench-generated-bottom-panel", "workbench-panel"]

[nodes.generated_bottom_panel]
component = "VerticalGroup"
control_id = "WorkbenchGeneratedBottomPanel"
classes = ["workbench-generated-bottom-panel", "workbench-panel"]
props = { visibility = "visible" }
layout = { clip = true, container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "generated_bottom_header" }, { node = "generated_bottom_modes" }, { node = "generated_bottom_filter_bar" }, { node = "generated_bottom_body" }]

[nodes.generated_bottom_header]
component = "HorizontalGroup"
control_id = "WorkbenchGeneratedBottomHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "generated_bottom_title" }, { node = "generated_bottom_header_fill" }, { node = "generated_bottom_open_button" }, { node = "generated_bottom_pin_button" }]

[nodes.generated_bottom_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchGeneratedBottomTitle"
props = { text = "Generated Bottom Panels" }
layout = { width = { min = 250.0, preferred = 250.0, max = 320.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.generated_bottom_header_fill]
component = "Container"
control_id = "WorkbenchGeneratedBottomHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.generated_bottom_open_button]
component = "WorkbenchButton"
control_id = "WorkbenchGeneratedBottomOpenButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Open", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 76.0, preferred = 76.0, max = 86.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchGeneratedBottom/OpenPanel", event = "Click", route = "WorkbenchGeneratedBottom.Command.Open" }]

[nodes.generated_bottom_pin_button]
component = "WorkbenchButton"
control_id = "WorkbenchGeneratedBottomPinButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Pin", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 68.0, preferred = 68.0, max = 78.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchGeneratedBottom/PinPanel", event = "Click", route = "WorkbenchGeneratedBottom.Command.Pin" }]

[nodes.generated_bottom_modes]
component = "HorizontalGroup"
control_id = "WorkbenchGeneratedBottomModes"
classes = ["workbench-panel-tabs"]
layout = { container = { kind = "HorizontalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "generated_bottom_mode_output" }, { node = "generated_bottom_mode_build" }, { node = "generated_bottom_mode_validation" }, { node = "generated_bottom_mode_runtime" }, { node = "generated_bottom_mode_review" }]

[nodes.generated_bottom_mode_output]
component = "WorkbenchTab"
control_id = "WorkbenchGeneratedBottomModeOutput"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Output", checked = true, selected = true, value = true }
layout = { width = { min = 94.0, preferred = 94.0, max = 112.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchGeneratedBottom/ModeOutput", event = "Click", route = "WorkbenchGeneratedBottom.Mode.Output" }]

[nodes.generated_bottom_mode_build]
component = "WorkbenchTab"
control_id = "WorkbenchGeneratedBottomModeBuild"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Build", checked = false, selected = false, value = false }
layout = { width = { min = 88.0, preferred = 88.0, max = 106.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchGeneratedBottom/ModeBuild", event = "Click", route = "WorkbenchGeneratedBottom.Mode.Build" }]

[nodes.generated_bottom_mode_validation]
component = "WorkbenchTab"
control_id = "WorkbenchGeneratedBottomModeValidation"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Validation", checked = false, selected = false, value = false }
layout = { width = { min = 118.0, preferred = 118.0, max = 140.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchGeneratedBottom/ModeValidation", event = "Click", route = "WorkbenchGeneratedBottom.Mode.Validation" }]

[nodes.generated_bottom_mode_runtime]
component = "WorkbenchTab"
control_id = "WorkbenchGeneratedBottomModeRuntime"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Runtime", checked = false, selected = false, value = false }
layout = { width = { min = 104.0, preferred = 104.0, max = 124.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchGeneratedBottom/ModeRuntime", event = "Click", route = "WorkbenchGeneratedBottom.Mode.Runtime" }]

[nodes.generated_bottom_mode_review]
component = "WorkbenchTab"
control_id = "WorkbenchGeneratedBottomModeReview"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Review", checked = false, selected = false, value = false }
layout = { width = { min = 96.0, preferred = 96.0, max = 116.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchGeneratedBottom/ModeReview", event = "Click", route = "WorkbenchGeneratedBottom.Mode.Review" }]

[nodes.generated_bottom_filter_bar]
component = "HorizontalGroup"
control_id = "WorkbenchGeneratedBottomFilterBar"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "generated_bottom_filter_field" }, { node = "generated_bottom_mode_dropdown" }, { node = "generated_bottom_selected_route" }]

[nodes.generated_bottom_filter_field]
component = "WorkbenchField"
control_id = "WorkbenchGeneratedBottomFilterField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "", placeholder = "Filter generated panel routes" }
layout = { width = { min = 260.0, preferred = 260.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [
  { id = "WorkbenchGeneratedBottom/FilterEdit", event = "Change", route = "WorkbenchGeneratedBottom.Filter.Edit" },
  { id = "WorkbenchGeneratedBottom/FilterCommit", event = "Submit", route = "WorkbenchGeneratedBottom.Filter.Commit" },
]

[nodes.generated_bottom_mode_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchGeneratedBottomModeDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Output", value = "Output", options = ["Output", "Build", "Validation", "Runtime", "Review"] }
layout = { width = { min = 160.0, preferred = 160.0, max = 190.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [
  { id = "WorkbenchGeneratedBottom/ModeEdit", event = "Change", route = "WorkbenchGeneratedBottom.Mode.Edit" },
  { id = "WorkbenchGeneratedBottom/ModeCommit", event = "Submit", route = "WorkbenchGeneratedBottom.Mode.Commit" },
]

[nodes.generated_bottom_selected_route]
component = "WorkbenchTableRow"
control_id = "WorkbenchGeneratedBottomSelectedRoute"
classes = ["workbench-table-row"]
props = { text = "Selected Route", value_text = "module-bottom-scene:console" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.generated_bottom_body]
component = "HorizontalGroup"
control_id = "WorkbenchGeneratedBottomBody"
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "generated_bottom_route_table" }, { node = "generated_bottom_detail_panel" }]

[nodes.generated_bottom_route_table]
component = "VerticalGroup"
control_id = "WorkbenchGeneratedBottomRouteTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { clip = true, container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "generated_bottom_scene_console" },
  { node = "generated_bottom_scene_validation" },
  { node = "generated_bottom_gameplay_effect_attribute_delta" },
  { node = "generated_bottom_gameplay_effect_validation" },
  { node = "generated_bottom_gameplay_effect_compile_log" },
  { node = "generated_bottom_gameplay_ability_compile_log" },
  { node = "generated_bottom_gameplay_ability_gameplay_event_log" },
  { node = "generated_bottom_gameplay_ability_simulation_console" },
  { node = "generated_bottom_gameplay_tags_reference_scan" },
  { node = "generated_bottom_gameplay_tags_migration_preview" },
  { node = "generated_bottom_gameplay_tags_compile_log" },
  { node = "generated_bottom_ai_perception_debug_log" },
  { node = "generated_bottom_ai_perception_query_output" },
  { node = "generated_bottom_ai_perception_validation" },
  { node = "generated_bottom_ai_perception_compile_log" },
  { node = "generated_bottom_material_preview_variants" },
  { node = "generated_bottom_material_warnings" },
  { node = "generated_bottom_behavior_tree_runtime_trace" },
  { node = "generated_bottom_behavior_tree_breakpoint_output" },
  { node = "generated_bottom_behavior_tree_validation_issues" },
  { node = "generated_bottom_render_pipeline_compile_output" },
  { node = "generated_bottom_render_pipeline_resource_transitions" },
  { node = "generated_bottom_render_pipeline_warnings" },
  { node = "generated_bottom_render_pipeline_errors" },
  { node = "generated_bottom_render_pipeline_compile_log" },
  { node = "generated_bottom_asset_browser_output" },
  { node = "generated_bottom_asset_browser_validation" },
  { node = "generated_bottom_asset_browser_cook" },
  { node = "generated_bottom_asset_browser_package" },
  { node = "generated_bottom_vfx_curves" },
  { node = "generated_bottom_vfx_niagara_log" },
  { node = "generated_bottom_vfx_compile_output" },
  { node = "generated_bottom_vfx_event_log" },
  { node = "generated_bottom_hud_editor_binding_errors" },
  { node = "generated_bottom_hud_editor_preview_log" },
  { node = "generated_bottom_hud_editor_performance" },
  { node = "generated_bottom_hud_editor_compile_log" },
]

