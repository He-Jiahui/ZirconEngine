[asset]
kind = "component"
id = "res://ui/editor/components/workbench_render_workspace.zui"
version = 2
display_name = "Workbench Render Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []
[components.WorkbenchRenderWorkspace]
root = "render_workspace"
default_classes = ["workbench-module-body"]

[nodes.render_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchModuleRenderWorkspace"
classes = ["workbench-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "render_rail_gap" }, { node = "render_left" }, { node = "render_center" }, { node = "render_right" }]

[nodes.render_rail_gap]
component = "Container"
control_id = "WorkbenchRenderRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.render_left]
component = "VerticalGroup"
control_id = "WorkbenchRenderLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "render_title" }, { node = "render_graph_tab" }, { node = "render_resources_tab" }, { node = "render_warnings_tab" }, { node = "render_pass_row_01" }, { node = "render_pass_row_02" }]

[nodes.render_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchRenderTitle"
props = { text = "Render Pipeline" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.render_graph_tab]
component = "WorkbenchTab"
control_id = "WorkbenchRenderGraphTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Graph", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderGraphTab", event = "Click", route = "WorkbenchModule.Render.Graph" }]

[nodes.render_resources_tab]
component = "WorkbenchTab"
control_id = "WorkbenchRenderResourcesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Resources", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderResourcesTab", event = "Click", route = "WorkbenchModule.Render.Resources" }]

[nodes.render_warnings_tab]
component = "WorkbenchTab"
control_id = "WorkbenchRenderWarningsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Warnings", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderWarningsTab", event = "Click", route = "WorkbenchModule.Render.Warnings" }]

[nodes.render_pass_row_01]
component = "WorkbenchListRow"
control_id = "WorkbenchRenderLightingPassRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Lighting Pass", icon = "renderer", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderLightingPass", event = "Click", route = "WorkbenchModule.Render.Pass.Lighting" }]

[nodes.render_pass_row_02]
component = "WorkbenchListRow"
control_id = "WorkbenchRenderBloomPassRow"
classes = ["workbench-list-row"]
props = { text = "Bloom Pass", icon = "renderer", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderBloomPass", event = "Click", route = "WorkbenchModule.Render.Pass.Bloom" }]

[nodes.render_center]
component = "VerticalGroup"
control_id = "WorkbenchRenderCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "render_center_header" }, { node = "render_graph_canvas" }, { node = "render_capture_row" }]

[nodes.render_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchRenderCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "render_center_title" }, { node = "render_header_fill" }, { node = "render_compile_button" }]

[nodes.render_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchRenderCenterTitle"
props = { text = "Render Graph" }
layout = { width = { min = 160.0, preferred = 160.0, max = 180.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.render_header_fill]
component = "Container"
control_id = "WorkbenchRenderHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.render_compile_button]
component = "WorkbenchButton"
control_id = "WorkbenchRenderCompileButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Compile", button_variant = "filled", button_color = "accent", background_color = "#12383d", border_color = "#209fa8" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderCompile", event = "Click", route = "WorkbenchModule.Render.Compile" }]

[nodes.render_graph_canvas]
component = "VerticalGroup"
control_id = "WorkbenchRenderGraphCanvas"
classes = ["workbench-panel", "workbench-module-graph"]
layout = { container = { kind = "VerticalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "render_graph_row_01" }, { node = "render_graph_row_02" }, { node = "render_resource_row" }]

[nodes.render_graph_row_01]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchRenderFrameStartRow"
classes = ["workbench-property-row", "workbench-row-selected"]
props = { text = "Frame Start", value_text = "Frame 1234 captured   0.000 ms", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderFrameStart", event = "Click", route = "WorkbenchModule.Render.FrameStart" }]

[nodes.render_graph_row_02]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchRenderLightingNodeRow"
classes = ["workbench-property-row"]
props = { text = "Lighting", value_text = "SceneColor -> BloomInput   1.84 ms" }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderLightingNode", event = "Click", route = "WorkbenchModule.Render.Node.Lighting" }]

[nodes.render_resource_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchRenderSceneColorRow"
classes = ["workbench-table-row"]
props = { text = "SceneColor", value_text = "R11G11B10_FLOAT   Read" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderSceneColor", event = "Click", route = "WorkbenchModule.Render.Resource.SceneColor" }]

[nodes.render_capture_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchRenderCaptureRow"
classes = ["workbench-table-row"]
props = { text = "Capture", value_text = "Windows DX12   30 fps   GPU 6.24 ms" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/RenderCapture", event = "Click", route = "WorkbenchModule.Render.Capture" }]

[nodes.render_right]
component = "VerticalGroup"
control_id = "WorkbenchRenderRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "render_details_title" }, { node = "render_pipeline_field" }, { node = "render_platform_dropdown" }, { node = "render_frame_field" }, { node = "render_shader_editor_button" }, { node = "render_lighting_bake_button" }, { node = "render_post_process_button" }]

[nodes.render_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchRenderDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.render_pipeline_field]
component = "WorkbenchField"
control_id = "WorkbenchRenderPipelineField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "MainPipeline.rp" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/RenderPipelineEdit", event = "Change", route = "WorkbenchModule.Render.Pipeline.Edit" },
  { id = "WorkbenchModule/RenderPipelineCommit", event = "Submit", route = "WorkbenchModule.Render.Pipeline.Commit" },
]

[nodes.render_platform_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchRenderPlatformDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Windows DX12", value = "Windows DX12" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/RenderPlatformEdit", event = "Change", route = "WorkbenchModule.Render.Platform.Edit" },
  { id = "WorkbenchModule/RenderPlatformCommit", event = "Submit", route = "WorkbenchModule.Render.Platform.Commit" },
]

[nodes.render_frame_field]
component = "WorkbenchField"
control_id = "WorkbenchRenderFrameField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Frame: 1234" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/RenderFrameEdit", event = "Change", route = "WorkbenchModule.Render.Frame.Edit" },
  { id = "WorkbenchModule/RenderFrameCommit", event = "Submit", route = "WorkbenchModule.Render.Frame.Commit" },
]

[nodes.render_shader_editor_button]
component = "WorkbenchButton"
control_id = "WorkbenchRenderShaderEditorButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Shader Editor", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ShaderEditorOpen", event = "Click", route = "WorkbenchExtension.ShaderEditor.Open" }]

[nodes.render_lighting_bake_button]
component = "WorkbenchButton"
control_id = "WorkbenchRenderLightingBakeButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Lighting Bake", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeOpen", event = "Click", route = "WorkbenchExtension.LightingBake.Open" }]

[nodes.render_post_process_button]
component = "WorkbenchButton"
control_id = "WorkbenchRenderPostProcessButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Post Process", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessOpen", event = "Click", route = "WorkbenchExtension.PostProcess.Open" }]
