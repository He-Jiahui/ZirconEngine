[components.WorkbenchExtensionModuleWorkspaces]
root = "extension_module_workspaces"
default_classes = ["workbench-module-workspace"]

[nodes.extension_module_workspaces]
component = "Overlay"
control_id = "WorkbenchExtensionModuleWorkspaces"
classes = ["workbench-module-workspace"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
