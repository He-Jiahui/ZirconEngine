[asset]
kind = "component"
id = "res://ui/editor/components/workbench_extension_console_diagnostics_workspace.zui"
version = 2
display_name = "Workbench Extension Console Diagnostics Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionConsoleDiagnosticsWorkspace]
root = "console_diagnostics_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.console_diagnostics_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_rail_gap" }, { node = "console_diagnostics_left" }, { node = "console_diagnostics_center" }, { node = "console_diagnostics_right" }]

[nodes.console_diagnostics_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionConsoleDiagnosticsRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.console_diagnostics_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_title" }, { node = "console_diagnostics_live_log_tab" }, { node = "console_diagnostics_counters_tab" }, { node = "console_diagnostics_report_tab" }, { node = "console_diagnostics_session_row" }, { node = "console_diagnostics_renderer_row" }, { node = "console_diagnostics_asset_row" }]

[nodes.console_diagnostics_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionConsoleDiagnosticsTitle"
props = { text = "Console Diagnostics" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.console_diagnostics_live_log_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionConsoleDiagnosticsLiveLogTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Live Log", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsLiveLogTab", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.LiveLog" }]

[nodes.console_diagnostics_counters_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionConsoleDiagnosticsCountersTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Counters", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsCountersTab", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Counters" }]

[nodes.console_diagnostics_report_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionConsoleDiagnosticsReportTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Report", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsReportTab", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Report" }]

[nodes.console_diagnostics_session_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsSessionRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Session_12_10", icon = "info", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsSessionRow", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Source.Session" }]

[nodes.console_diagnostics_renderer_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsRendererRow"
classes = ["workbench-list-row"]
props = { text = "Renderer", icon = "alert", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsRendererRow", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Source.Renderer" }]

[nodes.console_diagnostics_asset_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsAssetRow"
classes = ["workbench-list-row"]
props = { text = "Asset", icon = "file", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsAssetRow", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Source.Asset" }]

[nodes.console_diagnostics_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_center_header" }, { node = "console_diagnostics_table" }, { node = "console_diagnostics_output" }]

[nodes.console_diagnostics_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "console_diagnostics_center_title" }, { node = "console_diagnostics_header_fill" }, { node = "console_diagnostics_filter_button" }, { node = "console_diagnostics_clear_button" }]

[nodes.console_diagnostics_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionConsoleDiagnosticsCenterTitle"
props = { text = "Console Live Feed" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.console_diagnostics_header_fill]
component = "Container"
control_id = "WorkbenchExtensionConsoleDiagnosticsHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.console_diagnostics_filter_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionConsoleDiagnosticsFilterConsoleButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Filter Console", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 122.0, preferred = 122.0, max = 134.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsFilterConsole", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.FilterConsole" }]

[nodes.console_diagnostics_clear_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionConsoleDiagnosticsClearConsoleButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Clear Console", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 116.0, preferred = 116.0, max = 128.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsClearConsole", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.ClearConsole" }]

[nodes.console_diagnostics_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_warning_table_row" }, { node = "console_diagnostics_info_table_row" }, { node = "console_diagnostics_gameplay_table_row" }, { node = "console_diagnostics_error_table_row" }]

[nodes.console_diagnostics_warning_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsWarningTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "12:10:11   Renderer   Warning", value_text = "Missing transient view" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsWarningTableRow", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Row.Warning" }]

[nodes.console_diagnostics_info_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsInfoTableRow"
classes = ["workbench-table-row"]
props = { text = "12:10:13   Asset   Info", value_text = "Import completed" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsInfoTableRow", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Row.Info" }]

[nodes.console_diagnostics_gameplay_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsGameplayTableRow"
classes = ["workbench-table-row"]
props = { text = "12:10:18   Gameplay   Warning", value_text = "Tag redirect used" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsGameplayTableRow", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Row.Gameplay" }]

[nodes.console_diagnostics_error_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsErrorTableRow"
classes = ["workbench-table-row"]
props = { text = "12:10:21   Runtime   Error", value_text = "Null object path" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsErrorTableRow", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Row.Error" }]

[nodes.console_diagnostics_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsOutputRow"
classes = ["workbench-table-row"]
props = { text = "Console Diagnostics", value_text = "58 FPS   24 warnings   1 error   82 marks" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsOutput", event = "Click", route = "WorkbenchExtension.ConsoleDiagnostics.Output" }]

[nodes.console_diagnostics_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_details_title" }, { node = "console_diagnostics_subsystem_dropdown" }, { node = "console_diagnostics_severity_dropdown" }, { node = "console_diagnostics_regex_field" }]

[nodes.console_diagnostics_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionConsoleDiagnosticsDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.console_diagnostics_subsystem_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionConsoleDiagnosticsSubsystemDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Renderer", value = "Renderer", options = ["Renderer", "Asset", "Gameplay", "Runtime"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ConsoleDiagnosticsSubsystemEdit", event = "Change", route = "WorkbenchExtension.ConsoleDiagnostics.Subsystem.Edit" },
  { id = "WorkbenchExtension/ConsoleDiagnosticsSubsystemCommit", event = "Submit", route = "WorkbenchExtension.ConsoleDiagnostics.Subsystem.Commit" },
]

[nodes.console_diagnostics_severity_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionConsoleDiagnosticsSeverityDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Warnings+", value = "Warnings+", options = ["Info+", "Warnings+", "Errors"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ConsoleDiagnosticsSeverityEdit", event = "Change", route = "WorkbenchExtension.ConsoleDiagnostics.Severity.Edit" },
  { id = "WorkbenchExtension/ConsoleDiagnosticsSeverityCommit", event = "Submit", route = "WorkbenchExtension.ConsoleDiagnostics.Severity.Commit" },
]

[nodes.console_diagnostics_regex_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionConsoleDiagnosticsRegexField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Regex: texture|shader" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ConsoleDiagnosticsRegexEdit", event = "Change", route = "WorkbenchExtension.ConsoleDiagnostics.Regex.Edit" },
  { id = "WorkbenchExtension/ConsoleDiagnosticsRegexCommit", event = "Submit", route = "WorkbenchExtension.ConsoleDiagnostics.Regex.Commit" },
]
