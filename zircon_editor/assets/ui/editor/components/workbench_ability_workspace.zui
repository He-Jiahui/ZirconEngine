[asset]
kind = "component"
id = "res://ui/editor/components/workbench_ability_workspace.zui"
version = 2
display_name = "Workbench Ability Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []
[components.WorkbenchAbilityWorkspace]
root = "ability_workspace"
default_classes = ["workbench-module-body"]

[nodes.ability_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchModuleAbilityWorkspace"
classes = ["workbench-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_rail_gap" }, { node = "ability_left" }, { node = "ability_center" }, { node = "ability_right" }]

[nodes.ability_rail_gap]
component = "Container"
control_id = "WorkbenchAbilityRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.ability_left]
component = "VerticalGroup"
control_id = "WorkbenchAbilityLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_title" }, { node = "ability_graph_tab" }, { node = "ability_tasks_tab" }, { node = "ability_debug_tab" }, { node = "ability_task_row_01" }, { node = "ability_task_row_02" }, { node = "ability_asset_row" }]

[nodes.ability_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityTitle"
props = { text = "Gameplay Ability" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.ability_graph_tab]
component = "WorkbenchTab"
control_id = "WorkbenchAbilityGraphTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Graph", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityGraphTab", event = "Click", route = "WorkbenchModule.Ability.Graph" }]

[nodes.ability_tasks_tab]
component = "WorkbenchTab"
control_id = "WorkbenchAbilityTasksTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Tasks", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityTasksTab", event = "Click", route = "WorkbenchModule.Ability.Tasks" }]

[nodes.ability_debug_tab]
component = "WorkbenchTab"
control_id = "WorkbenchAbilityDebugTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Debug", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityDebugTab", event = "Click", route = "WorkbenchModule.Ability.Debug" }]

[nodes.ability_task_row_01]
component = "WorkbenchListRow"
control_id = "WorkbenchAbilityTaskActivateRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Activate Ability", icon = "play", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityTaskActivate", event = "Click", route = "WorkbenchModule.Ability.Task.Activate" }]

[nodes.ability_task_row_02]
component = "WorkbenchListRow"
control_id = "WorkbenchAbilityTaskCostRow"
classes = ["workbench-list-row"]
props = { text = "Apply Cost", icon = "gear", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityTaskCost", event = "Click", route = "WorkbenchModule.Ability.Task.Cost" }]

[nodes.ability_asset_row]
component = "WorkbenchListRow"
control_id = "WorkbenchAbilityAssetRow"
classes = ["workbench-list-row"]
props = { text = "GA_DashAttack", icon = "play", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityAssetDash", event = "Click", route = "WorkbenchModule.Ability.Asset.Dash" }]

[nodes.ability_center]
component = "VerticalGroup"
control_id = "WorkbenchAbilityCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_center_header" }, { node = "ability_graph_canvas" }, { node = "ability_output" }]

[nodes.ability_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchAbilityCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "ability_center_title" }, { node = "ability_header_fill" }, { node = "ability_playtest_button" }]

[nodes.ability_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityCenterTitle"
props = { text = "Ability Graph" }
layout = { width = { min = 160.0, preferred = 160.0, max = 180.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.ability_header_fill]
component = "Container"
control_id = "WorkbenchAbilityHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.ability_playtest_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityPlaytestButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Playtest", button_variant = "filled", button_color = "accent", background_color = "#12383d", border_color = "#209fa8" }
layout = { width = { min = 82.0, preferred = 82.0, max = 92.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityPlaytest", event = "Click", route = "WorkbenchModule.Ability.Playtest" }]

[nodes.ability_graph_canvas]
component = "VerticalGroup"
control_id = "WorkbenchAbilityGraphCanvas"
classes = ["workbench-panel", "workbench-module-graph"]
layout = { container = { kind = "VerticalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_phase_table" }, { node = "ability_phase_row_01" }, { node = "ability_phase_row_02" }, { node = "ability_graph_row" }]

[nodes.ability_phase_table]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityPhaseTable"
props = { text = "Phase Matrix" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.ability_phase_row_01]
component = "WorkbenchTableRow"
control_id = "WorkbenchAbilityPhaseActivateRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Activation", value_text = "Activate Ability   Server   Ready", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityPhaseActivate", event = "Click", route = "WorkbenchModule.Ability.Phase.Activate" }]

[nodes.ability_phase_row_02]
component = "WorkbenchTableRow"
control_id = "WorkbenchAbilityPhaseCostRow"
classes = ["workbench-table-row"]
props = { text = "Cost", value_text = "GE_DashAttack_Cost   Predicted   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityPhaseCost", event = "Click", route = "WorkbenchModule.Ability.Phase.Cost" }]

[nodes.ability_graph_row]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchAbilityGraphRow"
classes = ["workbench-property-row"]
props = { text = "Graph", value_text = "Activate -> Cost -> Montage -> Damage -> End" }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityGraphSelect", event = "Click", route = "WorkbenchModule.Ability.Graph.Select" }]

[nodes.ability_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchAbilityOutputRow"
classes = ["workbench-table-row"]
props = { text = "Timeline", value_text = "1.22s Ability Activated   OK   GA_DashAttack" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityOutput", event = "Click", route = "WorkbenchModule.Ability.Output" }]

[nodes.ability_right]
component = "VerticalGroup"
control_id = "WorkbenchAbilityRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_details_title" }, { node = "ability_name_field" }, { node = "ability_net_policy_dropdown" }, { node = "ability_cooldown_field" }, { node = "ability_sequencer_button" }, { node = "ability_montage_editor_button" }, { node = "ability_blend_space_button" }, { node = "ability_pose_library_button" }, { node = "ability_retarget_button" }, { node = "ability_control_rig_button" }, { node = "ability_motion_matching_button" }, { node = "ability_animation_compression_button" }]

[nodes.ability_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.ability_name_field]
component = "WorkbenchField"
control_id = "WorkbenchAbilityNameField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "GA_DashAttack" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/AbilityNameEdit", event = "Change", route = "WorkbenchModule.Ability.Name.Edit" },
  { id = "WorkbenchModule/AbilityNameCommit", event = "Submit", route = "WorkbenchModule.Ability.Name.Commit" },
]

[nodes.ability_net_policy_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchAbilityNetPolicyDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Server Initiated", value = "Server Initiated" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/AbilityNetPolicyEdit", event = "Change", route = "WorkbenchModule.Ability.NetPolicy.Edit" },
  { id = "WorkbenchModule/AbilityNetPolicyCommit", event = "Submit", route = "WorkbenchModule.Ability.NetPolicy.Commit" },
]

[nodes.ability_cooldown_field]
component = "WorkbenchField"
control_id = "WorkbenchAbilityCooldownField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Cooldown: 4.00s" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/AbilityCooldownEdit", event = "Change", route = "WorkbenchModule.Ability.Cooldown.Edit" },
  { id = "WorkbenchModule/AbilityCooldownCommit", event = "Submit", route = "WorkbenchModule.Ability.Cooldown.Commit" },
]

[nodes.ability_sequencer_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilitySequencerButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Sequencer", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerOpen", event = "Click", route = "WorkbenchExtension.Sequencer.Open" }]

[nodes.ability_montage_editor_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityMontageEditorButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Montage Editor", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorOpen", event = "Click", route = "WorkbenchExtension.MontageEditor.Open" }]

[nodes.ability_blend_space_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityBlendSpaceButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Blend Space", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceOpen", event = "Click", route = "WorkbenchExtension.BlendSpace.Open" }]

[nodes.ability_pose_library_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityPoseLibraryButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Pose Library", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PoseLibraryOpen", event = "Click", route = "WorkbenchExtension.PoseLibrary.Open" }]

[nodes.ability_retarget_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityRetargetButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Retarget", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetOpen", event = "Click", route = "WorkbenchExtension.Retarget.Open" }]

[nodes.ability_control_rig_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityControlRigButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Control Rig", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigOpen", event = "Click", route = "WorkbenchExtension.ControlRig.Open" }]

[nodes.ability_motion_matching_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityMotionMatchingButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Motion Matching", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MotionMatchingOpen", event = "Click", route = "WorkbenchExtension.MotionMatching.Open" }]

[nodes.ability_animation_compression_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityAnimationCompressionButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Animation Compression", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionOpen", event = "Click", route = "WorkbenchExtension.AnimationCompression.Open" }]
