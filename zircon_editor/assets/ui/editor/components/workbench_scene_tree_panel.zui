[asset]
kind = "component"
id = "res://ui/editor/components/workbench_scene_tree_panel.zui"
version = 2
display_name = "Workbench Scene Tree Panel"

[imports]
widgets = [
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_icon_button.zui#WorkbenchIconButton",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_tree_row.zui#WorkbenchTreeRow",
]
styles = []

[components.WorkbenchSceneTreePanel]
root = "scene_tree_panel"
default_classes = ["workbench-panel", "workbench-left-panel"]

[nodes.scene_tree_panel]
component = "VerticalGroup"
control_id = "WorkbenchSceneTreePanel"
classes = ["workbench-panel", "workbench-left-panel"]
layout = { clip = true, container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 332.0, preferred = 332.0, max = 332.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "scene_tabs" }, { node = "scene_search_row" }, { node = "scene_tree" }]

[nodes.scene_tabs]
component = "HorizontalGroup"
control_id = "WorkbenchSceneTabs"
classes = ["workbench-tabs"]
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = 42.0, preferred = 42.0, max = 42.0, stretch = "Fixed" } }
children = [{ node = "scene_tab_scene" }, { node = "scene_tab_layers" }]

[nodes.scene_tab_scene]
component = "WorkbenchTab"
control_id = "WorkbenchSceneTabScene"
classes = ["workbench-tab"]
props = { text = "Scene", checked = true, selected = true, value = true }
layout = { width = { min = 96.0, preferred = 96.0, max = 96.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "PanelTab/SceneTreeScene", event = "Click", route = "PanelTab.Select.SceneTreeScene" }]

[nodes.scene_tab_layers]
component = "WorkbenchTab"
control_id = "WorkbenchSceneTabLayers"
classes = ["workbench-tab"]
props = { text = "Layers" }
layout = { width = { min = 96.0, preferred = 96.0, max = 96.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "PanelTab/SceneTreeLayers", event = "Click", route = "PanelTab.Select.SceneTreeLayers" }]

[nodes.scene_search_row]
component = "HorizontalGroup"
control_id = "WorkbenchSceneSearchRow"
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "scene_search_field" }, { node = "scene_filter_button" }, { node = "scene_add_button" }]

[nodes.scene_search_field]
component = "WorkbenchField"
control_id = "WorkbenchSceneSearchField"
classes = ["workbench-field", "workbench-muted"]
props = { value = "", placeholder = "Search..." }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.scene_filter_button]
component = "WorkbenchIconButton"
control_id = "WorkbenchSceneFilter"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/scene/filter.svg", label = "Filter" }
layout = { width = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Hierarchy/OpenFilter", event = "Click", route = "Hierarchy.OpenFilter" }]

[nodes.scene_add_button]
component = "WorkbenchIconButton"
control_id = "WorkbenchSceneAdd"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/controls/add.svg", label = "Add" }
layout = { width = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Hierarchy/AddEntity", event = "Click", route = "Hierarchy.AddEntity" }]

[nodes.scene_tree]
component = "VerticalGroup"
control_id = "WorkbenchSceneTree"
layout = { container = { kind = "VerticalBox", gap = 3.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
repeat = { kind = "virtual_rows", prototype = "WorkbenchSceneSlot10Item", virtual_control_prefix = "WorkbenchSceneVirtualItem", authored_count = 10, node_path_namespace = "v2" }
children = [{ node = "scene_root_item" }, { node = "scene_environment_item" }, { node = "scene_level_item" }, { node = "scene_props_item" }, { node = "scene_player_item" }, { node = "scene_audio_item" }, { node = "scene_slot_07_item" }, { node = "scene_slot_08_item" }, { node = "scene_slot_09_item" }, { node = "scene_slot_10_item" }]

[nodes.scene_root_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchSceneRootItem"
classes = ["workbench-tree-item"]
props = { text = "Root", tree_depth = 0, expanded = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectRoot", event = "Click", route = "Hierarchy.SelectRoot" }]

[nodes.scene_environment_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchSceneEnvironmentItem"
classes = ["workbench-tree-item", "workbench-indent-1"]
props = { text = "Environment", tree_depth = 1, expanded = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectEnvironment", event = "Click", route = "Hierarchy.SelectEnvironment" }]

[nodes.scene_level_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchSceneLevelItem"
classes = ["workbench-tree-item", "workbench-indent-1"]
props = { text = "Level", tree_depth = 1, expanded = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectLevel", event = "Click", route = "Hierarchy.SelectLevel" }]

[nodes.scene_props_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchScenePropsItem"
classes = ["workbench-tree-item", "workbench-indent-2"]
props = { text = "Props", tree_depth = 2, tree_indent_px = 40.0, expanded = true, selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectProps", event = "Click", route = "Hierarchy.SelectProps" }]

[nodes.scene_player_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchScenePlayerItem"
classes = ["workbench-tree-item"]
props = { text = "PlayerStart", tree_depth = 0, expanded = false }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectPlayer", event = "Click", route = "Hierarchy.SelectPlayer" }]

[nodes.scene_audio_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchSceneAudioItem"
classes = ["workbench-tree-item"]
props = { text = "AudioZone", tree_depth = 0, expanded = false }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectAudio", event = "Click", route = "Hierarchy.SelectAudio" }]

[nodes.scene_slot_07_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchSceneSlot07Item"
classes = ["workbench-tree-item"]
props = { text = "Scene Item 07", tree_depth = 0, expanded = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectSlot07", event = "Click", route = "Hierarchy.SelectSlot07" }]

[nodes.scene_slot_08_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchSceneSlot08Item"
classes = ["workbench-tree-item"]
props = { text = "Scene Item 08", tree_depth = 0, expanded = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectSlot08", event = "Click", route = "Hierarchy.SelectSlot08" }]

[nodes.scene_slot_09_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchSceneSlot09Item"
classes = ["workbench-tree-item"]
props = { text = "Scene Item 09", tree_depth = 0, expanded = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectSlot09", event = "Click", route = "Hierarchy.SelectSlot09" }]

[nodes.scene_slot_10_item]
component = "WorkbenchTreeRow"
control_id = "WorkbenchSceneSlot10Item"
classes = ["workbench-tree-item"]
props = { text = "Scene Item 10", tree_depth = 0, expanded = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Hierarchy/SelectSlot10", event = "Click", route = "Hierarchy.SelectSlot10" }]
