[asset]
kind = "component"
id = "res://ui/editor/components/workbench_material_workspace.zui"
version = 2
display_name = "Workbench Material Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchMaterialWorkspace]
root = "material_workspace"
default_classes = ["workbench-module-body"]

[nodes.material_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchModuleMaterialWorkspace"
classes = ["workbench-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "material_rail_gap" }, { node = "material_left" }, { node = "material_center" }, { node = "material_right" }]

[nodes.material_rail_gap]
component = "Container"
control_id = "WorkbenchMaterialRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.material_left]
component = "VerticalGroup"
control_id = "WorkbenchMaterialLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "material_title" }, { node = "material_graph_tab" }, { node = "material_preview_tab" }, { node = "material_shader_tab" }, { node = "material_base_color_row" }, { node = "material_normal_row" }]

[nodes.material_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchMaterialTitle"
classes = ["workbench-section-title"]
props = { text = "Material" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.material_graph_tab]
component = "WorkbenchTab"
control_id = "WorkbenchMaterialGraphTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Graph", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialGraphTab", event = "Click", route = "WorkbenchModule.Material.Graph" }]

[nodes.material_preview_tab]
component = "WorkbenchTab"
control_id = "WorkbenchMaterialPreviewTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Preview", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialPreviewTab", event = "Click", route = "WorkbenchModule.Material.Preview" }]

[nodes.material_shader_tab]
component = "WorkbenchTab"
control_id = "WorkbenchMaterialShaderTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Shader", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialShaderTab", event = "Click", route = "WorkbenchModule.Material.Shader" }]

[nodes.material_base_color_row]
component = "WorkbenchListRow"
control_id = "WorkbenchMaterialBaseColorRow"
classes = ["workbench-list-row"]
props = { text = "Base Color", value = "base_color", selected = true, checked = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialBaseColorRow", event = "Click", route = "WorkbenchModule.Material.BaseColor" }]

[nodes.material_normal_row]
component = "WorkbenchListRow"
control_id = "WorkbenchMaterialNormalRow"
classes = ["workbench-list-row"]
props = { text = "Normal Map", value = "normal_map", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialNormalRow", event = "Click", route = "WorkbenchModule.Material.Normal" }]

[nodes.material_center]
component = "VerticalGroup"
control_id = "WorkbenchMaterialCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "material_center_header" }, { node = "material_graph_canvas" }, { node = "material_output" }]

[nodes.material_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchMaterialCenterHeader"
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 38.0, preferred = 38.0, max = 40.0, stretch = "Fixed" } }
children = [{ node = "material_center_title" }, { node = "material_header_fill" }, { node = "material_compile_button" }]

[nodes.material_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchMaterialCenterTitle"
classes = ["workbench-section-title"]
props = { text = "M_Rock_Cliff" }
layout = { width = { min = 180.0, preferred = 180.0, max = 240.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.material_header_fill]
component = "Container"
control_id = "WorkbenchMaterialHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.material_compile_button]
component = "WorkbenchButton"
control_id = "WorkbenchMaterialCompileButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Compile", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialCompile", event = "Click", route = "WorkbenchModule.Material.Compile" }]

[nodes.material_graph_canvas]
component = "VerticalGroup"
control_id = "WorkbenchMaterialGraphCanvas"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "material_node_row_01" }, { node = "material_node_row_02" }, { node = "material_node_row_03" }]

[nodes.material_node_row_01]
component = "WorkbenchTableRow"
control_id = "WorkbenchMaterialNodeRow01"
classes = ["workbench-table-row"]
props = { text = "Texture Sample     Albedo      T_Rock_A", value = "node_01", options = ["Texture Sample", "Albedo", "T_Rock_A", "RGBA"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialNodeAlbedo", event = "Click", route = "WorkbenchModule.Material.Node.Albedo" }]

[nodes.material_node_row_02]
component = "WorkbenchTableRow"
control_id = "WorkbenchMaterialNodeRow02"
classes = ["workbench-table-row"]
props = { text = "Multiply           Roughness   0.72", value = "node_02", options = ["Multiply", "Roughness", "0.72", "float"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialNodeRoughness", event = "Click", route = "WorkbenchModule.Material.Node.Roughness" }]

[nodes.material_node_row_03]
component = "WorkbenchTableRow"
control_id = "WorkbenchMaterialNodeRow03"
classes = ["workbench-table-row"]
props = { text = "Normal             Tangent     T_Rock_N", value = "node_03", options = ["Normal", "Tangent", "T_Rock_N", "RGB"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialNodeNormal", event = "Click", route = "WorkbenchModule.Material.Node.Normal" }]

[nodes.material_output]
component = "WorkbenchListRow"
control_id = "WorkbenchMaterialOutputRow"
classes = ["workbench-list-row"]
props = { text = "Shader Output: 0 errors, 2 warnings", value = "material_output" }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/MaterialOutput", event = "Click", route = "WorkbenchModule.Material.Output" }]

[nodes.material_right]
component = "VerticalGroup"
control_id = "WorkbenchMaterialRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "material_details_title" }, { node = "material_domain_dropdown" }, { node = "material_blend_dropdown" }, { node = "material_preview_field" }]

[nodes.material_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchMaterialDetailsTitle"
classes = ["workbench-section-title"]
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.material_domain_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchMaterialDomainDropdown"
classes = ["workbench-field", "workbench-dropdown"]
props = { value = "surface", value_text = "Surface", options = ["surface", "post_process", "decal"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/MaterialDomainEdit", event = "Change", route = "WorkbenchModule.Material.Domain.Edit" },
  { id = "WorkbenchModule/MaterialDomainCommit", event = "Submit", route = "WorkbenchModule.Material.Domain.Commit" },
]

[nodes.material_blend_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchMaterialBlendDropdown"
classes = ["workbench-field", "workbench-dropdown"]
props = { value = "opaque", value_text = "Opaque", options = ["opaque", "masked", "translucent"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/MaterialBlendEdit", event = "Change", route = "WorkbenchModule.Material.Blend.Edit" },
  { id = "WorkbenchModule/MaterialBlendCommit", event = "Submit", route = "WorkbenchModule.Material.Blend.Commit" },
]

[nodes.material_preview_field]
component = "WorkbenchField"
control_id = "WorkbenchMaterialPreviewField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Preview Mesh: Sphere" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/MaterialPreviewEdit", event = "Change", route = "WorkbenchModule.Material.Preview.Edit" },
  { id = "WorkbenchModule/MaterialPreviewCommit", event = "Submit", route = "WorkbenchModule.Material.Preview.Commit" },
]