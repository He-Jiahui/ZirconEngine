[asset]
kind = "component"
id = "res://ui/editor/components/workbench_extension_source_control_workspace.zui"
version = 2
display_name = "Workbench Extension Source Control Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []
[components.WorkbenchExtensionSourceControlWorkspace]
root = "source_control_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.source_control_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionSourceControlWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_rail_gap" }, { node = "source_control_left" }, { node = "source_control_center" }, { node = "source_control_right" }]

[nodes.source_control_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionSourceControlRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.source_control_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSourceControlLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_title" }, { node = "source_control_diff_tab" }, { node = "source_control_owners_tab" }, { node = "source_control_submit_tab" }, { node = "source_control_changelist_row" }, { node = "source_control_runtime_row" }, { node = "source_control_editor_row" }]

[nodes.source_control_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSourceControlTitle"
props = { text = "Source Control" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.source_control_diff_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionSourceControlDiffTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Diff", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlDiffTab", event = "Click", route = "WorkbenchExtension.SourceControl.Diff" }]

[nodes.source_control_owners_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionSourceControlOwnersTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Owners", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlOwnersTab", event = "Click", route = "WorkbenchExtension.SourceControl.Owners" }]

[nodes.source_control_submit_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionSourceControlSubmitTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Submit", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlSubmitTab", event = "Click", route = "WorkbenchExtension.SourceControl.Submit" }]

[nodes.source_control_changelist_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSourceControlChangelistRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "CL_2048", icon = "history", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlChangelistRow", event = "Click", route = "WorkbenchExtension.SourceControl.Changelist" }]

[nodes.source_control_runtime_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSourceControlRuntimeRow"
classes = ["workbench-list-row"]
props = { text = "zircon_runtime", icon = "folder", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlRuntimeRow", event = "Click", route = "WorkbenchExtension.SourceControl.Runtime" }]

[nodes.source_control_editor_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSourceControlEditorRow"
classes = ["workbench-list-row"]
props = { text = "zircon_editor", icon = "folder", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlEditorRow", event = "Click", route = "WorkbenchExtension.SourceControl.Editor" }]

[nodes.source_control_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSourceControlCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_center_header" }, { node = "source_control_files" }, { node = "source_control_output" }]

[nodes.source_control_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionSourceControlCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "source_control_center_title" }, { node = "source_control_header_fill" }, { node = "source_control_validate_button" }, { node = "source_control_submit_button" }]

[nodes.source_control_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSourceControlCenterTitle"
props = { text = "CL_2048 / Diff Review" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.source_control_header_fill]
component = "Container"
control_id = "WorkbenchExtensionSourceControlHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.source_control_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionSourceControlValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlValidate", event = "Click", route = "WorkbenchExtension.SourceControl.Validate" }]

[nodes.source_control_submit_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionSourceControlSubmitButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Submit", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 82.0, preferred = 82.0, max = 92.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlSubmit", event = "Click", route = "WorkbenchExtension.SourceControl.SubmitChange" }]

[nodes.source_control_files]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSourceControlFiles"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_runtime_file_row" }, { node = "source_control_editor_file_row" }, { node = "source_control_docs_file_row" }, { node = "source_control_conflict_file_row" }]

[nodes.source_control_runtime_file_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlRuntimeFileRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "runtime/ui/render.rs", value_text = "Modified   Alice   Selected" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlRuntimeFileRow", event = "Click", route = "WorkbenchExtension.SourceControl.File.Runtime" }]

[nodes.source_control_editor_file_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlEditorFileRow"
classes = ["workbench-table-row"]
props = { text = "editor/painter.rs", value_text = "Modified   Bob   Review" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlEditorFileRow", event = "Click", route = "WorkbenchExtension.SourceControl.File.Editor" }]

[nodes.source_control_docs_file_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlDocsFileRow"
classes = ["workbench-table-row"]
props = { text = "docs/ui.md", value_text = "Added   Alice   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlDocsFileRow", event = "Click", route = "WorkbenchExtension.SourceControl.File.Docs" }]

[nodes.source_control_conflict_file_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlConflictFileRow"
classes = ["workbench-table-row"]
props = { text = "asset/import.rs", value_text = "Conflict   Chen   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlConflictFileRow", event = "Click", route = "WorkbenchExtension.SourceControl.File.Conflict" }]

[nodes.source_control_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlOutputRow"
classes = ["workbench-table-row"]
props = { text = "Checks", value_text = "18 files   2 conflicts   6 checks" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlOutput", event = "Click", route = "WorkbenchExtension.SourceControl.Output" }]

[nodes.source_control_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSourceControlRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_details_title" }, { node = "source_control_changelist_dropdown" }, { node = "source_control_owner_field" }, { node = "source_control_gate_dropdown" }]

[nodes.source_control_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSourceControlDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.source_control_changelist_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionSourceControlChangelistDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "CL_2048", value = "CL_2048", options = ["CL_2048", "CL_2049", "Shelved_Alice"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SourceControlChangelistEdit", event = "Change", route = "WorkbenchExtension.SourceControl.Changelist.Edit" },
  { id = "WorkbenchExtension/SourceControlChangelistCommit", event = "Submit", route = "WorkbenchExtension.SourceControl.Changelist.Commit" },
]

[nodes.source_control_owner_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionSourceControlOwnerField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Alice" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SourceControlOwnerEdit", event = "Change", route = "WorkbenchExtension.SourceControl.Owner.Edit" },
  { id = "WorkbenchExtension/SourceControlOwnerCommit", event = "Submit", route = "WorkbenchExtension.SourceControl.Owner.Commit" },
]

[nodes.source_control_gate_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionSourceControlGateDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Full", value = "Full", options = ["Fast", "Full", "Submit Only"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SourceControlGateEdit", event = "Change", route = "WorkbenchExtension.SourceControl.Gate.Edit" },
  { id = "WorkbenchExtension/SourceControlGateCommit", event = "Submit", route = "WorkbenchExtension.SourceControl.Gate.Commit" },
]
