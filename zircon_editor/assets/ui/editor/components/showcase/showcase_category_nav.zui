[asset]
kind = "component"
id = "res://ui/editor/components/showcase/showcase_category_nav.zui"
version = 2
display_name = "Showcase Category Navigation"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.ShowcaseCategoryNav]
root = "category_nav_root"
default_classes = ["showcase-panel"]

[nodes.nav_all]
component = "Button"
control_id = "ShowAllCategory"
classes = ["material-control", "material-button"]
props = { text = "All", layout_padding_left = "$editor.density.gap.large", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.dense", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "UiComponentShowcase/ShowAllCategory", event = "Click", route = "component_lab.showcase.select_category.all" },
]

[nodes.nav_visual]
component = "Button"
control_id = "ShowVisualCategory"
classes = ["material-control", "material-button"]
props = { text = "Visual", layout_padding_left = "$editor.density.gap.large", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.dense", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "UiComponentShowcase/ShowVisualCategory", event = "Click", route = "component_lab.showcase.select_category.visual" },
]

[nodes.nav_feedback]
component = "Button"
control_id = "ShowFeedbackCategory"
classes = ["material-control", "material-button"]
props = { text = "Feedback", layout_padding_left = "$editor.density.gap.large", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.dense", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "UiComponentShowcase/ShowFeedbackCategory", event = "Click", route = "component_lab.showcase.select_category.feedback" },
]

[nodes.nav_input]
component = "Button"
control_id = "ShowInputCategory"
classes = ["material-control", "material-button"]
props = { text = "Input", layout_padding_left = "$editor.density.gap.large", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.dense", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "UiComponentShowcase/ShowInputCategory", event = "Click", route = "component_lab.showcase.select_category.input" },
]

[nodes.nav_numeric]
component = "Button"
control_id = "ShowNumericCategory"
classes = ["material-control", "material-button"]
props = { text = "Numeric", layout_padding_left = "$editor.density.gap.large", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.dense", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "UiComponentShowcase/ShowNumericCategory", event = "Click", route = "component_lab.showcase.select_category.numeric" },
]

[nodes.nav_selection]
component = "Button"
control_id = "ShowSelectionCategory"
classes = ["material-control", "material-button"]
props = { text = "Selection", layout_padding_left = "$editor.density.gap.large", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.dense", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "UiComponentShowcase/ShowSelectionCategory", event = "Click", route = "component_lab.showcase.select_category.selection" },
]

[nodes.nav_reference]
component = "Button"
control_id = "ShowReferenceCategory"
classes = ["material-control", "material-button"]
props = { text = "Reference", layout_padding_left = "$editor.density.gap.large", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.dense", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "UiComponentShowcase/ShowReferenceCategory", event = "Click", route = "component_lab.showcase.select_category.reference" },
]

[nodes.nav_collections]
component = "Button"
control_id = "ShowDataCategory"
classes = ["material-control", "material-button"]
props = { text = "Collections", layout_padding_left = "$editor.density.gap.large", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.dense", layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "UiComponentShowcase/ShowDataCategory", event = "Click", route = "component_lab.showcase.select_category.collections" },
]

[nodes.category_nav_root]
component = "VerticalBox"
control_id = "ComponentCategoryNav"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "VerticalBox", gap = "$editor.density.gap.small" } }
children = [
  { node = "nav_all" },
  { node = "nav_visual" },
  { node = "nav_feedback" },
  { node = "nav_input" },
  { node = "nav_numeric" },
  { node = "nav_selection" },
  { node = "nav_reference" },
  { node = "nav_collections" },
]
