[asset]
kind = "component"
id = "res://ui/editor/components/showcase/showcase_command_toolbar.zui"
version = 2
display_name = "Showcase Command Toolbar"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.ShowcaseCommandToolbar]
root = "toolbar_root"
default_classes = ["unreal-panel"]

[nodes.toolbar_label]
component = "Label"
control_id = "ComponentShowcaseToolbarLabel"
classes = ["showcase-muted"]
props = { text = "Component Gallery", font_size = "$editor.typography.caption.size" }
layout = { width = { min = 132.0, preferred = 132.0, max = 132.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.toolbar_compile]
component = "Button"
control_id = "ComponentShowcaseCompileButton"
classes = ["material-control", "material-button", "unreal-command"]
props = { text = "Compile", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.density.toolbar_action_width", layout_min_height = "$editor.control.height.dense", layout_icon_size = 14.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.density.toolbar_action_width", preferred = "$editor.density.toolbar_action_width", max = "$editor.density.toolbar_action_width", stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }

[nodes.toolbar_preview]
component = "Button"
control_id = "ComponentShowcasePreviewButton"
classes = ["material-control", "material-button", "unreal-command"]
props = { text = "Preview", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.density.toolbar_action_width", layout_min_height = "$editor.control.height.dense", layout_icon_size = 14.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.density.toolbar_action_width", preferred = "$editor.density.toolbar_action_width", max = "$editor.density.toolbar_action_width", stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }

[nodes.toolbar_reset]
component = "Button"
control_id = "ComponentShowcaseResetButton"
classes = ["material-control", "material-button", "unreal-command"]
props = { text = "Reset", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.density.toolbar_action_width", layout_min_height = "$editor.control.height.dense", layout_icon_size = 14.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.density.toolbar_action_width", preferred = "$editor.density.toolbar_action_width", max = "$editor.density.toolbar_action_width", stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }

[nodes.toolbar_fill]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_runtime_badge]
component = "Badge"
control_id = "ComponentShowcaseRuntimeBadge"
classes = ["showcase-field", "unreal-accent"]
props = { text = ".zui prototypes", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small" }
layout = { width = { min = 118.0, preferred = 118.0, max = 118.0, stretch = "Fixed" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }

[nodes.toolbar_root]
component = "HorizontalBox"
control_id = "ShowcaseCommandToolbarRoot"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" } }
children = [
  { node = "toolbar_label" },
  { node = "toolbar_compile" },
  { node = "toolbar_preview" },
  { node = "toolbar_reset" },
  { node = "toolbar_fill" },
  { node = "toolbar_runtime_badge" },
]
