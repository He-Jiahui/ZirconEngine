layout = { width = { min = 52.0, preferred = 52.0, max = 52.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Ability", event = "Click", route = "WorkbenchModule.Ability" }]

[nodes.module_tags]
component = "WorkbenchTab"
control_id = "WorkbenchModuleTags"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Tags", checked = false, selected = false, value = false }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Tags", event = "Click", route = "WorkbenchModule.Tags" }]

[nodes.module_perception]
component = "WorkbenchTab"
control_id = "WorkbenchModulePerception"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Percept", checked = false, selected = false, value = false }
layout = { width = { min = 54.0, preferred = 54.0, max = 54.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Perception", event = "Click", route = "WorkbenchModule.Perception" }]

[nodes.module_material]
component = "WorkbenchTab"
control_id = "WorkbenchModuleMaterial"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Mat", checked = false, selected = false, value = false }
layout = { width = { min = 48.0, preferred = 48.0, max = 48.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Material", event = "Click", route = "WorkbenchModule.Material" }]

[nodes.module_behavior]
component = "WorkbenchTab"
control_id = "WorkbenchModuleBehavior"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Behav", checked = false, selected = false, value = false }
layout = { width = { min = 52.0, preferred = 52.0, max = 52.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Behavior", event = "Click", route = "WorkbenchModule.Behavior" }]

[nodes.module_render]
component = "WorkbenchTab"
control_id = "WorkbenchModuleRender"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Render", checked = false, selected = false, value = false }
layout = { width = { min = 48.0, preferred = 48.0, max = 48.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Render", event = "Click", route = "WorkbenchModule.Render" }]

[nodes.module_assets]
component = "WorkbenchTab"
control_id = "WorkbenchModuleAssets"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Asset", checked = false, selected = false, value = false }
layout = { width = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Assets", event = "Click", route = "WorkbenchModule.Assets" }]

[nodes.module_vfx]
component = "WorkbenchTab"
control_id = "WorkbenchModuleVfx"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "VFX", checked = false, selected = false, value = false }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Vfx", event = "Click", route = "WorkbenchModule.Vfx" }]

[nodes.module_hud]
component = "WorkbenchTab"
control_id = "WorkbenchModuleHud"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "HUD", checked = false, selected = false, value = false }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Hud", event = "Click", route = "WorkbenchModule.Hud" }]

[nodes.toolbar_module_commands]
component = "HorizontalGroup"
control_id = "WorkbenchModuleCommands"
classes = ["workbench-toolbar-group", "workbench-module-commands"]
layout = { container = { kind = "HorizontalBox", gap = 6.0 }, width = { min = 286.0, preferred = 286.0, max = 286.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "module_save" }, { node = "module_browse" }, { node = "module_compile" }, { node = "module_diff" }, { node = "module_simulate" }]

[nodes.module_save]
component = "WorkbenchButton"
control_id = "WorkbenchModuleSave"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Save", icon = "editor_pages/workbench/menu/save-all.svg", button_variant = "outlined", button_color = "secondary", button_size = "small", background_color = "#1a1f23", border_color = "#303840", layout_spacing = 6.0 }
layout = { width = { min = 48.0, preferred = 48.0, max = 48.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Save", event = "Click", route = "WorkbenchModule.Save" }]

[nodes.module_browse]
component = "WorkbenchButton"
control_id = "WorkbenchModuleBrowse"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Browse", icon = "editor_pages/workbench/menu/open-project.svg", button_variant = "outlined", button_color = "secondary", button_size = "small", background_color = "#1a1f23", border_color = "#303840", layout_spacing = 6.0 }
layout = { width = { min = 62.0, preferred = 62.0, max = 62.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Browse", event = "Click", route = "WorkbenchModule.Browse" }]

[nodes.module_compile]
component = "WorkbenchButton"
control_id = "WorkbenchModuleCompile"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Compile", icon = "editor_pages/workbench/menu/command-palette.svg", button_variant = "filled", button_color = "accent", button_size = "small", background_color = "#12383d", border_color = "#209fa8", selected = true, checked = true, layout_spacing = 6.0 }
layout = { width = { min = 70.0, preferred = 70.0, max = 70.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Compile", event = "Click", route = "WorkbenchModule.Compile" }]

[nodes.module_diff]
component = "WorkbenchButton"
control_id = "WorkbenchModuleDiff"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Diff", button_variant = "outlined", button_color = "secondary", button_size = "small", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { min = 42.0, preferred = 42.0, max = 42.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Diff", event = "Click", route = "WorkbenchModule.Diff" }]

[nodes.module_simulate]
component = "WorkbenchButton"
control_id = "WorkbenchModuleSimulate"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Sim", button_variant = "outlined", button_color = "secondary", button_size = "small", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Simulate", event = "Click", route = "WorkbenchModule.Simulate" }]

[nodes.toolbar_tool_group]
component = "HorizontalGroup"
control_id = "WorkbenchToolbarToolGroup"
classes = ["workbench-toolbar-group"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { min = 230.0, preferred = 230.0, max = 230.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "tool_select" }, { node = "tool_move" }, { node = "tool_rotate" }, { node = "tool_scale" }, { node = "tool_snap" }]

[nodes.tool_select]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolSelect"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/select.svg", label = "Select", selected = true, checked = true, button_interaction_state = "pressed" }
layout = { width = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" }, height = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" } }
events = [{ id = "Tool/Select", event = "Click", route = "Tool.Select" }]

[nodes.tool_move]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolMove"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/move.svg", label = "Move" }
layout = { width = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" }, height = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" } }
events = [{ id = "Tool/Move", event = "Click", route = "Tool.Move" }]

[nodes.tool_rotate]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolRotate"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/rotate.svg", label = "Rotate" }
layout = { width = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" }, height = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" } }
events = [{ id = "Tool/Rotate", event = "Click", route = "Tool.Rotate" }]

[nodes.tool_scale]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolScale"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/scale.svg", label = "Scale" }
layout = { width = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" }, height = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" } }
events = [{ id = "Tool/Scale", event = "Click", route = "Tool.Scale" }]

[nodes.tool_snap]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolSnap"
classes = ["workbench-icon-button"]
props = { icon = "editor_pages/scene_viewport/snapping/grid-snap.svg", label = "Snap" }
layout = { width = { min = 46.0, preferred = 46.0, max = 46.0, stretch = "Fixed" }, height = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" } }
events = [{ id = "Tool/ToggleSnap", event = "Click", route = "Tool.ToggleSnap" }]

[nodes.toolbar_spacer_right]
component = "Container"
control_id = "WorkbenchToolbarSpacerRight"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_run_group]
component = "HorizontalGroup"
control_id = "WorkbenchToolbarRunGroup"
classes = ["workbench-toolbar-group"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { min = 176.0, preferred = 176.0, max = 176.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "run_play" }, { node = "run_mode" }, { node = "layout_grid" }, { node = "theme_toggle" }]

[nodes.run_play]
component = "WorkbenchIconButton"
control_id = "WorkbenchRunPlay"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/play.svg", label = "Play" }
layout = { width = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" }, height = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" } }
events = [{ id = "Run/Play", event = "Click", route = "Run.Play" }]

[nodes.run_mode]
