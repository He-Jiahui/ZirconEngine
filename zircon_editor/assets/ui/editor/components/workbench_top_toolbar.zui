[asset]
kind = "component"
id = "res://ui/editor/components/workbench_top_toolbar.zui"
version = 2
display_name = "Workbench Top Toolbar"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_icon_button.zui#WorkbenchIconButton",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
]
styles = []

[components.WorkbenchTopToolbar]
root = "top_toolbar"
default_classes = ["workbench-topbar"]

[nodes.top_toolbar]
component = "HorizontalGroup"
control_id = "WorkbenchWindowTopToolbar"
classes = ["workbench-topbar"]
layout = { container = { kind = "HorizontalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { min = 60.0, preferred = 60.0, max = 60.0, stretch = "Fixed" } }
children = [
  { node = "toolbar_file_group" },
  { node = "toolbar_spacer_left" },
  { node = "toolbar_module_tabs" },
  { node = "toolbar_module_commands" },
  { node = "toolbar_tool_group" },
  { node = "toolbar_spacer_right" },
  { node = "toolbar_run_group" },
]

[nodes.toolbar_file_group]
component = "HorizontalGroup"
control_id = "WorkbenchToolbarFileGroup"
classes = ["workbench-toolbar-group"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { min = 166.0, preferred = 166.0, max = 166.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "toolbar_menu" }, { node = "toolbar_new" }, { node = "toolbar_open" }, { node = "toolbar_save" }]

[nodes.toolbar_menu]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarMenu"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/menu.svg", label = "Menu" }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "MenuAction/OpenMainMenu", event = "Click", route = "MenuAction.workbench.menu.main.open" }]

[nodes.toolbar_new]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarNew"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/file-new.svg", label = "New" }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "MenuAction/NewAsset", event = "Click", route = "MenuAction.workbench.asset.create" }]

[nodes.toolbar_open]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarOpen"
classes = ["workbench-icon-button"]
props = { icon = "editor_pages/workbench/menu/open-project.svg", label = "Open" }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "MenuAction/OpenProject", event = "Click", route = "MenuAction.workbench.project.open" }]

[nodes.toolbar_save]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarSave"
classes = ["workbench-icon-button"]
props = { icon = "editor_pages/workbench/menu/save-all.svg", label = "Save" }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "MenuAction/SaveProject", event = "Click", route = "MenuAction.workbench.project.save" }]

[nodes.toolbar_spacer_left]
component = "Container"
control_id = "WorkbenchToolbarSpacerLeft"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_module_tabs]
component = "HorizontalGroup"
control_id = "WorkbenchModuleTabs"
classes = ["workbench-toolbar-group", "workbench-module-tabs"]
layout = { container = { kind = "HorizontalBox", gap = 4.0 }, width = { min = 530.0, preferred = 530.0, max = 530.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "module_scene" }, { node = "module_effect" }, { node = "module_ability" }, { node = "module_tags" }, { node = "module_perception" }, { node = "module_material" }, { node = "module_behavior" }, { node = "module_render" }, { node = "module_assets" }, { node = "module_vfx" }, { node = "module_hud" }]

[nodes.module_scene]
component = "WorkbenchTab"
control_id = "WorkbenchModuleScene"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Scene", checked = false, selected = false, value = false }
layout = { width = { min = 42.0, preferred = 42.0, max = 42.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Scene", event = "Click", route = "WorkbenchModule.Scene" }]

[nodes.module_effect]
component = "WorkbenchTab"
control_id = "WorkbenchModuleEffect"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Effect", checked = true, selected = true, value = true }
layout = { width = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchModule/Effect", event = "Click", route = "WorkbenchModule.Effect" }]

