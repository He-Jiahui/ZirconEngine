classes = ["workbench-icon-button"]
props = { icon = "editor_pages/workbench/tabs/tab-overflow.svg", label = "Run Mode" }
layout = { width = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" }, height = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" } }
events = [{ id = "Run/OpenModeMenu", event = "Click", route = "Run.OpenModeMenu" }]

[nodes.layout_grid]
component = "WorkbenchIconButton"
control_id = "WorkbenchLayoutGrid"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/layout-grid.svg", label = "Layouts" }
layout = { width = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" }, height = { min = 40.0, preferred = 40.0, max = 40.0, stretch = "Fixed" } }
events = [{ id = "DockCommand/OpenLayoutMenu", event = "Click", route = "DockCommand.OpenLayoutMenu" }]

[nodes.theme_toggle]
