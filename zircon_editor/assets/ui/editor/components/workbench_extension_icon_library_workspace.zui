[asset]
kind = "component"
id = "res://ui/editor/components/workbench_extension_icon_library_workspace.zui"
version = 2
display_name = "Workbench Extension Icon Library Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionIconLibraryWorkspace]
root = "icon_library_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.icon_library_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionIconLibraryWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "icon_library_rail_gap" }, { node = "icon_library_left" }, { node = "icon_library_center" }, { node = "icon_library_right" }]

[nodes.icon_library_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionIconLibraryRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.icon_library_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionIconLibraryLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "icon_library_title" }, { node = "icon_library_icon_tab" }, { node = "icon_library_usage_tab" }, { node = "icon_library_export_tab" }, { node = "icon_library_editor_core_row" }, { node = "icon_library_warning_row" }, { node = "icon_library_usage_topbar_row" }]

[nodes.icon_library_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionIconLibraryTitle"
props = { text = "Icon Library" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.icon_library_icon_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionIconLibraryIconTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Icon", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryIconTab", event = "Click", route = "WorkbenchExtension.IconLibrary.Icon" }]

[nodes.icon_library_usage_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionIconLibraryUsageTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Usage", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryUsageTab", event = "Click", route = "WorkbenchExtension.IconLibrary.Usage" }]

[nodes.icon_library_export_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionIconLibraryExportTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Export", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryExportTab", event = "Click", route = "WorkbenchExtension.IconLibrary.Export" }]

[nodes.icon_library_editor_core_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionIconLibraryEditorCoreRow"
classes = ["workbench-list-row"]
props = { text = "Editor_Core", icon = "image", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryEditorCoreRow", event = "Click", route = "WorkbenchExtension.IconLibrary.Asset.EditorCore" }]

[nodes.icon_library_warning_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionIconLibraryWarningRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "icon-warning", icon = "alert", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryWarningRow", event = "Click", route = "WorkbenchExtension.IconLibrary.Asset.Warning" }]

[nodes.icon_library_usage_topbar_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionIconLibraryUsageTopbarRow"
classes = ["workbench-list-row"]
props = { text = "Usage_Topbar", icon = "layout", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryUsageTopbarRow", event = "Click", route = "WorkbenchExtension.IconLibrary.Asset.UsageTopbar" }]

[nodes.icon_library_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionIconLibraryCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "icon_library_center_header" }, { node = "icon_library_table" }, { node = "icon_library_output" }]

[nodes.icon_library_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionIconLibraryCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "icon_library_center_title" }, { node = "icon_library_header_fill" }, { node = "icon_library_find_usage_button" }, { node = "icon_library_validate_button" }]

[nodes.icon_library_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionIconLibraryCenterTitle"
props = { text = "Icon Usage Matrix" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.icon_library_header_fill]
component = "Container"
control_id = "WorkbenchExtensionIconLibraryHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.icon_library_find_usage_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionIconLibraryFindUsageButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Find Usage", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 98.0, preferred = 98.0, max = 108.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryFindUsage", event = "Click", route = "WorkbenchExtension.IconLibrary.FindUsage" }]

[nodes.icon_library_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionIconLibraryValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 88.0, preferred = 88.0, max = 98.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryValidate", event = "Click", route = "WorkbenchExtension.IconLibrary.Validate" }]

[nodes.icon_library_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionIconLibraryTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "icon_library_save_table_row" }, { node = "icon_library_play_table_row" }, { node = "icon_library_warning_table_row" }, { node = "icon_library_legacy_table_row" }]

[nodes.icon_library_save_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionIconLibrarySaveTableRow"
classes = ["workbench-table-row"]
props = { text = "icon-save", value_text = "Editor   18 refs   ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibrarySaveTableRow", event = "Click", route = "WorkbenchExtension.IconLibrary.Row.Save" }]

[nodes.icon_library_play_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionIconLibraryPlayTableRow"
classes = ["workbench-table-row"]
props = { text = "icon-play", value_text = "Editor   22 refs   ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryPlayTableRow", event = "Click", route = "WorkbenchExtension.IconLibrary.Row.Play" }]

[nodes.icon_library_warning_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionIconLibraryWarningTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "icon-warning", value_text = "System   14 refs   selected" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryWarningTableRow", event = "Click", route = "WorkbenchExtension.IconLibrary.Row.Warning" }]

[nodes.icon_library_legacy_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionIconLibraryLegacyTableRow"
classes = ["workbench-table-row"]
props = { text = "icon-old", value_text = "Legacy   0 refs   warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryLegacyTableRow", event = "Click", route = "WorkbenchExtension.IconLibrary.Row.Legacy" }]

[nodes.icon_library_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionIconLibraryOutputRow"
classes = ["workbench-table-row"]
props = { text = "Icon Library", value_text = "312 icons   268 used   4 missing" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/IconLibraryOutput", event = "Click", route = "WorkbenchExtension.IconLibrary.Output" }]

[nodes.icon_library_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionIconLibraryRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "icon_library_details_title" }, { node = "icon_library_icon_dropdown" }, { node = "icon_library_set_dropdown" }, { node = "icon_library_color_token_field" }]

[nodes.icon_library_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionIconLibraryDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.icon_library_icon_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionIconLibraryIconDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "icon-warning", value = "icon-warning", options = ["icon-save", "icon-play", "icon-warning", "icon-old"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/IconLibraryIconEdit", event = "Change", route = "WorkbenchExtension.IconLibrary.Icon.Edit" },
  { id = "WorkbenchExtension/IconLibraryIconCommit", event = "Submit", route = "WorkbenchExtension.IconLibrary.Icon.Commit" },
]

[nodes.icon_library_set_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionIconLibrarySetDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Editor Core", value = "Editor Core", options = ["Editor Core", "System", "Legacy"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/IconLibrarySetEdit", event = "Change", route = "WorkbenchExtension.IconLibrary.Set.Edit" },
  { id = "WorkbenchExtension/IconLibrarySetCommit", event = "Submit", route = "WorkbenchExtension.IconLibrary.Set.Commit" },
]

[nodes.icon_library_color_token_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionIconLibraryColorTokenField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "color.warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/IconLibraryColorTokenEdit", event = "Change", route = "WorkbenchExtension.IconLibrary.ColorToken.Edit" },
  { id = "WorkbenchExtension/IconLibraryColorTokenCommit", event = "Submit", route = "WorkbenchExtension.IconLibrary.ColorToken.Commit" },
]
