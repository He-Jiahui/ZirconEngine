[asset]
kind = "component"
id = "res://ui/editor/components/workbench_component_drawer.zui"
version = 2
display_name = "Workbench Component Drawer"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_checkbox.zui#WorkbenchCheckbox",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_icon_button.zui#WorkbenchIconButton",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_popup_menu.zui#WorkbenchPopupMenu",
  "res://ui/editor/components/workbench_radio.zui#WorkbenchRadio",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_segmented_control.zui#WorkbenchSegmentedControl",
  "res://ui/editor/components/workbench_slider.zui#WorkbenchSlider",
  "res://ui/editor/components/workbench_status_item.zui#WorkbenchStatusItem",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench_toast.zui#WorkbenchToast",
  "res://ui/editor/components/workbench_tooltip.zui#WorkbenchTooltip",
  "res://ui/editor/components/workbench_toggle.zui#WorkbenchToggle",
]
styles = []

[components.WorkbenchComponentDrawer]
root = "component_drawer"
default_classes = ["workbench-component-drawer"]

[nodes.component_drawer]
component = "VerticalGroup"
control_id = "WorkbenchComponentDrawer"
classes = ["workbench-component-drawer"]
layout = { clip = true, container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = 407.0, preferred = 407.0, max = 407.0, stretch = "Fixed" } }
children = [{ node = "drawer_tabs" }, { node = "component_body" }, { node = "console_body" }]

[nodes.drawer_tabs]
component = "HorizontalGroup"
control_id = "WorkbenchComponentDrawerTabs"
classes = ["workbench-tabs"]
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = 42.0, preferred = 42.0, max = 42.0, stretch = "Fixed" } }
children = [{ node = "drawer_tab_components" }, { node = "drawer_tab_console" }]

[nodes.drawer_tab_components]
component = "WorkbenchTab"
control_id = "WorkbenchDrawerTabComponents"
classes = ["workbench-tab"]
props = { text = "UI Components", checked = true, selected = true, value = true }
layout = { width = { min = 150.0, preferred = 150.0, max = 170.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "PanelTab/ComponentDrawerComponents", event = "Click", route = "PanelTab.Select.ComponentDrawerComponents" }]

[nodes.drawer_tab_console]
component = "WorkbenchTab"
control_id = "WorkbenchDrawerTabConsole"
classes = ["workbench-tab"]
props = { text = "Console", checked = false, selected = false, value = false }
layout = { width = { min = 110.0, preferred = 110.0, max = 130.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "PanelTab/ComponentDrawerConsole", event = "Click", route = "PanelTab.Select.ComponentDrawerConsole" }]

[nodes.component_body]
component = "VerticalGroup"
control_id = "WorkbenchComponentDrawerBody"
classes = ["workbench-component-drawer-body"]
layout = { clip = true, container = { kind = "VerticalBox", gap = 12.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "component_top_row" }, { node = "component_lower_row" }]

[nodes.component_top_row]
component = "HorizontalGroup"
control_id = "WorkbenchComponentTopRow"
classes = ["workbench-component-grid-row"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = 12.0 }, width = { stretch = "Stretch" }, height = { min = 202.0, preferred = 202.0, max = 202.0, stretch = "Fixed" } }
children = [{ node = "component_buttons" }, { node = "component_icon_buttons" }, { node = "component_inputs" }, { node = "component_selection" }, { node = "component_sliders" }, { node = "component_labs" }, { node = "component_list" }]

[nodes.component_lower_row]
component = "HorizontalGroup"
control_id = "WorkbenchComponentLowerRow"
classes = ["workbench-lower-demo"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = 12.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "component_table" }, { node = "component_feedback" }]

[nodes.console_body]
component = "VerticalGroup"
control_id = "WorkbenchComponentDrawerConsoleBody"
classes = ["workbench-panel", "workbench-console-panel"]
props = { visibility = "collapsed" }
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_info" }, { node = "console_warning" }, { node = "console_ok" }]

[nodes.console_info]
component = "WorkbenchStatusItem"
control_id = "WorkbenchConsoleInfo"
classes = ["workbench-status-item", "workbench-info"]
props = { text = "UI component palette loaded" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.console_warning]
component = "WorkbenchStatusItem"
control_id = "WorkbenchConsoleWarning"
classes = ["workbench-status-item", "workbench-warning"]
props = { text = "2 layout warnings" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.console_ok]
component = "WorkbenchStatusItem"
control_id = "WorkbenchConsoleOk"
classes = ["workbench-status-item", "workbench-success"]
props = { text = "No runtime errors" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.component_buttons]
component = "VerticalGroup"
control_id = "WorkbenchComponentButtons"
classes = ["workbench-panel"]
layout = { container = { kind = "VerticalBox", gap = 7.0 }, width = { min = 204.0, preferred = 204.0, max = 204.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "buttons_title" }, { node = "buttons_row_primary" }, { node = "buttons_row_variant" }, { node = "buttons_row_icon" }, { node = "buttons_row_tail" }]

[nodes.buttons_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchButtonsTitle"
classes = ["workbench-section-title"]
props = { text = "Buttons" }
layout = { width = { stretch = "Stretch" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = "Fixed" } }

[nodes.buttons_row_primary]
component = "HorizontalGroup"
control_id = "WorkbenchButtonsRowPrimary"
props = { layout_gap = 8.0 }
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
children = [{ node = "primary_button" }, { node = "secondary_button" }]

[nodes.primary_button]
component = "WorkbenchButton"
control_id = "WorkbenchPrimaryButton"
classes = ["workbench-primary-button"]
props = { text = "Primary", button_variant = "filled", button_color = "accent", button_size = "small", background_color = "#29a4b8", border_color = "#1c8798", layout_offset_x = 3.0, layout_offset_y = -1.0, font_size = 12.22, visual_brightness = 1.0 }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/Primary", event = "Click", route = "ComponentLab.Primary" }]

[nodes.secondary_button]
component = "WorkbenchButton"
control_id = "WorkbenchSecondaryButton"
classes = ["workbench-control-button"]
props = { text = "Secondary", button_variant = "outlined", button_color = "secondary", button_size = "small", background_color = "#1a1f23", layout_offset_x = 1.0, layout_offset_y = -1.0, font_size = 12.22, visual_brightness = 1.01 }
layout = { width = { min = 82.0, preferred = 82.0, max = 82.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/Secondary", event = "Click", route = "ComponentLab.Secondary" }]

[nodes.buttons_row_variant]
component = "HorizontalGroup"
control_id = "WorkbenchButtonsRowVariant"
props = { layout_gap = 8.0 }
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
children = [{ node = "tertiary_button" }, { node = "outline_button" }]

[nodes.tertiary_button]
component = "WorkbenchButton"
control_id = "WorkbenchTertiaryButton"
classes = ["workbench-control-button", "workbench-tertiary-button"]
props = { text = "Tertiary", button_variant = "text", button_color = "secondary", button_size = "small", background_color = "#171c20", border_color = "#252e35", foreground_color = "#879299", corner_radius = 9.0, layout_offset_x = 1.0 }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/Tertiary", event = "Click", route = "ComponentLab.Tertiary" }]

[nodes.outline_button]
component = "WorkbenchButton"
control_id = "WorkbenchOutlineButton"
classes = ["workbench-control-button", "workbench-outline-button"]
props = { text = "Outline", button_variant = "outlined", button_color = "secondary", button_size = "small", border_color = "#252e35", foreground_color = "#879299", corner_radius = 9.0, layout_offset_x = 1.0 }
layout = { width = { min = 82.0, preferred = 82.0, max = 82.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/Outline", event = "Click", route = "ComponentLab.Outline" }]

[nodes.buttons_row_icon]
component = "HorizontalGroup"
control_id = "WorkbenchButtonsRowIcon"
props = { layout_gap = 8.0 }
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
children = [{ node = "button_icon" }, { node = "button_delete" }]

[nodes.button_icon]
component = "WorkbenchButton"
control_id = "WorkbenchButtonIcon"
classes = ["workbench-control-button", "workbench-button-icon"]
props = { text = "Icon", icon = "plus", button_variant = "outlined", button_color = "secondary", button_size = "small", background_color = "#20262a", border_color = "#303840", foreground_color = "#7f8a91", corner_radius = 9.0, layout_offset_x = 3.0, layout_offset_y = 1.0, visual_brightness = 1.02 }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/IconButton", event = "Click", route = "ComponentLab.IconButton" }]

[nodes.button_delete]
component = "WorkbenchButton"
control_id = "WorkbenchButtonDelete"
classes = ["workbench-control-button", "workbench-danger"]
props = { text = "", icon = "trash", button_variant = "outlined", button_color = "danger", button_size = "small", validation_level = "danger", foreground_color = "#d05a50", corner_radius = 9.0, layout_offset_x = 3.0, layout_offset_y = 1.0, visual_brightness = 1.02 }
layout = { width = { min = 82.0, preferred = 82.0, max = 82.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/DeleteButton", event = "Click", route = "ComponentLab.DeleteButton" }]

[nodes.buttons_row_tail]
component = "HorizontalGroup"
control_id = "WorkbenchButtonsRowTail"
props = { layout_gap = 8.0 }
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
children = [{ node = "disabled_button" }, { node = "dropdown_button" }]

[nodes.disabled_button]
component = "WorkbenchButton"
control_id = "WorkbenchDisabledButton"
classes = ["workbench-control-button", "workbench-disabled-button"]
props = { text = "Disabled", button_variant = "outlined", button_color = "secondary", button_size = "small", disabled = true, background_color = "#2d3337", border_color = "#343d44", foreground_color = "#747f86", disabled_opacity = 0.72, layout_offset_x = -1.0, layout_offset_y = 3.5 }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.dropdown_button]
component = "WorkbenchDropdown"
control_id = "WorkbenchDropdownButton"
classes = ["workbench-field", "workbench-button-dropdown"]
props = { value = "dropdown", value_text = "Dropdown", options = ["dropdown", "option_a", "option_b"], popup_open = false, layout_width = 82.0, value_color = "#7f8a91", arrow_color = "#67737a", border_color = "#1f272e", layout_offset_x = -1.0, layout_offset_y = 3.5, visual_brightness = 1.005 }
layout = { width = { min = 82.0, preferred = 82.0, max = 82.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/ButtonDropdownOpen", event = "Click", route = "ComponentLab.OpenPopup.ButtonDropdown" }, { id = "ComponentLab/ButtonDropdownSelect", event = "Change", route = "ComponentLab.SelectOption.ButtonDropdown" }]

[nodes.component_icon_buttons]
component = "VerticalGroup"
control_id = "WorkbenchComponentIconButtons"
classes = ["workbench-panel"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 210.0, preferred = 210.0, max = 210.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "icon_buttons_title" }, { node = "icon_grid_row_top" }, { node = "icon_grid_row_bottom" }, { node = "icon_toggle_title" }, { node = "icon_toggle_segment" }]

[nodes.icon_buttons_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchIconButtonsTitle"
classes = ["workbench-section-title"]
props = { text = "Icon Buttons" }
layout = { width = { stretch = "Stretch" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = "Fixed" } }

[nodes.icon_grid_row_top]
component = "HorizontalGroup"
control_id = "WorkbenchIconButtonGridTop"
props = { layout_gap = 6.0 }
layout = { container = { kind = "HorizontalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }
children = [{ node = "mini_add" }, { node = "mini_folder" }, { node = "mini_save" }, { node = "mini_delete" }]

[nodes.mini_add]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniAdd"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/controls/add.svg", label = "Add", layout_icon_size = 18.0, icon_size = 18.0, layout_offset_y = 1.35, icon_color = "#98a3a8", background_color = "#272d31", border_color = "#171f26", corner_radius = 10.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.mini_folder]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniFolder"
classes = ["workbench-icon-button"]
props = { icon = "editor_pages/workbench/menu/open-project.svg", label = "Open", layout_icon_size = 18.0, icon_size = 18.0, layout_offset_y = 1.35, icon_color = "#98a3a8", background_color = "#272d31", border_color = "#171f26", corner_radius = 10.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.mini_save]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniSave"
classes = ["workbench-icon-button"]
props = { icon = "editor_pages/workbench/menu/save-all.svg", label = "Save", layout_icon_size = 18.0, icon_size = 18.0, layout_offset_y = 1.35, icon_color = "#98a3a8", background_color = "#272d31", border_color = "#171f26", corner_radius = 10.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.mini_delete]
