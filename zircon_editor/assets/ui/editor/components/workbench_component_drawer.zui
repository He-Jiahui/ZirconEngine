control_id = "WorkbenchIconToggleSegmented"
classes = ["workbench-segmented-control", "workbench-icon-toggle-segmented"]
props = { value = "grid", options = ["grid", "list", "columns"], selection_state = "single", layout_width = 150.0, layout_offset_y = 1.0, selected_segment_border_width = 0.0, selected_segment_underline_height = 1.0, selected_segment_underline_color = "#32d3de7a" }
