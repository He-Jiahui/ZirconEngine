[nodes.component_inputs]
component = "VerticalGroup"
control_id = "WorkbenchComponentInputs"
classes = ["workbench-panel"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 214.0, preferred = 214.0, max = 214.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
