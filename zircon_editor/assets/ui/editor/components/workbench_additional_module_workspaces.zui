layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/HudAmmoPanel", event = "Click", route = "WorkbenchModule.Hud.AmmoPanel" }]

[nodes.hud_binding_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchHudBindingRow"
classes = ["workbench-table-row"]
