[asset]
kind = "component"
id = "res://ui/editor/components/workbench_additional_module_workspaces.zui"
version = 2
display_name = "Workbench Additional Module Workspaces"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchAdditionalModuleWorkspaces]
root = "additional_module_workspaces"
default_classes = ["workbench-module-workspace"]

[nodes.additional_module_workspaces]
component = "Overlay"
control_id = "WorkbenchAdditionalModuleWorkspaces"
classes = ["workbench-module-workspace"]
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "ability_workspace" },
  { node = "tags_workspace" },
  { node = "perception_workspace" },
  { node = "render_workspace" },
  { node = "hud_workspace" },
]

[nodes.ability_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchModuleAbilityWorkspace"
classes = ["workbench-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_rail_gap" }, { node = "ability_left" }, { node = "ability_center" }, { node = "ability_right" }]

[nodes.ability_rail_gap]
component = "Container"
control_id = "WorkbenchAbilityRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.ability_left]
component = "VerticalGroup"
control_id = "WorkbenchAbilityLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_title" }, { node = "ability_graph_tab" }, { node = "ability_tasks_tab" }, { node = "ability_debug_tab" }, { node = "ability_task_row_01" }, { node = "ability_task_row_02" }, { node = "ability_asset_row" }]

[nodes.ability_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityTitle"
props = { text = "Gameplay Ability" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.ability_graph_tab]
component = "WorkbenchTab"
control_id = "WorkbenchAbilityGraphTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Graph", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityGraphTab", event = "Click", route = "WorkbenchModule.Ability.Graph" }]

[nodes.ability_tasks_tab]
component = "WorkbenchTab"
control_id = "WorkbenchAbilityTasksTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Tasks", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityTasksTab", event = "Click", route = "WorkbenchModule.Ability.Tasks" }]

[nodes.ability_debug_tab]
component = "WorkbenchTab"
control_id = "WorkbenchAbilityDebugTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Debug", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityDebugTab", event = "Click", route = "WorkbenchModule.Ability.Debug" }]

[nodes.ability_task_row_01]
component = "WorkbenchListRow"
control_id = "WorkbenchAbilityTaskActivateRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Activate Ability", icon = "play", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityTaskActivate", event = "Click", route = "WorkbenchModule.Ability.Task.Activate" }]

[nodes.ability_task_row_02]
component = "WorkbenchListRow"
control_id = "WorkbenchAbilityTaskCostRow"
classes = ["workbench-list-row"]
props = { text = "Apply Cost", icon = "gear", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityTaskCost", event = "Click", route = "WorkbenchModule.Ability.Task.Cost" }]

[nodes.ability_asset_row]
component = "WorkbenchListRow"
control_id = "WorkbenchAbilityAssetRow"
classes = ["workbench-list-row"]
props = { text = "GA_DashAttack", icon = "play", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityAssetDash", event = "Click", route = "WorkbenchModule.Ability.Asset.Dash" }]

[nodes.ability_center]
component = "VerticalGroup"
control_id = "WorkbenchAbilityCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_center_header" }, { node = "ability_graph_canvas" }, { node = "ability_output" }]

[nodes.ability_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchAbilityCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "ability_center_title" }, { node = "ability_header_fill" }, { node = "ability_playtest_button" }]

[nodes.ability_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityCenterTitle"
props = { text = "Ability Graph" }
layout = { width = { min = 160.0, preferred = 160.0, max = 180.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.ability_header_fill]
component = "Container"
control_id = "WorkbenchAbilityHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.ability_playtest_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityPlaytestButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Playtest", button_variant = "filled", button_color = "accent", background_color = "#12383d", border_color = "#209fa8" }
layout = { width = { min = 82.0, preferred = 82.0, max = 92.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityPlaytest", event = "Click", route = "WorkbenchModule.Ability.Playtest" }]

[nodes.ability_graph_canvas]
component = "VerticalGroup"
control_id = "WorkbenchAbilityGraphCanvas"
classes = ["workbench-panel", "workbench-module-graph"]
layout = { container = { kind = "VerticalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_phase_table" }, { node = "ability_phase_row_01" }, { node = "ability_phase_row_02" }, { node = "ability_graph_row" }]

[nodes.ability_phase_table]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityPhaseTable"
props = { text = "Phase Matrix" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.ability_phase_row_01]
component = "WorkbenchTableRow"
control_id = "WorkbenchAbilityPhaseActivateRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Activation", value_text = "Activate Ability   Server   Ready", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityPhaseActivate", event = "Click", route = "WorkbenchModule.Ability.Phase.Activate" }]

[nodes.ability_phase_row_02]
component = "WorkbenchTableRow"
control_id = "WorkbenchAbilityPhaseCostRow"
