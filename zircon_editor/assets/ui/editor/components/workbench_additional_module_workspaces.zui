layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityPhaseCost", event = "Click", route = "WorkbenchModule.Ability.Phase.Cost" }]

[nodes.ability_graph_row]
