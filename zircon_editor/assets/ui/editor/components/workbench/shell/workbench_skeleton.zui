[asset]
kind = "component"
id = "res://ui/editor/components/workbench/shell/workbench_skeleton.zui"
version = 2
display_name = "Workbench Skeleton"

[imports]
widgets = [
  "res://ui/editor/components/workbench/shell/workbench_top_toolbar.zui#WorkbenchTopToolbar",
  "res://ui/editor/components/workbench/shell/workbench_activity_rail.zui#WorkbenchActivityRail",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab_strip.zui#WorkbenchTabStrip",
  "res://ui/editor/components/workbench/shell/workbench_main_band.zui#WorkbenchMainBand",
  "res://ui/editor/components/workbench/shell/workbench_status_bar.zui#WorkbenchStatusBar",
]
styles = [
  "res://ui/theme/editor_workbench_spatial.zui",
]

[components.WorkbenchSkeleton]
root = "skeleton"
default_classes = ["workbench-skeleton"]

[nodes.skeleton]
component = "VerticalGroup"
control_id = "WorkbenchSkeleton"
classes = ["workbench-skeleton"]
style = { self = { background = { color = "$editor.surface.0" }, foreground = { color = "$editor.text.primary" }, border = { color = "$editor.border", width = 0.0, radius = 0.0 } } }
layout = { clip = true, container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "top_toolbar" }, { node = "document_tabs" }, { node = "main_band" }, { node = "status_bar" }]

[nodes.top_toolbar]
component = "WorkbenchTopToolbar"
control_id = "WorkbenchSkeletonTopToolbar"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.chrome.workbench_toolbar.height", preferred = "$editor.chrome.workbench_toolbar.height", max = "$editor.chrome.workbench_toolbar.height", stretch = "Fixed" } }

[nodes.document_tabs]
component = "WorkbenchTabStrip"
control_id = "WorkbenchSkeletonDocumentTabs"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }

[nodes.main_band]
component = "WorkbenchMainBand"
control_id = "WorkbenchSkeletonMainBand"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.status_bar]
component = "WorkbenchStatusBar"
control_id = "WorkbenchSkeletonStatusBar"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.chrome.status_bar.height", preferred = "$editor.chrome.status_bar.height", max = "$editor.chrome.status_bar.height", stretch = "Fixed" } }
