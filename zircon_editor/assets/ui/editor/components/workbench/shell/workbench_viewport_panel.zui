[asset]
kind = "component"
id = "res://ui/editor/components/workbench/shell/workbench_viewport_panel.zui"
version = 2
display_name = "Workbench Viewport Panel"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/chrome/workbench_chip.zui#WorkbenchChip",
  "res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel",
]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchViewportPanel]
root = "viewport_panel"
default_classes = ["workbench-viewport-panel"]

[nodes.viewport_panel]
component = "VerticalGroup"
control_id = "WorkbenchViewportPanel"
classes = ["workbench-viewport-panel"]
layout = { clip = true, container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "document_tabs" }, { node = "viewport_toolbar" }, { node = "viewport_surface" }]

[nodes.document_tabs]
component = "DocumentTabs"
control_id = "DocumentTabsRoot"
classes = ["workbench-document-tabs", "workbench-tab-strip"]
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.chrome.document_header.height", preferred = "$editor.chrome.document_header.height", max = "$editor.chrome.document_header.height", stretch = "Fixed" } }
events = [
  { id = "DocumentTabs/ActivateTab", event = "Change", route = "workbench.dock.focus_view" },
  { id = "DocumentTabs/CloseTab", event = "Submit", route = "workbench.dock.close_view" },
]

[nodes.viewport_toolbar]
component = "HorizontalGroup"
control_id = "WorkbenchViewportToolbar"
classes = ["workbench-viewport-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" } }
children = [{ node = "viewport_mode" }, { node = "viewport_lit" }, { node = "viewport_toolbar_fill" }, { node = "viewport_angle" }, { node = "viewport_speed" }]

[nodes.viewport_mode]
component = "WorkbenchChip"
control_id = "WorkbenchViewportMode"
classes = ["workbench-chip"]
props = { text = "Perspective", layout_min_height = "$editor.chrome.viewport_toolbar.height" }
layout = { width = { min = 108.0, preferred = 108.0, max = 108.0, stretch = "Fixed" }, height = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" } }

[nodes.viewport_lit]
component = "WorkbenchChip"
control_id = "WorkbenchViewportLit"
classes = ["workbench-chip"]
props = { text = "Lit", layout_min_height = "$editor.chrome.viewport_toolbar.height" }
layout = { width = { min = 64.0, preferred = 64.0, max = 64.0, stretch = "Fixed" }, height = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" } }

[nodes.viewport_toolbar_fill]
component = "Container"
control_id = "WorkbenchViewportToolbarFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.viewport_angle]
component = "WorkbenchChip"
control_id = "WorkbenchViewportAngle"
classes = ["workbench-chip"]
props = { text = "10 deg", layout_min_height = "$editor.chrome.viewport_toolbar.height" }
layout = { width = { min = 70.0, preferred = 70.0, max = 70.0, stretch = "Fixed" }, height = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" } }

[nodes.viewport_speed]
component = "WorkbenchChip"
control_id = "WorkbenchViewportSpeed"
classes = ["workbench-chip"]
props = { text = "0.25", layout_min_height = "$editor.chrome.viewport_toolbar.height" }
layout = { width = { min = 70.0, preferred = 70.0, max = 70.0, stretch = "Fixed" }, height = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" } }

[nodes.viewport_surface]
component = "Overlay"
control_id = "WorkbenchViewportSurface"
classes = ["workbench-viewport-surface"]
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "viewport_backdrop" },
  { node = "viewport_ceiling" },
  { node = "viewport_back_wall" },
  { node = "viewport_wall_detail_center_lines" },
  { node = "viewport_side_left" },
