props = { text = "Diff", button_variant = "tertiary", button_color = "secondary", button_size = "small", background_color = "transparent", border_color = "transparent" }
layout = { width = { min = 54.0, preferred = 54.0, max = 54.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Diff", event = "Click", route = "workbench.module.diff" }]

[nodes.module_simulate]
