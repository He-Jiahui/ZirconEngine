classes = ["workbench-toolbar-group"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { min = 34.0, preferred = 182.0, max = 182.0, priority = 40, weight = 1.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
