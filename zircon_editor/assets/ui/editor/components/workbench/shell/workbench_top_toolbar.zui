props = { text = "Material" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Material", event = "Click", route = "workbench.module.material" }]

