events = [{ id = "WorkbenchModule/Behavior", event = "Click", route = "workbench.module.behavior" }]

[nodes.module_render]
component = "WorkbenchTab"
control_id = "WorkbenchModuleRender"
classes = ["workbench-tab", "workbench-module-tab", "workbench-toolbar-tab"]
props = { text = "Render" }
layout = { width = { min = 74.0, preferred = 74.0, max = 74.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Render", event = "Click", route = "workbench.module.render" }]

[nodes.module_assets]
component = "WorkbenchTab"
control_id = "WorkbenchModuleAssets"
classes = ["workbench-tab", "workbench-module-tab", "workbench-toolbar-tab"]
props = { text = "Assets" }
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Assets", event = "Click", route = "workbench.module.assets" }]

[nodes.module_vfx]
component = "WorkbenchTab"
control_id = "WorkbenchModuleVfx"
classes = ["workbench-tab", "workbench-module-tab", "workbench-toolbar-tab"]
props = { text = "VFX" }
layout = { width = { min = 54.0, preferred = 54.0, max = 54.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Vfx", event = "Click", route = "workbench.module.vfx" }]

[nodes.module_hud]
component = "WorkbenchTab"
control_id = "WorkbenchModuleHud"
classes = ["workbench-tab", "workbench-module-tab", "workbench-toolbar-tab"]
props = { text = "HUD" }
