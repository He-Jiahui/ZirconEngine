control_id = "WorkbenchModuleMore"
classes = ["workbench-icon-button", "workbench-module-overflow", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/more-vertical.svg", label = "More Modules" }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
