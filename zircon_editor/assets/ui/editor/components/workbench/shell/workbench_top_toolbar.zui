component = "WorkbenchTab"
control_id = "WorkbenchModuleEffect"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Effect", checked = true, selected = true, value = true }
layout = { width = { min = 68.0, preferred = 68.0, max = 68.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Effect", event = "Click", route = "workbench.module.effect" }]

