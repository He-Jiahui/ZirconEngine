classes = ["workbench-toolbar-group"]
layout = { container = { kind = "HorizontalBox", gap = 4.0 }, width = { min = 182.0, preferred = 182.0, max = 182.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
