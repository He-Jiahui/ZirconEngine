layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { min = 72.0, preferred = 300.0, max = 300.0, priority = 60, weight = 1.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "module_save", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "module_browse", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "module_compile", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "module_diff", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "module_simulate", slot = { layout = { alignment = { vertical = "Center" } } } },
]

[nodes.module_save]
component = "WorkbenchIconButton"
control_id = "WorkbenchModuleSave"
classes = ["workbench-icon-button", "workbench-module-command", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/save.svg", label = "Save Current Module", tooltip = "Save Current Module" }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Save", event = "Click", route = "workbench.module.save" }]

