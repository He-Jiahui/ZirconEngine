component = "HorizontalGroup"
control_id = "WorkbenchModuleCommands"
classes = ["workbench-toolbar-group", "workbench-module-commands"]
layout = { container = { kind = "HorizontalBox", gap = 4.0 }, width = { min = 388.0, preferred = 388.0, max = 388.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "module_save" }, { node = "module_browse" }, { node = "module_compile" }, { node = "module_diff" }, { node = "module_simulate" }]

[nodes.module_save]
component = "WorkbenchButton"
control_id = "WorkbenchModuleSave"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Save", icon = "zircon_editor_shell/toolbar/save.svg", button_variant = "outlined", button_color = "secondary", button_size = "small", background_color = "#1a1f23", border_color = "#303840", layout_spacing = 4.0 }
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" } }
