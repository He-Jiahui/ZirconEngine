[asset]
kind = "component"
id = "res://ui/editor/components/workbench/shell/workbench_top_toolbar.zui"
version = 2
display_name = "Workbench Top Toolbar"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/data/workbench_divider.zui#WorkbenchDivider",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab",
]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchTopToolbar]
root = "top_toolbar"
default_classes = ["workbench-topbar"]

[nodes.top_toolbar]
component = "VerticalGroup"
control_id = "WorkbenchWindowTopToolbar"
classes = ["workbench-topbar"]
props = { background_color = "$editor.surface.2", hover_background_color = "$editor.surface.hover", pressed_background_color = "$editor.surface.3", selected_background_color = "$editor.surface.selected", disabled_background_color = "$editor.surface.disabled", border_color = "$editor.border", focus_border_color = "$editor.focus.ring", separator_edge = "bottom", separator_color = "$editor.separator.soft", separator_thickness = "$editor.control.border_width", foreground_color = "$editor.text.secondary", active_foreground_color = "$editor.text.primary", disabled_foreground_color = "$editor.text.disabled", icon_color = "$editor.text.secondary", active_icon_color = "$editor.accent", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_vertical = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.chrome.workbench_toolbar.height", preferred = "$editor.chrome.workbench_toolbar.height", max = "$editor.chrome.workbench_toolbar.height", stretch = "Fixed" } }
children = [
  { node = "toolbar_command_row" },
  { node = "toolbar_module_tabs" },
]

[nodes.toolbar_command_row]
component = "HorizontalGroup"
control_id = "WorkbenchToolbarCommandRow"
classes = ["workbench-toolbar-command-row"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.chrome.workbench_toolbar.command_row.height", preferred = "$editor.chrome.workbench_toolbar.command_row.height", max = "$editor.chrome.workbench_toolbar.command_row.height", stretch = "Fixed" } }
children = [
  { node = "toolbar_file_group", slot = { layout = { linear_size = { rule = "StretchContent", value = 1.0, shrink_value = 1.0 } } } },
  { node = "toolbar_file_group_divider", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "toolbar_spacer_left" },
  { node = "toolbar_module_commands", slot = { layout = { linear_size = { rule = "StretchContent", value = 1.0, shrink_value = 1.0 } } } },
  { node = "toolbar_tool_group_divider", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "toolbar_tool_group", slot = { layout = { linear_size = { rule = "StretchContent", value = 1.0, shrink_value = 1.0 } } } },
  { node = "toolbar_spacer_right" },
  { node = "toolbar_run_group_divider", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "toolbar_run_group", slot = { layout = { linear_size = { rule = "StretchContent", value = 1.0, shrink_value = 1.0 } } } },
  { node = "toolbar_layout_group_divider", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "toolbar_layout_group", slot = { layout = { linear_size = { rule = "StretchContent", value = 1.0, shrink_value = 1.0 } } } },
]

[nodes.toolbar_file_group]
component = "HorizontalGroup"
control_id = "WorkbenchToolbarFileGroup"
classes = ["workbench-toolbar-group"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { min = 64.0, preferred = 132.0, max = 132.0, priority = 90, weight = 1.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "toolbar_menu", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "toolbar_assets", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "toolbar_open", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "toolbar_save", slot = { layout = { alignment = { vertical = "Center" } } } },
]

[nodes.toolbar_menu]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarMenu"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/menu.svg", label = "Menu" }
layout = { width = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "MenuAction/OpenMainMenu", event = "Click", route = "workbench.menu.main.open" }]

[nodes.toolbar_assets]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarAssets"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/package.svg", label = "Assets" }
layout = { width = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "Workbench/OpenAssetBrowserFromToolbar", event = "Click", action = { action = "view.asset_browser.open" } }]

[nodes.toolbar_open]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarOpen"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/folder-open.svg", label = "Open" }
layout = { width = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "MenuAction/OpenProject", event = "Click", action = { action = "file.project.open" } }]

[nodes.toolbar_save]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarSave"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/save.svg", label = "Save" }
layout = { width = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "MenuAction/SaveProject", event = "Click", action = { action = "file.project.save" } }]

[nodes.toolbar_spacer_left]
component = "Space"
control_id = "WorkbenchToolbarSpacerLeft"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_file_group_divider]
component = "WorkbenchDivider"
control_id = "WorkbenchToolbarFileGroupDivider"
classes = ["workbench-toolbar-divider"]
props = { orientation = "vertical", variant = "middle", thickness = "$editor.control.border_width", layout_min_height = 22.0 }
layout = { width = { min = "$editor.control.border_width", preferred = "$editor.control.border_width", max = "$editor.control.border_width", stretch = "Fixed" }, height = { min = 22.0, preferred = 22.0, max = 22.0, stretch = "Fixed" } }

[nodes.toolbar_module_tabs]
component = "HorizontalGroup"
control_id = "WorkbenchModuleTabs"
classes = ["workbench-toolbar-group", "workbench-module-tabs"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.xsmall" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [
  { node = "module_tab_scroll", slot = { layout = { linear_size = { rule = "Stretch", value = 1.0, shrink_value = 1.0 } } } },
  { node = "module_more", slot = { layout = { alignment = { vertical = "Center" } } } },
]

[nodes.module_tab_scroll]
component = "ScrollableBox"
control_id = "WorkbenchModuleTabScroll"
classes = ["workbench-module-tab-scroll"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Horizontal", gap = "$editor.density.gap.xsmall", scrollbar_visibility = "Never" }, input_policy = "Receive", width = { min = 0.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "module_scene" }, { node = "module_effect" }, { node = "module_ability" }, { node = "module_tags" }, { node = "module_perception" }, { node = "module_material" }, { node = "module_behavior" }, { node = "module_render" }, { node = "module_assets" }, { node = "module_vfx" }, { node = "module_hud" }]

[nodes.module_scene]
component = "WorkbenchTab"
control_id = "WorkbenchModuleScene"
classes = ["workbench-tab", "workbench-module-tab", "workbench-toolbar-tab"]
props = { text = "Scene" }
layout = { width = { min = 64.0, preferred = 64.0, max = 64.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Scene", event = "Click", route = "workbench.module.scene" }]

[nodes.module_effect]
component = "WorkbenchTab"
control_id = "WorkbenchModuleEffect"
classes = ["workbench-tab", "workbench-module-tab", "workbench-toolbar-tab"]
props = { text = "Effect" }
layout = { width = { min = 68.0, preferred = 68.0, max = 68.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Effect", event = "Click", route = "workbench.module.effect" }]

[nodes.module_ability]
component = "WorkbenchTab"
control_id = "WorkbenchModuleAbility"
classes = ["workbench-tab", "workbench-module-tab", "workbench-toolbar-tab"]
props = { text = "Ability" }
layout = { width = { min = 76.0, preferred = 76.0, max = 76.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Ability", event = "Click", route = "workbench.module.ability" }]

[nodes.module_tags]
