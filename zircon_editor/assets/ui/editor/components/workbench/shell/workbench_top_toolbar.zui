control_id = "WorkbenchModuleCompile"
classes = ["workbench-control-button", "workbench-module-command", "workbench-toolbar-action"]
props = { text = "Compile", icon = "zircon_editor_shell/toolbar/compile.svg", tooltip = "Compile Current Module", button_variant = "filled", button_color = "accent", button_size = "small", layout_spacing = "$editor.density.gap.small" }
layout = { width = { min = 104.0, preferred = 104.0, max = 104.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Compile", event = "Click", route = "workbench.module.compile" }]

[nodes.module_diff]
component = "WorkbenchButton"
