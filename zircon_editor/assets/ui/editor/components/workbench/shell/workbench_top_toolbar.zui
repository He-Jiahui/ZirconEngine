control_id = "WorkbenchToolbarRunGroup"
classes = ["workbench-toolbar-group"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { min = 34.0, preferred = 70.0, max = 70.0, priority = 100, weight = 1.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "run_play", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "run_stop", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "run_mode", slot = { layout = { alignment = { vertical = "Center" } } } },
]

[nodes.toolbar_layout_group_divider]
component = "WorkbenchDivider"
control_id = "WorkbenchToolbarLayoutGroupDivider"
classes = ["workbench-toolbar-divider"]
props = { orientation = "vertical", variant = "middle", thickness = "$editor.control.border_width", layout_min_height = 22.0 }
layout = { width = { min = "$editor.control.border_width", preferred = "$editor.control.border_width", max = "$editor.control.border_width", stretch = "Fixed" }, height = { min = 22.0, preferred = 22.0, max = 22.0, stretch = "Fixed" } }

[nodes.toolbar_layout_group]
component = "HorizontalGroup"
control_id = "WorkbenchToolbarLayoutGroup"
classes = ["workbench-toolbar-group"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { min = 32.0, preferred = 68.0, max = 68.0, priority = 20, weight = 1.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "layout_grid", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "theme_toggle", slot = { layout = { alignment = { vertical = "Center" } } } },
  { node = "module_details_drawer_toggle", slot = { layout = { alignment = { vertical = "Center" } } } },
]

[nodes.run_play]
component = "WorkbenchIconButton"
control_id = "WorkbenchRunPlay"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/play.svg", label = "Play", button_color = "success" }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "Run/Play", event = "Click", action = { action = "runtime.play_mode.enter" } }]

[nodes.run_stop]
component = "WorkbenchIconButton"
control_id = "WorkbenchRunStop"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "editor_pages/scene_viewport/play/stop.svg", label = "Stop", button_color = "error", visibility = "collapsed" }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "Run/Stop", event = "Click", action = { action = "runtime.play_mode.exit" } }]

[nodes.run_mode]
component = "WorkbenchIconButton"
control_id = "WorkbenchRunMode"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/dropdown.svg", label = "Run Mode" }
layout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "Run/OpenModeMenu", event = "Click", route = "workbench.run.open_mode_menu" }]

[nodes.layout_grid]
component = "WorkbenchIconButton"
control_id = "WorkbenchLayoutGrid"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/layout-grid.svg", label = "Layouts" }
layout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "DockCommand/OpenLayoutMenu", event = "Click", route = "workbench.dock.open_layout_menu" }]

[nodes.theme_toggle]
component = "WorkbenchIconButton"
control_id = "WorkbenchThemeToggle"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "zircon_editor_shell/toolbar/sun.svg", label = "Theme" }
layout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "Workbench/ToggleTheme", event = "Click", route = "workbench.theme.toggle" }]

[nodes.module_details_drawer_toggle]
component = "WorkbenchIconButton"
control_id = "WorkbenchModuleDetailsDrawerToggle"
classes = ["workbench-icon-button", "workbench-toolbar-action", "workbench-quiet-action"]
props = { icon = "editor_pages/workbench/dock/dock-right.svg", label = "Module Details", tooltip = "Module Details", responsive_min_tier = "narrow", responsive_max_tier = "regular" }
layout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "Workbench/ToggleModuleDetailsDrawer", event = "Click", route = "workbench.module.details_drawer.toggle" }]
