props = { text = "Render", checked = false, selected = false, value = false }
layout = { width = { min = 74.0, preferred = 74.0, max = 74.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Render", event = "Click", route = "workbench.module.render" }]

