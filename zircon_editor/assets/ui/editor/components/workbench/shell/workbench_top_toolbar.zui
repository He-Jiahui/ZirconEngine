[asset]
kind = "component"
id = "res://ui/editor/components/workbench/shell/workbench_top_toolbar.zui"
version = 2
display_name = "Workbench Top Toolbar"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab",
]
styles = []

[components.WorkbenchTopToolbar]
root = "top_toolbar"
default_classes = ["workbench-topbar"]

[nodes.top_toolbar]
component = "VerticalGroup"
control_id = "WorkbenchWindowTopToolbar"
classes = ["workbench-topbar"]
layout = { container = { kind = "VerticalBox", gap = 2.0 }, width = { stretch = "Stretch" }, height = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" } }
children = [
  { node = "toolbar_command_row" },
  { node = "toolbar_module_tabs" },
]

[nodes.toolbar_command_row]
component = "HorizontalGroup"
control_id = "WorkbenchToolbarCommandRow"
classes = ["workbench-toolbar-command-row"]
layout = { container = { kind = "HorizontalBox", gap = 4.0 }, width = { stretch = "Stretch" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" } }
children = [
  { node = "toolbar_file_group" },
  { node = "toolbar_spacer_left" },
  { node = "toolbar_module_commands" },
  { node = "toolbar_tool_group" },
  { node = "toolbar_spacer_right" },
  { node = "toolbar_run_group" },
]

[nodes.toolbar_file_group]
component = "HorizontalGroup"
control_id = "WorkbenchToolbarFileGroup"
classes = ["workbench-toolbar-group"]
layout = { container = { kind = "HorizontalBox", gap = 4.0 }, width = { min = 132.0, preferred = 132.0, max = 132.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "toolbar_menu" }, { node = "toolbar_new" }, { node = "toolbar_open" }, { node = "toolbar_save" }]

[nodes.toolbar_menu]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarMenu"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/menu.svg", label = "Menu" }
layout = { width = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" } }
events = [{ id = "MenuAction/OpenMainMenu", event = "Click", route = "workbench.menu.main.open" }]

[nodes.toolbar_new]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarNew"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/file-new.svg", label = "New" }
layout = { width = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" } }
events = [{ id = "MenuAction/NewAsset", event = "Click", route = "workbench.asset.create" }]

[nodes.toolbar_open]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarOpen"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/folder-open.svg", label = "Open" }
layout = { width = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" } }
events = [{ id = "MenuAction/OpenProject", event = "Click", route = "workbench.project.open" }]

[nodes.toolbar_save]
component = "WorkbenchIconButton"
control_id = "WorkbenchToolbarSave"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/save.svg", label = "Save" }
layout = { width = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" } }
events = [{ id = "MenuAction/SaveProject", event = "Click", route = "workbench.project.save" }]

[nodes.toolbar_spacer_left]
component = "Container"
control_id = "WorkbenchToolbarSpacerLeft"
layout = { width = { min = 0.0, preferred = 0.0, max = 0.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.toolbar_module_tabs]
component = "HorizontalGroup"
control_id = "WorkbenchModuleTabs"
classes = ["workbench-toolbar-group", "workbench-module-tabs"]
layout = { container = { kind = "HorizontalBox", gap = 2.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "module_scene" }, { node = "module_effect" }, { node = "module_ability" }, { node = "module_tags" }, { node = "module_perception" }, { node = "module_material" }, { node = "module_behavior" }, { node = "module_render" }, { node = "module_assets" }, { node = "module_vfx" }, { node = "module_hud" }, { node = "module_more" }]

[nodes.module_scene]
component = "WorkbenchTab"
control_id = "WorkbenchModuleScene"
classes = ["workbench-tab", "workbench-module-tab"]
props = { text = "Scene", checked = false, selected = false, value = false }
layout = { width = { min = 64.0, preferred = 64.0, max = 64.0, stretch = "Fixed" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Scene", event = "Click", route = "workbench.module.scene" }]

