props = { icon = "zircon_editor_shell/toolbar/folder-open.svg", label = "Browse Current Module", tooltip = "Browse Current Module" }
layout = { width = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/Browse", event = "Click", route = "workbench.module.browse" }]

[nodes.module_compile]
