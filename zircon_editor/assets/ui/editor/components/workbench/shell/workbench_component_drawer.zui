layout = { clip = true, container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = 112.0, preferred = 112.0, max = 120.0, stretch = "Fixed" } }
children = [{ node = "table_row_header" }, { node = "table_row_item" }, { node = "table_row_selected" }, { node = "table_row_tail" }]

[nodes.table_row_header]
component = "WorkbenchTableRow"
control_id = "WorkbenchTableHeader"
classes = ["workbench-table-row", "workbench-table-header", "workbench-muted"]
props = { text = "Name        Type        Size        Modified", value = "header", options = ["Name", "Type", "Size", "Modified"], selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = 30.0, stretch = "Fixed" } }

[nodes.table_row_item]
component = "WorkbenchTableRow"
control_id = "WorkbenchTableItem"
classes = ["workbench-table-row"]
props = { text = "Item_01     Mesh        2.4 MB      2m ago", value = "item_01", options = ["Item_01", "Mesh", "2.4 MB", "2m ago"], selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = 30.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/TableItemSelect", event = "Click", route = "component_lab.select.table_item" }]

[nodes.table_row_selected]
component = "WorkbenchTableRow"
control_id = "WorkbenchTableSelected"
classes = ["workbench-table-row"]
props = { text = "Item_02     Material    512 KB      10m ago", value = "item_02", options = ["Item_02", "Material", "512 KB", "10m ago"], selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = 30.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/TableSelectedSelect", event = "Click", route = "component_lab.select.table_selected" }]

[nodes.table_row_tail]
component = "WorkbenchTableRow"
control_id = "WorkbenchTableTail"
classes = ["workbench-table-row", "workbench-table-tail"]
props = { text = "Item_03     Texture     1.2 MB      1h ago", value = "item_03", options = ["Item_03", "Texture", "1.2 MB", "1h ago"], selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = 30.0, stretch = "Fixed" } }
events = [{ id = "ComponentLab/TableTailSelect", event = "Click", route = "component_lab.select.table_tail" }]

[nodes.popup_menu]
component = "WorkbenchPopupMenu"
control_id = "WorkbenchPopupMenu"
classes = ["workbench-popup-menu"]
props = { value = "Open", menu_items = ["New|icon=plus", "Open|icon=folder", "Save|icon=save", "Delete|danger,hovered,icon=trash", "More Tools|submenu"], popup_open = true, disable_enforce_focus = true, popup_anchor_x = 16.0, popup_anchor_y = 20.0 }
layout = { width = { min = 145.0, preferred = 145.0, max = 145.0, stretch = "Fixed" }, height = { min = 140.0, preferred = 150.0, max = 156.0, stretch = "Fixed" } }
