[asset]
kind = "component"
id = "res://ui/editor/components/workbench/shell/workbench_component_drawer.zui"
version = 2
display_name = "Workbench Component Drawer"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_checkbox.zui#WorkbenchCheckbox",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton",
  "res://ui/editor/components/workbench/primitives/data/workbench_label.zui#WorkbenchLabel",
  "res://ui/editor/components/workbench/primitives/data/workbench_icon.zui#WorkbenchIcon",
  "res://ui/editor/components/workbench/primitives/data/workbench_divider.zui#WorkbenchDivider",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_popup_menu.zui#WorkbenchPopupMenu",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_progress_bar.zui#WorkbenchProgressBar",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_radio.zui#WorkbenchRadio",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_segmented_control.zui#WorkbenchSegmentedControl",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_skeleton.zui#WorkbenchSkeleton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_range_slider.zui#WorkbenchRangeSlider",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_slider.zui#WorkbenchSlider",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_status_item.zui#WorkbenchStatusItem",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab_strip.zui#WorkbenchTabStrip",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_toast.zui#WorkbenchToast",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_tooltip.zui#WorkbenchTooltip",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_toggle.zui#WorkbenchToggle",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_number_field.zui#WorkbenchNumberField",
]
styles = [
  "res://ui/editor/theme/editor_tokens.zui",
]

[components.WorkbenchComponentDrawer]
root = "component_drawer"
default_classes = ["workbench-component-drawer"]

[nodes.component_drawer]
component = "VerticalGroup"
control_id = "WorkbenchComponentDrawer"
classes = ["workbench-component-drawer"]
layout = { clip = true, container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "drawer_tabs" }, { node = "component_drawer_content" }]

[nodes.drawer_tabs]
component = "HorizontalGroup"
control_id = "BottomDrawerHeaderRoot"
classes = ["workbench-tabs"]
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = "$editor.chrome.panel_header.height", preferred = "$editor.chrome.panel_header.height", max = "$editor.chrome.panel_header.height", stretch = "Fixed" } }
children = [{ node = "drawer_tab_components" }, { node = "drawer_tab_console" }]

[nodes.component_drawer_content]
component = "VerticalGroup"
control_id = "BottomDrawerContentRoot"
classes = ["workbench-bottom-drawer-content"]
layout = { clip = true, container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "component_body" }, { node = "console_body" }]

[nodes.drawer_tab_components]
component = "WorkbenchTab"
control_id = "WorkbenchDrawerTabComponents"
classes = ["workbench-tab"]
props = { text = "UI Components", checked = true, selected = true, value = true, layout_min_height = "$editor.chrome.panel_header.height" }
layout = { width = { min = 150.0, preferred = 150.0, max = 170.0, stretch = "Fixed" }, height = { min = "$editor.chrome.panel_header.height", preferred = "$editor.chrome.panel_header.height", max = "$editor.chrome.panel_header.height", stretch = "Fixed" } }
events = [{ id = "PanelTab/ComponentDrawerComponents", event = "Click", route = "workbench.panel_tab.select.component_drawer_components" }]

[nodes.drawer_tab_console]
component = "WorkbenchTab"
control_id = "WorkbenchDrawerTabConsole"
classes = ["workbench-tab"]
props = { text = "Console", checked = false, selected = false, value = false, layout_min_height = "$editor.chrome.panel_header.height" }
layout = { width = { min = 110.0, preferred = 110.0, max = 130.0, stretch = "Fixed" }, height = { min = "$editor.chrome.panel_header.height", preferred = "$editor.chrome.panel_header.height", max = "$editor.chrome.panel_header.height", stretch = "Fixed" } }
events = [{ id = "PanelTab/ComponentDrawerConsole", event = "Click", route = "workbench.panel_tab.select.component_drawer_console" }]

[nodes.component_body]
component = "VerticalGroup"
control_id = "WorkbenchComponentDrawerBody"
classes = ["workbench-component-drawer-body"]
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.large" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "component_top_row" }, { node = "component_lower_row" }]

[nodes.component_top_row]
component = "HorizontalGroup"
control_id = "WorkbenchComponentTopRow"
classes = ["workbench-component-grid-row"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.large" }, width = { stretch = "Stretch" }, height = { min = 202.0, preferred = 202.0, max = 202.0, stretch = "Fixed" } }
children = [{ node = "component_buttons" }, { node = "component_icon_buttons" }, { node = "component_inputs" }, { node = "component_selection" }, { node = "component_sliders" }, { node = "component_labs" }, { node = "component_list" }]

[nodes.component_lower_row]
component = "HorizontalGroup"
control_id = "WorkbenchComponentLowerRow"
classes = ["workbench-lower-demo"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "component_table" }, { node = "component_feedback" }]

[nodes.console_body]
component = "VerticalGroup"
control_id = "WorkbenchComponentDrawerConsoleBody"
classes = ["workbench-panel", "workbench-console-panel"]
props = { visibility = "collapsed" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_info" }, { node = "console_warning" }, { node = "console_ok" }]

[nodes.console_info]
component = "WorkbenchStatusItem"
control_id = "WorkbenchConsoleInfo"
classes = ["workbench-status-item", "workbench-info"]
props = { text = "UI component palette loaded" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }

[nodes.console_warning]
component = "WorkbenchStatusItem"
control_id = "WorkbenchConsoleWarning"
classes = ["workbench-status-item", "workbench-warning"]
props = { text = "2 layout warnings" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }

[nodes.console_ok]
component = "WorkbenchStatusItem"
control_id = "WorkbenchConsoleOk"
classes = ["workbench-status-item", "workbench-success"]
props = { text = "No runtime errors" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }

[nodes.component_buttons]
component = "VerticalGroup"
control_id = "WorkbenchComponentButtons"
classes = ["workbench-panel", "workbench-component-sample-card"]
props = { surface_variant = "component-panel" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 204.0, preferred = 204.0, max = 204.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "buttons_title", slot = { layout = { padding = { left = 8.0, top = 4.0, right = 8.0 } } } }, { node = "buttons_row_primary", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "buttons_row_variant", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "buttons_row_icon", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "buttons_row_tail", slot = { layout = { padding = { left = 8.0, right = 8.0, bottom = 4.0 } } } }]

[nodes.buttons_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchButtonsTitle"
classes = ["workbench-section-title"]
props = { text = "Buttons" }
layout = { width = { stretch = "Stretch" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = "Fixed" } }

[nodes.buttons_row_primary]
component = "HorizontalGroup"
control_id = "WorkbenchButtonsRowPrimary"
props = { layout_gap = "$editor.density.gap.medium" }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
children = [{ node = "primary_button" }, { node = "secondary_button" }]

[nodes.primary_button]
component = "WorkbenchButton"
control_id = "WorkbenchPrimaryButton"
classes = ["workbench-primary-button"]
props = { text = "Primary", button_variant = "filled", button_color = "primary", button_size = "small" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "ComponentLab/Primary", event = "Click", route = "component_lab.primary" }]

[nodes.secondary_button]
component = "WorkbenchButton"
control_id = "WorkbenchSecondaryButton"
classes = ["workbench-control-button"]
props = { text = "Secondary", button_variant = "outlined", button_color = "secondary", button_size = "small" }
layout = { width = { min = 82.0, preferred = 82.0, max = 82.0, stretch = "Fixed" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "ComponentLab/Secondary", event = "Click", route = "component_lab.secondary" }]

[nodes.buttons_row_variant]
component = "HorizontalGroup"
control_id = "WorkbenchButtonsRowVariant"
props = { layout_gap = "$editor.density.gap.medium" }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
children = [{ node = "tertiary_button" }, { node = "outline_button" }]

[nodes.tertiary_button]
component = "WorkbenchButton"
control_id = "WorkbenchTertiaryButton"
classes = ["workbench-control-button", "workbench-tertiary-button"]
props = { text = "Tertiary", button_variant = "text", button_color = "secondary", button_size = "small" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "ComponentLab/Tertiary", event = "Click", route = "component_lab.tertiary" }]

[nodes.outline_button]
component = "WorkbenchButton"
control_id = "WorkbenchOutlineButton"
classes = ["workbench-control-button", "workbench-outline-button"]
props = { text = "Outline", button_variant = "outlined", button_color = "secondary", button_size = "small" }
layout = { width = { min = 82.0, preferred = 82.0, max = 82.0, stretch = "Fixed" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "ComponentLab/Outline", event = "Click", route = "component_lab.outline" }]

[nodes.buttons_row_icon]
component = "HorizontalGroup"
control_id = "WorkbenchButtonsRowIcon"
props = { layout_gap = "$editor.density.gap.medium" }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
children = [{ node = "button_icon" }, { node = "button_delete" }]

[nodes.button_icon]
component = "WorkbenchButton"
control_id = "WorkbenchButtonIcon"
classes = ["workbench-control-button", "workbench-button-icon"]
props = { text = "Icon", icon = "zircon_editor_shell/controls/add.svg", button_variant = "outlined", button_color = "secondary", button_size = "small" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "ComponentLab/IconButton", event = "Click", route = "component_lab.icon_button" }]

[nodes.button_delete]
component = "WorkbenchButton"
control_id = "WorkbenchButtonDelete"
classes = ["workbench-control-button", "workbench-danger"]
props = { text = "", icon = "zircon_editor_shell/controls/delete.svg", button_variant = "outlined", button_color = "danger", button_size = "small", validation_level = "danger" }
layout = { width = { min = 82.0, preferred = 82.0, max = 82.0, stretch = "Fixed" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "ComponentLab/DeleteButton", event = "Click", route = "component_lab.delete_button" }]

[nodes.buttons_row_tail]
component = "HorizontalGroup"
control_id = "WorkbenchButtonsRowTail"
props = { layout_gap = "$editor.density.gap.medium" }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
children = [{ node = "disabled_button" }, { node = "dropdown_button" }]

[nodes.disabled_button]
component = "WorkbenchButton"
control_id = "WorkbenchDisabledButton"
classes = ["workbench-control-button", "workbench-disabled-button"]
props = { text = "Disabled", button_variant = "outlined", button_color = "secondary", button_size = "small", disabled = true, overflow = "shrink" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }

[nodes.dropdown_button]
component = "WorkbenchDropdown"
control_id = "WorkbenchDropdownButton"
classes = ["workbench-field", "workbench-button-dropdown"]
props = { value = "dropdown", value_text = "Dropdown", options = ["dropdown", "option_a", "option_b"], popup_open = false, layout_width = 82.0 }
layout = { width = { min = 82.0, preferred = 82.0, max = 82.0, stretch = "Fixed" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "ComponentLab/ButtonDropdownOpen", event = "Click", route = "component_lab.open_popup.button_dropdown" }, { id = "ComponentLab/ButtonDropdownSelect", event = "Change", route = "component_lab.select_option.button_dropdown" }]

[nodes.component_icon_buttons]
component = "VerticalGroup"
control_id = "WorkbenchComponentIconButtons"
classes = ["workbench-panel", "workbench-component-sample-card"]
props = { surface_variant = "component-panel" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 210.0, preferred = 210.0, max = 210.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "icon_buttons_title", slot = { layout = { padding = { left = 8.0, top = 4.0, right = 8.0 } } } }, { node = "icon_grid_row_top", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "icon_grid_row_bottom", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "icon_toggle_title", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "icon_toggle_segment", slot = { layout = { padding = { left = 8.0, right = 8.0, bottom = 4.0 } } } }]

[nodes.icon_buttons_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchIconButtonsTitle"
classes = ["workbench-section-title"]
props = { text = "Icon Buttons" }
layout = { width = { stretch = "Stretch" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = "Fixed" } }

[nodes.icon_grid_row_top]
component = "HorizontalGroup"
control_id = "WorkbenchIconButtonGridTop"
props = { layout_gap = 6.0 }
layout = { container = { kind = "HorizontalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }
children = [{ node = "mini_add" }, { node = "mini_folder" }, { node = "mini_save" }, { node = "mini_delete" }]

[nodes.mini_add]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniAdd"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/controls/add.svg", label = "Add", layout_icon_size = 18.0, icon_size = 18.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.mini_folder]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniFolder"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/folder-open.svg", label = "Open", layout_icon_size = 18.0, icon_size = 18.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.mini_save]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniSave"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/save.svg", label = "Save", layout_icon_size = 18.0, icon_size = 18.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.mini_delete]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniDelete"
classes = ["workbench-icon-button", "workbench-danger"]
props = { icon = "zircon_editor_shell/controls/delete.svg", label = "Delete", button_color = "danger", validation_level = "danger", layout_icon_size = 18.0, icon_size = 18.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.icon_grid_row_bottom]
component = "HorizontalGroup"
control_id = "WorkbenchIconButtonGridBottom"
props = { layout_gap = 6.0 }
layout = { container = { kind = "HorizontalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }
children = [{ node = "mini_eye" }, { node = "mini_eye_off" }, { node = "mini_lock" }, { node = "mini_more" }]

[nodes.mini_eye]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniEye"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/scene/eye.svg", label = "Visible", layout_icon_size = 18.0, icon_size = 18.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.mini_eye_off]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniEyeOff"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/scene/eye-off.svg", label = "Hidden", layout_icon_size = 18.0, icon_size = 18.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.mini_lock]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniLock"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/scene/lock.svg", label = "Locked", layout_icon_size = 18.0, icon_size = 18.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.mini_more]
component = "WorkbenchIconButton"
control_id = "WorkbenchMiniMore"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/more-vertical.svg", label = "More", layout_icon_size = 18.0, icon_size = 18.0 }
layout = { width = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" }, height = { min = 38.0, preferred = 38.0, max = 38.0, stretch = "Fixed" } }

[nodes.icon_toggle_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchIconToggleTitle"
classes = ["workbench-section-title"]
props = { text = "Toggle Buttons" }
layout = { width = { stretch = "Stretch" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = "Fixed" } }

[nodes.icon_toggle_segment]
component = "WorkbenchSegmentedControl"
control_id = "WorkbenchIconToggleSegmented"
classes = ["workbench-segmented-control", "workbench-icon-toggle-segmented"]
props = { value = "grid", options = ["grid", "list", "columns"], selection_state = "single", layout_width = 150.0 }
layout = { width = { min = 150.0, preferred = 150.0, max = 150.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [{ id = "ComponentLab/IconToggleSegmentedSelect", event = "Change", route = "component_lab.select_option.icon_toggle_segmented" }]

[nodes.component_inputs]
component = "VerticalGroup"
control_id = "WorkbenchComponentInputs"
classes = ["workbench-panel", "workbench-component-sample-card"]
props = { surface_variant = "component-panel" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 214.0, preferred = 214.0, max = 214.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "inputs_title", slot = { layout = { padding = { left = 8.0, top = 4.0, right = 8.0 } } } }, { node = "input_search", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "input_text", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "input_focused", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "input_disabled", slot = { layout = { padding = { left = 8.0, right = 8.0 } } } }, { node = "input_dropdown_row", slot = { layout = { padding = { left = 8.0, right = 8.0, bottom = 4.0 } } } }]

[nodes.inputs_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchInputsTitle"
classes = ["workbench-section-title"]
props = { text = "Inputs" }
layout = { width = { stretch = "Stretch" }, height = { min = 26.0, preferred = 26.0, max = 26.0, stretch = "Fixed" } }

[nodes.input_text]
component = "WorkbenchField"
control_id = "WorkbenchInputText"
