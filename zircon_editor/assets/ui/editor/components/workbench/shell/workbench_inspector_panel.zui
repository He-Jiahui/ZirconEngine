  { id = "Inspector/TransformScaleYCommit", event = "Submit", route = "workbench.inspector.transform.scale_y.commit" },
]

[nodes.scale_value_y_group]
component = "HorizontalGroup"
control_id = "WorkbenchTransformScaleYGroup"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.xsmall" }, width = { min = 70.0, preferred = 76.0, max = 80.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "scale_axis_y" }, { node = "scale_value_y" }]

[nodes.scale_axis_z]
component = "WorkbenchLabel"
control_id = "WorkbenchTransformScaleAxisZ"
classes = ["workbench-axis-label", "workbench-axis-z"]
props = { text = "Z", font_size = "$editor.typography.caption.size", label_color = "$editor.text.disabled" }
layout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.scale_value_z]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformScaleZ"
classes = ["workbench-axis-value-field"]
props = { value = "1.00", value_color = "$editor.text.secondary" }
layout = { width = { min = "$editor.density.axis_value_field.min_width", preferred = "$editor.density.axis_value_field.preferred_width", max = "$editor.density.axis_value_field.max_width", stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "Inspector/TransformScaleZEdit", event = "Change", route = "workbench.inspector.transform.scale_z.edit" },
  { id = "Inspector/TransformScaleZCommit", event = "Submit", route = "workbench.inspector.transform.scale_z.commit" },
]

[nodes.scale_value_z_group]
component = "HorizontalGroup"
control_id = "WorkbenchTransformScaleZGroup"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.xsmall" }, width = { min = 70.0, preferred = 76.0, max = 80.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "scale_axis_z" }, { node = "scale_value_z" }]

[nodes.inspector_mesh]
