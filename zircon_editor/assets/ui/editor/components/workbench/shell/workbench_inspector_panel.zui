control_id = "WorkbenchTransformScaleXGroup"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.xsmall" }, width = { min = 70.0, preferred = 76.0, max = 80.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "scale_axis_x" }, { node = "scale_value_x" }]

[nodes.scale_axis_x]
component = "WorkbenchLabel"
control_id = "WorkbenchTransformScaleAxisX"
classes = ["workbench-axis-label", "workbench-axis-x"]
props = { text = "X", font_size = "$editor.typography.caption.size", label_color = "$editor.text.disabled" }
layout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.scale_value_x]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformScaleX"
classes = ["workbench-axis-value-field"]
props = { value = "1.00", value_color = "$editor.text.secondary" }
layout = { width = { min = "$editor.density.axis_value_field.min_width", preferred = "$editor.density.axis_value_field.preferred_width", max = "$editor.density.axis_value_field.max_width", stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
events = [
  { id = "Inspector/TransformScaleXEdit", event = "Change", route = "workbench.inspector.transform.scale_x.edit" },
  { id = "Inspector/TransformScaleXCommit", event = "Submit", route = "workbench.inspector.transform.scale_x.commit" },
]

[nodes.scale_axis_y]
component = "WorkbenchLabel"
control_id = "WorkbenchTransformScaleAxisY"
classes = ["workbench-axis-label", "workbench-axis-y"]
props = { text = "Y", font_size = "$editor.typography.caption.size", label_color = "$editor.text.disabled" }
layout = { width = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.scale_value_y]
