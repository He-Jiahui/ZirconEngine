control_id = "WorkbenchTransformRotationZ"
classes = ["workbench-axis-value-field"]
props = { value = "0 deg", disabled = true, editable_text = false, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { min = "$editor.density.axis_value_field.min_width", preferred = "$editor.density.axis_value_field.preferred_width", max = "$editor.density.axis_value_field.max_width", stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }

[nodes.rotation_value_z_group]
component = "HorizontalGroup"
control_id = "WorkbenchTransformRotationZGroup"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.xsmall" }, width = { min = 70.0, preferred = 76.0, max = 80.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "rotation_axis_z" }, { node = "rotation_value_z" }]

[nodes.scale_row]
component = "VerticalGroup"
control_id = "WorkbenchTransformScale"
classes = ["workbench-property-row", "workbench-transform-row", "workbench-transform-scale-row"]
props = { text = "Scale", value = "X 1.00   Y 1.00   Z 1.00" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Fixed" } }
children = [{ node = "scale_label" }, { node = "scale_values" }]

[nodes.scale_label]
component = "WorkbenchLabel"
control_id = "WorkbenchTransformScaleLabel"
classes = ["workbench-transform-row-label"]
props = { text = "Scale", text_tone = "muted", font_size = "$editor.typography.body.size" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }

[nodes.scale_link]
component = "WorkbenchLabel"
control_id = "WorkbenchTransformScaleLink"
classes = ["workbench-transform-scale-link"]
props = { icon = "link", text = "", text_tone = "muted", font_size = "$editor.typography.caption.size", layout_offset_x = -12.0, layout_icon_size = 17.0, responsive_min_tier = "wide" }
layout = { width = { min = 14.0, preferred = 14.0, max = 14.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.scale_values]
component = "WrapBox"
control_id = "WorkbenchTransformScaleValues"
layout = { container = { kind = "WrapBox", horizontal_gap = "$editor.density.gap.small", vertical_gap = "$editor.density.gap.small", item_min_width = 76.0 }, width = { stretch = "Stretch" }, height = { stretch = "Fixed" } }
children = [{ node = "scale_value_x_group" }, { node = "scale_value_y_group" }, { node = "scale_value_z_group" }]

[nodes.scale_value_x_group]
