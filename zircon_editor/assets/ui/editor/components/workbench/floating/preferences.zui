[asset]
kind = "component"
id = "res://ui/editor/components/workbench/floating/preferences.zui"
version = 2
display_name = "Workbench Preferences"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
]
styles = [
  "res://ui/theme/editor_workbench_strict.v2.ui.toml",
  "res://ui/editor/theme/editor_tokens.v2.ui.toml",
]

[components.WorkbenchPreferences]
root = "preferences"
default_classes = ["workbench-floating", "workbench-preferences"]

[nodes.preferences]
component = "HorizontalGroup"
control_id = "WorkbenchPreferences"
classes = ["workbench-floating", "workbench-preferences"]
style = { self = { background = { color = "editor.surface.1" }, foreground = { color = "editor.text.primary" }, border = { color = "editor.border", width = 1.0, radius = 8.0 } } }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 8.0 }, width = { min = 720.0, preferred = 860.0, max = 960.0, stretch = "Fixed" }, height = { min = 480.0, preferred = 560.0, max = 680.0, stretch = "Fixed" } }
children = [{ node = "navigation" }, { node = "content" }]

[nodes.navigation]
component = "VerticalGroup"
control_id = "WorkbenchPreferencesNavigation"
style = { self = { background = { color = "editor.surface.0" }, foreground = { color = "editor.text.secondary" }, border = { color = "editor.border", width = 1.0, radius = 5.0 } } }
layout = { clip = true, container = { kind = "VerticalBox", gap = 2.0 }, width = { min = 192.0, preferred = 224.0, max = 240.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "nav_general" }, { node = "nav_layout" }]

[nodes.nav_general]
component = "WorkbenchListRow"
control_id = "WorkbenchPreferencesGeneral"
props = { label = "General" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.nav_layout]
component = "WorkbenchListRow"
control_id = "WorkbenchPreferencesLayout"
props = { label = "Layout" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.content]
component = "VerticalGroup"
control_id = "WorkbenchPreferencesContent"
style = { self = { background = { color = "editor.surface.2" }, foreground = { color = "editor.text.primary" }, border = { color = "editor.border", width = 1.0, radius = 5.0 } } }
layout = { clip = true, container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "title" }]

[nodes.title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchPreferencesTitle"
props = { text = "Preferences" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
