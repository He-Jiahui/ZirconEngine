[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/production/workbench_extension_plugin_manager_workspace.zui"
version = 2
display_name = "Workbench Extension Plugin Manager Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionPluginManagerWorkspace]
root = "plugin_manager_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.plugin_manager_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionPluginManagerWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "plugin_manager_workspace_main" },
  { node = "plugin_manager_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.plugin_manager_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "plugin_manager_rail_gap" }, { node = "plugin_manager_left" }, { node = "plugin_manager_center" }, { node = "plugin_manager_right_reserve" }]

[nodes.plugin_manager_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.plugin_manager_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionPluginManagerRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.plugin_manager_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPluginManagerLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "plugin_manager_title" }, { node = "plugin_manager_left_content" }]

[nodes.plugin_manager_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPluginManagerLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "plugin_manager_audio_row" }, { node = "plugin_manager_renderdoc_row" }, { node = "plugin_manager_gameplay_row" }]

[nodes.plugin_manager_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPluginManagerTitle"
props = { text = "Plugin Manager" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.plugin_manager_audio_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPluginManagerAudioRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Plugin_Audio", icon = "speaker", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PluginManagerAudioRow", event = "Click", route = "workbench.extension.plugin_manager.plugin.audio" }]

[nodes.plugin_manager_renderdoc_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPluginManagerRenderdocRow"
classes = ["workbench-list-row"]
props = { text = "Plugin_RenderDoc", icon = "camera", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PluginManagerRenderdocRow", event = "Click", route = "workbench.extension.plugin_manager.plugin.render_doc" }]

[nodes.plugin_manager_gameplay_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPluginManagerGameplayRow"
classes = ["workbench-list-row"]
props = { text = "Plugin_Gameplay", icon = "puzzle", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PluginManagerGameplayRow", event = "Click", route = "workbench.extension.plugin_manager.plugin.gameplay" }]

[nodes.plugin_manager_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPluginManagerCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "plugin_manager_center_header" }, { node = "plugin_manager_dependency_table" }, { node = "plugin_manager_output" }]

[nodes.plugin_manager_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionPluginManagerCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "plugin_manager_center_title" }, { node = "plugin_manager_header_fill" }, { node = "plugin_manager_hot_reload_button" }, { node = "plugin_manager_validate_button" }]

[nodes.plugin_manager_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPluginManagerCenterTitle"
props = { text = "Plugin Dependency Graph" }
layout = { width = { min = 250.0, preferred = 250.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.plugin_manager_header_fill]
component = "Container"
control_id = "WorkbenchExtensionPluginManagerHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.plugin_manager_hot_reload_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPluginManagerHotReloadButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Hot Reload", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 98.0, preferred = 98.0, max = 110.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PluginManagerHotReload", event = "Click", route = "workbench.extension.plugin_manager.hot_reload" }]

[nodes.plugin_manager_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPluginManagerValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Validate Plugin", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 122.0, preferred = 122.0, max = 134.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PluginManagerValidate", event = "Click", route = "workbench.extension.plugin_manager.validate" }]

[nodes.plugin_manager_dependency_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPluginManagerDependencyTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "plugin_manager_audio_runtime_table_row" }, { node = "plugin_manager_renderdoc_bridge_table_row" }, { node = "plugin_manager_gameplay_pack_table_row" }, { node = "plugin_manager_version_warning_table_row" }]

[nodes.plugin_manager_audio_runtime_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPluginManagerAudioRuntimeTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Audio Runtime", value_text = "enabled   v1.8.2   editor + game", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PluginManagerAudioRuntimeTableRow", event = "Click", route = "workbench.extension.plugin_manager.dependency.audio_runtime" }]

[nodes.plugin_manager_renderdoc_bridge_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPluginManagerRenderdocBridgeTableRow"
classes = ["workbench-table-row"]
props = { text = "RenderDoc Bridge", value_text = "editor only   optional dependency" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PluginManagerRenderdocBridgeTableRow", event = "Click", route = "workbench.extension.plugin_manager.dependency.renderdoc_bridge" }]

[nodes.plugin_manager_gameplay_pack_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPluginManagerGameplayPackTableRow"
classes = ["workbench-table-row"]
props = { text = "Gameplay Pack", value_text = "requires online sessions   hot reloadable" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PluginManagerGameplayPackTableRow", event = "Click", route = "workbench.extension.plugin_manager.dependency.gameplay_pack" }]

[nodes.plugin_manager_version_warning_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPluginManagerVersionWarningTableRow"
classes = ["workbench-table-row"]
props = { text = "Version Warning", value_text = "RenderDoc Bridge requests engine api 0.12" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PluginManagerVersionWarningTableRow", event = "Click", route = "workbench.extension.plugin_manager.dependency.version_warning" }]

[nodes.plugin_manager_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPluginManagerOutputRow"
classes = ["workbench-table-row"]
props = { text = "Plugin Output", value_text = "18 installed   3 updates   1 warning", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.plugin_manager_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPluginManagerRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "plugin_manager_details_title" }, { node = "plugin_manager_right_content" }]

[nodes.plugin_manager_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPluginManagerRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "plugin_manager_plugin_dropdown_property_row" }, { node = "plugin_manager_channel_dropdown_property_row" }, { node = "plugin_manager_version_field_property_row" }]

[nodes.plugin_manager_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPluginManagerDetailsTitle"
props = { text = "Plugin Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.plugin_manager_plugin_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPluginManagerPluginDropdownPropertyRow"
props = { text = "Plugin" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "plugin_manager_plugin_dropdown", slot = { name = "value" } }]

[nodes.plugin_manager_plugin_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPluginManagerPluginDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Audio Runtime", value = "Audio Runtime", options = ["Audio Runtime", "RenderDoc Bridge", "Gameplay Pack", "Telemetry"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PluginManagerPluginEdit", event = "Change", route = "workbench.extension.plugin_manager.plugin.edit" },
  { id = "WorkbenchExtension/PluginManagerPluginCommit", event = "Submit", route = "workbench.extension.plugin_manager.plugin.commit" },
]

[nodes.plugin_manager_channel_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPluginManagerChannelDropdownPropertyRow"
props = { text = "Channel" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "plugin_manager_channel_dropdown", slot = { name = "value" } }]

[nodes.plugin_manager_channel_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPluginManagerChannelDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Editor", value = "Editor", options = ["Editor", "Runtime", "Tools", "Experimental"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PluginManagerChannelEdit", event = "Change", route = "workbench.extension.plugin_manager.channel.edit" },
  { id = "WorkbenchExtension/PluginManagerChannelCommit", event = "Submit", route = "workbench.extension.plugin_manager.channel.commit" },
]

[nodes.plugin_manager_version_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPluginManagerVersionFieldPropertyRow"
props = { text = "Version" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "plugin_manager_version_field", slot = { name = "value" } }]

[nodes.plugin_manager_version_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionPluginManagerVersionField"
classes = ["workbench-field", "workbench-component-field"]
props = { label = "Version", value = "1.8.2" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PluginManagerVersionEdit", event = "Change", route = "workbench.extension.plugin_manager.version.edit" },
  { id = "WorkbenchExtension/PluginManagerVersionCommit", event = "Submit", route = "workbench.extension.plugin_manager.version.commit" },
]
