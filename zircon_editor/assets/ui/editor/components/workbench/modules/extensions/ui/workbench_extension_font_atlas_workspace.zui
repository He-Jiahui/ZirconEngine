[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/ui/workbench_extension_font_atlas_workspace.zui"
version = 2
display_name = "Workbench Extension Font Atlas Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionFontAtlasWorkspace]
root = "font_atlas_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.font_atlas_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionFontAtlasWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "font_atlas_rail_gap" }, { node = "font_atlas_left" }, { node = "font_atlas_center" }, { node = "font_atlas_right" }]

[nodes.font_atlas_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionFontAtlasRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.font_atlas_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionFontAtlasLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "font_atlas_title" }, { node = "font_atlas_glyphs_tab" }, { node = "font_atlas_kerning_tab" }, { node = "font_atlas_coverage_tab" }, { node = "font_atlas_inter_ui_row" }, { node = "font_atlas_latin_range_row" }, { node = "font_atlas_cjk_range_row" }]

[nodes.font_atlas_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionFontAtlasTitle"
props = { text = "Font Atlas" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.font_atlas_glyphs_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionFontAtlasGlyphsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Glyphs", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasGlyphsTab", event = "Click", route = "workbench.extension.font_atlas.glyphs" }]

[nodes.font_atlas_kerning_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionFontAtlasKerningTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Kerning", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasKerningTab", event = "Click", route = "workbench.extension.font_atlas.kerning" }]

[nodes.font_atlas_coverage_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionFontAtlasCoverageTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Coverage", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasCoverageTab", event = "Click", route = "workbench.extension.font_atlas.coverage" }]

[nodes.font_atlas_inter_ui_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionFontAtlasInterUiRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Inter_UI", icon = "file", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasInterUiRow", event = "Click", route = "workbench.extension.font_atlas.font.inter_ui" }]

[nodes.font_atlas_latin_range_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionFontAtlasLatinRangeRow"
classes = ["workbench-list-row"]
props = { text = "Range_Latin", icon = "grid", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasLatinRangeRow", event = "Click", route = "workbench.extension.font_atlas.range.latin" }]

[nodes.font_atlas_cjk_range_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionFontAtlasCjkRangeRow"
classes = ["workbench-list-row"]
props = { text = "Range_CJK", icon = "alert", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasCjkRangeRow", event = "Click", route = "workbench.extension.font_atlas.range.cjk" }]

[nodes.font_atlas_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionFontAtlasCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "font_atlas_center_header" }, { node = "font_atlas_table" }, { node = "font_atlas_output" }]

[nodes.font_atlas_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionFontAtlasCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "font_atlas_center_title" }, { node = "font_atlas_header_fill" }, { node = "font_atlas_bake_button" }, { node = "font_atlas_inspect_button" }]

[nodes.font_atlas_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionFontAtlasCenterTitle"
props = { text = "Glyph Coverage" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.font_atlas_header_fill]
component = "Container"
control_id = "WorkbenchExtensionFontAtlasHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.font_atlas_bake_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionFontAtlasBakeAtlasButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Bake Atlas", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 100.0, preferred = 100.0, max = 112.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasBakeAtlas", event = "Click", route = "workbench.extension.font_atlas.bake_atlas" }]

[nodes.font_atlas_inspect_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionFontAtlasInspectGlyphButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Inspect Glyph", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 112.0, preferred = 112.0, max = 124.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasInspectGlyph", event = "Click", route = "workbench.extension.font_atlas.inspect_glyph" }]

[nodes.font_atlas_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionFontAtlasTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "font_atlas_latin_table_row" }, { node = "font_atlas_cyrillic_table_row" }, { node = "font_atlas_cjk_table_row" }, { node = "font_atlas_icons_table_row" }]

[nodes.font_atlas_latin_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFontAtlasLatinTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Latin", value_text = "512 glyphs   0 missing   Page 0" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasLatinTableRow", event = "Click", route = "workbench.extension.font_atlas.row.latin" }]

[nodes.font_atlas_cyrillic_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFontAtlasCyrillicTableRow"
classes = ["workbench-table-row"]
props = { text = "Cyrillic", value_text = "384 glyphs   0 missing   Page 1" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasCyrillicTableRow", event = "Click", route = "workbench.extension.font_atlas.row.cyrillic" }]

[nodes.font_atlas_cjk_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFontAtlasCjkTableRow"
classes = ["workbench-table-row"]
props = { text = "CJK", value_text = "2840 glyphs   12 missing   Page 2" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasCjkTableRow", event = "Click", route = "workbench.extension.font_atlas.row.cjk" }]

[nodes.font_atlas_icons_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFontAtlasIconsTableRow"
classes = ["workbench-table-row"]
props = { text = "Icons", value_text = "360 glyphs   0 missing   Page 3" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasIconsTableRow", event = "Click", route = "workbench.extension.font_atlas.row.icons" }]

[nodes.font_atlas_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionFontAtlasOutputRow"
classes = ["workbench-table-row"]
props = { text = "Font Atlas", value_text = "4096 glyphs   4 pages   12 missing" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/FontAtlasOutput", event = "Click", route = "workbench.extension.font_atlas.output" }]

[nodes.font_atlas_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionFontAtlasRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "font_atlas_details_title" }, { node = "font_atlas_font_dropdown" }, { node = "font_atlas_range_dropdown" }, { node = "font_atlas_size_field" }]

[nodes.font_atlas_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionFontAtlasDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.font_atlas_font_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionFontAtlasFontDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Inter UI", value = "Inter UI", options = ["Inter UI", "Noto Sans", "Mono UI"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/FontAtlasFontEdit", event = "Change", route = "workbench.extension.font_atlas.font.edit" },
  { id = "WorkbenchExtension/FontAtlasFontCommit", event = "Submit", route = "workbench.extension.font_atlas.font.commit" },
]

[nodes.font_atlas_range_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionFontAtlasRangeDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Latin Extended", value = "Latin Extended", options = ["Latin Extended", "CJK", "Icons"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/FontAtlasRangeEdit", event = "Change", route = "workbench.extension.font_atlas.range.edit" },
  { id = "WorkbenchExtension/FontAtlasRangeCommit", event = "Submit", route = "workbench.extension.font_atlas.range.commit" },
]

[nodes.font_atlas_size_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionFontAtlasSizeField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Size: 18" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/FontAtlasSizeEdit", event = "Change", route = "workbench.extension.font_atlas.size.edit" },
  { id = "WorkbenchExtension/FontAtlasSizeCommit", event = "Submit", route = "workbench.extension.font_atlas.size.commit" },
]
