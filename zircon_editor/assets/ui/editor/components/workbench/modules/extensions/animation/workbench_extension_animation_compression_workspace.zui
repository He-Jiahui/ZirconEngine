[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/animation/workbench_extension_animation_compression_workspace.zui"
version = 2
display_name = "Workbench Extension Animation Compression Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionAnimationCompressionWorkspace]
root = "animation_compression_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.animation_compression_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionAnimationCompressionWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "animation_compression_workspace_main" },
  { node = "animation_compression_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.animation_compression_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "animation_compression_rail_gap" }, { node = "animation_compression_left" }, { node = "animation_compression_center" }, { node = "animation_compression_right_reserve" }]

[nodes.animation_compression_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.animation_compression_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionAnimationCompressionRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.animation_compression_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAnimationCompressionLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "animation_compression_title" }, { node = "animation_compression_left_content" }]

[nodes.animation_compression_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionAnimationCompressionLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "animation_compression_locomotion_row" }, { node = "animation_compression_combat_row" }, { node = "animation_compression_cinematic_row" }]

[nodes.animation_compression_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionAnimationCompressionTitle"
props = { text = "Animation Compression" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.animation_compression_locomotion_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionAnimationCompressionLocomotionRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "AC_Locomotion", icon = "play", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionLocomotionRow", event = "Click", route = "workbench.extension.animation_compression.profile.locomotion" }]

[nodes.animation_compression_combat_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionAnimationCompressionCombatRow"
classes = ["workbench-list-row"]
props = { text = "AC_Combat", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionCombatRow", event = "Click", route = "workbench.extension.animation_compression.profile.combat" }]

[nodes.animation_compression_cinematic_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionAnimationCompressionCinematicRow"
classes = ["workbench-list-row"]
props = { text = "AC_Cinematic", icon = "component", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionCinematicRow", event = "Click", route = "workbench.extension.animation_compression.profile.cinematic" }]

[nodes.animation_compression_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAnimationCompressionCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "animation_compression_center_header" }, { node = "animation_compression_clip_table" }, { node = "animation_compression_output" }]

[nodes.animation_compression_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionAnimationCompressionCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "animation_compression_center_title" }, { node = "animation_compression_header_fill" }, { node = "animation_compression_preview_button" }, { node = "animation_compression_compress_button" }]

[nodes.animation_compression_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionAnimationCompressionCenterTitle"
props = { text = "Clip Budget" }
layout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.animation_compression_header_fill]
component = "Container"
control_id = "WorkbenchExtensionAnimationCompressionHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.animation_compression_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionAnimationCompressionPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionPreview", event = "Click", route = "workbench.extension.animation_compression.preview" }]

[nodes.animation_compression_compress_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionAnimationCompressionCompressButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Compress", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 88.0, preferred = 88.0, max = 98.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionCompress", event = "Click", route = "workbench.extension.animation_compression.compress" }]

[nodes.animation_compression_clip_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionAnimationCompressionClipTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "animation_compression_run_clip_table_row" }, { node = "animation_compression_attack_clip_table_row" }, { node = "animation_compression_facial_clip_table_row" }, { node = "animation_compression_error_clip_table_row" }]

[nodes.animation_compression_run_clip_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAnimationCompressionRunClipTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Run_Fwd", value_text = "ratio 8.2:1   max err 0.18 cm   selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionRunClipTableRow", event = "Click", route = "workbench.extension.animation_compression.clip.run" }]

[nodes.animation_compression_attack_clip_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAnimationCompressionAttackClipTableRow"
classes = ["workbench-table-row"]
props = { text = "Attack_Light", value_text = "ratio 6.4:1   additive curves   Clean" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionAttackClipTableRow", event = "Click", route = "workbench.extension.animation_compression.clip.attack" }]

[nodes.animation_compression_facial_clip_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAnimationCompressionFacialClipTableRow"
classes = ["workbench-table-row"]
props = { text = "Face_Talk_A", value_text = "ratio 4.1:1   curve rich   Review" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionFacialClipTableRow", event = "Click", route = "workbench.extension.animation_compression.clip.facial" }]

[nodes.animation_compression_error_clip_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAnimationCompressionErrorClipTableRow"
classes = ["workbench-table-row"]
props = { text = "Turn_180", value_text = "ratio 10.5:1   max err 1.8 cm   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/AnimationCompressionErrorClipTableRow", event = "Click", route = "workbench.extension.animation_compression.clip.error" }]

[nodes.animation_compression_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionAnimationCompressionOutputRow"
classes = ["workbench-table-row"]
props = { text = "Animation Compression", value_text = "AC_Locomotion   312 clips   3 warnings", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.animation_compression_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionAnimationCompressionRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "animation_compression_details_title" }, { node = "animation_compression_right_content" }]

[nodes.animation_compression_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionAnimationCompressionRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "animation_compression_codec_dropdown_property_row" }, { node = "animation_compression_tolerance_field_property_row" }, { node = "animation_compression_rate_field_property_row" }]

[nodes.animation_compression_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionAnimationCompressionDetailsTitle"
props = { text = "Compression Settings" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.animation_compression_codec_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionAnimationCompressionCodecDropdownPropertyRow"
props = { text = "Codec" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "animation_compression_codec_dropdown", slot = { name = "value" } }]

[nodes.animation_compression_codec_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionAnimationCompressionCodecDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "ACL Uniform", value = "ACL Uniform", options = ["ACL Uniform", "ACL Variable", "Per Track"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/AnimationCompressionCodecEdit", event = "Change", route = "workbench.extension.animation_compression.codec.edit" },
  { id = "WorkbenchExtension/AnimationCompressionCodecCommit", event = "Submit", route = "workbench.extension.animation_compression.codec.commit" },
]

[nodes.animation_compression_tolerance_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionAnimationCompressionToleranceFieldPropertyRow"
props = { text = "Tolerance" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "animation_compression_tolerance_field", slot = { name = "value" } }]

[nodes.animation_compression_tolerance_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionAnimationCompressionToleranceField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Tolerance: 0.5 cm" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/AnimationCompressionToleranceEdit", event = "Change", route = "workbench.extension.animation_compression.tolerance.edit" },
  { id = "WorkbenchExtension/AnimationCompressionToleranceCommit", event = "Submit", route = "workbench.extension.animation_compression.tolerance.commit" },
]

[nodes.animation_compression_rate_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionAnimationCompressionRateFieldPropertyRow"
props = { text = "Rate" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "animation_compression_rate_field", slot = { name = "value" } }]

[nodes.animation_compression_rate_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionAnimationCompressionRateField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Sample Rate: 30 Hz" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/AnimationCompressionRateEdit", event = "Change", route = "workbench.extension.animation_compression.rate.edit" },
  { id = "WorkbenchExtension/AnimationCompressionRateCommit", event = "Submit", route = "workbench.extension.animation_compression.rate.commit" },
]
