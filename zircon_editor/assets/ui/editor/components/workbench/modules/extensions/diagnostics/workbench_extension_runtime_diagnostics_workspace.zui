[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/diagnostics/workbench_extension_runtime_diagnostics_workspace.zui"
version = 2
display_name = "Workbench Extension Runtime Diagnostics Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionRuntimeDiagnosticsWorkspace]
root = "runtime_diagnostics_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.runtime_diagnostics_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionRuntimeDiagnosticsWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "runtime_diagnostics_rail_gap" }, { node = "runtime_diagnostics_left" }, { node = "runtime_diagnostics_center" }, { node = "runtime_diagnostics_right" }]

[nodes.runtime_diagnostics_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionRuntimeDiagnosticsRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.runtime_diagnostics_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionRuntimeDiagnosticsLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "runtime_diagnostics_title" }, { node = "runtime_diagnostics_watch_tab" }, { node = "runtime_diagnostics_events_tab" }, { node = "runtime_diagnostics_console_tab" }, { node = "runtime_diagnostics_session_player_row" }, { node = "runtime_diagnostics_world_runtime_row" }, { node = "runtime_diagnostics_event_stream_row" }]

[nodes.runtime_diagnostics_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionRuntimeDiagnosticsTitle"
props = { text = "Runtime Diagnostics" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.runtime_diagnostics_watch_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionRuntimeDiagnosticsWatchTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Watch", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsWatchTab", event = "Click", route = "workbench.extension.runtime_diagnostics.watch" }]

[nodes.runtime_diagnostics_events_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionRuntimeDiagnosticsEventsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Events", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsEventsTab", event = "Click", route = "workbench.extension.runtime_diagnostics.events" }]

[nodes.runtime_diagnostics_console_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionRuntimeDiagnosticsConsoleTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Console", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsConsoleTab", event = "Click", route = "workbench.extension.runtime_diagnostics.console" }]

[nodes.runtime_diagnostics_session_player_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionRuntimeDiagnosticsSessionPlayerRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Session_Player_01", icon = "info", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsSessionPlayerRow", event = "Click", route = "workbench.extension.runtime_diagnostics.session.player01" }]

[nodes.runtime_diagnostics_world_runtime_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionRuntimeDiagnosticsWorldRuntimeRow"
classes = ["workbench-list-row"]
props = { text = "World_Runtime", icon = "globe", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsWorldRuntimeRow", event = "Click", route = "workbench.extension.runtime_diagnostics.world.runtime" }]

[nodes.runtime_diagnostics_event_stream_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionRuntimeDiagnosticsEventStreamRow"
classes = ["workbench-list-row"]
props = { text = "Event_Stream", icon = "timeline", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsEventStreamRow", event = "Click", route = "workbench.extension.runtime_diagnostics.event_stream" }]

[nodes.runtime_diagnostics_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionRuntimeDiagnosticsCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "runtime_diagnostics_center_header" }, { node = "runtime_diagnostics_watch_table" }, { node = "runtime_diagnostics_output" }]

[nodes.runtime_diagnostics_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionRuntimeDiagnosticsCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "runtime_diagnostics_center_title" }, { node = "runtime_diagnostics_header_fill" }, { node = "runtime_diagnostics_capture_snapshot_button" }, { node = "runtime_diagnostics_export_report_button" }]

[nodes.runtime_diagnostics_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionRuntimeDiagnosticsCenterTitle"
props = { text = "Runtime Watch Values" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.runtime_diagnostics_header_fill]
component = "Container"
control_id = "WorkbenchExtensionRuntimeDiagnosticsHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.runtime_diagnostics_capture_snapshot_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionRuntimeDiagnosticsCaptureSnapshotButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Capture Snapshot", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 136.0, preferred = 136.0, max = 150.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsCaptureSnapshot", event = "Click", route = "workbench.extension.runtime_diagnostics.capture_snapshot" }]

[nodes.runtime_diagnostics_export_report_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionRuntimeDiagnosticsExportReportButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Export Report", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 112.0, preferred = 112.0, max = 126.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsExportReport", event = "Click", route = "workbench.extension.runtime_diagnostics.export_report" }]

[nodes.runtime_diagnostics_watch_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionRuntimeDiagnosticsWatchTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "runtime_diagnostics_actor_health_table_row" }, { node = "runtime_diagnostics_ai_guard_state_table_row" }, { node = "runtime_diagnostics_world_time_table_row" }, { node = "runtime_diagnostics_weapon_target_table_row" }]

[nodes.runtime_diagnostics_actor_health_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRuntimeDiagnosticsActorHealthTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Player.Health", value_text = "Float   82   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsActorHealthTableRow", event = "Click", route = "workbench.extension.runtime_diagnostics.watch.actor_health" }]

[nodes.runtime_diagnostics_ai_guard_state_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRuntimeDiagnosticsAiGuardStateTableRow"
classes = ["workbench-table-row"]
props = { text = "AI.Guard.State", value_text = "Enum   Alert   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsAiGuardStateTableRow", event = "Click", route = "workbench.extension.runtime_diagnostics.watch.ai_guard_state" }]

[nodes.runtime_diagnostics_world_time_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRuntimeDiagnosticsWorldTimeTableRow"
classes = ["workbench-table-row"]
props = { text = "World.Time", value_text = "Float   142.4   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsWorldTimeTableRow", event = "Click", route = "workbench.extension.runtime_diagnostics.watch.world_time" }]

[nodes.runtime_diagnostics_weapon_target_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRuntimeDiagnosticsWeaponTargetTableRow"
classes = ["workbench-table-row"]
props = { text = "Weapon.Target", value_text = "Object   Null   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsWeaponTargetTableRow", event = "Click", route = "workbench.extension.runtime_diagnostics.watch.weapon_target" }]

[nodes.runtime_diagnostics_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRuntimeDiagnosticsOutputRow"
classes = ["workbench-table-row"]
props = { text = "Runtime Output", value_text = "Actors 420   Events 1.2K   Errors 1   FPS 58" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RuntimeDiagnosticsOutput", event = "Click", route = "workbench.extension.runtime_diagnostics.output" }]

[nodes.runtime_diagnostics_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionRuntimeDiagnosticsRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "runtime_diagnostics_details_title" }, { node = "runtime_diagnostics_session_dropdown" }, { node = "runtime_diagnostics_subsystem_dropdown" }, { node = "runtime_diagnostics_filter_field" }]

[nodes.runtime_diagnostics_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionRuntimeDiagnosticsDetailsTitle"
props = { text = "Runtime Filters" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.runtime_diagnostics_session_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionRuntimeDiagnosticsSessionDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Player_01", value = "Player_01", options = ["Player_01", "Editor", "Replay_02", "Dedicated"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/RuntimeDiagnosticsSessionEdit", event = "Change", route = "workbench.extension.runtime_diagnostics.session.edit" },
  { id = "WorkbenchExtension/RuntimeDiagnosticsSessionCommit", event = "Submit", route = "workbench.extension.runtime_diagnostics.session.commit" },
]

[nodes.runtime_diagnostics_subsystem_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionRuntimeDiagnosticsSubsystemDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "World", value = "World", options = ["World", "Actors", "Components", "Events"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/RuntimeDiagnosticsSubsystemEdit", event = "Change", route = "workbench.extension.runtime_diagnostics.subsystem.edit" },
  { id = "WorkbenchExtension/RuntimeDiagnosticsSubsystemCommit", event = "Submit", route = "workbench.extension.runtime_diagnostics.subsystem.commit" },
]

[nodes.runtime_diagnostics_filter_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionRuntimeDiagnosticsFilterField"
classes = ["workbench-field", "workbench-component-field"]
props = { label = "Filter", value = "health" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/RuntimeDiagnosticsFilterEdit", event = "Change", route = "workbench.extension.runtime_diagnostics.filter.edit" },
  { id = "WorkbenchExtension/RuntimeDiagnosticsFilterCommit", event = "Submit", route = "workbench.extension.runtime_diagnostics.filter.commit" },
]
