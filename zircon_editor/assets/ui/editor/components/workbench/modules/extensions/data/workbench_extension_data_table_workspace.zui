[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/data/workbench_extension_data_table_workspace.zui"
version = 2
display_name = "Workbench Extension Data Table Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []
[components.WorkbenchExtensionDataTableWorkspace]
root = "data_table_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.data_table_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionDataTableWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "data_table_workspace_main" },
  { node = "data_table_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.data_table_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "data_table_rail_gap" }, { node = "data_table_left" }, { node = "data_table_center" }, { node = "data_table_right_reserve" }]

[nodes.data_table_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.data_table_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionDataTableRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.data_table_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionDataTableLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "data_table_title" }, { node = "data_table_left_content" }]

[nodes.data_table_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionDataTableLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "data_table_items_row" }, { node = "data_table_schema_row" }, { node = "data_table_localization_row" }]

[nodes.data_table_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionDataTableTitle"
props = { text = "Data Table" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.data_table_items_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionDataTableItemsRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "DT_Items", icon = "grid", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/DataTableItemsRow", event = "Click", route = "workbench.extension.data_table.items" }]

[nodes.data_table_schema_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionDataTableSchemaRow"
classes = ["workbench-list-row"]
props = { text = "Schema_Item", icon = "file", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/DataTableSchemaRow", event = "Click", route = "workbench.extension.data_table.schema_file" }]

[nodes.data_table_localization_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionDataTableLocalizationRow"
classes = ["workbench-list-row"]
props = { text = "Localization", icon = "file", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/DataTableLocalizationRow", event = "Click", route = "workbench.extension.data_table.localization" }]

[nodes.data_table_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionDataTableCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "data_table_center_header" }, { node = "data_table_rows" }, { node = "data_table_output" }]

[nodes.data_table_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionDataTableCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "data_table_center_title" }, { node = "data_table_header_fill" }, { node = "data_table_validate_button" }, { node = "data_table_save_button" }]

[nodes.data_table_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionDataTableCenterTitle"
props = { text = "Rows / DT_Items" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.data_table_header_fill]
component = "Container"
control_id = "WorkbenchExtensionDataTableHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.data_table_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionDataTableValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Validate", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/DataTableValidate", event = "Click", route = "workbench.extension.data_table.validate" }]

[nodes.data_table_save_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionDataTableSaveButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Save Table", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 96.0, preferred = 96.0, max = 110.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/DataTableSave", event = "Click", route = "workbench.extension.data_table.save" }]

[nodes.data_table_rows]
component = "ScrollableBox"
control_id = "WorkbenchExtensionDataTableRows"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "data_table_potion_row" }, { node = "data_table_sword_row" }, { node = "data_table_armor_row" }, { node = "data_table_debug_row" }]

[nodes.data_table_potion_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionDataTablePotionRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Potion_Health", value_text = "Consumable   +50 HP   Selected" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/DataTablePotionRow", event = "Click", route = "workbench.extension.data_table.row.potion" }]

[nodes.data_table_sword_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionDataTableSwordRow"
classes = ["workbench-table-row"]
props = { text = "Sword_01", value_text = "Weapon   12 DPS   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/DataTableSwordRow", event = "Click", route = "workbench.extension.data_table.row.sword" }]

[nodes.data_table_armor_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionDataTableArmorRow"
classes = ["workbench-table-row"]
props = { text = "Armor_Heavy", value_text = "Armor   42 DEF   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/DataTableArmorRow", event = "Click", route = "workbench.extension.data_table.row.armor" }]

[nodes.data_table_debug_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionDataTableDebugRow"
classes = ["workbench-table-row"]
props = { text = "Debug_Item", value_text = "Item   Missing Icon   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/DataTableDebugRow", event = "Click", route = "workbench.extension.data_table.row.debug" }]

[nodes.data_table_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionDataTableOutputRow"
classes = ["workbench-table-row"]
props = { text = "Validation", value_text = "128 rows   2 warnings   512 refs", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.data_table_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionDataTableRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "data_table_details_title" }, { node = "data_table_right_content" }]

[nodes.data_table_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionDataTableRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "data_table_row_field_property_row" }, { node = "data_table_type_dropdown_property_row" }, { node = "data_table_version_field_property_row" }]

[nodes.data_table_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionDataTableDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.data_table_row_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionDataTableRowFieldPropertyRow"
props = { text = "Row" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "data_table_row_field", slot = { name = "value" } }]

[nodes.data_table_row_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionDataTableRowField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Potion_Health" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/DataTableRowEdit", event = "Change", route = "workbench.extension.data_table.row.edit" },
  { id = "WorkbenchExtension/DataTableRowCommit", event = "Submit", route = "workbench.extension.data_table.row.commit" },
]

[nodes.data_table_type_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionDataTableTypeDropdownPropertyRow"
props = { text = "Type" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "data_table_type_dropdown", slot = { name = "value" } }]

[nodes.data_table_type_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionDataTableTypeDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Gameplay Item", value = "Gameplay Item", options = ["Gameplay Item", "Weapon", "Armor", "Debug"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/DataTableTypeEdit", event = "Change", route = "workbench.extension.data_table.type.edit" },
  { id = "WorkbenchExtension/DataTableTypeCommit", event = "Submit", route = "workbench.extension.data_table.type.commit" },
]

[nodes.data_table_version_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionDataTableVersionFieldPropertyRow"
props = { text = "Version" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "data_table_version_field", slot = { name = "value" } }]

[nodes.data_table_version_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionDataTableVersionField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "12" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/DataTableVersionEdit", event = "Change", route = "workbench.extension.data_table.version.edit" },
  { id = "WorkbenchExtension/DataTableVersionCommit", event = "Submit", route = "workbench.extension.data_table.version.commit" },
]
