[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/simulation/workbench_extension_physics_collision_workspace.zui"
version = 2
display_name = "Workbench Extension Physics Collision Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionPhysicsCollisionWorkspace]
root = "physics_collision_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.physics_collision_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionPhysicsCollisionWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "physics_collision_rail_gap" }, { node = "physics_collision_left" }, { node = "physics_collision_center" }, { node = "physics_collision_right" }]

[nodes.physics_collision_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionPhysicsCollisionRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.physics_collision_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPhysicsCollisionLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "physics_collision_title" }, { node = "physics_collision_bodies_tab" }, { node = "physics_collision_materials_tab" }, { node = "physics_collision_contacts_tab" }, { node = "physics_collision_player_capsule_row" }, { node = "physics_collision_material_ice_row" }, { node = "physics_collision_contact_wall_row" }]

[nodes.physics_collision_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPhysicsCollisionTitle"
props = { text = "Physics Collision" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.physics_collision_bodies_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionPhysicsCollisionBodiesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Bodies", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionBodiesTab", event = "Click", route = "workbench.extension.physics_collision.bodies" }]

[nodes.physics_collision_materials_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionPhysicsCollisionMaterialsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Materials", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionMaterialsTab", event = "Click", route = "workbench.extension.physics_collision.materials" }]

[nodes.physics_collision_contacts_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionPhysicsCollisionContactsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Contacts", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionContactsTab", event = "Click", route = "workbench.extension.physics_collision.contacts" }]

[nodes.physics_collision_player_capsule_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPhysicsCollisionPlayerCapsuleRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Body_PlayerCapsule", icon = "capsule", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionPlayerCapsuleRow", event = "Click", route = "workbench.extension.physics_collision.body.player_capsule" }]

[nodes.physics_collision_material_ice_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPhysicsCollisionMaterialIceRow"
classes = ["workbench-list-row"]
props = { text = "Material_Ice", icon = "circle", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionMaterialIceRow", event = "Click", route = "workbench.extension.physics_collision.material.ice" }]

[nodes.physics_collision_contact_wall_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPhysicsCollisionContactWallRow"
classes = ["workbench-list-row"]
props = { text = "Contact_Wall", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionContactWallRow", event = "Click", route = "workbench.extension.physics_collision.contact.wall" }]

[nodes.physics_collision_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPhysicsCollisionCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "physics_collision_center_header" }, { node = "physics_collision_matrix_table" }, { node = "physics_collision_output" }]

[nodes.physics_collision_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionPhysicsCollisionCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "physics_collision_center_title" }, { node = "physics_collision_header_fill" }, { node = "physics_collision_simulate_button" }, { node = "physics_collision_validate_button" }]

[nodes.physics_collision_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPhysicsCollisionCenterTitle"
props = { text = "Physics Collision Matrix" }
layout = { width = { min = 250.0, preferred = 250.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.physics_collision_header_fill]
component = "Container"
control_id = "WorkbenchExtensionPhysicsCollisionHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.physics_collision_simulate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPhysicsCollisionSimulateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Simulate Physics", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 132.0, preferred = 132.0, max = 144.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionSimulate", event = "Click", route = "workbench.extension.physics_collision.simulate" }]

[nodes.physics_collision_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPhysicsCollisionValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate Contacts", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 136.0, preferred = 136.0, max = 148.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionValidate", event = "Click", route = "workbench.extension.physics_collision.validate" }]

[nodes.physics_collision_matrix_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPhysicsCollisionMatrixTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = {}
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "physics_collision_player_capsule_table_row" }, { node = "physics_collision_ice_material_table_row" }, { node = "physics_collision_wall_contact_table_row" }, { node = "physics_collision_ccd_warning_table_row" }]

[nodes.physics_collision_player_capsule_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPhysicsCollisionPlayerCapsuleTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Player Capsule", value_text = "Dynamic body   82 kg   Active", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionPlayerCapsuleTableRow", event = "Click", route = "workbench.extension.physics_collision.matrix.player_capsule" }]

[nodes.physics_collision_ice_material_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPhysicsCollisionIceMaterialTableRow"
classes = ["workbench-table-row"]
props = { text = "Ice Material", value_text = "Friction 0.08   Restitution 0.2" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionIceMaterialTableRow", event = "Click", route = "workbench.extension.physics_collision.matrix.ice_material" }]

[nodes.physics_collision_wall_contact_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPhysicsCollisionWallContactTableRow"
classes = ["workbench-table-row"]
props = { text = "Wall Contact", value_text = "4 manifolds   penetration 1.8 cm" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionWallContactTableRow", event = "Click", route = "workbench.extension.physics_collision.matrix.wall_contact" }]

[nodes.physics_collision_ccd_warning_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPhysicsCollisionCcdWarningTableRow"
classes = ["workbench-table-row"]
props = { text = "CCD Warning", value_text = "Projectile layer missing continuous sweep" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionCcdWarningTableRow", event = "Click", route = "workbench.extension.physics_collision.matrix.ccd_warning" }]

[nodes.physics_collision_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPhysicsCollisionOutputRow"
classes = ["workbench-table-row"]
props = { text = "Physics Output", value_text = "124 bodies   32 contacts   1 warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PhysicsCollisionOutput", event = "Click", route = "workbench.extension.physics_collision.output" }]

[nodes.physics_collision_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPhysicsCollisionRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "physics_collision_details_title" }, { node = "physics_collision_profile_dropdown" }, { node = "physics_collision_solver_dropdown" }, { node = "physics_collision_mass_field" }]

[nodes.physics_collision_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPhysicsCollisionDetailsTitle"
props = { text = "Collision Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.physics_collision_profile_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPhysicsCollisionProfileDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Character", value = "Character", options = ["Default", "Vehicle", "Character", "Ragdoll"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PhysicsCollisionProfileEdit", event = "Change", route = "workbench.extension.physics_collision.profile.edit" },
  { id = "WorkbenchExtension/PhysicsCollisionProfileCommit", event = "Submit", route = "workbench.extension.physics_collision.profile.commit" },
]

[nodes.physics_collision_solver_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPhysicsCollisionSolverDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "TGS", value = "TGS", options = ["PGS", "TGS", "XPBD", "Debug"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PhysicsCollisionSolverEdit", event = "Change", route = "workbench.extension.physics_collision.solver.edit" },
  { id = "WorkbenchExtension/PhysicsCollisionSolverCommit", event = "Submit", route = "workbench.extension.physics_collision.solver.commit" },
]

[nodes.physics_collision_mass_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionPhysicsCollisionMassField"
classes = ["workbench-field", "workbench-component-field"]
props = { label = "Mass", value = "82 kg" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PhysicsCollisionMassEdit", event = "Change", route = "workbench.extension.physics_collision.mass.edit" },
  { id = "WorkbenchExtension/PhysicsCollisionMassCommit", event = "Submit", route = "workbench.extension.physics_collision.mass.commit" },
]
