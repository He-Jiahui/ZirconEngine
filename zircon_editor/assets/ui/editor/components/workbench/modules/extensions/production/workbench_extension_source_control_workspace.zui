[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/production/workbench_extension_source_control_workspace.zui"
version = 2
display_name = "Workbench Extension Source Control Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []
[components.WorkbenchExtensionSourceControlWorkspace]
root = "source_control_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.source_control_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionSourceControlWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "source_control_workspace_main" },
  { node = "source_control_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.source_control_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_rail_gap" }, { node = "source_control_left" }, { node = "source_control_center" }, { node = "source_control_right_reserve" }]

[nodes.source_control_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.source_control_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionSourceControlRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.source_control_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSourceControlLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_title" }, { node = "source_control_left_content" }]

[nodes.source_control_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionSourceControlLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_changelist_row" }, { node = "source_control_runtime_row" }, { node = "source_control_editor_row" }]

[nodes.source_control_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSourceControlTitle"
props = { text = "Source Control" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.source_control_changelist_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSourceControlChangelistRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "CL_2048", icon = "history", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlChangelistRow", event = "Click", route = "workbench.extension.source_control.changelist" }]

[nodes.source_control_runtime_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSourceControlRuntimeRow"
classes = ["workbench-list-row"]
props = { text = "zircon_runtime", icon = "folder", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlRuntimeRow", event = "Click", route = "workbench.extension.source_control.runtime" }]

[nodes.source_control_editor_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSourceControlEditorRow"
classes = ["workbench-list-row"]
props = { text = "zircon_editor", icon = "folder", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlEditorRow", event = "Click", route = "workbench.extension.source_control.editor" }]

[nodes.source_control_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSourceControlCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_center_header" }, { node = "source_control_files" }, { node = "source_control_output" }]

[nodes.source_control_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionSourceControlCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "source_control_center_title" }, { node = "source_control_header_fill" }, { node = "source_control_validate_button" }, { node = "source_control_submit_button" }]

[nodes.source_control_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSourceControlCenterTitle"
props = { text = "CL_2048 / Diff Review" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.source_control_header_fill]
component = "Container"
control_id = "WorkbenchExtensionSourceControlHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.source_control_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionSourceControlValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlValidate", event = "Click", route = "workbench.extension.source_control.validate" }]

[nodes.source_control_submit_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionSourceControlSubmitButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Submit", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 82.0, preferred = 82.0, max = 92.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlSubmit", event = "Click", route = "workbench.extension.source_control.submit_change" }]

[nodes.source_control_files]
component = "ScrollableBox"
control_id = "WorkbenchExtensionSourceControlFiles"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_runtime_file_row" }, { node = "source_control_editor_file_row" }, { node = "source_control_docs_file_row" }, { node = "source_control_conflict_file_row" }]

[nodes.source_control_runtime_file_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlRuntimeFileRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "runtime/ui/render.rs", value_text = "Modified   Alice   Selected" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlRuntimeFileRow", event = "Click", route = "workbench.extension.source_control.file.runtime" }]

[nodes.source_control_editor_file_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlEditorFileRow"
classes = ["workbench-table-row"]
props = { text = "editor/painter.rs", value_text = "Modified   Bob   Review" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlEditorFileRow", event = "Click", route = "workbench.extension.source_control.file.editor" }]

[nodes.source_control_docs_file_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlDocsFileRow"
classes = ["workbench-table-row"]
props = { text = "docs/ui.md", value_text = "Added   Alice   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlDocsFileRow", event = "Click", route = "workbench.extension.source_control.file.docs" }]

[nodes.source_control_conflict_file_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlConflictFileRow"
classes = ["workbench-table-row"]
props = { text = "asset/import.rs", value_text = "Conflict   Chen   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SourceControlConflictFileRow", event = "Click", route = "workbench.extension.source_control.file.conflict" }]

[nodes.source_control_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSourceControlOutputRow"
classes = ["workbench-table-row"]
props = { text = "Checks", value_text = "18 files   2 conflicts   6 checks", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.source_control_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSourceControlRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_details_title" }, { node = "source_control_right_content" }]

[nodes.source_control_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionSourceControlRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "source_control_changelist_dropdown_property_row" }, { node = "source_control_owner_field_property_row" }, { node = "source_control_gate_dropdown_property_row" }]

[nodes.source_control_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSourceControlDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.source_control_changelist_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionSourceControlChangelistDropdownPropertyRow"
props = { text = "Changelist" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "source_control_changelist_dropdown", slot = { name = "value" } }]

[nodes.source_control_changelist_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionSourceControlChangelistDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "CL_2048", value = "CL_2048", options = ["CL_2048", "CL_2049", "Shelved_Alice"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SourceControlChangelistEdit", event = "Change", route = "workbench.extension.source_control.changelist.edit" },
  { id = "WorkbenchExtension/SourceControlChangelistCommit", event = "Submit", route = "workbench.extension.source_control.changelist.commit" },
]

[nodes.source_control_owner_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionSourceControlOwnerFieldPropertyRow"
props = { text = "Owner" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "source_control_owner_field", slot = { name = "value" } }]

[nodes.source_control_owner_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionSourceControlOwnerField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Alice" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SourceControlOwnerEdit", event = "Change", route = "workbench.extension.source_control.owner.edit" },
  { id = "WorkbenchExtension/SourceControlOwnerCommit", event = "Submit", route = "workbench.extension.source_control.owner.commit" },
]

[nodes.source_control_gate_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionSourceControlGateDropdownPropertyRow"
props = { text = "Gate" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "source_control_gate_dropdown", slot = { name = "value" } }]

[nodes.source_control_gate_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionSourceControlGateDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Full", value = "Full", options = ["Fast", "Full", "Submit Only"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SourceControlGateEdit", event = "Change", route = "workbench.extension.source_control.gate.edit" },
  { id = "WorkbenchExtension/SourceControlGateCommit", event = "Submit", route = "workbench.extension.source_control.gate.commit" },
]
