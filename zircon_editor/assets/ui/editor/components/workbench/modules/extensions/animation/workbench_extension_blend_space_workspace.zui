control_id = "WorkbenchExtensionBlendSpacePreviewViewport"
classes = ["workbench-panel", "workbench-module-canvas"]
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.xsmall" }, width = { stretch = "Stretch" }, height = { min = 164.0, preferred = 184.0, max = 216.0, stretch = "Fixed" } }
children = [{ node = "blend_space_preview_toolbar" }, { node = "blend_space_preview_viewport_image" }, { node = "blend_space_preview_status" }]

