control_id = "WorkbenchExtensionBlendSpaceOutputPanel"
classes = ["workbench-panel", "workbench-module-canvas", "workbench-surface-inset"]
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.xsmall" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "blend_space_output_header" }, { node = "blend_space_timeline_transport" }, { node = "blend_space_preview_timeline" }]

[nodes.blend_space_output_header]
component = "WorkbenchPanelHeader"
control_id = "WorkbenchExtensionBlendSpaceOutputHeader"
layout = { width = { stretch = "Stretch" } }
children = [{ node = "blend_space_output_title", slot = { name = "title" } }, { node = "blend_space_timeline_rate", slot = { name = "actions" } }]

[nodes.blend_space_output_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionBlendSpaceOutputTitle"
props = { text = "Preview Timeline" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.blend_space_timeline_rate]
component = "WorkbenchCaption"
control_id = "WorkbenchExtensionBlendSpaceTimelineRate"
props = { text = "1.0x" }
layout = { width = { min = 32.0, preferred = 38.0, max = 44.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.blend_space_timeline_transport]
component = "WorkbenchTransportControls"
control_id = "WorkbenchExtensionBlendSpaceTimelineTransport"
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.blend_space_preview_timeline]
component = "WorkbenchTimelineStrip"
control_id = "WorkbenchExtensionBlendSpacePreviewTimeline"
props = { component_variant = "timeline-strip", duration = 3.0, current_time = 3.0, tick_interval = 0.5, track_label = "Run_Fwd", timeline_keys = [{ time = 0.0, label = "Start", selected = false }, { time = 2.0, label = "Run_Fwd", selected = true }], input_interactive = true, input_clickable = true, input_focusable = true }
layout = { clip = true, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "WorkbenchExtension/BlendSpaceOutput", event = "Click", route = "workbench.extension.blend_space.output.select" }]

[nodes.blend_space_sample_weights]
component = "WorkbenchSampleWeights"
control_id = "WorkbenchExtensionBlendSpaceSampleWeights"
props = { responsive_min_tier = "wide" }
layout = { width = { min = 178.0, preferred = 178.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.blend_space_validation_log]
component = "WorkbenchValidationLog"
control_id = "WorkbenchExtensionBlendSpaceValidationLog"
props = { responsive_min_tier = "wide" }
layout = { width = { min = 212.0, preferred = 212.0, max = 270.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
