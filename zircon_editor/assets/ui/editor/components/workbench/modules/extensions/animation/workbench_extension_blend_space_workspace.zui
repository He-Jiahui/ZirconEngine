[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/animation/workbench_extension_blend_space_workspace.zui"
version = 2
display_name = "Workbench Extension Blend Space Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput",
  "res://ui/editor/components/workbench/primitives/data/workbench_divider.zui#WorkbenchDivider",
  "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_preview_viewport.zui#WorkbenchPreviewViewport",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_sample_grid.zui#WorkbenchSampleGrid",
  "res://ui/editor/components/workbench/primitives/data/workbench_weight_heatmap.zui#WorkbenchWeightHeatmap",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_timeline_strip.zui#WorkbenchTimelineStrip",
  "res://ui/editor/components/workbench/primitives/data/workbench_tree_row.zui#WorkbenchTreeRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_chip.zui#WorkbenchChip",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/composites/chrome/workbench_panel_header.zui#WorkbenchPanelHeader",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench/composites/animation/workbench_transport_controls.zui#WorkbenchTransportControls",
  "res://ui/editor/components/workbench/composites/animation/workbench_blend_space_details.zui#WorkbenchBlendSpaceDetails",
  "res://ui/editor/components/workbench/composites/animation/workbench_sample_weights.zui#WorkbenchSampleWeights",
  "res://ui/editor/components/workbench/composites/feedback/workbench_validation_log.zui#WorkbenchValidationLog",
]
styles = []

[components.WorkbenchExtensionBlendSpaceWorkspace]
root = "blend_space_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.blend_space_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionBlendSpaceWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 1.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "blend_space_rail_gap" }, { node = "blend_space_left" }, { node = "blend_space_center" }, { node = "blend_space_right" }]

[nodes.blend_space_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionBlendSpaceRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.blend_space_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionBlendSpaceLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { min = 188.0, preferred = 220.0, max = 250.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "blend_space_title" }, { node = "blend_space_tabs" }, { node = "blend_space_search" }, { node = "blend_space_assets_title" }, { node = "blend_space_idle_run_row" }, { node = "blend_space_strafe_row" }, { node = "blend_space_sprint_row" }, { node = "blend_space_search_empty" }, { node = "blend_space_left_divider" }, { node = "blend_space_files_title" }, { node = "blend_space_characters_tree_row" }, { node = "blend_space_locomotion_tree_row" }, { node = "blend_space_clips_tree_row" }, { node = "blend_space_left_fill" }]

[nodes.blend_space_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionBlendSpaceTitle"
props = { text = "Blend Space" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.blend_space_tabs]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionBlendSpaceTabs"
classes = ["workbench-tab-strip", "workbench-module-panel-tabs"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.xsmall" }, width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
children = [{ node = "blend_space_samples_tab" }, { node = "blend_space_axes_tab" }, { node = "blend_space_preview_tab" }]

[nodes.blend_space_samples_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionBlendSpaceSamplesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Samples", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceSamplesTab", event = "Click", route = "workbench.extension.blend_space.samples_tab.select" }]

[nodes.blend_space_axes_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionBlendSpaceAxesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Axes", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceAxesTab", event = "Click", route = "workbench.extension.blend_space.axes_tab.select" }]

[nodes.blend_space_preview_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionBlendSpacePreviewTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Preview", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpacePreviewTab", event = "Click", route = "workbench.extension.blend_space.preview_tab.select" }]

[nodes.blend_space_search]
component = "WorkbenchSearchInput"
control_id = "WorkbenchExtensionBlendSpaceSearch"
props = { query = "", placeholder = "Search samples", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceSearchEdit", event = "Change", route = "workbench.extension.blend_space.search.edit" }, { id = "WorkbenchExtension/BlendSpaceSearchCommit", event = "Submit", route = "workbench.extension.blend_space.search.commit" }]

[nodes.blend_space_assets_title]
component = "WorkbenchCaption"
control_id = "WorkbenchExtensionBlendSpaceAssetsTitle"
props = { text = "BLEND ASSETS" }
layout = { width = { stretch = "Stretch" }, height = { min = 20.0, preferred = 20.0, max = 22.0, stretch = "Fixed" } }

[nodes.blend_space_idle_run_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionBlendSpaceIdleRunRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "BS_Idle_Run", icon = "play", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceIdleRunRow", event = "Click", route = "workbench.extension.blend_space.idle_run_row.select" }]

[nodes.blend_space_strafe_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionBlendSpaceStrafeRow"
classes = ["workbench-list-row"]
props = { text = "BS_Strafe_Grid", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceStrafeRow", event = "Click", route = "workbench.extension.blend_space.strafe_row.select" }]

[nodes.blend_space_sprint_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionBlendSpaceSprintRow"
classes = ["workbench-list-row"]
props = { text = "BS_Sprint_Lean", icon = "history", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceSprintRow", event = "Click", route = "workbench.extension.blend_space.sprint_row.select" }]

[nodes.blend_space_search_empty]
component = "WorkbenchCaption"
control_id = "WorkbenchExtensionBlendSpaceSearchEmpty"
props = { text = "No matching blend assets", visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 18.0, preferred = 20.0, max = 22.0, stretch = "Fixed" } }

[nodes.blend_space_left_divider]
component = "WorkbenchDivider"
control_id = "WorkbenchExtensionBlendSpaceLeftDivider"
layout = { width = { stretch = "Stretch" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" } }

[nodes.blend_space_files_title]
component = "WorkbenchCaption"
control_id = "WorkbenchExtensionBlendSpaceFilesTitle"
props = { text = "FILES" }
layout = { width = { stretch = "Stretch" }, height = { min = 20.0, preferred = 20.0, max = 22.0, stretch = "Fixed" } }

[nodes.blend_space_characters_tree_row]
component = "WorkbenchTreeRow"
control_id = "WorkbenchExtensionBlendSpaceCharactersTreeRow"
props = { text = "Characters", expanded = true, tree_depth = 0, input_interactive = false, input_clickable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.blend_space_locomotion_tree_row]
component = "WorkbenchTreeRow"
control_id = "WorkbenchExtensionBlendSpaceLocomotionTreeRow"
props = { text = "Locomotion", expanded = true, tree_depth = 1, input_interactive = false, input_clickable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.blend_space_clips_tree_row]
component = "WorkbenchTreeRow"
control_id = "WorkbenchExtensionBlendSpaceClipsTreeRow"
props = { text = "Animation Clips", expanded = false, tree_depth = 2, input_interactive = false, input_clickable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.blend_space_left_fill]
component = "Container"
control_id = "WorkbenchExtensionBlendSpaceLeftFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.blend_space_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionBlendSpaceCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "blend_space_center_header" }, { node = "blend_space_center_work_area" }, { node = "blend_space_bottom_composite_row" }]

[nodes.blend_space_center_header]
component = "WorkbenchPanelHeader"
control_id = "WorkbenchExtensionBlendSpaceCenterHeader"
layout = { width = { stretch = "Stretch" } }
children = [{ node = "blend_space_center_title", slot = { name = "title" } }, { node = "blend_space_asset_summary", slot = { name = "actions" } }, { node = "blend_space_preview_button", slot = { name = "actions" } }, { node = "blend_space_apply_button", slot = { name = "actions" } }]

[nodes.blend_space_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionBlendSpaceCenterTitle"
props = { text = "Blend Space" }
layout = { width = { min = 92.0, preferred = 112.0, max = 132.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.blend_space_asset_summary]
component = "WorkbenchCaption"
control_id = "WorkbenchExtensionBlendSpaceAssetSummary"
props = { text = "BS_Locomotion  |  8 samples", responsive_min_tier = "wide" }
layout = { width = { min = 122.0, preferred = 164.0, max = 190.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.blend_space_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionBlendSpacePreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary", responsive_min_tier = "wide" }
layout = { width = { min = 68.0, preferred = 74.0, max = 82.0, stretch = "Fixed" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpacePreview", event = "Click", route = "workbench.extension.blend_space.preview.invoke" }]

[nodes.blend_space_apply_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionBlendSpaceApplyButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Apply", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 62.0, preferred = 68.0, max = 76.0, stretch = "Fixed" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceApply", event = "Click", route = "workbench.extension.blend_space.apply.invoke" }]

[nodes.blend_space_center_work_area]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionBlendSpaceCenterWorkArea"
layout = { clip = true, container = { kind = "HorizontalBox", gap = 1.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "blend_space_sample_canvas" }, { node = "blend_space_preview_card" }]

[nodes.blend_space_sample_canvas]
component = "VerticalGroup"
control_id = "WorkbenchExtensionBlendSpaceSampleCanvas"
classes = ["workbench-panel", "workbench-module-canvas", "workbench-surface-inset"]
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "blend_space_canvas_toolbar" }, { node = "blend_space_sample_grid" }]

[nodes.blend_space_canvas_toolbar]
component = "WorkbenchPanelHeader"
control_id = "WorkbenchExtensionBlendSpaceCanvasToolbar"
layout = { width = { stretch = "Stretch" } }
children = [{ node = "blend_space_canvas_title", slot = { name = "title" } }, { node = "blend_space_canvas_status", slot = { name = "actions" } }]

[nodes.blend_space_canvas_title]
component = "WorkbenchCaption"
control_id = "WorkbenchExtensionBlendSpaceCanvasTitle"
props = { text = "SAMPLE GRID" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.blend_space_canvas_status]
component = "WorkbenchCaption"
control_id = "WorkbenchExtensionBlendSpaceCanvasStatus"
props = { text = "Speed x Direction" }
layout = { width = { min = 92.0, preferred = 112.0, max = 132.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.blend_space_sample_grid]
component = "WorkbenchSampleGrid"
control_id = "WorkbenchExtensionBlendSpaceSampleGrid"
props = { component_variant = "sample-grid", x_axis_label = "Direction (deg)", y_axis_label = "Speed (cm/s)", x_min = -180.0, x_max = 180.0, y_min = 0.0, y_max = 600.0, x_ticks = [-180.0, -135.0, -90.0, -45.0, 0.0, 45.0, 90.0, 135.0, 180.0], y_ticks = [0.0, 120.0, 240.0, 360.0, 480.0, 600.0], sample_points = [{ x = 0.0, y = 0.0, label = "Idle", selected = false }, { x = -90.0, y = 240.0, label = "Strafe_L", selected = false }, { x = 90.0, y = 240.0, label = "Strafe_R", selected = false }, { x = 0.0, y = 300.0, label = "Walk_Fwd", selected = false }, { x = -135.0, y = 520.0, label = "Run_Left", selected = false }, { x = 0.0, y = 600.0, label = "Run_Fwd", selected = true }, { x = 135.0, y = 520.0, label = "Run_Right", selected = false }, { x = 180.0, y = 180.0, label = "Backpedal", selected = false }] }
layout = { clip = true, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.blend_space_preview_card]
component = "VerticalGroup"
control_id = "WorkbenchExtensionBlendSpacePreviewCard"
classes = ["workbench-panel", "workbench-module-side", "workbench-surface-inset"]
props = { responsive_min_tier = "wide" }
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { min = 176.0, preferred = 208.0, max = 240.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "blend_space_preview_header" }, { node = "blend_space_preview_viewport" }, { node = "blend_space_preview_divider" }, { node = "blend_space_heatmap_header" }, { node = "blend_space_weight_heatmap" }, { node = "blend_space_preview_asset" }, { node = "blend_space_preview_fill" }]

[nodes.blend_space_preview_header]
component = "WorkbenchPanelHeader"
control_id = "WorkbenchExtensionBlendSpacePreviewHeader"
