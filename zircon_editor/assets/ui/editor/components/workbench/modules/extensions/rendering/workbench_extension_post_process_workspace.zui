[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/rendering/workbench_extension_post_process_workspace.zui"
version = 2
display_name = "Workbench Extension Post Process Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []
[components.WorkbenchExtensionPostProcessWorkspace]
root = "post_process_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.post_process_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionPostProcessWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "post_process_workspace_main" },
  { node = "post_process_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.post_process_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "post_process_rail_gap" }, { node = "post_process_left" }, { node = "post_process_center" }, { node = "post_process_right_reserve" }]

[nodes.post_process_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.post_process_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionPostProcessRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.post_process_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPostProcessLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "post_process_title" }, { node = "post_process_left_content" }]

[nodes.post_process_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPostProcessLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "post_process_global_row" }, { node = "post_process_cinematic_row" }, { node = "post_process_volume_row" }]

[nodes.post_process_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPostProcessTitle"
props = { text = "Post Process" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.post_process_global_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPostProcessGlobalStackRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Global Stack", icon = "renderer", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessGlobalStackRow", event = "Click", route = "workbench.extension.post_process.stack.global" }]

[nodes.post_process_cinematic_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPostProcessCinematicStackRow"
classes = ["workbench-list-row"]
props = { text = "Cinematic Grade", icon = "sun", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessCinematicStackRow", event = "Click", route = "workbench.extension.post_process.stack.cinematic" }]

[nodes.post_process_volume_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPostProcessVolumeBlendRow"
classes = ["workbench-list-row"]
props = { text = "Volume Blend", icon = "cube", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessVolumeBlendRow", event = "Click", route = "workbench.extension.post_process.volume_blend" }]

[nodes.post_process_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPostProcessCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "post_process_center_header" }, { node = "post_process_pass_table" }, { node = "post_process_output" }]

[nodes.post_process_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionPostProcessCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "post_process_center_title" }, { node = "post_process_header_fill" }, { node = "post_process_preview_button" }, { node = "post_process_apply_button" }]

[nodes.post_process_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPostProcessCenterTitle"
props = { text = "Post Process Stack" }
layout = { width = { min = 220.0, preferred = 220.0, max = 260.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.post_process_header_fill]
component = "Container"
control_id = "WorkbenchExtensionPostProcessHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.post_process_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPostProcessPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessPreview", event = "Click", route = "workbench.extension.post_process.preview" }]

[nodes.post_process_apply_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPostProcessApplyButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Apply", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessApply", event = "Click", route = "workbench.extension.post_process.apply" }]

[nodes.post_process_pass_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPostProcessPassTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "post_process_bloom_row" }, { node = "post_process_tonemap_row" }, { node = "post_process_lut_row" }, { node = "post_process_exposure_warning_row" }]

[nodes.post_process_bloom_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPostProcessBloomTableRow"
classes = ["workbench-table-row"]
props = { text = "Bloom", value_text = "0.65 intensity   threshold 1.0   Ready", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessBloomTableRow", event = "Click", route = "workbench.extension.post_process.pass.bloom" }]

[nodes.post_process_tonemap_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPostProcessTonemapTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Tonemap", value_text = "Filmic   exposure +0.4   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessTonemapTableRow", event = "Click", route = "workbench.extension.post_process.pass.tonemap" }]

[nodes.post_process_lut_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPostProcessLutTableRow"
classes = ["workbench-table-row"]
props = { text = "Color LUT", value_text = "LUT_CityWarm   33 cube   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessLutTableRow", event = "Click", route = "workbench.extension.post_process.pass.lut" }]

[nodes.post_process_exposure_warning_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPostProcessExposureWarningTableRow"
classes = ["workbench-table-row"]
props = { text = "Exposure Warning", value_text = "Interior volume   EV +2.1   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PostProcessExposureWarningTableRow", event = "Click", route = "workbench.extension.post_process.pass.exposure_warning" }]

[nodes.post_process_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPostProcessOutputRow"
classes = ["workbench-table-row"]
props = { text = "Post Process", value_text = "Preview ready   1 warning   stack active", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.post_process_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPostProcessRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "post_process_details_title" }, { node = "post_process_right_content" }]

[nodes.post_process_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPostProcessRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "post_process_profile_dropdown_property_row" }, { node = "post_process_volume_field_property_row" }, { node = "post_process_blend_dropdown_property_row" }]

[nodes.post_process_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPostProcessDetailsTitle"
props = { text = "Stack Settings" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.post_process_profile_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPostProcessProfileDropdownPropertyRow"
props = { text = "Profile" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "post_process_profile_dropdown", slot = { name = "value" } }]

[nodes.post_process_profile_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPostProcessProfileDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Cinematic", value = "cinematic", options = ["gameplay|label=Gameplay", "cinematic|label=Cinematic", "debug|label=Debug"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PostProcessProfileEdit", event = "Change", route = "workbench.extension.post_process.profile.edit" },
  { id = "WorkbenchExtension/PostProcessProfileCommit", event = "Submit", route = "workbench.extension.post_process.profile.commit" },
]

[nodes.post_process_volume_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPostProcessVolumeFieldPropertyRow"
props = { text = "Volume" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "post_process_volume_field", slot = { name = "value" } }]

[nodes.post_process_volume_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionPostProcessVolumeField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "PPV_CityGlobal" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PostProcessVolumeEdit", event = "Change", route = "workbench.extension.post_process.volume.edit" },
  { id = "WorkbenchExtension/PostProcessVolumeCommit", event = "Submit", route = "workbench.extension.post_process.volume.commit" },
]

[nodes.post_process_blend_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPostProcessBlendDropdownPropertyRow"
props = { text = "Blend" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "post_process_blend_dropdown", slot = { name = "value" } }]

[nodes.post_process_blend_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPostProcessBlendDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Weighted", value = "weighted", options = ["override|label=Override", "weighted|label=Weighted", "additive|label=Additive"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PostProcessBlendEdit", event = "Change", route = "workbench.extension.post_process.blend.edit" },
  { id = "WorkbenchExtension/PostProcessBlendCommit", event = "Submit", route = "workbench.extension.post_process.blend.commit" },
]
