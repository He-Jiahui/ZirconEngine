[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/animation/workbench_extension_montage_editor_workspace.zui"
version = 2
display_name = "Workbench Extension Montage Editor Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionMontageEditorWorkspace]
root = "montage_editor_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.montage_editor_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionMontageEditorWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "montage_editor_workspace_main" },
  { node = "montage_editor_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.montage_editor_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "montage_editor_rail_gap" }, { node = "montage_editor_left" }, { node = "montage_editor_center" }, { node = "montage_editor_right_reserve" }]

[nodes.montage_editor_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.montage_editor_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionMontageEditorRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.montage_editor_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionMontageEditorLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "montage_editor_title" }, { node = "montage_editor_left_content" }]

[nodes.montage_editor_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionMontageEditorLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "montage_editor_attack_row" }, { node = "montage_editor_combo_row" }, { node = "montage_editor_cancel_window_row" }]

[nodes.montage_editor_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionMontageEditorTitle"
props = { text = "Montage Editor" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.montage_editor_attack_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionMontageEditorAttackRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "AM_DashAttack", icon = "play", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorAttackRow", event = "Click", route = "workbench.extension.montage_editor.montage.attack" }]

[nodes.montage_editor_combo_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionMontageEditorComboRow"
classes = ["workbench-list-row"]
props = { text = "Combo Window", icon = "history", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorComboRow", event = "Click", route = "workbench.extension.montage_editor.montage.combo" }]

[nodes.montage_editor_cancel_window_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionMontageEditorCancelWindowRow"
classes = ["workbench-list-row"]
props = { text = "Cancel Window", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorCancelWindowRow", event = "Click", route = "workbench.extension.montage_editor.montage.cancel_window" }]

[nodes.montage_editor_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionMontageEditorCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "montage_editor_center_header" }, { node = "montage_editor_timeline_table" }, { node = "montage_editor_output" }]

[nodes.montage_editor_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionMontageEditorCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "montage_editor_center_title" }, { node = "montage_editor_header_fill" }, { node = "montage_editor_preview_button" }, { node = "montage_editor_apply_button" }]

[nodes.montage_editor_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionMontageEditorCenterTitle"
props = { text = "Section Timeline" }
layout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.montage_editor_header_fill]
component = "Container"
control_id = "WorkbenchExtensionMontageEditorHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.montage_editor_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionMontageEditorPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorPreview", event = "Click", route = "workbench.extension.montage_editor.preview" }]

[nodes.montage_editor_apply_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionMontageEditorApplyButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Apply", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 72.0, preferred = 72.0, max = 82.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorApply", event = "Click", route = "workbench.extension.montage_editor.apply" }]

[nodes.montage_editor_timeline_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionMontageEditorTimelineTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "montage_editor_intro_table_row" }, { node = "montage_editor_combo_table_row" }, { node = "montage_editor_notify_table_row" }, { node = "montage_editor_root_motion_table_row" }]

[nodes.montage_editor_intro_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionMontageEditorIntroTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Intro Section", value_text = "0.00-0.38s   Slot UpperBody   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorIntroTableRow", event = "Click", route = "workbench.extension.montage_editor.section.intro" }]

[nodes.montage_editor_combo_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionMontageEditorComboTableRow"
classes = ["workbench-table-row"]
props = { text = "Combo Branch", value_text = "0.38-0.74s   next section   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorComboTableRow", event = "Click", route = "workbench.extension.montage_editor.section.combo" }]

[nodes.montage_editor_notify_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionMontageEditorNotifyTableRow"
classes = ["workbench-table-row"]
props = { text = "Notify HitPause", value_text = "0.46s   gameplay cue   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorNotifyTableRow", event = "Click", route = "workbench.extension.montage_editor.notify.hit_pause" }]

[nodes.montage_editor_root_motion_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionMontageEditorRootMotionTableRow"
classes = ["workbench-table-row"]
props = { text = "Root Motion", value_text = "Extracted   2.8m forward   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/MontageEditorRootMotionTableRow", event = "Click", route = "workbench.extension.montage_editor.root_motion" }]

[nodes.montage_editor_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionMontageEditorOutputRow"
classes = ["workbench-table-row"]
props = { text = "Montage", value_text = "AM_DashAttack   4 sections   3 notifies", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.montage_editor_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionMontageEditorRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "montage_editor_details_title" }, { node = "montage_editor_right_content" }]

[nodes.montage_editor_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionMontageEditorRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "montage_editor_montage_dropdown_property_row" }, { node = "montage_editor_slot_field_property_row" }, { node = "montage_editor_blend_dropdown_property_row" }]

[nodes.montage_editor_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionMontageEditorDetailsTitle"
props = { text = "Montage Settings" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.montage_editor_montage_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionMontageEditorMontageDropdownPropertyRow"
props = { text = "Montage" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "montage_editor_montage_dropdown", slot = { name = "value" } }]

[nodes.montage_editor_montage_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionMontageEditorMontageDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "AM_DashAttack", value = "AM_DashAttack", options = ["AM_DashAttack", "AM_Combo_01", "AM_Evade"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/MontageEditorMontageEdit", event = "Change", route = "workbench.extension.montage_editor.montage.edit" },
  { id = "WorkbenchExtension/MontageEditorMontageCommit", event = "Submit", route = "workbench.extension.montage_editor.montage.commit" },
]

[nodes.montage_editor_slot_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionMontageEditorSlotFieldPropertyRow"
props = { text = "Slot" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "montage_editor_slot_field", slot = { name = "value" } }]

[nodes.montage_editor_slot_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionMontageEditorSlotField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Slot: UpperBody" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/MontageEditorSlotEdit", event = "Change", route = "workbench.extension.montage_editor.slot.edit" },
  { id = "WorkbenchExtension/MontageEditorSlotCommit", event = "Submit", route = "workbench.extension.montage_editor.slot.commit" },
]

[nodes.montage_editor_blend_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionMontageEditorBlendDropdownPropertyRow"
props = { text = "Blend" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "montage_editor_blend_dropdown", slot = { name = "value" } }]

[nodes.montage_editor_blend_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionMontageEditorBlendDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Blend 0.15s", value = "0.15", options = ["0.05|label=Blend 0.05s", "0.15|label=Blend 0.15s", "0.30|label=Blend 0.30s"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/MontageEditorBlendEdit", event = "Change", route = "workbench.extension.montage_editor.blend.edit" },
  { id = "WorkbenchExtension/MontageEditorBlendCommit", event = "Submit", route = "workbench.extension.montage_editor.blend.commit" },
]
