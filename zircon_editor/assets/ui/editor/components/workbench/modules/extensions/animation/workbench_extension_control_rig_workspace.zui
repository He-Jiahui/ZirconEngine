[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/animation/workbench_extension_control_rig_workspace.zui"
version = 2
display_name = "Workbench Extension Control Rig Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionControlRigWorkspace]
root = "control_rig_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.control_rig_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionControlRigWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "control_rig_workspace_main" },
  { node = "control_rig_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.control_rig_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "control_rig_rail_gap" }, { node = "control_rig_left" }, { node = "control_rig_center" }, { node = "control_rig_right_reserve" }]

[nodes.control_rig_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.control_rig_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionControlRigRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.control_rig_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionControlRigLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "control_rig_title" }, { node = "control_rig_left_content" }]

[nodes.control_rig_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionControlRigLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "control_rig_hero_row" }, { node = "control_rig_spine_row" }, { node = "control_rig_hand_row" }]

[nodes.control_rig_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionControlRigTitle"
props = { text = "Control Rig" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.control_rig_hero_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionControlRigHeroRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "CR_Hero", icon = "component", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigHeroRow", event = "Click", route = "workbench.extension.control_rig.rig.hero" }]

[nodes.control_rig_spine_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionControlRigSpineRow"
classes = ["workbench-list-row"]
props = { text = "Spine_CTRL", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigSpineRow", event = "Click", route = "workbench.extension.control_rig.control.spine" }]

[nodes.control_rig_hand_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionControlRigHandRow"
classes = ["workbench-list-row"]
props = { text = "Hand_IK_L", icon = "gear", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigHandRow", event = "Click", route = "workbench.extension.control_rig.control.hand" }]

[nodes.control_rig_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionControlRigCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "control_rig_center_header" }, { node = "control_rig_solve_table" }, { node = "control_rig_output" }]

[nodes.control_rig_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionControlRigCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "control_rig_center_title" }, { node = "control_rig_header_fill" }, { node = "control_rig_preview_button" }, { node = "control_rig_validate_button" }]

[nodes.control_rig_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionControlRigCenterTitle"
props = { text = "Solve Graph" }
layout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.control_rig_header_fill]
component = "Container"
control_id = "WorkbenchExtensionControlRigHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.control_rig_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionControlRigPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigPreview", event = "Click", route = "workbench.extension.control_rig.preview" }]

[nodes.control_rig_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionControlRigValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 78.0, preferred = 78.0, max = 90.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigValidate", event = "Click", route = "workbench.extension.control_rig.validate" }]

[nodes.control_rig_solve_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionControlRigSolveTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "control_rig_spine_control_table_row" }, { node = "control_rig_arm_ik_table_row" }, { node = "control_rig_hand_ik_table_row" }, { node = "control_rig_output_pose_table_row" }]

[nodes.control_rig_spine_control_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionControlRigSpineControlTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Spine_CTRL", value_text = "FK   World space   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigSpineControlTableRow", event = "Click", route = "workbench.extension.control_rig.solve.spine" }]

[nodes.control_rig_arm_ik_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionControlRigArmIkTableRow"
classes = ["workbench-table-row"]
props = { text = "Arm_IK_L", value_text = "IK   two bone   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigArmIkTableRow", event = "Click", route = "workbench.extension.control_rig.solve.arm_ik" }]

[nodes.control_rig_hand_ik_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionControlRigHandIkTableRow"
classes = ["workbench-table-row"]
props = { text = "Hand_IK_L", value_text = "Space switch   keyed   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigHandIkTableRow", event = "Click", route = "workbench.extension.control_rig.solve.hand_ik" }]

[nodes.control_rig_output_pose_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionControlRigOutputPoseTableRow"
classes = ["workbench-table-row"]
props = { text = "Output Pose", value_text = "64 controls   18 constraints   Clean" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ControlRigOutputPoseTableRow", event = "Click", route = "workbench.extension.control_rig.solve.output_pose" }]

[nodes.control_rig_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionControlRigOutputRow"
classes = ["workbench-table-row"]
props = { text = "Control Rig", value_text = "CR_Hero   64 controls   1 warning", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.control_rig_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionControlRigRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "control_rig_details_title" }, { node = "control_rig_right_content" }]

[nodes.control_rig_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionControlRigRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "control_rig_control_dropdown_property_row" }, { node = "control_rig_space_dropdown_property_row" }, { node = "control_rig_weight_field_property_row" }]

[nodes.control_rig_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionControlRigDetailsTitle"
props = { text = "Control Settings" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.control_rig_control_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionControlRigControlDropdownPropertyRow"
props = { text = "Control" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "control_rig_control_dropdown", slot = { name = "value" } }]

[nodes.control_rig_control_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionControlRigControlDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Hand_IK_L", value = "Hand_IK_L", options = ["Hand_IK_L", "Spine_CTRL", "Foot_IK_R"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ControlRigControlEdit", event = "Change", route = "workbench.extension.control_rig.control.edit" },
  { id = "WorkbenchExtension/ControlRigControlCommit", event = "Submit", route = "workbench.extension.control_rig.control.commit" },
]

[nodes.control_rig_space_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionControlRigSpaceDropdownPropertyRow"
props = { text = "Space" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "control_rig_space_dropdown", slot = { name = "value" } }]

[nodes.control_rig_space_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionControlRigSpaceDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "World", value = "World", options = ["World", "Local", "Parent"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ControlRigSpaceEdit", event = "Change", route = "workbench.extension.control_rig.space.edit" },
  { id = "WorkbenchExtension/ControlRigSpaceCommit", event = "Submit", route = "workbench.extension.control_rig.space.commit" },
]

[nodes.control_rig_weight_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionControlRigWeightFieldPropertyRow"
props = { text = "Weight" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "control_rig_weight_field", slot = { name = "value" } }]

[nodes.control_rig_weight_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionControlRigWeightField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Weight: 1.00" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ControlRigWeightEdit", event = "Change", route = "workbench.extension.control_rig.weight.edit" },
  { id = "WorkbenchExtension/ControlRigWeightCommit", event = "Submit", route = "workbench.extension.control_rig.weight.commit" },
]
