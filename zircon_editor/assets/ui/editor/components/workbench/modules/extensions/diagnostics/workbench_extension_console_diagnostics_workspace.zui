[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/diagnostics/workbench_extension_console_diagnostics_workspace.zui"
version = 2
display_name = "Workbench Extension Console Diagnostics Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionConsoleDiagnosticsWorkspace]
root = "console_diagnostics_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.console_diagnostics_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionConsoleDiagnosticsWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "console_diagnostics_workspace_main" },
  { node = "console_diagnostics_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.console_diagnostics_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_rail_gap" }, { node = "console_diagnostics_left" }, { node = "console_diagnostics_center" }, { node = "console_diagnostics_right_reserve" }]

[nodes.console_diagnostics_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.console_diagnostics_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionConsoleDiagnosticsRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.console_diagnostics_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_title" }, { node = "console_diagnostics_left_content" }]

[nodes.console_diagnostics_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionConsoleDiagnosticsLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_session_row" }, { node = "console_diagnostics_renderer_row" }, { node = "console_diagnostics_asset_row" }]

[nodes.console_diagnostics_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionConsoleDiagnosticsTitle"
props = { text = "Console Diagnostics" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.console_diagnostics_session_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsSessionRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Session_12_10", icon = "info", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsSessionRow", event = "Click", route = "workbench.extension.console_diagnostics.source.session" }]

[nodes.console_diagnostics_renderer_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsRendererRow"
classes = ["workbench-list-row"]
props = { text = "Renderer", icon = "alert", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsRendererRow", event = "Click", route = "workbench.extension.console_diagnostics.source.renderer" }]

[nodes.console_diagnostics_asset_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsAssetRow"
classes = ["workbench-list-row"]
props = { text = "Asset", icon = "file", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsAssetRow", event = "Click", route = "workbench.extension.console_diagnostics.source.asset" }]

[nodes.console_diagnostics_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_center_header" }, { node = "console_diagnostics_table" }, { node = "console_diagnostics_output" }]

[nodes.console_diagnostics_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "console_diagnostics_center_title" }, { node = "console_diagnostics_header_fill" }, { node = "console_diagnostics_filter_button" }, { node = "console_diagnostics_clear_button" }]

[nodes.console_diagnostics_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionConsoleDiagnosticsCenterTitle"
props = { text = "Console Live Feed" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.console_diagnostics_header_fill]
component = "Container"
control_id = "WorkbenchExtensionConsoleDiagnosticsHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.console_diagnostics_filter_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionConsoleDiagnosticsFilterConsoleButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Filter Console", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 122.0, preferred = 122.0, max = 134.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsFilterConsole", event = "Click", route = "workbench.extension.console_diagnostics.filter_console" }]

[nodes.console_diagnostics_clear_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionConsoleDiagnosticsClearConsoleButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Clear Console", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 116.0, preferred = 116.0, max = 128.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsClearConsole", event = "Click", route = "workbench.extension.console_diagnostics.clear_console" }]

[nodes.console_diagnostics_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionConsoleDiagnosticsTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_warning_table_row" }, { node = "console_diagnostics_info_table_row" }, { node = "console_diagnostics_gameplay_table_row" }, { node = "console_diagnostics_error_table_row" }]

[nodes.console_diagnostics_warning_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsWarningTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "12:10:11   Renderer   Warning", value_text = "Missing transient view" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsWarningTableRow", event = "Click", route = "workbench.extension.console_diagnostics.row.warning" }]

[nodes.console_diagnostics_info_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsInfoTableRow"
classes = ["workbench-table-row"]
props = { text = "12:10:13   Asset   Info", value_text = "Import completed" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsInfoTableRow", event = "Click", route = "workbench.extension.console_diagnostics.row.info" }]

[nodes.console_diagnostics_gameplay_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsGameplayTableRow"
classes = ["workbench-table-row"]
props = { text = "12:10:18   Gameplay   Warning", value_text = "Tag redirect used" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsGameplayTableRow", event = "Click", route = "workbench.extension.console_diagnostics.row.gameplay" }]

[nodes.console_diagnostics_error_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsErrorTableRow"
classes = ["workbench-table-row"]
props = { text = "12:10:21   Runtime   Error", value_text = "Null object path" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ConsoleDiagnosticsErrorTableRow", event = "Click", route = "workbench.extension.console_diagnostics.row.error" }]

[nodes.console_diagnostics_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsOutputRow"
classes = ["workbench-table-row"]
props = { text = "Console Diagnostics", value_text = "58 FPS   24 warnings   1 error   82 marks", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.console_diagnostics_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionConsoleDiagnosticsRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_details_title" }, { node = "console_diagnostics_right_content" }]

[nodes.console_diagnostics_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionConsoleDiagnosticsRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "console_diagnostics_subsystem_dropdown_property_row" }, { node = "console_diagnostics_severity_dropdown_property_row" }, { node = "console_diagnostics_regex_field_property_row" }]

[nodes.console_diagnostics_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionConsoleDiagnosticsDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.console_diagnostics_subsystem_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsSubsystemDropdownPropertyRow"
props = { text = "Subsystem" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "console_diagnostics_subsystem_dropdown", slot = { name = "value" } }]

[nodes.console_diagnostics_subsystem_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionConsoleDiagnosticsSubsystemDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Renderer", value = "Renderer", options = ["Renderer", "Asset", "Gameplay", "Runtime"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ConsoleDiagnosticsSubsystemEdit", event = "Change", route = "workbench.extension.console_diagnostics.subsystem.edit" },
  { id = "WorkbenchExtension/ConsoleDiagnosticsSubsystemCommit", event = "Submit", route = "workbench.extension.console_diagnostics.subsystem.commit" },
]

[nodes.console_diagnostics_severity_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsSeverityDropdownPropertyRow"
props = { text = "Severity" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "console_diagnostics_severity_dropdown", slot = { name = "value" } }]

[nodes.console_diagnostics_severity_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionConsoleDiagnosticsSeverityDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Warnings+", value = "Warnings+", options = ["Info+", "Warnings+", "Errors"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ConsoleDiagnosticsSeverityEdit", event = "Change", route = "workbench.extension.console_diagnostics.severity.edit" },
  { id = "WorkbenchExtension/ConsoleDiagnosticsSeverityCommit", event = "Submit", route = "workbench.extension.console_diagnostics.severity.commit" },
]

[nodes.console_diagnostics_regex_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionConsoleDiagnosticsRegexFieldPropertyRow"
props = { text = "Regex" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "console_diagnostics_regex_field", slot = { name = "value" } }]

[nodes.console_diagnostics_regex_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionConsoleDiagnosticsRegexField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Regex: texture|shader" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ConsoleDiagnosticsRegexEdit", event = "Change", route = "workbench.extension.console_diagnostics.regex.edit" },
  { id = "WorkbenchExtension/ConsoleDiagnosticsRegexCommit", event = "Submit", route = "workbench.extension.console_diagnostics.regex.commit" },
]
