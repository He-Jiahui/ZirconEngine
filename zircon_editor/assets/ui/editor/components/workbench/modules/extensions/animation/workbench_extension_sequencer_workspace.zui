[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/animation/workbench_extension_sequencer_workspace.zui"
version = 2
display_name = "Workbench Extension Sequencer Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionSequencerWorkspace]
root = "sequencer_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.sequencer_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionSequencerWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "sequencer_workspace_main" },
  { node = "sequencer_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.sequencer_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "sequencer_rail_gap" }, { node = "sequencer_left" }, { node = "sequencer_center" }, { node = "sequencer_right_reserve" }]

[nodes.sequencer_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.sequencer_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionSequencerRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.sequencer_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSequencerLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "sequencer_title" }, { node = "sequencer_left_content" }]

[nodes.sequencer_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionSequencerLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "sequencer_sequence_row" }, { node = "sequencer_camera_row" }, { node = "sequencer_event_row" }]

[nodes.sequencer_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSequencerTitle"
props = { text = "Sequencer" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.sequencer_sequence_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSequencerSequenceRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "SEQ_Intro", icon = "play", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerSequenceRow", event = "Click", route = "workbench.extension.sequencer.sequence.intro" }]

[nodes.sequencer_camera_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSequencerCameraRow"
classes = ["workbench-list-row"]
props = { text = "Camera_A", icon = "camera", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerCameraRow", event = "Click", route = "workbench.extension.sequencer.track.camera" }]

[nodes.sequencer_event_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionSequencerEventRow"
classes = ["workbench-list-row"]
props = { text = "Event Cues", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerEventRow", event = "Click", route = "workbench.extension.sequencer.track.event" }]

[nodes.sequencer_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSequencerCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "sequencer_center_header" }, { node = "sequencer_timeline_table" }, { node = "sequencer_output" }]

[nodes.sequencer_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionSequencerCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "sequencer_center_title" }, { node = "sequencer_header_fill" }, { node = "sequencer_preview_button" }, { node = "sequencer_validate_button" }]

[nodes.sequencer_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSequencerCenterTitle"
props = { text = "Timeline" }
layout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.sequencer_header_fill]
component = "Container"
control_id = "WorkbenchExtensionSequencerHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.sequencer_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionSequencerPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerPreview", event = "Click", route = "workbench.extension.sequencer.preview" }]

[nodes.sequencer_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionSequencerValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 84.0, preferred = 84.0, max = 94.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerValidate", event = "Click", route = "workbench.extension.sequencer.validate" }]

[nodes.sequencer_timeline_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionSequencerTimelineTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "sequencer_camera_cut_table_row" }, { node = "sequencer_hero_transform_table_row" }, { node = "sequencer_audio_table_row" }, { node = "sequencer_event_cue_table_row" }]

[nodes.sequencer_camera_cut_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSequencerCameraCutTableRow"
classes = ["workbench-table-row"]
props = { text = "Camera Cut", value_text = "0000-0180   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerCameraCutTableRow", event = "Click", route = "workbench.extension.sequencer.timeline.camera_cut" }]

[nodes.sequencer_hero_transform_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSequencerHeroTransformTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Hero Transform", value_text = "0180-0620   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerHeroTransformTableRow", event = "Click", route = "workbench.extension.sequencer.timeline.hero_transform" }]

[nodes.sequencer_audio_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSequencerAudioTableRow"
classes = ["workbench-table-row"]
props = { text = "Audio Theme", value_text = "0000-1460   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerAudioTableRow", event = "Click", route = "workbench.extension.sequencer.timeline.audio" }]

[nodes.sequencer_event_cue_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSequencerEventCueTableRow"
classes = ["workbench-table-row"]
props = { text = "Event Cues", value_text = "0520-0860   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SequencerEventCueTableRow", event = "Click", route = "workbench.extension.sequencer.timeline.event_cue" }]

[nodes.sequencer_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionSequencerOutputRow"
classes = ["workbench-table-row"]
props = { text = "Sequencer", value_text = "SEQ_Intro   12 shots   428 keys", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.sequencer_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionSequencerRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "sequencer_details_title" }, { node = "sequencer_right_content" }]

[nodes.sequencer_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionSequencerRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "sequencer_sequence_dropdown_property_row" }, { node = "sequencer_frame_rate_dropdown_property_row" }, { node = "sequencer_work_range_field_property_row" }]

[nodes.sequencer_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionSequencerDetailsTitle"
props = { text = "Sequence Settings" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.sequencer_sequence_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionSequencerSequenceDropdownPropertyRow"
props = { text = "Sequence" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "sequencer_sequence_dropdown", slot = { name = "value" } }]

[nodes.sequencer_sequence_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionSequencerSequenceDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "SEQ_Intro", value = "SEQ_Intro", options = ["SEQ_Intro", "SEQ_BossReveal", "SEQ_Outro"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SequencerSequenceEdit", event = "Change", route = "workbench.extension.sequencer.sequence.edit" },
  { id = "WorkbenchExtension/SequencerSequenceCommit", event = "Submit", route = "workbench.extension.sequencer.sequence.commit" },
]

[nodes.sequencer_frame_rate_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionSequencerFrameRateDropdownPropertyRow"
props = { text = "Frame Rate" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "sequencer_frame_rate_dropdown", slot = { name = "value" } }]

[nodes.sequencer_frame_rate_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionSequencerFrameRateDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "24 fps", value = "24 fps", options = ["24 fps", "30 fps", "60 fps"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SequencerFrameRateEdit", event = "Change", route = "workbench.extension.sequencer.frame_rate.edit" },
  { id = "WorkbenchExtension/SequencerFrameRateCommit", event = "Submit", route = "workbench.extension.sequencer.frame_rate.commit" },
]

[nodes.sequencer_work_range_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionSequencerWorkRangeFieldPropertyRow"
props = { text = "Work Range" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "sequencer_work_range_field", slot = { name = "value" } }]

[nodes.sequencer_work_range_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionSequencerWorkRangeField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Work Range: 0100-1460" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/SequencerWorkRangeEdit", event = "Change", route = "workbench.extension.sequencer.work_range.edit" },
  { id = "WorkbenchExtension/SequencerWorkRangeCommit", event = "Submit", route = "workbench.extension.sequencer.work_range.commit" },
]
