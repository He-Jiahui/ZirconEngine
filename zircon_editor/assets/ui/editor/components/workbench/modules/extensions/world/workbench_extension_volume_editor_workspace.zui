[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/extensions/world/workbench_extension_volume_editor_workspace.zui"
version = 2
display_name = "Workbench Extension Volume Editor Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionVolumeEditorWorkspace]
root = "volume_editor_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.volume_editor_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionVolumeEditorWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "volume_editor_workspace_main" },
  { node = "volume_editor_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.volume_editor_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "volume_editor_rail_gap" }, { node = "volume_editor_left" }, { node = "volume_editor_center" }, { node = "volume_editor_right_reserve" }]

[nodes.volume_editor_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.volume_editor_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionVolumeEditorRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.volume_editor_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionVolumeEditorLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "volume_editor_title" }, { node = "volume_editor_left_content" }]

[nodes.volume_editor_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionVolumeEditorLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "volume_editor_damage_zone_row" }, { node = "volume_editor_profile_default_row" }, { node = "volume_editor_overlap_player_row" }]

[nodes.volume_editor_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionVolumeEditorTitle"
props = { text = "Volume Editor" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.volume_editor_damage_zone_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionVolumeEditorDamageZoneRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "VOL_DamageZone", icon = "cube", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/VolumeEditorDamageZoneRow", event = "Click", route = "workbench.extension.volume_editor.volume.damage_zone" }]

[nodes.volume_editor_profile_default_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionVolumeEditorProfileDefaultRow"
classes = ["workbench-list-row"]
props = { text = "Profile_Default", icon = "grid", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/VolumeEditorProfileDefaultRow", event = "Click", route = "workbench.extension.volume_editor.profile.default" }]

[nodes.volume_editor_overlap_player_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionVolumeEditorOverlapPlayerRow"
classes = ["workbench-list-row"]
props = { text = "Overlap_Player", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/VolumeEditorOverlapPlayerRow", event = "Click", route = "workbench.extension.volume_editor.overlap.player" }]

[nodes.volume_editor_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionVolumeEditorCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "volume_editor_center_header" }, { node = "volume_editor_overlap_table" }, { node = "volume_editor_output" }]

[nodes.volume_editor_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionVolumeEditorCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "volume_editor_center_title" }, { node = "volume_editor_header_fill" }, { node = "volume_editor_inspect_button" }, { node = "volume_editor_validate_button" }]

[nodes.volume_editor_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionVolumeEditorCenterTitle"
props = { text = "Volume Overlap Workspace" }
layout = { width = { min = 250.0, preferred = 250.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.volume_editor_header_fill]
component = "Container"
control_id = "WorkbenchExtensionVolumeEditorHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.volume_editor_inspect_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionVolumeEditorInspectButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Inspect", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/VolumeEditorInspect", event = "Click", route = "workbench.extension.volume_editor.inspect" }]

[nodes.volume_editor_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionVolumeEditorValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/VolumeEditorValidate", event = "Click", route = "workbench.extension.volume_editor.validate" }]

[nodes.volume_editor_overlap_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionVolumeEditorOverlapTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "volume_editor_bounds_table_row" }, { node = "volume_editor_player_overlap_table_row" }, { node = "volume_editor_damage_rule_table_row" }, { node = "volume_editor_on_enter_event_table_row" }]

[nodes.volume_editor_bounds_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionVolumeEditorBoundsTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Volume", value_text = "Bounds   12 x 8 x 6   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/VolumeEditorBoundsTableRow", event = "Click", route = "workbench.extension.volume_editor.graph.bounds" }]

[nodes.volume_editor_player_overlap_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionVolumeEditorPlayerOverlapTableRow"
classes = ["workbench-table-row"]
props = { text = "Player", value_text = "Overlap   Pawn capsule   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/VolumeEditorPlayerOverlapTableRow", event = "Click", route = "workbench.extension.volume_editor.graph.player_overlap" }]

[nodes.volume_editor_damage_rule_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionVolumeEditorDamageRuleTableRow"
classes = ["workbench-table-row"]
props = { text = "Damage Rule", value_text = "Effect   25 DPS   Priority 10" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/VolumeEditorDamageRuleTableRow", event = "Click", route = "workbench.extension.volume_editor.graph.damage_rule" }]

[nodes.volume_editor_on_enter_event_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionVolumeEditorOnEnterEventTableRow"
classes = ["workbench-table-row"]
props = { text = "OnEnter", value_text = "Event   Generate overlap   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/VolumeEditorOnEnterEventTableRow", event = "Click", route = "workbench.extension.volume_editor.graph.on_enter" }]

[nodes.volume_editor_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionVolumeEditorOutputRow"
classes = ["workbench-table-row"]
props = { text = "Volume Log", value_text = "24 volumes   12 overlaps   1 warning", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.volume_editor_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionVolumeEditorRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "volume_editor_details_title" }, { node = "volume_editor_right_content" }]

[nodes.volume_editor_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionVolumeEditorRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "volume_editor_volume_dropdown_property_row" }, { node = "volume_editor_profile_dropdown_property_row" }, { node = "volume_editor_priority_field_property_row" }]

[nodes.volume_editor_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionVolumeEditorDetailsTitle"
props = { text = "Volume Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.volume_editor_volume_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionVolumeEditorVolumeDropdownPropertyRow"
props = { text = "Volume" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "volume_editor_volume_dropdown", slot = { name = "value" } }]

[nodes.volume_editor_volume_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionVolumeEditorVolumeDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "VOL_DamageZone", value = "VOL_DamageZone", options = ["VOL_DamageZone", "VOL_AudioReverb", "VOL_Checkpoint", "VOL_StreamingGate"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/VolumeEditorVolumeEdit", event = "Change", route = "workbench.extension.volume_editor.volume.edit" },
  { id = "WorkbenchExtension/VolumeEditorVolumeCommit", event = "Submit", route = "workbench.extension.volume_editor.volume.commit" },
]

[nodes.volume_editor_profile_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionVolumeEditorProfileDropdownPropertyRow"
props = { text = "Profile" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "volume_editor_profile_dropdown", slot = { name = "value" } }]

[nodes.volume_editor_profile_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionVolumeEditorProfileDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "Damage", value = "Damage", options = ["Damage", "Reverb", "Checkpoint", "Streaming"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/VolumeEditorProfileEdit", event = "Change", route = "workbench.extension.volume_editor.profile.edit" },
  { id = "WorkbenchExtension/VolumeEditorProfileCommit", event = "Submit", route = "workbench.extension.volume_editor.profile.commit" },
]

[nodes.volume_editor_priority_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionVolumeEditorPriorityFieldPropertyRow"
props = { text = "Priority" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "volume_editor_priority_field", slot = { name = "value" } }]

[nodes.volume_editor_priority_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionVolumeEditorPriorityField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Priority: 10" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/VolumeEditorPriorityEdit", event = "Change", route = "workbench.extension.volume_editor.priority.edit" },
  { id = "WorkbenchExtension/VolumeEditorPriorityCommit", event = "Submit", route = "workbench.extension.volume_editor.priority.commit" },
]
