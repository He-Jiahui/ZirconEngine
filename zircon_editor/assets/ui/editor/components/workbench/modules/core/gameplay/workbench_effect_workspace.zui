[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/core/gameplay/workbench_effect_workspace.zui"
version = 2
display_name = "Workbench Effect Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchEffectWorkspace]
root = "effect_workspace"
default_classes = ["workbench-module-body"]

[nodes.effect_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchModuleEffectWorkspace"
classes = ["workbench-module-body"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "effect_rail_gap" }, { node = "effect_left" }, { node = "effect_center" }, { node = "effect_right" }]

[nodes.effect_rail_gap]
component = "Container"
control_id = "WorkbenchEffectRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.effect_left]
component = "VerticalGroup"
control_id = "WorkbenchEffectLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "effect_title" }, { node = "effect_rules_tab" }, { node = "effect_tags_tab" }, { node = "effect_simulation_tab" }, { node = "effect_asset_search" }, { node = "effect_health_regen_row" }, { node = "effect_damage_fire_row" }, { node = "effect_stack_row" }, { node = "effect_cue_row" }]

[nodes.effect_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchEffectTitle"
classes = ["workbench-section-title"]
props = { text = "Gameplay Effect" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.effect_rules_tab]
component = "WorkbenchTab"
control_id = "WorkbenchEffectRulesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Rules", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectRulesTab", event = "Click", route = "workbench.module.effect.rules" }]

[nodes.effect_tags_tab]
component = "WorkbenchTab"
control_id = "WorkbenchEffectTagsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Tags", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectTagsTab", event = "Click", route = "workbench.module.effect.tags" }]

[nodes.effect_simulation_tab]
component = "WorkbenchTab"
control_id = "WorkbenchEffectSimulationTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Simulation", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectSimulationTab", event = "Click", route = "workbench.module.effect.simulation" }]

[nodes.effect_asset_search]
component = "WorkbenchField"
control_id = "WorkbenchEffectAssetSearch"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "", placeholder = "Search Effects..." }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/EffectSearchEdit", event = "Change", route = "workbench.module.effect.search.edit" },
  { id = "WorkbenchModule/EffectSearchCommit", event = "Submit", route = "workbench.module.effect.search.commit" },
]

[nodes.effect_health_regen_row]
component = "WorkbenchListRow"
control_id = "WorkbenchEffectHealthRegenRow"
classes = ["workbench-list-row"]
props = { text = "GE_HealthRegen", value = "ge_health_regen", selected = true, checked = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectHealthRegenRow", event = "Click", route = "workbench.module.effect.asset.health_regen" }]

[nodes.effect_damage_fire_row]
component = "WorkbenchListRow"
control_id = "WorkbenchEffectDamageFireRow"
classes = ["workbench-list-row"]
props = { text = "GE_DamageFire", value = "ge_damage_fire", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectDamageFireRow", event = "Click", route = "workbench.module.effect.asset.damage_fire" }]

[nodes.effect_stack_row]
component = "WorkbenchListRow"
control_id = "WorkbenchEffectStackRow"
classes = ["workbench-list-row"]
props = { text = "Stacking Rules", value = "effect_stack", selected = true, checked = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectStackRow", event = "Click", route = "workbench.module.effect.stack" }]

[nodes.effect_cue_row]
component = "WorkbenchListRow"
control_id = "WorkbenchEffectCueRow"
classes = ["workbench-list-row"]
props = { text = "Gameplay Cues", value = "effect_cues", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectCueRow", event = "Click", route = "workbench.module.effect.cues" }]

[nodes.effect_center]
component = "VerticalGroup"
control_id = "WorkbenchEffectCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "effect_center_header" }, { node = "effect_canvas" }, { node = "effect_output" }]

[nodes.effect_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchEffectCenterHeader"
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 38.0, preferred = 38.0, max = 40.0, stretch = "Fixed" } }
children = [{ node = "effect_center_title" }, { node = "effect_header_fill" }, { node = "effect_apply_button" }]

[nodes.effect_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchEffectCenterTitle"
classes = ["workbench-section-title"]
props = { text = "GE_HealthRegen" }
layout = { width = { min = 180.0, preferred = 180.0, max = 240.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.effect_header_fill]
component = "Container"
control_id = "WorkbenchEffectHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.effect_apply_button]
component = "WorkbenchButton"
control_id = "WorkbenchEffectApplyButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Apply", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 76.0, preferred = 76.0, max = 86.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectApply", event = "Click", route = "workbench.module.effect.apply" }]

[nodes.effect_canvas]
component = "VerticalGroup"
control_id = "WorkbenchEffectCanvas"
classes = ["workbench-panel", "workbench-module-canvas"]
props = {}
layout = { container = { kind = "VerticalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "effect_duration_row" }, { node = "effect_period_row" }, { node = "effect_policy_row" }, { node = "effect_mod_table" }, { node = "effect_mod_health_row" }, { node = "effect_mod_healing_row" }, { node = "effect_mod_cap_row" }, { node = "effect_graph_title" }, { node = "effect_graph_row" }]

[nodes.effect_duration_row]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchEffectDurationRow"
classes = ["workbench-property-row"]
props = { text = "Duration", value = "10.0 s" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectDurationRow", event = "Click", route = "workbench.module.effect.duration" }]

[nodes.effect_period_row]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchEffectPeriodRow"
classes = ["workbench-property-row"]
props = { text = "Period", value = "1.0 s" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectPeriodRow", event = "Click", route = "workbench.module.effect.period" }]

[nodes.effect_policy_row]
component = "WorkbenchDropdown"
control_id = "WorkbenchEffectPolicyDropdown"
classes = ["workbench-field", "workbench-dropdown"]
props = { value = "has_duration", value_text = "Has Duration", options = ["instant", "has_duration", "infinite"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/EffectPolicyEdit", event = "Change", route = "workbench.module.effect.policy.edit" },
  { id = "WorkbenchModule/EffectPolicyCommit", event = "Submit", route = "workbench.module.effect.policy.commit" },
]

[nodes.effect_mod_table]
component = "WorkbenchTableRow"
control_id = "WorkbenchEffectModifierTable"
classes = ["workbench-table-row", "workbench-table-header"]
props = { text = "Attribute     Op       Value       Source", value = "modifier", options = ["Health", "Add", "+5.0", "Periodic"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }

[nodes.effect_mod_health_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchEffectModifierHealthRow"
classes = ["workbench-table-row"]
props = { text = "HealthRegen     Health        Additive       Scalable Float", value = "health_regen", options = ["HealthRegen", "Health", "Additive", "Scalable Float"], selected = true, checked = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectModifierHealth", event = "Click", route = "workbench.module.effect.modifier.health_regen" }]

[nodes.effect_mod_healing_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchEffectModifierHealingRow"
classes = ["workbench-table-row"]
props = { text = "IncomingHealing Healing       Multiply       Scalable Float", value = "incoming_healing", options = ["IncomingHealing", "Healing", "Multiply", "Scalable Float"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectModifierHealing", event = "Click", route = "workbench.module.effect.modifier.incoming_healing" }]

[nodes.effect_mod_cap_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchEffectModifierCapRow"
classes = ["workbench-table-row"]
props = { text = "MaxHealthCap    Max Health    Additive       Captured Attribute", value = "max_health_cap", options = ["MaxHealthCap", "Max Health", "Additive", "Captured Attribute"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectModifierCap", event = "Click", route = "workbench.module.effect.modifier.max_health_cap" }]

[nodes.effect_graph_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchEffectGraphTitle"
classes = ["workbench-section-title"]
props = { text = "Dependency Graph" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.effect_graph_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchEffectGraphRow"
classes = ["workbench-table-row"]
props = { text = "Source HealthRegen  ->  Health Attribute  ->  Clamp Health", value = "effect_graph", options = ["Source HealthRegen", "Health Attribute", "Clamp Health"], selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectGraphSelect", event = "Click", route = "workbench.module.effect.graph.select" }]

[nodes.effect_output]
component = "WorkbenchListRow"
control_id = "WorkbenchEffectOutputRow"
classes = ["workbench-list-row"]
props = { text = "Simulation Output: +50 health over 10 seconds", value = "effect_output" }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectOutput", event = "Click", route = "workbench.module.effect.output" }]

[nodes.effect_right]
component = "VerticalGroup"
control_id = "WorkbenchEffectRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "effect_details_title" }, { node = "effect_name_field" }, { node = "effect_tag_field" }, { node = "effect_stack_field" }, { node = "effect_magnitude_field" }, { node = "effect_attribute_preview_row" }]

[nodes.effect_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchEffectDetailsTitle"
classes = ["workbench-section-title"]
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.effect_name_field]
component = "WorkbenchField"
control_id = "WorkbenchEffectNameField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "GE_HealthRegen" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/EffectNameEdit", event = "Change", route = "workbench.module.effect.name.edit" },
  { id = "WorkbenchModule/EffectNameCommit", event = "Submit", route = "workbench.module.effect.name.commit" },
]

[nodes.effect_tag_field]
component = "WorkbenchField"
control_id = "WorkbenchEffectTagField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Effect.Health.Regen" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/EffectTagEdit", event = "Change", route = "workbench.module.effect.tag.edit" },
  { id = "WorkbenchModule/EffectTagCommit", event = "Submit", route = "workbench.module.effect.tag.commit" },
]

[nodes.effect_stack_field]
component = "WorkbenchField"
control_id = "WorkbenchEffectStackField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Aggregate by Source" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/EffectStackEdit", event = "Change", route = "workbench.module.effect.stack.edit" },
  { id = "WorkbenchModule/EffectStackCommit", event = "Submit", route = "workbench.module.effect.stack.commit" },
]

[nodes.effect_magnitude_field]
component = "WorkbenchField"
control_id = "WorkbenchEffectMagnitudeField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Magnitude: 10.0" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/EffectMagnitudeEdit", event = "Change", route = "workbench.module.effect.magnitude.edit" },
  { id = "WorkbenchModule/EffectMagnitudeCommit", event = "Submit", route = "workbench.module.effect.magnitude.commit" },
]

[nodes.effect_attribute_preview_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchEffectAttributePreviewRow"
classes = ["workbench-table-row"]
props = { text = "Preview Level 1       Health +10.0", value = "attribute_preview", options = ["Preview Level 1", "Health +10.0"], selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectAttributePreview", event = "Click", route = "workbench.module.effect.attribute_preview" }]
