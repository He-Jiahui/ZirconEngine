[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/core/gameplay/workbench_ability_workspace.zui"
version = 2
display_name = "Workbench Ability Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []
[components.WorkbenchAbilityWorkspace]
root = "ability_workspace"
default_classes = ["workbench-module-body"]

[nodes.ability_workspace]
component = "Overlay"
control_id = "WorkbenchModuleAbilityWorkspace"
classes = ["workbench-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "ability_workspace_main" },
  { node = "ability_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.ability_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_rail_gap" }, { node = "ability_left" }, { node = "ability_center" }, { node = "ability_right_reserve" }]

[nodes.ability_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.ability_rail_gap]
component = "Container"
control_id = "WorkbenchAbilityRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.ability_left]
component = "VerticalGroup"
control_id = "WorkbenchAbilityLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_title" }, { node = "ability_left_content" }]

[nodes.ability_left_content]
component = "ScrollableBox"
control_id = "WorkbenchAbilityLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_task_row_01" }, { node = "ability_task_row_02" }, { node = "ability_asset_row" }]

[nodes.ability_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityTitle"
props = { text = "Gameplay Ability" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.ability_task_row_01]
component = "WorkbenchListRow"
control_id = "WorkbenchAbilityTaskActivateRow"
classes = ["workbench-list-row"]
props = { text = "Activate Ability", icon = "play" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityTaskActivate", event = "Click", route = "workbench.module.ability.task.activate" }]

[nodes.ability_task_row_02]
component = "WorkbenchListRow"
control_id = "WorkbenchAbilityTaskCostRow"
classes = ["workbench-list-row"]
props = { text = "Apply Cost", icon = "gear" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityTaskCost", event = "Click", route = "workbench.module.ability.task.cost" }]

[nodes.ability_asset_row]
component = "WorkbenchListRow"
control_id = "WorkbenchAbilityAssetRow"
classes = ["workbench-list-row"]
props = { text = "GA_DashAttack", icon = "play" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityAssetDash", event = "Click", route = "workbench.module.ability.asset.dash" }]

[nodes.ability_center]
component = "VerticalGroup"
control_id = "WorkbenchAbilityCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_center_header" }, { node = "ability_graph_canvas" }, { node = "ability_output" }]

[nodes.ability_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchAbilityCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "ability_center_title" }, { node = "ability_header_fill" }, { node = "ability_playtest_button" }]

[nodes.ability_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityCenterTitle"
props = { text = "Ability Graph" }
layout = { width = { min = 160.0, preferred = 160.0, max = 180.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.ability_header_fill]
component = "Container"
control_id = "WorkbenchAbilityHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.ability_playtest_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityPlaytestButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Playtest", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 82.0, preferred = 82.0, max = 92.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityPlaytest", event = "Click", route = "workbench.module.ability.playtest" }]

[nodes.ability_graph_canvas]
component = "ScrollableBox"
control_id = "WorkbenchAbilityGraphCanvas"
classes = ["workbench-panel", "workbench-module-graph"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.regular", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_phase_table" }, { node = "ability_phase_row_01" }, { node = "ability_phase_row_02" }, { node = "ability_graph_row" }]

[nodes.ability_phase_table]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityPhaseTable"
props = { text = "Phase Matrix" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.ability_phase_row_01]
component = "WorkbenchTableRow"
control_id = "WorkbenchAbilityPhaseActivateRow"
classes = ["workbench-table-row"]
props = { text = "Activation", value_text = "Activate Ability   Server   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityPhaseActivate", event = "Click", route = "workbench.module.ability.phase.activate" }]

[nodes.ability_phase_row_02]
component = "WorkbenchTableRow"
control_id = "WorkbenchAbilityPhaseCostRow"
classes = ["workbench-table-row"]
props = { text = "Cost", value_text = "GE_DashAttack_Cost   Predicted   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityPhaseCost", event = "Click", route = "workbench.module.ability.phase.cost" }]

[nodes.ability_graph_row]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchAbilityGraphRow"
classes = ["workbench-property-row"]
props = { text = "Graph", value_text = "Activate -> Cost -> Montage -> Damage -> End" }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityGraphSelect", event = "Click", route = "workbench.module.ability.graph.select" }]

[nodes.ability_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchAbilityOutputRow"
classes = ["workbench-table-row"]
props = { text = "Timeline", value_text = "1.22s Ability Activated   OK   GA_DashAttack", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.ability_right]
component = "VerticalGroup"
control_id = "WorkbenchAbilityRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_details_title" }, { node = "ability_right_content" }]

[nodes.ability_right_content]
component = "ScrollableBox"
control_id = "WorkbenchAbilityRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "ability_name_property_row" }, { node = "ability_net_policy_property_row" }, { node = "ability_cooldown_property_row" }, { node = "ability_animation_tools_button" }]

[nodes.ability_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchAbilityDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.ability_name_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchAbilityNamePropertyRow"
props = { text = "Name" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "ability_name_field", slot = { name = "value" } }]

[nodes.ability_name_field]
component = "WorkbenchField"
control_id = "WorkbenchAbilityNameField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "GA_DashAttack" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/AbilityNameEdit", event = "Change", route = "workbench.module.ability.name.edit" },
  { id = "WorkbenchModule/AbilityNameCommit", event = "Submit", route = "workbench.module.ability.name.commit" },
]

[nodes.ability_net_policy_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchAbilityNetPolicyPropertyRow"
props = { text = "Net Policy" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "ability_net_policy_dropdown", slot = { name = "value" } }]

[nodes.ability_net_policy_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchAbilityNetPolicyDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value = "server_initiated", value_text = "Server Initiated", options = ["server_initiated|label=Server Initiated", "client_predicted|label=Client Predicted", "local_only|label=Local Only"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/AbilityNetPolicyEdit", event = "Change", route = "workbench.module.ability.net_policy.edit" },
  { id = "WorkbenchModule/AbilityNetPolicyCommit", event = "Submit", route = "workbench.module.ability.net_policy.commit" },
]

[nodes.ability_cooldown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchAbilityCooldownPropertyRow"
props = { text = "Cooldown" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "ability_cooldown_field", slot = { name = "value" } }]

[nodes.ability_cooldown_field]
component = "WorkbenchField"
control_id = "WorkbenchAbilityCooldownField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "4.00s" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/AbilityCooldownEdit", event = "Change", route = "workbench.module.ability.cooldown.edit" },
  { id = "WorkbenchModule/AbilityCooldownCommit", event = "Submit", route = "workbench.module.ability.cooldown.commit" },
]

[nodes.ability_animation_tools_button]
component = "WorkbenchButton"
control_id = "WorkbenchAbilityAnimationTools"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Animation Tools", icon = "more", button_variant = "outlined", button_color = "secondary" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/AbilityAnimationToolsOpen", event = "Click", route = "workbench.module.ability.animation_tools.open" }]
