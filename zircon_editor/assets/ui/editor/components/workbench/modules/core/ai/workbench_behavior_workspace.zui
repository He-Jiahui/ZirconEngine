[asset]
kind = "component"
id = "res://ui/editor/components/workbench/modules/core/ai/workbench_behavior_workspace.zui"
version = 2
display_name = "Workbench Behavior Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchBehaviorWorkspace]
root = "behavior_workspace"
default_classes = ["workbench-module-body"]

[nodes.behavior_workspace]
component = "Overlay"
control_id = "WorkbenchModuleBehaviorWorkspace"
classes = ["workbench-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "behavior_workspace_main" },
  { node = "behavior_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.behavior_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "behavior_rail_gap" }, { node = "behavior_left" }, { node = "behavior_center" }, { node = "behavior_right_reserve" }]

[nodes.behavior_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.behavior_rail_gap]
component = "Container"
control_id = "WorkbenchBehaviorRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.behavior_left]
component = "VerticalGroup"
control_id = "WorkbenchBehaviorLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "behavior_title" }, { node = "behavior_left_content" }]

[nodes.behavior_left_content]
component = "ScrollableBox"
control_id = "WorkbenchBehaviorLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "behavior_selector_row" }, { node = "behavior_attack_row" }]

[nodes.behavior_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchBehaviorTitle"
classes = ["workbench-section-title"]
props = { text = "Behavior Tree" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.behavior_selector_row]
component = "WorkbenchListRow"
control_id = "WorkbenchBehaviorSelectorRow"
classes = ["workbench-list-row"]
props = { text = "Selector: Combat Root", value = "selector" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/BehaviorSelectorRow", event = "Click", route = "workbench.module.behavior.selector" }]

[nodes.behavior_attack_row]
component = "WorkbenchListRow"
control_id = "WorkbenchBehaviorAttackRow"
classes = ["workbench-list-row"]
props = { text = "Task: Attack Target", value = "attack" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/BehaviorAttackRow", event = "Click", route = "workbench.module.behavior.attack" }]

[nodes.behavior_center]
component = "VerticalGroup"
control_id = "WorkbenchBehaviorCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "behavior_center_header" }, { node = "behavior_graph_canvas" }, { node = "behavior_output" }]

[nodes.behavior_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchBehaviorCenterHeader"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 38.0, preferred = 38.0, max = 40.0, stretch = "Fixed" } }
children = [{ node = "behavior_center_title" }, { node = "behavior_header_fill" }, { node = "behavior_validate_button" }]

[nodes.behavior_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchBehaviorCenterTitle"
classes = ["workbench-section-title"]
props = { text = "BT_Enemy" }
layout = { width = { min = 180.0, preferred = 180.0, max = 240.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.behavior_header_fill]
component = "Container"
control_id = "WorkbenchBehaviorHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.behavior_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchBehaviorValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "filled", button_color = "accent" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/BehaviorValidate", event = "Click", route = "workbench.module.behavior.validate" }]

[nodes.behavior_graph_canvas]
component = "ScrollableBox"
control_id = "WorkbenchBehaviorGraphCanvas"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.regular", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "behavior_node_row_01" }, { node = "behavior_node_row_02" }, { node = "behavior_node_row_03" }]

[nodes.behavior_node_row_01]
component = "WorkbenchTableRow"
control_id = "WorkbenchBehaviorNodeRow01"
classes = ["workbench-table-row"]
props = { text = "Selector        Success      Running", value = "node_01", options = ["Selector", "Success", "Running", "root"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/BehaviorNodeSelector", event = "Click", route = "workbench.module.behavior.node.selector" }]

[nodes.behavior_node_row_02]
component = "WorkbenchTableRow"
control_id = "WorkbenchBehaviorNodeRow02"
classes = ["workbench-table-row"]
props = { text = "Sequence        Attack       Pending", value = "node_02", options = ["Sequence", "Attack", "Pending", "child"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/BehaviorNodeAttack", event = "Click", route = "workbench.module.behavior.node.attack" }]

[nodes.behavior_node_row_03]
component = "WorkbenchTableRow"
control_id = "WorkbenchBehaviorNodeRow03"
classes = ["workbench-table-row"]
props = { text = "Decorator       Cooldown     0.8 s", value = "node_03", options = ["Decorator", "Cooldown", "0.8 s", "guard"] }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/BehaviorNodeCooldown", event = "Click", route = "workbench.module.behavior.node.cooldown" }]

[nodes.behavior_output]
component = "WorkbenchListRow"
control_id = "WorkbenchBehaviorOutputRow"
classes = ["workbench-list-row"]
props = { text = "Runtime Trace: branch changed to Attack", value = "behavior_output", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }

[nodes.behavior_right]
component = "VerticalGroup"
control_id = "WorkbenchBehaviorRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "behavior_details_title" }, { node = "behavior_right_content" }]

[nodes.behavior_right_content]
component = "ScrollableBox"
control_id = "WorkbenchBehaviorRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "behavior_blackboard_property_row" }, { node = "behavior_ai_property_row" }, { node = "behavior_state_property_row" }]

[nodes.behavior_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchBehaviorDetailsTitle"
classes = ["workbench-section-title"]
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.behavior_blackboard_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchBehaviorBlackboardPropertyRow"
props = { text = "Blackboard" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "behavior_blackboard_field", slot = { name = "value" } }]

[nodes.behavior_blackboard_field]
component = "WorkbenchField"
control_id = "WorkbenchBehaviorBlackboardField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "BB_Enemy" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/BehaviorBlackboardEdit", event = "Change", route = "workbench.module.behavior.blackboard.edit" },
  { id = "WorkbenchModule/BehaviorBlackboardCommit", event = "Submit", route = "workbench.module.behavior.blackboard.commit" },
]

[nodes.behavior_ai_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchBehaviorAiPropertyRow"
props = { text = "AI Controller" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "behavior_ai_field", slot = { name = "value" } }]

[nodes.behavior_ai_field]
component = "WorkbenchField"
control_id = "WorkbenchBehaviorAiField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "AIController_Enemy" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/BehaviorAiEdit", event = "Change", route = "workbench.module.behavior.ai.edit" },
  { id = "WorkbenchModule/BehaviorAiCommit", event = "Submit", route = "workbench.module.behavior.ai.commit" },
]

[nodes.behavior_state_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchBehaviorStatePropertyRow"
props = { text = "Preview State" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "behavior_state_field", slot = { name = "value" } }]

[nodes.behavior_state_field]
component = "WorkbenchField"
control_id = "WorkbenchBehaviorStateField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Running" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/BehaviorStateEdit", event = "Change", route = "workbench.module.behavior.state.edit" },
  { id = "WorkbenchModule/BehaviorStateCommit", event = "Submit", route = "workbench.module.behavior.state.commit" },
]
