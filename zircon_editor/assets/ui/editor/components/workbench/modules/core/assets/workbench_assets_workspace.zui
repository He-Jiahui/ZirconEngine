component = "WorkbenchButton"
control_id = "WorkbenchAssetsSaveDataButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Save Data", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/SaveDataOpen", event = "Click", route = "workbench.extension.save_data.open" }]
