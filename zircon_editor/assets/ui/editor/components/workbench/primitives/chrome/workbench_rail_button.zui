[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/chrome/workbench_rail_button.zui"
version = 2
display_name = "Workbench Rail Button"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchRailButton]
root = "root"
default_classes = ["workbench-rail-button", "workbench-primitive"]

[nodes.root]
component = "IconButton"
control_id = "WorkbenchRailButtonRoot"
classes = ["workbench-rail-button"]
props = { icon = "zircon_editor_shell/activity/play.svg", text = "", label = "Activity", button_variant = "text", button_color = "secondary", button_size = "small", button_interaction_state = "normal", icon_placement = "icon_only", selected = false, focused = false, hovered = false, pressed = false, disabled = false, background_color = "transparent", hover_background_color = "$editor.surface.hover", pressed_background_color = "$editor.surface.3", selected_background_color = "$editor.surface.selected", selected_border_color = "$editor.accent", disabled_background_color = "$editor.surface.disabled", border_color = "transparent", focus_border_color = "$editor.focus.ring", disabled_border_color = "$editor.border.disabled", icon_color = "$editor.text.secondary", selected_icon_color = "$editor.accent", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", layout_padding_left = "$editor.density.gap.small", layout_padding_right = "$editor.density.gap.small", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_min_width = "$editor.control.height.compact", layout_min_height = "$editor.control.height.compact", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
