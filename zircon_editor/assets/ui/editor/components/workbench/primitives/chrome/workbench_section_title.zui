[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui"
version = 2
display_name = "Workbench Section Title"

[imports]
widgets = []
styles = []

[components.WorkbenchSectionTitle]
root = "root"
default_classes = ["workbench-section-title", "workbench-primitive"]

[nodes.root]
component = "Label"
control_id = "WorkbenchSectionTitleRoot"
classes = ["workbench-section-title"]
props = { text = "Section", font_size = 13.0, font_weight = 700, text_tone = "primary" }
layout = { width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 26.0, max = 32.0, stretch = "Fixed" } }
