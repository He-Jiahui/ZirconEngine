[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui"
version = 2
display_name = "Workbench Section Title"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchSectionTitle]
root = "root"
default_classes = ["workbench-section-title", "workbench-primitive"]

[nodes.root]
component = "Label"
control_id = "WorkbenchSectionTitleRoot"
classes = ["workbench-section-title"]
props = { text = "Section", component_variant = "section-title", font_size = "$editor.typography.body.size", font_weight = "$editor.typography.strong.weight", text_tone = "primary" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.compact", stretch = "Fixed" } }
