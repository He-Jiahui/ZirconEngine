[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/chrome/workbench_axis_value_field.zui"
version = 2
display_name = "Workbench Axis Value Field"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchAxisValueField]
root = "root"
default_classes = ["workbench-field", "workbench-axis-value-field", "workbench-primitive"]

[nodes.root]
component = "InputField"
control_id = "WorkbenchAxisValueFieldRoot"
classes = ["workbench-field", "workbench-axis-value-field"]
props = { value = "0.0", placeholder = "0", validation_level = "normal", focused = false, hovered = false, disabled = false, editable_text = true, background_color = "$editor.surface.recessed", hover_background_color = "$editor.surface.hover", pressed_background_color = "$editor.surface.3", focused_background_color = "$editor.surface.recessed", disabled_background_color = "$editor.surface.disabled", border_color = "$editor.separator.soft", hover_border_color = "$editor.border", focus_border_color = "$editor.accent", disabled_border_color = "$editor.border.disabled", foreground_color = "$editor.text.primary", placeholder_color = "$editor.text.secondary", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_min_height = "$editor.control.height.dense", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = 54.0, preferred = 62.0, max = 72.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.compact", stretch = "Fixed" } }
