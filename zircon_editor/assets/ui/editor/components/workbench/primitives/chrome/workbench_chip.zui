[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/chrome/workbench_chip.zui"
version = 2
display_name = "Workbench Chip"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchChip]
root = "root"
default_classes = ["workbench-chip", "workbench-primitive"]

[nodes.root]
component = "Label"
control_id = "WorkbenchChipRoot"
classes = ["workbench-chip"]
props = { text = "Chip", component_variant = "chip", font_size = "$editor.typography.body.size", text_tone = "primary", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small" }
layout = { width = { min = 40.0, preferred = 80.0, max = 160.0, stretch = "Fixed" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
