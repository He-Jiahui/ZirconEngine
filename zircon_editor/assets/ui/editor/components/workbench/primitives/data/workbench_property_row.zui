[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui"
version = 2
display_name = "Workbench Property Row"

[imports]
widgets = []
styles = []

[components.WorkbenchPropertyRow]
root = "root"
default_classes = ["workbench-property-row", "workbench-primitive"]

[nodes.root]
component = "PropertyRow"
control_id = "WorkbenchPropertyRowRoot"
classes = ["workbench-property-row"]
props = { text = "Property", value = "Value", layout_padding_left = 8.0, layout_padding_right = 8.0, layout_spacing = 4.0, layout_min_height = 28.0 }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
