[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui"
version = 2
display_name = "Workbench Property Row"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchPropertyRow]
root = "root"
default_classes = ["workbench-property-row", "workbench-primitive"]

[nodes.root]
component = "PropertyRow"
control_id = "WorkbenchPropertyRowRoot"
classes = ["workbench-property-row"]
props = { text = "Property", value = "Value", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_spacing = "$editor.density.gap.small", layout_min_height = "$editor.control.height.dense" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
