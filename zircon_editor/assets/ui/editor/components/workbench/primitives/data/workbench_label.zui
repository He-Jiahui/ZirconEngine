[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/data/workbench_label.zui"
version = 2
display_name = "Workbench Label"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchLabel]
root = "root"
default_classes = ["workbench-label", "workbench-primitive"]

[nodes.root]
component = "Label"
control_id = "WorkbenchLabelRoot"
classes = ["workbench-label"]
props = { text = "Label", font_size = "$editor.typography.body.size", font_weight = "$editor.typography.medium.weight", text_tone = "primary", foreground_color = "$editor.text.primary", layout_padding_top = "$editor.density.gap.xsmall", layout_padding_bottom = "$editor.density.gap.xsmall" }
layout = { width = { stretch = "Stretch" }, height = { min = 20.0, preferred = 22.0, max = 28.0, stretch = "Fixed" } }
