[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/data/workbench_list_row.zui"
version = 2
display_name = "Workbench List Row"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchListRow]
root = "root"
default_classes = ["workbench-list-row", "workbench-primitive"]

[nodes.root]
component = "ListRow"
control_id = "WorkbenchListRowRoot"
classes = ["workbench-list-row"]
props = { text = "List item", value = "item", selected = false, focused = false, hovered = false, pressed = false, background_color = "$editor.surface.1", hover_background_color = "$editor.surface.hover", selected_background_color = "$editor.surface.selected", selected_hover_background_color = "$editor.accent.soft", pressed_background_color = "$editor.surface.3", disabled_background_color = "$editor.surface.disabled", separator_color = "$editor.separator.soft", focus_border_color = "$editor.accent", foreground_color = "$editor.text.primary", secondary_foreground_color = "$editor.text.secondary", selected_foreground_color = "$editor.text.primary", disabled_foreground_color = "$editor.text.disabled", icon_color = "$editor.text.secondary", selected_icon_color = "$editor.text.primary", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.small", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_spacing = "$editor.density.gap.small", layout_icon_size = "$editor.density.gap.large", layout_action_gap = "$editor.density.gap.medium", layout_min_height = "$editor.control.height.dense", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
