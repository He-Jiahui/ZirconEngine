[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/data/workbench_divider.zui"
version = 2
display_name = "Workbench Divider"

[imports]
widgets = []
styles = []

[components.WorkbenchDivider]
root = "root"
default_classes = ["workbench-divider", "workbench-primitive"]

[nodes.root]
component = "Divider"
control_id = "WorkbenchDividerRoot"
classes = ["workbench-divider"]
props = { orientation = "horizontal", variant = "fullWidth", separator_color = "#2b343a", thickness = 1.0, layout_min_height = 1.0 }
layout = { width = { stretch = "Stretch" }, height = { min = 1.0, preferred = 1.0, max = 6.0, stretch = "Fixed" } }
