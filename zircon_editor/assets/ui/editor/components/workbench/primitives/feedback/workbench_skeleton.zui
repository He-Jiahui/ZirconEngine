[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_skeleton.zui"
version = 2
display_name = "Workbench Skeleton"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchSkeleton]
root = "root"
default_classes = ["workbench-skeleton", "workbench-primitive"]

[nodes.root]
component = "Skeleton"
control_id = "WorkbenchSkeletonRoot"
classes = ["workbench-skeleton"]
props = { variant = "rounded", animation = "pulse", loading = true, background_color = "$editor.surface.3", disabled_background_color = "$editor.surface.disabled", highlight_color = "$editor.border", disabled_highlight_color = "$editor.border.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.small" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.typography.title.size", preferred = "$editor.typography.title.size", max = "$editor.control.height.dense", stretch = "Fixed" } }
