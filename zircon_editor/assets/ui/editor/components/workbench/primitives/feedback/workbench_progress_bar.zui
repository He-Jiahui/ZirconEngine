[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_progress_bar.zui"
version = 2
display_name = "Workbench Progress Bar"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchProgressBar]
root = "root"
default_classes = ["workbench-progress-bar", "workbench-primitive"]

[nodes.root]
component = "Progress"
control_id = "WorkbenchProgressBarRoot"
pixel_snapping = "disabled"
classes = ["workbench-progress-bar"]
props = { value = 64.0, value_percent = 0.64, min = 0.0, max = 100.0, variant = "linear", label_text = "Progress", show_label = false, validation_level = "normal", track_color = "$editor.surface.recessed", disabled_track_color = "$editor.surface.disabled", fill_color = "$editor.accent", disabled_fill_color = "$editor.text.disabled", warning_color = "$editor.semantic.warning", error_color = "$editor.semantic.error", border_color = "$editor.separator.soft", disabled_border_color = "$editor.border.disabled", label_color = "$editor.text.primary", disabled_foreground_color = "$editor.text.disabled", track_height = "$editor.density.gap.small", horizontal_inset = "$editor.density.gap.medium", label_gap = "$editor.density.gap.small", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.small", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
