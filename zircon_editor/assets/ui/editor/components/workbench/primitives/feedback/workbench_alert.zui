[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_alert.zui"
version = 2
display_name = "Workbench Alert"

[imports]
widgets = []
styles = []

[components.WorkbenchAlert]
root = "root"
default_classes = ["workbench-alert", "workbench-primitive"]

[nodes.root]
component = "Alert"
control_id = "WorkbenchAlertRoot"
classes = ["workbench-alert"]
props = { text = "Unsaved scene changes", severity = "warning", variant = "outlined", color = "warning", icon = "warning", show_icon = true, closeText = "Close", layout_offset_x = 0.0, layout_offset_y = 0.0, status_mark_size = 18.0, status_mark_color = "#c99721", action_color = "#d2a331" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 32.0, max = 38.0, stretch = "Fixed" } }
