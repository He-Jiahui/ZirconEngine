[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_command_palette.zui"
version = 2
display_name = "Workbench Command Palette"

[imports]
widgets = []
styles = [
  "res://ui/editor/theme/editor_tokens.zui",
]

[components.WorkbenchCommandPalette]
root = "root"
default_classes = ["workbench-command-palette", "workbench-primitive"]

[nodes.root]
component = "CommandPalette"
control_id = "WorkbenchCommandPaletteRoot"
classes = ["workbench-command-palette"]
props = { open = true, popup_open = true, query = "", placeholder = "Search commands", commands = ["open_scene|label=Open Scene|shortcut=Ctrl+O", "build_project|label=Build Project|shortcut=Ctrl+B", "toggle_console|label=Toggle Console|shortcut=Ctrl+`"], filtered_commands = ["open_scene", "build_project", "toggle_console"], recent_commands = ["build_project"], selected_command_id = "build_project", focused_index = 1, keyboard_navigation = true, empty_text = "No commands found", command_source = "workbench", background_color = "$editor.popup", border_color = "$editor.border", search_background_color = "$editor.surface.recessed", search_border_color = "$editor.accent", foreground_color = "$editor.text.primary", placeholder_color = "$editor.text.secondary", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.panel", search_radius = "$editor.control.radius.small", panel_padding_x = "$editor.density.gap.large", search_top = "$editor.density.gap.medium", search_height = "$editor.control.height.compact", search_text_inset_x = "$editor.density.gap.medium", list_gap = "$editor.density.gap.medium", row_inset_x = "$editor.density.gap.medium", row_height = "$editor.density.row_height", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", placement = "top", popup_anchor_x = 420.0, popup_anchor_y = 72.0, popup_anchor_width = "$editor.density.command_palette.preferred_width", popup_anchor_height = 0.0, anchor_origin_vertical = "top", anchor_origin_horizontal = "center", transform_origin_vertical = "top", transform_origin_horizontal = "center", popup_offset_x = 0.0, popup_offset_y = 24.0, disable_auto_focus = false, disable_enforce_focus = false, disable_restore_focus = false, disable_escape_key_down = false, close_on_backdrop_click = true, keep_mounted = false, aria_modal = true, aria_labelledby = "Workbench command palette", aria_describedby = "Search and run editor commands", z_index = 1500, disable_portal = false, portal_layer = "command-palette", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.density.command_palette.min_width", preferred = "$editor.density.command_palette.preferred_width", max = "$editor.density.command_palette.max_width", stretch = "Fixed" }, height = { min = "$editor.density.command_palette.min_height", preferred = "$editor.density.command_palette.preferred_height", max = "$editor.density.command_palette.max_height", stretch = "Fixed" } }
