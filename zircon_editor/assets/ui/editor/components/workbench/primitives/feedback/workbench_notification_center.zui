[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_notification_center.zui"
version = 2
display_name = "Workbench Notification Center"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchNotificationCenter]
root = "root"
default_classes = ["workbench-notification-center", "workbench-primitive"]

[nodes.root]
component = "NotificationCenter"
control_id = "WorkbenchNotificationCenterRoot"
classes = ["workbench-notification-center"]
props = { open = false, popup_open = false, title = "Notifications", notification_generation = 0, unread_count = 2, overflow_count = 0, notifications = ["build|title=Build failed|message=Shader compile error|severity=error|unread=true", "asset|title=Asset import complete|message=StoneWall.mesh ready|severity=success|unread=true", "source|title=Source control synced|message=No local conflicts|severity=info|unread=false"], selected_notification_id = "build", focused_index = -1, visible_limit = 4, empty_text = "No notifications", panel_surface_color = "$editor.popup", panel_border_color = "$editor.border", row_surface_color = "$editor.surface.1", row_unread_surface_color = "$editor.surface.selected", row_disabled_surface_color = "$editor.surface.disabled", row_border_color = "$editor.separator.soft", header_text_color = "$editor.text.primary", muted_text_color = "$editor.text.secondary", accent_color = "$editor.accent", success_color = "$editor.semantic.success", warning_color = "$editor.semantic.warning", error_color = "$editor.semantic.error", panel_border_width = "$editor.control.border_width", panel_radius = "$editor.control.radius.panel", row_radius = "$editor.control.radius.small", mark_radius = "$editor.control.border_width", header_font_size = "$editor.typography.body.size", title_font_size = "$editor.typography.overlay.size", message_font_size = "$editor.typography.caption.size", typography_line_height_ratio = "$editor.typography.line_height", placement = "bottom-end", anchor_origin_vertical = "top", anchor_origin_horizontal = "right", transform_origin_vertical = "top", transform_origin_horizontal = "right", popup_offset_x = 0.0, popup_offset_y = "$editor.density.gap.small", disable_auto_focus = false, disable_enforce_focus = false, disable_restore_focus = false, disable_escape_key_down = false, close_on_backdrop_click = true, keep_mounted = false, aria_modal = false, aria_labelledby = "Workbench notification center", aria_describedby = "Editor notifications", z_index = 1490, disable_portal = false, portal_layer = "notification-center", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.density.notification_panel.min_width", preferred = "$editor.density.notification_panel.preferred_width", max = "$editor.density.notification_panel.max_width", stretch = "Fixed" }, height = { min = "$editor.density.notification_panel.min_height", preferred = "$editor.density.notification_panel.preferred_height", max = "$editor.density.notification_panel.max_height", stretch = "Fixed" } }
