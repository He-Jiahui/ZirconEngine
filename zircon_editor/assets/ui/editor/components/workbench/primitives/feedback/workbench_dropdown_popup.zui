[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_dropdown_popup.zui"
version = 2
display_name = "Workbench Dropdown Popup"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchDropdownPopup]
root = "root"
default_classes = ["workbench-dropdown-popup", "workbench-popup-menu", "workbench-primitive"]

[nodes.root]
component = "DropdownPopup"
control_id = "WorkbenchDropdownPopupRoot"
classes = ["workbench-dropdown-popup", "workbench-popup-menu"]
props = { open = true, popup_open = true, options = ["Scene", "Assets", "Console", "Render"], selected_options = ["Assets"], selectedOptions = ["Assets"], disabled_options = ["Render"], focused_options = ["Console"], hovered_options = ["Console"], pressed_options = [], focused_index = 2, keyboard_navigation = true, typeahead_buffer = "", typeahead_buffer_expired = false, typeahead_timeout_ms = 500, hovered_option_id = "Console", submenu_pending_option_id = "", submenu_open_option_id = "", submenu_hover_ready = false, submenu_hover_delay_ms = 300, submenu_focus_scope = "root", submenu_focus_loop = true, placement = "bottom-start", popup_anchor_x = 12.0, popup_anchor_y = 32.0, popup_anchor_width = 160.0, popup_anchor_height = 30.0, anchor_origin_vertical = "bottom", anchor_origin_horizontal = "left", transform_origin_vertical = "top", transform_origin_horizontal = "left", popup_offset_x = 0.0, popup_offset_y = "$editor.density.gap.small", disable_auto_focus = false, disable_enforce_focus = false, disable_restore_focus = false, disable_escape_key_down = false, close_on_backdrop_click = true, keep_mounted = false, aria_modal = true, aria_labelledby = "Workbench dropdown popup", aria_describedby = "Selection popup options for a Workbench dropdown", z_index = 1300, disable_portal = false, portal_layer = "overlay", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_height = "$editor.control.height.dense", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.small", elevation = 0.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 118.0, preferred = 126.0, max = 132.0, stretch = "Fixed" } }
