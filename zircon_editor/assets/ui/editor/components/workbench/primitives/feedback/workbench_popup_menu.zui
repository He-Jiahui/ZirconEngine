[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_popup_menu.zui"
version = 2
display_name = "Workbench Popup Menu"

[imports]
widgets = []
styles = []

[components.WorkbenchPopupMenu]
root = "root"
default_classes = ["workbench-popup-menu", "workbench-primitive"]

[nodes.root]
component = "ContextActionMenu"
control_id = "WorkbenchPopupMenuRoot"
classes = ["workbench-popup-menu"]
props = { value = "Open", menu_items = ["New|icon=plus", "Open|icon=folder", "Save|icon=save", "Delete|danger,icon=trash", "More Tools|submenu"], popup_open = true, popup_anchor_x = 0.0, popup_anchor_y = 30.0, layout_padding_left = 8.0, layout_padding_right = 8.0, layout_padding_top = 3.0, layout_padding_bottom = 3.0, layout_spacing = 4.0, layout_min_height = 28.0, border_width = 1.0, corner_radius = 4.0, elevation = 0.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 140.0, preferred = 150.0, max = 156.0, stretch = "Fixed" } }
