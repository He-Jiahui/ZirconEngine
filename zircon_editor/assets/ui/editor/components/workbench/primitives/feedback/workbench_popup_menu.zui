[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_popup_menu.zui"
version = 2
display_name = "Workbench Popup Menu"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchPopupMenu]
root = "root"
default_classes = ["workbench-popup-menu", "workbench-primitive"]

[nodes.root]
component = "ContextActionMenu"
control_id = "WorkbenchPopupMenuRoot"
classes = ["workbench-popup-menu"]
props = { value = "Open", menu_items = ["New|icon=plus", "Open|icon=folder", "Save|icon=save", "Delete|danger,icon=trash", "More Tools|submenu"], popup_open = true, popup_anchor_x = 0.0, popup_anchor_y = "$editor.control.height.compact", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_height = "$editor.control.height.dense", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.small", elevation = 0.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 140.0, preferred = 150.0, max = 156.0, stretch = "Fixed" } }
