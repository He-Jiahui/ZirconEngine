[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_dialog.zui"
version = 2
display_name = "Workbench Dialog"

[imports]
widgets = []
styles = []

[components.WorkbenchDialog]
root = "root"
default_classes = ["workbench-dialog", "workbench-primitive"]

[nodes.root]
component = "Dialog"
control_id = "WorkbenchDialogRoot"
classes = ["workbench-dialog"]
props = { open = true, popup_open = true, text = "Scene Settings", title = "Scene Settings", message = "Review scene-level settings before applying changes.", placement = "center", popup_anchor_x = 640.0, popup_anchor_y = 360.0, popup_anchor_width = 0.0, popup_anchor_height = 0.0, anchor_origin_vertical = "center", anchor_origin_horizontal = "center", transform_origin_vertical = "center", transform_origin_horizontal = "center", popup_offset_x = 0.0, popup_offset_y = 0.0, disable_auto_focus = false, disable_enforce_focus = false, disable_restore_focus = false, disable_escape_key_down = false, close_on_backdrop_click = true, keep_mounted = false, aria_modal = true, aria_labelledby = "Workbench dialog", aria_describedby = "Editor modal dialog", z_index = 1450, disable_portal = false, portal_layer = "dialog", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = 420.0, preferred = 480.0, max = 560.0, stretch = "Fixed" }, height = { min = 180.0, preferred = 220.0, max = 320.0, stretch = "Fixed" } }
