[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_tooltip.zui"
version = 2
display_name = "Workbench Tooltip"

[imports]
widgets = []
styles = []

[components.WorkbenchTooltip]
root = "root"
default_classes = ["workbench-tooltip", "workbench-primitive"]

[nodes.root]
component = "Tooltip"
control_id = "WorkbenchTooltipRoot"
classes = ["workbench-tooltip"]
props = { text = "Tooltip", label_text = "This is a tooltip", icon = "info", show_icon = true, surface_variant = "workbench-tooltip", background_color = "#171c20", border_color = "#252d32", text_color = "#d0d9dd", label_color = "#a8b3b8", icon_color = "#259ca7", layout_icon_size = 18.0, layout_content_offset_y = 56.0, arrow_size = 8.0, arrow_color = "#171c20" }
layout = { width = { min = 110.0, preferred = 110.0, max = 120.0, stretch = "Fixed" }, height = { min = 78.0, preferred = 78.0, max = 78.0, stretch = "Fixed" } }
