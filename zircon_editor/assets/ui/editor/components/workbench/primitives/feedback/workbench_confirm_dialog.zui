[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/feedback/workbench_confirm_dialog.zui"
version = 2
display_name = "Workbench Confirm Dialog"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchConfirmDialog]
root = "root"
default_classes = ["workbench-confirm-dialog", "workbench-dialog", "workbench-primitive"]

[nodes.root]
component = "ConfirmDialog"
control_id = "WorkbenchConfirmDialogRoot"
classes = ["workbench-confirm-dialog", "workbench-dialog"]
props = { open = true, popup_open = true, title = "Delete selected node?", message = "This removes the node from the scene hierarchy.", confirm_text = "Delete", cancel_text = "Cancel", confirm_action_id = "delete-node", cancel_action_id = "cancel-delete-node", severity = "warning", default_action = "cancel", destructive = true, confirm_enabled = true, requires_explicit_action = true, background_color = "$editor.popup", border_color = "$editor.border", focus_border_color = "$editor.accent", title_color = "$editor.text.primary", body_color = "$editor.text.secondary", action_color = "$editor.accent", cancel_action_color = "$editor.text.secondary", confirm_action_color = "$editor.semantic.error", disabled_text_color = "$editor.text.disabled", info_color = "$editor.semantic.info", info_border_color = "$editor.semantic.info.container", warning_color = "$editor.semantic.warning", warning_border_color = "$editor.semantic.warning.container", error_color = "$editor.semantic.error", error_border_color = "$editor.semantic.error.container", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.panel", title_font_size = "$editor.typography.title.size", body_font_size = "$editor.typography.caption.size", action_font_size = "$editor.typography.body.size", typography_line_height_ratio = "$editor.typography.line_height", placement = "center", popup_anchor_x = 640.0, popup_anchor_y = 360.0, popup_anchor_width = 0.0, popup_anchor_height = 0.0, anchor_origin_vertical = "center", anchor_origin_horizontal = "center", transform_origin_vertical = "center", transform_origin_horizontal = "center", popup_offset_x = 0.0, popup_offset_y = 0.0, disable_auto_focus = false, disable_enforce_focus = false, disable_restore_focus = false, disable_escape_key_down = false, close_on_backdrop_click = true, keep_mounted = false, aria_modal = true, aria_labelledby = "Workbench confirmation dialog", aria_describedby = "Confirm or cancel a destructive editor action", z_index = 1460, disable_portal = false, portal_layer = "dialog", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.density.dialog.min_width", preferred = "$editor.density.confirm_dialog.preferred_width", max = "$editor.density.confirm_dialog.max_width", stretch = "Fixed" }, height = { min = "$editor.density.confirm_dialog.min_height", preferred = "$editor.density.confirm_dialog.preferred_height", max = "$editor.density.confirm_dialog.max_height", stretch = "Fixed" } }
