[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui"
version = 2
display_name = "Workbench Field"

[imports]
widgets = []
styles = []

[components.WorkbenchField]
root = "root"
default_classes = ["workbench-field", "workbench-primitive"]

[nodes.root]
component = "InputField"
control_id = "WorkbenchFieldRoot"
classes = ["workbench-field"]
props = { value = "", placeholder = "", validation_level = "normal", focused = false, hovered = false, disabled = false, editable_text = true, layout_padding_left = 10.0, layout_padding_right = 10.0, layout_padding_top = 4.0, layout_padding_bottom = 4.0, layout_min_height = 30.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
