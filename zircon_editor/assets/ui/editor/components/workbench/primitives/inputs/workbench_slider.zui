[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_slider.zui"
version = 2
display_name = "Workbench Slider"

[imports]
widgets = []
styles = []

[components.WorkbenchSlider]
root = "root"
default_classes = ["workbench-slider", "workbench-primitive"]

[nodes.root]
component = "RangeField"
control_id = "WorkbenchSliderRoot"
classes = ["workbench-slider"]
props = { value = 50.0, min = 0.0, max = 100.0, step = 1.0, validation_level = "normal", layout_padding_left = 10.0, layout_padding_right = 10.0, layout_padding_top = 3.0, layout_padding_bottom = 3.0, layout_min_height = 28.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
