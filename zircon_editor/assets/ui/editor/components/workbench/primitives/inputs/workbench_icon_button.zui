[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui"
version = 2
display_name = "Workbench Icon Button"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchIconButton]
root = "root"
default_classes = ["workbench-icon-button", "workbench-primitive"]

[nodes.root]
component = "IconButton"
control_id = "WorkbenchIconButtonRoot"
classes = ["workbench-icon-button"]
props = { icon = "zircon_editor_shell/toolbar/select.svg", text = "", label = "Tool", button_variant = "text", button_color = "secondary", button_size = "small", button_interaction_state = "normal", icon_placement = "icon_only", selected = false, focused = false, hovered = false, pressed = false, disabled = false, background_color = "transparent", hover_background_color = "$editor.surface.hover", pressed_background_color = "$editor.surface.3", selected_background_color = "$editor.surface.selected", disabled_background_color = "$editor.surface.disabled", border_color = "transparent", focus_border_color = "$editor.accent", disabled_border_color = "$editor.border.disabled", icon_color = "$editor.text.secondary", selected_icon_color = "$editor.accent", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.small", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.default", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
