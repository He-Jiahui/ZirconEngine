[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui"
version = 2
display_name = "Workbench Search Input"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchSearchInput]
root = "root"
default_classes = ["workbench-field", "workbench-search-input", "workbench-primitive"]

[nodes.root]
component = "SearchField"
control_id = "WorkbenchSearchInputRoot"
classes = ["workbench-field", "workbench-search-input"]
props = { query = "", placeholder = "Search", validation_level = "normal", focused = false, hovered = false, disabled = false, editable_text = true, search_icon = "zircon_editor_shell/toolbar/search.svg", clear_icon = "zircon_editor_shell/controls/close.svg", has_clear_action = true, background_color = "$editor.surface.recessed", hover_background_color = "$editor.surface.hover", pressed_background_color = "$editor.surface.3", focused_background_color = "$editor.surface.recessed", disabled_background_color = "$editor.surface.disabled", border_color = "$editor.separator.soft", hover_border_color = "$editor.border", focus_border_color = "$editor.accent", disabled_border_color = "$editor.border.disabled", foreground_color = "$editor.text.primary", placeholder_color = "$editor.text.secondary", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_padding_left = "$editor.control.height.dense", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_min_height = "$editor.control.height.dense", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
widget = { value_property = "query" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
