[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_radio.zui"
version = 2
display_name = "Workbench Radio"

[imports]
widgets = []
styles = []

[components.WorkbenchRadio]
root = "root"
default_classes = ["workbench-radio", "workbench-primitive"]

[nodes.root]
component = "Radio"
control_id = "WorkbenchRadioRoot"
classes = ["workbench-radio"]
props = { text = "Radio option", value = false, checked = false, label_color = "#828c93", layout_spacing = 9.0, layout_icon_size = 16.0, dot_size = 7.0, dot_color = "#2aa6b8", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 26.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }
