[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui"
version = 2
display_name = "Workbench Dropdown"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchDropdown]
root = "root"
default_classes = ["workbench-field", "workbench-dropdown", "workbench-primitive"]

[nodes.root]
component = "Dropdown"
control_id = "WorkbenchDropdownRoot"
classes = ["workbench-field", "workbench-dropdown"]
props = { value = "default", value_text = "Default", options = ["default"], multiple = false, popup_open = false, selected = false, focused = false, hovered = false, pressed = false, disabled = false, selection_state = "single", validation_level = "normal", background_color = "$editor.surface.recessed", hover_background_color = "$editor.surface.hover", pressed_background_color = "$editor.surface.3", open_background_color = "$editor.accent.soft", disabled_background_color = "$editor.surface.disabled", border_color = "$editor.border", focus_border_color = "$editor.accent", disabled_border_color = "$editor.border.disabled", foreground_color = "$editor.text.primary", label_color = "$editor.text.secondary", icon_color = "$editor.text.secondary", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.small", horizontal_inset = "$editor.density.gap.medium", caret_size = "$editor.typography.overlay.size", caret_right_inset = "$editor.density.gap.large", caret_gap = "$editor.density.gap.small", label_top = "$editor.control.border_width", label_font_size = "$editor.typography.caption.size", label_line_height_ratio = "$editor.typography.line_height", value_bottom_inset = "$editor.control.border_width", font_size = "$editor.typography.overlay.size", line_height_ratio = "$editor.typography.line_height", layout_padding_left = "$editor.density.gap.medium", layout_padding_right = "$editor.density.gap.medium", layout_padding_top = "$editor.control.border_width", layout_padding_bottom = "$editor.density.gap.small", layout_min_height = "$editor.control.height.dense", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
