[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui"
version = 2
display_name = "Workbench Dropdown"

[imports]
widgets = []
styles = []

[components.WorkbenchDropdown]
root = "root"
default_classes = ["workbench-field", "workbench-dropdown", "workbench-primitive"]

[nodes.root]
component = "Dropdown"
control_id = "WorkbenchDropdownRoot"
classes = ["workbench-field", "workbench-dropdown"]
props = { value = "default", value_text = "Default", options = ["default"], multiple = false, popup_open = false, selected = false, focused = false, hovered = false, pressed = false, disabled = false, selection_state = "single", validation_level = "normal", layout_padding_left = 8.0, layout_padding_right = 8.0, layout_padding_top = 3.0, layout_padding_bottom = 4.0, layout_min_height = 28.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
