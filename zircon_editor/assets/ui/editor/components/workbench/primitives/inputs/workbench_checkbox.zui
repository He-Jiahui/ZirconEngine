[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_checkbox.zui"
version = 2
display_name = "Workbench Checkbox"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchCheckbox]
root = "root"
default_classes = ["workbench-check", "workbench-primitive"]

[nodes.root]
component = "Checkbox"
control_id = "WorkbenchCheckboxRoot"
classes = ["workbench-check"]
props = { text = "Checkbox", value = false, checked = false, background_color = "$editor.surface.recessed", selected_background_color = "$editor.surface.selected", disabled_background_color = "$editor.surface.disabled", border_color = "$editor.separator.strong", focus_border_color = "$editor.focus.ring", disabled_border_color = "$editor.border.disabled", label_color = "$editor.text.secondary", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.small", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_spacing = "$editor.density.gap.medium", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.compact", stretch = "Fixed" } }
