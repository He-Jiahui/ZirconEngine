[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui"
version = 2
display_name = "Workbench Button"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchButton]
root = "root"
default_classes = ["workbench-control-button", "workbench-primitive"]

[nodes.root]
component = "Button"
control_id = "WorkbenchButtonRoot"
classes = ["workbench-control-button"]
props = { text = "Button", text_overflow = "ellipsis", button_variant = "outlined", button_color = "secondary", button_size = "small", button_interaction_state = "normal", validation_level = "normal", selected = false, focused = false, hovered = false, pressed = false, disabled = false, background_color = "$editor.surface.1", hover_background_color = "$editor.surface.hover", pressed_background_color = "$editor.surface.3", selected_background_color = "$editor.surface.selected", disabled_background_color = "$editor.surface.disabled", border_color = "$editor.border", focus_border_color = "$editor.accent", disabled_border_color = "$editor.border.disabled", foreground_color = "$editor.text.primary", disabled_foreground_color = "$editor.text.disabled", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.small", font_size = "$editor.typography.body.size", line_height_ratio = "$editor.typography.line_height", layout_padding_left = "$editor.density.gap.large", layout_padding_right = "$editor.density.gap.large", layout_padding_top = "$editor.density.gap.small", layout_padding_bottom = "$editor.density.gap.small", layout_spacing = "$editor.density.gap.medium", layout_min_width = "$editor.control.height.default", layout_min_height = "$editor.control.height.dense", input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.compact", max = "$editor.control.height.default", stretch = "Fixed" } }
