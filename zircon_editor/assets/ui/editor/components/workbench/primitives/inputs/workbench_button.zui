[asset]
kind = "component"
id = "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui"
version = 2
display_name = "Workbench Button"

[imports]
widgets = []
styles = []

[components.WorkbenchButton]
root = "root"
default_classes = ["workbench-control-button", "workbench-primitive"]

[nodes.root]
component = "Button"
control_id = "WorkbenchButtonRoot"
classes = ["workbench-control-button"]
props = { text = "Button", button_variant = "outlined", button_color = "secondary", button_size = "small", button_interaction_state = "normal", validation_level = "normal", selected = false, focused = false, hovered = false, pressed = false, disabled = false, layout_padding_left = 12.0, layout_padding_right = 12.0, layout_padding_top = 6.0, layout_padding_bottom = 6.0, layout_spacing = 7.0, layout_min_width = 32.0, layout_min_height = 28.0, layout_icon_size = 16.0, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
