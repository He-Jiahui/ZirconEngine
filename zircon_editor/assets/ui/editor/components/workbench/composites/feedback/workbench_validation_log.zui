[asset]
kind = "component"
id = "res://ui/editor/components/workbench/composites/feedback/workbench_validation_log.zui"
version = 2
display_name = "Workbench Validation Log"

[imports]
widgets = [
  "res://ui/editor/components/workbench/composites/chrome/workbench_panel_header.zui#WorkbenchPanelHeader",
  "res://ui/editor/components/workbench/composites/feedback/workbench_diagnostic_row.zui#WorkbenchDiagnosticRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_caption.zui#WorkbenchCaption",
  "res://ui/editor/components/workbench/primitives/feedback/workbench_status_item.zui#WorkbenchStatusItem",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_button.zui#WorkbenchButton",
]
styles = []

[components.WorkbenchValidationLog]
root = "validation_log_root"
default_classes = ["workbench-panel", "workbench-surface-inset", "workbench-composite"]

[nodes.validation_log_root]
component = "VerticalGroup"
control_id = "WorkbenchValidationLogRoot"
classes = ["workbench-panel", "workbench-surface-inset"]
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.xsmall" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "validation_log_header" }, { node = "validation_log_filters" }, { node = "validation_log_info_axes" }, { node = "validation_log_warning" }, { node = "validation_log_info_range" }, { node = "validation_log_info_duplicates" }, { node = "validation_log_fill" }, { node = "validation_log_footer" }]

[nodes.validation_log_header]
component = "WorkbenchPanelHeader"
control_id = "WorkbenchValidationLogHeader"
layout = { width = { stretch = "Stretch" } }
children = [{ node = "validation_log_title", slot = { name = "title" } }]

[nodes.validation_log_title]
component = "WorkbenchCaption"
control_id = "WorkbenchValidationLogTitle"
props = { text = "VALIDATION LOG" }
layout = { width = { stretch = "Stretch" }, height = { min = 20.0, preferred = 22.0, max = 24.0, stretch = "Fixed" } }

[nodes.validation_log_filters]
component = "HorizontalGroup"
control_id = "WorkbenchValidationLogFilters"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 26.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }
children = [{ node = "validation_log_all" }, { node = "validation_log_errors" }, { node = "validation_log_warnings" }, { node = "validation_log_infos" }, { node = "validation_log_filters_fill" }]

[nodes.validation_log_all]
component = "WorkbenchButton"
control_id = "WorkbenchValidationLogAll"
props = { text = "All", icon = "editor_pages/console_profiler/logs/filter-logs.svg", icon_placement = "leading", component_variant = "code compact_icon_text", button_variant = "text", button_color = "secondary", text_tone = "accent", selected = true, checked = true }
layout = { width = { min = 48.0, preferred = 54.0, max = 58.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.validation_log_errors]
component = "WorkbenchButton"
control_id = "WorkbenchValidationLogErrors"
props = { text = "0", icon = "editor_pages/console_profiler/logs/log-error.svg", icon_placement = "leading", component_variant = "code compact_icon_text", button_variant = "text", button_color = "secondary", text_tone = "error", validation_level = "error" }
layout = { width = { min = 42.0, preferred = 46.0, max = 48.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.validation_log_warnings]
component = "WorkbenchButton"
control_id = "WorkbenchValidationLogWarnings"
props = { text = "1", icon = "editor_pages/console_profiler/logs/log-warning.svg", icon_placement = "leading", component_variant = "code compact_icon_text", button_variant = "text", button_color = "secondary", text_tone = "warning", validation_level = "warning" }
layout = { width = { min = 42.0, preferred = 46.0, max = 48.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.validation_log_infos]
component = "WorkbenchButton"
control_id = "WorkbenchValidationLogInfos"
props = { text = "2", icon = "editor_pages/console_profiler/logs/log-info.svg", icon_placement = "leading", component_variant = "code compact_icon_text", button_variant = "text", button_color = "secondary", text_tone = "info", validation_level = "info" }
layout = { width = { min = 42.0, preferred = 46.0, max = 48.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.validation_log_filters_fill]
component = "Container"
control_id = "WorkbenchValidationLogFiltersFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_info_axes]
component = "WorkbenchDiagnosticRow"
control_id = "WorkbenchValidationLogInfoAxesRow"
layout = { width = { stretch = "Stretch" } }
children = [{ node = "validation_log_info_axes_severity", slot = { name = "severity" } }, { node = "validation_log_info_axes_message", slot = { name = "message" } }]

[nodes.validation_log_info_axes_severity]
component = "WorkbenchStatusItem"
control_id = "WorkbenchValidationLogInfoAxesSeverity"
props = { text = "[Info]", component_variant = "diagnostic_signal", validation_level = "info", text_tone = "info" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_info_axes_message]
component = "WorkbenchStatusItem"
control_id = "WorkbenchValidationLogInfoAxesMessage"
props = { text = "Blend space axes are valid.", foreground_color = "$editor.text.primary", text_tone = "subtle" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_warning]
component = "WorkbenchDiagnosticRow"
control_id = "WorkbenchValidationLogWarningRow"
layout = { width = { stretch = "Stretch" } }
children = [{ node = "validation_log_warning_severity", slot = { name = "severity" } }, { node = "validation_log_warning_message", slot = { name = "message" } }]

[nodes.validation_log_warning_severity]
component = "WorkbenchStatusItem"
control_id = "WorkbenchValidationLogWarningSeverity"
props = { text = "[Warning]", component_variant = "diagnostic_signal", validation_level = "warning", text_tone = "warning" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_warning_message]
component = "WorkbenchStatusItem"
control_id = "WorkbenchValidationLogWarningMessage"
props = { text = "1 sample missing.", foreground_color = "$editor.text.primary", text_tone = "subtle" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_info_range]
component = "WorkbenchDiagnosticRow"
control_id = "WorkbenchValidationLogInfoRangeRow"
layout = { width = { stretch = "Stretch" } }
children = [{ node = "validation_log_info_range_severity", slot = { name = "severity" } }, { node = "validation_log_info_range_message", slot = { name = "message" } }]

[nodes.validation_log_info_range_severity]
component = "WorkbenchStatusItem"
control_id = "WorkbenchValidationLogInfoRangeSeverity"
props = { text = "[Info]", component_variant = "diagnostic_signal", validation_level = "info", text_tone = "info" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_info_range_message]
component = "WorkbenchStatusItem"
control_id = "WorkbenchValidationLogInfoRangeMessage"
props = { text = "Samples are within axis range.", foreground_color = "$editor.text.primary", text_tone = "subtle" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_info_duplicates]
component = "WorkbenchDiagnosticRow"
control_id = "WorkbenchValidationLogInfoDuplicatesRow"
layout = { width = { stretch = "Stretch" } }
children = [{ node = "validation_log_info_duplicates_severity", slot = { name = "severity" } }, { node = "validation_log_info_duplicates_message", slot = { name = "message" } }]

[nodes.validation_log_info_duplicates_severity]
component = "WorkbenchStatusItem"
control_id = "WorkbenchValidationLogInfoDuplicatesSeverity"
props = { text = "[Info]", component_variant = "diagnostic_signal", validation_level = "info", text_tone = "info" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_info_duplicates_message]
component = "WorkbenchStatusItem"
control_id = "WorkbenchValidationLogInfoDuplicatesMessage"
props = { text = "No duplicate samples found.", foreground_color = "$editor.text.primary", text_tone = "subtle" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_fill]
component = "Container"
control_id = "WorkbenchValidationLogFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_footer]
component = "HorizontalGroup"
control_id = "WorkbenchValidationLogFooter"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 26.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }
children = [{ node = "validation_log_footer_fill" }, { node = "validation_log_clear" }]

[nodes.validation_log_footer_fill]
component = "Container"
control_id = "WorkbenchValidationLogFooterFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_log_clear]
component = "WorkbenchButton"
control_id = "WorkbenchValidationLogClear"
props = { text = "Clear", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 50.0, preferred = 58.0, max = 66.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
