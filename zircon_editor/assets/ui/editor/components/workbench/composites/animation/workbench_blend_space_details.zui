[asset]
kind = "component"
id = "res://ui/editor/components/workbench/composites/animation/workbench_blend_space_details.zui"
version = 2
display_name = "Workbench Blend Space Details"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/chrome/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench/primitives/data/workbench_table_row.zui#WorkbenchTableRow",
  "res://ui/editor/components/workbench/primitives/data/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/composites/inputs/workbench_property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchBlendSpaceDetails]
root = "root"
default_classes = ["workbench-blend-space-details", "workbench-composite"]

[nodes.root]
component = "VerticalGroup"
control_id = "WorkbenchBlendSpaceDetailsRoot"
classes = ["workbench-blend-space-details"]
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.xsmall" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "samples_title" }, { node = "run_forward" }, { node = "strafe_left" }, { node = "strafe_right" }, { node = "idle" }, { node = "axes_title" }, { node = "horizontal_axis" }, { node = "vertical_axis" }, { node = "grid_divisions" }, { node = "sample_title" }, { node = "asset_row" }, { node = "x_axis_row" }, { node = "interpolation_row" }, { node = "sample_position" }, { node = "rate_scale" }, { node = "fill" }]

[nodes.samples_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionBlendSpaceSamplesTitle"
props = { text = "SAMPLES (8)" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.run_forward]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionBlendSpaceSampleRunForwardRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Run_Fwd  0  600  1.00", value = "run_forward", options = ["Run_Fwd", "0", "600", "1.00"], selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceRunSampleTableRow", event = "Click", route = "workbench.extension.blend_space.run_sample_table_row.select" }]

[nodes.strafe_left]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionBlendSpaceSampleStrafeLeftRow"
classes = ["workbench-table-row"]
props = { text = "Strafe_L  -90  240  0.34", value = "strafe_left", options = ["Strafe_L", "-90", "240", "0.34"] }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceWalkSampleTableRow", event = "Click", route = "workbench.extension.blend_space.walk_sample_table_row.select" }]

[nodes.strafe_right]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionBlendSpaceSampleStrafeRightRow"
classes = ["workbench-table-row"]
props = { text = "Strafe_R  90  240  0.32", value = "strafe_right", options = ["Strafe_R", "90", "240", "0.32"] }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceDiagonalSampleTableRow", event = "Click", route = "workbench.extension.blend_space.diagonal_sample_table_row.select" }]

[nodes.idle]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionBlendSpaceSampleIdleRow"
classes = ["workbench-table-row"]
props = { text = "Idle  0  0  0.18", value = "idle", options = ["Idle", "0", "0", "0.18"] }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BlendSpaceIdleSampleTableRow", event = "Click", route = "workbench.extension.blend_space.idle_sample_table_row.select" }]

[nodes.axes_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionBlendSpaceAxisGroupTitle"
props = { text = "AXIS SETTINGS" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.horizontal_axis]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchExtensionBlendSpaceXAxisProperty"
props = { text = "Horizontal", value = "Speed  0 - 620" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.vertical_axis]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchExtensionBlendSpaceYAxisProperty"
props = { text = "Vertical", value = "Direction  -180 - 180" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.grid_divisions]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchExtensionBlendSpaceGridDivisionsProperty"
props = { text = "Grid divisions", value = "4 x 4" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.sample_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionBlendSpaceSampleDetailTitle"
props = { text = "SAMPLE" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.asset_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionBlendSpaceAssetPropertyRow"
props = { text = "Asset" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
children = [{ node = "asset", slot = { name = "value" } }]

[nodes.asset]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionBlendSpaceAssetDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "BS_Locomotion", value = "BS_Locomotion", options = ["BS_Locomotion", "BS_Strafe", "BS_SprintLean"] }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/BlendSpaceAssetEdit", event = "Change", route = "workbench.extension.blend_space.asset.edit" },
  { id = "WorkbenchExtension/BlendSpaceAssetCommit", event = "Submit", route = "workbench.extension.blend_space.asset.commit" },
]

[nodes.x_axis_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionBlendSpaceXAxisPropertyRow"
props = { text = "X Axis" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
children = [{ node = "x_axis", slot = { name = "value" } }]

[nodes.x_axis]
component = "WorkbenchField"
control_id = "WorkbenchExtensionBlendSpaceXAxisField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Speed 0-620" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/BlendSpaceXAxisEdit", event = "Change", route = "workbench.extension.blend_space.x_axis.edit" },
  { id = "WorkbenchExtension/BlendSpaceXAxisCommit", event = "Submit", route = "workbench.extension.blend_space.x_axis.commit" },
]

[nodes.interpolation_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionBlendSpaceInterpolationPropertyRow"
props = { text = "Interpolation" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
children = [{ node = "interpolation", slot = { name = "value" } }]

[nodes.interpolation]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionBlendSpaceInterpolationDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Triangulated", value = "Triangulated", options = ["Triangulated", "Grid", "Weighted"] }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/BlendSpaceInterpolationEdit", event = "Change", route = "workbench.extension.blend_space.interpolation.edit" },
  { id = "WorkbenchExtension/BlendSpaceInterpolationCommit", event = "Submit", route = "workbench.extension.blend_space.interpolation.commit" },
]

[nodes.sample_position]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchExtensionBlendSpaceSamplePositionProperty"
props = { text = "Sample position", value = "420, 0" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.rate_scale]
component = "WorkbenchPropertyRow"
control_id = "WorkbenchExtensionBlendSpaceSampleRateProperty"
props = { text = "Rate scale", value = "1.00" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }

[nodes.fill]
component = "Container"
control_id = "WorkbenchExtensionBlendSpaceRightFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
