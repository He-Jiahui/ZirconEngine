[asset]
kind = "component"
id = "res://ui/editor/components/workbench/composites/chrome/workbench_panel_header.zui"
version = 2
display_name = "Workbench Panel Header"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[components.WorkbenchPanelHeader]
root = "root"
default_classes = ["workbench-panel-header", "workbench-composite"]
slots = { title = { multiple = false }, actions = { multiple = true } }

[nodes.root]
component = "HorizontalGroup"
control_id = "WorkbenchPanelHeaderRoot"
classes = ["workbench-panel-toolbar"]
props = { background_color = "$editor.surface.1", border_color = "$editor.separator.soft", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.compact", stretch = "Fixed" } }
children = [{ node = "title_slot" }, { node = "actions_slot" }]

[nodes.title_slot]
component = "Slot"
props = { name = "title" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.actions_slot]
component = "Slot"
props = { name = "actions" }
layout = { height = { stretch = "Stretch" } }
