[asset]
kind = "component"
id = "res://ui/editor/components/workbench_extension_world_state_workspace.zui"
version = 2
display_name = "Workbench Extension World State Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionWorldStateWorkspace]
root = "world_state_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.world_state_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionWorldStateWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "world_state_rail_gap" }, { node = "world_state_left" }, { node = "world_state_center" }, { node = "world_state_right" }]

[nodes.world_state_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionWorldStateRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.world_state_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionWorldStateLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "world_state_title" }, { node = "world_state_keys_tab" }, { node = "world_state_scenario_tab" }, { node = "world_state_timeline_tab" }, { node = "world_state_night_raid_row" }, { node = "world_state_global_layer_row" }, { node = "world_state_alarm_key_row" }]

[nodes.world_state_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionWorldStateTitle"
props = { text = "World State" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.world_state_keys_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionWorldStateKeysTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Keys", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateKeysTab", event = "Click", route = "WorkbenchExtension.WorldState.Keys" }]

[nodes.world_state_scenario_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionWorldStateScenarioTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Scenario", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateScenarioTab", event = "Click", route = "WorkbenchExtension.WorldState.Scenario" }]

[nodes.world_state_timeline_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionWorldStateTimelineTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Timeline", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateTimelineTab", event = "Click", route = "WorkbenchExtension.WorldState.Timeline" }]

[nodes.world_state_night_raid_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionWorldStateNightRaidRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Scenario_NightRaid", icon = "globe", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateNightRaidRow", event = "Click", route = "WorkbenchExtension.WorldState.Scenario.NightRaid" }]

[nodes.world_state_global_layer_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionWorldStateGlobalLayerRow"
classes = ["workbench-list-row"]
props = { text = "Layer_Global", icon = "file", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateGlobalLayerRow", event = "Click", route = "WorkbenchExtension.WorldState.Layer.Global" }]

[nodes.world_state_alarm_key_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionWorldStateAlarmKeyRow"
classes = ["workbench-list-row"]
props = { text = "Key_Alarm", icon = "target", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateAlarmKeyRow", event = "Click", route = "WorkbenchExtension.WorldState.Key.Alarm" }]

[nodes.world_state_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionWorldStateCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "world_state_center_header" }, { node = "world_state_key_table" }, { node = "world_state_output" }]

[nodes.world_state_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionWorldStateCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "world_state_center_title" }, { node = "world_state_header_fill" }, { node = "world_state_simulate_button" }, { node = "world_state_validate_button" }]

[nodes.world_state_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionWorldStateCenterTitle"
props = { text = "World State Keys" }
layout = { width = { min = 250.0, preferred = 250.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.world_state_header_fill]
component = "Container"
control_id = "WorkbenchExtensionWorldStateHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.world_state_simulate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionWorldStateSimulateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Simulate", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 96.0, preferred = 96.0, max = 106.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateSimulate", event = "Click", route = "WorkbenchExtension.WorldState.Simulate" }]

[nodes.world_state_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionWorldStateValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 96.0, preferred = 96.0, max = 106.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateValidate", event = "Click", route = "WorkbenchExtension.WorldState.Validate" }]

[nodes.world_state_key_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionWorldStateKeyTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "world_state_alarm_active_table_row" }, { node = "world_state_weather_mode_table_row" }, { node = "world_state_ai_alert_table_row" }, { node = "world_state_quest_flag_table_row" }]

[nodes.world_state_alarm_active_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWorldStateAlarmActiveTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Alarm.Active", value_text = "Global   true   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateAlarmActiveTableRow", event = "Click", route = "WorkbenchExtension.WorldState.Keys.AlarmActive" }]

[nodes.world_state_weather_mode_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWorldStateWeatherModeTableRow"
classes = ["workbench-table-row"]
props = { text = "Weather.Mode", value_text = "Region   Storm   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateWeatherModeTableRow", event = "Click", route = "WorkbenchExtension.WorldState.Keys.WeatherMode" }]

[nodes.world_state_ai_alert_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWorldStateAiAlertTableRow"
classes = ["workbench-table-row"]
props = { text = "AI.Alert", value_text = "System   High   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateAiAlertTableRow", event = "Click", route = "WorkbenchExtension.WorldState.Keys.AiAlert" }]

[nodes.world_state_quest_flag_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWorldStateQuestFlagTableRow"
classes = ["workbench-table-row"]
props = { text = "Quest.Flag", value_text = "Scenario   Conflict   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateQuestFlagTableRow", event = "Click", route = "WorkbenchExtension.WorldState.Keys.QuestFlag" }]

[nodes.world_state_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionWorldStateOutputRow"
classes = ["workbench-table-row"]
props = { text = "World State Log", value_text = "84 keys   6 layers   1 conflict" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/WorldStateOutput", event = "Click", route = "WorkbenchExtension.WorldState.Output" }]

[nodes.world_state_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionWorldStateRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "world_state_details_title" }, { node = "world_state_scenario_dropdown" }, { node = "world_state_layer_dropdown" }, { node = "world_state_authority_field" }]

[nodes.world_state_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionWorldStateDetailsTitle"
props = { text = "State Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.world_state_scenario_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionWorldStateScenarioDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Night Raid", value = "Night Raid", options = ["Night Raid", "Patrol", "Defense", "Debug Scenario"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/WorldStateScenarioEdit", event = "Change", route = "WorkbenchExtension.WorldState.Scenario.Edit" },
  { id = "WorkbenchExtension/WorldStateScenarioCommit", event = "Submit", route = "WorkbenchExtension.WorldState.Scenario.Commit" },
]

[nodes.world_state_layer_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionWorldStateLayerDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Global", value = "Global", options = ["Global", "Region", "System", "Scenario"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/WorldStateLayerEdit", event = "Change", route = "WorkbenchExtension.WorldState.Layer.Edit" },
  { id = "WorkbenchExtension/WorldStateLayerCommit", event = "Submit", route = "WorkbenchExtension.WorldState.Layer.Commit" },
]

[nodes.world_state_authority_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionWorldStateAuthorityField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Authority: Server" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/WorldStateAuthorityEdit", event = "Change", route = "WorkbenchExtension.WorldState.Authority.Edit" },
  { id = "WorkbenchExtension/WorldStateAuthorityCommit", event = "Submit", route = "WorkbenchExtension.WorldState.Authority.Commit" },
]
