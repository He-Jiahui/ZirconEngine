  { id = "WorkbenchModule/EffectTagEdit", event = "Change", route = "WorkbenchModule.Effect.Tag.Edit" },
  { id = "WorkbenchModule/EffectTagCommit", event = "Submit", route = "WorkbenchModule.Effect.Tag.Commit" },
]

[nodes.effect_stack_field]
component = "WorkbenchField"
control_id = "WorkbenchEffectStackField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Aggregate by Source" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/EffectStackEdit", event = "Change", route = "WorkbenchModule.Effect.Stack.Edit" },
  { id = "WorkbenchModule/EffectStackCommit", event = "Submit", route = "WorkbenchModule.Effect.Stack.Commit" },
]

[nodes.effect_magnitude_field]
component = "WorkbenchField"
control_id = "WorkbenchEffectMagnitudeField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Magnitude: 10.0" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchModule/EffectMagnitudeEdit", event = "Change", route = "WorkbenchModule.Effect.Magnitude.Edit" },
  { id = "WorkbenchModule/EffectMagnitudeCommit", event = "Submit", route = "WorkbenchModule.Effect.Magnitude.Commit" },
]

[nodes.effect_attribute_preview_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchEffectAttributePreviewRow"
classes = ["workbench-table-row"]
props = { text = "Preview Level 1       Health +10.0", value = "attribute_preview", options = ["Preview Level 1", "Health +10.0"], selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchModule/EffectAttributePreview", event = "Click", route = "WorkbenchModule.Effect.AttributePreview" }]

[nodes.material_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchModuleMaterialWorkspace"
classes = ["workbench-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "material_rail_gap" }, { node = "material_left" }, { node = "material_center" }, { node = "material_right" }]

