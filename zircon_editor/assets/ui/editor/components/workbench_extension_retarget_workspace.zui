[asset]
kind = "component"
id = "res://ui/editor/components/workbench_extension_retarget_workspace.zui"
version = 2
display_name = "Workbench Extension Retarget Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionRetargetWorkspace]
root = "retarget_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.retarget_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionRetargetWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "retarget_rail_gap" }, { node = "retarget_left" }, { node = "retarget_center" }, { node = "retarget_right" }]

[nodes.retarget_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionRetargetRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.retarget_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionRetargetLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "retarget_title" }, { node = "retarget_rigs_tab" }, { node = "retarget_chains_tab" }, { node = "retarget_preview_tab" }, { node = "retarget_mannequin_row" }, { node = "retarget_robot_row" }, { node = "retarget_quadruped_row" }]

[nodes.retarget_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionRetargetTitle"
props = { text = "Retarget" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.retarget_rigs_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionRetargetRigsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Rigs", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetRigsTab", event = "Click", route = "WorkbenchExtension.Retarget.Rigs" }]

[nodes.retarget_chains_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionRetargetChainsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Chains", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetChainsTab", event = "Click", route = "WorkbenchExtension.Retarget.Chains" }]

[nodes.retarget_preview_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionRetargetPreviewTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Preview", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetPreviewTab", event = "Click", route = "WorkbenchExtension.Retarget.PreviewTab" }]

[nodes.retarget_mannequin_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionRetargetMannequinRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "SK_Mannequin", icon = "target", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetMannequinRow", event = "Click", route = "WorkbenchExtension.Retarget.Rig.Mannequin" }]

[nodes.retarget_robot_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionRetargetRobotRow"
classes = ["workbench-list-row"]
props = { text = "SK_Robot", icon = "gear", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetRobotRow", event = "Click", route = "WorkbenchExtension.Retarget.Rig.Robot" }]

[nodes.retarget_quadruped_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionRetargetQuadrupedRow"
classes = ["workbench-list-row"]
props = { text = "Creature Proxy", icon = "history", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetQuadrupedRow", event = "Click", route = "WorkbenchExtension.Retarget.Rig.Quadruped" }]

[nodes.retarget_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionRetargetCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "retarget_center_header" }, { node = "retarget_chain_table" }, { node = "retarget_output" }]

[nodes.retarget_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionRetargetCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "retarget_center_title" }, { node = "retarget_header_fill" }, { node = "retarget_preview_button" }, { node = "retarget_apply_button" }]

[nodes.retarget_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionRetargetCenterTitle"
props = { text = "Chain Map" }
layout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.retarget_header_fill]
component = "Container"
control_id = "WorkbenchExtensionRetargetHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.retarget_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionRetargetPreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetPreview", event = "Click", route = "WorkbenchExtension.Retarget.Preview" }]

[nodes.retarget_apply_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionRetargetApplyButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Apply", button_variant = "filled", button_color = "accent", background_color = "#12383d", border_color = "#209fa8", selected = true, checked = true }
layout = { width = { min = 72.0, preferred = 72.0, max = 82.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetApply", event = "Click", route = "WorkbenchExtension.Retarget.Apply" }]

[nodes.retarget_chain_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionRetargetChainTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "retarget_root_chain_table_row" }, { node = "retarget_spine_chain_table_row" }, { node = "retarget_arm_chain_table_row" }, { node = "retarget_leg_chain_table_row" }]

[nodes.retarget_root_chain_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRetargetRootChainTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Root", value_text = "pelvis -> root   Locked   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetRootChainTableRow", event = "Click", route = "WorkbenchExtension.Retarget.Chain.Root" }]

[nodes.retarget_spine_chain_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRetargetSpineChainTableRow"
classes = ["workbench-table-row"]
props = { text = "Spine", value_text = "spine_01..neck_01   FK   Clean" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetSpineChainTableRow", event = "Click", route = "WorkbenchExtension.Retarget.Chain.Spine" }]

[nodes.retarget_arm_chain_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRetargetArmChainTableRow"
classes = ["workbench-table-row"]
props = { text = "Arms", value_text = "clavicle..hand   IK   Mirror pair" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetArmChainTableRow", event = "Click", route = "WorkbenchExtension.Retarget.Chain.Arm" }]

[nodes.retarget_leg_chain_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRetargetLegChainTableRow"
classes = ["workbench-table-row"]
props = { text = "Legs", value_text = "thigh..ball   IK   Foot lock warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetLegChainTableRow", event = "Click", route = "WorkbenchExtension.Retarget.Chain.Leg" }]

[nodes.retarget_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionRetargetOutputRow"
classes = ["workbench-table-row"]
props = { text = "Retarget", value_text = "SK_Mannequin -> SK_Robot   4 chains   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/RetargetOutput", event = "Click", route = "WorkbenchExtension.Retarget.Output" }]

[nodes.retarget_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionRetargetRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "retarget_details_title" }, { node = "retarget_source_dropdown" }, { node = "retarget_target_field" }, { node = "retarget_solver_dropdown" }]

[nodes.retarget_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionRetargetDetailsTitle"
props = { text = "Retarget Settings" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.retarget_source_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionRetargetSourceDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "SK_Mannequin", value = "SK_Mannequin", options = ["SK_Mannequin", "SK_MetaHuman", "Creature_Source"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/RetargetSourceEdit", event = "Change", route = "WorkbenchExtension.Retarget.Source.Edit" },
  { id = "WorkbenchExtension/RetargetSourceCommit", event = "Submit", route = "WorkbenchExtension.Retarget.Source.Commit" },
]

[nodes.retarget_target_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionRetargetTargetField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Target: SK_Robot" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/RetargetTargetEdit", event = "Change", route = "WorkbenchExtension.Retarget.Target.Edit" },
  { id = "WorkbenchExtension/RetargetTargetCommit", event = "Submit", route = "WorkbenchExtension.Retarget.Target.Commit" },
]

[nodes.retarget_solver_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionRetargetSolverDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Full Body IK", value = "FullBodyIK", options = ["FullBodyIK", "LimbIK", "FKOnly"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/RetargetSolverEdit", event = "Change", route = "WorkbenchExtension.Retarget.Solver.Edit" },
  { id = "WorkbenchExtension/RetargetSolverCommit", event = "Submit", route = "WorkbenchExtension.Retarget.Solver.Commit" },
]
