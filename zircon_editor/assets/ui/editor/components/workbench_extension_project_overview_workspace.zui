[asset]
kind = "component"
id = "res://ui/editor/components/workbench_extension_project_overview_workspace.zui"
version = 2
display_name = "Workbench Extension Project Overview Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionProjectOverviewWorkspace]
root = "project_overview_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.project_overview_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionProjectOverviewWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "project_overview_rail_gap" }, { node = "project_overview_left" }, { node = "project_overview_center" }, { node = "project_overview_right" }]

[nodes.project_overview_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionProjectOverviewRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.project_overview_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionProjectOverviewLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "project_overview_title" }, { node = "project_overview_summary_tab" }, { node = "project_overview_targets_tab" }, { node = "project_overview_releases_tab" }, { node = "project_overview_project_row" }, { node = "project_overview_milestone_row" }, { node = "project_overview_risk_row" }]

[nodes.project_overview_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionProjectOverviewTitle"
props = { text = "Project Overview" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.project_overview_summary_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionProjectOverviewSummaryTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Summary", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewSummaryTab", event = "Click", route = "WorkbenchExtension.ProjectOverview.Summary" }]

[nodes.project_overview_targets_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionProjectOverviewTargetsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Targets", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewTargetsTab", event = "Click", route = "WorkbenchExtension.ProjectOverview.Targets" }]

[nodes.project_overview_releases_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionProjectOverviewReleasesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Releases", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewReleasesTab", event = "Click", route = "WorkbenchExtension.ProjectOverview.Releases" }]

[nodes.project_overview_project_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionProjectOverviewProjectRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "NebulaGame", icon = "folder", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewProjectRow", event = "Click", route = "WorkbenchExtension.ProjectOverview.Project" }]

[nodes.project_overview_milestone_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionProjectOverviewMilestoneRow"
classes = ["workbench-list-row"]
props = { text = "Milestone M3", icon = "flag", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewMilestoneRow", event = "Click", route = "WorkbenchExtension.ProjectOverview.Milestone" }]

[nodes.project_overview_risk_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionProjectOverviewRiskRow"
classes = ["workbench-list-row"]
props = { text = "Release Risks", icon = "alert", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewRiskRow", event = "Click", route = "WorkbenchExtension.ProjectOverview.Risks" }]

[nodes.project_overview_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionProjectOverviewCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "project_overview_center_header" }, { node = "project_overview_status_table" }, { node = "project_overview_output" }]

[nodes.project_overview_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionProjectOverviewCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "project_overview_center_title" }, { node = "project_overview_header_fill" }, { node = "project_overview_refresh_button" }, { node = "project_overview_publish_button" }]

[nodes.project_overview_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionProjectOverviewCenterTitle"
props = { text = "Project Health Board" }
layout = { width = { min = 240.0, preferred = 240.0, max = 300.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.project_overview_header_fill]
component = "Container"
control_id = "WorkbenchExtensionProjectOverviewHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.project_overview_refresh_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionProjectOverviewRefreshButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Refresh", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewRefresh", event = "Click", route = "WorkbenchExtension.ProjectOverview.Refresh" }]

[nodes.project_overview_publish_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionProjectOverviewPublishButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Publish", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewPublish", event = "Click", route = "WorkbenchExtension.ProjectOverview.Publish" }]

[nodes.project_overview_status_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionProjectOverviewStatusTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "project_overview_health_row" }, { node = "project_overview_build_row" }, { node = "project_overview_coverage_row" }, { node = "project_overview_dependency_row" }]

[nodes.project_overview_health_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionProjectOverviewHealthRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Project Health", value_text = "Healthy   All systems nominal" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewHealthRow", event = "Click", route = "WorkbenchExtension.ProjectOverview.Status.Health" }]

[nodes.project_overview_build_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionProjectOverviewBuildRow"
classes = ["workbench-table-row"]
props = { text = "Build Status", value_text = "Success   Win64 Development" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewBuildRow", event = "Click", route = "WorkbenchExtension.ProjectOverview.Status.Build" }]

[nodes.project_overview_coverage_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionProjectOverviewCoverageRow"
classes = ["workbench-table-row"]
props = { text = "Test Coverage", value_text = "72 percent   1248 / 1728" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewCoverageRow", event = "Click", route = "WorkbenchExtension.ProjectOverview.Status.Coverage" }]

[nodes.project_overview_dependency_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionProjectOverviewDependencyRow"
classes = ["workbench-table-row"]
props = { text = "Module Dependencies", value_text = "Core -> Engine -> Gameplay   2 warnings" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewDependencyRow", event = "Click", route = "WorkbenchExtension.ProjectOverview.Status.Dependencies" }]

[nodes.project_overview_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionProjectOverviewOutputRow"
classes = ["workbench-table-row"]
props = { text = "Overview", value_text = "Healthy   7 tasks   3 build jobs" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/ProjectOverviewOutput", event = "Click", route = "WorkbenchExtension.ProjectOverview.Output" }]

[nodes.project_overview_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionProjectOverviewRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "project_overview_details_title" }, { node = "project_overview_owner_field" }, { node = "project_overview_channel_dropdown" }, { node = "project_overview_health_dropdown" }]

[nodes.project_overview_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionProjectOverviewDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.project_overview_owner_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionProjectOverviewOwnerField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "Owner: Editor Team" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ProjectOverviewOwnerEdit", event = "Change", route = "WorkbenchExtension.ProjectOverview.Owner.Edit" },
  { id = "WorkbenchExtension/ProjectOverviewOwnerCommit", event = "Submit", route = "WorkbenchExtension.ProjectOverview.Owner.Commit" },
]

[nodes.project_overview_channel_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionProjectOverviewChannelDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Development", value = "Development", options = ["Development", "Release", "Hotfix"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ProjectOverviewChannelEdit", event = "Change", route = "WorkbenchExtension.ProjectOverview.Channel.Edit" },
  { id = "WorkbenchExtension/ProjectOverviewChannelCommit", event = "Submit", route = "WorkbenchExtension.ProjectOverview.Channel.Commit" },
]

[nodes.project_overview_health_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionProjectOverviewHealthDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Healthy", value = "Healthy", options = ["Healthy", "Warning", "Blocked"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/ProjectOverviewHealthEdit", event = "Change", route = "WorkbenchExtension.ProjectOverview.Health.Edit" },
  { id = "WorkbenchExtension/ProjectOverviewHealthCommit", event = "Submit", route = "WorkbenchExtension.ProjectOverview.Health.Commit" },
]
