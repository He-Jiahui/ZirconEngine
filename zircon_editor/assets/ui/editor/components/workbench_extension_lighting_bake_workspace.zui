[asset]
kind = "component"
id = "res://ui/editor/components/workbench_extension_lighting_bake_workspace.zui"
version = 2
display_name = "Workbench Extension Lighting Bake Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []
[components.WorkbenchExtensionLightingBakeWorkspace]
root = "lighting_bake_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.lighting_bake_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionLightingBakeWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_rail_gap" }, { node = "lighting_bake_left" }, { node = "lighting_bake_center" }, { node = "lighting_bake_right" }]

[nodes.lighting_bake_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionLightingBakeRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.lighting_bake_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionLightingBakeLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_title" }, { node = "lighting_bake_levels_tab" }, { node = "lighting_bake_probes_tab" }, { node = "lighting_bake_warnings_tab" }, { node = "lighting_bake_scene_row" }, { node = "lighting_bake_interior_row" }, { node = "lighting_bake_reflection_probe_row" }]

[nodes.lighting_bake_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionLightingBakeTitle"
props = { text = "Lighting Bake" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.lighting_bake_levels_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionLightingBakeLevelsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Levels", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeLevelsTab", event = "Click", route = "WorkbenchExtension.LightingBake.Levels" }]

[nodes.lighting_bake_probes_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionLightingBakeProbesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Probes", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeProbesTab", event = "Click", route = "WorkbenchExtension.LightingBake.Probes" }]

[nodes.lighting_bake_warnings_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionLightingBakeWarningsTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Warnings", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeWarningsTab", event = "Click", route = "WorkbenchExtension.LightingBake.Warnings" }]

[nodes.lighting_bake_scene_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionLightingBakeSceneBakeRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "City_Block_A", icon = "sun", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeSceneBakeRow", event = "Click", route = "WorkbenchExtension.LightingBake.Level.CityBlock" }]

[nodes.lighting_bake_interior_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionLightingBakeInteriorBakeRow"
classes = ["workbench-list-row"]
props = { text = "Interior_Lab", icon = "cube", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeInteriorBakeRow", event = "Click", route = "WorkbenchExtension.LightingBake.Level.Interior" }]

[nodes.lighting_bake_reflection_probe_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionLightingBakeReflectionProbeRow"
classes = ["workbench-list-row"]
props = { text = "Reflection Probe Grid", icon = "grid", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeReflectionProbeRow", event = "Click", route = "WorkbenchExtension.LightingBake.ProbeGrid" }]

[nodes.lighting_bake_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionLightingBakeCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_center_header" }, { node = "lighting_bake_queue_table" }, { node = "lighting_bake_output" }]

[nodes.lighting_bake_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionLightingBakeCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "lighting_bake_center_title" }, { node = "lighting_bake_header_fill" }, { node = "lighting_bake_preview_button" }, { node = "lighting_bake_bake_button" }]

[nodes.lighting_bake_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionLightingBakeCenterTitle"
props = { text = "Bake Queue" }
layout = { width = { min = 180.0, preferred = 180.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.lighting_bake_header_fill]
component = "Container"
control_id = "WorkbenchExtensionLightingBakeHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.lighting_bake_preview_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionLightingBakePreviewButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Preview", button_variant = "outlined", button_color = "secondary", background_color = "#1a1f23", border_color = "#303840" }
layout = { width = { min = 78.0, preferred = 78.0, max = 88.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakePreview", event = "Click", route = "WorkbenchExtension.LightingBake.Preview" }]

[nodes.lighting_bake_bake_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionLightingBakeBakeButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Bake", button_variant = "filled", button_color = "accent", background_color = "#12383d", border_color = "#209fa8", selected = true, checked = true }
layout = { width = { min = 72.0, preferred = 72.0, max = 82.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeBake", event = "Click", route = "WorkbenchExtension.LightingBake.Bake" }]

[nodes.lighting_bake_queue_table]
component = "VerticalGroup"
control_id = "WorkbenchExtensionLightingBakeQueueTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_shadow_map_row" }, { node = "lighting_bake_lightmap_uv_row" }, { node = "lighting_bake_probe_grid_row" }, { node = "lighting_bake_bleed_warning_row" }]

[nodes.lighting_bake_shadow_map_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeShadowMapTableRow"
classes = ["workbench-table-row"]
props = { text = "Shadow Maps", value_text = "4096 px   Stationary   Ready", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeShadowMapTableRow", event = "Click", route = "WorkbenchExtension.LightingBake.Queue.ShadowMap" }]

[nodes.lighting_bake_lightmap_uv_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeLightmapUvTableRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Lightmap UV", value_text = "87 assets   4 warnings   Selected", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeLightmapUvTableRow", event = "Click", route = "WorkbenchExtension.LightingBake.Queue.LightmapUv" }]

[nodes.lighting_bake_probe_grid_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeProbeGridTableRow"
classes = ["workbench-table-row"]
props = { text = "Probe Grid", value_text = "12 volumes   Adaptive   Ready" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeProbeGridTableRow", event = "Click", route = "WorkbenchExtension.LightingBake.Queue.ProbeGrid" }]

[nodes.lighting_bake_bleed_warning_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeBleedWarningTableRow"
classes = ["workbench-table-row"]
props = { text = "Bleed Warning", value_text = "Interior_Lab   6 texels   Warning" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeBleedWarningTableRow", event = "Click", route = "WorkbenchExtension.LightingBake.Queue.BleedWarning" }]

[nodes.lighting_bake_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionLightingBakeOutputRow"
classes = ["workbench-table-row"]
props = { text = "Lighting", value_text = "Preview ready   4 warnings   estimate 02:30" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/LightingBakeOutput", event = "Click", route = "WorkbenchExtension.LightingBake.Output" }]

[nodes.lighting_bake_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionLightingBakeRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "lighting_bake_details_title" }, { node = "lighting_bake_quality_dropdown" }, { node = "lighting_bake_target_field" }, { node = "lighting_bake_denoise_dropdown" }]

[nodes.lighting_bake_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionLightingBakeDetailsTitle"
props = { text = "Bake Settings" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.lighting_bake_quality_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionLightingBakeQualityDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Quality: Production", value = "production", options = ["preview", "medium", "production"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/LightingBakeQualityEdit", event = "Change", route = "WorkbenchExtension.LightingBake.Quality.Edit" },
  { id = "WorkbenchExtension/LightingBakeQualityCommit", event = "Submit", route = "WorkbenchExtension.LightingBake.Quality.Commit" },
]

[nodes.lighting_bake_target_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionLightingBakeTargetField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "City_Block_A" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/LightingBakeTargetEdit", event = "Change", route = "WorkbenchExtension.LightingBake.Target.Edit" },
  { id = "WorkbenchExtension/LightingBakeTargetCommit", event = "Submit", route = "WorkbenchExtension.LightingBake.Target.Commit" },
]

[nodes.lighting_bake_denoise_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionLightingBakeDenoiseDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Denoise: High", value = "high", options = ["off", "medium", "high"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/LightingBakeDenoiseEdit", event = "Change", route = "WorkbenchExtension.LightingBake.Denoise.Edit" },
  { id = "WorkbenchExtension/LightingBakeDenoiseCommit", event = "Submit", route = "WorkbenchExtension.LightingBake.Denoise.Commit" },
]
