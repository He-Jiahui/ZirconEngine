[asset]
kind = "component"
id = "res://ui/editor/components/workbench_extension_build_export_workspace.zui"
version = 2
display_name = "Workbench Extension Build Export Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench_button.zui#WorkbenchButton",
  "res://ui/editor/components/workbench_dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench_field.zui#WorkbenchField",
  "res://ui/editor/components/workbench_list_row.zui#WorkbenchListRow",
  "res://ui/editor/components/workbench_property_row.zui#WorkbenchPropertyRow",
  "res://ui/editor/components/workbench_section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/components/workbench_tab.zui#WorkbenchTab",
  "res://ui/editor/components/workbench_table_row.zui#WorkbenchTableRow",
]
styles = []

[components.WorkbenchExtensionBuildExportWorkspace]
root = "build_export_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.build_export_workspace]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionBuildExportWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = 10.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "build_export_rail_gap" }, { node = "build_export_left" }, { node = "build_export_center" }, { node = "build_export_right" }]

[nodes.build_export_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionBuildExportRailGap"
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.build_export_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionBuildExportLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "build_export_title" }, { node = "build_export_profiles_tab" }, { node = "build_export_queue_tab" }, { node = "build_export_signing_tab" }, { node = "build_export_shipping_row" }, { node = "build_export_development_row" }, { node = "build_export_patch_row" }]

[nodes.build_export_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionBuildExportTitle"
props = { text = "Build Export" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.build_export_profiles_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionBuildExportProfilesTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Profiles", checked = true, selected = true, value = true }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportProfilesTab", event = "Click", route = "WorkbenchExtension.BuildExport.Profiles" }]

[nodes.build_export_queue_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionBuildExportQueueTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Queue", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportQueueTab", event = "Click", route = "WorkbenchExtension.BuildExport.Queue" }]

[nodes.build_export_signing_tab]
component = "WorkbenchTab"
control_id = "WorkbenchExtensionBuildExportSigningTab"
classes = ["workbench-tab", "workbench-module-panel-tab"]
props = { text = "Signing", checked = false, selected = false, value = false }
layout = { width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportSigningTab", event = "Click", route = "WorkbenchExtension.BuildExport.Signing" }]

[nodes.build_export_shipping_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionBuildExportShippingRow"
classes = ["workbench-list-row", "workbench-row-selected"]
props = { text = "Shipping Win64", icon = "package", selected = true }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportShippingRow", event = "Click", route = "WorkbenchExtension.BuildExport.Profile.Shipping" }]

[nodes.build_export_development_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionBuildExportDevelopmentRow"
classes = ["workbench-list-row"]
props = { text = "Development QA", icon = "gear", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportDevelopmentRow", event = "Click", route = "WorkbenchExtension.BuildExport.Profile.Development" }]

[nodes.build_export_patch_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionBuildExportPatchRow"
classes = ["workbench-list-row"]
props = { text = "Patch 1.2", icon = "file", selected = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportPatchRow", event = "Click", route = "WorkbenchExtension.BuildExport.Profile.Patch" }]

[nodes.build_export_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionBuildExportCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "build_export_center_header" }, { node = "build_export_queue" }, { node = "build_export_output" }]

[nodes.build_export_center_header]
component = "HorizontalGroup"
control_id = "WorkbenchExtensionBuildExportCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = 8.0 }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "build_export_center_title" }, { node = "build_export_header_fill" }, { node = "build_export_validate_button" }, { node = "build_export_package_button" }]

[nodes.build_export_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionBuildExportCenterTitle"
props = { text = "Package Queue" }
layout = { width = { min = 220.0, preferred = 220.0, max = 280.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.build_export_header_fill]
component = "Container"
control_id = "WorkbenchExtensionBuildExportHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.build_export_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionBuildExportValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "outlined", button_color = "secondary" }
layout = { width = { min = 86.0, preferred = 86.0, max = 96.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportValidate", event = "Click", route = "WorkbenchExtension.BuildExport.Validate" }]

[nodes.build_export_package_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionBuildExportPackageButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Package", button_variant = "filled", button_color = "accent", selected = true, checked = true }
layout = { width = { min = 88.0, preferred = 88.0, max = 98.0, stretch = "Fixed" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportPackage", event = "Click", route = "WorkbenchExtension.BuildExport.Package" }]

[nodes.build_export_queue]
component = "VerticalGroup"
control_id = "WorkbenchExtensionBuildExportQueue"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { background_color = "#10161a", border_color = "#263239", border_width = 1.0, corner_radius = 6.0 }
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "build_export_cook_step_row" }, { node = "build_export_pak_step_row" }, { node = "build_export_sign_step_row" }, { node = "build_export_publish_step_row" }]

[nodes.build_export_cook_step_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionBuildExportCookStepRow"
classes = ["workbench-table-row", "workbench-row-selected"]
props = { text = "Cook Content", value_text = "Running   62%   Selected" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportCookStepRow", event = "Click", route = "WorkbenchExtension.BuildExport.Step.Cook" }]

[nodes.build_export_pak_step_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionBuildExportPakStepRow"
classes = ["workbench-table-row"]
props = { text = "Package Paks", value_text = "Queued   0%   Waiting" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportPakStepRow", event = "Click", route = "WorkbenchExtension.BuildExport.Step.Pak" }]

[nodes.build_export_sign_step_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionBuildExportSignStepRow"
classes = ["workbench-table-row"]
props = { text = "Sign Installer", value_text = "Ready   Cert OK   Waiting" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportSignStepRow", event = "Click", route = "WorkbenchExtension.BuildExport.Step.Sign" }]

[nodes.build_export_publish_step_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionBuildExportPublishStepRow"
classes = ["workbench-table-row"]
props = { text = "Publish Build", value_text = "Waiting   CDN   Pending" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportPublishStepRow", event = "Click", route = "WorkbenchExtension.BuildExport.Step.Publish" }]

[nodes.build_export_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionBuildExportOutputRow"
classes = ["workbench-table-row"]
props = { text = "Export", value_text = "Win64 Shipping   62%   4 steps" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/BuildExportOutput", event = "Click", route = "WorkbenchExtension.BuildExport.Output" }]

[nodes.build_export_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionBuildExportRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
layout = { container = { kind = "VerticalBox", gap = 8.0 }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "build_export_details_title" }, { node = "build_export_platform_dropdown" }, { node = "build_export_channel_field" }, { node = "build_export_compression_dropdown" }]

[nodes.build_export_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionBuildExportDetailsTitle"
props = { text = "Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.build_export_platform_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionBuildExportPlatformDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Win64", value = "Win64", options = ["Win64", "Linux", "Android"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/BuildExportPlatformEdit", event = "Change", route = "WorkbenchExtension.BuildExport.Platform.Edit" },
  { id = "WorkbenchExtension/BuildExportPlatformCommit", event = "Submit", route = "WorkbenchExtension.BuildExport.Platform.Commit" },
]

[nodes.build_export_channel_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionBuildExportChannelField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "ReleaseCandidate" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/BuildExportChannelEdit", event = "Change", route = "WorkbenchExtension.BuildExport.Channel.Edit" },
  { id = "WorkbenchExtension/BuildExportChannelCommit", event = "Submit", route = "WorkbenchExtension.BuildExport.Channel.Commit" },
]

[nodes.build_export_compression_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionBuildExportCompressionDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { text = "Oodle", value = "Oodle", options = ["Oodle", "Zstd", "None"] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/BuildExportCompressionEdit", event = "Change", route = "WorkbenchExtension.BuildExport.Compression.Edit" },
  { id = "WorkbenchExtension/BuildExportCompressionCommit", event = "Submit", route = "WorkbenchExtension.BuildExport.Compression.Commit" },
]
