stylesheets = []

[asset]
kind = "view"
id = "res://ui/editor/welcome.zui"
version = 2
display_name = "Welcome"

[imports]
styles = ["res://ui/theme/editor_base.zui", "res://ui/theme/editor_material.zui", "res://ui/editor/theme/editor_tokens.zui"]

[root]
node = "welcome_root"

[nodes.top_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.panel_padding", preferred = "$editor.density.panel_padding", max = "$editor.density.panel_padding", stretch = "Fixed" } }

[nodes.left_space]
component = "Space"
layout = { width = { min = "$editor.density.panel_padding", preferred = "$editor.density.panel_padding", max = "$editor.density.panel_padding", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.recent_panel_top_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.panel_padding", preferred = "$editor.density.panel_padding", max = "$editor.density.panel_padding", stretch = "Fixed" } }

[nodes.recent_header_panel]
component = "Space"
control_id = "WelcomeRecentHeaderPanel"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.large", preferred = "$editor.control.height.large", max = "$editor.control.height.large", stretch = "Fixed" } }

[nodes.recent_header_list_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.medium", preferred = "$editor.density.gap.medium", max = "$editor.density.gap.medium", stretch = "Fixed" } }

[nodes.recent_list_panel]
component = "Space"
control_id = "WelcomeRecentListPanel"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, scroll = { vertical = true } }

[nodes.recent_panel]
component = "VerticalBox"
control_id = "WelcomeRecentPanel"
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { min = 120.0, preferred = 220.0, max = 320.0, weight = 1.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "recent_panel_top_space" }, { node = "recent_header_panel" }, { node = "recent_header_list_gap" }, { node = "recent_list_panel" }]

[nodes.main_panel_top_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.panel_padding", preferred = "$editor.density.panel_padding", max = "$editor.density.panel_padding", stretch = "Fixed" } }

[nodes.startup_chooser_button_workbench]
component = "Button"
control_id = "WelcomeStartupWorkbenchButton"
classes = ["showcase-field", "material-control", "material-button", "material-text-button"]
props = { text = "Default Workbench", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", height = "$editor.control.height.compact" }
events = [{ id = "Welcome/OpenStartupWorkbench", event = "Click", route = "workbench.welcome.open_startup_workbench" }]

[nodes.startup_chooser_button_demo]
component = "Button"
control_id = "WelcomeStartupDemoButton"
classes = ["showcase-field", "material-control", "material-button", "material-text-button"]
props = { text = "Component Showcase", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", height = "$editor.control.height.compact" }
events = [{ id = "Welcome/OpenStartupDemo", event = "Click", route = "workbench.welcome.open_startup_demo" }]

[nodes.startup_chooser_button_asset]
component = "Button"
control_id = "WelcomeStartupAssetWindowButton"
classes = ["showcase-field", "material-control", "material-button", "material-text-button"]
props = { text = "Asset Window", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", height = "$editor.control.height.compact" }
events = [{ id = "Welcome/OpenStartupAssetWindow", event = "Click", route = "workbench.welcome.open_startup_asset_window" }]

[nodes.startup_chooser_button_ui_layout]
component = "Button"
control_id = "WelcomeStartupUILayoutEditorButton"
classes = ["showcase-field", "material-control", "material-button", "material-text-button"]
props = { text = "UI Layout Editor", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", height = "$editor.control.height.compact" }
events = [{ id = "Welcome/OpenStartupUILayoutEditor", event = "Click", route = "workbench.welcome.open_startup_ui_layout_editor" }]

[nodes.startup_chooser_row]
component = "HorizontalBox"
control_id = "WelcomeStartupChooserRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.compact", preferred = "$editor.control.height.compact", max = "$editor.control.height.compact", stretch = "Fixed" } }
children = [
  { node = "startup_chooser_button_workbench" },
  { node = "startup_chooser_button_demo" },
  { node = "startup_chooser_button_asset" },
  { node = "startup_chooser_button_ui_layout" },
]

[nodes.hero_panel]
component = "Space"
control_id = "WelcomeHeroPanel"
layout = { width = { max = 680.0, stretch = "Stretch" }, height = { min = 84.0, preferred = 84.0, max = 84.0, stretch = "Fixed" } }

[nodes.hero_status_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.large", preferred = "$editor.density.gap.large", max = "$editor.density.gap.large", stretch = "Fixed" } }

[nodes.status_panel]
component = "Space"
control_id = "WelcomeStatusPanel"
layout = { width = { max = 680.0, stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" } }

[nodes.actions_optional_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 12.0, preferred = 12.0, max = 12.0, stretch = "Fixed" } }

[nodes.new_project_header_panel]
component = "Space"
control_id = "WelcomeNewProjectHeaderPanel"
layout = { width = { max = 680.0, stretch = "Stretch" }, height = { min = 36.0, preferred = 36.0, max = 36.0, stretch = "Fixed" } }

[nodes.new_project_name_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.medium", preferred = "$editor.density.gap.medium", max = "$editor.density.gap.medium", stretch = "Fixed" } }

[nodes.project_name_label]
component = "Label"
control_id = "WelcomeProjectNameLabel"
props = { text = "Project name", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { max = 680.0, stretch = "Stretch" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = "Fixed" } }

[nodes.project_name_label_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.small", preferred = "$editor.density.gap.small", max = "$editor.density.gap.small", stretch = "Fixed" } }

[nodes.project_name_field]
component = "TextField"
control_id = "WelcomeProjectNameField"
classes = ["showcase-field", "material-control", "material-outlined-field"]
props = { value = "ZirconProject", placeholder = "Project name", validation_level = "normal", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", height = "$editor.control.height.large" }
layout = { width = { max = 680.0, stretch = "Stretch" }, height = { min = "$editor.control.height.large", preferred = "$editor.control.height.large", max = "$editor.control.height.large", stretch = "Fixed" } }

[nodes.project_name_location_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.medium", preferred = "$editor.density.gap.medium", max = "$editor.density.gap.medium", stretch = "Fixed" } }

[nodes.location_label]
component = "Label"
control_id = "WelcomeLocationLabel"
props = { text = "Location", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { max = 680.0, stretch = "Stretch" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = "Fixed" } }

[nodes.location_label_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.small", preferred = "$editor.density.gap.small", max = "$editor.density.gap.small", stretch = "Fixed" } }

[nodes.location_field]
component = "TextField"
control_id = "WelcomeLocationField"
classes = ["showcase-field", "material-control", "material-outlined-field"]
props = { value = "Documents/ZirconProjects", placeholder = "Location", validation_level = "normal", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", height = "$editor.control.height.large" }
layout = { width = { max = 680.0, stretch = "Stretch" }, height = { min = "$editor.control.height.large", preferred = "$editor.control.height.large", max = "$editor.control.height.large", stretch = "Fixed" } }

[nodes.location_validation_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.medium", preferred = "$editor.density.gap.medium", max = "$editor.density.gap.medium", stretch = "Fixed" } }

[nodes.status_preview_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.large", preferred = "$editor.density.gap.large", max = "$editor.density.gap.large", stretch = "Fixed" } }

[nodes.preview_panel]
component = "Space"
control_id = "WelcomePreviewPanel"
layout = { width = { max = 680.0, stretch = "Stretch" }, height = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" } }

[nodes.preview_bottom_fill]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.validation_panel]
component = "Space"
control_id = "WelcomeValidationPanel"
layout = { width = { max = 680.0, stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.validation_actions_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.gap.medium", preferred = "$editor.density.gap.medium", max = "$editor.density.gap.medium", stretch = "Fixed" } }

[nodes.actions_row_fill]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.open_existing_button]
component = "Button"
control_id = "WelcomeOpenExistingButton"
classes = ["showcase-field", "material-control", "material-button", "material-text-button"]
props = { text = "Open", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", height = "$editor.control.height.default" }
events = [{ id = "Welcome/OpenExisting", event = "Click", route = "workbench.welcome.open_existing" }]

[nodes.create_project_button]
component = "Button"
control_id = "WelcomeCreateProjectButton"
classes = ["showcase-field", "material-control", "material-button", "material-button-primary"]
props = { text = "Create Project", surface_variant = "accent", button_variant = "primary", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", validation_level = "normal", height = "$editor.control.height.default" }
events = [{ id = "Welcome/CreateProject", event = "Click", route = "workbench.welcome.create_project" }]

[nodes.actions_row]
component = "HorizontalBox"
control_id = "WelcomeActionsRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { max = 680.0, stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
children = [
  { node = "actions_row_fill" },
  { node = "open_existing_button", slot = { layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" } } } },
  { node = "create_project_button", slot = { layout = { width = { min = 118.0, preferred = 118.0, max = 118.0, stretch = "Fixed" } } } },
]

[nodes.main_panel_bottom_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.panel_padding", preferred = "$editor.density.panel_padding", max = "$editor.density.panel_padding", stretch = "Fixed" } }

[nodes.main_panel]
component = "VerticalBox"
control_id = "WelcomeMainPanel"
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { min = 160.0, preferred = 480.0, max = 680.0, weight = 4.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "main_panel_top_space" },
  { node = "new_project_header_panel", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "new_project_name_gap" },
  { node = "project_name_label", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "project_name_label_gap" },
  { node = "project_name_field", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "project_name_location_gap" },
  { node = "location_label", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "location_label_gap" },
  { node = "location_field", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "location_validation_gap" },
  { node = "validation_panel", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "validation_actions_gap" },
  { node = "actions_row", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "actions_optional_gap" },
  { node = "hero_panel", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "hero_status_gap" },
  { node = "status_panel", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "status_preview_gap" },
  { node = "preview_panel", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "preview_bottom_fill" },
  { node = "startup_chooser_row", slot = { layout = { padding = { left = "$editor.density.panel_padding", right = "$editor.density.panel_padding" } } } },
  { node = "main_panel_bottom_space" },
]

[nodes.outer_panel]
component = "HorizontalBox"
control_id = "WelcomeOuterPanel"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "recent_panel" }, { node = "main_panel" }]

[nodes.right_space]
component = "Space"
layout = { width = { min = "$editor.density.panel_padding", preferred = "$editor.density.panel_padding", max = "$editor.density.panel_padding", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.content_row]
component = "HorizontalBox"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "left_space" }, { node = "outer_panel" }, { node = "right_space" }]

[nodes.bottom_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.density.panel_padding", preferred = "$editor.density.panel_padding", max = "$editor.density.panel_padding", stretch = "Fixed" } }

[nodes.welcome_root]
component = "VerticalBox"
control_id = "WelcomeRoot"
classes = ["editor-shell", "showcase-shell"]
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "top_space" }, { node = "content_row" }, { node = "bottom_space" }]
