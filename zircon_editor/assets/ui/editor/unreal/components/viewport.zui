props = { font = "res://fonts/editor-ui.font.toml", background_color = "$unreal_dropdown", hover_background_color = "#575757", pressed_background_color = "$unreal_input_outline", open_background_color = "$unreal_primary_press", disabled_background_color = "$unreal_panel", border_color = "$unreal_dropdown_outline", focus_border_color = "$unreal_primary", disabled_border_color = "$unreal_input_outline", foreground_color = "$unreal_foreground", label_color = "$unreal_foreground", icon_color = "$unreal_foreground", disabled_foreground_color = "$unreal_foreground_disabled", border_width = 1.0, corner_radius = 4.0, value = "15.0", value_text = "15", options = ["5.0|label=5", "15.0|label=15", "30.0|label=30", "45.0|label=45", "90.0|label=90"], input_focusable = true, font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
