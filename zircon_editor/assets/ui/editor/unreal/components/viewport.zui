props = { label = "Scale", icon = "editor_pages/scene_viewport/tools/scale.svg", icon_placement = "icon_only", selected = false, checked = false, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/ScaleMode", event = "Click", route = "workbench.viewport.activate_scene_mode" }]

[nodes.space]
component = "WorkbenchDropdown"
control_id = "SetTransformSpace"
classes = ["unreal-viewport-tool", "unreal-control"]
props = { font = "res://fonts/editor-ui.font.toml", background_color = "$unreal_dropdown", hover_background_color = "#575757", pressed_background_color = "$unreal_input_outline", open_background_color = "$unreal_primary_press", disabled_background_color = "$unreal_panel", border_color = "$unreal_dropdown_outline", focus_border_color = "$unreal_primary", disabled_border_color = "$unreal_input_outline", foreground_color = "$unreal_foreground", label_color = "$unreal_foreground", icon_color = "$unreal_foreground", disabled_foreground_color = "$unreal_foreground_disabled", border_width = 1.0, corner_radius = 4.0, value = "Local", value_text = "Local", options = ["Local|label=Local", "Global|label=World"], input_focusable = true, font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetTransformSpace", event = "Change", route = "workbench.viewport.set_transform_space" }]
