props = { label = "Select", icon = "editor_pages/scene_viewport/tools/select.svg", icon_placement = "icon_only", selected = false, checked = false, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SelectMode", event = "Click", route = "workbench.viewport.activate_scene_mode" }]

