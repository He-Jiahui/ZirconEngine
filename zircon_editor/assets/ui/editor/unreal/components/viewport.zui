[asset]
kind = "component"
id = "res://ui/editor/unreal/components/viewport.zui"
version = 2
display_name = "Unreal level viewport"

[imports]
widgets = [
  "res://ui/editor/workbench/primitives/inputs/dropdown.zui#WorkbenchDropdown",
]
styles = ["res://ui/editor/unreal/starship.zui"]

[components.UnrealLevelViewport]
root = "root"
default_classes = ["unreal-level-viewport"]

[nodes.root]
component = "VerticalGroup"
control_id = "UnrealLevelViewport"
classes = ["unreal-level-viewport"]
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, clip = true }
children = [{ node = "viewport" }]

[nodes.viewport]
component = "Overlay"
control_id = "UnrealSceneViewViewport"
classes = ["unreal-scene-view-viewport"]
layout = { container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, clip = true }
children = [{ node = "scene_media" }, { node = "toolbar_layer" }]

[nodes.scene_media]
component = "SceneViewViewport"
control_id = "WorkbenchViewportSurface"
classes = ["unreal-scene-media", "unreal-control"]
props = { input_interactive = true, input_hoverable = true, input_focusable = true, background_color = "$editor.surface.recessed" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_layer]
component = "Overlay"
control_id = "UnrealViewportToolbarLayer"
props = { layout_padding_left = 8.0, layout_padding_right = 8.0, layout_padding_top = 8.0 }
layout = { container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "toolbar" }]

[nodes.toolbar]
component = "Overlay"
control_id = "UnrealViewportToolbar"
classes = ["unreal-viewport-toolbar", "unreal-viewport-overlay-toolbar"]
props = { background_color = "$editor.surface.1", layout_padding_left = 4.0, layout_padding_right = 4.0, font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2, toolbar_overflow_row_control = "UnrealViewportToolbarRow", toolbar_overflow_group_controls = ["UnrealViewportProjectionGroup", "UnrealViewportDisplayGroup", "UnrealViewportShowGroup", "UnrealViewportTransformModeGroup", "UnrealViewportTransformSpaceGroup", "UnrealViewportPivotGroup", "ToggleTranslateSnapGroup", "ToggleRotateSnapGroup", "ToggleScaleSnapGroup", "UnrealViewportFrameSelectionGroup", "UnrealViewportAlignViewGroup"] }
layout = { container = { kind = "Overlay" }, anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 0.0, y = 0.0 }, width = { stretch = "Stretch" }, height = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" } }
children = [{ node = "toolbar_row" }, { node = "toolbar_overflow" }]

[nodes.toolbar_row]
component = "HorizontalGroup"
control_id = "UnrealViewportToolbarRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [ { node = "projection_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "display_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "show_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "toolbar_fill", slot = { layout = { linear_size = { rule = "Stretch", value = 1.0, shrink_value = 0.0 } } } }, { node = "transform_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "space_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "pivot_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "move_snap_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "rotate_snap_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "scale_snap_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "frame_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "align_group", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } }, { node = "toolbar_more", slot = { layout = { linear_size = { rule = "Auto", shrink_value = 0.0 } } } } ]

[nodes.toolbar_more]
component = "IconButton"
control_id = "UnrealViewportToolbarMore"
classes = ["unreal-viewport-tool", "unreal-control"]
props = { label = "More viewport controls", icon = "zircon_editor_shell/toolbar/more-horizontal.svg", icon_placement = "icon_only", selected = false, checked = false, visibility = "Collapsed", visible = false, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "UnrealViewportToolbarOverflow/Toggle", event = "Click", route = "workbench.unreal.viewport.overflow.open" }]

[nodes.toolbar_overflow]
component = "ScrollableBox"
control_id = "UnrealViewportToolbarOverflow"
classes = ["unreal-viewport-overflow", "unreal-control"]
props = { toolbar_overflow_role = "toolbar-overflow", popup_open = false, selected = false, visibility = "Collapsed", visible = false, background_color = "$unreal_panel", border_color = "$unreal_dropdown_outline", border_width = 1.0, corner_radius = 4.0, layout_padding_left = 4.0, layout_padding_right = 4.0, layout_padding_top = 4.0, layout_padding_bottom = 4.0, input_interactive = true, input_hoverable = true, input_focusable = true }
layout = { container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small" }, anchor = { x = 1.0, y = 1.0 }, pivot = { x = 1.0, y = 0.0 }, position = { x = 0.0, y = "$editor.density.gap.small" }, width = { stretch = "Fixed" }, height = { stretch = "Fixed" }, clip = true }
children = []

[nodes.toolbar_fill]
component = "Space"
control_id = "UnrealViewportToolbarFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.projection]
component = "WorkbenchDropdown"
control_id = "SetProjectionMode"
classes = ["unreal-viewport-tool", "unreal-control"]
props = { font = "res://fonts/editor-ui.font.toml", background_color = "$unreal_dropdown", hover_background_color = "#575757", pressed_background_color = "$unreal_input_outline", open_background_color = "$unreal_primary_press", disabled_background_color = "$unreal_panel", border_color = "$unreal_dropdown_outline", focus_border_color = "$unreal_primary", disabled_border_color = "$unreal_input_outline", foreground_color = "$unreal_foreground", label_color = "$unreal_foreground", icon_color = "$unreal_foreground", disabled_foreground_color = "$unreal_foreground_disabled", border_width = 1.0, corner_radius = 4.0, value = "Perspective", value_text = "Perspective", options = ["Perspective|label=Perspective", "Orthographic|label=Orthographic"], input_focusable = true, font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetProjectionMode", event = "Change", route = "workbench.viewport.set_projection_mode" }]
[nodes.display]
component = "WorkbenchDropdown"
control_id = "SetDisplayMode"
classes = ["unreal-viewport-tool", "unreal-control"]
props = { font = "res://fonts/editor-ui.font.toml", background_color = "$unreal_dropdown", hover_background_color = "#575757", pressed_background_color = "$unreal_input_outline", open_background_color = "$unreal_primary_press", disabled_background_color = "$unreal_panel", border_color = "$unreal_dropdown_outline", focus_border_color = "$unreal_primary", disabled_border_color = "$unreal_input_outline", foreground_color = "$unreal_foreground", label_color = "$unreal_foreground", icon_color = "$unreal_foreground", disabled_foreground_color = "$unreal_foreground_disabled", border_width = 1.0, corner_radius = 4.0, value = "Shaded", value_text = "Lit", options = ["Shaded|label=Lit", "WireOverlay|label=Wireframe Overlay", "WireOnly|label=Wireframe"], input_focusable = true, font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetDisplayMode", event = "Change", route = "workbench.viewport.set_display_mode" }]
[nodes.show]
component = "WorkbenchDropdown"
control_id = "SetGridMode"
classes = ["unreal-viewport-tool", "unreal-control"]
props = { font = "res://fonts/editor-ui.font.toml", background_color = "$unreal_dropdown", hover_background_color = "#575757", pressed_background_color = "$unreal_input_outline", open_background_color = "$unreal_primary_press", disabled_background_color = "$unreal_panel", border_color = "$unreal_dropdown_outline", focus_border_color = "$unreal_primary", disabled_border_color = "$unreal_input_outline", foreground_color = "$unreal_foreground", label_color = "$unreal_foreground", icon_color = "$unreal_foreground", disabled_foreground_color = "$unreal_foreground_disabled", border_width = 1.0, corner_radius = 4.0, value = "VisibleNoSnap", value_text = "Show", options = ["Hidden|label=Grid off", "VisibleNoSnap|label=Grid"], input_focusable = true, font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetGridMode", event = "Change", route = "workbench.viewport.set_grid_mode" }]
[nodes.select_mode]
component = "IconButton"
control_id = "SelectMode"
