[nodes.move_snap_group]
component = "HorizontalGroup"
control_id = "ToggleTranslateSnapGroup"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Fixed" }, height = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" } }
children = [{ node = "move_snap_toggle" }, { node = "move_snap" }]

