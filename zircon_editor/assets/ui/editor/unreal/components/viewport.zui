props = { label = "Translation snapping", icon = "editor_pages/scene_viewport/snapping/grid-snap.svg", icon_placement = "icon_only", selected = true, checked = true, input_interactive = true, input_clickable = true, input_hoverable = true, input_focusable = true }
layout = { width = { min = "$editor.chrome.viewport_toolbar.height", preferred = "$editor.chrome.viewport_toolbar.height", max = "$editor.chrome.viewport_toolbar.height", stretch = "Fixed" }, height = { stretch = "Stretch" } }
