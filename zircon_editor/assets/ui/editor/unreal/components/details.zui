# Unreal Engine Details dock. Core snapshot owns selected object and property values.
[asset]
kind = "component"
id = "res://ui/editor/unreal/components/details.zui"
version = 2
display_name = "Unreal Details Panel"

[imports]
widgets = ["res://ui/editor/workbench/primitives/inputs/dropdown.zui#WorkbenchDropdown", "res://ui/editor/workbench/primitives/inputs/search_input.zui#WorkbenchSearchInput", "res://ui/editor/workbench/primitives/chrome/axis_value_field.zui#WorkbenchAxisValueField", "res://ui/editor/workbench/data/component_property_row.zui#WorkbenchComponentPropertyRow", "res://ui/editor/components/workbench/primitives/inputs/button.zui#WorkbenchButton"]
styles = ["res://ui/editor/unreal/starship.zui"]

[components.UnrealDetailsPanel]
root = "panel"
default_classes = ["unreal-details", "unreal-dock-panel"]

[nodes.panel]
component = "VerticalGroup"
control_id = "WorkbenchInspectorPanel"
classes = ["unreal-details", "unreal-dock-panel"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "tab" }, { node = "selection_hint" }, { node = "summary" }, { node = "add" }, { node = "search" }, { node = "content" }]

[nodes.tab]
component = "HorizontalGroup"
control_id = "RightDrawerHeaderRoot"
classes = ["unreal-dock-tab"]
layout = { container = { kind = "HorizontalBox" }, width = { stretch = "Stretch" }, height = { min = "$editor.chrome.panel_header.height", preferred = "$editor.chrome.panel_header.height", max = "$editor.chrome.panel_header.height", stretch = "Fixed" } }
children = [{ node = "title" }]

[nodes.title]
component = "Label"
control_id = "UnrealDetailsDockTitle"
props = { foreground_color = "$unreal_foreground_header", text = { text_key = "editor.workbench.details.title", table = "editor" }, font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

# Unreal Details shows a hint until the authoritative selection is available.
[nodes.selection_hint]
component = "Label"
control_id = "UnrealDetailsSelectionHint"
props = { text = "Select an object to view details.", text_align = "center", foreground_color = "$editor.text.secondary", layout_padding_top = 24.0, layout_padding_bottom = 4.0, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { stretch = "Stretch" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" } }

[nodes.summary]
component = "HorizontalGroup"
control_id = "UnrealDetailsNameArea"
props = { visibility = "collapsed" }
classes = ["unreal-details-name-area"]
layout = { container = { kind = "HorizontalBox" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
children = [{ node = "name" }]

[nodes.name]
component = "Label"
control_id = "WorkbenchInspectorTitle"
props = { text = "No Selection", text_overflow = "ellipsis", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.add]
component = "WorkbenchButton"
control_id = "WorkbenchAddComponent"
props = { text = { text_key = "editor.inspector.component_add.open", table = "editor" }, visibility = "collapsed", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "Inspector/AddComponent", event = "Click" }]

[nodes.search]
component = "WorkbenchSearchInput"
control_id = "WorkbenchInspectorFilter"
classes = ["unreal-panel-search"]
props = { query = "", placeholder = "Search Details", disabled = true, visibility = "collapsed", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
widget = { value_property = "query" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "Workbench/InspectorSearchEdit", event = "Change", component_event = "ValueChanged", route = "workbench.inspector.search.edit" }, { id = "Workbench/InspectorSearchCommit", event = "Submit", component_event = "Commit", route = "workbench.inspector.search.commit" }]

[nodes.content]
component = "ScrollableBox"
control_id = "RightDrawerContentRoot"
props = { input_hoverable = true, visibility = "collapsed" }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "component_add" }, { node = "metadata" }, { node = "transform" }, { node = "component" }, { node = "empty" }]

[nodes.metadata]
component = "HorizontalGroup"
control_id = "WorkbenchInspectorMetadata"
props = { visibility = "collapsed" }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "layer_label" }, { node = "layer" }]

[nodes.layer_label]
component = "Label"
control_id = "WorkbenchInspectorRenderLayerLabel"
props = { text = "Layer mask", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.layer]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchInspectorRenderLayerMask"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", placeholder = "1", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { min = 96.0, preferred = 112.0, max = 120.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "Inspector/RenderLayerMaskEdit", event = "Change", route = "workbench.inspector.render_layer_mask.edit" }, { id = "Inspector/RenderLayerMaskCommit", event = "Submit", route = "workbench.inspector.render_layer_mask.commit" }]

[nodes.transform]
component = "VerticalGroup"
control_id = "WorkbenchInspectorTransform"
props = { visibility = "collapsed" }
classes = ["unreal-property-category"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Fixed" } }
children = [{ node = "transform_title" }, { node = "position" }, { node = "rotation" }, { node = "scale" }]

[nodes.transform_title]
component = "Label"
control_id = "WorkbenchTransformLabel"
classes = ["unreal-category-header"]
props = { corner_radius = 4.0, border_width = 1.0, border_color = "$unreal_input_outline", foreground_color = "$unreal_foreground_header", background_color = "$unreal_header", text = "Transform", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 700, line_height_ratio = 1.2 }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }

[nodes.position]
component = "HorizontalGroup"
control_id = "WorkbenchTransformPosition"
props = { value = "" }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "position_label" }, { node = "position_x" }, { node = "position_y" }, { node = "position_z" }]

[nodes.position_label]
component = "Label"
control_id = "WorkbenchTransformPositionLabel"
props = { text = "Location", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { min = 64.0, preferred = 72.0, max = 88.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.position_x]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformPositionX"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
events = [{ id = "Inspector/TransformPositionXEdit", event = "Change", route = "workbench.inspector.transform.position_x.edit" }, { id = "Inspector/TransformPositionXCommit", event = "Submit", route = "workbench.inspector.transform.position_x.commit" }]

[nodes.position_y]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformPositionY"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
events = [{ id = "Inspector/TransformPositionYEdit", event = "Change", route = "workbench.inspector.transform.position_y.edit" }, { id = "Inspector/TransformPositionYCommit", event = "Submit", route = "workbench.inspector.transform.position_y.commit" }]

[nodes.position_z]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformPositionZ"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
events = [{ id = "Inspector/TransformPositionZEdit", event = "Change", route = "workbench.inspector.transform.position_z.edit" }, { id = "Inspector/TransformPositionZCommit", event = "Submit", route = "workbench.inspector.transform.position_z.commit" }]

[nodes.rotation]
component = "HorizontalGroup"
control_id = "WorkbenchTransformRotation"
props = { value = "" }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }
children = [{ node = "rotation_label" }, { node = "rotation_x" }, { node = "rotation_y" }, { node = "rotation_z" }]

[nodes.rotation_label]
component = "Label"
control_id = "WorkbenchTransformRotationLabel"
props = { text = "Rotation", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { min = 64.0, preferred = 72.0, max = 88.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.rotation_x]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformRotationX"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", disabled = true, editable_text = false, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }

[nodes.rotation_y]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformRotationY"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", disabled = true, editable_text = false, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }

[nodes.rotation_z]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformRotationZ"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", disabled = true, editable_text = false, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }

[nodes.scale]
component = "HorizontalGroup"
control_id = "WorkbenchTransformScale"
props = { value = "" }
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }
children = [{ node = "scale_label" }, { node = "scale_x" }, { node = "scale_y" }, { node = "scale_z" }]

[nodes.scale_label]
component = "Label"
control_id = "WorkbenchTransformScaleLabel"
props = { text = "Scale", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { min = 64.0, preferred = 72.0, max = 88.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.scale_x]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformScaleX"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
events = [{ id = "Inspector/TransformScaleXEdit", event = "Change", route = "workbench.inspector.transform.scale_x.edit" }, { id = "Inspector/TransformScaleXCommit", event = "Submit", route = "workbench.inspector.transform.scale_x.commit" }]

[nodes.scale_y]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformScaleY"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
events = [{ id = "Inspector/TransformScaleYEdit", event = "Change", route = "workbench.inspector.transform.scale_y.edit" }, { id = "Inspector/TransformScaleYCommit", event = "Submit", route = "workbench.inspector.transform.scale_y.commit" }]

[nodes.scale_z]
component = "WorkbenchAxisValueField"
control_id = "WorkbenchTransformScaleZ"
props = { corner_radius = 4.0, border_width = 1.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_input", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_input", value = "", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
events = [{ id = "Inspector/TransformScaleZEdit", event = "Change", route = "workbench.inspector.transform.scale_z.edit" }, { id = "Inspector/TransformScaleZCommit", event = "Submit", route = "workbench.inspector.transform.scale_z.commit" }]

[nodes.component]
component = "VerticalGroup"
control_id = "WorkbenchInspectorMesh"
props = { visibility = "collapsed" }
classes = ["unreal-property-category"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Fixed" } }
children = [{ node = "component_title" }, { node = "properties" }]

[nodes.component_title]
component = "Label"
control_id = "WorkbenchMeshLabel"
classes = ["unreal-category-header"]
props = { corner_radius = 4.0, border_width = 1.0, border_color = "$unreal_input_outline", foreground_color = "$unreal_foreground_header", background_color = "$unreal_header", text = "", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 700, line_height_ratio = 1.2 }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }

[nodes.properties]
component = "ScrollableBox"
control_id = "WorkbenchInspectorMeshProperties"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", scrollbar_visibility = "Auto", virtualization = { item_extent = 28.0, overscan = 2 } }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { min = 112.0, preferred = 112.0, max = 112.0, stretch = "Fixed" } }
repeat = { kind = "virtual_rows", prototype = "WorkbenchComponentPropertySlot04Row", virtual_control_prefix = "WorkbenchComponentPropertyVirtualRow", authored_count = 1, node_path_namespace = "v2" }
children = [{ node = "prototype" }]

[nodes.prototype]
component = "WorkbenchComponentPropertyRow"
control_id = "WorkbenchComponentPropertySlot04Row"
classes = ["unreal-property-row", "workbench-component-property-row"]
props = { corner_radius = 0.0, border_width = 0.0, disabled_foreground_color = "$unreal_foreground_disabled", placeholder_color = "$editor.text.secondary", foreground_color = "$unreal_foreground", disabled_border_color = "$editor.border.disabled", focus_border_color = "$unreal_primary", hover_border_color = "$unreal_input_outline", border_color = "$unreal_input_outline", disabled_background_color = "$editor.surface.disabled", focused_background_color = "$unreal_panel", pressed_background_color = "$editor.surface.3", hover_background_color = "#575757", background_color = "$unreal_panel", text = "", value = "", value_text = "", visibility = "collapsed", font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_size = 13.333333, font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
events = [{ id = "Inspector/ComponentProperty04Edit", event = "Change", route = "workbench.inspector.component_property04.edit" }, { id = "Inspector/ComponentProperty04Commit", event = "Submit", route = "workbench.inspector.component_property04.commit" }]

[nodes.empty]
component = "Label"
control_id = "WorkbenchInspectorFilterEmpty"
props = { text = "No matching properties", visibility = "collapsed", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 400, line_height_ratio = 1.2 }

# Inline creation picker uses RightDrawerContentRoot and adds no scroll owner.
[nodes.component_add]
component = "VerticalGroup"
control_id = "WorkbenchComponentAddPanel"
props = { visibility = "collapsed" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { min = 0.0, stretch = "Stretch" }, height = { stretch = "Fixed" } }
children = [{ node = "component_add_title" }, { node = "component_add_type" }, { node = "component_add_name" }, { node = "component_add_pages" }, { node = "component_add_required_label" }, { node = "component_add_required" }, { node = "component_add_values" }, { node = "component_add_feedback" }, { node = "component_add_actions" }]

[nodes.component_add_title]
component = "Label"
control_id = "WorkbenchComponentAddTitle"
props = { text = { text_key = "editor.inspector.component_add.title", table = "editor" }, text_overflow = "ellipsis", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 400, line_height_ratio = 1.2 }
layout = { width = { min = 0.0, stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }

[nodes.component_add_type]
component = "WorkbenchDropdown"
control_id = "WorkbenchComponentAddType"
props = { options = [], disabled_options = [], value = "", value_text = "", label = { text_key = "editor.inspector.component_add.type", table = "editor" }, popup_open = false, disabled = true }
layout = { width = { min = 0.0, stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "Inspector/ComponentAddType", event = "Click" }]

[nodes.component_add_name]
component = "Label"
control_id = "WorkbenchComponentAddName"
props = { text = "", text_overflow = "ellipsis", font_size = 13.333333, font = "res://fonts/editor-ui.font.toml", font_family = "Roboto", font_weight = 400, line_height_ratio = 1.2 }
