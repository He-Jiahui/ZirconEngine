control_id = "UnrealWindowMenuPopup"
props = { corner_radius = 4.0, border_width = 1.0, border_color = "$unreal_dropdown_outline", background_color = "$unreal_dropdown", foreground_color = "$unreal_foreground", line_height_ratio = 1.2, font_weight = 400, font_size = 13.333333, font_family = "Roboto", open = false, popup_open = false, input_interactive = true, menu_items = [] }

