[asset]
kind = "view"
id = "res://ui/editor/host/inspector_body.zui"
version = 2
display_name = "inspector pane body"

[imports]
widgets = []
styles = ["res://ui/editor/theme/editor_tokens.zui"]

[root]
node = "root"

[nodes.root]
component = "VerticalGroup"
control_id = "InspectorPaneBodyRoot"
classes = ["editor-pane", "inspector-pane", "panel"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "body" }]

[nodes.body]
component = "Container"
control_id = "InspectorBodySection"
classes = ["inspector-fields-host"]
layout = { clip = true, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
