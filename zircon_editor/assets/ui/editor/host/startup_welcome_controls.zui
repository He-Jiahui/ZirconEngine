[asset]
kind = "view"
id = "res://ui/editor/host/startup_welcome_controls.zui"
version = 2
display_name = "startup welcome controls"

[root]
node = "root"

[nodes.root]
component = "VerticalGroup"
control_id = "WelcomeSurfaceControls"
classes = ["editor-surface-controls", "welcome-controls"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "project_name" }, { node = "location" }, { node = "actions" }, { node = "recent_actions" }]

[nodes.project_name]
component = "InputField"
control_id = "ProjectNameEdited"
props = { label = "Project", placeholder = "Project name", value_text = "", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", layout_min_height = "$editor.control.height.default" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "WelcomeSurface/ProjectNameEdited", event = "Change", route = "workbench.welcome.set_project_name" }]

[nodes.location]
component = "InputField"
control_id = "LocationEdited"
props = { label = "Location", placeholder = "Project location", value_text = "", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", layout_min_height = "$editor.control.height.default" }
layout = { width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
events = [{ id = "WelcomeSurface/LocationEdited", event = "Change", route = "workbench.welcome.set_location" }]

[nodes.actions]
component = "HorizontalGroup"
control_id = "WelcomePrimaryActions"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
children = [{ node = "create" }, { node = "open_existing" }]

[nodes.create]
component = "IconButton"
control_id = "CreateProject"
props = { label = "Create", icon = "add-circle-outline", icon_placement = "leading", surface_variant = "accent", button_variant = "primary", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "WelcomeSurface/CreateProject", event = "Click", route = "workbench.welcome.create_project" }]

[nodes.open_existing]
component = "IconButton"
control_id = "OpenExistingProject"
props = { label = "Open", icon = "editor_pages/workbench/menu/open-project.svg", icon_placement = "leading", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "WelcomeSurface/OpenExistingProject", event = "Click", route = "workbench.welcome.open_existing_project" }]

[nodes.recent_actions]
component = "HorizontalGroup"
control_id = "WelcomeRecentActions"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "open_recent" }, { node = "remove_recent" }]

[nodes.open_recent]
component = "IconButton"
control_id = "OpenRecentProject"
props = { label = "Open Recent", icon = "editor_pages/asset_browser/navigation/recent.svg", icon_placement = "leading", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "WelcomeSurface/OpenRecentProject", event = "Click", route = "workbench.welcome.open_recent_project" }]

[nodes.remove_recent]
component = "IconButton"
control_id = "RemoveRecentProject"
props = { label = "Remove", icon = "editor_pages/workbench/tabs/close-tab.svg", icon_placement = "icon_only", surface_variant = "danger", text_tone = "danger", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control" }
layout = { width = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "WelcomeSurface/RemoveRecentProject", event = "Click", route = "workbench.welcome.remove_recent_project" }]
