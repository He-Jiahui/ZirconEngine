[asset]
kind = "view"
id = "res://ui/editor/host/runtime_diagnostics_body.zui"
version = 2
display_name = "runtime diagnostics pane body"

[root]
node = "root"

[nodes.root]
component = "VerticalGroup"
control_id = "RuntimeDiagnosticsPaneBodyRoot"
classes = ["editor-pane", "diagnostics-pane"]
layout = { container = { kind = "VerticalBox", gap = 4.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "header" }, { node = "reflector_nodes" }]

[nodes.header]
component = "HorizontalGroup"
control_id = "RuntimeDiagnosticsHeader"
layout = { container = { kind = "HorizontalBox", gap = 4.0 }, width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }
children = [{ node = "summary" }, { node = "focus" }]

[nodes.focus]
component = "IconButton"
control_id = "FocusDiagnostics"
props = { label = "Focus Diagnostics", icon = "editor_pages/console_profiler/diagnostics/watch.svg" }
layout = { width = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "RuntimeDiagnosticsPaneBody/FocusDiagnostics", event = "Click", route = "workbench.dock.focus_view" }]

[nodes.summary]
component = "Text"
control_id = "RuntimeDiagnosticsSummary"
props = { text = "Runtime diagnostics" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.reflector_nodes]
component = "Container"
control_id = "UiDebugReflectorNodeList"
layout = { clip = true, width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, scroll = { vertical = true } }
