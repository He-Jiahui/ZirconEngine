[asset]
kind = "view"
id = "res://ui/editor/host/pane_surface_controls.zui"
version = 2
display_name = "pane surface controls"

[root]
node = "root"

[nodes.root]
component = "HorizontalGroup"
control_id = "PaneSurfaceControlsRoot"
classes = ["editor-surface-controls", "pane-controls"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
