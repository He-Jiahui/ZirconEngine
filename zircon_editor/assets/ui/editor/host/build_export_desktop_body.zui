[asset]
kind = "view"
id = "res://ui/editor/host/build_export_desktop_body.zui"
version = 2
display_name = "desktop build export pane body"

[root]
node = "root"

[nodes.root]
component = "VerticalGroup"
control_id = "BuildExportPaneBodyRoot"
classes = ["editor-pane", "build-export-pane"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "header" }, { node = "summary" }, { node = "targets_slot", slot = { name = "build_export_targets_slot" } }]

[nodes.header]
component = "HorizontalGroup"
control_id = "BuildExportHeader"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "focus" }]

[nodes.focus]
component = "IconButton"
control_id = "FocusBuildExport"
props = { label = "Focus Export", icon = "editor_pages/build_plugins/package/package.svg", icon_placement = "leading" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "BuildExportPaneBody/FocusBuildExport", event = "Click", route = "workbench.dock.focus_view" }]

[nodes.summary]
component = "Text"
control_id = "BuildExportSummary"
props = { text = "Desktop export plans" }
layout = { width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 32.0, stretch = "Fixed" } }

[nodes.targets_slot]
component = "Container"
control_id = "BuildExportTargetsPanel"
props = { slot_name = "build_export_targets_slot" }
layout = { clip = true, width = { stretch = "Stretch" }, height = { stretch = "Stretch" }, scroll = { vertical = true } }
