[asset]
kind = "view"
id = "res://ui/editor/host/asset_surface_controls.zui"
version = 2
display_name = "asset surface controls"

[root]
node = "root"

[nodes.root]
component = "VerticalGroup"
control_id = "AssetSurfaceControls"
classes = ["editor-surface-controls", "asset-surface-controls"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "filter_row" },
  { node = "display_row" },
  { node = "navigation_row" },
  { node = "pointer_routes" },
]

[nodes.filter_row]
component = "HorizontalGroup"
control_id = "AssetFilterRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [
  { node = "search" },
  { node = "kind_filter" },
]

[nodes.display_row]
component = "HorizontalGroup"
control_id = "AssetDisplayRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [
  { node = "view_mode" },
  { node = "utility_tab" },
]

[nodes.navigation_row]
component = "HorizontalGroup"
control_id = "AssetNavigationRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [
  { node = "open_browser" },
  { node = "locate_asset" },
  { node = "import_model" },
]

[nodes.pointer_routes]
component = "VerticalGroup"
control_id = "AssetPointerRoutes"
props = { visibility = "collapsed", visible = false }
layout = { clip = true, container = { kind = "VerticalBox" }, width = { stretch = "Stretch" }, height = { min = 0.0, preferred = 0.0, max = 0.0, stretch = "Fixed" } }
children = [
  { node = "select_folder" },
  { node = "select_item" },
  { node = "activate_reference" },
]

[nodes.select_folder]
component = "IconButton"
control_id = "SelectFolder"
props = { label = "Folder", icon = "editor_pages/asset_browser/navigation/folder.svg", icon_placement = "leading" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/SelectFolder", event = "Change", route = "workbench.asset.select_folder" }]

[nodes.select_item]
component = "IconButton"
control_id = "SelectItem"
props = { label = "Asset", icon = "cube-outline", icon_placement = "leading" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/SelectItem", event = "Change", route = "workbench.asset.select_item" }]

[nodes.search]
component = "InputField"
control_id = "SearchEdited"
props = { placeholder = "Search", value_text = "", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", layout_min_height = "$editor.control.height.dense", input_focusable = true }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/SearchEdited", event = "Change", route = "workbench.asset.set_search_query" }]

[nodes.kind_filter]
component = "ComboBox"
control_id = "SetKindFilter"
props = { label = "Kind", value = "All", value_text = "All Types", options = ["All|label=All Types", "Texture|label=Textures", "Material|label=Materials", "Scene|label=Scenes", "Model|label=Models", "Mesh|label=Meshes", "Shader|label=Shaders", "PhysicsMaterial|label=Physics Materials", "AnimationSkeleton|label=Animation Skeletons", "AnimationClip|label=Animation Clips", "AnimationSequence|label=Animation Sequences", "AnimationGraph|label=Animation Graphs", "AnimationStateMachine|label=Animation State Machines", "UiLayout|label=UI Layouts", "UiWidget|label=UI Widgets", "UiStyle|label=UI Styles"], surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", layout_min_height = "$editor.control.height.dense", input_focusable = true }
layout = { width = { min = 124.0, preferred = 168.0, max = 220.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/SetKindFilter", event = "Change", route = "workbench.asset.set_kind_filter" }]

[nodes.view_mode]
component = "IconButton"
control_id = "SetViewMode"
props = { label = "View", icon = "list-outline", icon_placement = "leading", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", layout_min_height = "$editor.control.height.dense" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/SetViewMode", event = "Change", route = "workbench.asset.set_view_mode" }]

[nodes.utility_tab]
component = "IconButton"
control_id = "SetUtilityTab"
props = { label = "Tools", icon = "editor_pages/asset_browser/import_pipeline/import-settings.svg", icon_placement = "leading", surface_variant = "inset", border_width = "$editor.control.border_width", corner_radius = "$editor.control.radius.control", layout_min_height = "$editor.control.height.dense" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/SetUtilityTab", event = "Change", route = "workbench.asset.set_utility_tab" }]

[nodes.activate_reference]
component = "IconButton"
control_id = "ActivateReference"
props = { label = "Use", icon = "editor_pages/asset_browser/references/reference.svg", icon_placement = "leading" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/ActivateReference", event = "Click", route = "workbench.asset.activate_reference" }]

[nodes.open_browser]
component = "IconButton"
control_id = "OpenAssetBrowser"
props = { label = "Browser", icon = "editor_pages/asset_browser/navigation/folder.svg", icon_placement = "leading" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/OpenAssetBrowser", event = "Click", action = { action = "view.asset_browser.open" } }]

[nodes.locate_asset]
component = "IconButton"
control_id = "LocateSelectedAsset"
props = { label = "Locate", icon = "editor_pages/asset_browser/navigation/search.svg", icon_placement = "leading" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/LocateSelectedAsset", event = "Click", route = "workbench.asset.locate_selected_asset" }]

[nodes.import_model]
component = "IconButton"
control_id = "ImportModel"
props = { label = "Import", icon = "editor_pages/asset_browser/import_pipeline/import.svg", icon_placement = "leading" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "AssetSurface/ImportModel", event = "Click", route = "workbench.asset.import_model" }]
