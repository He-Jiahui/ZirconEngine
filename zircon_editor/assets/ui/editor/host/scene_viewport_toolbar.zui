[asset]
kind = "view"
id = "res://ui/editor/host/scene_viewport_toolbar.zui"
version = 2
display_name = "scene viewport toolbar"

[root]
node = "root"

[nodes.root]
component = "SceneViewportToolbar"
control_id = "SceneViewportToolbarRoot"
classes = ["viewport-toolbar"]
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" } }
children = [
  { node = "left_group" },
  { node = "fill" },
  { node = "right_group" },
]

[nodes.left_group]
component = "ScrollableBox"
control_id = "SceneViewportToolbarLeftGroup"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Horizontal", gap = "$editor.density.gap.small", scrollbar_visibility = "Never" }, input_policy = "Receive", width = { min = 0.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "activate_scene_mode" },
  { node = "set_transform_space" },
  { node = "set_pivot_mode" },
  { node = "set_display_mode" },
  { node = "set_grid_mode" },
  { node = "set_translate_snap" },
  { node = "set_rotate_snap" },
  { node = "set_scale_snap" },
  { node = "set_preview_lighting" },
  { node = "set_preview_skybox" },
  { node = "set_gizmos" },
  { node = "frame_selection" },
  { node = "enter_play" },
  { node = "exit_play" },
]

[nodes.fill]
component = "Space"
control_id = "SceneViewportToolbarFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.right_group]
component = "HorizontalGroup"
control_id = "SceneViewportToolbarRightGroup"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { min = 96.0, preferred = 96.0, max = 96.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "set_projection_mode" }, { node = "align_view" }]

[nodes.activate_scene_mode]
component = "IconButton"
control_id = "ActivateSceneMode"
props = { label = "Tool", icon = "editor_pages/scene_viewport/tools/universal-transform.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/ActivateSceneMode", event = "Change", route = "workbench.viewport.activate_scene_mode" }]

[nodes.set_transform_space]
component = "IconButton"
control_id = "SetTransformSpace"
props = { label = "Space", icon = "resize-outline", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetTransformSpace", event = "Change", route = "workbench.viewport.set_transform_space" }]

[nodes.set_pivot_mode]
component = "IconButton"
control_id = "SetPivotMode"
props = { label = "Pivot", icon = "locate-outline", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetPivotMode", event = "Change", route = "workbench.viewport.set_pivot_mode" }]

[nodes.set_display_mode]
component = "IconButton"
control_id = "SetDisplayMode"
props = { label = "Display", icon = "editor_pages/scene_viewport/display/lit.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetDisplayMode", event = "Change", route = "workbench.viewport.set_display_mode" }]

[nodes.set_grid_mode]
component = "IconButton"
control_id = "SetGridMode"
props = { label = "Grid", icon = "editor_pages/scene_viewport/display/grid-overlay.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetGridMode", event = "Change", route = "workbench.viewport.set_grid_mode" }]

[nodes.set_translate_snap]
component = "IconButton"
control_id = "SetTranslateSnap"
props = { label = "Move", icon = "editor_pages/scene_viewport/snapping/grid-snap.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetTranslateSnap", event = "Change", route = "workbench.viewport.set_translate_snap" }]

[nodes.set_rotate_snap]
component = "IconButton"
control_id = "SetRotateSnapDegrees"
props = { label = "Rotate", icon = "editor_pages/scene_viewport/snapping/angle-snap.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetRotateSnapDegrees", event = "Change", route = "workbench.viewport.set_rotate_snap_degrees" }]

[nodes.set_scale_snap]
component = "IconButton"
control_id = "SetScaleSnap"
props = { label = "Scale", icon = "editor_pages/scene_viewport/snapping/scale-snap.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetScaleSnap", event = "Change", route = "workbench.viewport.set_scale_snap" }]

[nodes.set_preview_lighting]
component = "IconButton"
control_id = "SetPreviewLighting"
props = { label = "Light", icon = "editor_pages/scene_viewport/display/lit.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetPreviewLighting", event = "Change", route = "workbench.viewport.set_preview_lighting" }]

[nodes.set_preview_skybox]
component = "IconButton"
control_id = "SetPreviewSkybox"
props = { label = "Sky", icon = "cloud-outline", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetPreviewSkybox", event = "Change", route = "workbench.viewport.set_preview_skybox" }]

[nodes.set_gizmos]
component = "IconButton"
control_id = "SetGizmosEnabled"
props = { label = "Gizmo", icon = "editor_pages/scene_viewport/display/gizmo-visibility.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetGizmosEnabled", event = "Change", route = "workbench.viewport.set_gizmos_enabled" }]

[nodes.frame_selection]
component = "IconButton"
control_id = "FrameSelection"
props = { label = "Frame", icon = "editor_pages/scene_viewport/camera/frame-selection.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/FrameSelection", event = "Click", route = "workbench.viewport.frame_selection" }]

[nodes.enter_play]
component = "IconButton"
control_id = "EnterPlayMode"
props = { label = "Play", icon = "editor_pages/scene_viewport/play/play.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/EnterPlayMode", event = "Click", action = { action = "runtime.play_mode.enter" } }]

[nodes.exit_play]
component = "IconButton"
control_id = "ExitPlayMode"
props = { label = "Stop", icon = "editor_pages/scene_viewport/play/stop.svg", icon_placement = "icon_only" }
layout = { width = { min = 28.0, preferred = 28.0, max = 28.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/ExitPlayMode", event = "Click", action = { action = "runtime.play_mode.exit" } }]

[nodes.set_projection_mode]
component = "IconButton"
control_id = "SetProjectionMode"
props = { label = "Camera", icon = "editor_pages/scene_viewport/camera/perspective.svg", icon_placement = "icon_only" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/SetProjectionMode", event = "Change", route = "workbench.viewport.set_projection_mode" }]

[nodes.align_view]
component = "IconButton"
control_id = "AlignView"
props = { label = "Align", icon = "navigate-outline", icon_placement = "icon_only" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "ViewportToolbar/AlignView", event = "Change", route = "workbench.viewport.align_view" }]
