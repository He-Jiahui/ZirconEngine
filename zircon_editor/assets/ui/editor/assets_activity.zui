stylesheets = []

[asset]
kind = "view"
id = "res://ui/editor/assets_activity.zui"
version = 2
display_name = "Assets Activity"

[imports]
widgets = ["res://ui/editor/components/workbench/primitives/inputs/workbench_dropdown.zui#WorkbenchDropdown", "res://ui/editor/components/workbench/primitives/inputs/workbench_icon_button.zui#WorkbenchIconButton", "res://ui/editor/components/workbench/primitives/inputs/workbench_search_input.zui#WorkbenchSearchInput", "res://ui/editor/components/workbench/primitives/inputs/workbench_tab.zui#WorkbenchTab"]
styles = ["res://ui/theme/editor_workbench_strict.zui"]

[root]
node = "assets_activity_root"

[nodes.toolbar_title_text]
component = "Label"
control_id = "AssetsActivityTitleText"
props = { text = "Assets", font_size = "$editor.typography.overlay.size", font_weight = "$editor.typography.emphasis.weight" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_open_browser_button]
component = "WorkbenchIconButton"
control_id = "OpenAssetBrowser"
props = { label = "Open Asset Browser", icon = "folder-open-outline", icon_placement = "icon_only", dispatch_kind = "asset" }
layout = { width = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetsActivityOpenBrowser", event = "Click", action = { action = "view.asset_browser.open" } }]

[nodes.toolbar_title_row]
component = "HorizontalBox"
control_id = "AssetsActivityToolbarTitleRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 20.0, preferred = 20.0, max = 20.0, stretch = "Fixed" } }
children = [{ node = "toolbar_title_text" }]

[nodes.toolbar_subtitle_text]
component = "Label"
control_id = "AssetsActivitySubtitleText"
props = { text = "Browse project assets", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.toolbar_subtitle_row]
component = "HorizontalBox"
control_id = "AssetsActivityToolbarSubtitleRow"
layout = { container = { kind = "HorizontalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }
children = [{ node = "toolbar_subtitle_text" }]

[nodes.toolbar_search_field]
component = "WorkbenchSearchInput"
control_id = "SearchEdited"
props = { placeholder = "Search", dispatch_kind = "asset" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetsActivitySearchEdited", event = "Change", route = "workbench.assets_activity.search.edit" }]

[nodes.toolbar_view_mode_list_button]
component = "WorkbenchIconButton"
control_id = "AssetsActivityViewModeListButton"
props = { label = "List view", icon = "list-outline", icon_placement = "icon_only", dispatch_kind = "asset", action_id = "workbench.asset.view_mode.set", value = "list" }
layout = { width = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetsActivityViewModeList", event = "Change", route = "workbench.assets_activity.view_mode.list" }]

[nodes.toolbar_view_mode_thumb_button]
component = "WorkbenchIconButton"
control_id = "AssetsActivityViewModeThumbButton"
props = { label = "Thumbnail view", icon = "grid-outline", icon_placement = "icon_only", dispatch_kind = "asset", action_id = "workbench.asset.view_mode.set", value = "thumbnail" }
layout = { width = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetsActivityViewModeThumbnail", event = "Change", route = "workbench.assets_activity.view_mode.thumbnail" }]

[nodes.toolbar_search_row]
component = "HorizontalBox"
control_id = "AssetsActivityToolbarSearchRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.dense", preferred = "$editor.control.height.dense", max = "$editor.control.height.dense", stretch = "Fixed" } }
children = [{ node = "toolbar_search_field" }, { node = "toolbar_open_browser_button" }]

[nodes.toolbar_kind_filter_dropdown]
component = "WorkbenchDropdown"
control_id = "AssetsActivityKindFilterDropdown"
props = { value = "All", value_text = "All Types", options = ["All|label=All Types", "Texture|label=Textures", "Material|label=Materials", "Scene|label=Scenes", "Model|label=Models", "Mesh|label=Meshes", "Shader|label=Shaders", "PhysicsMaterial|label=Physics Materials", "AnimationSkeleton|label=Animation Skeletons", "AnimationClip|label=Animation Clips", "AnimationSequence|label=Animation Sequences", "AnimationGraph|label=Animation Graphs", "AnimationStateMachine|label=Animation State Machines", "UiLayout|label=UI Layouts", "UiWidget|label=UI Widgets", "UiStyle|label=UI Styles"], dispatch_kind = "asset" }
layout = { width = { min = 148.0, preferred = 220.0, max = 300.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetsActivityKindFilterChanged", event = "Change", route = "workbench.assets_activity.kind_filter.change" }]

[nodes.toolbar_filter_row]
component = "HorizontalBox"
control_id = "AssetsActivityToolbarFilterRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }
children = [{ node = "toolbar_kind_filter_dropdown" }, { node = "toolbar_view_mode_list_button" }, { node = "toolbar_view_mode_thumb_button" }]

[nodes.toolbar_panel]
component = "VerticalBox"
control_id = "AssetsActivityToolbarPanel"
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 96.0, preferred = 96.0, max = 96.0, stretch = "Fixed" } }
children = [{ node = "toolbar_title_row" }, { node = "toolbar_subtitle_row" }, { node = "toolbar_search_row" }, { node = "toolbar_filter_row" }]

[nodes.tree_title_text]
component = "Label"
control_id = "AssetsActivityTreeTitleText"
props = { text = "Folders", font_size = "$editor.typography.overlay.size", font_weight = "$editor.typography.emphasis.weight" }
layout = { width = { stretch = "Stretch" }, height = { min = 15.0, preferred = 15.0, max = 15.0, stretch = "Fixed" } }

[nodes.tree_subtitle_text]
component = "Label"
control_id = "AssetsActivityTreeSubtitleText"
props = { text = "Project/assets", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.tree_header_top_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 6.0, preferred = 6.0, max = 6.0, stretch = "Fixed" } }

[nodes.tree_header_title_subtitle_gap]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 2.0, preferred = 2.0, max = 2.0, stretch = "Fixed" } }

[nodes.tree_header_bottom_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.tree_header_text_stack]
component = "VerticalBox"
layout = { container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "tree_header_top_space" }, { node = "tree_title_text" }, { node = "tree_header_title_subtitle_gap" }, { node = "tree_subtitle_text" }, { node = "tree_header_bottom_space" }]

[nodes.tree_header_panel]
component = "Overlay"
control_id = "AssetsActivityTreeHeaderPanel"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" } }
children = [{ node = "tree_header_text_stack" }]

[nodes.tree_divider]
component = "Space"
control_id = "AssetsActivityTreeDivider"
props = { surface_variant = "divider" }
layout = { width = { stretch = "Stretch" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" } }

[nodes.tree_row_icon]
component = "Space"
control_id = "AssetsActivityTreeRowIcon"
layout = { width = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.tree_row_name_text]
component = "Label"
control_id = "AssetsActivityTreeRowNameText"
props = { text = "Assets", font_size = "$editor.typography.overlay.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.tree_row_count_text]
component = "Label"
control_id = "AssetsActivityTreeRowCountText"
props = { text = "0", font_size = "$editor.typography.caption.size", text_align = "right" }
layout = { width = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.tree_row_left_space]
component = "Space"
layout = { width = { min = 8.0, preferred = 8.0, max = 8.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.tree_row_right_space]
component = "Space"
layout = { width = { min = 8.0, preferred = 8.0, max = 8.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.tree_row_content]
component = "HorizontalBox"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "tree_row_left_space" }, { node = "tree_row_icon" }, { node = "tree_row_name_text" }, { node = "tree_row_count_text" }, { node = "tree_row_right_space" }]

[nodes.tree_row_panel]
component = "Overlay"
control_id = "AssetsActivityTreeRowPanel"
props = { surface_variant = "asset-tree-row", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { min = "$editor.density.row_height", preferred = "$editor.density.row_height", max = "$editor.density.row_height", stretch = "Fixed" } }
children = [{ node = "tree_row_content" }]

[nodes.tree_scroll_top_space]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { min = 8.0, preferred = 8.0, max = 8.0, stretch = "Fixed" } }

[nodes.tree_scroll_bottom_fill]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.tree_scroll_body]
component = "VerticalBox"
control_id = "AssetsActivityTreeScrollBody"
props = { surface_variant = "inset", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "VerticalBox", gap = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "tree_scroll_top_space" }, { node = "tree_row_panel" }, { node = "tree_scroll_bottom_fill" }]

[nodes.tree_panel]
component = "VerticalBox"
control_id = "AssetsActivityTreePanel"
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { min = 188.0, preferred = 220.0, max = 250.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "tree_header_panel" }, { node = "tree_divider" }, { node = "tree_scroll_body" }]

[nodes.content_panel]
component = "Space"
control_id = "AssetsActivityContentPanel"
layout = { width = { min = 320.0, preferred = 640.0, stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.main_panel]
component = "HorizontalBox"
control_id = "AssetsActivityMainPanel"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "tree_panel", slot = { layout = { width = { min = 188.0, preferred = 220.0, max = 250.0, weight = 1.0, stretch = "Stretch" } } } },
  { node = "content_panel", slot = { layout = { width = { min = 320.0, preferred = 640.0, weight = 4.0, stretch = "Stretch" } } } },
]

[nodes.utility_preview_button]
component = "WorkbenchTab"
control_id = "AssetsActivityPreviewTabButton"
props = { text = "Preview", dispatch_kind = "asset", action_id = "workbench.asset.utility_tab.set", value_text = "preview" }
layout = { width = { min = 88.0, preferred = 88.0, max = 88.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetsActivityUtilityPreview", event = "Change", route = "workbench.assets_activity.utility.preview" }]

[nodes.utility_references_button]
component = "WorkbenchTab"
control_id = "AssetsActivityReferencesTabButton"
props = { text = "Refs", dispatch_kind = "asset", action_id = "workbench.asset.utility_tab.set", value_text = "references" }
layout = { width = { min = 58.0, preferred = 58.0, max = 58.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
events = [{ id = "Workbench/AssetsActivityUtilityReferences", event = "Change", route = "workbench.assets_activity.utility.references" }]

[nodes.utility_tabs_spacer]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.utility_selection_text]
component = "Label"
control_id = "AssetsActivitySelectionText"
props = { text = "No asset selected", text_tone = "muted", font_size = "$editor.typography.caption.size", text_align = "right", overflow = "elide" }
layout = { width = { min = 144.0, preferred = 144.0, max = 144.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.utility_tabs_row]
component = "HorizontalBox"
control_id = "AssetsActivityUtilityTabsRow"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = "$editor.control.height.default", preferred = "$editor.control.height.default", max = "$editor.control.height.default", stretch = "Fixed" } }
children = [{ node = "utility_preview_button" }, { node = "utility_references_button" }, { node = "utility_tabs_spacer" }, { node = "utility_selection_text" }]

[nodes.utility_tabs_divider]
component = "Space"
control_id = "AssetsActivityUtilityDivider"
layout = { width = { stretch = "Stretch" }, height = { min = 1.0, preferred = 1.0, max = 1.0, stretch = "Fixed" } }

[nodes.preview_visual_panel]
component = "Overlay"
control_id = "AssetsActivityPreviewVisualPanel"
props = { surface_variant = "asset-preview-visual", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "Overlay" }, width = { min = 108.0, preferred = 108.0, max = 108.0, stretch = "Fixed" }, height = { min = 108.0, preferred = 108.0, max = 108.0, stretch = "Fixed" } }

[nodes.preview_name_text]
component = "Label"
control_id = "AssetsActivityPreviewNameText"
props = { text = "No Asset Selected", font_size = "$editor.typography.overlay.size", font_weight = "$editor.typography.emphasis.weight", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.preview_locator_text]
component = "Label"
control_id = "AssetsActivityPreviewLocatorText"
props = { text = "", text_tone = "subtle", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = "Fixed" } }

[nodes.preview_kind_text]
component = "Label"
control_id = "AssetsActivityPreviewKindText"
props = { text = "", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 14.0, preferred = 14.0, max = 14.0, stretch = "Fixed" } }

[nodes.preview_identity_text]
component = "Label"
control_id = "AssetsActivityPreviewIdentityText"
props = { text = "", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.preview_adapter_text]
component = "Label"
control_id = "AssetsActivityPreviewToolkitText"
props = { text = "", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.preview_meta_path_text]
component = "Label"
control_id = "AssetsActivityPreviewMetaPathText"
props = { text = "", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.preview_diagnostics_text]
component = "Label"
control_id = "AssetsActivityPreviewDiagnosticsText"
props = { text = "", font_size = "$editor.typography.caption.size" }
layout = { width = { stretch = "Stretch" }, height = { min = 20.0, preferred = 20.0, max = 20.0, stretch = "Fixed" } }

[nodes.preview_details]
component = "VerticalBox"
control_id = "AssetsActivityPreviewDetails"
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.xsmall" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "preview_name_text" }, { node = "preview_locator_text" }, { node = "preview_kind_text" }, { node = "preview_identity_text" }, { node = "preview_adapter_text" }, { node = "preview_meta_path_text" }, { node = "preview_diagnostics_text" }, { node = "preview_details_fill" }]

[nodes.preview_details_fill]
component = "Space"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.preview_panel]
component = "HorizontalBox"
control_id = "AssetsActivityPreviewPanel"
props = { surface_variant = "asset-preview", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.large" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "preview_visual_panel", slot = { layout = { alignment = { vertical = "Center" } } } }, { node = "preview_details" }]

[nodes.reference_left_title_text]
component = "Label"
control_id = "AssetsActivityReferenceLeftTitleText"
props = { text = "References", font_size = "$editor.typography.body.size", font_weight = "$editor.typography.strong.weight", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.reference_left_empty_text]
component = "Label"
control_id = "AssetsActivityReferenceLeftEmptyText"
props = { text = "No direct references", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.reference_left_row_name_text]
component = "Label"
control_id = "AssetsActivityReferenceLeftRowNameText"
props = { text = "", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.reference_left_row_locator_text]
component = "Label"
control_id = "AssetsActivityReferenceLeftRowLocatorText"
props = { text = "", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.reference_left_row_kind_text]
component = "Label"
control_id = "AssetsActivityReferenceLeftRowKindText"
props = { text = "", text_tone = "muted", font_size = "$editor.typography.caption.size", text_align = "right", overflow = "elide" }
layout = { width = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.reference_left_row_text_stack]
component = "VerticalBox"
control_id = "AssetsActivityReferenceLeftRowTextStack"
layout = { container = { kind = "VerticalBox", gap = "$editor.chrome.separator.thickness" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_left_row_name_text" }, { node = "reference_left_row_locator_text" }]

[nodes.reference_left_row_panel]
component = "HorizontalBox"
control_id = "AssetsActivityReferenceLeftRowPanel"
props = { surface_variant = "reference-row", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "reference_left_row_text_stack" }, { node = "reference_left_row_kind_text" }]

[nodes.reference_left_scroll_body]
component = "Overlay"
control_id = "AssetsActivityReferenceLeftScrollBody"
props = { surface_variant = "scroll-body" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_left_empty_text" }, { node = "reference_left_row_panel" }]

[nodes.reference_left_panel]
component = "VerticalBox"
control_id = "AssetsActivityReferenceLeftPanel"
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_left_title_text" }, { node = "reference_left_scroll_body" }]

[nodes.reference_right_title_text]
component = "Label"
control_id = "AssetsActivityReferenceRightTitleText"
props = { text = "Used By", font_size = "$editor.typography.body.size", font_weight = "$editor.typography.strong.weight", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 16.0, preferred = 16.0, max = 16.0, stretch = "Fixed" } }

[nodes.reference_right_empty_text]
component = "Label"
control_id = "AssetsActivityReferenceRightEmptyText"
props = { text = "No direct references", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.reference_right_row_name_text]
component = "Label"
control_id = "AssetsActivityReferenceRightRowNameText"
props = { text = "", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.reference_right_row_locator_text]
component = "Label"
control_id = "AssetsActivityReferenceRightRowLocatorText"
props = { text = "", text_tone = "muted", font_size = "$editor.typography.caption.size", overflow = "elide" }
layout = { width = { stretch = "Stretch" }, height = { min = 13.0, preferred = 13.0, max = 13.0, stretch = "Fixed" } }

[nodes.reference_right_row_kind_text]
component = "Label"
control_id = "AssetsActivityReferenceRightRowKindText"
props = { text = "", text_tone = "muted", font_size = "$editor.typography.caption.size", text_align = "right", overflow = "elide" }
layout = { width = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.reference_right_row_text_stack]
component = "VerticalBox"
control_id = "AssetsActivityReferenceRightRowTextStack"
layout = { container = { kind = "VerticalBox", gap = "$editor.chrome.separator.thickness" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_right_row_name_text" }, { node = "reference_right_row_locator_text" }]

[nodes.reference_right_row_panel]
component = "HorizontalBox"
control_id = "AssetsActivityReferenceRightRowPanel"
props = { surface_variant = "reference-row", radius = "$editor.control.radius.small", border_width = "$editor.control.border_width" }
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "reference_right_row_text_stack" }, { node = "reference_right_row_kind_text" }]

[nodes.reference_right_scroll_body]
component = "Overlay"
control_id = "AssetsActivityReferenceRightScrollBody"
props = { surface_variant = "scroll-body" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_right_empty_text" }, { node = "reference_right_row_panel" }]

[nodes.reference_right_panel]
component = "VerticalBox"
control_id = "AssetsActivityReferenceRightPanel"
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_right_title_text" }, { node = "reference_right_scroll_body" }]

[nodes.references_shell]
component = "HorizontalBox"
layout = { container = { kind = "HorizontalBox", gap = "$editor.density.gap.large" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "reference_left_panel" }, { node = "reference_right_panel" }]

[nodes.utility_content_panel]
component = "Overlay"
control_id = "AssetsActivityUtilityContentPanel"
layout = { container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "preview_panel" }, { node = "references_shell" }]

[nodes.utility_panel]
component = "VerticalBox"
control_id = "AssetsActivityUtilityPanel"
layout = { clip = true, container = { kind = "VerticalBox", gap = "$editor.density.gap.small" }, width = { stretch = "Stretch" }, height = { min = 176.0, preferred = 176.0, max = 176.0, stretch = "Fixed" } }
children = [{ node = "utility_tabs_row" }, { node = "utility_tabs_divider" }, { node = "utility_content_panel" }]

[nodes.assets_activity_root]
component = "VerticalBox"
control_id = "AssetsActivityRoot"
classes = ["workbench-shell-root"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "toolbar_panel" }, { node = "main_panel" }, { node = "utility_panel" }]
