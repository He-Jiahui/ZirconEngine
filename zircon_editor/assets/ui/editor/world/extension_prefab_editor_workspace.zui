[asset]
kind = "component"
id = "res://ui/editor/world/extension_prefab_editor_workspace.zui"
version = 2
display_name = "Workbench Extension Prefab Editor Workspace"

[imports]
widgets = [
  "res://ui/editor/components/workbench/primitives/inputs/button.zui#WorkbenchButton",
  "res://ui/editor/workbench/primitives/inputs/dropdown.zui#WorkbenchDropdown",
  "res://ui/editor/components/workbench/primitives/inputs/field.zui#WorkbenchField",
  "res://ui/editor/components/workbench/primitives/data/list_row.zui#WorkbenchListRow",
  "res://ui/editor/workbench/primitives/chrome/section_title.zui#WorkbenchSectionTitle",
  "res://ui/editor/workbench/primitives/data/table_row.zui#WorkbenchTableRow",
  "res://ui/editor/workbench/inputs/property_editor_row.zui#WorkbenchPropertyEditorRow",
]
styles = []

[components.WorkbenchExtensionPrefabEditorWorkspace]
root = "prefab_editor_workspace"
default_classes = ["workbench-module-body", "workbench-extension-module-body"]

[nodes.prefab_editor_workspace]
component = "Overlay"
control_id = "WorkbenchExtensionPrefabEditorWorkspace"
classes = ["workbench-module-body", "workbench-extension-module-body"]
props = { visibility = "collapsed" }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "prefab_editor_workspace_main" },
  { node = "prefab_editor_right", slot = { layout = { alignment = { horizontal = "End", vertical = "Fill" }, z_order = 20 } } },
]

[nodes.prefab_editor_workspace_main]
component = "HorizontalGroup"
classes = ["workbench-module-layout-main"]
layout = { clip = true, container = { kind = "HorizontalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "prefab_editor_rail_gap" }, { node = "prefab_editor_left" }, { node = "prefab_editor_center" }, { node = "prefab_editor_right_reserve" }]

[nodes.prefab_editor_right_reserve]
component = "Container"
classes = ["workbench-module-details-reserve"]
props = { responsive_min_tier = "wide" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
[nodes.prefab_editor_rail_gap]
component = "Container"
control_id = "WorkbenchExtensionPrefabEditorRailGap"
props = { responsive_min_tier = "narrow" }
layout = { width = { min = "$editor.chrome.activity_rail.width", preferred = "$editor.chrome.activity_rail.width", max = "$editor.chrome.activity_rail.width", stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.prefab_editor_left]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPrefabEditorLeftPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "narrow" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 270.0, preferred = 270.0, max = 290.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "prefab_editor_title" }, { node = "prefab_editor_left_content" }]

[nodes.prefab_editor_left_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPrefabEditorLeftContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "prefab_editor_root_row" }, { node = "prefab_editor_mesh_component_row" }, { node = "prefab_editor_loot_socket_row" }]

[nodes.prefab_editor_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPrefabEditorTitle"
props = { text = "Prefab Editor" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.prefab_editor_root_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPrefabEditorPrefabRootRow"
classes = ["workbench-list-row"]
props = { text = "", icon = "cube", selected = false, disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PrefabEditorPrefabRootRow", event = "Click", route = "workbench.extension.prefab_editor.hierarchy.root" }]

[nodes.prefab_editor_mesh_component_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPrefabEditorMeshComponentRow"
classes = ["workbench-list-row"]
props = { text = "", icon = "box", selected = false, disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PrefabEditorMeshComponentRow", event = "Click", route = "workbench.extension.prefab_editor.hierarchy.mesh" }]

[nodes.prefab_editor_loot_socket_row]
component = "WorkbenchListRow"
control_id = "WorkbenchExtensionPrefabEditorLootSocketRow"
classes = ["workbench-list-row"]
props = { text = "", icon = "target", selected = false, disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PrefabEditorLootSocketRow", event = "Click", route = "workbench.extension.prefab_editor.hierarchy.socket" }]

[nodes.prefab_editor_center]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPrefabEditorCenterPanel"
classes = ["workbench-panel", "workbench-module-center"]
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "prefab_editor_center_header" }, { node = "prefab_editor_composition_table" }, { node = "prefab_editor_output" }]

[nodes.prefab_editor_center_header]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPrefabEditorCenterHeader"
classes = ["workbench-panel-toolbar"]
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Horizontal", gap = "$editor.density.gap.medium", scrollbar_visibility = "Never" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { min = 34.0, preferred = 34.0, max = 36.0, stretch = "Fixed" } }
children = [{ node = "prefab_editor_center_title" }, { node = "prefab_editor_header_fill" }, { node = "prefab_editor_apply_button" }, { node = "prefab_editor_validate_button" }]

[nodes.prefab_editor_center_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPrefabEditorCenterTitle"
props = { text = "Prefab Composition" }
layout = { width = { min = 240.0, preferred = 240.0, max = 320.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }

[nodes.prefab_editor_header_fill]
component = "Container"
control_id = "WorkbenchExtensionPrefabEditorHeaderFill"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.prefab_editor_apply_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPrefabEditorApplyButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { responsive_min_tier = "narrow", text = "Apply", button_variant = "outlined", button_color = "secondary", disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { min = 86, preferred = 86, max = 96, stretch = "Fixed" }, height = { min = 28, preferred = 28, max = 28, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PrefabEditorApply", event = "Click", route = "workbench.extension.prefab_editor.apply" }]

[nodes.prefab_editor_validate_button]
component = "WorkbenchButton"
control_id = "WorkbenchExtensionPrefabEditorValidateButton"
classes = ["workbench-control-button", "workbench-module-command"]
props = { text = "Validate", button_variant = "filled", button_color = "accent", disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { min = 86, preferred = 86, max = 96, stretch = "Fixed" }, height = { min = 28, preferred = 28, max = 28, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PrefabEditorValidate", event = "Click", route = "workbench.extension.prefab_editor.validate" }]

[nodes.prefab_editor_composition_table]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPrefabEditorCompositionTable"
classes = ["workbench-panel", "workbench-module-canvas"]
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = 0.0, scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "prefab_editor_mesh_table_row" }, { node = "prefab_editor_loot_socket_table_row" }, { node = "prefab_editor_light_table_row" }, { node = "prefab_editor_override_table_row" }]

[nodes.prefab_editor_mesh_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPrefabEditorMeshTableRow"
classes = ["workbench-table-row"]
props = { text = "", value_text = "", selected = false, options = [], disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PrefabEditorMeshTableRow", event = "Click", route = "workbench.extension.prefab_editor.component.mesh" }]

[nodes.prefab_editor_loot_socket_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPrefabEditorLootSocketTableRow"
classes = ["workbench-table-row"]
props = { text = "", value_text = "", options = [], disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, selected = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PrefabEditorLootSocketTableRow", event = "Click", route = "workbench.extension.prefab_editor.component.loot_socket" }]

[nodes.prefab_editor_light_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPrefabEditorLightTableRow"
classes = ["workbench-table-row"]
props = { text = "", value_text = "", options = [], disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, selected = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PrefabEditorLightTableRow", event = "Click", route = "workbench.extension.prefab_editor.component.light" }]

[nodes.prefab_editor_override_table_row]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPrefabEditorOverrideTableRow"
classes = ["workbench-table-row"]
props = { text = "", value_text = "", options = [], disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, selected = false, visibility = "collapsed" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 32.0, stretch = "Fixed" } }
events = [{ id = "WorkbenchExtension/PrefabEditorOverrideTableRow", event = "Click", route = "workbench.extension.prefab_editor.override.open" }]

[nodes.prefab_editor_output]
component = "WorkbenchTableRow"
control_id = "WorkbenchExtensionPrefabEditorOutputRow"
classes = ["workbench-table-row"]
props = { text = "Prefab Log", value_text = "", input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, options = [] }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }

[nodes.prefab_editor_right]
component = "VerticalGroup"
control_id = "WorkbenchExtensionPrefabEditorRightPanel"
classes = ["workbench-panel", "workbench-module-side"]
props = { responsive_min_tier = "wide", responsive_compact_drawer = "module_details" }
layout = { container = { kind = "VerticalBox", gap = "$editor.density.gap.medium" }, width = { min = 320.0, preferred = 320.0, max = 340.0, stretch = "Fixed" }, height = { stretch = "Stretch" } }
children = [{ node = "prefab_editor_details_title" }, { node = "prefab_editor_right_content" }]

[nodes.prefab_editor_right_content]
component = "ScrollableBox"
control_id = "WorkbenchExtensionPrefabEditorRightContent"
props = { input_hoverable = true }
layout = { clip = true, container = { kind = "ScrollableBox", axis = "Vertical", gap = "$editor.density.gap.small", scrollbar_visibility = "Auto" }, input_policy = "Receive", width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "prefab_editor_prefab_dropdown_property_row" }, { node = "prefab_editor_variant_dropdown_property_row" }, { node = "prefab_editor_instance_field_property_row" }]

[nodes.prefab_editor_details_title]
component = "WorkbenchSectionTitle"
control_id = "WorkbenchExtensionPrefabEditorDetailsTitle"
props = { text = "Prefab Details" }
layout = { width = { stretch = "Stretch" }, height = { min = 28.0, preferred = 28.0, max = 30.0, stretch = "Fixed" } }

[nodes.prefab_editor_prefab_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPrefabEditorPrefabDropdownPropertyRow"
props = { text = "Prefab", disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "prefab_editor_prefab_dropdown", slot = { name = "value" } }]

[nodes.prefab_editor_prefab_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPrefabEditorPrefabDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "", value = "", options = [], disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PrefabEditorPrefabEdit", event = "Change", route = "workbench.extension.prefab_editor.prefab.edit" },
  { id = "WorkbenchExtension/PrefabEditorPrefabCommit", event = "Submit", route = "workbench.extension.prefab_editor.prefab.commit" },
]

[nodes.prefab_editor_variant_dropdown_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPrefabEditorVariantDropdownPropertyRow"
props = { text = "Variant", disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "prefab_editor_variant_dropdown", slot = { name = "value" } }]

[nodes.prefab_editor_variant_dropdown]
component = "WorkbenchDropdown"
control_id = "WorkbenchExtensionPrefabEditorVariantDropdown"
classes = ["workbench-dropdown", "workbench-component-dropdown"]
props = { value_text = "", value = "", options = [], disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PrefabEditorVariantEdit", event = "Change", route = "workbench.extension.prefab_editor.variant.edit" },
  { id = "WorkbenchExtension/PrefabEditorVariantCommit", event = "Submit", route = "workbench.extension.prefab_editor.variant.commit" },
]

[nodes.prefab_editor_instance_field_property_row]
component = "WorkbenchPropertyEditorRow"
control_id = "WorkbenchExtensionPrefabEditorInstanceFieldPropertyRow"
props = { text = "Instance", disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 34.0, stretch = "Fixed" } }
children = [{ node = "prefab_editor_instance_field", slot = { name = "value" } }]

[nodes.prefab_editor_instance_field]
component = "WorkbenchField"
control_id = "WorkbenchExtensionPrefabEditorInstanceField"
classes = ["workbench-field", "workbench-component-field"]
props = { value = "", disabled = true, input_interactive = false, input_clickable = false, input_hoverable = false, input_focusable = false, editable_text = false }
layout = { width = { stretch = "Stretch" }, height = { min = 32, preferred = 32, max = 32, stretch = "Fixed" } }
events = [
  { id = "WorkbenchExtension/PrefabEditorInstanceEdit", event = "Change", route = "workbench.extension.prefab_editor.instance.edit" },
  { id = "WorkbenchExtension/PrefabEditorInstanceCommit", event = "Submit", route = "workbench.extension.prefab_editor.instance.commit" },
]
