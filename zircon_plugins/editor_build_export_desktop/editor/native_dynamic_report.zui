[asset]
kind = "view"
id = "editor_build_export_desktop.native_dynamic_report"
version = 2
display_name = "Native Dynamic Report"

[imports]
styles = ["res://ui/theme/editor_base.zui"]

[root]
node = "native_dynamic_report_root"

[nodes.native_dynamic_summary]
component = "Label"
control_id = "NativeDynamicReportSummary"
props = { text = "NativeDynamic" }
layout = { width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 28.0, stretch = "Fixed" } }

[nodes.native_dynamic_abi_summary]
component = "PropertyRow"
control_id = "NativeDynamicAbiSummary"
props = { text = "ABI", value = "v3" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 36.0, stretch = "Fixed" } }

[nodes.native_dynamic_package_list]
component = "Space"
control_id = "NativeDynamicPackageList"
layout = { width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.native_dynamic_loader_manifest]
component = "PropertyRow"
control_id = "NativeDynamicLoaderManifest"
props = { text = "Loader Manifest", value = "" }
layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 36.0, stretch = "Fixed" } }

[nodes.native_dynamic_diagnostics]
component = "Space"
control_id = "NativeDynamicDiagnostics"
layout = { width = { stretch = "Stretch" }, height = { min = 96.0, preferred = 128.0, stretch = "Fixed" } }

[nodes.native_dynamic_report_root]
component = "VerticalGroup"
control_id = "NativeDynamicReportRoot"
classes = ["workbench-panel"]
layout = { container = { kind = "VerticalBox", gap = 6.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [{ node = "native_dynamic_summary" }, { node = "native_dynamic_abi_summary" }, { node = "native_dynamic_package_list" }, { node = "native_dynamic_loader_manifest" }, { node = "native_dynamic_diagnostics" }]
