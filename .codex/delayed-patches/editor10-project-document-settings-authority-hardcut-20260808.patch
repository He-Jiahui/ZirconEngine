--- /dev/null
+++ b/tools/tests/test_editor10_project_document_settings_authority_contract.py
@@ -0,0 +1,38 @@
+from pathlib import Path
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[2]
+DOCUMENT_LOAD = (
+    ROOT
+    / "zircon_editor"
+    / "src"
+    / "ui"
+    / "workbench"
+    / "project"
+    / "editor_project_document_load.rs"
+)
+PROJECT_ACCESS = ROOT / "zircon_editor" / "src" / "ui" / "host" / "project_access.rs"
+
+
+class ProjectDocumentSettingsAuthorityContractTests(unittest.TestCase):
+    def test_direct_loader_is_test_only_and_not_a_public_production_api(self) -> None:
+        source = DOCUMENT_LOAD.read_text(encoding="utf-8")
+
+        self.assertNotIn("pub fn load_from_project(", source)
+        self.assertIn(
+            "#[cfg(test)]\\n    pub(crate) fn load_from_project(", source
+        )
+        self.assertIn(
+            "#[cfg(test)]\\nuse crate::core::settings::SettingsStore;", source
+        )
+
+    def test_project_host_uses_the_activated_context_authority(self) -> None:
+        host = PROJECT_ACCESS.read_text(encoding="utf-8")
+
+        self.assertIn("EditorProjectDocument::load_from_activated_project(", host)
+        self.assertIn("self.settings.as_ref()", host)
+
+
+if __name__ == "__main__":
+    unittest.main()
