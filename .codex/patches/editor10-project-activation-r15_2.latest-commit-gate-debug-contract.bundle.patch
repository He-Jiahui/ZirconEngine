+impl std::fmt::Debug for ProjectActivationPrepared {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Ready(ready) => formatter
+                .debug_tuple("ProjectActivationPrepared::Ready")
+                .field(&ready.artifact)
+                .finish(),
+            Self::Stale(reason) => formatter
+                .debug_tuple("ProjectActivationPrepared::Stale")
+                .field(reason)
+                .finish(),
+        }
+    }
+}
