+/// Immutable filesystem and manifest identity captured before project activation.
+///
+/// Only [`PreparedProjectOpen`] constructs this witness. Consumers must revalidate the
+/// witness immediately before an activation transaction rather than reopening a project root.
+#[derive(Debug)]
+pub struct ProjectRootWitness {
+    root: PathBuf,
+    identity: ProjectRootIdentity,
+    manifest: ProjectManifest,
+    manifest_identity: ProjectManifestIdentity,
+}
+
+impl ProjectRootWitness {
+    fn capture(root: PathBuf, manifest: ProjectManifest) -> Result<Self, AssetImportError> {
+        let manifest_identity = ProjectManifestIdentity::capture(&root, &manifest)?;
+        Ok(Self {
+            identity: ProjectRootIdentity::from_path(&root)?,
+            manifest_identity,
+            root,
+            manifest,
+        })
+    }
+
+    pub fn root(&self) -> &Path {
+        &self.root
+    }
+
+    pub fn manifest(&self) -> &ProjectManifest {
+        &self.manifest
+    }
+
+    pub fn revalidate(&self) -> Result<(), PreparedProjectOpenStale> {
+        let canonical_root = fs::canonicalize(&self.root).map_err(|source| {
+            PreparedProjectOpenStale::RecanonicalizeRoot {
+                root: self.root.clone(),
+                source,
+            }
+        })?;
+        let identity = ProjectRootIdentity::from_path(&canonical_root).map_err(|source| {
+            PreparedProjectOpenStale::RecanonicalizeRoot {
+                root: self.root.clone(),
+                source,
+            }
+        })?;
+        if canonical_root != self.root || identity != self.identity {
+            return Err(PreparedProjectOpenStale::RootReplaced {
+                expected_root: self.root.clone(),
+                actual_root: canonical_root,
+            });
+        }
+
+        self.manifest_identity.revalidate(&self.manifest)
+    }
+}
+
+/// Exact manifest identity carried by a prepared activation capability.
+///
+/// The parsed manifest is the semantic revision consumed by the prepared manager, while the
+/// document and canonical target reject whitespace-only rewrites and reparse-target swaps that
+/// would otherwise silently activate a manager prepared from a different file instance.
+#[derive(Debug)]
+struct ProjectManifestIdentity {
+    configured_path: PathBuf,
+    canonical_path: PathBuf,
+    document: Box<str>,
+    format_version: u32,
+    library_version: u32,
+}
+
+impl ProjectManifestIdentity {
+    fn capture(root: &Path, manifest: &ProjectManifest) -> Result<Self, AssetImportError> {
+        let configured_path = root.join("zircon-project.toml");
+        let canonical_path = fs::canonicalize(&configured_path)?;
+        let document = fs::read_to_string(&canonical_path)?;
+        let loaded = ProjectManifest::from_toml_str(&document)?;
+        if loaded.value != *manifest {
+            return Err(AssetImportError::Parse(
+                "project manifest changed while preparing activation".to_string(),
+            ));
+        }
+        Ok(Self {
+            configured_path,
+            canonical_path,
+            document: document.into_boxed_str(),
+            format_version: manifest.format_version,
+            library_version: manifest.library_version,
+        })
+    }
+
+    fn revalidate(
+        &self,
+        captured: &ProjectManifest,
+    ) -> Result<(), PreparedProjectOpenStale> {
+        let canonical_path = fs::canonicalize(&self.configured_path).map_err(|source| {
+            PreparedProjectOpenStale::ManifestCanonicalize {
+                manifest_path: self.configured_path.clone(),
+                source,
+            }
+        })?;
+        if canonical_path != self.canonical_path {
+            return Err(PreparedProjectOpenStale::ManifestTargetChanged {
+                manifest_path: self.configured_path.clone(),
+                expected_target: self.canonical_path.clone(),
+                actual_target: canonical_path,
+            });
+        }
+
+        let document = fs::read_to_string(&self.canonical_path).map_err(|source| {
+            PreparedProjectOpenStale::ManifestRead {
+                manifest_path: self.configured_path.clone(),
+                source,
+            }
+        })?;
+        if document == self.document.as_ref() {
+            return Ok(());
+        }
+        let current = ProjectManifest::from_toml_str(&document)
+            .map_err(|source| PreparedProjectOpenStale::ManifestLoad {
+                manifest_path: self.configured_path.clone(),
+                source,
+            })?
+            .value;
+        if current.format_version != self.format_version
+            || current.library_version != self.library_version
+        {
+            return Err(PreparedProjectOpenStale::ManifestRevisionChanged {
+                manifest_path: self.configured_path.clone(),
+                expected_format_version: self.format_version,
+                actual_format_version: current.format_version,
+                expected_library_version: self.library_version,
+                actual_library_version: current.library_version,
+            });
+        }
+        if current != *captured {
+            return Err(PreparedProjectOpenStale::ManifestChanged {
+                manifest_path: self.configured_path.clone(),
+            });
+        }
+        Err(PreparedProjectOpenStale::ManifestBytesChanged {
+            manifest_path: self.configured_path.clone(),
+        })
+    }
+}
