+#[cfg(test)]
+mod tests {
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    use crate::asset::project::ProjectManager;
+    use crate::asset::{AssetImportError, AssetUri};
+
+    use super::{PreparedProjectOpen, PreparedProjectOpenStale, ProjectManifest};
+
+    #[test]
+    fn prepared_project_open_rejects_a_manifest_rewrite_before_activation() {
+        let unique = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root = std::env::temp_dir().join(format!(
+            "zircon_prepared_project_open_{}_{}",
+            std::process::id(),
+            unique
+        ));
+        std::fs::create_dir_all(&root).unwrap();
+        let manifest_path = root.join("zircon-project.toml");
+        ProjectManifest::new(
+            "Prepared Project One",
+            AssetUri::parse("res://scenes/one.scene.toml").unwrap(),
+            1,
+        )
+        .save(&manifest_path)
+        .unwrap();
+
+        let prepared = PreparedProjectOpen::open(&root).unwrap();
+        ProjectManifest::new(
+            "Prepared Project Two",
+            AssetUri::parse("res://scenes/two.scene.toml").unwrap(),
+            2,
+        )
+        .save(&manifest_path)
+        .unwrap();
+
+        assert!(matches!(
+            prepared.revalidate(),
+            Err(PreparedProjectOpenStale::ManifestRevisionChanged { .. })
+        ));
+
+        drop(prepared);
+        let _ = std::fs::remove_dir_all(root);
+    }
+
+    #[test]
+    fn prepared_project_open_rejects_a_byte_only_manifest_rewrite_before_activation() {
+        let unique = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root = std::env::temp_dir().join(format!(
+            "zircon_prepared_project_manifest_bytes_{}_{}",
+            std::process::id(),
+            unique
+        ));
+        std::fs::create_dir_all(&root).unwrap();
+        let manifest_path = root.join("zircon-project.toml");
+        ProjectManifest::new(
+            "Prepared Project Bytes",
+            AssetUri::parse("res://scenes/one.scene.toml").unwrap(),
+            1,
+        )
+        .save(&manifest_path)
+        .unwrap();
+
+        let prepared = PreparedProjectOpen::open(&root).unwrap();
+        let original = std::fs::read_to_string(&manifest_path).unwrap();
+        std::fs::write(&manifest_path, format!("\n{original}")).unwrap();
+
+        assert!(matches!(
+            prepared.revalidate(),
+            Err(PreparedProjectOpenStale::ManifestBytesChanged { .. })
+        ));
+
+        drop(prepared);
+        let _ = std::fs::remove_dir_all(root);
+    }
+
+    #[test]
+    fn witness_capture_rejects_a_manifest_changed_after_manager_open() {
+        let unique = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root = std::env::temp_dir().join(format!(
+            "zircon_prepared_project_capture_race_{}_{}",
+            std::process::id(),
+            unique
+        ));
+        std::fs::create_dir_all(&root).unwrap();
+        let manifest_path = root.join("zircon-project.toml");
+        ProjectManifest::new(
+            "Prepared Project Capture One",
+            AssetUri::parse("res://scenes/one.scene.toml").unwrap(),
+            1,
+        )
+        .save(&manifest_path)
+        .unwrap();
+
+        let project = ProjectManager::open(&root).unwrap();
+        ProjectManifest::new(
+            "Prepared Project Capture Two",
+            AssetUri::parse("res://scenes/two.scene.toml").unwrap(),
+            2,
+        )
+        .save(&manifest_path)
+        .unwrap();
+
+        let canonical_root = std::fs::canonicalize(&root).unwrap();
+        assert!(matches!(
+            super::ProjectRootWitness::capture(canonical_root, project.manifest().clone()),
+            Err(AssetImportError::Parse(message))
+                if message == "project manifest changed while preparing activation"
+        ));
+
+        drop(project);
+        let _ = std::fs::remove_dir_all(root);
+    }
+}
