+/// One staged backend commit that becomes externally visible only through a bound ready token.
+pub(crate) trait ProjectActivationCommit: Send {
+    fn commit(self: Box<Self>) -> Result<(), ProjectActivationTaskError>;
+}
+
+struct ProjectActivationCommitLease {
+    generation: ProjectActivationGeneration,
+    latest_generation: Arc<AtomicU64>,
+    gate: Arc<Mutex<()>>,
+}
+
+/// A prepared immutable artifact paired with a one-shot Runtime/Editor commit action.
+///
+/// The backend constructs this before publication. `ProjectActivationService::poll` attaches the
+/// generation lease; only then may `commit` publish. Dropping a ready token discards the backend
+/// action, which releases its staged Runtime04 and staged filesystem capabilities.
+pub struct ProjectActivationReady {
+    artifact: ProjectActivationArtifact,
+    commit: Box<dyn ProjectActivationCommit>,
+    lease: Option<ProjectActivationCommitLease>,
+}
+
+impl ProjectActivationReady {
+    pub(crate) fn new(
+        artifact: ProjectActivationArtifact,
+        commit: Box<dyn ProjectActivationCommit>,
+    ) -> Self {
+        Self {
+            artifact,
+            commit,
+            lease: None,
+        }
+    }
+
+    fn bind(mut self, lease: ProjectActivationCommitLease) -> Self {
+        self.lease = Some(lease);
+        self
+    }
+
+    /// Commits exactly once if this remains the newest activation at the gate linearization point.
+    pub(crate) fn commit(self) -> Result<ProjectActivationArtifact, ProjectActivationCommitError> {
+        let lease = self.lease.as_ref().ok_or(ProjectActivationCommitError::Unbound)?;
+        let _gate = lease
+            .gate
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        if lease.latest_generation.load(Ordering::Acquire) != lease.generation.0 {
+            return Err(ProjectActivationCommitError::Superseded {
+                generation: lease.generation,
+            });
+        }
+        self.commit
+            .commit()
+            .map_err(ProjectActivationCommitError::Task)?;
+        Ok(self.artifact)
+    }
+}
+
+pub enum ProjectActivationPrepared {
+    Ready(ProjectActivationReady),
     Stale(PreparedProjectOpenStale),
 }
