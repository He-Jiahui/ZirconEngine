+#[test]
+fn project_activation_hard_cut_keeps_runtime_manager_and_io_out_of_ui_callbacks() {
+    let project_access_source = include_str!("../../../ui/host/project_access.rs");
+    let startup_source = include_str!("../../../ui/host/startup/create_or_open.rs");
+    let host_startup_source = include_str!("../../../ui/host/editor_host_startup.rs");
+    let editor_manager_source = include_str!("../../../ui/host/editor_manager_project.rs");
+    let run_config_source = include_str!("../../../ui/retained_host/run_config.rs");
+    let constructors_source = include_str!(
+        "../../../ui/retained_host/app/host_lifecycle/startup/constructors.rs"
+    );
+    let retained_workspace_source =
+        include_str!("../../../ui/retained_host/app/assets/workspace.rs");
+
+    for source in [
+        project_access_source,
+        startup_source,
+        host_startup_source,
+        editor_manager_source,
+        run_config_source,
+        constructors_source,
+    ] {
+        assert!(
+            !source.contains("ProjectManager"),
+            "UI host project activation must consume an editor-core activation artifact, not a runtime manager"
+        );
+        assert!(
+            !source.contains("open_prepared_project("),
+            "UI host project activation must not own runtime prepared-project consumption"
+        );
+    }
+
+    for forbidden in ["ProjectManager::open", "scan_and_import"] {
+        assert!(
+            !retained_workspace_source.contains(forbidden),
+            "retained asset callbacks must obtain active-generation transactions instead of `{forbidden}`"
+        );
+    }
+}
