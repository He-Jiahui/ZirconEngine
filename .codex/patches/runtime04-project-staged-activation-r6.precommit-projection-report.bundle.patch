+        &self.manifest
+    }
+
+    /// Already-validated project asset roots for pre-commit Editor projections.
+    pub fn asset_roots(&self) -> &[PathBuf] {
+        &self.asset_roots
+    }
+
+    pub fn default_scene(&self) -> &Scene {
+        &self.default_scene
+    }
+
+    pub fn into_parts(self) -> (ProjectInfo, ProjectManifest, Vec<PathBuf>, Scene) {
+        (
+            self.project_info,
+            self.manifest,
+            self.asset_roots,
+            self.default_scene,
+        )
+    }
