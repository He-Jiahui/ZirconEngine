+/// Immutable project data prepared against an uncommitted Runtime04 generation.
+///
+/// It intentionally contains no `ProjectManager`, watcher, resource-sync, or commit authority.
+/// Editor-core may build document and session projections from this data while the paired handle
+/// remains the sole authority capable of publishing the runtime generation.
+#[derive(Clone, Debug)]
+pub struct RuntimePreparedProjectProjection {
+    project_info: ProjectInfo,
+    manifest: ProjectManifest,
+    asset_roots: Vec<PathBuf>,
+    default_scene: Scene,
+}
