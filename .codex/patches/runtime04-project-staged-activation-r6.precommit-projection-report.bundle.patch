+    ///
+    /// The handle is returned intact so callers cannot inspect a prepared project without keeping
+    /// its eventual commit/drop authority. A stale witness or scene error drops the candidate and
+    /// leaves the previously active runtime generation untouched.
+    pub fn prepare_editor_projection(
+        self,
+    ) -> Result<(Self, RuntimePreparedProjectProjection), CoreError> {
+        self.prepared
