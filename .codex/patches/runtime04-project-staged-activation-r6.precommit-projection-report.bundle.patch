+            &self.prepared.project,
+            &manifest.default_scene,
+        )
+        .map_err(|source| {
+            CoreError::Initialization(
+                "RuntimePreparedProjectProjection default scene".to_string(),
+                source.to_string(),
+            )
+        })?;
+        let projection = RuntimePreparedProjectProjection {
+            project_info: self.prepared.info.clone(),
+            manifest,
+            asset_roots: self.prepared.project.project_asset_roots().to_vec(),
+            default_scene,
+        };
+        Ok((self, projection))
+    }
