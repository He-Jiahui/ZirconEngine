diff --git a/zircon_editor/src/scene/selection/domain_selection.rs b/zircon_editor/src/scene/selection/domain_selection.rs
--- a/zircon_editor/src/scene/selection/domain_selection.rs
+++ b/zircon_editor/src/scene/selection/domain_selection.rs
@@ -30,6 +30,22 @@ impl DomainSelection {
         self.apply(items, primary)
     }
 
+    pub(super) fn replace_with_last_input_primary<I>(&mut self, items: I) -> bool
+    where
+        I: IntoIterator<Item = EntityId>,
+    {
+        // Selection replacement projection begins.
+        let mut primary = None;
+        let mut selected = IndexSet::new();
+        for entity in items {
+            primary = Some(entity);
+            selected.insert(entity);
+        }
+        let changed = self.apply(selected, primary);
+        // Selection replacement projection ends.
+        changed
+    }
+
     pub(super) fn select_only(&mut self, entity: EntityId) -> bool {
         self.replace([entity], Some(entity))
     }
diff --git a/zircon_editor/src/scene/selection/selection_model.rs b/zircon_editor/src/scene/selection/selection_model.rs
--- a/zircon_editor/src/scene/selection/selection_model.rs
