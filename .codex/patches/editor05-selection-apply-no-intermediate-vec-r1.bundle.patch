+#[test]
+fn replace_mutation_uses_one_authoritative_selection_container() {
+    let model_source = include_str!("selection_model.rs");
+    let dispatch_prefix = source_between(
+        model_source,
+        "pub fn apply_active",
+        "Selection mutation dispatch begins.",
+    );
+    let dispatch = source_between(
+        model_source,
+        "Selection mutation dispatch begins.",
+        "Selection mutation dispatch ends.",
+    );
+    let dispatch_suffix = source_between(
+        model_source,
+        "Selection mutation dispatch ends.",
+        "pub fn clear",
+    );
+    let domain_source = include_str!("domain_selection.rs");
+    let replacement_prefix = source_between(
+        domain_source,
+        "fn replace_with_last_input_primary",
+        "Selection replacement projection begins.",
+    );
+    let replacement = source_between(
+        domain_source,
+        "Selection replacement projection begins.",
+        "Selection replacement projection ends.",
+    );
+    let replacement_suffix = source_between(
+        domain_source,
+        "Selection replacement projection ends.",
+        "fn select_only",
+    );
+
+    assert!(dispatch.contains("selection.replace_with_last_input_primary(items)"));
+    assert!(!dispatch_prefix.contains("Vec"));
+    assert!(!dispatch.contains("Vec"));
+    assert!(!dispatch_suffix.contains("Vec"));
+    assert!(!replacement_prefix.contains("Vec"));
+    assert!(!replacement.contains("Vec"));
+    assert!(!replacement_suffix.contains("Vec"));
+}
+
+fn source_between<'a>(source: &'a str, start: &str, end: &str) -> &'a str {
+    source
+        .split_once(start)
+        .expect("selection source must retain the start marker")
+        .1
+        .split_once(end)
+        .expect("selection source must retain the end marker")
+        .0
+}
+
 fn ordered_items(selection: &SelectionModel, domain: WorldDomain) -> Vec<u64> {
     selection.items(domain).iter().copied().collect()
 }
