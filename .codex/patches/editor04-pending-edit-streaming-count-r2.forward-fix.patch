+struct PayloadByteCounter {
+    byte_limit: usize,
+    bytes: usize,
+    exceeded: bool,
+}
+
+impl PayloadByteCounter {
+    fn new(byte_limit: usize) -> Self {
+        Self {
+            byte_limit,
+            bytes: 0,
+            exceeded: false,
+        }
+    }
+}
+
+impl Write for PayloadByteCounter {
+    fn write(&mut self, buffer: &[u8]) -> io::Result<usize> {
+        if self.exceeded {
+            return Err(io::Error::new(
+                ErrorKind::WriteZero,
+                "pending edit payload byte limit reached",
+            ));
+        }
+
+        let remaining = self.byte_limit.saturating_sub(self.bytes);
+        let written = remaining.min(buffer.len());
+        self.bytes += written;
+        if written < buffer.len() {
+            self.exceeded = true;
+        }
+        Ok(written)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+/// Measures one serialized invocation without materializing a second payload buffer.
+///
+/// `None` is an early cutoff after `byte_limit` bytes, so `byte_limit + 1` is a sound lower
+/// bound for the rejected payload while its remaining JSON stays unvisited.
+fn serialized_payload_bytes(
+    invocation: &EditorOperationInvocation,
+    byte_limit: usize,
+) -> Result<Option<usize>, PendingEditQueueError> {
+    let mut counter = PayloadByteCounter::new(byte_limit);
+    match serde_json::to_writer(&mut counter, invocation) {
+        Ok(()) => Ok(Some(counter.bytes)),
+        Err(_) if counter.exceeded => Ok(None),
+        Err(error) => Err(PendingEditQueueError::PayloadEncoding(error.to_string())),
+    }
+}
