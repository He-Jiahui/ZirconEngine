+fn atlas_resource_fingerprint(
+    texture_path: &Path,
+    atlas: &SpriteAtlasAsset,
+) -> Option<AtlasResourceFingerprint> {
+    let metadata = fs::metadata(texture_path).ok()?;
+    if !metadata.is_file() {
+        return None;
+    }
+    let modified_nanos = metadata
+        .modified()
+        .ok()
+        .and_then(|modified| modified.duration_since(UNIX_EPOCH).ok())
+        .map(|elapsed| elapsed.as_nanos());
+    Some(AtlasResourceFingerprint {
+        byte_len: metadata.len(),
+        modified_nanos,
+        width: atlas.width,
+        height: atlas.height,
+    })
+}
+
+fn resource_generation_for(
+    current: &mut BTreeMap<Arc<str>, AtlasResourceGeneration>,
+    next_generation: &mut u64,
+    previous: &EditorSpriteAtlasIndex,
+    resource_key: Arc<str>,
+    fingerprint: AtlasResourceFingerprint,
+) -> u64 {
+    if let Some(existing) = current.get(&resource_key) {
+        return existing.generation;
+    }
+    let generation = previous
+        .resource_generations
+        .get(&resource_key)
+        .filter(|previous| previous.fingerprint.matches_previous(fingerprint))
+        .map(|previous| previous.generation)
+        .unwrap_or_else(|| {
+            let allocated = (*next_generation).max(1);
+            *next_generation = allocated.saturating_add(1).max(1);
+            allocated
+        });
+    current.insert(
+        resource_key,
+        AtlasResourceGeneration {
+            fingerprint,
+            generation,
+        },
+    );
+    generation
+}
