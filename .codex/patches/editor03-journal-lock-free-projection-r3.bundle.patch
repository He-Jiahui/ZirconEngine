+++ b/zircon_editor/src/core/editing/engine/transaction/journal_projection.rs
@@ -0,0 +1,192 @@
+use std::collections::btree_map::Entry;
+
+use super::{
+    EditCommandError, EditorTransactionEngine, HistoryContextId, HistoryStore, TransactionId,
+    TransactionJournal, TransactionJournalError,
+};
+
+/// Owns a history while an explicit journal projection runs outside the engine state lock.
+struct JournalHistoryLease<'engine> {
+    engine: &'engine EditorTransactionEngine,
+    history: HistoryContextId,
+    store: Option<HistoryStore>,
+}
+
+impl<'engine> JournalHistoryLease<'engine> {
+    fn take(
+        engine: &'engine EditorTransactionEngine,
+        history: HistoryContextId,
+        transaction: TransactionId,
+    ) -> Result<Self, TransactionJournalError> {
+        let store = {
+            let mut state = engine.lock_state();
+            state.histories.remove(&history).ok_or(
+                TransactionJournalError::TransactionNotFound {
+                    history,
+                    transaction,
+                },
+            )?
+        };
+        Ok(Self {
+            engine,
+            history,
+            store: Some(store),
+        })
+    }
+
+    fn project(
+        &self,
+        transaction: TransactionId,
+    ) -> Result<TransactionJournal, TransactionJournalError> {
+        let Some(store) = self.store.as_ref() else {
+            return Err(TransactionJournalError::Engine {
+                source: EditCommandError::InvariantViolation {
+                    invariant: "journal history lease retains a history store until restoration",
+                },
+            });
+        };
+        store.journal(self.history, transaction)
+    }
+}
+
+impl Drop for JournalHistoryLease<'_> {
+    fn drop(&mut self) {
+        let Some(store) = self.store.take() else {
+            return;
+        };
+        let mut state = self.engine.lock_state();
+        match state.histories.entry(self.history) {
+            Entry::Vacant(entry) => {
+                entry.insert(store);
+            }
+            Entry::Occupied(mut entry) => {
+                let displaced = entry.insert(store);
+                state
+                    .recovery_histories
+                    .entry(self.history)
+                    .or_default()
+                    .push(displaced);
+                state.faulted = true;
+                state.drop_error = Some(EditCommandError::InvariantViolation {
+                    invariant: "journal history lease must restore into a vacant history slot",
+                });
+            }
+        }
+        self.engine.clear_operation_locked(&mut state);
+    }
+}
+
+impl EditorTransactionEngine {
+    pub fn journal_transaction(
+        &self,
+        history: HistoryContextId,
+        transaction: TransactionId,
+    ) -> Result<TransactionJournal, TransactionJournalError> {
+        self.flush_operation_group()
+            .map_err(TransactionJournalError::from)?;
+        self.start_operation("serialize transaction journal")
+            .map_err(TransactionJournalError::from)?;
+        let lease = match JournalHistoryLease::take(self, history, transaction) {
+            Ok(lease) => lease,
+            Err(error) => {
+                self.clear_operation();
+                return Err(error);
+            }
+        };
+
+        // The operation gate remains held, but journal payload work never holds engine state.
+        let journal = lease.project(transaction);
+        drop(lease);
+        journal
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::any::Any;
+
+    use crate::core::editing::engine::EditContext;
+    use crate::core::editing::selection::SelectionSnapshot;
+    use crate::core::gateway::EditorRuntimeGatewayHandle;
+
+    use super::*;
+
+    struct JournalProjectionContext {
+        gateway: EditorRuntimeGatewayHandle,
+    }
+
+    impl Default for JournalProjectionContext {
+        fn default() -> Self {
+            Self {
+                gateway: EditorRuntimeGatewayHandle::detached(),
+            }
+        }
+    }
+
+    impl EditContext for JournalProjectionContext {
+        fn runtime_gateway(&self) -> &EditorRuntimeGatewayHandle {
+            &self.gateway
+        }
+
+        fn selection_snapshot(&self) -> SelectionSnapshot {
+            SelectionSnapshot::default()
+        }
+
+        fn restore_selection(
+            &mut self,
+            _snapshot: &SelectionSnapshot,
+        ) -> Result<(), EditCommandError> {
+            Ok(())
+        }
+
+        fn as_any(&self) -> &dyn Any {
+            self
+        }
+
+        fn as_any_mut(&mut self) -> &mut dyn Any {
+            self
+        }
+    }
+
+    #[test]
+    fn restoration_conflict_keeps_both_history_stores_for_recovery() {
+        let engine = EditorTransactionEngine::new(JournalProjectionContext::default());
+        {
+            let mut state = engine.lock_state();
+            state
+                .histories
+                .insert(HistoryContextId::Global, HistoryStore::new(2).unwrap());
+        }
+        engine.start_operation("test journal restoration conflict").unwrap();
+        let lease = JournalHistoryLease::take(
+            &engine,
+            HistoryContextId::Global,
+            TransactionId::from_sequence(1),
+        )
+        .unwrap();
+        {
+            let mut state = engine.lock_state();
+            state
+                .histories
+                .insert(HistoryContextId::Global, HistoryStore::new(1).unwrap());
+        }
+        drop(lease);
+
+        let state = engine.lock_state();
+        assert!(state.histories.contains_key(&HistoryContextId::Global));
+        assert_eq!(
+            state
+                .recovery_histories
+                .get(&HistoryContextId::Global)
+                .map(Vec::len),
+            Some(1)
+        );
+        assert!(state.faulted);
+        assert!(state.operation.is_none());
+        drop(state);
+        assert!(matches!(
+            engine.take_drop_error(),
+            Some(EditCommandError::InvariantViolation { .. })
+        ));
+    }
+}
