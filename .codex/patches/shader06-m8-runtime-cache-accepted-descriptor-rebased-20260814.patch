+    #[test]
+    fn accepted_runtime_cache_artifact_stays_hydrated_after_memo_eviction() {
+        let root = unique_temp_project_root("ibl-compile-options-runtime-accepted");
+        let manager = project_asset_manager_with_root(&root);
+        let hydration_cache = Arc::new(Mutex::<EnvironmentIblHydrationCache>::default());
+        let mut extract = extract_with_source_cubemap();
+        let request = extract
+            .environment
+            .source_cubemap_ibl_bake_request(IblBakeArtifactContents::PMREM_SH9)
+            .expect("source cubemap request");
+        let store = IblBakeArtifactCacheStore::new(
+            manager
+                .current_project_manager()
+                .expect("project")
+                .paths()
+                .cache_root(),
+        );
+        store
+            .write_runtime_cache(&blob_for_request(&request))
+            .expect("runtime cache seed should write");
+        resolve_and_rehydrate_environment_ibl_cache(&manager, &hydration_cache, &mut extract)
+            .expect("runtime cache hit should hydrate the environment");
+        let hydrated_environment = extract
+            .environment
+            .skybox
+            .source_cubemap_environment()
+            .expect("runtime cache hydration should retain the environment")
+            .clone();
+        assert_eq!(
+            hydrated_environment
+                .accepted_bake_artifact_descriptor()
+                .expect("runtime cache hydration should retain descriptor provenance")
+                .producer(),
+            crate::core::framework::render::IblBakeArtifactProducer::RendererGpuRuntime,
+        );
+
+        let mut evicted_extract = extract_with_source_cubemap();
+        evicted_extract.environment.skybox.source_cubemap = Some(hydrated_environment);
+        let evicted_hydration_cache = Arc::new(Mutex::<EnvironmentIblHydrationCache>::default());
+        let resolution = resolve_and_rehydrate_environment_ibl_cache(
+            &ProjectAssetManager::default(),
+            &evicted_hydration_cache,
+            &mut evicted_extract,
+        )
+        .expect("accepted runtime cache payload should not require a cache-store lookup");
+
+        let options = compile_options_with_environment_ibl_bake_request(
+            &evicted_extract,
+            RenderPipelineCompileOptions::default(),
+            resolution.as_ref(),
+        )
+        .expect("accepted runtime cache payload should keep bake out of graph");
+
+        assert!(options.environment_ibl_bake_request().is_none());
+        assert!(matches!(
+            resolution,
+            Some(super::EnvironmentIblCacheResolution::Hydrated)
+        ));
+        let _ = fs::remove_dir_all(root);
+    }
