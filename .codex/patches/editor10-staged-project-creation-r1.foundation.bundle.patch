@@ -0,0 +1,164 @@
+use std::fs;
+
+use zircon_runtime_interface::project::{render_project_template, ProjectTemplateId};
+
+use super::super::staged_creation::StagedProjectCreation;
+use super::super::{NewProjectDraft, NewProjectTemplate, ProjectAuthority};
+use super::temp_root;
+
+#[test]
+fn staged_creation_keeps_target_hidden_until_publish_and_removes_it_on_rollback() {
+    let location = temp_root("staged-creation-hidden-target");
+    let target = location.join("Created");
+    let rendered = render_project_template(ProjectTemplateId::RenderableEmpty, "Created").unwrap();
+
+    let staged = StagedProjectCreation::stage(&target, rendered).unwrap();
+    assert!(!target.exists(), "staging must not publish the target directory");
+
+    let published = staged.publish().unwrap();
+    assert_eq!(published.root(), target.as_path());
+    assert!(target.join("zircon-project.toml").is_file());
+    assert_eq!(published.summary().name, "Created");
+
+    published.rollback().unwrap();
+    assert!(!target.exists());
+    assert_eq!(transaction_entries(&location), Vec::<String>::new());
+    fs::remove_dir_all(location).unwrap();
+}
+
+#[test]
+fn authority_stages_a_new_project_without_publishing_it() {
+    let location = temp_root("staged-creation-authority-entry");
+    let draft = NewProjectDraft {
+        project_name: "Created".to_string(),
+        location: location.to_string_lossy().into_owned(),
+        template: NewProjectTemplate::RenderableEmpty,
+    };
+
+    let staged = ProjectAuthority.stage_project_creation(&draft).unwrap();
+    let target = location.join("Created");
+    assert!(!target.exists());
+    drop(staged);
+
+    assert_eq!(transaction_entries(&location), Vec::<String>::new());
+    fs::remove_dir_all(location).unwrap();
+}
+
+#[test]
+fn staged_creation_uses_the_validated_manifest_summary() {
+    let location = temp_root("staged-creation-manifest-summary");
+    let target = location.join("Created");
+    let mut rendered =
+        render_project_template(ProjectTemplateId::RenderableEmpty, "Validated Name").unwrap();
+    rendered.summary.name = "Stale Rendered Summary".to_string();
+
+    let published = StagedProjectCreation::stage(&target, rendered)
+        .unwrap()
+        .publish()
+        .unwrap();
+    assert_eq!(published.summary().name, "Validated Name");
+
+    published.rollback().unwrap();
+    assert!(!target.exists());
+    fs::remove_dir_all(location).unwrap();
+}
+
+#[test]
+fn finalization_reports_backup_cleanup_as_warning_without_rolling_back_target() {
+    let location = temp_root("staged-creation-finalize-warning");
+    let target = location.join("Created");
+    fs::create_dir(&target).unwrap();
+    let rendered = render_project_template(ProjectTemplateId::RenderableEmpty, "Created").unwrap();
+
+    let published = StagedProjectCreation::stage(&target, rendered)
+        .unwrap()
+        .publish()
+        .unwrap();
+    let backup = transaction_path(&location, "zircon-activation-backup");
+    fs::write(backup.join("foreign.txt"), b"not ours").unwrap();
+
+    let finalized = published.finalize();
+    assert_eq!(finalized.summary().name, "Created");
+    let warning = finalized.cleanup_warning().expect("backup cleanup must be reported");
+    assert_eq!(warning.target(), target.as_path());
+    assert_eq!(warning.backup(), backup.as_path());
+    assert!(warning.error().to_string().contains("must be empty"));
+    assert!(target.join("zircon-project.toml").is_file());
+
+    fs::remove_dir_all(&target).unwrap();
+    fs::remove_dir_all(backup).unwrap();
+    fs::remove_dir_all(location).unwrap();
+}
+
+#[test]
+fn dropping_staged_creation_removes_the_hidden_directory() {
+    let location = temp_root("staged-creation-drop-staged");
+    let target = location.join("Created");
+    let rendered = render_project_template(ProjectTemplateId::RenderableEmpty, "Created").unwrap();
+
+    let staged = StagedProjectCreation::stage(&target, rendered).unwrap();
+    assert_eq!(transaction_entries(&location).len(), 1);
+    drop(staged);
+
+    assert!(!target.exists());
+    assert_eq!(transaction_entries(&location), Vec::<String>::new());
+    fs::remove_dir_all(location).unwrap();
+}
+
+#[test]
+fn dropping_published_creation_restores_the_original_empty_target() {
+    let location = temp_root("staged-creation-drop-published");
+    let target = location.join("Created");
+    fs::create_dir(&target).unwrap();
+    let rendered = render_project_template(ProjectTemplateId::RenderableEmpty, "Created").unwrap();
+
+    let published = StagedProjectCreation::stage(&target, rendered)
+        .unwrap()
+        .publish()
+        .unwrap();
+    assert!(target.join("zircon-project.toml").is_file());
+    drop(published);
+
+    assert!(target.is_dir());
+    assert_eq!(fs::read_dir(&target).unwrap().count(), 0);
+    assert_eq!(transaction_entries(&location), Vec::<String>::new());
+    fs::remove_dir_all(location).unwrap();
+}
+
+#[test]
+fn staged_creation_rollback_restores_an_original_empty_target() {
+    let location = temp_root("staged-creation-restore-empty-target");
+    let target = location.join("Created");
+    fs::create_dir(&target).unwrap();
+    let rendered = render_project_template(ProjectTemplateId::RenderableEmpty, "Created").unwrap();
+
+    let published = StagedProjectCreation::stage(&target, rendered)
+        .unwrap()
+        .publish()
+        .unwrap();
+    assert!(target.join("zircon-project.toml").is_file());
+
+    published.rollback().unwrap();
+    assert!(target.is_dir());
+    assert_eq!(fs::read_dir(&target).unwrap().count(), 0);
+    assert_eq!(transaction_entries(&location), Vec::<String>::new());
+    fs::remove_dir_all(location).unwrap();
+}
+
+fn transaction_entries(root: &std::path::Path) -> Vec<String> {
+    let mut entries = fs::read_dir(root)
+        .unwrap()
+        .map(|entry| entry.unwrap().file_name().to_string_lossy().into_owned())
+        .filter(|name| name.contains("zircon-activation-staging") || name.contains("zircon-activation-backup"))
+        .collect::<Vec<_>>();
+    entries.sort();
+    entries
+}
+
+fn transaction_path(root: &std::path::Path, marker: &str) -> std::path::PathBuf {
+    fs::read_dir(root)
+        .unwrap()
+        .map(|entry| entry.unwrap().path())
+        .find(|path| path.file_name().is_some_and(|name| name.to_string_lossy().contains(marker)))
+        .expect("transaction path must exist")
+}
