+++ b/zircon_editor/src/core/project/staged_creation.rs
@@ -0,0 +1,253 @@
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use zircon_runtime::asset::project::{ProjectManifest, ProjectPaths};
+use zircon_runtime_interface::project::{ProjectManifestSummary, RenderedProjectTemplate};
+
+use super::authority::{
+    cleanup_failed_transaction_staging, commit_staged_directory, finalize_empty_target_backup,
+    rollback_committed_project,
+};
+use super::filesystem::validate_creation_target;
+use super::ProjectAuthorityError;
+
+static NEXT_STAGED_CREATION_TRANSACTION: AtomicU64 = AtomicU64::new(1);
+
+/// A rendered project directory that is valid on disk but has not been made visible at its target.
+///
+/// It carries the sole cleanup authority for the staging directory. The UI never receives this
+/// capability: the activation backend publishes it only long enough to prepare a runtime project
+/// generation, then either rolls it back or finishes the directory transaction.
+pub(super) struct StagedProjectCreation {
+    target: PathBuf,
+    staging: PathBuf,
+    backup: PathBuf,
+    replace_empty_target: bool,
+    summary: ProjectManifestSummary,
+    cleanup_on_drop: bool,
+}
+
+/// A target directory published for runtime preparation but still recoverable on failure.
+pub(super) struct PublishedProjectCreation {
+    target: PathBuf,
+    staging: PathBuf,
+    backup: PathBuf,
+    replace_empty_target: bool,
+    summary: ProjectManifestSummary,
+    rollback_on_drop: bool,
+}
+
+/// Terminal filesystem outcome for a runtime-committed new-project activation.
+pub(super) struct ProjectCreationFinalize {
+    summary: ProjectManifestSummary,
+    cleanup_warning: Option<ProjectCreationCleanupWarning>,
+}
+
+/// Recoverable evidence that only the predecessor backup cleanup failed after commit.
+pub(super) struct ProjectCreationCleanupWarning {
+    target: PathBuf,
+    backup: PathBuf,
+    error: ProjectAuthorityError,
+}
+
+impl ProjectCreationFinalize {
+    pub(super) fn summary(&self) -> &ProjectManifestSummary {
+        &self.summary
+    }
+
+    pub(super) fn cleanup_warning(&self) -> Option<&ProjectCreationCleanupWarning> {
+        self.cleanup_warning.as_ref()
+    }
+}
+
+impl ProjectCreationCleanupWarning {
+    pub(super) fn target(&self) -> &Path {
+        &self.target
+    }
+
+    pub(super) fn backup(&self) -> &Path {
+        &self.backup
+    }
+
+    pub(super) fn error(&self) -> &ProjectAuthorityError {
+        &self.error
+    }
+}
+
+impl StagedProjectCreation {
+    /// Materializes and validates a template without making the requested project root visible.
+    pub(super) fn stage(
+        target: &Path,
+        rendered: RenderedProjectTemplate,
+    ) -> Result<Self, ProjectAuthorityError> {
+        validate_creation_target(target)?;
+        let parent = target
+            .parent()
+            .ok_or_else(|| ProjectAuthorityError::ProjectMissing {
+                path: target.to_path_buf(),
+            })?;
+        fs::create_dir_all(parent)
+            .map_err(|source| ProjectAuthorityError::io("create project parent", parent, source))?;
+        let transaction = NEXT_STAGED_CREATION_TRANSACTION.fetch_add(1, Ordering::Relaxed);
+        let stem = target
+            .file_name()
+            .and_then(|name| name.to_str())
+            .unwrap_or("project");
+        let staging = parent.join(format!(
+            ".{stem}.zircon-activation-staging-{}-{transaction}",
+            std::process::id()
+        ));
+        let backup = parent.join(format!(
+            ".{stem}.zircon-activation-backup-{}-{transaction}",
+            std::process::id()
+        ));
+        let replace_empty_target = target.exists();
+        let RenderedProjectTemplate { entries, .. } = rendered;
+        let mut summary = None;
+        let mut staging_created = false;
+        let result = (|| {
+            fs::create_dir(&staging).map_err(|source| {
+                ProjectAuthorityError::io("create project staging directory", &staging, source)
+            })?;
+            staging_created = true;
+            for entry in entries {
+                let destination = entry.path.join_to(&staging);
+                if let Some(parent) = destination.parent() {
+                    fs::create_dir_all(parent).map_err(|source| {
+                        ProjectAuthorityError::io("create template directory", parent, source)
+                    })?;
+                }
+                fs::write(&destination, entry.bytes).map_err(|source| {
+                    ProjectAuthorityError::io("write template entry", &destination, source)
+                })?;
+            }
+            let paths = ProjectPaths::from_root(&staging).map_err(|source| {
+                ProjectAuthorityError::io("resolve staging project paths", &staging, source)
+            })?;
+            paths.ensure_derived_layout().map_err(|source| {
+                ProjectAuthorityError::io("create staging derived layout", &staging, source)
+            })?;
+            let manifest_path = staging.join("zircon-project.toml");
+            let manifest = ProjectManifest::load(&manifest_path)?;
+            manifest.save(&manifest_path)?;
+            summary = Some(manifest.summary());
+            Ok(())
+        })();
+        if let Err(error) = result {
+            cleanup_failed_transaction_staging(&staging, false, staging_created);
+            return Err(error);
+        }
+        let summary = summary.ok_or_else(|| ProjectAuthorityError::ProjectMissing {
+            path: target.to_path_buf(),
+        })?;
+        Ok(Self {
+            target: target.to_path_buf(),
+            staging,
+            backup,
+            replace_empty_target,
+            summary,
+            cleanup_on_drop: true,
+        })
+    }
+
+    /// Makes the directory available to runtime preparation while retaining rollback ownership.
+    pub(super) fn publish(mut self) -> Result<PublishedProjectCreation, ProjectAuthorityError> {
+        let result = commit_staged_directory(
+            &self.staging,
+            &self.target,
+            &self.backup,
+            self.replace_empty_target,
+            fs::rename,
+        );
+        if let Err(error) = result {
+            let preserve = matches!(&error, ProjectAuthorityError::CommitRollbackFailed { .. });
+            self.cleanup_on_drop = !preserve;
+            cleanup_failed_transaction_staging(&self.staging, preserve, true);
+            return Err(error);
+        }
+        Ok(PublishedProjectCreation {
+            target: self.target.clone(),
+            staging: self.staging.clone(),
+            backup: self.backup.clone(),
+            replace_empty_target: self.replace_empty_target,
+            summary: self.summary.clone(),
+            rollback_on_drop: true,
+        })
+    }
+}
+
+impl Drop for StagedProjectCreation {
+    fn drop(&mut self) {
+        if self.cleanup_on_drop {
+            cleanup_failed_transaction_staging(&self.staging, false, true);
+        }
+    }
+}
+
+impl PublishedProjectCreation {
+    pub(super) fn root(&self) -> &Path {
+        &self.target
+    }
+
+    pub(super) fn summary(&self) -> &ProjectManifestSummary {
+        &self.summary
+    }
+
+    /// Restores the exact pre-creation directory state after a later runtime preparation failure.
+    pub(super) fn rollback(mut self) -> Result<(), ProjectAuthorityError> {
+        self.rollback_on_drop = false;
+        let result = rollback_committed_project(
+            &self.staging,
+            &self.target,
+            &self.backup,
+            self.replace_empty_target,
+            fs::rename,
+        );
+        let preserve = matches!(&result, Err(ProjectAuthorityError::PostCommitRollbackFailed { .. }));
+        cleanup_failed_transaction_staging(&self.staging, preserve, true);
+        result
+    }
+
+    /// Completes the filesystem transaction after the consuming authority has committed.
+    ///
+    /// A cleanup error cannot roll back an already committed runtime generation. The caller must
+    /// surface it as recoverable cleanup evidence rather than closing the active project.
+    pub(super) fn finalize(mut self) -> ProjectCreationFinalize {
+        // Runtime committed before this call. A backup-cleanup failure must remain recoverable
+        // evidence and must not trigger Drop's pre-commit directory rollback.
+        self.rollback_on_drop = false;
+        let cleanup_warning = finalize_empty_target_backup(
+            &self.target,
+            &self.backup,
+            self.replace_empty_target,
+        )
+        .err()
+        .map(|error| ProjectCreationCleanupWarning {
+            target: self.target.clone(),
+            backup: self.backup.clone(),
+            error,
+        });
+        ProjectCreationFinalize {
+            summary: self.summary.clone(),
+            cleanup_warning,
+        }
+    }
+}
+
+impl Drop for PublishedProjectCreation {
+    fn drop(&mut self) {
+        if !self.rollback_on_drop {
+            return;
+        }
+        let result = rollback_committed_project(
+            &self.staging,
+            &self.target,
+            &self.backup,
+            self.replace_empty_target,
+            fs::rename,
+        );
+        let preserve = matches!(&result, Err(ProjectAuthorityError::PostCommitRollbackFailed { .. }));
+        cleanup_failed_transaction_staging(&self.staging, preserve, true);
+    }
+}
