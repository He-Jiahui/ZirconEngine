new file mode 100644
--- /dev/null
+++ b/zircon_editor/src/tests/editing/transaction_engine/journal_projection.rs
@@ -0,0 +1,157 @@
+use std::any::Any;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Weak};
+
+use serde_json::json;
+
+use crate::core::editing::engine::{
+    CommandExecutionError, CommandJournalPayload, EditCommand, EditCommandError, EditContext,
+    EditorTransactionEngine, HistoryContextId, MergeOutcome,
+};
+
+use super::fixture::FixtureContext;
+
+#[test]
+fn journal_projection_runs_payload_outside_the_state_lock_and_releases_the_operation_gate() {
+    let engine = Arc::new(EditorTransactionEngine::new(FixtureContext::default()));
+    let observed_busy = Arc::new(AtomicBool::new(false));
+    let mut scope = engine
+        .begin("reentrant journal", HistoryContextId::Global)
+        .unwrap();
+    scope
+        .push(ReentrantJournalCommand {
+            engine: Arc::downgrade(&engine),
+            observed_busy: Arc::clone(&observed_busy),
+        })
+        .unwrap();
+    let transaction = scope.commit().unwrap();
+
+    let journal = engine
+        .journal_transaction(HistoryContextId::Global, transaction)
+        .unwrap();
+    assert_eq!(journal.transaction(), transaction);
+    assert!(observed_busy.load(Ordering::SeqCst));
+    assert!(engine.history_status(HistoryContextId::Global).is_ok());
+    assert_eq!(
+        engine
+            .journal_transaction(HistoryContextId::Global, transaction)
+            .unwrap(),
+        journal
+    );
+}
+
+#[test]
+fn journal_projection_restores_history_and_releases_operation_after_panic() {
+    let engine = EditorTransactionEngine::new(FixtureContext::default());
+    let mut scope = engine
+        .begin("panic journal", HistoryContextId::Global)
+        .unwrap();
+    scope.push(PanicOnceJournalCommand::new()).unwrap();
+    let transaction = scope.commit().unwrap();
+
+    assert!(catch_unwind(AssertUnwindSafe(|| {
+        let _ = engine.journal_transaction(HistoryContextId::Global, transaction);
+    }))
+    .is_err());
+    assert!(engine.history_status(HistoryContextId::Global).is_ok());
+    assert_eq!(
+        engine
+            .journal_transaction(HistoryContextId::Global, transaction)
+            .unwrap()
+            .transaction(),
+        transaction
+    );
+}
+
+struct ReentrantJournalCommand {
+    engine: Weak<EditorTransactionEngine>,
+    observed_busy: Arc<AtomicBool>,
+}
+
+impl EditCommand for ReentrantJournalCommand {
+    fn label(&self) -> &str {
+        "reentrant journal"
+    }
+
+    fn apply(&mut self, _context: &mut dyn EditContext) -> Result<(), CommandExecutionError> {
+        Ok(())
+    }
+
+    fn revert(&mut self, _context: &mut dyn EditContext) -> Result<(), CommandExecutionError> {
+        Ok(())
+    }
+
+    fn try_merge(&mut self, _next: &dyn EditCommand) -> MergeOutcome {
+        MergeOutcome::Reject
+    }
+
+    fn journal_payload(
+        &self,
+    ) -> Result<CommandJournalPayload, crate::core::editing::engine::CommandJournalUnavailable>
+    {
+        let engine = self.engine.upgrade().ok_or_else(|| {
+            crate::core::editing::engine::CommandJournalUnavailable::new(self.label())
+        })?;
+        self.observed_busy.store(
+            matches!(
+                engine.history_status(HistoryContextId::Global),
+                Err(EditCommandError::EngineBusy { .. })
+            ),
+            Ordering::SeqCst,
+        );
+        Ok(CommandJournalPayload::new(
+            "test.reentrant_journal",
+            1,
+            json!({ "reentrant": true }),
+        ))
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+struct PanicOnceJournalCommand {
+    should_panic: AtomicBool,
+}
+
+impl PanicOnceJournalCommand {
+    fn new() -> Self {
+        Self {
+            should_panic: AtomicBool::new(true),
+        }
+    }
+}
+
+impl EditCommand for PanicOnceJournalCommand {
+    fn label(&self) -> &str {
+        "panic once journal"
+    }
+
+    fn apply(&mut self, _context: &mut dyn EditContext) -> Result<(), CommandExecutionError> {
+        Ok(())
+    }
+
+    fn revert(&mut self, _context: &mut dyn EditContext) -> Result<(), CommandExecutionError> {
+        Ok(())
+    }
+
+    fn journal_payload(
+        &self,
+    ) -> Result<CommandJournalPayload, crate::core::editing::engine::CommandJournalUnavailable>
+    {
+        if self.should_panic.swap(false, Ordering::SeqCst) {
+            panic!("journal projection panic test");
+        }
+        Ok(CommandJournalPayload::new(
+            "test.panic_once_journal",
+            1,
+            json!({ "recovered": true }),
+        ))
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
