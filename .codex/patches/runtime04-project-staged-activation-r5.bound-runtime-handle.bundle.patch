+/// Opaque, self-bound replacement generation prepared by one runtime asset manager.
+///
+/// The handle owns both the manager clone and private candidate. It has no manager accessor and
+/// `commit(self)` invokes the captured manager, preventing a prepared generation from being
+/// committed through a different runtime service. Dropping it closes pending watchers and keeps
+/// the active project, resources, source index, and public change stream unchanged.
+pub struct RuntimePreparedProjectActivation {
+    manager: ProjectAssetManager,
+    prepared: PreparedProjectActivation,
+}
+
+impl RuntimePreparedProjectActivation {
+    pub(in crate::asset::pipeline::manager) fn prepare(
+        manager: ProjectAssetManager,
+        project: PreparedProjectOpen,
+    ) -> Result<Self, CoreError> {
+        let prepared = manager.prepare_project_activation(project)?;
+        Ok(Self { manager, prepared })
+    }
+
+    /// Returns immutable report data for Editor-core artifact preparation before commit.
+    pub fn project_info(&self) -> &ProjectInfo {
+        &self.prepared.info
+    }
+
+    /// Publishes this generation exactly once through the manager that prepared it.
+    pub fn commit(self) -> Result<ProjectInfo, CoreError> {
+        self.manager.commit_project_activation(self.prepared)
+    }
+}
