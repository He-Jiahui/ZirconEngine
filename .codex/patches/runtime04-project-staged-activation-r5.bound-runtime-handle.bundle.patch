+    #[test]
+    fn bound_activation_handle_drops_without_changing_the_active_project() {
+        let first_root = project_root("bound handle first", "Bound Handle First");
+        let second_root = project_root("bound handle second", "Bound Handle Second");
+        let manager = ProjectAssetManager::default();
+        let changes = AssetManager::subscribe_asset_changes(&manager);
+        AssetManager::open_project(&manager, first_root.to_string_lossy().as_ref()).unwrap();
+        while changes.try_recv().is_ok() {}
+
+        let activation = AssetManager::prepare_project_activation(
+            &manager,
+            PreparedProjectOpen::open(&second_root).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(activation.project_info().name, "Bound Handle Second");
+        drop(activation);
+
+        assert_eq!(
+            AssetManager::current_project_snapshot(&manager)
+                .unwrap()
+                .manifest()
+                .name,
+            "Bound Handle First"
+        );
+        assert!(changes.try_recv().is_err());
+
+        drop(manager);
+        let _ = fs::remove_dir_all(first_root);
+        let _ = fs::remove_dir_all(second_root);
+    }
