+fn scene_asset_indexes_rebuild_when_an_incremental_asset_replacement_changes_kind() {
+    let current = Arc::new(EditorAssetCatalogGeneration::from_snapshot_record(
+        EditorAssetCatalogSnapshotRecord {
+            catalog_revision: 8,
+            assets: vec![
+                asset_with_kind(
+                    "texture",
+                    "res://textures/sky.png",
+                    ResourceKind::Texture,
+                ),
+                asset_with_kind(
+                    "scene-main",
+                    "res://levels/main.scene.toml",
+                    ResourceKind::Scene,
+                ),
+                asset_with_kind(
+                    "material",
+                    "res://materials/ground.material.toml",
+                    ResourceKind::Material,
+                ),
+                asset_with_kind(
+                    "scene-menu",
+                    "res://levels/menu.scene.toml",
+                    ResourceKind::Scene,
+                ),
+            ],
+            ..EditorAssetCatalogSnapshotRecord::default()
+        },
+        30,
+    ));
+
+    assert_eq!(current.scene_asset_indexes(), &[1, 3]);
+
+    let next = update_asset_in_catalog_generation(
+        &current,
+        asset_with_kind(
+            "scene-main",
+            "res://levels/main.scene.toml",
+            ResourceKind::Texture,
+        ),
+        31,
+    );
+
+    assert_eq!(next.scene_asset_indexes(), &[3]);
+}
