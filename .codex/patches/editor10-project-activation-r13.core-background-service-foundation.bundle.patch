+#[cfg(test)]
+mod tests {
+    use std::fs;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::sync::mpsc::{self, Receiver, Sender};
+    use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+    use zircon_runtime::asset::project::ProjectManifest;
+    use zircon_runtime::asset::{AssetUri, ProjectInfo};
+
+    use crate::core::jobs::{test_job_system, JobContext};
+
+    use super::{
+        ProjectActivation, ProjectActivationArtifact, ProjectActivationBackend,
+        ProjectActivationIntent, ProjectActivationPrepared, ProjectActivationService,
+        ProjectActivationTaskError,
+    };
+
+    struct BlockingBackend {
+        first_started: Sender<()>,
+        release_first: Receiver<()>,
+        calls: AtomicUsize,
+    }
+
+    impl ProjectActivationBackend for BlockingBackend {
+        fn prepare(
+            &self,
+            intent: ProjectActivationIntent,
+            _context: &JobContext,
+        ) -> Result<ProjectActivationPrepared, ProjectActivationTaskError> {
+            let ProjectActivationIntent::Open(activation) = intent else {
+                panic!("test backend accepts only prepared project opens");
+            };
+            let root_path = activation.root().to_string_lossy().into_owned();
+            let project_name = activation.summary().name.clone();
+            if self.calls.fetch_add(1, Ordering::SeqCst) == 0 {
+                let _ = self.first_started.send(());
+                let _ = self.release_first.recv_timeout(Duration::from_secs(2));
+            }
+            Ok(ProjectActivationPrepared::Activated(ProjectActivationArtifact::new(
+                activation.summary().clone(),
+                ProjectInfo {
+                    root_path,
+                    name: project_name,
+                    default_scene_uri: "res://scenes/main.scene.toml".to_string(),
+                    library_version: 1,
+                    asset_count: 0,
+                    ready_asset_count: 0,
+                    failed_asset_count: 0,
+                    registry_diagnostic_count: 0,
+                },
+            )))
+        }
+
+    }
+
+    #[test]
+    fn replacement_discards_a_cancelled_staged_generation_and_only_polls_the_successor() {
+        let (first_started_tx, first_started_rx) = mpsc::channel();
+        let (release_first_tx, release_first_rx) = mpsc::channel();
+        let backend = std::sync::Arc::new(BlockingBackend {
+            first_started: first_started_tx,
+            release_first: release_first_rx,
+            calls: AtomicUsize::new(0),
+        });
+        let service = ProjectActivationService::with_backend(test_job_system(), backend.clone());
+        let (first, first_root) = fixture_activation("first");
+        let (second, second_root) = fixture_activation("second");
+
+        let first_generation = service.submit(ProjectActivationIntent::Open(first)).unwrap();
+        first_started_rx.recv_timeout(Duration::from_secs(2)).unwrap();
+        let second_generation = service.submit(ProjectActivationIntent::Open(second)).unwrap();
+        assert!(second_generation.get() > first_generation.get());
+        release_first_tx.send(()).unwrap();
+
+        let outcome = wait_for_outcome(&service);
+        assert_eq!(outcome.generation(), second_generation);
+        let artifact = match outcome.into_result().unwrap() {
+            ProjectActivationPrepared::Activated(artifact) => artifact,
+            ProjectActivationPrepared::Stale(reason) => panic!("expected activation, got {reason}"),
+        };
+        assert_eq!(artifact.report().name, "second");
+        assert_eq!(backend.calls.load(Ordering::SeqCst), 2);
+
+        let _ = fs::remove_dir_all(first_root);
+        let _ = fs::remove_dir_all(second_root);
+    }
+
+    #[test]
+    fn activation_artifact_exposes_no_project_manager_or_ui_host() {
+        let source = include_str!("service.rs");
+        let project_manager = ["Project", "Manager"].concat();
+        let editor_ui_host = ["Editor", "UiHost"].concat();
+        let production = source.split("#[cfg(test)]").next().unwrap();
+        assert!(!source.contains(&project_manager));
+        assert!(!source.contains(&editor_ui_host));
+        assert!(!production.contains("root_path"));
+        assert_send_static::<ProjectActivationArtifact>();
+        assert_send_static::<ProjectActivationPrepared>();
+    }
+
+    fn assert_send_static<T: Send + 'static>() {}
+
+    fn fixture_activation(name: &str) -> (ProjectActivation, std::path::PathBuf) {
+        let nonce = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root = std::env::temp_dir().join(format!(
+            "zircon_project_activation_service_{name}_{}_{}",
+            std::process::id(),
+            nonce
+        ));
+        fs::create_dir_all(root.join("assets")).unwrap();
+        ProjectManifest::new(
+            name,
+            AssetUri::parse("res://scenes/main.scene.toml").unwrap(),
+            1,
+        )
+        .save(root.join("zircon-project.toml"))
+        .unwrap();
+        let activation = ProjectActivation::open(&root).unwrap();
+        (activation, root)
+    }
+
+    fn wait_for_outcome(
+        service: &ProjectActivationService,
+    ) -> super::ProjectActivationOutcome {
+        let deadline = std::time::Instant::now() + Duration::from_secs(2);
+        loop {
+            if let Some(outcome) = service.poll() {
+                return outcome;
+            }
+            assert!(std::time::Instant::now() < deadline, "activation did not finish");
+            std::thread::yield_now();
+        }
+    }
+}
