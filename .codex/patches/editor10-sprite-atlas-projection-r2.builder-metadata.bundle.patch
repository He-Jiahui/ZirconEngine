+use std::collections::BTreeMap;
+use std::error::Error;
+use std::fmt::{self, Display, Formatter};
+use std::sync::Arc;
+
+use zircon_runtime::asset::SpriteAtlasUvRect;
+
+use super::PackedSpriteAtlas;
+
+const ENTRY_METADATA_OVERHEAD_BYTES: usize = 64;
+
+/// Bounded publication limits for atlas metadata passed from asset refresh to paint consumers.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SpriteAtlasPaintProjectionLimits {
+    pub max_entries: usize,
+    pub max_metadata_bytes: usize,
+}
+
+impl Default for SpriteAtlasPaintProjectionLimits {
+    fn default() -> Self {
+        Self {
+            max_entries: 10_000,
+            max_metadata_bytes: 4 * 1024 * 1024,
+        }
+    }
+}
+
+/// Immutable metadata for one source key in a packed atlas generation.
+///
+/// This deliberately excludes pixel bytes. Render13 owns decoded CPU/GPU texture lifetime for
+/// `resource_key` and `resource_revision`.
+#[derive(Clone, Debug, PartialEq)]
+pub struct SpriteAtlasPaintResource {
+    pub resource_key: Arc<str>,
+    pub resource_revision: Arc<str>,
+    pub atlas_width: u32,
+    pub atlas_height: u32,
+    pub uv: SpriteAtlasUvRect,
+}
+
+/// Immutable source-key lookup published by a single sprite-atlas build generation.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct SpriteAtlasPaintResourceProjection {
+    entries_by_source_key: Arc<BTreeMap<String, SpriteAtlasPaintResource>>,
+    metadata_bytes: usize,
+}
+
+impl SpriteAtlasPaintResourceProjection {
+    pub fn entry_for_source_key(&self, source_key: &str) -> Option<&SpriteAtlasPaintResource> {
+        self.entries_by_source_key.get(source_key)
+    }
+
+    pub fn entry_count(&self) -> usize {
+        self.entries_by_source_key.len()
+    }
+
+    pub fn metadata_bytes(&self) -> usize {
+        self.metadata_bytes
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum SpriteAtlasPaintProjectionError {
+    EmptyResourceRevision,
+    DuplicateSourceKey {
+        source_key: String,
+    },
+    EntryLimitExceeded {
+        max_entries: usize,
+        attempted_entries: usize,
+    },
+    MetadataLimitExceeded {
+        max_metadata_bytes: usize,
+        attempted_metadata_bytes: usize,
+    },
+}
+
+impl Display for SpriteAtlasPaintProjectionError {
+    fn fmt(&self, formatter: &mut Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::EmptyResourceRevision => {
+                write!(formatter, "sprite atlas resource revision is empty")
+            }
+            Self::DuplicateSourceKey { source_key } => {
+                write!(
+                    formatter,
+                    "sprite atlas generation has duplicate source key `{source_key}`"
+                )
+            }
+            Self::EntryLimitExceeded {
+                max_entries,
+                attempted_entries,
+            } => write!(
+                formatter,
+                "sprite atlas source-key projection exceeds {max_entries} entries at {attempted_entries}"
+            ),
+            Self::MetadataLimitExceeded {
+                max_metadata_bytes,
+                attempted_metadata_bytes,
+            } => write!(
+                formatter,
+                "sprite atlas source-key projection exceeds {max_metadata_bytes} metadata bytes at {attempted_metadata_bytes}"
+            ),
+        }
+    }
+}
+
+impl Error for SpriteAtlasPaintProjectionError {}
+
+/// Converts a completed atlas build into paint metadata without decoding, serializing, or copying
+/// its RGBA payload. The caller supplies the source-dependency revision for the derived atlas.
+pub fn project_packed_sprite_atlas(
+    packed: &PackedSpriteAtlas,
+    resource_revision: impl AsRef<str>,
+) -> Result<SpriteAtlasPaintResourceProjection, SpriteAtlasPaintProjectionError> {
+    project_packed_sprite_atlas_with_limits(
+        packed,
+        resource_revision,
+        SpriteAtlasPaintProjectionLimits::default(),
+    )
+}
+
+pub fn project_packed_sprite_atlas_with_limits(
+    packed: &PackedSpriteAtlas,
+    resource_revision: impl AsRef<str>,
+    limits: SpriteAtlasPaintProjectionLimits,
+) -> Result<SpriteAtlasPaintResourceProjection, SpriteAtlasPaintProjectionError> {
+    let resource_revision = resource_revision.as_ref();
+    if resource_revision.trim().is_empty() {
+        return Err(SpriteAtlasPaintProjectionError::EmptyResourceRevision);
+    }
+
+    let resource_key: Arc<str> = Arc::from(packed.atlas.atlas_texture.to_string());
+    let resource_revision: Arc<str> = Arc::from(resource_revision);
+    let mut entries_by_source_key = BTreeMap::new();
+    let mut metadata_bytes = 0;
+
+    for entry in &packed.atlas.entries {
+        let mut source_keys = vec![format!("template-icon:{}", entry.name)];
+        if let Some(source) = &entry.source {
+            let source = source.to_string();
+            source_keys.push(format!("image:{source}"));
+            source_keys.push(format!("template-image:{source}"));
+        }
+        for source_key in source_keys {
+            if entries_by_source_key.contains_key(&source_key) {
+                return Err(SpriteAtlasPaintProjectionError::DuplicateSourceKey { source_key });
+            }
+            let attempted_entries = entries_by_source_key.len().saturating_add(1);
+            if attempted_entries > limits.max_entries {
+                return Err(SpriteAtlasPaintProjectionError::EntryLimitExceeded {
+                    max_entries: limits.max_entries,
+                    attempted_entries,
+                });
+            }
+            let entry_bytes = source_key
+                .len()
+                .saturating_add(resource_key.len())
+                .saturating_add(resource_revision.len())
+                .saturating_add(ENTRY_METADATA_OVERHEAD_BYTES);
+            let attempted_metadata_bytes = metadata_bytes.saturating_add(entry_bytes);
+            if attempted_metadata_bytes > limits.max_metadata_bytes {
+                return Err(SpriteAtlasPaintProjectionError::MetadataLimitExceeded {
+                    max_metadata_bytes: limits.max_metadata_bytes,
+                    attempted_metadata_bytes,
+                });
+            }
+            metadata_bytes = attempted_metadata_bytes;
+            entries_by_source_key.insert(
+                source_key,
+                SpriteAtlasPaintResource {
+                    resource_key: Arc::clone(&resource_key),
+                    resource_revision: Arc::clone(&resource_revision),
+                    atlas_width: packed.atlas.width,
+                    atlas_height: packed.atlas.height,
+                    uv: entry.uv_rect,
+                },
+            );
+        }
+    }
+
+    Ok(SpriteAtlasPaintResourceProjection {
+        entries_by_source_key: Arc::new(entries_by_source_key),
+        metadata_bytes,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use zircon_runtime::asset::AssetUri;
+
+    use super::{
+        SpriteAtlasPaintProjectionError, SpriteAtlasPaintProjectionLimits,
+        project_packed_sprite_atlas, project_packed_sprite_atlas_with_limits,
+    };
+    use crate::ui::host::editor_asset_manager::manager::sprite_atlas::{
+        SpriteAtlasBuildConfig, SpriteAtlasSourceImage, pack_sprite_atlas_sources,
+    };
+
+    #[test]
+    fn packed_atlas_projects_icon_and_canonical_image_keys_without_rgba_payload() {
+        let packed = packed_sources(&["search"]);
+
+        let projection = project_packed_sprite_atlas(&packed, "source-generation-a").unwrap();
+
+        let icon = projection
+            .entry_for_source_key("template-icon:search")
+            .expect("template icon key");
+        let image = projection
+            .entry_for_source_key("image:res://ui/search.png")
+            .expect("canonical image key");
+        let template_image = projection
+            .entry_for_source_key("template-image:res://ui/search.png")
+            .expect("canonical template image key");
+        assert_eq!(projection.entry_count(), 3);
+        assert_eq!(
+            icon.resource_key.as_ref(),
+            "lib://editor-sprite-atlases/editor-atlas.png"
+        );
+        assert_eq!(icon.resource_revision.as_ref(), "source-generation-a");
+        assert_eq!(icon, image);
+        assert_eq!(icon, template_image);
+        assert_eq!(icon.uv, packed.atlas.entries[0].uv_rect);
+        assert!(projection.metadata_bytes() > 0);
+    }
+
+    #[test]
+    fn projection_rejects_empty_revision_and_hard_bounds_before_partial_publication() {
+        let packed = packed_sources(&["search"]);
+
+        assert_eq!(
+            project_packed_sprite_atlas(&packed, ""),
+            Err(SpriteAtlasPaintProjectionError::EmptyResourceRevision)
+        );
+        assert_eq!(
+            project_packed_sprite_atlas_with_limits(
+                &packed,
+                "generation",
+                SpriteAtlasPaintProjectionLimits {
+                    max_entries: 2,
+                    max_metadata_bytes: usize::MAX,
+                },
+            ),
+            Err(SpriteAtlasPaintProjectionError::EntryLimitExceeded {
+                max_entries: 2,
+                attempted_entries: 3,
+            })
+        );
+    }
+
+    #[test]
+    fn projection_rejects_duplicate_key_from_invalid_builder_output() {
+        let mut packed = packed_sources(&["search", "close"]);
+        packed.atlas.entries[1].name = "search".to_string();
+
+        assert_eq!(
+            project_packed_sprite_atlas(&packed, "generation"),
+            Err(SpriteAtlasPaintProjectionError::DuplicateSourceKey {
+                source_key: "template-icon:search".to_string(),
+            })
+        );
+    }
+
+    fn packed_sources(names: &[&str]) -> super::super::PackedSpriteAtlas {
+        let sources = names
+            .iter()
+            .map(|name| SpriteAtlasSourceImage {
+                name: (*name).to_string(),
+                source_uri: Some(AssetUri::parse(&format!("res://ui/{name}.png")).unwrap()),
+                width: 1,
+                height: 1,
+                rgba: vec![255, 255, 255, 255],
+            })
+            .collect::<Vec<_>>();
+        pack_sprite_atlas_sources(
+            &SpriteAtlasBuildConfig {
+                initial_size: (4, 4),
+                max_size: (4, 4),
+                ..Default::default()
+            },
+            &sources,
+        )
+        .unwrap()
+    }
+}
