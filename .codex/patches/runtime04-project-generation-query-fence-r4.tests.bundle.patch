+use std::sync::Arc;
+use std::thread;
+use std::time::Duration;
+
+use crate::asset::AssetManager;
+
+use super::super::project_asset_manager::ProjectAssetManager;
+
+#[test]
+fn project_snapshot_query_waits_for_generation_commit() {
+    let manager = Arc::new(ProjectAssetManager::default());
+    let generation = manager.project_generation_write();
+    let (started_sender, started_receiver) = std::sync::mpsc::channel();
+    let (completed_sender, completed_receiver) = std::sync::mpsc::channel();
+    let reader_manager = Arc::clone(&manager);
+    let reader = thread::spawn(move || {
+        started_sender.send(()).unwrap();
+        completed_sender
+            .send(AssetManager::current_project_snapshot(reader_manager.as_ref()).is_none())
+            .unwrap();
+    });
+
+    started_receiver.recv_timeout(Duration::from_secs(1)).unwrap();
+    assert!(completed_receiver.recv_timeout(Duration::from_millis(25)).is_err());
+    drop(generation);
+    assert!(completed_receiver.recv_timeout(Duration::from_secs(1)).unwrap());
+    reader.join().unwrap();
+}
