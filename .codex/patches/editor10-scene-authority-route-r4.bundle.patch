+fn scene_picker_ticket_was_cancelled(
+    control_id: &str,
+    action_id: &str,
+    cancellation: &Result<(UiHostEventEffects, bool), String>,
+) -> bool {
+    control_id == callback_dispatch::WORKBENCH_COMMAND_PALETTE_CONTROL_ID
+        && action_id == WORKBENCH_POPUP_CANCEL_ACTION_ID
+        && matches!(cancellation, Ok((_, true)))
+}
