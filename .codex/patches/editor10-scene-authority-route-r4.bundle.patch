+            callback_dispatch::WORKBENCH_COMMAND_PALETTE_CONTROL_ID,
+            WORKBENCH_POPUP_CANCEL_ACTION_ID,
+            &Ok((UiHostEventEffects::default(), true)),
+        ));
+        assert!(!scene_picker_ticket_was_cancelled(
+            callback_dispatch::WORKBENCH_COMMAND_PALETTE_CONTROL_ID,
+            WORKBENCH_POPUP_CANCEL_ACTION_ID,
+            &Ok((UiHostEventEffects::default(), false)),
+        ));
+        assert!(!scene_picker_ticket_was_cancelled(
+            callback_dispatch::WORKBENCH_COMMAND_PALETTE_CONTROL_ID,
+            WORKBENCH_POPUP_CANCEL_ACTION_ID,
+            &Err("bridge failure".to_string()),
+        ));
+    }
+}
