+
+#[test]
+fn nonclosing_popup_cancel_keeps_the_scene_picker_ticket() {
+    let _guard = lock_env();
+    let harness = ChildWindowHostHarness::new("zircon_retained_scene_picker_nonclosing_cancel");
+    let project_root = unique_temp_path("zircon_retained_scene_picker_nonclosing_cancel_project")
+        .with_extension("");
+    let project_name = project_root
+        .file_name()
+        .and_then(|name| name.to_str())
+        .expect("temporary project root must have a UTF-8 name")
+        .to_string();
+    let location = project_root
+        .parent()
+        .expect("temporary project root must have a parent")
+        .to_string_lossy()
+        .into_owned();
+    let created = ProjectAuthority::default()
+        .create_project(&NewProjectDraft {
+            project_name,
+            location,
+            template: NewProjectTemplate::RenderableEmpty,
+        })
+        .expect("scene picker test project should be created");
+    assert_eq!(created.root, project_root);
+    drop(created);
+
+    {
+        let mut host = harness.host.borrow_mut();
+        host.editor_manager
+            .open_project(&project_root)
+            .expect("scene picker test project should open");
+        host.open_workbench_scene_picker(ScenePickerMode::Open);
+        assert!(host.scene_picker_session.is_some());
+        host.workbench_window_bridge
+            .close_popup("WorkbenchCommandPalette")
+            .expect("test setup should close the scene picker popup");
+
+        let cancellation = host.dispatch_componentized_workbench_surface_control(
+            "WorkbenchCommandPalette",
+            WORKBENCH_POPUP_CANCEL_ACTION_ID,
+        );
+        assert!(matches!(cancellation, Some(Ok(_))));
+        assert!(host.scene_picker_session.is_some());
+    }
+
+    let _ = std::fs::remove_dir_all(project_root);
+}
