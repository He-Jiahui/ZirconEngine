+/// Recoverable filesystem evidence produced only after Runtime04 has committed a new generation.
+/// It is typed core state, not a retained-host presentation string, and can never request rollback.
+#[derive(Debug)]
+pub(crate) struct ProjectActivationCleanupWarning {
