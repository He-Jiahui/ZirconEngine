+/// A committed runtime artifact with an explicit normal or cleanup-warning terminal state.
+#[derive(Debug)]
+pub(crate) enum ProjectActivationCommitOutcome {
+    Activated(ProjectActivationArtifact),
+    ActivatedWithCleanupWarning {
+        artifact: ProjectActivationArtifact,
+        warning: ProjectActivationCleanupWarning,
+    },
+}
+
+impl ProjectActivationCommitOutcome {
+    fn new(
+        artifact: ProjectActivationArtifact,
+        cleanup_warning: Option<ProjectActivationCleanupWarning>,
+    ) -> Self {
+        match cleanup_warning {
+            Some(warning) => Self::ActivatedWithCleanupWarning { artifact, warning },
+            None => Self::Activated(artifact),
+        }
+    }
+
+    pub(crate) fn artifact(&self) -> &ProjectActivationArtifact {
+        match self {
+            Self::Activated(artifact) => artifact,
+            Self::ActivatedWithCleanupWarning { artifact, .. } => artifact,
+        }
+    }
+
+    pub(crate) fn into_parts(self) -> (ProjectActivationArtifact, Option<ProjectActivationCleanupWarning>) {
+        match self {
+            Self::Activated(artifact) => (artifact, None),
+            Self::ActivatedWithCleanupWarning { artifact, warning } => (artifact, Some(warning)),
+        }
+    }
+}
