+    backup: PathBuf,
+    error: ProjectAuthorityError,
+}
+
+impl ProjectActivationCleanupWarning {
+    pub(crate) fn new(target: PathBuf, backup: PathBuf, error: ProjectAuthorityError) -> Self {
+        Self { target, backup, error }
+    }
+
+    pub(crate) fn target(&self) -> &std::path::Path {
