+
+// Catalog records are already published as immutable project metadata. Projection checks the
+// locator shape without materializing an AssetUri for every scanned record; submission reruns
+// the complete parser before constructing the typed open request.
+fn is_project_scene_locator(locator: &str) -> bool {
+    let locator = locator.trim();
+    let Some(path) = locator.strip_prefix("res://") else {
+        return false;
+    };
+    if path.is_empty() || locator.contains('#') || !path.ends_with(".scene.toml") {
+        return false;
+    }
+
+    let mut normal_component_depth = 0_usize;
+    for component in path.split(['/', '\\']) {
+        match component {
+            "" | "." => {}
+            ".." => {
+                let Some(next_depth) = normal_component_depth.checked_sub(1) else {
+                    return false;
+                };
+                normal_component_depth = next_depth;
+            }
+            _ if component.contains(':') => return false,
+            _ => normal_component_depth = normal_component_depth.saturating_add(1),
+        }
+    }
+
+    normal_component_depth > 0
+}
