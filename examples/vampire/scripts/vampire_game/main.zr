var gameplay = %import("zr.zircon.gameplay");

pub activate(): int {
    return 0;
}

pub deactivate(): int {
    return 0;
}

pub saveState(): string {
    return "vampire_game";
}

pub restoreState(state: string): int {
    return 0;
}

pub onStart(entity: int, dt: float): int {
    if (gameplay.script_property_matches(entity, "role", "player")) {
        gameplay.set_component_json(
            entity,
            "gameplay.menu_state",
            "{\"state\":\"start\",\"title\":\"Blood Moon Hunt\",\"subtitle\":\"WASD movement. Blood Bolt attacks automatically.\",\"button\":\"Start Game\"}"
        );
        gameplay.set_component_json(entity, "gameplay.control_state", "\"none\"");
        gameplay.set_component_json(entity, "vampire.run_state", "\"start_menu\"");
        gameplay.set_world_hud_bar(entity, 120.0, 1.45, 0.12, 1.92, 1.18);
    } else if (gameplay.script_property_matches(entity, "role", "enemy")) {
        var enemyMaxHealth = gameplay.script_number(entity, "hp", 24.0);
        gameplay.set_world_hud_bar(entity, enemyMaxHealth, 0.95, 0.09, 1.55, 1.18);
    } else if (gameplay.script_property_matches(entity, "role", "boss")) {
        gameplay.set_world_hud_bar(entity, 450.0, 1.12, 0.10, 1.75, 1.18);
    }
    return 0;
}

pub onFixedUpdate(entity: int, dt: float): int {
    return 0;
}

pub onUpdate(entity: int, dt: float): int {
    if (gameplay.script_property_matches(entity, "role", "player")) {
        var command = gameplay.component_string(entity, "gameplay.control_state", "none");
        var shouldStart = false;
        if (command == "start_game") {
            shouldStart = true;
        }
        if (command == "retry_game") {
            shouldStart = true;
        }
        if (shouldStart) {
            gameplay.set_position(entity, 0.0, 0.0, 0.0);
            gameplay.heal_entity(entity, 120.0, 120.0);
            gameplay.set_animation_bool(entity, "moving", false);
            gameplay.set_animation_bool(entity, "attacking", false);
            gameplay.set_component_json(entity, "vampire.action_state", "0");
            gameplay.set_component_json(entity, "vampire.behavior_node", "0");
            gameplay.set_particle_sprites(entity, "[]");
            gameplay.camera_follow(1, entity, 0.0, 5.35, -7.25);
            gameplay.follow_position(118, entity, 0.0, 1.6, 0.0);
            gameplay.set_component_json(entity, "vampire.run_state", "\"playing\"");
            gameplay.set_component_json(entity, "vampire.spawn_grace", "\"1\"");
            gameplay.set_component_json(entity, "gameplay.menu_state", "null");
            gameplay.set_component_json(entity, "gameplay.control_state", "\"none\"");
            gameplay.set_world_hud_bar(entity, 120.0, 1.45, 0.12, 1.92, 1.18);
            return 0;
        }
        var runState = gameplay.component_string(entity, "vampire.run_state", "start_menu");
        if (runState != "playing") {
            gameplay.camera_follow(1, entity, 0.0, 5.35, -7.25);
            gameplay.follow_position(118, entity, 0.0, 1.6, 0.0);
            gameplay.set_animation_bool(entity, "moving", false);
            gameplay.set_animation_bool(entity, "attacking", false);
            gameplay.set_world_hud_bar(entity, 120.0, 1.45, 0.12, 1.92, 1.18);
            return 0;
        }
        var spawnGrace = gameplay.component_string(entity, "vampire.spawn_grace", "0");
        if (spawnGrace == "1") {
            gameplay.set_component_json(entity, "vampire.spawn_grace", "\"0\"");
        }
        var playerDefeated = gameplay.script_number_at_most(entity, "hp", 0.0, 120.0);
        if (playerDefeated) {
            gameplay.set_component_json(
                entity,
                "gameplay.menu_state",
                "{\"state\":\"game_over\",\"title\":\"Game Over\",\"subtitle\":\"The hunt ended before dawn. Retry from the clearing.\",\"button\":\"Retry\"}"
            );
            gameplay.set_component_json(entity, "vampire.run_state", "\"game_over\"");
            gameplay.set_component_json(entity, "gameplay.control_state", "\"none\"");
            return 0;
        }

        var dx = 0.0;
        var dz = 0.0;
        if (gameplay.key_pressed("A")) {
            dx = 1.0;
        }
        if (gameplay.key_pressed("D")) {
            dx = -1.0;
        }
        if (gameplay.key_pressed("W")) {
            dz = -1.0;
        }
        if (gameplay.key_pressed("S")) {
            dz = 1.0;
        }

        var moving = false;
        if (dx != 0.0 || dz != 0.0) {
            moving = true;
            gameplay.translate(entity, dx, 0.0, dz);
            gameplay.face_direction(entity, dx, dz);
        }
        gameplay.camera_follow(1, entity, 0.0, 5.35, -7.25);
        gameplay.follow_position(118, entity, 0.0, 1.6, 0.0);
        gameplay.set_animation_bool(entity, "moving", moving);

        var target = gameplay.nearest_by_script_property(entity, "role", "enemy", 12.0);
        if (gameplay.entity_exists(target)) {
            gameplay.damage_entity(target, 1.0);
        }
        gameplay.set_animation_bool(entity, "attacking", true);
        gameplay.set_component_json(entity, "vampire.action_state", "2");
        gameplay.set_component_json(entity, "vampire.behavior_node", "11");
        gameplay.set_particle_sprites(
            entity,
            "[{\"position\":[0.0,1.35,0.0],\"size\":0.34,\"color\":[1.0,0.08,0.16,0.82],\"billboard_offset\":[0.0,1.2],\"aspect_ratio\":1.0,\"sort_order\":4}]"
        );
        gameplay.set_world_hud_bar(entity, 120.0, 1.45, 0.12, 1.92, 1.18);
        return 0;
    } else if (gameplay.script_property_matches(entity, "role", "enemy")) {
        var player = gameplay.nearest_by_script_property(entity, "role", "player", 1000.0);
        if (gameplay.entity_exists(player)) {
            var playerRunState = gameplay.component_string(player, "vampire.run_state", "start_menu");
            if (playerRunState != "playing") {
                gameplay.set_animation_bool(entity, "moving", false);
                gameplay.set_animation_bool(entity, "attacking", false);
                return 0;
            }
            var playerSpawnGrace = gameplay.component_string(player, "vampire.spawn_grace", "0");
            if (playerSpawnGrace == "1") {
                gameplay.set_animation_bool(entity, "moving", false);
                gameplay.set_animation_bool(entity, "attacking", false);
                return 0;
            }
            var maxHealth = gameplay.script_number(entity, "hp", 24.0);
            var contact = gameplay.nearest_by_script_property(entity, "role", "player", 1.45);
            if (gameplay.entity_exists(contact)) {
                gameplay.set_animation_bool(entity, "moving", false);
                var playerDefeatedByContact = gameplay.script_number_at_most(contact, "hp", 0.2, 120.0);
                if (playerDefeatedByContact) {
                    gameplay.set_component_json(
                        contact,
                        "gameplay.menu_state",
                        "{\"state\":\"game_over\",\"title\":\"Game Over\",\"subtitle\":\"The hunt ended before dawn. Retry from the clearing.\",\"button\":\"Retry\"}"
                    );
                    gameplay.set_component_json(contact, "vampire.run_state", "\"game_over\"");
                    gameplay.set_component_json(contact, "gameplay.control_state", "\"none\"");
                } else {
                    gameplay.damage_entity(contact, 0.2);
                }
                gameplay.set_animation_bool(entity, "attacking", true);
                gameplay.set_component_json(entity, "vampire.action_state", "2");
                gameplay.set_component_json(entity, "vampire.behavior_node", "41");
            } else {
                var enemySpeed = gameplay.script_number(entity, "move_speed", 3.0);
                gameplay.nav_move_towards_entity(entity, player, enemySpeed, dt);
                gameplay.set_animation_bool(entity, "moving", true);
                gameplay.set_component_json(entity, "vampire.action_state", "1");
                gameplay.set_component_json(entity, "vampire.behavior_node", "31");
                gameplay.set_animation_bool(entity, "attacking", false);
            }
            gameplay.set_world_hud_bar(entity, maxHealth, 0.95, 0.09, 1.55, 1.18);
        }
        return 0;
    } else if (gameplay.script_property_matches(entity, "role", "boss")) {
        var bossPlayer = gameplay.nearest_by_script_property(entity, "role", "player", 1000.0);
        if (gameplay.entity_exists(bossPlayer)) {
            var bossPlayerRunState = gameplay.component_string(bossPlayer, "vampire.run_state", "start_menu");
            if (bossPlayerRunState != "playing") {
                return 0;
            }
            gameplay.nav_move_towards_entity(entity, bossPlayer, 2.15, dt);
            gameplay.set_component_json(entity, "vampire.action_state", "1");
            gameplay.set_component_json(entity, "vampire.behavior_node", "31");
            gameplay.set_world_hud_bar(entity, 450.0, 1.12, 0.10, 1.75, 1.18);
        }
        return 0;
    }
    return 0;
}
