kind = "surface"
version = 2
name = "Vampire Effect PBR"
shading_model = "standard_pbr"
wgsl_files = ["vampire_effect_base.wgsl", "vampire_effect_variant.wgsl"]

[[properties]]
name = "base_color"
kind = "vec4"
default = [1.0, 1.0, 1.0, 1.0]

[[properties]]
name = "metallic"
kind = "float"
default = 0.0

[[properties]]
name = "roughness"
kind = "float"
default = 1.0

[[properties]]
name = "emissive"
kind = "vec3"
default = [0.0, 0.0, 0.0]

[[texture_slots]]
name = "base_color"
kind = "texture_2d"
default = "white"

[[texture_slots]]
name = "normal"
kind = "texture_2d"
default = "flat_normal"

[[texture_slots]]
name = "metallic_roughness"
kind = "texture_2d"
default = "white"

[[texture_slots]]
name = "occlusion"
kind = "texture_2d"
default = "white"

[[texture_slots]]
name = "emissive"
kind = "texture_2d"
default = "black"
