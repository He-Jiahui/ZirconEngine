version = 1
name = "Vampire Example Default PBR"
wgsl_files = ["default_pbr.wgsl"]

[[entry_points]]
name = "vs_main"
stage = "vertex"

[[entry_points]]
name = "fs_main"
stage = "fragment"

[pipeline_layout]
push_constant_ranges = []

[[pipeline_layout.bind_groups]]
group = 0
label = "scene"

[[pipeline_layout.bind_groups.bindings]]
binding = 0
label = "scene_uniform"
resource_type = "uniform_buffer"
visibility = ["vertex", "fragment"]

[[pipeline_layout.bind_groups]]
group = 1
label = "model"

[[pipeline_layout.bind_groups.bindings]]
binding = 0
label = "model_uniform"
resource_type = "uniform_buffer"
visibility = ["vertex", "fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 1
label = "current_skinned_joint_palette"
resource_type = "uniform_buffer"
visibility = ["vertex"]

[[pipeline_layout.bind_groups.bindings]]
binding = 2
label = "previous_skinned_joint_palette"
resource_type = "uniform_buffer"
visibility = ["vertex"]

[[pipeline_layout.bind_groups]]
group = 2
label = "material_textures"

[[pipeline_layout.bind_groups.bindings]]
binding = 0
label = "base_color_texture"
resource_type = "texture"
visibility = ["fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 1
label = "base_color_sampler"
resource_type = "sampler"
visibility = ["fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 2
label = "normal_texture"
resource_type = "texture"
visibility = ["fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 3
label = "normal_sampler"
resource_type = "sampler"
visibility = ["fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 4
label = "metallic_roughness_texture"
resource_type = "texture"
visibility = ["fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 5
label = "metallic_roughness_sampler"
resource_type = "sampler"
visibility = ["fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 6
label = "occlusion_texture"
resource_type = "texture"
visibility = ["fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 7
label = "occlusion_sampler"
resource_type = "sampler"
visibility = ["fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 8
label = "emissive_texture"
resource_type = "texture"
visibility = ["fragment"]

[[pipeline_layout.bind_groups.bindings]]
binding = 9
label = "emissive_sampler"
resource_type = "sampler"
visibility = ["fragment"]

[[pipeline_layout.bind_groups]]
group = 3
label = "material"

[[pipeline_layout.bind_groups.bindings]]
binding = 0
label = "material_uniform"
resource_type = "uniform_buffer"
visibility = ["fragment"]

[[properties]]
name = "base_color"
kind = "vec4"
default = [1.0, 1.0, 1.0, 1.0]

[[properties]]
name = "metallic"
kind = "float"
default = 0.0

[[properties]]
name = "roughness"
kind = "float"
default = 1.0

[[properties]]
name = "emissive"
kind = "vec3"
default = [0.0, 0.0, 0.0]

[[texture_slots]]
name = "base_color"
kind = "texture_2d"
default = "white"

[[texture_slots]]
name = "normal"
kind = "texture_2d"
default = "flat_normal"

[[texture_slots]]
name = "metallic_roughness"
kind = "texture_2d"
default = "white"

[[texture_slots]]
name = "occlusion"
kind = "texture_2d"
default = "white"

[[texture_slots]]
name = "emissive"
kind = "texture_2d"
default = "black"
