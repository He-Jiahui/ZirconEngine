var console = %import("zr.system.console");
var rules = %import("combat/rules");

console.printLine("m4-combat-rules-test");
var result: int = 1;
if (rules.metric(0, 10.0, 10.0, 0.0, 0.0) < 0.959999 ||
    rules.metric(0, 10.0, 13.0, 0.0, 0.0) < 0.749999 ||
    rules.metric(0, 20.0, 10.0, 0.0, 0.0) < 0.989999) {
    result = -1;
}
if (result == 1 &&
    (rules.metric(1, 10.0, 10.0, 0.0, 0.0) < 0.049999 ||
     rules.metric(1, 10.0, 13.0, 0.0, 0.0) < 0.259999 ||
     rules.metric(1, 13.0, 10.0, 0.0, 0.0) < 0.043999)) {
    result = -2;
}
if (result == 1 &&
    (rules.metric(2, 1.0, 60.0, 0.0, 1.0) < 0.199999 ||
     rules.metric(2, 10.0, 12.0, 0.1, 0.0) < 0.089999)) {
    result = -3;
}
if (result == 1 &&
    (rules.metric(3, 110.0, 1.0, 0.0, 0.0) < 0.184872 ||
     rules.metric(3, 1000000.0, 1.0, 0.0, 0.0) != 0.75)) {
    result = -4;
}
if (result == 1 &&
    (rules.metric(4, 1.0, 0.0, 0.0, 0.0) < 7.5090 ||
     rules.metric(5, 100.0, 1.0, 0.0, 0.0) < 99.8 ||
     rules.metric(6, 30.0, 10.0, 0.0, 0.0) != 2.0)) {
    result = -5;
}
if (result == 1 &&
    (rules.metric(7, 0.0, 0.0, 0.0, 25.0) < 2.079999 ||
     rules.metric(7, 0.0, 0.0, 0.0, 4.0) < 0.709999)) {
    result = -6;
}
if (result == 1 &&
    (rules.metric(8, 100.0, 20.0, 1.5, 1.3) < 220.999999 ||
     rules.metric(9, 100.0, 4.0, 0.0, 0.0) != 12.5)) {
    result = -7;
}
if (result == 1 &&
    (rules.metric(10, 90.0, 120.0, 0.0, 0.0) != 90.0 ||
     rules.metric(11, 90.0, 120.0, 0.0, 0.0) != 0.0 ||
     rules.metric(12, 40.0, 90.0, 80.0, 0.0) != 50.0 ||
     rules.metric(13, 40.0, 90.0, 80.0, 0.0) != 90.0)) {
    result = -8;
}
if (result == 1 &&
    (rules.metric(14, 95.0, 100.0, 20.0, 0.0) != 100.0 ||
     rules.metric(14, 5.0, 100.0, -20.0, 0.0) != 0.0)) {
    result = -9;
}
console.printLine(result);
return result == 1 ? 0 : result;
