var console = %import("zr.system.console");
var classes = %import("combat/class_scenarios");

console.printLine("m4-class-scenarios-test");
var result: int = 1;
if (classes.metric(0, 1000.0, 1.0, 0.7, 0.5) != 525.0) { result = -1; }
if (result == 1 && classes.metric(1, 1000.0, 200.0, 0.0, 0.0) != 800.0) { result = -2; }
if (result == 1 && classes.metric(2, 600.0, 3.0, 1.0, 0.0) != 100.0) { result = -3; }
if (result == 1 && classes.metric(3, 100.0, 0.7, 0.5, 1.0) != 105.0) { result = -4; }
if (result == 1 && classes.metric(4, 10.0, 2.0, 0.0, 0.0) != 5.0) { result = -5; }
if (result == 1 && classes.metric(4, 4.5, 2.0, 0.0, 0.0) != 3.0) { result = -6; }
if (result == 1 && classes.metric(5, 4.0, 5.0, 0.0, 0.0) != 5.0) { result = -7; }
if (result == 1 && <int>classes.scenarioContract(0, 1001, 6) != 1) { result = -8; }
if (result == 1 && <int>classes.scenarioContract(1, 1002, 8) != 1) { result = -9; }
if (result == 1 && <int>classes.scenarioContract(2, 1003, 6) != 1) { result = -10; }
if (result == 1 && <int>classes.scenarioContract(3, 1016, 6) != 1) { result = -11; }
if (result == 1 && <int>classes.scenarioContract(4, 1007, 10) != 1) { result = -12; }
console.printLine(result);
return result == 1 ? 0 : result;
