var container = %import("zr.container");

class HealEntity {
    pub var id: uint;
    pub var kind: string;
    pub var dead: bool;
    pub var hp: int;
    pub var maxHp: int;
    pub var spellCritChance: float;
    pub var critDamageHealBonus: float;
    pub var auraIds: container.Array<string>;
    pub var auraKinds: container.Array<string>;
    pub var auraValues: container.Array<float>;

    pub @constructor() {
        this.id = <uint>0;
        this.kind = "player";
        this.dead = false;
        this.hp = 100;
        this.maxHp = 100;
        this.spellCritChance = 0.0;
        this.critDamageHealBonus = 0.0;
        this.auraIds = new container.Array<string>();
        this.auraKinds = new container.Array<string>();
        this.auraValues = new container.Array<float>();
    }

    pub addAura(id: string, kind: string, value: float): void {
        this.auraIds.add(id);
        this.auraKinds.add(kind);
        this.auraValues.add(value);
    }
}

class AwareMobProjection {
    pub var dead: container.Array<bool>;
    pub var hostile: container.Array<bool>;
    pub var inCombat: container.Array<bool>;
    pub var hasThreatEntries: container.Array<bool>;
    pub var directTargetEntry: container.Array<bool>;
    pub var ownedPetEntry: container.Array<bool>;
    pub var healerThreat: container.Array<float>;

    pub @constructor() {
        this.dead = new container.Array<bool>();
        this.hostile = new container.Array<bool>();
        this.inCombat = new container.Array<bool>();
        this.hasThreatEntries = new container.Array<bool>();
        this.directTargetEntry = new container.Array<bool>();
        this.ownedPetEntry = new container.Array<bool>();
        this.healerThreat = new container.Array<float>();
    }

    pub addMob(
        isDead: bool,
        isHostile: bool,
        isInCombat: bool,
        hasEntries: bool,
        directEntry: bool,
        petEntry: bool
    ): void {
        this.dead.add(isDead);
        this.hostile.add(isHostile);
        this.inCombat.add(isInCombat);
        this.hasThreatEntries.add(hasEntries);
        this.directTargetEntry.add(directEntry);
        this.ownedPetEntry.add(petEntry);
        this.healerThreat.add(0.0);
    }
}

class HealEvents {
    pub var randomUnits: container.Array<float>;
    pub var randomIndex: int;
    pub var healEvents: int;
    pub var weaponProcCalls: int;
    pub var lastHealed: int;
    pub var lastCrit: bool;

    pub @constructor() {
        this.randomUnits = new container.Array<float>();
        this.randomIndex = 0;
        this.healEvents = 0;
        this.weaponProcCalls = 0;
        this.lastHealed = 0;
        this.lastCrit = false;
    }
}

roundPositive(value: float): int {
    return <int>(value + 0.5);
}

closeEnough(actual: float, expected: float): bool {
    var difference = actual - expected;
    if (difference < 0.0) { difference = -difference; }
    return difference <= 0.000001;
}

removeAuraAt(entity: HealEntity, index: int): void {
    entity.auraIds.removeAt(index);
    entity.auraKinds.removeAt(index);
    entity.auraValues.removeAt(index);
}

productReduction(entity: HealEntity, kind: string): float {
    var result = 1.0;
    var index = 0;
    while (index < entity.auraKinds.length) {
        if (<string>entity.auraKinds[index] == kind) {
            result = result * (1.0 - <float>entity.auraValues[index]);
        }
        index = index + 1;
    }
    return result < 0.0 ? 0.0 : result;
}

threatModifier(source: HealEntity): float {
    var result = 1.0;
    var index = 0;
    while (index < source.auraKinds.length) {
        var kind = <string>source.auraKinds[index];
        if (kind == "defensive_stance" || kind == "form_bear") {
            result = result * 1.3;
        } else if (kind == "form_cat") {
            result = result * 0.71;
        }
        index = index + 1;
    }
    return result;
}

takeRandomUnit(events: HealEvents): float {
    if (events.randomIndex < 0 || events.randomIndex >= events.randomUnits.length) {
        throw "heal random stream is exhausted";
    }
    var result = <float>events.randomUnits[events.randomIndex];
    events.randomIndex = events.randomIndex + 1;
    return result;
}

pub consumeHealAbsorb(target: HealEntity, healed: int): int {
    if (healed <= 0) { return healed; }
    var remaining = healed;
    var depleted = false;
    var index = 0;
    while (index < target.auraKinds.length) {
        if (<string>target.auraKinds[index] == "heal_absorb" &&
            <float>target.auraValues[index] > 0.0) {
            var budget = <float>target.auraValues[index];
            var eaten = budget < <float>remaining ? budget : <float>remaining;
            target.auraValues[index] = budget - eaten;
            remaining = remaining - <int>eaten;
            if (<float>target.auraValues[index] <= 0.0) { depleted = true; }
            if (remaining <= 0) { break; }
        }
        index = index + 1;
    }
    if (depleted) {
        index = target.auraKinds.length - 1;
        while (index >= 0) {
            if (<string>target.auraKinds[index] == "heal_absorb" &&
                <float>target.auraValues[index] <= 0.0) {
                removeAuraAt(target, index);
            }
            index = index - 1;
        }
    }
    return remaining;
}

mobAwareOfTarget(mobs: AwareMobProjection, index: int, targetKind: string): bool {
    if (<bool>mobs.directTargetEntry[index]) { return true; }
    return targetKind == "player" && <bool>mobs.ownedPetEntry[index];
}

pub applyHealingThreat(
    source: HealEntity,
    target: HealEntity,
    healed: int,
    mobs: AwareMobProjection
): void {
    if (source.kind != "player" || healed <= 0) { return; }
    var awareCount = 0;
    var index = 0;
    while (index < mobs.dead.length) {
        if (!<bool>mobs.dead[index] && <bool>mobs.hostile[index] &&
            <bool>mobs.inCombat[index] && <bool>mobs.hasThreatEntries[index] &&
            mobAwareOfTarget(mobs, index, target.kind)) {
            awareCount = awareCount + 1;
        }
        index = index + 1;
    }
    if (awareCount == 0) { return; }
    var perMob = <float>healed * 0.5 * threatModifier(source) / <float>awareCount;
    index = 0;
    while (index < mobs.dead.length) {
        if (!<bool>mobs.dead[index] && <bool>mobs.hostile[index] &&
            <bool>mobs.inCombat[index] && <bool>mobs.hasThreatEntries[index] &&
            mobAwareOfTarget(mobs, index, target.kind)) {
            mobs.healerThreat[index] = <float>mobs.healerThreat[index] + perMob;
        }
        index = index + 1;
    }
}

pub applyHeal(
    source: HealEntity,
    target: HealEntity,
    amount: float,
    mobs: AwareMobProjection,
    events: HealEvents
): int {
    if (target.dead) { return 0; }
    var crit = takeRandomUnit(events) < source.spellCritChance;
    var critMultiplier = crit ? 1.5 + source.critDamageHealBonus : 1.0;
    var healed = roundPositive(
        <float>amount * critMultiplier * productReduction(source, "hex") *
            productReduction(target, "mortal_wound")
    );
    healed = consumeHealAbsorb(target, healed);
    var missing = target.maxHp - target.hp;
    if (healed > missing) { healed = missing; }
    target.hp = target.hp + healed;
    events.healEvents = events.healEvents + 1;
    events.lastHealed = healed;
    events.lastCrit = crit;
    applyHealingThreat(source, target, healed, mobs);
    events.weaponProcCalls = events.weaponProcCalls + 1;
    return healed;
}

pub applyHotTick(
    source: HealEntity,
    target: HealEntity,
    value: int,
    sourcePresent: bool,
    mobs: AwareMobProjection,
    events: HealEvents
): int {
    var healed = roundPositive(
        <float>value * productReduction(target, "mortal_wound")
    );
    var missing = target.maxHp - target.hp;
    if (healed > missing) { healed = missing; }
    if (healed <= 0) { return 0; }
    target.hp = target.hp + healed;
    events.healEvents = events.healEvents + 1;
    events.lastHealed = healed;
    events.lastCrit = false;
    if (sourcePresent) { applyHealingThreat(source, target, healed, mobs); }
    return healed;
}

makeEntity(id: uint, kind: string, hp: int, maxHp: int): HealEntity {
    var result = new HealEntity();
    result.id = id;
    result.kind = kind;
    result.hp = hp;
    result.maxHp = maxHp;
    return result;
}

threeAwareMobs(): AwareMobProjection {
    var mobs = new AwareMobProjection();
    mobs.addMob(false, true, true, true, true, false);
    mobs.addMob(false, true, true, true, true, false);
    mobs.addMob(false, true, true, true, false, true);
    mobs.addMob(true, true, true, true, true, false);
    mobs.addMob(false, false, true, true, true, false);
    mobs.addMob(false, true, false, true, true, false);
    mobs.addMob(false, true, true, false, true, false);
    return mobs;
}

pub contractTest(): int {
    var source = makeEntity(<uint>1, "player", 1000, 1000);
    var target = makeEntity(<uint>2, "player", 10, 1000);
    target.dead = true;
    var events = new HealEvents();
    if (applyHeal(source, target, 500, new AwareMobProjection(), events) != 0 ||
        target.hp != 10 || events.randomIndex != 0 || events.healEvents != 0) {
        return -1;
    }

    target.dead = false;
    source.spellCritChance = 1.0;
    source.addAura("hex", "hex", 0.5);
    target.addAura("wound", "mortal_wound", 0.5);
    target.addAura("absorb", "heal_absorb", 100.0);
    target.hp = 100;
    var mobs = threeAwareMobs();
    events = new HealEvents();
    events.randomUnits.add(0.75);
    if (applyHeal(source, target, 1000, mobs, events) != 275 || target.hp != 375 ||
        events.randomIndex != 1 || !events.lastCrit || events.weaponProcCalls != 1 ||
        target.auraKinds.length != 1 ||
        <string>target.auraKinds[0] != "mortal_wound" ||
        !closeEnough(<float>mobs.healerThreat[0], 137.5 / 3.0) ||
        !closeEnough(<float>mobs.healerThreat[1], 137.5 / 3.0) ||
        !closeEnough(<float>mobs.healerThreat[2], 137.5 / 3.0) ||
        <float>mobs.healerThreat[3] != 0.0) {
        return -2;
    }

    var absorbs = makeEntity(<uint>3, "player", 100, 10000);
    absorbs.addAura("small", "heal_absorb", 200.0);
    absorbs.addAura("other", "hex", 0.1);
    absorbs.addAura("big", "heal_absorb", 5000.0);
    if (consumeHealAbsorb(absorbs, 1000) != 0 || absorbs.auraKinds.length != 2 ||
        <string>absorbs.auraIds[0] != "other" ||
        <string>absorbs.auraIds[1] != "big" ||
        <float>absorbs.auraValues[1] != 4200.0) {
        return -3;
    }

    var full = makeEntity(<uint>4, "player", 1000, 1000);
    events = new HealEvents();
    events.randomUnits.add(0.9);
    if (applyHeal(source, full, 500, threeAwareMobs(), events) != 0 ||
        events.randomIndex != 1 || events.healEvents != 1 ||
        events.weaponProcCalls != 1) {
        return -4;
    }

    var mobHealer = makeEntity(<uint>5, "mob", 100, 100);
    var injured = makeEntity(<uint>6, "player", 50, 100);
    mobs = threeAwareMobs();
    events = new HealEvents();
    events.randomUnits.add(0.5);
    applyHeal(mobHealer, injured, 20, mobs, events);
    if (<float>mobs.healerThreat[0] != 0.0) { return -5; }

    var hotSource = makeEntity(<uint>7, "player", 100, 100);
    var hotTarget = makeEntity(<uint>8, "player", 100, 1000);
    hotTarget.addAura("wound", "mortal_wound", 0.5);
    hotTarget.addAura("absorb", "heal_absorb", 9999.0);
    mobs = threeAwareMobs();
    events = new HealEvents();
    if (applyHotTick(hotSource, hotTarget, 300, true, mobs, events) != 150 ||
        hotTarget.hp != 250 || <float>hotTarget.auraValues[1] != 9999.0 ||
        events.randomIndex != 0 || events.healEvents != 1 ||
        !closeEnough(<float>mobs.healerThreat[0], 25.0)) {
        return -6;
    }

    // Effect dispatch supplies a fractional source range roll. The source rounds
    // once after critical-heal multiplication, so rounding this to 53 first
    // would incorrectly produce 80 instead of 79.
    var fractionalSource = makeEntity(<uint>9, "player", 100, 100);
    fractionalSource.spellCritChance = 1.0;
    var fractionalTarget = makeEntity(<uint>10, "player", 0, 1000);
    events = new HealEvents();
    events.randomUnits.add(0.0);
    if (applyHeal(
        fractionalSource, fractionalTarget, 52.5, new AwareMobProjection(), events
    ) != 79 || fractionalTarget.hp != 79 || events.randomIndex != 1 ||
        !events.lastCrit) {
        return -7;
    }
    return 1;
}
