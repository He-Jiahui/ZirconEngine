// Resolves source talent modifiers for generated AoE endpoints before target
// selection and range RNG. WorldState keeps timing and all combat side effects.
var catalog = %import("generated/talent_modifier_catalog");
var modifiers = %import("progression/talent_modifier_state");

pub class AoERange {
    pub var minimum: int;
    pub var maximum: int;

    pub @constructor() {
        this.minimum = 0;
        this.maximum = 0;
    }
}

roundPositive(value: float): int {
    return <int>(value + 0.5);
}

pub resolveAoEDamageRange(
    baseMinimum: int,
    baseMaximum: int,
    school: string,
    talentState: modifiers.TalentModifierState,
    abilityId: string
): AoERange {
    var range = new AoERange();
    var globalField = school == "physical" ? "meleeDmgPct" : "spellDmgPct";
    var multiplier = 1.0 + modifiers.globalField(talentState, globalField) +
        modifiers.abilityField(talentState, abilityId, "dmgPct");
    var flat = modifiers.abilityField(talentState, abilityId, "flatDmg");
    range.minimum = roundPositive(<float>baseMinimum * multiplier + flat);
    range.maximum = roundPositive(<float>baseMaximum * multiplier + flat);
    return range;
}

pub resolveAoEHealRange(
    baseMinimum: int,
    baseMaximum: int,
    talentState: modifiers.TalentModifierState,
    abilityId: string
): AoERange {
    var range = new AoERange();
    var multiplier = 1.0 + modifiers.globalField(talentState, "healPct") +
        modifiers.abilityField(talentState, abilityId, "dmgPct");
    var flat = modifiers.abilityField(talentState, abilityId, "flatDmg");
    range.minimum = roundPositive(<float>baseMinimum * multiplier + flat);
    range.maximum = roundPositive(<float>baseMaximum * multiplier + flat);
    return range;
}

setGlobal(talentState: modifiers.TalentModifierState, name: string, value: float): void {
    var index = 0;
    while (index < talentState.globals.length) {
        if (catalog.globalFieldName(index) == name) {
            talentState.globals[index] = value;
            return;
        }
        index = index + 1;
    }
    throw "woc aoe talent global field is absent";
}

setAbilityNumber(
    talentState: modifiers.TalentModifierState,
    abilityId: string,
    name: string,
    value: float
): void {
    var ability = 0;
    while (ability < talentState.abilityIds.length &&
        <string>talentState.abilityIds[ability] != abilityId) {
        ability = ability + 1;
    }
    if (ability == talentState.abilityIds.length) {
        talentState.abilityIds.add(abilityId);
        talentState.abilityDottedIds.add("");
        talentState.abilityCastWhileMoving.add(false);
        talentState.abilityPushbackImmune.add(false);
        talentState.abilityNestedEffectCounts.add(0);
        var newField = 0;
        while (newField < catalog.abilityNumberFieldCount()) {
            talentState.abilityNumbers.add(0.0);
            newField = newField + 1;
        }
    }
    var field = 0;
    while (field < catalog.abilityNumberFieldCount()) {
        if (catalog.abilityNumberFieldName(field) == name) {
            talentState.abilityNumbers[ability * catalog.abilityNumberFieldCount() + field] = value;
            return;
        }
        field = field + 1;
    }
    throw "woc aoe talent ability field is absent";
}

pub contractTest(): int {
    var identity = new modifiers.TalentModifierState();
    var untouched = resolveAoEDamageRange(26, 31, "arcane", identity, "arcane_explosion");
    if (untouched.minimum != 26 || untouched.maximum != 31) { return -1; }

    var mixed = new modifiers.TalentModifierState();
    setGlobal(mixed, "meleeDmgPct", 0.2);
    setGlobal(mixed, "spellDmgPct", 0.1);
    setGlobal(mixed, "healPct", 0.3);
    setAbilityNumber(mixed, "burst", "dmgPct", 0.15);
    setAbilityNumber(mixed, "burst", "flatDmg", 2.0);
    var physical = resolveAoEDamageRange(31, 41, "physical", mixed, "burst");
    var spell = resolveAoEDamageRange(31, 41, "fire", mixed, "burst");
    var heal = resolveAoEHealRange(31, 41, mixed, "burst");
    if (physical.minimum != 44 || physical.maximum != 57 ||
        spell.minimum != 41 || spell.maximum != 53 ||
        heal.minimum != 47 || heal.maximum != 61) {
        return -2;
    }

    var rounded = new modifiers.TalentModifierState();
    setAbilityNumber(rounded, "storm", "dmgPct", 0.15);
    setAbilityNumber(rounded, "storm", "flatDmg", 2.0);
    var endpoints = resolveAoEDamageRange(47, 58, "nature", rounded, "storm");
    var endpointFirst = roundPositive(<float>endpoints.minimum +
        0.5 * <float>(endpoints.maximum - endpoints.minimum));
    var postRoll = roundPositive((47.0 + 0.5 * (58.0 - 47.0)) * 1.15 + 2.0);
    return endpoints.minimum == 56 && endpoints.maximum == 69 &&
        endpointFirst == 63 && postRoll == 62 ? 1 : -3;
}
