var container=%import("zr.container");var group=%import("combat/group_targeting_state");var contract=%import("generated/natures_fury_contract");
pub shouldPulse(pct:float,moonwing:bool,tick:int,sourceId:int):bool{return pct>0.0&&moonwing&&tick%contract.pulseTicks()==sourceId%contract.pulseTicks();}
pub planTargets(state:group.GroupTargetingState,sourceId:int,pct:float,moonwing:bool,tick:int):container.Array<int>{var out=new container.Array<int>();if(!shouldPulse(pct,moonwing,tick,sourceId))return out;var sourceIndex=group.findMemberIndex(state,sourceId);if(sourceIndex<0)return out;var source=<group.GroupTargetMember>state.members[sourceIndex];out.add(sourceId);if(!state.hasParty)return out;var i=0;while(i<state.partyMemberIds.length){var id=<int>state.partyMemberIds[i];if(id!=sourceId){var index=group.findMemberIndex(state,id);if(index>=0){var member=<group.GroupTargetMember>state.members[index];var dx=member.x-source.x;var dz=member.z-source.z;if(!member.isDead&&dx*dx+dz*dz<=contract.radius()*contract.radius())out.add(id);}}i=i+1;}return out;}
pub contractTest():int{var s=new group.GroupTargetingState();group.setMember(s,5,true,false,false,0.0,0.0);group.setMember(s,7,true,false,false,30.0,0.0);group.setMember(s,9,true,false,false,30.1,0.0);group.addPartyMember(s,9);group.addPartyMember(s,5);group.addPartyMember(s,7);var out=planTargets(s,5,0.1,true,5);if(out.length!=2||<int>out[0]!=5||<int>out[1]!=7)return -1;if(planTargets(s,5,0.0,true,5).length!=0||planTargets(s,5,0.1,false,5).length!=0)return -2;return 1;}
