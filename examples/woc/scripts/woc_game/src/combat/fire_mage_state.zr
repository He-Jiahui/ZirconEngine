// 火法命中、暴击和点燃的纯决策投影；world/state 提供权威状态并负责随机、光环、冷却、伤害与事件写入。
var contract = %import("generated/fire_mage_contract");

/// 暴击后仅描述升温、炽热连击与燃烧冷却变化；世界层按此计划处理真实光环及冷却。
pub class HotStreakPlan {
    pub var removeHeating: bool;
    pub var applyHeating: bool;
    pub var applyHotStreakPair: bool;
    pub var updateCombustionCooldown: bool;
    pub var combustionCooldown: float;
    pub @constructor(removeHeating: bool, applyHeating: bool, applyHotStreakPair: bool, updateCombustionCooldown: bool, combustionCooldown: float) {
        this.removeHeating = removeHeating;
        this.applyHeating = applyHeating;
        this.applyHotStreakPair = applyHotStreakPair;
        this.updateCombustionCooldown = updateCombustionCooldown;
        this.combustionCooldown = combustionCooldown;
    }
}

pub class CauterizePlan {
    pub var applies: bool;
    pub var restoredHp: int;
    pub var burnPerTick: int;
    pub @constructor(applies: bool, restoredHp: int, burnPerTick: int) {
        this.applies = applies;
        this.restoredHp = restoredHp;
        this.burnPerTick = burnPerTick;
    }
}

pub class IgnitePlan {
    pub var applies: bool;
    pub var updatesExisting: bool;
    pub var perTick: int;
    pub var resultingValue: int;
    pub @constructor(applies: bool, updatesExisting: bool, perTick: int, resultingValue: int) {
        this.applies = applies;
        this.updatesExisting = updatesExisting;
        this.perTick = perTick;
        this.resultingValue = resultingValue;
    }
}

pub class PersonalBarrierPlan {
    pub var hasBarrier: bool;
    pub var barrierId: string;
    pub @constructor(hasBarrier: bool, barrierId: string) {
        this.hasBarrier = hasBarrier;
        this.barrierId = barrierId;
    }
}

pub class IgniteCritPlan {
    pub var applies: bool;
    pub var amount: int;
    pub var ignitionPct: float;
    pub @constructor(applies: bool, amount: int, ignitionPct: float) {
        this.applies = applies;
        this.amount = amount;
        this.ignitionPct = ignitionPct;
    }
}

/// 火系已承诺施法的必暴条件；燃烧或火焰冲击直接成立，灼烧还须有目标且生命落入阈值。
pub fireGuaranteedCrit(committedFire: bool, school: string, hasCombustion: bool, abilityId: string, targetPresent: bool, targetHp: int, targetMaxHp: int): bool {
    if (school != contract.fireSchool() || !committedFire) return false;
    if (hasCombustion || abilityId == "fire_blast") return true;
    return abilityId == "scorch" && targetPresent && <float>targetHp <= <float>targetMaxHp * contract.scorchExecuteHp();
}

/// 命中后先排除非构筑技能，再区分非暴击清升温、首次暴击升温及再次暴击成对授权；不抽随机数。
pub hotStreakOnSpellHit(committedFire: bool, abilityPresent: bool, abilityId: string, crit: bool, hasHeating: bool, hasCombustion: bool, hasCombustionCooldown: bool, combustionCooldown: float): HotStreakPlan {
    var inert = new HotStreakPlan(false, false, false, false, combustionCooldown);
    if (!abilityPresent || !contract.isHotStreakBuilder(abilityId) || !committedFire) return inert;
    if (!crit) return new HotStreakPlan(hasHeating, false, false, false, combustionCooldown);
    var nextCooldown = combustionCooldown;
    var updateCooldown = false;
    if (!hasCombustion && hasCombustionCooldown && combustionCooldown > 0.0) {
        nextCooldown = combustionCooldown - contract.combustionCdrPerCrit();
        if (nextCooldown < 0.0) nextCooldown = 0.0;
        updateCooldown = true;
    }
    if (!hasHeating) return new HotStreakPlan(false, true, false, updateCooldown, nextCooldown);
    return new HotStreakPlan(true, false, true, updateCooldown, nextCooldown);
}

pub cauterizeFireDamageMult(sourcePresent: bool, sourceIsTarget: bool, sourceHasCauterizing: bool, school: string): float {
    if (!sourcePresent || sourceIsTarget || school != contract.fireSchool()) return 1.0;
    return sourceHasCauterizing ? 1.0 + contract.cauterizeFireDamageBonus() : 1.0;
}

pub personalBarrierForSpec(specPresent: bool, spec: string): PersonalBarrierPlan {
    if (!specPresent) return new PersonalBarrierPlan(false, "");
    if (spec == "arcane") return new PersonalBarrierPlan(true, contract.temporalBarrierId());
    if (spec == "fire") return new PersonalBarrierPlan(true, contract.blazingBarrierId());
    if (spec == "frost") return new PersonalBarrierPlan(true, contract.iceBarrierId());
    return new PersonalBarrierPlan(false, "");
}

// 世界层先核对专精与技能来源，再把非负伤害按 ignitionPct 舍入传给 ignitePlan；本层只返回资格。
/// 点燃前置筛选只返回资格与比例；世界层按已结算暴击伤害舍入，再调用 ignitePlan。
pub igniteOnCritPlan(crit: bool, amount: int, abilityPresent: bool, school: string, sourcePresent: bool, sourceIsTarget: bool, committedFire: bool, ignitionPct: float): IgniteCritPlan {
    if (!crit || amount <= 0 || !abilityPresent || school != contract.fireSchool()) return new IgniteCritPlan(false, amount, ignitionPct);
    if (!sourcePresent || sourceIsTarget || !committedFire || ignitionPct <= 0.0) return new IgniteCritPlan(false, amount, ignitionPct);
    return new IgniteCritPlan(true, amount, ignitionPct);
}

pub isFireSpender(abilityId: string, hasAbilityDefinition: bool): bool {
    return contract.isHotStreakSpender(abilityId) && hasAbilityDefinition;
}

// 致命伤害边界给出恢复生命与后续燃烧计划；实际生命、疲劳光环和事件由世界事务提交。
pub cauterizePlan(isPlayer: bool, targetDead: bool, committedFire: bool, hasFatigue: bool, incoming: int, currentHp: int, maxHp: int): CauterizePlan {
    if (!isPlayer || targetDead || incoming < currentHp || !committedFire || hasFatigue) return new CauterizePlan(false, currentHp, 0);
    var restored = roundPositiveRatio(maxHp, contract.cauterizeHealDivisor());
    if (restored < 1) restored = 1;
    var burn = roundPositiveRatio(maxHp, contract.cauterizeBurnDivisor());
    if (burn < 1) burn = 1;
    return new CauterizePlan(true, restored, burn);
}

// hasOwnedIgnite 对应同一目标、技能与伤害来源的旧点燃；新建或叠加都由世界层刷新周期。
/// 将同来源旧点燃每跳伤害累加或新建；调用者使用 resultingValue 写回并自行刷新周期。
pub ignitePlan(targetDead: bool, burn: int, hasOwnedIgnite: bool, existingValue: int): IgnitePlan {
    if (targetDead || burn <= 0) return new IgnitePlan(false, false, 0, existingValue);
    var perTick = roundPositiveRatio(burn, contract.igniteTickCount());
    if (perTick < 1) perTick = 1;
    return new IgnitePlan(true, hasOwnedIgnite, perTick, hasOwnedIgnite ? existingValue + perTick : perTick);
}

// 对非负整数比例复现 JavaScript 的正中间向上取整；无效分母返回零。
pub roundPositiveRatio(numerator: int, denominator: int): int {
    if (numerator <= 0 || denominator <= 0) return 0;
    var quotient = 0, remainder = numerator;
    while (remainder >= denominator) {
        remainder = remainder - denominator;
        quotient = quotient + 1;
    }
    return remainder * 2 >= denominator ? quotient + 1 : quotient;
}

pub contractTest(): int {
    if (!fireGuaranteedCrit(true, "fire", false, "fire_blast", false, 0, 0)) return -1;
    if (!fireGuaranteedCrit(true, "fire", false, "scorch", true, 30, 100)) return -2;
    if (fireGuaranteedCrit(true, "fire", false, "scorch", true, 31, 100) || fireGuaranteedCrit(false, "fire", true, "fireball", true, 1, 1)) return -3;
    var breakPlan = hotStreakOnSpellHit(true, true, "fireball", false, true, false, true, 6.0);
    if (!breakPlan.removeHeating || breakPlan.updateCombustionCooldown) return -4;
    var firstCrit = hotStreakOnSpellHit(true, true, "scorch", true, false, false, true, 1.0);
    if (!firstCrit.applyHeating || firstCrit.applyHotStreakPair || !firstCrit.updateCombustionCooldown || firstCrit.combustionCooldown != 0.0) return -5;
    var secondCrit = hotStreakOnSpellHit(true, true, "pyroblast", true, true, true, true, 4.0);
    if (!secondCrit.removeHeating || !secondCrit.applyHotStreakPair || secondCrit.updateCombustionCooldown) return -6;
    if (hotStreakOnSpellHit(true, true, "frostbolt", true, true, false, true, 4.0).removeHeating) return -7;
    if (cauterizeFireDamageMult(true, false, true, "fire") != 1.12 || cauterizeFireDamageMult(true, true, true, "fire") != 1.0) return -8;
    var saved = cauterizePlan(true, false, true, false, 100, 100, 101);
    if (!saved.applies || saved.restoredHp != 25 || saved.burnPerTick != 5) return -9;
    if (cauterizePlan(true, false, true, true, 100, 100, 101).applies || cauterizePlan(true, false, true, false, 99, 100, 101).applies) return -10;
    var newIgnite = ignitePlan(false, 4, false, 0);
    var stackedIgnite = ignitePlan(false, 4, true, 6);
    if (!newIgnite.applies || newIgnite.perTick != 1 || newIgnite.resultingValue != 1 || !stackedIgnite.updatesExisting || stackedIgnite.resultingValue != 7) return -11;
    if (ignitePlan(true, 4, false, 0).applies || roundPositiveRatio(5, 2) != 3 || roundPositiveRatio(4, 3) != 1) return -12;
    var barrier = personalBarrierForSpec(true, "frost");
    if (!barrier.hasBarrier || barrier.barrierId != contract.iceBarrierId() || personalBarrierForSpec(true, "shadow").hasBarrier) return -13;
    var igniteCrit = igniteOnCritPlan(true, 100, true, "fire", true, false, true, 0.2);
    if (!igniteCrit.applies || igniteOnCritPlan(true, 100, false, "fire", true, false, true, 0.2).applies || igniteOnCritPlan(true, 100, true, "fire", true, true, true, 0.2).applies) return -14;
    if (!isFireSpender("pyroblast", true) || isFireSpender("pyroblast", false) || isFireSpender("fireball", true)) return -15;
    return 1;
}
