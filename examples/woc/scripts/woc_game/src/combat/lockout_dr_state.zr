// Source-compatible Lockout diminishing returns. Only hostile player pairs
// consume this target-owned ladder; NPC paths preserve their supplied duration.
pub class LockoutDrResolution {
    pub var shouldStore: bool;
    pub var duration: float;
    pub var immune: bool;
    pub var nextStage: int;
    pub var resetAt: float;

    pub @constructor(
        shouldStore: bool,
        duration: float,
        immune: bool,
        nextStage: int,
        resetAt: float
    ) {
        this.shouldStore = shouldStore;
        this.duration = duration;
        this.immune = immune;
        this.nextStage = nextStage;
        this.resetAt = resetAt;
    }
}

pub lockoutResetSeconds(): float { return 18.0; }

pub appliesToPair(sourceIsPlayer: bool, targetIsPlayer: bool, hostile: bool): bool {
    return sourceIsPlayer && targetIsPlayer && hostile;
}

// Mirrors Sim.diminishedCrowdControlDuration's lockout branch. At the fourth
// active application the source returns null and leaves the existing stage and
// reset deadline untouched; callers still cancel the cast and grant Pummel Rage.
pub resolve(
    sourceIsPlayer: bool,
    targetIsPlayer: bool,
    hostile: bool,
    storedStage: int,
    storedResetAt: float,
    now: float,
    duration: float
): LockoutDrResolution {
    if (storedStage < 0 || storedResetAt < 0.0 || now < 0.0 || duration <= 0.0) {
        throw "lockout DR input is invalid";
    }
    if (!appliesToPair(sourceIsPlayer, targetIsPlayer, hostile)) {
        return new LockoutDrResolution(
            false, duration, false, storedStage, storedResetAt
        );
    }
    var stage = storedResetAt > now ? storedStage : 0;
    if (stage >= 3) {
        return new LockoutDrResolution(
            false, 0.0, true, storedStage, storedResetAt
        );
    }
    var multiplier = 1.0;
    if (stage == 1) {
        multiplier = 0.5;
    } else if (stage == 2) {
        multiplier = 0.25;
    }
    return new LockoutDrResolution(
        true,
        duration * multiplier,
        false,
        stage + 1,
        now + lockoutResetSeconds()
    );
}

pub contractTest(): int {
    var npc = resolve(true, false, true, 2, 90.0, 30.0, 4.0);
    if (npc.shouldStore || npc.immune || npc.duration != 4.0 ||
        npc.nextStage != 2 || npc.resetAt != 90.0) {
        return -1;
    }
    var friendly = resolve(true, true, false, 2, 90.0, 30.0, 4.0);
    if (friendly.shouldStore || friendly.immune || friendly.duration != 4.0 ||
        !appliesToPair(true, true, true) || appliesToPair(false, true, true)) {
        return -2;
    }
    var first = resolve(true, true, true, 0, 0.0, 10.0, 4.0);
    var second = resolve(true, true, true, first.nextStage, first.resetAt, 20.0, 4.0);
    var third = resolve(true, true, true, second.nextStage, second.resetAt, 30.0, 4.0);
    var immune = resolve(true, true, true, third.nextStage, third.resetAt, 40.0, 4.0);
    if (!first.shouldStore || first.duration != 4.0 || first.nextStage != 1 ||
        first.resetAt != 28.0 || second.duration != 2.0 || second.nextStage != 2 ||
        second.resetAt != 38.0 || third.duration != 1.0 || third.nextStage != 3 ||
        third.resetAt != 48.0 || immune.shouldStore || !immune.immune ||
        immune.duration != 0.0 || immune.nextStage != 3 || immune.resetAt != 48.0) {
        return -3;
    }
    var expired = resolve(true, true, true, 3, 48.0, 48.0, 4.0);
    return expired.shouldStore && !expired.immune && expired.duration == 4.0 &&
        expired.nextStage == 1 && expired.resetAt == 66.0 ? 1 : -4;
}
