// Resolves cast-time talent modifiers for Judgement only. Seal endpoints,
// spell power, criticals and final rounding stay with their current owners.
var catalog = %import("generated/talent_modifier_catalog");
var modifiers = %import("progression/talent_modifier_state");

pub class JudgementValues {
    pub var damageMultiplier: float;
    pub var flatDamage: float;

    pub @constructor() {
        this.damageMultiplier = 1.0;
        this.flatDamage = 0.0;
    }
}

pub resolveJudgement(
    talentState: modifiers.TalentModifierState, school: string, abilityId: string
): JudgementValues {
    var resolved = new JudgementValues();
    var globalField = school == "physical" ? "meleeDmgPct" : "spellDmgPct";
    resolved.damageMultiplier = 1.0 + modifiers.globalField(talentState, globalField) +
        modifiers.abilityField(talentState, abilityId, "dmgPct");
    resolved.flatDamage = modifiers.abilityField(talentState, abilityId, "flatDmg");
    return resolved;
}

setGlobal(talentState: modifiers.TalentModifierState, name: string, value: float): void {
    var index = 0;
    while (index < talentState.globals.length) {
        if (catalog.globalFieldName(index) == name) {
            talentState.globals[index] = value;
            return;
        }
        index = index + 1;
    }
    throw "woc Judgement talent global field is absent";
}

setAbilityNumber(
    talentState: modifiers.TalentModifierState,
    abilityId: string,
    name: string,
    value: float
): void {
    var ability = 0;
    while (ability < talentState.abilityIds.length &&
        <string>talentState.abilityIds[ability] != abilityId) {
        ability = ability + 1;
    }
    if (ability == talentState.abilityIds.length) {
        talentState.abilityIds.add(abilityId);
        talentState.abilityDottedIds.add("");
        talentState.abilityCastWhileMoving.add(false);
        talentState.abilityPushbackImmune.add(false);
        talentState.abilityNestedEffectCounts.add(0);
        var newField = 0;
        while (newField < catalog.abilityNumberFieldCount()) {
            talentState.abilityNumbers.add(0.0);
            newField = newField + 1;
        }
    }
    var field = 0;
    while (field < catalog.abilityNumberFieldCount()) {
        if (catalog.abilityNumberFieldName(field) == name) {
            talentState.abilityNumbers[
                ability * catalog.abilityNumberFieldCount() + field
            ] = value;
            return;
        }
        field = field + 1;
    }
    throw "woc Judgement talent ability field is absent";
}

pub contractTest(): int {
    var identity = resolveJudgement(
        new modifiers.TalentModifierState(), "holy", "judgement"
    );
    if (identity.damageMultiplier != 1.0 || identity.flatDamage != 0.0) {
        return -1;
    }

    var mixed = new modifiers.TalentModifierState();
    setGlobal(mixed, "spellDmgPct", 0.2);
    setGlobal(mixed, "meleeDmgPct", 0.4);
    setAbilityNumber(mixed, "judgement", "dmgPct", 0.15);
    setAbilityNumber(mixed, "judgement", "flatDmg", 2.0);
    var holy = resolveJudgement(mixed, "holy", "judgement");
    var physical = resolveJudgement(mixed, "physical", "judgement");
    return holy.damageMultiplier == 1.35 && holy.flatDamage == 2.0 &&
        physical.damageMultiplier == 1.55 && physical.flatDamage == 2.0 ? 1 : -2;
}
