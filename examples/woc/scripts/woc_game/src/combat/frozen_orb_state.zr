// 冰球移动、接触停驻与脉冲时钟的独立投影；当前仅叶子测试消费，接入世界时需外部提供碰撞事实并处理伤害及减速效果。
var contract = %import("generated/frozen_orb_contract");

/// 冰球局部时钟与水平位置由调用者保留；接触判定不存于此对象，而是逐步传入。
pub class FrozenOrbState {
    pub var x: float;
    pub var z: float;
    pub var directionX: float;
    pub var directionZ: float;
    pub var remaining: float;
    pub var interval: float;
    pub var pulseTimer: float;
    pub var halted: bool;
    pub @constructor(x: float, z: float, directionX: float, directionZ: float, duration: float, interval: float) {
        this.x = x;
        this.z = z;
        this.directionX = directionX;
        this.directionZ = directionZ;
        this.remaining = duration;
        this.interval = interval;
        this.pulseTimer = interval;
        this.halted = false;
    }
}

/// 单步事件标记供外部提交；同一步允许先脉冲再过期。
pub class FrozenOrbAdvance {
    pub var transitioned: bool;
    pub var halted: bool;
    pub var pulse: bool;
    pub var expired: bool;
    pub @constructor() {
        this.transitioned = false;
        this.halted = false;
        this.pulse = false;
        this.expired = false;
    }
}

/// 单步先切换停驻，再按需移动、递减寿命和脉冲计时，最后标记过期；停驻仍推进寿命与脉冲，每步最多发一次脉冲。
pub advanceFrozenOrb(state: FrozenOrbState, hasContact: bool): FrozenOrbAdvance {
    var result = new FrozenOrbAdvance();
    if (hasContact != state.halted) {
        state.halted = hasContact;
        result.transitioned = true;
    }
    if (!state.halted) {
        state.x = state.x + state.directionX * contract.speed(true) * contract.dt(true);
        state.z = state.z + state.directionZ * contract.speed(true) * contract.dt(true);
    }
    state.remaining = state.remaining - contract.dt(true);
    state.pulseTimer = state.pulseTimer - contract.dt(true);
    if (state.pulseTimer <= 0.0) {
        state.pulseTimer = state.pulseTimer + state.interval;
        result.pulse = true;
    }
    result.halted = state.halted;
    result.expired = state.remaining <= 0.0;
    return result;
}

pub contractTest(): int {
    var orb = new FrozenOrbState(0.0, 0.0, 1.0, 0.0, 0.09, 0.1);
    var first = advanceFrozenOrb(orb, false);
    if (first.transitioned || first.halted || first.pulse || first.expired || orb.x != 0.2) return -1;
    var second = advanceFrozenOrb(orb, true);
    if (!second.transitioned || !second.halted || !second.pulse || !second.expired || orb.x != 0.2 || orb.pulseTimer != 0.1) return -2;
    var resumed = new FrozenOrbState(2.0, 3.0, 0.0, 1.0, 1.0, 1.0);
    advanceFrozenOrb(resumed, true);
    var afterResume = advanceFrozenOrb(resumed, false);
    if (!afterResume.transitioned || afterResume.halted || resumed.z != 3.2) return -3;
    return 1;
}
