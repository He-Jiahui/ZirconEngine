var container=%import("zr.container");var contract=%import("generated/aura_stacking_contract");
pub class AuraRef{pub var id:string;pub var sourceId:int;pub @constructor(id:string,sourceId:int){this.id=id;this.sourceId=sourceId;}}
pub replacementConflicts(auras:container.Array<AuraRef>,id:string,sourceId:int):container.Array<int>{var out=new container.Array<int>(),all=contract.sourceIndependent(id),i=auras.length-1;while(i>=0){var a=<AuraRef>auras[i];if(a.id==id&&(all||a.sourceId==sourceId))out.add(i);i=i-1;}return out;}
pub contractTest():int{var a=new container.Array<AuraRef>();a.add(new AuraRef("arcane_intellect",1));a.add(new AuraRef("arcane_intellect",2));a.add(new AuraRef("other",1));var group=replacementConflicts(a,"arcane_intellect",3);if(group.length!=2||<int>group[0]!=1||<int>group[1]!=0)return -1;var normal=replacementConflicts(a,"other",1);if(normal.length!=1||<int>normal[0]!=2)return -2;if(replacementConflicts(a,"other",2).length!=0)return -3;return 1;}
