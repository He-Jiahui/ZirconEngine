var container=%import("zr.container");var contract=%import("generated/exclusive_aura_contract");
/// 从对齐的身份与互斥组快照收集应删除的倒序索引，同一技能身份不属于冲突；空组或不等长列返回空结果，所以调用者须先保证列合法，不能将空结果当作校验成功。当前仅叶子测试消费。
pub exclusiveAuraConflicts(newGroup:string,newAbilityId:string,ids:container.Array<string>,groups:container.Array<string>):container.Array<int>{var out=new container.Array<int>();if(newGroup==""||ids.length!=groups.length)return out;var i=ids.length-1;while(i>=0){if(<string>ids[i]!=newAbilityId&&<string>groups[i]==newGroup)out.add(i);i=i-1;}return out;}
pub contractTest():int{var ids=new container.Array<string>();var groups=new container.Array<string>();ids.add("a");groups.add("g");ids.add("new");groups.add("g");ids.add("b");groups.add("g");var out=exclusiveAuraConflicts("g","new",ids,groups);if(!contract.descending()||out.length!=2||<int>out[0]!=2||<int>out[1]!=0)return -1;if(exclusiveAuraConflicts("","new",ids,groups).length!=0)return -2;return 1;}
