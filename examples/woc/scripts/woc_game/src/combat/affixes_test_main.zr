var console = %import("zr.system.console");
var affixes = %import("combat/affixes");

console.printLine("m4-affixes-test");
var result: int = 1;
if (affixes.metric(0, 0.2, 0.3, 1.0, 1.0) != 1.0) { result = -1; }
if (result == 1 && affixes.metric(0, 0.2, 0.3, 0.0, 1.0) != 0.0) { result = -2; }
if (result == 1 && affixes.metric(1, 4.0, 5.0, 0.0, 0.0) != 5.0) { result = -3; }
if (result == 1 && affixes.metric(2, 4.0, 20.0, 0.0, 0.0) != 80.0) { result = -4; }
if (result == 1 && affixes.metric(3, 0.3, 0.0, 0.0, 0.0) != 1.0) { result = -5; }
if (result == 1 && affixes.metric(4, 170.0, 0.0, 0.0, 0.0) != 0.17) { result = -6; }
if (result == 1 && affixes.metric(5, 0.75, 0.17, 0.0, 0.0) != 0.92) { result = -7; }
if (result == 1 && <int>affixes.scenarioContract(0, 1004, 5) != 1) { result = -8; }
if (result == 1 && <int>affixes.scenarioContract(1, 1007, 6) != 1) { result = -9; }
if (result == 1 && <int>affixes.scenarioContract(2, 1021, 1) != 1) { result = -10; }
if (result == 1 && <int>affixes.scenarioContract(3, 1015, 4) != 1) { result = -11; }
console.printLine(result);
return result == 1 ? 0 : result;
