// Full current-head item-level lookup table. It is generated by executing the
// pinned source item_level.ts graph, so source-index precedence stays with the
// target implementation rather than a second handwritten Zr index algorithm.
var catalog = %import("generated/item_level_catalog");

pub hasItemSourceLevel(itemId: string): bool {
    return catalog.itemSourceLevel(itemId) > 0;
}

pub itemSourceLevel(itemId: string): int {
    return catalog.itemSourceLevel(itemId);
}

pub itemFromRaid(itemId: string): bool {
    return catalog.itemFromRaid(itemId);
}

pub hasItemLevel(itemId: string): bool {
    return catalog.itemLevel(itemId) > 0;
}

pub itemLevel(itemId: string): int {
    return catalog.itemLevel(itemId);
}

pub contractTest(): int {
    var sourceItem = catalog.fixtureSourceItemId();
    if (!hasItemSourceLevel(sourceItem) ||
        itemSourceLevel(sourceItem) != catalog.fixtureSourceItemLevel()) return -1;
    if (hasItemSourceLevel(catalog.fixtureNoSourceItemId()) ||
        itemSourceLevel(catalog.fixtureNoSourceItemId()) != 0) return -2;
    if (!itemFromRaid(catalog.fixtureRaidItemId()) ||
        itemSourceLevel(catalog.fixtureRaidItemId()) != catalog.fixtureRaidItemSourceLevel()) return -3;
    var levelItem = catalog.fixtureItemLevelItemId();
    if (!hasItemLevel(levelItem) || itemLevel(levelItem) != catalog.fixtureItemLevel()) return -4;
    return 1;
}
