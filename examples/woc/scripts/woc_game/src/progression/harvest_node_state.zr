// Scalar source rules for the authoritative harvest_node reducer. Mutable
// inventory, player, timer and event arrays remain owned by WorldState until
// the ZrVM cross-module Array ABI is a reliable mutation boundary.
var math = %import("zr.zircon.math");
var contract = %import("generated/gathering_contract");
var inventory = %import("progression/m5_inventory_rules");
var experience = %import("generated/profession_action_xp_contract");

pub nodeCount(): int {
    return contract.nodeCount();
}

pub professionCount(): int {
    return contract.professionCount();
}

pub nodeIdUtf8Length(index: int): int {
    return contract.nodeIdUtf8Length(index);
}

pub nodeIdUtf8Byte(index: int, byteIndex: int): uint {
    return contract.nodeIdUtf8Byte(index, byteIndex);
}

pub nodeX(index: int): float {
    return contract.nodeXAt(index);
}

pub nodeZ(index: int): float {
    return contract.nodeZAt(index);
}

pub nodeLevel(index: int): int {
    return <int>contract.nodeLevelAt(index);
}

pub interactRangeSquared(): float {
    return contract.interactRange() * contract.interactRange();
}

pub professionCode(index: int): uint {
    var nodeType = contract.nodeTypeAt(index);
    if (nodeType == "ore") return <uint>1;
    if (nodeType == "wood") return <uint>2;
    if (nodeType == "herb") return <uint>3;
    return <uint>0;
}

pub professionIndex(index: int): int {
    return <int>professionCode(index) - 1;
}

pub itemCode(index: int): uint {
    var nodeType = contract.nodeTypeAt(index);
    return inventory.itemCodeForId(contract.nodeHarvestItemFor(nodeType));
}

pub respawnMicros(index: int): uint {
    var nodeType = contract.nodeTypeAt(index);
    return <uint>(contract.nodeRespawnSecondsFor(nodeType) * 1000000.0);
}

// The three source zones each expose ore, wood and herb. The bit order is
// zone-major, then the closed profession order mining/logging/herbalism.
pub visitedBit(index: int): uint {
    var zone = contract.nodeZoneAt(index);
    var zoneBase = zone == "eastbrook_vale" ? 0 :
        (zone == "mirefen_marsh" ? 3 : (zone == "thornpeak_heights" ? 6 : -1));
    var profession = professionIndex(index);
    var bit = zoneBase + profession;
    if (zoneBase < 0 || profession < 0 || bit > 8) return <uint>0;
    if (bit == 0) return <uint>1;
    if (bit == 1) return <uint>2;
    if (bit == 2) return <uint>4;
    if (bit == 3) return <uint>8;
    if (bit == 4) return <uint>16;
    if (bit == 5) return <uint>32;
    if (bit == 6) return <uint>64;
    if (bit == 7) return <uint>128;
    return <uint>256;
}

// Codes 1..5 preserve common, uncommon, rare, epic, legendary. The caller
// supplies the one authoritative draw consumed by a successful harvest.
pub rarityCode(proficiency: uint, randomUnit: float): uint {
    var maximum = contract.materialRarityMaxProficiency();
    var limited = <float>proficiency;
    if (limited > maximum) limited = maximum;
    var roll = randomUnit * maximum;
    var commonWeight = maximum - limited;
    if (roll < commonWeight) return <uint>1;
    roll = roll - commonWeight;
    var uncommonWeight = limited * contract.materialRarityShare("uncommon");
    if (roll < uncommonWeight) return <uint>2;
    roll = roll - uncommonWeight;
    var rareWeight = limited * contract.materialRarityShare("rare");
    if (roll < rareWeight) return <uint>3;
    roll = roll - rareWeight;
    var epicWeight = limited * contract.materialRarityShare("epic");
    return roll < epicWeight ? <uint>4 : <uint>5;
}

pub gatherExperience(index: int, playerLevel: int): int {
    var contentLevel = nodeLevel(index);
    var base = experience.gatherXpBase() + experience.gatherXpPerLevel() * contentLevel;
    var difference = contentLevel - playerLevel;
    if (difference >= 0) {
        var bonusLevels = difference < experience.higherLevelBonusCap() ?
            difference : experience.higherLevelBonusCap();
        return <int>math.floor(
            <float>base * (1.0 + experience.higherLevelBonusPerLevel() * <float>bonusLevels) + 0.5
        );
    }
    var grayDifference = experience.zeroDiff(playerLevel);
    if (-difference >= grayDifference) return 0;
    return <int>math.floor(
        <float>base * (1.0 - <float>(-difference) / <float>grayDifference) + 0.5
    );
}

pub contractTest(): int {
    return nodeCount() == 24 && professionCount() == 3 &&
        nodeIdUtf8Length(0) == 15 && nodeIdUtf8Byte(0, 0) == <uint>111 &&
        professionCode(0) == <uint>1 && itemCode(0) == <uint>36 &&
        respawnMicros(0) == <uint>120000000 && visitedBit(0) == <uint>1 &&
        rarityCode(<uint>0, 0.5) == <uint>1 && gatherExperience(0, 1) == 21 ? 1 : -1;
}
