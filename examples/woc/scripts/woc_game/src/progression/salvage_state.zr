// Current-head professions/salvage.ts projection. Definitions carry the
// upstream requiredLevelFor result; item catalog lookup and instance ownership
// remain with the wider inventory transaction owner.
var container = %import("zr.container");
var rng = %import("kernel/rng");
var contract = %import("generated/salvage_contract");

pub class SalvageItemDefinition {
    pub var itemId: string;
    // Source item kinds are represented by their source strings: weapon, armor,
    // or anything else.
    pub var kind: string;
    pub var quality: string;
    pub var requiredLevel: int;

    pub @constructor() {
        this.itemId = "";
        this.kind = "";
        this.quality = "";
        this.requiredLevel = 0;
    }
}

pub class SalvageResult {
    // 0 success, 1 unknown item, 2 not salvageable, 3 not held.
    pub var ok: bool;
    pub var reason: int;
    pub var itemId: string;
    pub var materialItemId: string;
    pub var count: int;

    pub @constructor() {
        this.ok = false;
        this.reason = 0;
        this.itemId = "";
        this.materialItemId = "";
        this.count = 0;
    }
}

pub class SalvageState {
    pub var definitions: container.Array<SalvageItemDefinition>;
    // This is the source removePreferFungible domain: per-item fungible counts.
    // Instance resolution remains at the inventory owner boundary.
    pub var itemIds: container.Array<string>;
    pub var itemCounts: container.Array<int>;

    pub @constructor() {
        this.definitions = new container.Array<SalvageItemDefinition>();
        this.itemIds = new container.Array<string>();
        this.itemCounts = new container.Array<int>();
    }
}

definitionIndex(state: SalvageState, itemId: string): int {
    var index = 0;
    while (index < state.definitions.length) {
        if ((<SalvageItemDefinition>state.definitions[index]).itemId == itemId) return index;
        index = index + 1;
    }
    return -1;
}

itemIndex(state: SalvageState, itemId: string): int {
    var index = 0;
    while (index < state.itemIds.length) {
        if (<string>state.itemIds[index] == itemId) return index;
        index = index + 1;
    }
    return -1;
}

pub addDefinition(state: SalvageState, definition: SalvageItemDefinition): void {
    var index = definitionIndex(state, definition.itemId);
    if (index < 0) {
        state.definitions.add(definition);
        return;
    }
    state.definitions[index] = definition;
}

pub addItem(state: SalvageState, itemId: string, count: int): void {
    if (count <= 0) return;
    var index = itemIndex(state, itemId);
    if (index < 0) {
        state.itemIds.add(itemId);
        state.itemCounts.add(count);
        return;
    }
    state.itemCounts[index] = <int>state.itemCounts[index] + count;
}

pub itemCount(state: SalvageState, itemId: string): int {
    var index = itemIndex(state, itemId);
    return index < 0 ? 0 : <int>state.itemCounts[index];
}

pub isSalvageable(definition: SalvageItemDefinition): bool {
    return (definition.kind == "weapon" || definition.kind == "armor") &&
        definition.quality != "" && definition.quality != "poor";
}

qualityIndex(quality: string): int {
    var index = 0;
    while (index < contract.qualityCount()) {
        if (contract.qualityAt(index) == quality) return index;
        index = index + 1;
    }
    return -1;
}

pub salvageYieldForRoll(definition: SalvageItemDefinition, randomUnit: float): int {
    var quality = qualityIndex(definition.quality);
    if (quality < 0) quality = 0;
    // requiredLevelFor produces a nonnegative level; the state accepts that
    // resolved value rather than duplicating the cross-catalog derivation.
    var level = definition.requiredLevel;
    if (level < 0) level = 0;
    var tierBonus = level / contract.tierLevelsPerBonus();
    var bonus = randomUnit < contract.rollThreshold() ? 0 : 1;
    return quality + tierBonus + 1 + bonus;
}

pub salvageYield(definition: SalvageItemDefinition, stream: rng.Mulberry32): int {
    return salvageYieldForRoll(definition, stream.next());
}

pub resolveSalvage(
    state: SalvageState, itemId: string, stream: rng.Mulberry32
): SalvageResult {
    var result = new SalvageResult();
    result.itemId = itemId;
    var definitionAt = definitionIndex(state, itemId);
    if (definitionAt < 0) {
        result.reason = 1;
        return result;
    }
    var definition = <SalvageItemDefinition>state.definitions[definitionAt];
    if (!isSalvageable(definition)) {
        result.reason = 2;
        return result;
    }
    var heldAt = itemIndex(state, itemId);
    if (heldAt < 0 || <int>state.itemCounts[heldAt] < 1) {
        result.reason = 3;
        return result;
    }
    // Match removePreferFungible: commit the one-item removal before the RNG
    // draw and material grant, with every rejection above leaving state intact.
    state.itemCounts[heldAt] = <int>state.itemCounts[heldAt] - 1;
    result.ok = true;
    result.materialItemId = contract.materialForQuality(definition.quality);
    result.count = salvageYield(definition, stream);
    addItem(state, result.materialItemId, result.count);
    return result;
}

makeDefinition(
    itemId: string, kind: string, quality: string, requiredLevel: int
): SalvageItemDefinition {
    var definition = new SalvageItemDefinition();
    definition.itemId = itemId;
    definition.kind = kind;
    definition.quality = quality;
    definition.requiredLevel = requiredLevel;
    return definition;
}

pub contractTest(): int {
    var state = new SalvageState();
    addDefinition(state, makeDefinition("sword", "weapon", "common", 10));
    addDefinition(state, makeDefinition("robe", "armor", "rare", 25));
    addDefinition(state, makeDefinition("potion", "consumable", "rare", 25));
    addDefinition(state, makeDefinition("junk", "weapon", "poor", 20));
    var stream = new rng.Mulberry32(<uint>7);
    if (resolveSalvage(state, "unknown", stream).reason != 1 ||
        resolveSalvage(state, "potion", stream).reason != 2 ||
        resolveSalvage(state, "junk", stream).reason != 2 ||
        resolveSalvage(state, "sword", stream).reason != 3 || stream.draws != <uint>0) return -1;
    var sword = <SalvageItemDefinition>state.definitions[0];
    var robe = <SalvageItemDefinition>state.definitions[1];
    if (salvageYieldForRoll(sword, 0.49) != 3 || salvageYieldForRoll(sword, 0.5) != 4 ||
        salvageYieldForRoll(robe, 0.49) != 6 || salvageYieldForRoll(robe, 0.5) != 7) return -2;
    addItem(state, "sword", 1);
    var first = resolveSalvage(state, "sword", stream);
    if (!first.ok || first.materialItemId != "bone_fragments" || first.count < 3 ||
        first.count > 4 || itemCount(state, "sword") != 0 ||
        itemCount(state, "bone_fragments") != first.count || stream.draws != <uint>1) return -3;
    addItem(state, "robe", 1);
    var second = resolveSalvage(state, "robe", stream);
    if (!second.ok || second.materialItemId != "spider_leg" || second.count < 6 ||
        second.count > 7 || itemCount(state, "robe") != 0 ||
        itemCount(state, "spider_leg") != second.count || stream.draws != <uint>2) return -4;
    return 1;
}
