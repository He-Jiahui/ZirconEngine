// Source-compatible quest_fallback.ts decision leaf. The source callback
// `hasItem` is represented by the authoritative owned-item snapshot supplied
// by the caller; this module returns only the ordered ids that must be granted.
var container = %import("zr.system.container");

contains(items: container.Array<string>, itemId: string): bool {
    var index = 0;
    while (index < items.length) {
        if (<string>items[index] == itemId) { return true; }
        index = index + 1;
    }
    return false;
}

// Mirrors questFallbackGrants: absent/empty requirements produce no grants,
// already-owned requirements are skipped, and repeated missing ids retain only
// their first source-order occurrence.
pub questFallbackGrants(
    requiredItems: container.Array<string>, ownedItems: container.Array<string>
): container.Array<string> {
    var grants = new container.Array<string>();
    var index = 0;
    while (index < requiredItems.length) {
        var itemId = <string>requiredItems[index];
        if (!contains(ownedItems, itemId) && !contains(grants, itemId)) {
            grants.add(itemId);
        }
        index = index + 1;
    }
    return grants;
}
