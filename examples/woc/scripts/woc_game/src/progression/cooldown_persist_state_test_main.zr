var console = %import("zr.system.console");
var container = %import("zr.container");
var cooldowns = %import("progression/cooldown_persist_state");

var result = 1;

var live = new cooldowns.CooldownStore();
live.setCooldown(<uint>100, 22.5);
live.setCooldown(<uint>200, 180.0);
var saved = cooldowns.serializeCooldowns(live, -1.0, 0.0);
var restored = new cooldowns.CooldownStore();
var allKnown = new container.Array<uint>();
if (!saved.present || !saved.hasAbilities || saved.abilities.length != 2 ||
    cooldowns.applyCooldowns(saved, restored, 9999.0, false, allKnown) != -1.0 ||
    restored.cooldownRemaining(<uint>100) != 22.5 ||
    restored.cooldownRemaining(<uint>200) != 180.0) {
    result = -1;
}

var potionLive = new cooldowns.CooldownStore();
var potionSaved = cooldowns.serializeCooldowns(potionLive, 140.0, 100.0);
if (result == 1 && (!potionSaved.present || !potionSaved.hasPotion ||
    potionSaved.potion != 40.0 ||
    cooldowns.applyCooldowns(potionSaved, new cooldowns.CooldownStore(), 5.0, false, allKnown) != 45.0)) {
    result = -2;
}

var emptySaved = cooldowns.serializeCooldowns(new cooldowns.CooldownStore(), -1.0, 0.0);
if (result == 1 && (emptySaved.present ||
    cooldowns.applyCooldowns(emptySaved, new cooldowns.CooldownStore(), 0.0, false, allKnown) != -1.0)) {
    result = -3;
}

var tampered = new cooldowns.CooldownSnapshot();
tampered.present = true;
tampered.hasAbilities = true;
tampered.abilities.add(new cooldowns.CooldownEntry(<uint>100, 10.0));
tampered.abilities.add(new cooldowns.CooldownEntry(<uint>101, 0.0));
tampered.abilities.add(new cooldowns.CooldownEntry(<uint>102, -5.0));
var defensive = new cooldowns.CooldownStore();
cooldowns.applyCooldowns(tampered, defensive, 0.0, false, allKnown);
if (result == 1 && (defensive.cooldownRemaining(<uint>100) != 10.0 ||
    defensive.hasCooldown(<uint>101) || defensive.hasCooldown(<uint>102))) {
    result = -4;
}

var knownOnly = new container.Array<uint>();
knownOnly.add(<uint>100);
var filtered = new cooldowns.CooldownStore();
cooldowns.applyCooldowns(saved, filtered, 0.0, true, knownOnly);
if (result == 1 && (filtered.cooldownRemaining(<uint>100) != 22.5 ||
    filtered.hasCooldown(<uint>200))) {
    result = -5;
}

var charged = new cooldowns.CooldownStore();
charged.abilityCharges.add(new cooldowns.AbilityChargeState(<uint>100, 1, 2, 5.5, 8.0));
charged.abilityCharges.add(new cooldowns.AbilityChargeState(<uint>101, 2, 2, 0.0, 240.0));
var liveCharge = <cooldowns.AbilityChargeState>charged.abilityCharges[0];
liveCharge.hasRecharges = true;
liveCharge.recharges.add(7.0);
liveCharge.recharges.add(2.0);
var chargedSaved = cooldowns.serializeCooldowns(charged, -1.0, 0.0);
var chargedRestored = new cooldowns.CooldownStore();
cooldowns.applyCooldowns(chargedSaved, chargedRestored, 0.0, false, allKnown);
var restoredChargeIndex = chargedRestored.chargeIndex(<uint>100);
if (result == 1 && (!chargedSaved.hasAbilityCharges || chargedSaved.abilityCharges.length != 1 ||
    restoredChargeIndex != 0 || chargedRestored.hasCooldown(<uint>100))) {
    result = -6;
}
if (result == 1) {
    var savedCharge = <cooldowns.AbilityChargeState>chargedSaved.abilityCharges[0];
    if (!savedCharge.hasRecharges || savedCharge.recharges.length != 2 ||
        (<float>savedCharge.recharges[0]) != 7.0 ||
        (<float>savedCharge.recharges[1]) != 2.0) {
        result = -6;
    }
}
if (result == 1) {
    var restoredCharge = <cooldowns.AbilityChargeState>chargedRestored.abilityCharges[restoredChargeIndex];
    if (restoredCharge.charges != 1 || restoredCharge.maxCharges != 2 ||
        restoredCharge.recharge != 5.5 || restoredCharge.rechargeLength != 8.0 ||
        !restoredCharge.hasRecharges || restoredCharge.recharges.length != 2 ||
        (<float>restoredCharge.recharges[0]) != 2.0 ||
        (<float>restoredCharge.recharges[1]) != 7.0) {
        result = -6;
    }
}

var drained = new cooldowns.CooldownStore();
drained.setCooldown(<uint>100, 6.0);
drained.abilityCharges.add(new cooldowns.AbilityChargeState(<uint>100, 0, 2, 6.0, 8.0));
var drainedSaved = cooldowns.serializeCooldowns(drained, -1.0, 0.0);
var drainedRestored = new cooldowns.CooldownStore();
cooldowns.applyCooldowns(drainedSaved, drainedRestored, 0.0, false, allKnown);
var drainedChargeIndex = drainedRestored.chargeIndex(<uint>100);
if (result == 1 && (drainedChargeIndex != 0 ||
    drainedRestored.cooldownRemaining(<uint>100) != 6.0)) {
    result = -7;
}
if (result == 1 && (<cooldowns.AbilityChargeState>drainedRestored.abilityCharges[drainedChargeIndex]).charges != 0) {
    result = -7;
}

var legacy = new cooldowns.CooldownSnapshot();
legacy.present = true;
legacy.hasAbilities = true;
legacy.abilities.add(new cooldowns.CooldownEntry(<uint>100, 5.0));
legacy.hasLegacyCharges = true;
legacy.legacyCharges.add(new cooldowns.LegacyChargeState(<uint>100, 1, 8.0));
var caps = new container.Array<cooldowns.ChargeCap>();
caps.add(new cooldowns.ChargeCap(<uint>100, 2, 8.0));
var legacyRestored = new cooldowns.CooldownStore();
cooldowns.applyCooldownsWithLegacy(legacy, legacyRestored, 0.0, false, allKnown, caps);
var legacyChargeIndex = legacyRestored.chargeIndex(<uint>100);
if (result == 1 && (legacyChargeIndex != 0 || legacyRestored.hasCooldown(<uint>100))) {
    result = -8;
}
if (result == 1) {
    var legacyCharge = <cooldowns.AbilityChargeState>legacyRestored.abilityCharges[legacyChargeIndex];
    if (legacyCharge.charges != 1 || legacyCharge.maxCharges != 2 ||
        legacyCharge.recharge != 5.0 || legacyCharge.rechargeLength != 8.0) {
        result = -8;
    }
}

var modernEmpty = new cooldowns.CooldownSnapshot();
modernEmpty.present = true;
modernEmpty.hasAbilities = true;
modernEmpty.abilities.add(new cooldowns.CooldownEntry(<uint>100, 5.0));
modernEmpty.hasAbilityCharges = true;
modernEmpty.hasLegacyCharges = true;
modernEmpty.legacyCharges.add(new cooldowns.LegacyChargeState(<uint>100, 1, 8.0));
var priorityRestored = new cooldowns.CooldownStore();
cooldowns.applyCooldownsWithLegacy(modernEmpty, priorityRestored, 0.0, false, allKnown, caps);
if (result == 1 && (priorityRestored.chargeIndex(<uint>100) != -1 ||
    priorityRestored.cooldownRemaining(<uint>100) != 5.0)) {
    result = -9;
}

console.printLine("m5-cooldown-persist-state-test");
console.printLine(result);
return result == 1 ? 0 : result;
