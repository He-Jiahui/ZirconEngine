// Source-compatible serialize_resource.ts leaf. The Zr boundary represents
// source null resource types as the existing optional-string sentinel "".
// WOS must supply its natural resource type, live bar type and parked mana
// before using this value in an authoritative character snapshot.

/// 保存调用方须同时提供职业本源资源和当前形态资源；变形时返回停放的法力池，不能把它当作当前资源条展示值。
pub persistedResource(
    classResourceType: string,
    liveResourceType: string,
    liveResource: int,
    savedMana: int
): int {
    // A mana class in Bear/Cat form has rage/energy in its live bar while
    // savedMana holds the caster pool that reload restores.
    if (classResourceType == "mana" && liveResourceType != "mana") {
        return savedMana;
    }
    return liveResource;
}
