// TODO: [CR-WOC-IPS-I-0009] 此事务断言入口当前未被.zrp或测试runner引用；需补可执行注册并运行后才能计入对应集成覆盖。
var delve = %import("instances/delve_state");

var state = new delve.DelveState();
if (!delve.unlockNextDelveLore(state) || state.lastDelveLoreId != "eastbrook_ledger" ||
    !delve.unlockNextDelveLore(state) || state.lastDelveLoreId != "first_collapse" ||
    !delve.unlockNextDelveLore(state) || state.lastDelveLoreId != "gravecaller_mark" ||
    !delve.unlockNextDelveLore(state) || state.lastDelveLoreId != "bell_below" ||
    !delve.unlockNextDelveLore(state) || state.lastDelveLoreId != "tessa_note" ||
    delve.unlockNextDelveLore(state) || delve.unlockedDelveLoreCount(state) != 5 ||
    delve.unlockedDelveLoreId(state, 5) != "") {
    return -1;
}

return 0;
