pub contractTest(): int {
    if (moduleCount(true) != 11 ||
        spawnCount(0, 0, true) != 4 ||
        spawnMobId(0, 0, 0, true) != "reliquary_ledger_wraith" ||
        spawnCoordinate(0, 0, 0, 1, true) != -5.0 ||
        spawnCoordinate(0, 0, 0, 2, true) != 26.0 ||
        interactableCount(0, true) != 3 ||
        interactableKind(0, 0, true) != "pressure_plate" ||
        puzzleInteractableCount(0, true) != 2 ||
        puzzleInteractableIndex(0, 1, true) != 1) {
        return -1;
    }
    if (spawnCount(4, 0, true) != 6 ||
        interactableCount(5, true) != 4 ||
        puzzleInteractableCount(5, true) != 4 ||
        puzzleInteractableIndex(5, 3, true) != 3 ||
        hazardCount(4, true) != 6 ||
        hazardFloat(4, 0, 1, true) != -8.0 ||
        hazardTierCode(4, 0, true) != 1) {
        return -2;
    }
    if (spawnCount(10, 0, true) != 1 ||
        hazardCount(10, true) != 4) {
        return -3;
    }
    return 1;
}
