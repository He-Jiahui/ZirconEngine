pub contractTest(): int {
    return shopCount(true) == 2 && shopId(0, true) == "collapsed_reliquary" &&
        shopId(1, true) == "drowned_litany" && offerCount(0, true) == 9 &&
        offerCount(1, true) == 9 && offerItemId(0, 0, true) == "reliquary_legs" &&
        offerMarks(0, 6, true) == 12 && offerGateKind(0, 6, true) == 2 &&
        offerRequiredClears(0, 6, true) == 3 && offerGateKind(1, 8, true) == 3 &&
        offerMarks(1, 8, true) == 56 ? 1 : -1;
}
