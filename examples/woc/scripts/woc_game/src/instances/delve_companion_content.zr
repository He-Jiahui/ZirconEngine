// Generated Delve companion identities and rank-up costs.
pub maxRank(required: bool): int {
    if (!required) { throw "woc Delve companion catalog is required"; }
    return 3;
}

pub companionCount(required: bool): int {
    if (!required) { throw "woc Delve companion catalog is required"; }
    return 2;
}

pub companionId(index: int, required: bool): string {
    if (!required) { throw "woc Delve companion catalog is required"; }
    if (index == 0) { return "companion_tessa"; }
    if (index == 1) { return "companion_edda"; }
    return "";
}

pub companionIdUtf8Length(index: int, required: bool): int {
    if (!required) { throw "woc Delve companion catalog is required"; }
    if (index == 0) { return 15; }
    if (index == 1) { return 14; }
    return 0;
}

pub companionIdUtf8Byte(index: int, byteIndex: int, required: bool): uint {
    if (!required) { throw "woc Delve companion catalog is required"; }
    if (index == 0 && byteIndex == 0) { return <uint>99; }
    if (index == 0 && byteIndex == 1) { return <uint>111; }
    if (index == 0 && byteIndex == 2) { return <uint>109; }
    if (index == 0 && byteIndex == 3) { return <uint>112; }
    if (index == 0 && byteIndex == 4) { return <uint>97; }
    if (index == 0 && byteIndex == 5) { return <uint>110; }
    if (index == 0 && byteIndex == 6) { return <uint>105; }
    if (index == 0 && byteIndex == 7) { return <uint>111; }
    if (index == 0 && byteIndex == 8) { return <uint>110; }
    if (index == 0 && byteIndex == 9) { return <uint>95; }
    if (index == 0 && byteIndex == 10) { return <uint>116; }
    if (index == 0 && byteIndex == 11) { return <uint>101; }
    if (index == 0 && byteIndex == 12) { return <uint>115; }
    if (index == 0 && byteIndex == 13) { return <uint>115; }
    if (index == 0 && byteIndex == 14) { return <uint>97; }
    if (index == 1 && byteIndex == 0) { return <uint>99; }
    if (index == 1 && byteIndex == 1) { return <uint>111; }
    if (index == 1 && byteIndex == 2) { return <uint>109; }
    if (index == 1 && byteIndex == 3) { return <uint>112; }
    if (index == 1 && byteIndex == 4) { return <uint>97; }
    if (index == 1 && byteIndex == 5) { return <uint>110; }
    if (index == 1 && byteIndex == 6) { return <uint>105; }
    if (index == 1 && byteIndex == 7) { return <uint>111; }
    if (index == 1 && byteIndex == 8) { return <uint>110; }
    if (index == 1 && byteIndex == 9) { return <uint>95; }
    if (index == 1 && byteIndex == 10) { return <uint>101; }
    if (index == 1 && byteIndex == 11) { return <uint>100; }
    if (index == 1 && byteIndex == 12) { return <uint>100; }
    if (index == 1 && byteIndex == 13) { return <uint>97; }
    return <uint>0;
}

pub upgradeMarks(rank: int, required: bool): int {
    if (!required) { throw "woc Delve companion upgrade is required"; }
    if (rank == 2) { return 3; }
    if (rank == 3) { return 5; }
    return 0;
}

pub upgradeCopper(rank: int, required: bool): int {
    if (!required) { throw "woc Delve companion upgrade is required"; }
    if (rank == 2) { return 0; }
    if (rank == 3) { return 0; }
    return 0;
}

pub contractTest(): int {
    return maxRank(true) == 3 && companionCount(true) == 2 &&
        companionId(0, true) == "companion_tessa" &&
        companionId(1, true) == "companion_edda" &&
        companionIdUtf8Length(0, true) == 15 &&
        companionIdUtf8Length(1, true) == 14 &&
        companionIdUtf8Byte(0, 0, true) == <uint>99 &&
        companionIdUtf8Byte(1, 13, true) == <uint>97 &&
        upgradeMarks(2, true) == 3 &&
        upgradeMarks(3, true) == 5 && upgradeCopper(2, true) == 0 &&
        upgradeCopper(3, true) == 0 ? 1 : -1;
}
