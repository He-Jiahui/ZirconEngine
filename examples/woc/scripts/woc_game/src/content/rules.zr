pub metric(kind: int, marker: int, a: int, b: int): float {
    if (marker != 1 || a != 2 || b != 3) {
        throw "WOC content rule metric marker is invalid";
    }
    if (kind == 1) {
        return 0.05;
    }
    if (kind == 2) {
        return 1.1;
    }
    if (kind == 3) {
        return 1.3;
    }
    if (kind == 4) {
        return 6.0;
    }
    if (kind == 5) {
        return 0.2;
    }
    if (kind == 6) {
        return 600.0;
    }
    if (kind == 7 || kind == 9) {
        return 2.0;
    }
    if (kind == 8) {
        return 9.0;
    }
    if (kind == 10) {
        return 8.0;
    }
    throw "WOC content rule metric kind is invalid";
}

pub contractTest(): int {
    if (metric(1, 1, 2, 3) != 0.05 || metric(2, 1, 2, 3) != 1.1 ||
        metric(3, 1, 2, 3) != 1.3 || metric(4, 1, 2, 3) != 6.0 ||
        metric(5, 1, 2, 3) != 0.2 || metric(6, 1, 2, 3) != 600.0) {
        return -1;
    }
    if (metric(7, 1, 2, 3) != 2.0 || metric(8, 1, 2, 3) != 9.0 ||
        metric(9, 1, 2, 3) != 2.0 || metric(10, 1, 2, 3) != 8.0) {
        return -2;
    }
    return 1;
}
