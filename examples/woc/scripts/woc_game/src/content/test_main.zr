var console = %import("zr.system.console");
var content = %import("content/m3_mobs");

console.printLine("m3-content-test");
var stage = 1;
while (stage <= 9) {
    var result = content.stageTest(stage);
    console.printLine(result);
    if (result != 1) {
        return result;
    }
    stage = stage + 1;
}
var contract = content.contractTest(1, 1, 2, 3, 5, 8, 13);
console.printLine(contract);
if (contract != 1) {
    return contract;
}
return 0;
