var container = %import("zr.container");
var lifecycle = %import("kernel/lifecycle");
var symbols = %import("generated/trace_symbols");

class Writer {
    pri var bytes: container.Array<uint>;

    pub @constructor() {
        this.bytes = new container.Array<uint>();
    }

    pub byte(value: uint, width: int): void {
        if (width != 1 || value > <uint>255) {
            throw "lifecycle trace byte is invalid";
        }
        var target = this.bytes;
        target.add(value);
    }

    pub u16(value: uint, lowBytes: int, highBytes: int): void {
        if (lowBytes != 1 || highBytes != 1) {
            throw "lifecycle trace u16 layout is invalid";
        }
        this.byte(value & <uint>255, 1);
        this.byte((value >> 8) & <uint>255, 1);
    }

    pub u32(value: uint, a: int, b: int, c: int): void {
        if (a != 1 || b != 1 || c != 2) {
            throw "lifecycle trace u32 layout is invalid";
        }
        this.u16(value & <uint>65535, 1, 1);
        this.u16((value >> 16) & <uint>65535, 1, 1);
    }

    pub u64(value: uint, a: int, b: int, c: int, d: int): void {
        if (a != 1 || b != 1 || c != 2 || d != 4) {
            throw "lifecycle trace u64 layout is invalid";
        }
        this.u32(value & <uint>4294967295, 1, 1, 2);
        this.u32(value >> 32, 1, 1, 2);
    }

    pub finish(): container.Array<uint> {
        var copy = new container.Array<uint>();
        var source = this.bytes;
        for (var value in source) {
            copy.add(<uint>value);
        }
        return copy;
    }
}

key(writer: Writer, symbol: int, required: bool): void {
    if (!required || symbol <= 0 || symbol > 65535) {
        throw "lifecycle trace key symbol is invalid";
    }
    writer.u16(<uint>symbol, 1, 1);
}

collection(writer: Writer, kind: int, length: uint, marker: int): void {
    if (marker != 1 || (kind != 10 && kind != 11)) {
        throw "lifecycle trace collection is invalid";
    }
    writer.byte(<uint>kind, 1);
    writer.u32(length, 1, 1, 2);
}

scalar(
    writer: Writer,
    kind: int,
    intValue: int,
    floatValue: float,
    symbol: int,
    flag: bool,
    marker: int
): void {
    if (marker != 1) {
        throw "lifecycle trace scalar marker is invalid";
    }
    if (kind == 0) {
        writer.byte(<uint>0, 1);
        return;
    }
    if (kind == 1) {
        writer.byte(flag ? <uint>2 : <uint>1, 1);
        return;
    }
    if (kind == 3) {
        if (intValue < 0) {
            throw "lifecycle trace unsigned value is negative";
        }
        writer.byte(<uint>3, 1);
        writer.u64(<uint>intValue, 1, 1, 2, 4);
        return;
    }
    if (kind == 4) {
        writer.byte(<uint>4, 1);
        var negativeInt = intValue < 0;
        writer.byte(negativeInt ? <uint>1 : <uint>0, 1);
        writer.u64(negativeInt ? <uint>(-intValue) : <uint>intValue, 1, 1, 2, 4);
        return;
    }
    if (kind == 5) {
        writer.byte(<uint>5, 1);
        var negativeFloat = floatValue < 0.0;
        writer.byte(negativeFloat ? <uint>1 : <uint>0, 1);
        var absolute = negativeFloat ? -floatValue : floatValue;
        writer.u64(<uint>(absolute * 1000000.0 + 0.5), 1, 1, 2, 4);
        return;
    }
    if (kind == 6) {
        writer.byte(<uint>6, 1);
        return;
    }
    if (kind == 9) {
        if (symbol <= 0 || symbol > 65535) {
            throw "lifecycle trace string symbol is invalid";
        }
        writer.byte(<uint>9, 1);
        writer.u16(<uint>symbol, 1, 1);
        return;
    }
    throw "lifecycle trace scalar kind is invalid";
}

emptyObject(writer: Writer, required: bool): void {
    if (!required) {
        throw "lifecycle empty object must be observed";
    }
    collection(writer, 11, <uint>0, 1);
}

bags(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "lifecycle bags marker is invalid";
    }
    collection(writer, 10, <uint>4, 1);
    scalar(writer, 0, 0, 0.0, 0, false, 1);
    scalar(writer, 0, 0, 0.0, 0, false, 1);
    scalar(writer, 0, 0, 0.0, 0, false, 1);
    scalar(writer, 0, 0, 0.0, 0, false, 1);
}

equipment(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "lifecycle equipment marker is invalid";
    }
    collection(writer, 11, <uint>2, 1);
    key(writer, 134, true); scalar(writer, 9, 0, 0.0, 717, false, 1);
    key(writer, 503, true); scalar(writer, 9, 0, 0.0, 960, false, 1);
}

inventory(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "lifecycle inventory marker is invalid";
    }
    collection(writer, 10, <uint>1, 1);
    collection(writer, 11, <uint>2, 1);
    key(writer, 181, true); scalar(writer, 3, 5, 0.0, 0, false, 1);
    key(writer, 450, true); scalar(writer, 9, 0, 0.0, 74, false, 1);
}

talents(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "lifecycle talents marker is invalid";
    }
    collection(writer, 11, <uint>2, 1);
    key(writer, 135, true); emptyObject(writer, true);
    key(writer, 712, true); emptyObject(writer, true);
}

position(writer: Writer, kind: int, marker: int): void {
    if (marker != 1 || kind < 0 || kind > 7) {
        throw "lifecycle position kind is invalid";
    }
    var x = 2.0;
    var y = 1.5;
    var z = -2.0;
    if (kind == 1) { x = 5.0; z = 1.0; }
    else if (kind == 2) { x = 7.0; z = 1.0; }
    else if (kind == 3) { x = 9.0; z = 1.0; }
    else if (kind == 4) { x = 6.0; z = 2.0; }
    else if (kind == 5) { x = 4.0; z = 0.0; }
    else if (kind == 6) { x = 300.0; y = 54.410541; z = 300.0; }
    else if (kind == 7) { x = 700.0; y = 56.399945; z = 300.0; }
    collection(writer, 11, kind == 5 ? <uint>2 : <uint>3, 1);
    key(writer, 961, true); scalar(writer, 5, 0, x, 0, false, 1);
    key(writer, 964, true); scalar(writer, 5, 0, y, 0, false, 1);
    if (kind != 5) {
        key(writer, 965, true); scalar(writer, 5, 0, z, 0, false, 1);
    }
}

playerStats(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "lifecycle player stats marker is invalid";
    }
    collection(writer, 11, <uint>6, 1);
    key(writer, 29, true); scalar(writer, 3, 20, 0.0, 0, false, 1);
    key(writer, 56, true); scalar(writer, 3, 110, 0.0, 0, false, 1);
    key(writer, 445, true); scalar(writer, 3, 10, 0.0, 0, false, 1);
    key(writer, 824, true); scalar(writer, 3, 11, 0.0, 0, false, 1);
    key(writer, 828, true); scalar(writer, 3, 22, 0.0, 0, false, 1);
    key(writer, 837, true); scalar(writer, 3, 23, 0.0, 0, false, 1);
}

armorStats(writer: Writer, armor: int, marker: int): void {
    if (marker != 1 || armor <= 0) {
        throw "lifecycle armor stats marker is invalid";
    }
    collection(writer, 11, <uint>1, 1);
    key(writer, 56, true); scalar(writer, 3, armor, 0.0, 0, false, 1);
}

weapon(writer: Writer, maximum: int, minimum: int, speed: float, marker: int): void {
    if (marker != 1 || maximum <= 0 || minimum <= 0 || speed <= 0.0) {
        throw "lifecycle weapon marker is invalid";
    }
    collection(writer, 11, <uint>3, 1);
    key(writer, 518, true); scalar(writer, 3, maximum, 0.0, 0, false, 1);
    key(writer, 529, true); scalar(writer, 3, minimum, 0.0, 0, false, 1);
    key(writer, 821, true); scalar(writer, 5, 0, speed, 0, false, 1);
}

progression(writer: Writer, stage: int, kind: int, marker: int): void {
    if (marker != 1 || stage < 1 || stage > 6 || kind < 0 || kind > 4) {
        throw "lifecycle progression contract is invalid";
    }
    var damage = stage == 1 ? 1096 : (stage <= 3 ? 2293 : (stage == 4 ? 3389 : 4485));
    var kills = stage == 1 ? 1 : (stage <= 3 ? 2 : (stage == 4 ? 3 : 4));
    var xp = stage == 1 ? 84 : (stage <= 3 ? 198 : (stage == 4 ? 282 : 366));
    if (kind == 0) {
        collection(writer, 11, stage >= 3 ? <uint>4 : <uint>3, 1);
        key(writer, 198, true); scalar(writer, 3, damage, 0.0, 0, false, 1);
        if (stage >= 3) {
            key(writer, 199, true); scalar(writer, 3, 18, 0.0, 0, false, 1);
        }
        key(writer, 461, true); scalar(writer, 3, kills, 0.0, 0, false, 1);
        key(writer, 963, true); scalar(writer, 3, xp, 0.0, 0, false, 1);
        return;
    }
    if (kind == 1) {
        collection(writer, 11, <uint>2, 1);
        key(writer, 198, true); scalar(writer, 3, damage, 0.0, 0, false, 1);
        key(writer, 461, true); scalar(writer, 3, kills, 0.0, 0, false, 1);
        return;
    }
    if (kind == 2) {
        collection(writer, 10, stage >= 5 ? <uint>2 : <uint>1, 1);
        if (stage >= 5) {
            collection(writer, 10, <uint>2, 1);
            scalar(writer, 9, 0, 0.0, 136, false, 1);
            scalar(writer, 9, 0, 0.0, 1, false, 1);
        }
        collection(writer, 10, <uint>2, 1);
        scalar(writer, 9, 0, 0.0, 151, false, 1);
        scalar(writer, 9, 0, 0.0, 1, false, 1);
        return;
    }
    if (kind == 3) {
        scalar(writer, 3, xp, 0.0, 0, false, 1);
        return;
    }
    scalar(writer, 3, stage >= 5 ? 15 : 10, 0.0, 0, false, 1);
}

deedStats(writer: Writer, stage: int, marker: int): void {
    if (marker != 1) {
        throw "lifecycle deed stats marker is invalid";
    }
    collection(writer, 11, <uint>3, 1);
    key(writer, 182, true); progression(writer, stage, 1, 1);
    key(writer, 289, true); emptyObject(writer, true);
    key(writer, 452, true);
    collection(writer, 10, <uint>3, 1);
    scalar(writer, 9, 0, 0.0, 74, false, 1);
    scalar(writer, 9, 0, 0.0, 717, false, 1);
    scalar(writer, 9, 0, 0.0, 960, false, 1);
}

playerMeta(writer: Writer, stage: int, marker: int): void {
    if (marker != 1 || stage < 1 || stage > 6) {
        throw "lifecycle player metadata stage is invalid";
    }
    collection(writer, 11, stage == 1 ? <uint>26 : <uint>28, 1);
    key(writer, 17, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 45, true); emptyObject(writer, true);
    key(writer, 51, true); scalar(writer, 3, 1500, 0.0, 0, false, 1);
    key(writer, 54, true); scalar(writer, 3, 1500, 0.0, 0, false, 1);
    key(writer, 73, true); bags(writer, 1);
    key(writer, 76, true); emptyObject(writer, true);
    key(writer, 148, true); scalar(writer, 9, 0, 0.0, 946, false, 1);
    key(writer, 166, true); emptyObject(writer, true);
    key(writer, 182, true); progression(writer, stage, 0, 1);
    key(writer, 186, true); emptyObject(writer, true);
    key(writer, 187, true); emptyObject(writer, true);
    key(writer, 221, true); deedStats(writer, stage, 1);
    if (stage >= 2) {
        key(writer, 220, true); progression(writer, stage, 2, 1);
    }
    key(writer, 234, true); emptyObject(writer, true);
    key(writer, 235, true); emptyObject(writer, true);
    key(writer, 311, true); scalar(writer, 3, 408, 0.0, 0, false, 1);
    key(writer, 315, true); equipment(writer, 1);
    key(writer, 316, true); emptyObject(writer, true);
    key(writer, 378, true); emptyObject(writer, true);
    key(writer, 408, true); emptyObject(writer, true);
    key(writer, 447, true); inventory(writer, 1);
    key(writer, 473, true); progression(writer, stage, 3, 1);
    key(writer, 502, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 567, true); emptyObject(writer, true);
    if (stage >= 2) {
        key(writer, 728, true); progression(writer, stage, 4, 1);
    }
    key(writer, 854, true); talents(writer, 1);
    key(writer, 882, true); emptyObject(writer, true);
    key(writer, 962, true); progression(writer, stage, 3, 1);
}

playerEntity(writer: Writer, stage: int, marker: int): void {
    if (marker != 1 || stage < 1 || stage > 6) {
        throw "lifecycle player entity stage is invalid";
    }
    collection(writer, 11, stage >= 3 ? <uint>29 : <uint>28, 1);
    key(writer, 30, true); scalar(writer, 9, 0, 0.0, 437, false, 1);
    key(writer, 66, true); scalar(writer, 3, 46, 0.0, 0, false, 1);
