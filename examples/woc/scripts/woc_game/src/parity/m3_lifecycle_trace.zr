frameMetrics(stage: int, kind: int, marker: int): uint {
    if (marker != 1 || stage < 0 || stage > 6 || kind < 0 || kind > 1) {
        throw "lifecycle frame metrics contract is invalid";
    }
    if (stage == 0) { return kind == 0 ? <uint>0 : <uint>2166136261; }
    if (stage == 1) { return kind == 0 ? <uint>5 : <uint>3397107356; }
    if (stage == 2) { return kind == 0 ? <uint>8 : <uint>3402092466; }
    if (stage == 3) { return kind == 0 ? <uint>9 : <uint>2292892409; }
    if (stage == 4) { return kind == 0 ? <uint>15 : <uint>3396338987; }
    return kind == 0 ? <uint>20 : <uint>3859941660;
}

frame(writer: Writer, stage: int, label: int, nextId: int, marker: int): void {
    if (marker != 1 || stage < 0 || stage > 6) {
        throw "lifecycle trace frame marker is invalid";
    }
    writer.u64(<uint>0, 1, 1, 2, 4);
    scalar(writer, 3, 0, 0.0, 0, false, 1);
    writer.u64(<uint>nextId, 1, 1, 2, 4);
    writer.u16(<uint>label, 1, 1);
    writer.byte(<uint>1, 1);
    writer.u32(frameMetrics(stage, 0, 1), 1, 1, 2);
    writer.u32(frameMetrics(stage, 1, 1), 1, 1, 2);
    if (stage == 0) {
        collection(writer, 10, <uint>0, 1);
        collection(writer, 10, <uint>0, 1);
    } else {
        collection(writer, 10, <uint>1, 1);
        playerMeta(writer, stage, 1);
        var entityCount = stage == 1 ? 5 : (stage <= 3 ? 6 : (stage == 4 ? 7 : 8));
        collection(writer, 10, <uint>entityCount, 1);
        playerEntity(writer, stage, 1);
        deadMob(writer, 1, stage, 1);
        frenzyWolf(writer, 410, 2, 1);
        frenzyWolf(writer, 411, 3, 1);
        boar(writer, 1);
        if (stage >= 2) { deadMob(writer, 2, stage, 1); }
        if (stage >= 4) { respawnedWolf(writer, 1); }
        if (stage >= 5) { deadMob(writer, 3, stage, 1); }
    }
    var eventDigest: uint = <uint>1947613349;
    if (stage == 1) { eventDigest = <uint>392025863; }
    else if (stage == 2) { eventDigest = <uint>3480757726; }
    else if (stage == 3) { eventDigest = <uint>30476328; }
    else if (stage == 4) { eventDigest = <uint>988982999; }
    else if (stage == 5) { eventDigest = <uint>3226696724; }
    writer.u32(eventDigest, 1, 1, 2);
}

buildTrace(marker: int): container.Array<uint> {
    if (marker != 1) {
        throw "lifecycle trace build marker is invalid";
    }
    if (lifecycle.scenarioContractTest() != 1) {
        throw "lifecycle trace authority contract failed";
    }
    var writer = new Writer();
    writer.byte(<uint>87, 1);
    writer.byte(<uint>84, 1);
    writer.byte(<uint>82, 1);
    writer.byte(<uint>49, 1);
    writer.u16(<uint>1, 1, 1);
    writer.u64(symbols.fingerprint(), 1, 1, 2, 4);
    writer.u16(<uint>532, 1, 1);
    writer.u32(<uint>1015, 1, 1, 2);
    writer.u32(<uint>1, 1, 1, 2);
    writer.u32(<uint>0, 1, 1, 2);
    writer.u16(<uint>5, 1, 1);
    writer.u16(<uint>210, 1, 1);
    writer.u16(<uint>209, 1, 1);
    writer.u16(<uint>175, 1, 1);
    writer.u16(<uint>176, 1, 1);
    writer.u16(<uint>177, 1, 1);
    writer.u32(<uint>20, 1, 1, 2);
    writer.u32(<uint>3859941660, 1, 1, 2);
    writer.u16(<uint>7, 1, 1);

    frame(writer, 0, 444, 408, 1);
    frame(writer, 1, 600, 413, 1);
    frame(writer, 2, 871, 414, 1);
    frame(writer, 3, 872, 414, 1);
    frame(writer, 4, 732, 416, 1);
    frame(writer, 5, 288, 417, 1);
    frame(writer, 6, 342, 417, 1);
    return writer.finish();
}

byteDigest(bytes: container.Array<uint>, marker: int, required: bool): uint {
    if (marker != 1 || !required) {
        throw "lifecycle trace digest contract is invalid";
    }
    var hash: uint = <uint>2166136261;
    for (var byte in bytes) {
        hash = ((hash ^ <uint>byte) * <uint>16777619) & <uint>4294967295;
    }
    return hash;
}

hexDigit(value: int, marker: int): string {
    if (marker != 1 || value < 0 || value > 15) {
        throw "lifecycle trace hex digit is invalid";
    }
    if (value == 0) { return "0"; }
    if (value == 1) { return "1"; }
    if (value == 2) { return "2"; }
    if (value == 3) { return "3"; }
    if (value == 4) { return "4"; }
    if (value == 5) { return "5"; }
    if (value == 6) { return "6"; }
    if (value == 7) { return "7"; }
    if (value == 8) { return "8"; }
    if (value == 9) { return "9"; }
    if (value == 10) { return "a"; }
    if (value == 11) { return "b"; }
    if (value == 12) { return "c"; }
    if (value == 13) { return "d"; }
    if (value == 14) { return "e"; }
    return "f";
}

// Validation-only scalar bridge while exported Array<uint> signatures are broken.
// Runtime trace transport remains the lossless byte contract owned by Plugins 08.
pub traceHexForValidation(required: bool): string {
    if (!required) {
        throw "lifecycle trace validation hex must be observed";
    }
    var bytes = buildTrace(1);
    var result = "";
    for (var byte in bytes) {
        var value = <uint>byte;
        result = result + hexDigit(<int>(value >> 4), 1) +
            hexDigit(<int>(value & <uint>15), 1);
    }
    return result;
}

pub byteMetric(kind: int, required: bool): uint {
    if (!required || kind < 0 || kind > 1) {
        throw "lifecycle trace byte metric is invalid";
    }
    var bytes = buildTrace(1);
    if (kind == 0) {
        return <uint>bytes.length;
    }
    return byteDigest(bytes, 1, true);
}

pub selfTest(): int {
    var first = buildTrace(1);
    var second = buildTrace(1);
    if (first.length != 19803 || first.length != second.length) {
        return -2;
    }
    if (byteDigest(first, 1, true) != <uint>971948515 ||
        byteDigest(first, 1, true) != byteDigest(second, 1, true)) {
        return -3;
    }
    return 1;
}
