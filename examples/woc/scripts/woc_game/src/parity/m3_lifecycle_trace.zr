    key(writer, 427, true); scalar(writer, 3, stage >= 3 ? 999982 : 90, 0.0, 0, false, 1);
    key(writer, 436, true); scalar(writer, 3, 408, 0.0, 0, false, 1);
    key(writer, 443, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 462, true); scalar(writer, 9, 0, 0.0, 639, false, 1);
    key(writer, 470, true); scalar(writer, 3, 1, 0.0, 0, false, 1);
    key(writer, 487, true); scalar(writer, 6, 0, 0.0, 0, false, 1);
    key(writer, 520, true); scalar(writer, 3, 90, 0.0, 0, false, 1);
    key(writer, 521, true); scalar(writer, 3, 100, 0.0, 0, false, 1);
    key(writer, 548, true); scalar(writer, 3, 7, 0.0, 0, false, 1);
    key(writer, 589, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 595, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 628, true); scalar(writer, 9, 0, 0.0, 222, false, 1);
    key(writer, 647, true); position(writer, 0, 1);
    key(writer, 649, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    if (stage >= 3) {
        key(writer, 730, true); scalar(writer, 5, 0, 1.2, 0, false, 1);
    }
    key(writer, 731, true); scalar(writer, 9, 0, 0.0, 699, false, 1);
    key(writer, 819, true); position(writer, 0, 1);
    key(writer, 823, true); scalar(writer, 3, 5, 0.0, 0, false, 1);
    key(writer, 831, true); playerStats(writer, 1);
    key(writer, 866, true); scalar(writer, 9, 0, 0.0, 946, false, 1);
    key(writer, 949, true); weapon(writer, 5, 2, 2.0, 1);
}

loot(writer: Writer, kind: int, marker: int): void {
    if (marker != 1 || kind < 1 || kind > 3) {
        throw "lifecycle loot kind is invalid";
    }
    collection(writer, 11, kind == 3 ? <uint>2 : <uint>1, 1);
    key(writer, 174, true); scalar(writer, 3, kind == 1 ? 5 : (kind == 2 ? 28 : 8), 0.0, 0, false, 1);
    if (kind == 3) {
        key(writer, 451, true);
        collection(writer, 10, <uint>1, 1);
        collection(writer, 11, <uint>2, 1);
        key(writer, 181, true); scalar(writer, 3, 1, 0.0, 0, false, 1);
        key(writer, 450, true); scalar(writer, 9, 0, 0.0, 958, false, 1);
    }
}

deadMob(writer: Writer, kind: int, stage: int, marker: int): void {
    if (marker != 1 || kind < 1 || kind > 3) {
        throw "lifecycle dead mob kind is invalid";
    }
    var bog = kind == 2;
    var dungeon = kind == 3;
    var id = kind == 1 ? 409 : (bog ? 413 : 416);
    var posKind = kind == 1 ? 1 : (bog ? 5 : 7);
    var level = kind == 1 ? 5 : (bog ? 10 : 5);
    var maximum = bog ? 197 : 96;
    var moveSpeed = kind == 1 ? 8.0 : (bog ? 6.0 : 8.0);
    var armor = kind == 1 ? 40 : (bog ? 81 : 40);
    var template = bog ? 95 : 365;
    var changedBog = bog && stage >= 3;
    collection(writer, 11, dungeon ? <uint>31 : <uint>32, 1);
    key(writer, 30, true); scalar(writer, 9, 0, 0.0, 202, false, 1);
    key(writer, 163, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 179, true);
    scalar(writer, 5, 0, dungeon ? -0.05 : (changedBog ? 58.45 : 60.0), 0, false, 1);
    key(writer, 189, true); scalar(writer, 5, 0, 0.05, 0, false, 1);
    key(writer, 202, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 248, true);
    if (bog && !changedBog) { scalar(writer, 5, 0, 1.5, 0, false, 1); }
    else { scalar(writer, 6, 0, 0.0, 0, false, 1); }
    key(writer, 264, true); scalar(writer, 5, 0, 0.05, 0, false, 1);
    key(writer, 326, true); scalar(writer, 5, 0, dungeon ? 56.399945 : 1.5, 0, false, 1);
    key(writer, 355, true); scalar(writer, 3, 99, 0.0, 0, false, 1);
    key(writer, 423, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 436, true); scalar(writer, 3, id, 0.0, 0, false, 1);
    key(writer, 443, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 462, true); scalar(writer, 9, 0, 0.0, 531, false, 1);
    key(writer, 467, true); position(writer, posKind, 1);
    key(writer, 470, true); scalar(writer, 3, level, 0.0, 0, false, 1);
    key(writer, 483, true); loot(writer, kind, 1);
    key(writer, 487, true);
    scalar(writer, 5, 0, dungeon ? 59.95 : (changedBog ? 58.45 : 60.0), 0, false, 1);
    key(writer, 488, true);
    collection(writer, 10, <uint>1, 1);
    scalar(writer, 3, 408, 0.0, 0, false, 1);
    if (!dungeon) {
        key(writer, 484, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    }
    key(writer, 520, true); scalar(writer, 3, maximum, 0.0, 0, false, 1);
    key(writer, 548, true); scalar(writer, 5, 0, moveSpeed, 0, false, 1);
    key(writer, 589, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 595, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 628, true); scalar(writer, 9, 0, 0.0, 222, false, 1);
    key(writer, 647, true); position(writer, posKind, 1);
    key(writer, 649, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 733, true);
    scalar(writer, 5, 0, dungeon ? -0.05 : (changedBog ? 23.45 : 25.0), 0, false, 1);
    key(writer, 819, true); position(writer, posKind, 1);
    key(writer, 831, true); armorStats(writer, armor, 1);
    key(writer, 856, true); scalar(writer, 3, 408, 0.0, 0, false, 1);
    key(writer, 866, true); scalar(writer, 9, 0, 0.0, template, false, 1);
    key(writer, 949, true);
    if (bog) { weapon(writer, 31, 20, 2.6, 1); }
    else { weapon(writer, 12, 8, 2.0, 1); }
}

