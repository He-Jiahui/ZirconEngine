respawnedWolf(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "lifecycle respawned wolf marker is invalid";
    }
    collection(writer, 11, <uint>27, 1);
    key(writer, 30, true); scalar(writer, 9, 0, 0.0, 437, false, 1);
