var container = %import("zr.container");
var roster = %import("kernel/roster");
var symbols = %import("generated/trace_symbols");

class Writer {
    pri var bytes: container.Array<uint>;

    pub @constructor() {
        this.bytes = new container.Array<uint>();
    }

    pub byte(value: uint, width: int): void {
        if (width != 1 || value > <uint>255) {
            throw "roster trace byte is invalid";
        }
        var target = this.bytes;
        target.add(value);
    }

    pub u16(value: uint, lowBytes: int, highBytes: int): void {
        if (lowBytes != 1 || highBytes != 1) {
            throw "roster trace u16 layout is invalid";
        }
        this.byte(value & <uint>255, 1);
        this.byte((value >> 8) & <uint>255, 1);
    }

    pub u32(value: uint, a: int, b: int, c: int): void {
        if (a != 1 || b != 1 || c != 2) {
            throw "roster trace u32 layout is invalid";
        }
        this.u16(value & <uint>65535, 1, 1);
        this.u16((value >> 16) & <uint>65535, 1, 1);
    }

    pub u64(value: uint, a: int, b: int, c: int, d: int): void {
        if (a != 1 || b != 1 || c != 2 || d != 4) {
            throw "roster trace u64 layout is invalid";
        }
        this.u32(value & <uint>4294967295, 1, 1, 2);
        this.u32(value >> 32, 1, 1, 2);
    }

    pub finish(): container.Array<uint> {
        var copy = new container.Array<uint>();
        var source = this.bytes;
        for (var value in source) {
            copy.add(<uint>value);
        }
        return copy;
    }
}

key(writer: Writer, symbol: int, required: bool): void {
    if (!required || symbol <= 0 || symbol > 65535) {
        throw "roster trace key symbol is invalid";
    }
    writer.u16(<uint>symbol, 1, 1);
}

collection(writer: Writer, kind: int, length: uint, marker: int): void {
    if (marker != 1 || (kind != 10 && kind != 11)) {
        throw "roster trace collection is invalid";
    }
    writer.byte(<uint>kind, 1);
    writer.u32(length, 1, 1, 2);
}

scalar(
    writer: Writer,
    kind: int,
    intValue: int,
    floatValue: float,
    symbol: int,
    flag: bool,
    marker: int
): void {
    if (marker != 1) {
        throw "roster trace scalar marker is invalid";
    }
    if (kind == 0) {
        writer.byte(<uint>0, 1);
        return;
    }
    if (kind == 1) {
        writer.byte(flag ? <uint>2 : <uint>1, 1);
        return;
    }
    if (kind == 3) {
        if (intValue < 0) {
            throw "roster trace unsigned value is negative";
        }
        writer.byte(<uint>3, 1);
        writer.u64(<uint>intValue, 1, 1, 2, 4);
        return;
    }
    if (kind == 4) {
        writer.byte(<uint>4, 1);
        var negativeInt = intValue < 0;
        writer.byte(negativeInt ? <uint>1 : <uint>0, 1);
        writer.u64(negativeInt ? <uint>(-intValue) : <uint>intValue, 1, 1, 2, 4);
        return;
    }
    if (kind == 5) {
        writer.byte(<uint>5, 1);
        var negativeFloat = floatValue < 0.0;
        writer.byte(negativeFloat ? <uint>1 : <uint>0, 1);
        var absolute = negativeFloat ? -floatValue : floatValue;
        writer.u64(<uint>(absolute * 1000000.0 + 0.5), 1, 1, 2, 4);
        return;
    }
    if (kind == 6) {
        writer.byte(<uint>6, 1);
        return;
    }
    if (kind == 9) {
        if (symbol <= 0 || symbol > 65535) {
            throw "roster trace string symbol is invalid";
        }
        writer.byte(<uint>9, 1);
        writer.u16(<uint>symbol, 1, 1);
        return;
    }
    throw "roster trace scalar kind is invalid";
}

emptyObject(writer: Writer, required: bool): void {
    if (!required) {
        throw "roster empty object must be observed";
    }
    collection(writer, 11, <uint>0, 1);
}

bags(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "roster bags marker is invalid";
    }
    collection(writer, 10, <uint>4, 1);
    scalar(writer, 0, 0, 0.0, 0, false, 1);
    scalar(writer, 0, 0, 0.0, 0, false, 1);
    scalar(writer, 0, 0, 0.0, 0, false, 1);
    scalar(writer, 0, 0, 0.0, 0, false, 1);
}

discoveredItems(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "roster discovered items marker is invalid";
    }
    collection(writer, 10, <uint>3, 1);
    scalar(writer, 9, 0, 0.0, 74, false, 1);
    scalar(writer, 9, 0, 0.0, 717, false, 1);
    scalar(writer, 9, 0, 0.0, 960, false, 1);
}

deedStats(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "roster deed stats marker is invalid";
    }
    collection(writer, 11, <uint>3, 1);
    key(writer, 182, true); emptyObject(writer, true);
    key(writer, 289, true); emptyObject(writer, true);
    key(writer, 452, true); discoveredItems(writer, 1);
}

deedsEarned(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "roster deeds marker is invalid";
    }
    collection(writer, 10, <uint>3, 1);
    collection(writer, 10, <uint>2, 1);
    scalar(writer, 9, 0, 0.0, 660, false, 1);
    scalar(writer, 9, 0, 0.0, 1, false, 1);
    collection(writer, 10, <uint>2, 1);
    scalar(writer, 9, 0, 0.0, 661, false, 1);
    scalar(writer, 9, 0, 0.0, 1, false, 1);
    collection(writer, 10, <uint>2, 1);
    scalar(writer, 9, 0, 0.0, 662, false, 1);
    scalar(writer, 9, 0, 0.0, 1, false, 1);
}

equipment(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "roster equipment marker is invalid";
    }
    collection(writer, 11, <uint>2, 1);
    key(writer, 134, true); scalar(writer, 9, 0, 0.0, 717, false, 1);
    key(writer, 503, true); scalar(writer, 9, 0, 0.0, 960, false, 1);
}

inventory(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "roster inventory marker is invalid";
    }
    collection(writer, 10, <uint>1, 1);
    collection(writer, 11, <uint>2, 1);
    key(writer, 181, true); scalar(writer, 3, 5, 0.0, 0, false, 1);
    key(writer, 450, true); scalar(writer, 9, 0, 0.0, 74, false, 1);
}

talents(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "roster talents marker is invalid";
    }
    collection(writer, 11, <uint>2, 1);
    key(writer, 135, true); emptyObject(writer, true);
    key(writer, 712, true); emptyObject(writer, true);
}

position(writer: Writer, kind: int, marker: int): void {
    if (marker != 1 || kind < 0 || kind > 2) {
        throw "roster position kind is invalid";
    }
    collection(writer, 11, <uint>3, 1);
    if (kind == 0) {
        key(writer, 961, true); scalar(writer, 5, 0, 2.0, 0, false, 1);
        key(writer, 964, true); scalar(writer, 5, 0, 1.5, 0, false, 1);
        key(writer, 965, true); scalar(writer, 5, 0, -2.0, 0, false, 1);
        return;
    }
    var xMicros = -14000000;
    var yMicros = 1511848;
    var zMicros = -14000000;
    key(writer, 961, true);
    scalar(writer, 5, 0, <float>xMicros / 1000000.0, 0, false, 1);
    key(writer, 964, true);
    scalar(writer, 5, 0, kind == 1 ? 1.5 : <float>yMicros / 1000000.0, 0, false, 1);
    key(writer, 965, true);
    scalar(writer, 5, 0, <float>zMicros / 1000000.0, 0, false, 1);
}

stats(writer: Writer, stage: int, marker: int): void {
    if (marker != 1 || stage < 0 || stage > 7) {
        throw "roster stats stage is invalid";
    }
    var initial = stage == 0;
    var sick = stage >= 5;
    collection(writer, 11, <uint>6, 1);
    key(writer, 29, true); scalar(writer, 3, initial ? 20 : (sick ? 7 : 29), 0.0, 0, false, 1);
    key(writer, 56, true); scalar(writer, 3, initial ? 110 : (sick ? 192 : 236), 0.0, 0, false, 1);
    key(writer, 445, true); scalar(writer, 3, sick ? 3 : 10, 0.0, 0, false, 1);
    key(writer, 824, true); scalar(writer, 3, sick ? 3 : 11, 0.0, 0, false, 1);
    key(writer, 828, true); scalar(writer, 3, initial ? 22 : (sick ? 10 : 40), 0.0, 0, false, 1);
    key(writer, 837, true); scalar(writer, 3, initial ? 23 : (sick ? 10 : 41), 0.0, 0, false, 1);
}

weapon(writer: Writer, marker: int): void {
    if (marker != 1) {
        throw "roster weapon marker is invalid";
    }
    collection(writer, 11, <uint>3, 1);
    key(writer, 518, true); scalar(writer, 3, 5, 0.0, 0, false, 1);
    key(writer, 529, true); scalar(writer, 3, 2, 0.0, 0, false, 1);
    key(writer, 821, true); scalar(writer, 5, 0, 2.0, 0, false, 1);
}

sicknessAura(writer: Writer, stage: int, marker: int): void {
    if (marker != 1 || stage < 5 || stage > 7) {
        throw "roster sickness aura stage is invalid";
    }
    var remainingMicros = stage == 5 ? 60000000 :
        (stage == 6 ? 59950000 : 59900000);
    collection(writer, 10, <uint>1, 1);
    collection(writer, 11, <uint>8, 1);
    key(writer, 292, true); scalar(writer, 3, 60, 0.0, 0, false, 1);
    key(writer, 436, true); scalar(writer, 9, 0, 0.0, 742, false, 1);
    key(writer, 462, true); scalar(writer, 9, 0, 0.0, 104, false, 1);
    key(writer, 559, true); scalar(writer, 9, 0, 0.0, 741, false, 1);
    key(writer, 725, true);
    scalar(writer, 5, 0, <float>remainingMicros / 1000000.0, 0, false, 1);
    key(writer, 772, true); scalar(writer, 9, 0, 0.0, 785, false, 1);
    key(writer, 818, true); scalar(writer, 3, 408, 0.0, 0, false, 1);
    key(writer, 920, true); scalar(writer, 5, 0, -0.75, 0, false, 1);
}

playerMeta(writer: Writer, progressed: bool, id: int, a: int, b: int, c: int): void {
    if (a != 1 || b != 2 || c != 3) {
        throw "roster player metadata marker is invalid";
    }
    collection(writer, 11, progressed ? <uint>28 : <uint>25, 1);
    key(writer, 17, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 45, true); emptyObject(writer, true);
    key(writer, 51, true); scalar(writer, 3, 1500, 0.0, 0, false, 1);
    key(writer, 54, true); scalar(writer, 3, 1500, 0.0, 0, false, 1);
    key(writer, 71, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 73, true); bags(writer, 1);
    key(writer, 76, true); emptyObject(writer, true);
    key(writer, 148, true); scalar(writer, 9, 0, 0.0, 946, false, 1);
    key(writer, 166, true); emptyObject(writer, true);
    key(writer, 182, true); emptyObject(writer, true);
    key(writer, 186, true); emptyObject(writer, true);
    key(writer, 187, true); emptyObject(writer, true);
    key(writer, 221, true); deedStats(writer, 1);
    if (progressed) {
        key(writer, 220, true); deedsEarned(writer, 1);
    }
    key(writer, 234, true); emptyObject(writer, true);
    key(writer, 235, true); emptyObject(writer, true);
    key(writer, 311, true); scalar(writer, 3, id, 0.0, 0, false, 1);
    key(writer, 315, true); equipment(writer, 1);
    key(writer, 316, true); emptyObject(writer, true);
    key(writer, 378, true); emptyObject(writer, true);
    key(writer, 408, true); emptyObject(writer, true);
    key(writer, 447, true); inventory(writer, 1);
    if (progressed) {
        key(writer, 473, true); scalar(writer, 3, 27600, 0.0, 0, false, 1);
    }
    key(writer, 502, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 567, true); emptyObject(writer, true);
    if (progressed) {
        key(writer, 728, true); scalar(writer, 3, 20, 0.0, 0, false, 1);
    }
    key(writer, 854, true); talents(writer, 1);
    key(writer, 882, true); emptyObject(writer, true);
}

playerEntity(writer: Writer, stage: int, id: int, a: int, b: int, c: int, d: int): void {
    if (a != 1 || b != 2 || c != 3 || d != 4 || stage < 0 || stage > 7) {
        throw "roster player entity stage is invalid";
    }
    var initial = stage == 0;
    var ghost = stage == 4;
    var sick = stage >= 5;
    var graveYMicros = 1511848;
    var fieldCount = ghost ? 31 : (sick ? 29 : 28);
    collection(writer, 11, <uint>fieldCount, 1);
    key(writer, 30, true); scalar(writer, 9, 0, 0.0, 437, false, 1);
    key(writer, 66, true); scalar(writer, 3, initial ? 46 : (sick ? 20 : 82), 0.0, 0, false, 1);
    if (sick) {
        key(writer, 69, true); sicknessAura(writer, stage, 1);
    }
    key(writer, 160, true);
    if (stage == 1) {
        scalar(writer, 5, 0, 99.1, 0, false, 1);
    } else if (stage == 2) {
        scalar(writer, 5, 0, 99.2, 0, false, 1);
    } else if (stage == 3) {
        scalar(writer, 5, 0, 99.25, 0, false, 1);
    } else if (stage == 6) {
        scalar(writer, 5, 0, 99.05, 0, false, 1);
    } else if (stage == 7) {
        scalar(writer, 5, 0, 99.1, 0, false, 1);
    } else {
        scalar(writer, 3, 99, 0.0, 0, false, 1);
    }
    key(writer, 163, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    if (ghost) {
        key(writer, 178, true); position(writer, 0, 1);
    }
    key(writer, 189, true);
    scalar(writer, 5, 0, initial ? 0.06 : (sick ? 0.0535 : 0.0645), 0, false, 1);
    if (ghost) {
        key(writer, 202, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    }
    key(writer, 248, true); scalar(writer, 6, 0, 0.0, 0, false, 1);
    key(writer, 264, true);
    scalar(writer, 5, 0, initial ? 0.06 : (sick ? 0.0535 : 0.0645), 0, false, 1);
    key(writer, 326, true);
    scalar(writer, 5, 0, stage >= 6 ?
        <float>graveYMicros / 1000000.0 : 1.5, 0, false, 1);
    key(writer, 355, true);
    if (stage == 1) {
        scalar(writer, 5, 0, 99.1, 0, false, 1);
    } else if (stage == 2) {
        scalar(writer, 5, 0, 99.2, 0, false, 1);
    } else if (stage == 3 || stage == 4 || stage == 5) {
        scalar(writer, 5, 0, 99.25, 0, false, 1);
    } else if (stage == 6) {
        scalar(writer, 5, 0, 99.3, 0, false, 1);
    } else if (stage == 7) {
        scalar(writer, 5, 0, 99.35, 0, false, 1);
    } else {
        scalar(writer, 3, 99, 0.0, 0, false, 1);
    }
    if (ghost) {
        key(writer, 380, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    }
    key(writer, 427, true);
    scalar(writer, 3, initial ? 90 : (ghost ? 432 : (sick ? 44 : 50000)), 0.0, 0, false, 1);
    key(writer, 436, true); scalar(writer, 3, id, 0.0, 0, false, 1);
    key(writer, 462, true); scalar(writer, 9, 0, 0.0, 639, false, 1);
    key(writer, 470, true); scalar(writer, 3, initial ? 1 : 10, 0.0, 0, false, 1);
    key(writer, 487, true); scalar(writer, 6, 0, 0.0, 0, false, 1);
    key(writer, 520, true);
    scalar(writer, 3, initial ? 90 : (ghost ? 432 : (sick ? 222 : 50000)), 0.0, 0, false, 1);
    key(writer, 521, true); scalar(writer, 3, 100, 0.0, 0, false, 1);
    key(writer, 548, true); scalar(writer, 3, 7, 0.0, 0, false, 1);
    key(writer, 589, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 595, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 628, true); scalar(writer, 9, 0, 0.0, 222, false, 1);
    key(writer, 647, true); position(writer, stage >= 4 ? 2 : 0, 1);
    key(writer, 649, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 731, true); scalar(writer, 9, 0, 0.0, 699, false, 1);
    key(writer, 819, true); position(writer, 0, 1);
    key(writer, 823, true); scalar(writer, 3, sick ? 2 : 5, 0.0, 0, false, 1);
    key(writer, 831, true); stats(writer, stage, 1);
    key(writer, 866, true); scalar(writer, 9, 0, 0.0, 946, false, 1);
    key(writer, 949, true); weapon(writer, 1);
}

frame(
    writer: Writer,
    stage: int,
    tick: int,
    time: float,
    label: int,
    full: bool,
    nextId: int,
    playerId: int,
    a: int,
    b: int,
    c: int
): void {
    if (a != 1 || b != 2 || c != 3 || stage < 0 || stage > 7) {
        throw "roster trace frame marker is invalid";
    }
    writer.u64(<uint>tick, 1, 1, 2, 4);
    if (time == 0.0) {
        scalar(writer, 3, 0, 0.0, 0, false, 1);
    } else {
        scalar(writer, 5, 0, time, 0, false, 1);
    }
    writer.u64(<uint>nextId, 1, 1, 2, 4);
    writer.u16(<uint>label, 1, 1);
    writer.byte(full ? <uint>1 : <uint>0, 1);
    var rngDraws: uint = <uint>0;
    var rngDigest: uint = <uint>2166136261;
    if (stage != 0) {
        rngDraws = <uint>4;
        rngDigest = <uint>2074694461;
    }
    writer.u32(rngDraws, 1, 1, 2);
    writer.u32(rngDigest, 1, 1, 2);
    collection(writer, 10, <uint>1, 1);
    playerMeta(writer, stage > 0, playerId, 1, 2, 3);
    collection(writer, 10, <uint>1, 1);
    playerEntity(writer, stage, playerId, 1, 2, 3, 4);
    var eventDigest: uint = <uint>1947613349;
    if (stage == 1) {
        eventDigest = <uint>1737237640;
    } else if (stage == 5) {
        eventDigest = <uint>2927245462;
    }
    writer.u32(eventDigest, 1, 1, 2);
}

buildTrace(marker: int): container.Array<uint> {
    if (marker != 1) {
        throw "roster trace build marker is invalid";
    }
    if (roster.scenarioContractTest() != 1) {
        throw "roster trace authority contract failed";
    }
    var writer = new Writer();
    writer.byte(<uint>87, 1);
    writer.byte(<uint>84, 1);
    writer.byte(<uint>82, 1);
    writer.byte(<uint>49, 1);
    writer.u16(<uint>1, 1, 1);
    writer.u64(symbols.fingerprint(), 1, 1, 2, 4);
    writer.u16(<uint>310, 1, 1);
    var seed = 1012;
    var sampleEvery = 2;
    var ticks = 7;
    var draws = 4;
    var drawDigest = 2074694461;
    var frameCount = 8;
    writer.u32(<uint>seed, 1, 1, 2);
    writer.u32(<uint>sampleEvery, 1, 1, 2);
    writer.u32(<uint>ticks, 1, 1, 2);
    writer.u16(<uint>4, 1, 1);
    writer.u16(<uint>18, 1, 1);
    writer.u16(<uint>245, 1, 1);
    writer.u16(<uint>299, 1, 1);
    writer.u16(<uint>721, 1, 1);
    writer.u32(<uint>draws, 1, 1, 2);
    writer.u32(<uint>drawDigest, 1, 1, 2);
    writer.u16(<uint>frameCount, 1, 1);

    var playerId = 408;
    frame(writer, 0, 0, 0.0, 444, true, 409, playerId, 1, 2, 3);
    frame(writer, 1, 2, 0.1, 0, false, 411, playerId, 1, 2, 3);
    frame(writer, 2, 4, 0.2, 0, false, 411, playerId, 1, 2, 3);
    frame(writer, 3, 5, 0.25, 648, true, 411, playerId, 1, 2, 3);
    frame(writer, 4, 5, 0.25, 381, true, 411, playerId, 1, 2, 3);
    frame(writer, 5, 5, 0.25, 400, true, 411, playerId, 1, 2, 3);
    frame(writer, 6, 6, 0.3, 0, false, 411, playerId, 1, 2, 3);
    frame(writer, 7, 7, 0.35, 342, true, 411, playerId, 1, 2, 3);
    return writer.finish();
}

byteDigest(bytes: container.Array<uint>, marker: int, required: bool): uint {
    if (marker != 1 || !required) {
        throw "roster trace digest contract is invalid";
    }
    var hash: uint = <uint>2166136261;
    for (var byte in bytes) {
        hash = ((hash ^ <uint>byte) * <uint>16777619) & <uint>4294967295;
    }
    return hash;
}

hexDigit(value: int, marker: int): string {
    if (marker != 1 || value < 0 || value > 15) {
        throw "roster trace hex digit is invalid";
    }
    if (value == 0) { return "0"; }
    if (value == 1) { return "1"; }
    if (value == 2) { return "2"; }
    if (value == 3) { return "3"; }
    if (value == 4) { return "4"; }
    if (value == 5) { return "5"; }
    if (value == 6) { return "6"; }
    if (value == 7) { return "7"; }
    if (value == 8) { return "8"; }
    if (value == 9) { return "9"; }
    if (value == 10) { return "a"; }
    if (value == 11) { return "b"; }
    if (value == 12) { return "c"; }
    if (value == 13) { return "d"; }
    if (value == 14) { return "e"; }
    return "f";
}

// Validation-only scalar bridge while exported Array<uint> signatures are broken.
// Runtime trace transport remains the lossless byte contract owned by Plugins 08.
pub traceHexForValidation(required: bool): string {
    if (!required) {
        throw "roster trace validation hex must be observed";
    }
    var bytes = buildTrace(1);
    var result = "";
    for (var byte in bytes) {
        var value = <uint>byte;
        result = result + hexDigit(<int>(value >> 4), 1) +
            hexDigit(<int>(value & <uint>15), 1);
    }
    return result;
}

pub byteMetric(kind: int, required: bool): uint {
    if (!required || kind < 0 || kind > 1) {
        throw "roster trace byte metric is invalid";
    }
    var bytes = buildTrace(1);
    if (kind == 0) {
        return <uint>bytes.length;
    }
    return byteDigest(bytes, 1, true);
}

pub selfTest(): int {
    var first = buildTrace(1);
    var second = buildTrace(1);
    if (first.length != 6680 || first.length != second.length) {
        return -2;
    }
    if (byteDigest(first, 1, true) != <uint>3966473180 ||
        byteDigest(first, 1, true) != byteDigest(second, 1, true)) {
        return -3;
    }
    return 1;
}
