    collection(writer, 11, <uint>1, 1);
    key(writer, 199, true); scalar(writer, 3, damageTaken, 0.0, 0, false, 1);
    key(writer, 186, true); emptyObject(writer, true);
    key(writer, 187, true); emptyObject(writer, true);
    key(writer, 221, true); deedStats(writer, 1);
    key(writer, 234, true); emptyObject(writer, true);
    key(writer, 235, true); emptyObject(writer, true);
    key(writer, 311, true); scalar(writer, 3, 408, 0.0, 0, false, 1);
    key(writer, 315, true); equipment(writer, 1);
    key(writer, 316, true); emptyObject(writer, true);
    key(writer, 378, true); emptyObject(writer, true);
    key(writer, 408, true); emptyObject(writer, true);
    key(writer, 447, true); inventory(writer, 1);
    key(writer, 502, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 567, true); emptyObject(writer, true);
    key(writer, 854, true); talents(writer, 1);
    key(writer, 882, true); emptyObject(writer, true);
}

playerEntity(writer: Writer, stage: int, marker: int): void {
    if (marker != 1 || stage < 1 || stage > 8) {
        throw "locomotion player entity stage is invalid";
    }
    var hp = stage == 1 ? 999944 : (stage == 2 ? 999862 : (stage >= 6 ? 1000000 : 999885));
    var resource = stage == 1 ? 6.222222 : (stage == 2 ? 10.822222 : 17.211111);
    collection(writer, 11, stage == 1 ? <uint>29 : <uint>30, 1);
    key(writer, 30, true); scalar(writer, 9, 0, 0.0, 437, false, 1);
    key(writer, 66, true); scalar(writer, 3, 46, 0.0, 0, false, 1);
    if (stage >= 2) {
        key(writer, 69, true); playerAuras(writer, stage, 1);
    }
    key(writer, 163, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 189, true); scalar(writer, 5, 0, 0.06, 0, false, 1);
    key(writer, 248, true); scalar(writer, 6, 0, 0.0, 0, false, 1);
    key(writer, 264, true); scalar(writer, 5, 0, 0.06, 0, false, 1);
    key(writer, 326, true); scalar(writer, 5, 0, 1.5, 0, false, 1);
    key(writer, 355, true); scalar(writer, 3, 99, 0.0, 0, false, 1);
    key(writer, 427, true); scalar(writer, 3, hp, 0.0, 0, false, 1);
    key(writer, 436, true); scalar(writer, 3, 408, 0.0, 0, false, 1);
    key(writer, 443, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 462, true); scalar(writer, 9, 0, 0.0, 639, false, 1);
    key(writer, 470, true); scalar(writer, 3, 1, 0.0, 0, false, 1);
    key(writer, 487, true); scalar(writer, 6, 0, 0.0, 0, false, 1);
    key(writer, 520, true); scalar(writer, 3, 90, 0.0, 0, false, 1);
    key(writer, 521, true); scalar(writer, 3, 100, 0.0, 0, false, 1);
    key(writer, 548, true); scalar(writer, 3, 7, 0.0, 0, false, 1);
    key(writer, 589, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 595, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 628, true); scalar(writer, 9, 0, 0.0, 222, false, 1);
    key(writer, 647, true); position(writer, 0, 1);
    key(writer, 649, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 730, true); scalar(writer, 5, 0, resource, 0, false, 1);
    key(writer, 731, true); scalar(writer, 9, 0, 0.0, 699, false, 1);
    key(writer, 819, true); position(writer, 0, 1);
    key(writer, 823, true); scalar(writer, 3, 5, 0.0, 0, false, 1);
    key(writer, 831, true); playerStats(writer, 1);
    key(writer, 866, true); scalar(writer, 9, 0, 0.0, 946, false, 1);
    key(writer, 949, true); weapon(writer, 5, 2, 2.0, 1);
}

bossMob(writer: Writer, kind: int, marker: int): void {
    if (marker != 1 || kind < 1 || kind > 3) {
        throw "locomotion boss mob kind is invalid";
    }
    var id = kind == 1 ? 409 : (kind == 2 ? 410 : 411);
    var hp = kind == 1 ? 1357 : (kind == 2 ? 2171 : 2277);
    var level = kind == 1 ? 6 : (kind == 2 ? 20 : 12);
    var moveSpeed = kind == 1 ? 7.4 : 7.0;
    var armor = kind == 1 ? 170 : (kind == 2 ? 570 : 330);
    var template = kind == 1 ? 542 : (kind == 2 ? 463 : 796);
    collection(writer, 11, kind == 2 ? <uint>28 : <uint>29, 1);
    key(writer, 28, true); scalar(writer, 3, 408, 0.0, 0, false, 1);
    key(writer, 30, true); scalar(writer, 9, 0, 0.0, 62, false, 1);
    key(writer, 163, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 189, true); scalar(writer, 5, 0, 0.05, 0, false, 1);
    key(writer, 248, true); scalar(writer, 6, 0, 0.0, 0, false, 1);
    key(writer, 264, true); scalar(writer, 5, 0, 0.05, 0, false, 1);
    key(writer, 326, true); scalar(writer, 5, 0, 1.5, 0, false, 1);
    key(writer, 355, true); scalar(writer, 3, 99, 0.0, 0, false, 1);
    key(writer, 423, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 427, true); scalar(writer, 3, hp, 0.0, 0, false, 1);
    key(writer, 436, true); scalar(writer, 3, id, 0.0, 0, false, 1);
    key(writer, 443, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 462, true); scalar(writer, 9, 0, 0.0, 531, false, 1);
    key(writer, 470, true); scalar(writer, 3, level, 0.0, 0, false, 1);
    key(writer, 487, true); scalar(writer, 6, 0, 0.0, 0, false, 1);
    key(writer, 520, true); scalar(writer, 3, hp, 0.0, 0, false, 1);
    key(writer, 548, true); scalar(writer, 5, 0, moveSpeed, 0, false, 1);
    key(writer, 589, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 595, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 628, true); scalar(writer, 9, 0, 0.0, 222, false, 1);
    key(writer, 647, true); position(writer, 0, 1);
    key(writer, 649, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    if (kind != 2) {
        key(writer, 668, true); scalar(writer, 3, kind == 1 ? 10 : 9, 0.0, 0, false, 1);
    }
    key(writer, 819, true); position(writer, 0, 1);
    key(writer, 831, true); armorStats(writer, armor, 1);
    if (kind == 2) {
        key(writer, 834, true); scalar(writer, 3, 12, 0.0, 0, false, 1);
    }
    key(writer, 847, true);
    scalar(writer, 5, 0, kind == 1 ? 2.2 : (kind == 2 ? 2.8 : 2.0), 0, false, 1);
    key(writer, 866, true); scalar(writer, 9, 0, 0.0, template, false, 1);
    if (kind == 3) {
        key(writer, 868, true); scalar(writer, 3, 16, 0.0, 0, false, 1);
    }
    if (kind == 1) {
        key(writer, 937, true); scalar(writer, 5, 0, 11.95, 0, false, 1);
    }
    key(writer, 949, true);
    if (kind == 1) {
        weapon(writer, 55, 35, 2.2, 1);
    } else if (kind == 2) {
        weapon(writer, 130, 83, 2.8, 1);
    } else {
        weapon(writer, 108, 69, 2.0, 1);
    }
}

wolfMob(writer: Writer, kind: int, marker: int): void {
    if (marker != 1 || kind < 1 || kind > 2) {
        throw "locomotion wolf mob kind is invalid";
    }
    var wanderer = kind == 1;
