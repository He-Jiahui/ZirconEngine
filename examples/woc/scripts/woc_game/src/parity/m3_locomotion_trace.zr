    key(writer, 589, true); scalar(writer, 1, 0, 0.0, 0, true, 1);
    key(writer, 595, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 628, true); scalar(writer, 9, 0, 0.0, 222, false, 1);
    key(writer, 647, true); position(writer, running ? 6 : 5, 1);
    key(writer, 649, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 819, true); position(writer, 5, 1);
    key(writer, 831, true); armorStats(writer, 90, 1);
    key(writer, 866, true); scalar(writer, 9, 0, 0.0, 543, false, 1);
    key(writer, 949, true); weapon(writer, 20, 13, 2.0, 1);
}

frameMetrics(stage: int, kind: int, marker: int): uint {
    if (marker != 1 || stage < 0 || stage > 8 || kind < 0 || kind > 1) {
        throw "locomotion frame metrics contract is invalid";
    }
    if (stage == 0) {
        return kind == 0 ? <uint>0 : <uint>2166136261;
    }
    if (stage == 1) {
        return kind == 0 ? <uint>4 : <uint>1710233402;
    }
    if (stage == 2) {
        return kind == 0 ? <uint>8 : <uint>676036881;
    }
    if (stage == 3) {
        return kind == 0 ? <uint>13 : <uint>114211238;
    }
    if (stage == 4) {
        return kind == 0 ? <uint>15 : <uint>1524287292;
    }
    return kind == 0 ? <uint>16 : <uint>1266539381;
}

frame(writer: Writer, stage: int, label: int, nextId: int, marker: int): void {
    if (marker != 1 || stage < 0 || stage > 8) {
        throw "locomotion trace frame marker is invalid";
    }
    writer.u64(<uint>0, 1, 1, 2, 4);
    scalar(writer, 3, 0, 0.0, 0, false, 1);
    writer.u64(<uint>nextId, 1, 1, 2, 4);
    writer.u16(<uint>label, 1, 1);
    writer.byte(<uint>1, 1);
    writer.u32(frameMetrics(stage, 0, 1), 1, 1, 2);
    writer.u32(frameMetrics(stage, 1, 1), 1, 1, 2);
    if (stage == 0) {
        collection(writer, 10, <uint>0, 1);
        collection(writer, 10, <uint>0, 1);
    } else {
        collection(writer, 10, <uint>1, 1);
        playerMeta(writer, stage, 1);
        collection(writer, 10, stage >= 6 ? <uint>7 : <uint>(stage + 1), 1);
        playerEntity(writer, stage, 1);
        if (stage >= 1) { bossMob(writer, 1, 1); }
        if (stage >= 2) { bossMob(writer, 2, 1); }
        if (stage >= 3) { bossMob(writer, 3, 1); }
        if (stage >= 4) { wolfMob(writer, 1, 1); }
        if (stage >= 5) { wolfMob(writer, 2, 1); }
        if (stage >= 6) { cowardMob(writer, stage >= 7, 1); }
    }
    var eventDigest: uint = <uint>1947613349;
    if (stage == 1) {
        eventDigest = <uint>1465872183;
    } else if (stage == 2) {
        eventDigest = <uint>1404535733;
    } else if (stage == 3) {
        eventDigest = <uint>514425958;
    } else if (stage == 6) {
        eventDigest = <uint>3060149478;
    }
    writer.u32(eventDigest, 1, 1, 2);
}

buildTrace(marker: int): container.Array<uint> {
    if (marker != 1) {
        throw "locomotion trace build marker is invalid";
    }
    if (locomotion.scenarioContractTest() != 1) {
        throw "locomotion trace authority contract failed";
    }
    var writer = new Writer();
    writer.byte(<uint>87, 1);
    writer.byte(<uint>84, 1);
    writer.byte(<uint>82, 1);
    writer.byte(<uint>49, 1);
    writer.u16(<uint>1, 1, 1);
    writer.u64(symbols.fingerprint(), 1, 1, 2, 4);
    writer.u16(<uint>533, 1, 1);
    writer.u32(<uint>7777, 1, 1, 2);
    writer.u32(<uint>1, 1, 1, 2);
    writer.u32(<uint>0, 1, 1, 2);
    writer.u16(<uint>6, 1, 1);
    writer.u16(<uint>63, 1, 1);
    writer.u16(<uint>65, 1, 1);
    writer.u16(<uint>64, 1, 1);
    writer.u16(<uint>438, 1, 1);
    writer.u16(<uint>319, 1, 1);
    writer.u16(<uint>185, 1, 1);
    writer.u32(<uint>16, 1, 1, 2);
    writer.u32(<uint>1266539381, 1, 1, 2);
    writer.u16(<uint>9, 1, 1);

    frame(writer, 0, 444, 408, 1);
    frame(writer, 1, 33, 410, 1);
    frame(writer, 2, 935, 411, 1);
    frame(writer, 3, 867, 412, 1);
    frame(writer, 4, 439, 413, 1);
    frame(writer, 5, 320, 414, 1);
    frame(writer, 6, 357, 415, 1);
    frame(writer, 7, 358, 415, 1);
    frame(writer, 8, 342, 415, 1);
    return writer.finish();
}

byteDigest(bytes: container.Array<uint>, marker: int, required: bool): uint {
    if (marker != 1 || !required) {
        throw "locomotion trace digest contract is invalid";
    }
    var hash: uint = <uint>2166136261;
    for (var byte in bytes) {
        hash = ((hash ^ <uint>byte) * <uint>16777619) & <uint>4294967295;
    }
    return hash;
}

hexDigit(value: int, marker: int): string {
    if (marker != 1 || value < 0 || value > 15) {
        throw "locomotion trace hex digit is invalid";
    }
    if (value == 0) { return "0"; }
    if (value == 1) { return "1"; }
    if (value == 2) { return "2"; }
    if (value == 3) { return "3"; }
    if (value == 4) { return "4"; }
    if (value == 5) { return "5"; }
    if (value == 6) { return "6"; }
    if (value == 7) { return "7"; }
    if (value == 8) { return "8"; }
    if (value == 9) { return "9"; }
    if (value == 10) { return "a"; }
    if (value == 11) { return "b"; }
    if (value == 12) { return "c"; }
    if (value == 13) { return "d"; }
    if (value == 14) { return "e"; }
    return "f";
}

// Validation-only scalar bridge while exported Array<uint> signatures are broken.
// Runtime trace transport remains the lossless byte contract owned by Plugins 08.
pub traceHexForValidation(required: bool): string {
    if (!required) {
        throw "locomotion trace validation hex must be observed";
    }
    var bytes = buildTrace(1);
    var result = "";
    for (var byte in bytes) {
        var value = <uint>byte;
        result = result + hexDigit(<int>(value >> 4), 1) +
            hexDigit(<int>(value & <uint>15), 1);
    }
    return result;
}

pub byteMetric(kind: int, required: bool): uint {
    if (!required || kind < 0 || kind > 1) {
        throw "locomotion trace byte metric is invalid";
    }
    var bytes = buildTrace(1);
    if (kind == 0) {
        return <uint>bytes.length;
    }
    return byteDigest(bytes, 1, true);
}

pub selfTest(): int {
    var first = buildTrace(1);
    var second = buildTrace(1);
    if (first.length != 19162 || first.length != second.length) {
        return -2;
    }
    if (byteDigest(first, 1, true) != <uint>2666418349 ||
        byteDigest(first, 1, true) != byteDigest(second, 1, true)) {
        return -3;
    }
    return 1;
}
