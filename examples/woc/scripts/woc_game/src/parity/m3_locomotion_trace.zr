    key(writer, 649, true); scalar(writer, 4, -1, 0.0, 0, false, 1);
    key(writer, 819, true); position(writer, wanderer ? 2 : 4, 1);
    key(writer, 831, true); armorStats(writer, 40, 1);
    key(writer, 866, true); scalar(writer, 9, 0, 0.0, 365, false, 1);
    if (wanderer) {
        key(writer, 928, true); position(writer, 3, 1);
    }
    key(writer, 929, true);
    scalar(writer, 5, 0, wanderer ? 30.0 : 7.771505, 0, false, 1);
    key(writer, 949, true); weapon(writer, 12, 8, 2.0, 1);
}

