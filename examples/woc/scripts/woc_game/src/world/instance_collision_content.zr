dungeonRouteIndexIsValid(index: int): bool {
    return index >= 0 && index < 6;
}

pub dungeonRouteCount(required: bool): int {
    if (!required) {
        throw "woc dungeon route count is required";
    }
    return 6;
}

pub dungeonIndexAtRoute(routeIndex: int, required: bool): int {
    if (!required || !dungeonRouteIndexIsValid(routeIndex)) {
        throw "woc dungeon route index is invalid";
    }
    if (routeIndex == 0) {
        return 0;
    }
    if (routeIndex == 1) {
        return 1;
    }
    if (routeIndex == 2) {
        return 2;
    }
    if (routeIndex == 3) {
        return 3;
    }
    if (routeIndex == 4) {
        return 4;
    }
    return 5;
}

pub dungeonLayoutIndexAtRoute(routeIndex: int, required: bool): int {
    if (!required || !dungeonRouteIndexIsValid(routeIndex)) {
        throw "woc dungeon route layout is invalid";
    }
    if (routeIndex == 0) {
        return 0;
    }
    if (routeIndex == 1) {
        return 0;
    }
    if (routeIndex == 2) {
        return 1;
    }
    if (routeIndex == 3) {
        return 2;
    }
    if (routeIndex == 4) {
        return 0;
    }
    return 3;
}

