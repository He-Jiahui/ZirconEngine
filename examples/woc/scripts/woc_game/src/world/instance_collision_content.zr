pub contractTest(): int {
    if (layoutCount(true) != 6 || layoutColliderCount(0, true) != 28 ||
        layoutColliderCount(5, true) != 48) {
        return -1;
    }
    if (colliderKind(0, 0, true) != 2 || colliderFloat(0, 1, 1, true) != 23.0 ||
        colliderKind(5, 0, true) != 2 || colliderFloat(5, 0, 2, true) != -44.375) {
        return -2;
    }
    if (dungeonRouteCount(true) != 6 || dungeonIndexAtRoute(0, true) != 0 ||
        dungeonIndexAtRoute(5, true) != 5 || dungeonLayoutIndexAtRoute(2, true) != 1 ||
        dungeonXThreshold(true) != 600.0 || dungeonSlotCount(true) != 24 ||
        dungeonOriginBaseX(true) != 900.0 || dungeonOriginIndexSpacing(true) != 600.0 ||
        dungeonOriginZ0(true) != -1250.0 || dungeonSlotSpacing(true) != 500.0 ||
        arenaX(true) != 4200.0 || arenaSlotCount(true) != 4 || delveBandXMin(true) != 4773.0 ||
        yumiBandXMin(true) != 8000.0 || yumiBandXMax(true) != 12000.0 || yumiMazeX(true) != 8400.0 ||
        yumiMazeSlotCount(true) != 4 || yumiMazeOriginZ0(true) != -1250.0 || yumiMazeSlotSpacing(true) != 200.0 || yumiMazeSeed(true) != 212332557) {
        return -3;
    }
    return 1;
}
