// 4=half-width, 5=half-depth, 6=rotation.

layoutIndexIsValid(index: int): bool {
    return index >= 0 && index < 6;
}

pub layoutCount(required: bool): int {
    if (!required) {
        throw "woc instance layout count is required";
    }
    return 6;
}

pub layoutColliderCount(layoutIndex: int, required: bool): int {
    if (!required || !layoutIndexIsValid(layoutIndex)) {
        throw "woc instance collider count is invalid";
    }
    if (layoutIndex == 0) {
        return 28;
    }
    if (layoutIndex == 1) {
        return 24;
    }
    if (layoutIndex == 2) {
        return 24;
    }
    if (layoutIndex == 3) {
        return 30;
    }
    if (layoutIndex == 4) {
        return 16;
    }
    return 48;
}

