var console = %import("zr.system.console");
var geometry = %import("world/geometry2d");
var container = %import("zr.container");

closeEnough(value: float, expected: float): bool {
    var difference = value - expected;
    if (difference < 0.0) { difference = -difference; }
    return difference <= 0.000001;
}

// 使用正反绕序、凹形与自交图形分别验证作者几何约束；
// 普通包含判定、星形可见性与自交排除是不同合同，不能互作替代。
var square = new container.Array<geometry.Point2D>();
square.add(new geometry.Point2D(0.0, 0.0));
square.add(new geometry.Point2D(10.0, 0.0));
square.add(new geometry.Point2D(10.0, 10.0));
square.add(new geometry.Point2D(0.0, 10.0));
var squareClockwise = new container.Array<geometry.Point2D>();
squareClockwise.add(new geometry.Point2D(0.0, 10.0));
squareClockwise.add(new geometry.Point2D(10.0, 10.0));
squareClockwise.add(new geometry.Point2D(10.0, 0.0));
squareClockwise.add(new geometry.Point2D(0.0, 0.0));
var triangle = new container.Array<geometry.Point2D>();
triangle.add(new geometry.Point2D(0.0, 0.0));
triangle.add(new geometry.Point2D(10.0, 0.0));
triangle.add(new geometry.Point2D(5.0, 10.0));
var lShape = new container.Array<geometry.Point2D>();
lShape.add(new geometry.Point2D(0.0, 0.0));
lShape.add(new geometry.Point2D(10.0, 0.0));
lShape.add(new geometry.Point2D(10.0, 4.0));
lShape.add(new geometry.Point2D(4.0, 4.0));
lShape.add(new geometry.Point2D(4.0, 10.0));
lShape.add(new geometry.Point2D(0.0, 10.0));
var bowtie = new container.Array<geometry.Point2D>();
bowtie.add(new geometry.Point2D(0.0, 0.0));
bowtie.add(new geometry.Point2D(10.0, 10.0));
bowtie.add(new geometry.Point2D(10.0, 0.0));
bowtie.add(new geometry.Point2D(0.0, 10.0));

var result = 1;
if (!closeEnough(geometry.polygonSignedArea(square), 100.0) ||
    !closeEnough(geometry.polygonSignedArea(squareClockwise), -100.0) ||
    geometry.polygonSignedArea(triangle) <= 0.0) {
    result = -1;
}
if (result == 1 && (!geometry.polygonContainsPoint(square, 5.0, 5.0) ||
    geometry.polygonContainsPoint(square, 20.0, 20.0) ||
    !geometry.polygonContainsPoint(squareClockwise, 5.0, 5.0) ||
    !geometry.polygonContainsPoint(lShape, 2.0, 8.0) ||
    geometry.polygonContainsPoint(lShape, 8.0, 8.0))) {
    result = -2;
}
if (result == 1 && (!geometry.polygonIsStarShaped(square, 5.0, 5.0) ||
    geometry.polygonIsStarShaped(square, 50.0, 50.0) ||
    !geometry.polygonIsStarShaped(triangle, 5.0, 3.3) ||
    !geometry.polygonIsStarShaped(lShape, 3.0, 3.0) ||
    geometry.polygonIsStarShaped(lShape, 1.0, 9.0))) {
    result = -3;
}
if (result == 1 && (geometry.polygonSelfIntersects(square) ||
    geometry.polygonSelfIntersects(triangle) ||
    geometry.polygonSelfIntersects(lShape) ||
    !geometry.polygonSelfIntersects(bowtie))) {
    result = -4;
}
// 同一切片同时查询西/东边界，保持源约定的方向符号；
// 两个结果对象独立保存存在位，避免一次查询覆盖另一侧。
var west = new geometry.PolygonXAtZResult();
var east = new geometry.PolygonXAtZResult();
geometry.polygonXAtZ(square, 5.0, -1, west);
geometry.polygonXAtZ(square, 5.0, 1, east);
if (result == 1 && (!west.hasValue || !east.hasValue ||
    !closeEnough(west.value, 0.0) || !closeEnough(east.value, 10.0))) {
    result = -5;
}
// 重用上次已有交点的结果对象再查空切片，验证存在位会重置；
// 调用方只能在存在位有效时消费坐标。
geometry.polygonXAtZ(square, -5.0, -1, west);
geometry.polygonXAtZ(square, 15.0, 1, east);
if (result == 1 && (west.hasValue || east.hasValue)) {
    result = -6;
}
geometry.polygonXAtZ(triangle, 0.0, -1, west);
geometry.polygonXAtZ(triangle, 0.0, 1, east);
if (result == 1 && (!west.hasValue || !east.hasValue ||
    !closeEnough(west.value, 0.0) || !closeEnough(east.value, 10.0))) {
    result = -7;
}
geometry.polygonXAtZ(triangle, 5.0, -1, west);
geometry.polygonXAtZ(triangle, 5.0, 1, east);
if (result == 1 && (!west.hasValue || !east.hasValue ||
    east.value - west.value >= 10.0 || east.value - west.value <= 0.0)) {
    result = -8;
}

console.printLine("m3-geometry2d-test");
console.printLine(result);
return result == 1 ? 0 : result;
