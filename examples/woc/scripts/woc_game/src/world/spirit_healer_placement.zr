// Overworld Spirit Healer construction from the Sim ctor. Instance healers and
// resurrection state remain owned by instance and spirit transaction modules.

var catalog = %import("generated/m3_spirit_healer_placement");
var terrainGround = %import("world/terrain_ground");

pub healerCount(required: bool): int {
    return catalog.graveyardCount(required);
}

pub healerId(required: bool): string {
    return catalog.healerId(required);
}

pub healerName(required: bool): string {
    return catalog.healerName(required);
}

pub healerFacing(required: bool): float {
    return catalog.healerFacing(required);
}

pub graveyardId(index: int, required: bool): string {
    return catalog.graveyardId(index, required);
}

pub finalCoordinate(index: int, axis: int, required: bool): float {
    return catalog.rawCoordinate(index, axis, required);
}

pub finalGroundY(seed: uint, index: int, required: bool): float {
    if (!required) {
        throw "woc spirit healer ground height is required";
    }
    return terrainGround.builtinGroundHeight(
        finalCoordinate(index, 1, true), finalCoordinate(index, 2, true), seed, true
    );
}

closeEnough(value: float, expected: float): bool {
    var delta = value - expected;
    if (delta < 0.0) {
        delta = -delta;
    }
    return delta < 0.00000001;
}

pub contractTest(): int {
    var seed = <uint>20061;
    if (catalog.contractTest() != 1 || healerCount(true) != 7 ||
        healerId(true) != "spirit_healer" || healerName(true) != "The Pale Keeper" ||
        !closeEnough(healerFacing(true), 3.141592653589793)) {
        return -1;
    }
    if (finalCoordinate(0, 1, true) != -14.0 || finalCoordinate(0, 2, true) != -14.0 ||
        !closeEnough(finalGroundY(seed, 0, true), 1.4348289874851001)) {
        return -2;
    }
    if (finalCoordinate(3, 1, true) != 15.0 || finalCoordinate(3, 2, true) != 645.0 ||
        !closeEnough(finalGroundY(seed, 3, true), 8.852514501376778)) {
        return -3;
    }
    if (finalCoordinate(6, 1, true) != -139.0 || finalCoordinate(6, 2, true) != 787.0 ||
        !closeEnough(finalGroundY(seed, 6, true), 5.7351127648462565)) {
        return -4;
    }
    return 1;
}
