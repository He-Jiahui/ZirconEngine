var container = %import("zr.container");

// The relationship layer supplies only candidates accepted by the upstream
// enemy/friendly predicates. This module owns deterministic ordering, not
// faction, pet, arena or Vale Cup policy.
// The WOS command reducer materializes source-approved relationship rows into
// this value-only input. Selection order remains owned by this module.
pub class CandidateSet {
    pub var enemyIds: container.Array<uint>;
    pub var enemyDx: container.Array<float>;
    pub var enemyDz: container.Array<float>;
    pub var enemyEngaged: container.Array<bool>;
    pub var friendlyIds: container.Array<uint>;
    pub var friendlyDx: container.Array<float>;
    pub var friendlyDz: container.Array<float>;

    pub @constructor() {
        this.enemyIds = new container.Array<uint>();
        this.enemyDx = new container.Array<float>();
        this.enemyDz = new container.Array<float>();
        this.enemyEngaged = new container.Array<bool>();
        this.friendlyIds = new container.Array<uint>();
        this.friendlyDx = new container.Array<float>();
        this.friendlyDz = new container.Array<float>();
    }

    pub addEnemy(id: uint, dx: float, dz: float, engaged: bool): void {
        if (id == <uint>0) {
            throw "target selection enemy id is invalid";
        }
        this.enemyIds.add(id);
        this.enemyDx.add(dx);
        this.enemyDz.add(dz);
        this.enemyEngaged.add(engaged);
    }

    pub addFriendly(id: uint, dx: float, dz: float): void {
        if (id == <uint>0) {
            throw "target selection friendly id is invalid";
        }
        this.friendlyIds.add(id);
        this.friendlyDx.add(dx);
        this.friendlyDz.add(dz);
    }
}

pub tabVisible(dx: float, dz: float, facing: float, marker: int): bool {
    if (marker != 1) {
        throw "target selection visibility marker is invalid";
    }
    var math = %import("zr.zircon.math");
    var distance = math.sqrt(dx * dx + dz * dz);
    if (distance <= 0.000001) {
        return true;
    }
    var t = distance / 30.0;
    if (t < 0.0) { t = 0.0; }
    if (t > 1.0) { t = 1.0; }
    var nearHalf = 0.7853981633974483;
    var farHalf = 1.0471975511965976;
    var halfAngle = nearHalf + (farHalf - nearHalf) * t;
    var cosine = (math.sin(facing) * dx + math.cos(facing) * dz) / distance;
    return cosine >= math.cos(halfAngle);
}

pub tabTier(engaged: bool, visible: bool, marker: int): int {
    if (marker != 1) {
        throw "target selection tier marker is invalid";
    }
    if (engaged && visible) { return 0; }
    if (visible) { return 1; }
    if (engaged) { return 2; }
    return 3;
}

pub tabNear(engaged: bool, visible: bool, distance: float, marker: int): bool {
    if (marker != 1 || distance < 0.0) {
        throw "target selection near-cluster input is invalid";
    }
    return visible && (engaged || distance <= 30.0);
}

validateCandidates(candidates: CandidateSet): void {
    if (candidates.enemyIds.length != candidates.enemyDx.length ||
        candidates.enemyIds.length != candidates.enemyDz.length ||
        candidates.enemyIds.length != candidates.enemyEngaged.length ||
        candidates.friendlyIds.length != candidates.friendlyDx.length ||
        candidates.friendlyIds.length != candidates.friendlyDz.length) {
        throw "target selection candidate columns have different lengths";
    }
}

pub nearestEnemy(candidates: CandidateSet, currentId: uint): uint {
    validateCandidates(candidates);
    var bestId = currentId;
    var bestDistanceSquared = 1600.0;
    var index = 0;
    while (index < candidates.enemyIds.length) {
        var dx = <float>candidates.enemyDx[index];
        var dz = <float>candidates.enemyDz[index];
        var distanceSquared = dx * dx + dz * dz;
        // The source initializes bestD2 to radius squared and compares strictly.
        if (distanceSquared < bestDistanceSquared) {
            bestDistanceSquared = distanceSquared;
            bestId = <uint>candidates.enemyIds[index];
        }
        index = index + 1;
    }
    return bestId;
}

pub nearestFriendly(candidates: CandidateSet, currentId: uint): uint {
    validateCandidates(candidates);
    var bestId = currentId;
    var bestDistanceSquared = 1000000000000.0;
    var index = 0;
    while (index < candidates.friendlyIds.length) {
        var dx = <float>candidates.friendlyDx[index];
        var dz = <float>candidates.friendlyDz[index];
        var distanceSquared = dx * dx + dz * dz;
        if (distanceSquared <= 1600.0 && distanceSquared < bestDistanceSquared) {
            bestDistanceSquared = distanceSquared;
            bestId = <uint>candidates.friendlyIds[index];
        }
        index = index + 1;
    }
    return bestId;
}

tabCandidateBefore(
    leftNear: bool,
    leftTier: int,
    leftDistance: float,
    leftId: uint,
    rightNear: bool,
    rightTier: int,
    rightDistance: float,
    rightId: uint
): bool {
    return (leftNear && !rightNear) ||
        (leftNear == rightNear && leftTier < rightTier) ||
        (leftNear == rightNear && leftTier == rightTier &&
            leftDistance < rightDistance) ||
        (leftNear == rightNear && leftTier == rightTier &&
            leftDistance == rightDistance && leftId < rightId);
}

pub tabEnemy(candidates: CandidateSet, currentId: uint, facing: float): uint {
    validateCandidates(candidates);
    var math = %import("zr.zircon.math");
    var currentFound = false;
    var currentNear = false;
    var currentTier = 0;
    var currentDistance = 0.0;
    var index = 0;
    while (index < candidates.enemyIds.length) {
        if (<uint>candidates.enemyIds[index] == currentId) {
            var currentDx = <float>candidates.enemyDx[index];
            var currentDz = <float>candidates.enemyDz[index];
            var currentDistanceSquared = currentDx * currentDx + currentDz * currentDz;
            if (currentDistanceSquared <= 1600.0) {
                var currentEngaged = <bool>candidates.enemyEngaged[index];
                currentDistance = math.sqrt(currentDistanceSquared);
                var currentVisible = tabVisible(currentDx, currentDz, facing, 1);
                currentNear = tabNear(currentEngaged, currentVisible, currentDistance, 1);
                currentTier = tabTier(currentEngaged, currentVisible, 1);
                currentFound = true;
                break;
            }
        }
        index = index + 1;
    }

    var wrapFound = false;
    var wrapId = currentId;
    var wrapNear = false;
    var wrapTier = 0;
    var wrapDistance = 0.0;
    var successorFound = false;
    var successorId = currentId;
    var successorNear = false;
    var successorTier = 0;
    var successorDistance = 0.0;
    index = 0;
    while (index < candidates.enemyIds.length) {
        var dx = <float>candidates.enemyDx[index];
        var dz = <float>candidates.enemyDz[index];
        var distanceSquared = dx * dx + dz * dz;
        if (distanceSquared <= 1600.0) {
            var id = <uint>candidates.enemyIds[index];
            var engaged = <bool>candidates.enemyEngaged[index];
            var distance = math.sqrt(distanceSquared);
            var visible = tabVisible(dx, dz, facing, 1);
            var near = tabNear(engaged, visible, distance, 1);
            var tier = tabTier(engaged, visible, 1);
            var eligible = !currentFound || !currentNear || near;
            if (eligible && (!wrapFound || tabCandidateBefore(
                near, tier, distance, id,
                wrapNear, wrapTier, wrapDistance, wrapId
            ))) {
                wrapFound = true;
                wrapId = id;
                wrapNear = near;
                wrapTier = tier;
                wrapDistance = distance;
            }
            var afterCurrent = currentFound && eligible && tabCandidateBefore(
                currentNear, currentTier, currentDistance, currentId,
                near, tier, distance, id
            );
            if (afterCurrent && (!successorFound || tabCandidateBefore(
                near, tier, distance, id,
                successorNear, successorTier, successorDistance, successorId
            ))) {
                successorFound = true;
                successorId = id;
                successorNear = near;
                successorTier = tier;
                successorDistance = distance;
            }
        }
        index = index + 1;
    }
    if (successorFound) { return successorId; }
    return wrapFound ? wrapId : currentId;
}

pub friendlyCycle(candidates: CandidateSet, currentId: uint): uint {
    validateCandidates(candidates);
    var currentCandidateIndex = -1;
    var currentDistanceSquared = 0.0;
    var index = 0;
    while (index < candidates.friendlyIds.length) {
        if (<uint>candidates.friendlyIds[index] == currentId) {
            var currentDx = <float>candidates.friendlyDx[index];
            var currentDz = <float>candidates.friendlyDz[index];
            var candidateDistanceSquared = currentDx * currentDx + currentDz * currentDz;
            if (candidateDistanceSquared <= 1600.0) {
                currentCandidateIndex = index;
                currentDistanceSquared = candidateDistanceSquared;
                break;
            }
        }
        index = index + 1;
    }

    var wrapFound = false;
    var wrapId = currentId;
    var wrapDistanceSquared = 0.0;
    var successorFound = false;
    var successorId = currentId;
    var successorDistanceSquared = 0.0;
    var successorCandidateIndex = -1;
    index = 0;
    while (index < candidates.friendlyIds.length) {
        var dx = <float>candidates.friendlyDx[index];
        var dz = <float>candidates.friendlyDz[index];
        var distanceSquared = dx * dx + dz * dz;
        if (distanceSquared <= 1600.0) {
            var id = <uint>candidates.friendlyIds[index];
            var candidateIndex = index;
            if (!wrapFound || distanceSquared < wrapDistanceSquared) {
                wrapFound = true;
                wrapId = id;
                wrapDistanceSquared = distanceSquared;
            }
            var afterCurrent = currentCandidateIndex >= 0 &&
                (distanceSquared > currentDistanceSquared ||
                    (distanceSquared == currentDistanceSquared &&
                        candidateIndex > currentCandidateIndex));
            if (afterCurrent && (!successorFound ||
                distanceSquared < successorDistanceSquared ||
                (distanceSquared == successorDistanceSquared &&
                    candidateIndex < successorCandidateIndex))) {
                successorFound = true;
                successorId = id;
                successorDistanceSquared = distanceSquared;
                successorCandidateIndex = candidateIndex;
            }
        }
        index = index + 1;
    }
    if (successorFound) { return successorId; }
    return wrapFound ? wrapId : currentId;
}

pub contractTest(): int {
    var nearest = new CandidateSet();
    nearest.addEnemy(<uint>30, 10.0, 0.0, false);
    nearest.addEnemy(<uint>20, -10.0, 0.0, false);
    if (nearestEnemy(nearest, <uint>99) != <uint>30) { return -1; }

    var enemyBoundary = new CandidateSet();
    enemyBoundary.addEnemy(<uint>1, 40.0, 0.0, false);
    if (nearestEnemy(enemyBoundary, <uint>99) != <uint>99) { return -2; }

    var friendlyBoundary = new CandidateSet();
    friendlyBoundary.addFriendly(<uint>7, 40.0, 0.0);
    if (nearestFriendly(friendlyBoundary, <uint>99) != <uint>7) { return -3; }

    var tab = new CandidateSet();
    tab.addEnemy(<uint>30, 0.0, 35.0, true);
    tab.addEnemy(<uint>10, 0.0, 10.0, false);
    tab.addEnemy(<uint>20, 0.0, -5.0, true);
    tab.addEnemy(<uint>40, 5.0, 0.0, false);
    if (tabEnemy(tab, <uint>0, 0.0) != <uint>30) { return -4; }
    if (tabEnemy(tab, <uint>30, 0.0) != <uint>10) { return -5; }
    if (tabEnemy(tab, <uint>10, 0.0) != <uint>30) { return -6; }
    if (tabEnemy(tab, <uint>20, 0.0) != <uint>40) { return -7; }
    if (tabEnemy(tab, <uint>40, 0.0) != <uint>30) { return -8; }

    var fallback = new CandidateSet();
    fallback.addEnemy(<uint>3, 0.0, -5.0, true);
    fallback.addEnemy(<uint>2, 2.0, 0.0, false);
    if (tabEnemy(fallback, <uint>0, 0.0) != <uint>3) { return -9; }
    if (tabEnemy(fallback, <uint>3, 0.0) != <uint>2) { return -10; }
    if (tabEnemy(fallback, <uint>2, 0.0) != <uint>3) { return -11; }

    var friendly = new CandidateSet();
    friendly.addFriendly(<uint>5, 10.0, 0.0);
    friendly.addFriendly(<uint>3, 5.0, 0.0);
    friendly.addFriendly(<uint>4, -5.0, 0.0);
    if (nearestFriendly(friendly, <uint>0) != <uint>3) { return -12; }
    if (friendlyCycle(friendly, <uint>0) != <uint>3) { return -13; }
    if (friendlyCycle(friendly, <uint>3) != <uint>4) { return -14; }
    if (friendlyCycle(friendly, <uint>4) != <uint>5) { return -15; }
    if (friendlyCycle(friendly, <uint>5) != <uint>3) { return -16; }

    var empty = new CandidateSet();
    if (tabEnemy(empty, <uint>77, 0.0) != <uint>77 ||
        nearestFriendly(empty, <uint>77) != <uint>77) {
        return -17;
    }
    var outside = new CandidateSet();
    outside.addEnemy(<uint>1, 0.0, 40.000001, true);
    if (tabEnemy(outside, <uint>77, 0.0) != <uint>77) { return -18; }

    var linearEnemyTie = new CandidateSet();
    linearEnemyTie.addEnemy(<uint>30, 0.0, 10.0, true);
    linearEnemyTie.addEnemy(<uint>10, 0.0, 10.0, true);
    linearEnemyTie.addEnemy(<uint>20, 0.0, 10.0, true);
    if (tabEnemy(linearEnemyTie, <uint>0, 0.0) != <uint>10) { return -19; }
    if (tabEnemy(linearEnemyTie, <uint>10, 0.0) != <uint>20) { return -20; }
    if (tabEnemy(linearEnemyTie, <uint>30, 0.0) != <uint>10) { return -21; }

    var linearEnemyFallback = new CandidateSet();
    linearEnemyFallback.addEnemy(<uint>3, 0.0, 5.0, true);
    linearEnemyFallback.addEnemy(<uint>1, 0.0, 10.0, false);
    linearEnemyFallback.addEnemy(<uint>2, 0.0, -5.0, true);
    if (tabEnemy(linearEnemyFallback, <uint>1, 0.0) != <uint>3) { return -22; }
    if (tabEnemy(linearEnemyFallback, <uint>3, 0.0) != <uint>1) { return -23; }
    if (tabEnemy(linearEnemyFallback, <uint>2, 0.0) != <uint>3) { return -24; }

    var linearFriendlyTie = new CandidateSet();
    linearFriendlyTie.addFriendly(<uint>30, 3.0, 4.0);
    linearFriendlyTie.addFriendly(<uint>10, -3.0, -4.0);
    linearFriendlyTie.addFriendly(<uint>20, 0.0, 10.0);
    if (friendlyCycle(linearFriendlyTie, <uint>0) != <uint>30) { return -25; }
    if (friendlyCycle(linearFriendlyTie, <uint>30) != <uint>10) { return -26; }
    if (friendlyCycle(linearFriendlyTie, <uint>10) != <uint>20) { return -27; }
    if (friendlyCycle(linearFriendlyTie, <uint>20) != <uint>30) { return -28; }
    return 1;
}
