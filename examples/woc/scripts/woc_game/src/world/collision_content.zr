fenceSegmentIndexIsValid(index: int): bool {
    return index >= 0 && index < 6;
}

pub fenceSegmentCount(required: bool): int {
    if (!required) {
        throw "woc fence segment count is required";
    }
    return 6;
}

pub fenceSegmentFloat(index: int, field: int, required: bool): float {
    if (!required || !fenceSegmentIndexIsValid(index) || field < 1 || field > 4) {
        throw "woc fence segment field is invalid";
    }
    if (index == 0) {
        if (field == 1) {
            return 16.0;
        }
        if (field == 2) {
            return 16.0;
        }
        if (field == 3) {
            return 22.0;
        }
        return 4.0;
    }
    if (index == 1) {
        if (field == 1) {
            return -16.0;
        }
        if (field == 2) {
            return 14.0;
        }
        if (field == 3) {
            return -20.0;
        }
        return 2.0;
    }
    if (index == 2) {
        if (field == 1) {
            return 16.0;
        }
        if (field == 2) {
            return 311.0;
        }
        if (field == 3) {
            return 21.0;
        }
        return 299.0;
    }
    if (index == 3) {
        if (field == 1) {
            return -18.0;
        }
        if (field == 2) {
            return 313.0;
        }
        if (field == 3) {
            return -22.0;
        }
        return 300.0;
    }
    if (index == 4) {
        if (field == 1) {
            return -14.0;
        }
        if (field == 2) {
            return 649.0;
        }
        if (field == 3) {
            return -4.0;
        }
        return 647.0;
    }
    if (field == 1) {
        return 4.0;
    }
    if (field == 2) {
        return 647.0;
    }
    if (field == 3) {
        return 14.0;
    }
    return 649.0;
}

pub contractTest(): int {
    if (colliderCount(true) != 170 || colliderKind(0, true) != 2 ||
        colliderKind(169, true) != 1 || colliderIsFence(0, true) != false ||
        colliderIsFence(169, true) != false) {
        return -1;
    }
    if (colliderFloat(0, 1, true) != 10.0 || colliderFloat(0, 2, true) != 12.0 ||
        colliderFloat(169, 4, true) != 0.0 || colliderFloat(169, 5, true) != 0.0) {
        return -2;
    }
    if (fenceSegmentCount(true) != 6 || fenceSegmentFloat(0, 1, true) != 16.0 ||
        fenceSegmentFloat(5, 4, true) != 649.0) {
        return -3;
    }
    return 1;
}
