doorIndexIsValid(index: int): bool {
    return index >= 0 && index < 5;
}

pub dungeonDoorClearRadius(required: bool): float {
    if (!required) {
        throw "woc dungeon door clear radius is required";
    }
    return 20.0;
}

pub dungeonDoorCount(required: bool): int {
    if (!required) {
        throw "woc dungeon door count is required";
    }
    return 5;
}

pub dungeonDoorX(index: int, required: bool): float {
    if (!required || !doorIndexIsValid(index)) {
        throw "woc dungeon door x is invalid";
    }
    if (index == 0) {
        return 80.0;
    }
    if (index == 1) {
        return 45.0;
    }
    if (index == 2) {
        return 0.0;
    }
    if (index == 3) {
        return -152.0;
    }
    return -70.0;
}

pub dungeonDoorZ(index: int, required: bool): float {
    if (!required || !doorIndexIsValid(index)) {
        throw "woc dungeon door z is invalid";
    }
    if (index == 0) {
        return 90.0;
    }
    if (index == 1) {
        return 515.0;
    }
    if (index == 2) {
        return 858.0;
    }
    if (index == 3) {
        return 610.0;
    }
    return 792.0;
}

pub contractTest(): int {
    if (dungeonDoorClearRadius(true) != 20.0 || dungeonDoorCount(true) != 5 ||
        dungeonDoorX(0, true) != 80.0 || dungeonDoorZ(0, true) != 90.0 ||
        dungeonDoorX(1, true) != 45.0 || dungeonDoorZ(1, true) != 515.0 ||
        dungeonDoorX(2, true) != 0.0 || dungeonDoorZ(2, true) != 858.0 ||
        dungeonDoorX(3, true) != -152.0 || dungeonDoorZ(3, true) != 610.0 ||
        dungeonDoorX(4, true) != -70.0 || dungeonDoorZ(4, true) != 792.0) {
        return -1;
    }
    return 1;
}
