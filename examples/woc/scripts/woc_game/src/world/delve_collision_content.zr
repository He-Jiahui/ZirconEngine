defaultChainRouteForDelveIndex(delveIndex: int): int {
    if (delveIndex == 0) {
        return 0;
    }
    return delveIndex == 1 ? 1 : -1;
}

pub defaultChainCount(delveIndex: int, required: bool): int {
    if (!required) {
        throw "woc Delve default chain count is required";
    }
    var route = defaultChainRouteForDelveIndex(delveIndex);
    if (route < 0) {
        throw "woc Delve default chain is invalid";
    }
    if (route == 0) {
        return 4;
    }
    return 4;
}

pub defaultChainModuleIndex(delveIndex: int, moduleOffset: int, required: bool): int {
    if (!required || moduleOffset < 0) {
        throw "woc Delve default chain module is invalid";
    }
    var route = defaultChainRouteForDelveIndex(delveIndex);
    if (route < 0 || moduleOffset >= defaultChainCount(delveIndex, true)) {
        throw "woc Delve default chain module is invalid";
    }
    if (route == 0) {
        if (moduleOffset == 0) {
            return 0;
        }
        if (moduleOffset == 1) {
            return 1;
        }
        if (moduleOffset == 2) {
            return 2;
        }
        return 3;
    }
    if (route == 1) {
        if (moduleOffset == 0) {
            return 4;
        }
        if (moduleOffset == 1) {
            return 5;
        }
        if (moduleOffset == 2) {
            return 6;
        }
        return 10;
    }
    throw "woc Delve default chain module is invalid";
}

pub delveBandXMin(required: bool): float {
    if (!required) {
        throw "woc Delve delve_band_x_min is required";
    }
    return 4773.0;
}

pub yumiBandXMin(required: bool): float {
    if (!required) {
        throw "woc Delve yumi_band_x_min is required";
    }
    return 8000.0;
}

pub delveOriginBaseX(required: bool): float {
    if (!required) {
        throw "woc Delve delve_origin_base_x is required";
    }
    return 4800.0;
}

pub delveOriginIndexSpacing(required: bool): float {
    if (!required) {
        throw "woc Delve delve_origin_index_spacing is required";
    }
    return 600.0;
}

pub delveOriginZ0(required: bool): float {
    if (!required) {
        throw "woc Delve delve_origin_z0 is required";
    }
    return -1250.0;
}

pub delveSlotCount(required: bool): int {
    if (!required) {
        throw "woc Delve delve_slot_count is required";
    }
    return 24;
}

pub delveSlotSpacing(required: bool): float {
    if (!required) {
        throw "woc Delve delve_slot_spacing is required";
    }
    return 620.0;
}

pub delveModuleGap(required: bool): float {
    if (!required) {
        throw "woc Delve delve_module_gap is required";
    }
    return 16.0;
}

pub delveModuleZStart(required: bool): float {
    if (!required) {
        throw "woc Delve delve_module_z_start is required";
    }
    return 8.0;
}


pub contractTest(): int {
    if (moduleCount(true) != 11 || moduleColliderCount(0, true) != 24 || moduleSpan(0, true) != 110.0 ||
        moduleColliderCount(10, true) != 63 || moduleSpan(10, true) != 108.0 ||
        colliderKind(0, 0, true) != 2 || colliderFloat(0, 0, 1, true) != -25.0 ||
        colliderKind(10, 0, true) != 2 || colliderFloat(10, 0, 2, true) != -19.0) {
        return -1;
    }
    if (defaultChainCount(0, true) != 4 || defaultChainModuleIndex(0, 0, true) != 0 ||
        defaultChainModuleIndex(0, 3, true) != 3 || defaultChainCount(1, true) != 4 ||
        defaultChainModuleIndex(1, 3, true) != 10) {
        return -2;
    }
    if (delveBandXMin(true) != 4773.0 || yumiBandXMin(true) != 8000.0 ||
        delveOriginBaseX(true) != 4800.0 || delveOriginIndexSpacing(true) != 600.0 ||
        delveOriginZ0(true) != -1250.0 || delveSlotCount(true) != 24 ||
        delveSlotSpacing(true) != 620.0 || delveModuleGap(true) != 16.0 ||
        delveModuleZStart(true) != 8.0) {
        return -3;
    }
    return 1;
}
