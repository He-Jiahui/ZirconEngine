// Generated fixed Delve module collision projection from pinned source.
// Module indices are source-order reliquary then Litany layouts. Kinds:
// 1=circle, 2=rotated OBB. Float fields: 1=x, 2=z, 3=radius,
// 4=half-width, 5=half-depth, 6=rotation.

moduleIndexIsValid(index: int): bool {
    return index >= 0 && index < 11;
}

pub moduleCount(required: bool): int {
    if (!required) {
        throw "woc Delve module count is required";
    }
    return 11;
}

pub moduleColliderCount(moduleIndex: int, required: bool): int {
    if (!required || !moduleIndexIsValid(moduleIndex)) {
        throw "woc Delve module collider count is invalid";
    }
    if (moduleIndex == 0) {
        return 24;
    }
    if (moduleIndex == 1) {
        return 20;
    }
    if (moduleIndex == 2) {
        return 24;
    }
    if (moduleIndex == 3) {
        return 16;
    }
    if (moduleIndex == 4) {
        return 43;
    }
    if (moduleIndex == 5) {
        return 59;
    }
    if (moduleIndex == 6) {
        return 61;
    }
    if (moduleIndex == 7) {
        return 51;
    }
    if (moduleIndex == 8) {
        return 59;
    }
    if (moduleIndex == 9) {
        return 53;
    }
    return 63;
}

pub moduleSpan(moduleIndex: int, required: bool): float {
    if (!required || !moduleIndexIsValid(moduleIndex)) {
        throw "woc Delve module span is invalid";
    }
    if (moduleIndex == 0) {
        return 110.0;
    }
    if (moduleIndex == 1) {
        return 110.0;
    }
    if (moduleIndex == 2) {
        return 110.0;
    }
    if (moduleIndex == 3) {
        return 110.0;
    }
    if (moduleIndex == 4) {
        return 74.0;
    }
    if (moduleIndex == 5) {
        return 100.0;
    }
    if (moduleIndex == 6) {
        return 106.0;
    }
    if (moduleIndex == 7) {
        return 84.0;
    }
    if (moduleIndex == 8) {
        return 96.0;
    }
    if (moduleIndex == 9) {
        return 106.0;
    }
    return 108.0;
}

