// Source-order 0.2-yard sweep inside one explicitly selected Delve module.
// Module transitions are owned by active run state and must select a new
// origin/index before calling this routine again.

var math = %import("zr.zircon.math");
var fence = %import("world/collision_sweep");
var routing = %import("world/delve_collision_routing");

pub resolveActiveModuleMovementCoordinate(
    fromX: float,
    fromZ: float,
    toX: float,
    toZ: float,
    moduleOriginX: float,
    moduleOriginZ: float,
    moduleIndex: int,
    bodyRadius: float,
    ignoreFences: bool,
    axis: int,
    required: bool
): float {
    if (!required || bodyRadius < 0.0 || (axis != 1 && axis != 2)) {
        throw "woc active Delve swept collision arguments are invalid";
    }
    var deltaX = toX - fromX;
    var deltaZ = toZ - fromZ;
    var distance = math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
    if (distance < 0.000001) {
        return routing.resolveActiveModuleWorldCoordinate(
            toX, toZ, moduleOriginX, moduleOriginZ, moduleIndex, bodyRadius, axis, true
        );
    }
    var steps = <int>math.ceil(distance / 0.2);
    if (steps < 1) {
        steps = 1;
    }
    var positionX = fromX;
    var positionZ = fromZ;
    var step = 1;
    while (step <= steps) {
        var fraction = <float>step / <float>steps;
        var nextX = fromX + deltaX * fraction;
        var nextZ = fromZ + deltaZ * fraction;
        if (!ignoreFences && fence.crossesBuiltinFence(
            positionX, positionZ, nextX, nextZ, bodyRadius, true
        )) {
            return axis == 1 ? positionX : positionZ;
        }
        positionX = routing.resolveActiveModuleWorldCoordinate(
            nextX, nextZ, moduleOriginX, moduleOriginZ, moduleIndex, bodyRadius, 1, true
        );
        positionZ = routing.resolveActiveModuleWorldCoordinate(
            nextX, nextZ, moduleOriginX, moduleOriginZ, moduleIndex, bodyRadius, 2, true
        );
        var correctionX = positionX - nextX;
        var correctionZ = positionZ - nextZ;
        var correctionLength = math.sqrt(correctionX * correctionX + correctionZ * correctionZ);
        if (correctionLength > bodyRadius * 0.25) {
            var remainingX = toX - nextX;
            var remainingZ = toZ - nextZ;
            if (remainingX * correctionX + remainingZ * correctionZ < 0.0) {
                return axis == 1 ? positionX : positionZ;
            }
        }
        step = step + 1;
    }
    return axis == 1 ? positionX : positionZ;
}

pub contractTest(): int {
    if (resolveActiveModuleMovementCoordinate(
        4770.0, -1206.0, 4780.0, -1206.0, 4800.0, -1242.0, 0, 0.5, false, 1, true
    ) != 4773.5 || resolveActiveModuleMovementCoordinate(
        4770.0, -1206.0, 4780.0, -1206.0, 4800.0, -1242.0, 0, 0.5, false, 2, true
    ) != -1206.0 || resolveActiveModuleMovementCoordinate(
        5395.333333333333, -1248.0, 5395.333333333333, -1262.0,
        5400.0, -1242.0, 4, 0.5, false, 1, true
    ) != 5395.333333333333 || resolveActiveModuleMovementCoordinate(
        5395.333333333333, -1248.0, 5395.333333333333, -1262.0,
        5400.0, -1242.0, 4, 0.5, false, 2, true
    ) != -1254.5) {
        return -1;
    }
    if (resolveActiveModuleMovementCoordinate(
        4800.0, -1220.0, 4802.0, -1220.0, 4800.0, -1242.0, 0, 0.5, false, 1, true
    ) != 4802.0 || resolveActiveModuleMovementCoordinate(
        4800.0, -1220.0, 4802.0, -1220.0, 4800.0, -1242.0, 0, 0.5, false, 2, true
    ) != -1220.0) {
        return -2;
    }
    return 1;
}
