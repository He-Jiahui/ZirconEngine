// Pure terrainSteepness/terrainSteepnessAt projection from src/sim/world.ts.
// The source cache changes cost only, so this module computes its pure value
// directly after preserving JavaScript Math.round's floor(value + 0.5) rule.

var math = %import("zr.zircon.math");
var terrainContent = %import("world/terrain_content");
var terrainGround = %import("world/terrain_ground");

closeEnough(value: float, expected: float): bool {
    var delta = value - expected;
    if (delta < 0.0) {
        delta = -delta;
    }
    return delta < 0.00000001;
}

pub javascriptRound(value: float, required: bool): int {
    if (!required) {
        throw "woc JavaScript round input is required";
    }
    return <int>math.floor(value + 0.5);
}

pub builtinTerrainSteepness(x: float, z: float, seed: uint, required: bool): float {
    if (!required) {
        throw "woc terrain steepness query is required";
    }
    var sample = 0.35;
    var heightX = (
        terrainGround.builtinGroundHeight(x + sample, z, seed, true) -
        terrainGround.builtinGroundHeight(x - sample, z, seed, true)
    ) / (2.0 * sample);
    var heightZ = (
        terrainGround.builtinGroundHeight(x, z + sample, seed, true) -
        terrainGround.builtinGroundHeight(x, z - sample, seed, true)
    ) / (2.0 * sample);
    return math.sqrt(heightX * heightX + heightZ * heightZ);
}

pub builtinTerrainSteepnessAt(x: float, z: float, seed: uint, required: bool): float {
    if (!required) {
        throw "woc terrain steepness-at query is required";
    }
    if (x > terrainContent.dungeonXThreshold(true)) {
        return 0.0;
    }
    return builtinTerrainSteepness(
        <float>javascriptRound(x, true),
        <float>javascriptRound(z, true),
        seed,
        true
    );
}

pub builtinTerrainDownhillCoordinate(
    x: float,
    z: float,
    seed: uint,
    axis: int,
    required: bool
): float {
    if (!required || (axis != 1 && axis != 2)) {
        throw "woc terrain downhill query is invalid";
    }
    var sample = 0.35;
    var heightX = (
        terrainGround.builtinGroundHeight(x + sample, z, seed, true) -
        terrainGround.builtinGroundHeight(x - sample, z, seed, true)
    ) / (2.0 * sample);
    var heightZ = (
        terrainGround.builtinGroundHeight(x, z + sample, seed, true) -
        terrainGround.builtinGroundHeight(x, z - sample, seed, true)
    ) / (2.0 * sample);
    var magnitude = math.sqrt(heightX * heightX + heightZ * heightZ);
    if (magnitude < 0.000001) {
        return 0.0;
    }
    return axis == 1 ? -heightX / magnitude : -heightZ / magnitude;
}

pub contractTest(): int {
    if (javascriptRound(-0.51, true) != -1 || javascriptRound(-0.5, true) != 0 ||
        javascriptRound(0.49, true) != 0 || javascriptRound(0.5, true) != 1) {
        return -1;
    }
    if (builtinTerrainSteepness(0.0, 0.0, <uint>20061, true) != 0.0 ||
        builtinTerrainSteepnessAt(600.1, 0.0, <uint>20061, true) != 0.0) {
        return -2;
    }
    if (!closeEnough(builtinTerrainSteepness(-11.0, -95.3, <uint>20061, true), 0.39285714285714285) ||
        !closeEnough(builtinTerrainSteepnessAt(-10.51, -95.49, <uint>20061, true), 0.39285714285714285)) {
        return -3;
    }
    if (builtinTerrainDownhillCoordinate(0.0, 0.0, <uint>20061, 1, true) != 0.0 ||
        builtinTerrainDownhillCoordinate(0.0, 0.0, <uint>20061, 2, true) != 0.0 ||
        !closeEnough(builtinTerrainDownhillCoordinate(-11.0, -95.3, <uint>20061, 1, true), 0.0) ||
        !closeEnough(builtinTerrainDownhillCoordinate(-11.0, -95.3, <uint>20061, 2, true), -1.0)) {
        return -4;
    }
    return 1;
}
