// Pure source DoTs replace only the same ability from the same caster. Their
// rank and selected-power snapshot make the resolved tick independently
// verifiable after the caster changes equipment.
appendOfflinePureDot(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    snapshotPower: int,
    damage: int,
    duration: float,
    interval: float
): void {
    var abilityIndex = pureDotAbilityIndex(abilityCode);
    if (abilityIndex < 0 || !numericEffects.pureDotProfileMatches(
            abilityIndex, <int>rank, snapshotPower, damage, duration, interval
        )) {
        throw "woc pure dot profile is invalid";
    }
    var index = 0;
    while (index < state.offlineDotTargetIds.length) {
        if (<uint>state.offlineDotTargetIds[index] == targetId &&
            <uint>state.offlineDotSourceIds[index] == sourceId &&
            <uint>state.offlineDotAbilityCodes[index] == abilityCode) {
            removeOfflineDotAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineDotTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc offline dot queue exceeds WOS cap";
    }
    state.offlineDotTargetIds.add(targetId);
    state.offlineDotSourceIds.add(sourceId);
    state.offlineDotAbilityCodes.add(abilityCode);
    state.offlineDotDamages.add(damage);
    state.offlineDotRanks.add(rank);
    state.offlineDotSnapshotPowers.add(snapshotPower);
    state.offlineDotRemaining.add(duration);
    state.offlineDotDurations.add(duration);
    state.offlineDotTickIntervals.add(interval);
    state.offlineDotTickTimers.add(interval);
}

entanglingRootsDotProfileIsValid(
    rank: uint,
    snapshotPower: int,
    damage: int,
    duration: float,
    interval: float
): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("entangling_roots");
    if (abilityIndex < 0 || rank != <uint>2 || snapshotPower < 0 ||
        effects.typeAt(abilityIndex, 2, 0) != "root" ||
        effects.typeAt(abilityIndex, 2, 1) != "dot") {
        return false;
    }
    var expectedDuration = effects.metric(abilityIndex, 2, 1, "duration");
    var expectedInterval = effects.metric(abilityIndex, 2, 1, "interval");
    if (expectedDuration <= 0.0 || expectedInterval <= 0.0 ||
        expectedDuration < expectedInterval) {
        return false;
    }
    var base = <int>(effects.metric(abilityIndex, 2, 1, "total") /
        (expectedDuration / expectedInterval) + 0.5);
    if (base < 1) { base = 1; }
    var bonus = spellScaling.dotTickBonus(
        <float>snapshotPower,
        "nature",
        false,
        expectedDuration,
        expectedInterval
    );
    return damage == base + bonus && duration == expectedDuration &&
        interval == expectedInterval;
}

appendOfflineEntanglingRootsDot(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    rank: uint,
    snapshotPower: int,
    damage: int,
    duration: float,
    interval: float
): void {
    var abilityCode = entanglingRootsAbilityCode();
    if (!entanglingRootsDotProfileIsValid(
            rank, snapshotPower, damage, duration, interval
        )) {
        throw "woc Entangling Roots dot profile is invalid";
    }
    var index = 0;
    while (index < state.offlineDotTargetIds.length) {
        if (<uint>state.offlineDotTargetIds[index] == targetId &&
            <uint>state.offlineDotSourceIds[index] == sourceId &&
            <uint>state.offlineDotAbilityCodes[index] == abilityCode) {
            removeOfflineDotAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineDotTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc offline dot queue exceeds WOS cap";
    }
    state.offlineDotTargetIds.add(targetId);
    state.offlineDotSourceIds.add(sourceId);
    state.offlineDotAbilityCodes.add(abilityCode);
    state.offlineDotDamages.add(damage);
    state.offlineDotRanks.add(rank);
    state.offlineDotSnapshotPowers.add(snapshotPower);
    state.offlineDotRemaining.add(duration);
    state.offlineDotDurations.add(duration);
    state.offlineDotTickIntervals.add(interval);
    state.offlineDotTickTimers.add(interval);
}

landOfflineImmolateProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = immolateAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("immolate");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] !=
        abilityCode || <uint>state.offlineProjectileSchoolCodes[projectileIndex] !=
        OFFLINE_PROJECTILE_SCHOOL_FIRE || rank <= 0) {
        return;
    }

    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }

    var resolution = new timedSpell.TimedSpellResult();
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    spell.spellPower = <float>state.entitySpellPower[casterIndex];
    spell.school = "fire";
    spell.castTime = <float>state.offlineProjectileCastTimes[projectileIndex];
    spell.critChance = <float>state.entityCritChance[casterIndex];
    timedSpell.resolveTimedSpellHit(resolution, spell);

    var damage = resolution.damage;
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage); }
    if (hp > 0) {
        var level = <int>state.entityLevels[casterIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
        var duration = m4AbilityEffects.metric(abilityIndex, rank, 1, "duration");
        var interval = m4AbilityEffects.metric(abilityIndex, rank, 1, "interval");
        var dotDamage = <int>(m4AbilityEffects.metric(
            abilityIndex, rank, 1, "total"
        ) / (duration / interval) + 0.5);
        if (dotDamage < 1) { dotDamage = 1; }
        applyOfflineImmolateDot(
            state,
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            abilityCode,
            dotDamage,
            duration,
            interval
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

landOfflineFireballProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = fireballAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("fireball");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] !=
        abilityCode || rank <= 0) {
        return;
    }

    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }

    var resolution = new timedSpell.TimedSpellResult();
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    spell.spellPower = <float>state.entitySpellPower[casterIndex];
    spell.school = "fire";
    spell.castTime = <float>state.offlineProjectileCastTimes[projectileIndex];
    spell.critChance = <float>state.entityCritChance[casterIndex];
    timedSpell.resolveTimedSpellHit(resolution, spell);

    var damage = resolution.damage;
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage); }
    if (hp > 0) {
        var level = <int>state.entityLevels[casterIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
        var duration = m4AbilityEffects.metric(abilityIndex, rank, 1, "duration");
        var interval = m4AbilityEffects.metric(abilityIndex, rank, 1, "interval");
        var dotDamage = <int>(m4AbilityEffects.metric(
            abilityIndex, rank, 1, "total"
        ) / (duration / interval) + 0.5);
        if (dotDamage < 1) { dotDamage = 1; }
        applyOfflineFireballDot(
            state,
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            abilityCode,
            dotDamage,
            duration,
            interval
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

// These effects are source spell projectiles even though their cast time is
// zero. A successful impact snapshots the selected scaling power and applies
// only the periodic aura; resistance is the sole impact-time random event.
landOfflinePureDotProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int,
    expectedAbilityCode: uint
): void {
    var abilityCode = <uint>state.offlineProjectileAbilityCodes[projectileIndex];
    var rank = <uint>state.offlineProjectileRanks[projectileIndex];
    var abilityIndex = pureDotAbilityIndex(abilityCode);
    if (abilityCode != expectedAbilityCode || abilityIndex < 0 ||
        !pureDotProjectileProfileIsValid(
            abilityCode,
            rank,
            <float>state.offlineProjectileMinimums[projectileIndex],
            <float>state.offlineProjectileMaximums[projectileIndex],
            <float>state.offlineProjectileCastTimes[projectileIndex]
        )) {
        return;
    }

    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }

    var profile = numericEffects.resolvePureDotProfile(
        abilityIndex,
        <int>rank,
        <int>state.entitySpellPower[casterIndex],
        <int>state.entityRangedPower[casterIndex],
        <int>effectiveOfflineAttackPower(state, casterIndex)
    );
    if (!profile.valid) { return; }
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    appendOfflinePureDot(
        state,
        <uint>state.entityIds[targetIndex],
        <uint>state.entityIds[casterIndex],
        abilityCode,
        rank,
        profile.snapshotPower,
        profile.damage,
        profile.duration,
        profile.interval
    );
}

