    appendOfflineAbilityProjectile(state, <uint>state.entityIds[casterIndex], targetId, <float>state.entityX[casterIndex], <float>state.entityZ[casterIndex], effects.metric(abilityIndex, rank, 0, "min"), effects.metric(abilityIndex, rank, 0, "max"), projectileTravel.projectileSpeed(), false, OFFLINE_PROJECTILE_SCHOOL_FIRE, abilityCode, <uint>rank, 0.0);
