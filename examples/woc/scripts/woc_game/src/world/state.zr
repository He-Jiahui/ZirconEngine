    pub var partyMarkerPartyIds: container.Array<uint>;
    pub var partyMarkerEntityIds: container.Array<uint>;
    pub var partyMarkerSymbols: container.Array<uint>;
    pub var entityPartyMasterLootEnabled: container.Array<bool>;
