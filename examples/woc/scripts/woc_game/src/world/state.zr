appendDefaultM5InventoryColumns(state: WorldState): void {
    var index = state.entityIds.length - 1;
    if (index < 0 || state.entityInventoryCopper.length != index ||
        state.entityInventoryBagCodes.length != index * m5InventoryRules.bagSockets() ||
        state.entityInventoryStackOffsets.length != index + 1 ||
        <uint>state.entityInventoryStackOffsets[index] !=
            <uint>state.entityInventoryStackItemCodes.length ||
        state.entityInventoryStackItemCodes.length != state.entityInventoryStackCounts.length ||
        state.entityVendorBuybackOffsets.length != index + 1 ||
        <uint>state.entityVendorBuybackOffsets[index] !=
            <uint>state.entityVendorBuybackItemCodes.length ||
        state.entityVendorBuybackItemCodes.length != state.entityVendorBuybackCounts.length) {
        throw "woc M5 inventory default row is invalid";
    }
    state.entityInventoryCopper.add(0);
    var socket = 0;
    while (socket < m5InventoryRules.bagSockets()) {
        state.entityInventoryBagCodes.add(<uint>0);
        socket = socket + 1;
    }
    state.entityInventoryStackOffsets.add(
        <uint>state.entityInventoryStackItemCodes.length
    );
    state.entityVendorBuybackOffsets.add(
        <uint>state.entityVendorBuybackItemCodes.length
    );
}

delveShopClearIndex(entityIndex: int, shopIndex: int): int {
    var catalog = %import("generated/m5_content_catalog");
    return entityIndex * catalog.delveShopCount() + shopIndex;
}

appendDefaultDelveShopColumns(state: WorldState): void {
    var catalog = %import("generated/m5_content_catalog");
    var entityIndex = state.entityIds.length - 1;
    var expectedClears = entityIndex * catalog.delveShopCount();
    if (entityIndex < 0 || state.entityDelveMarks.length != entityIndex ||
        state.entityDelveShopNormalClears.length != expectedClears ||
        state.entityDelveShopHeroicClears.length != expectedClears ||
        state.entityDelveShopOtherClears.length != expectedClears) {
        throw "woc Delve shop default row is invalid";
    }
    state.entityDelveMarks.add(0);
    var shopIndex = 0;
    while (shopIndex < catalog.delveShopCount()) {
        state.entityDelveShopNormalClears.add(0);
        state.entityDelveShopHeroicClears.add(0);
        state.entityDelveShopOtherClears.add(0);
        shopIndex = shopIndex + 1;
    }
}

delveShopStateIsValid(state: WorldState, entityIndex: int): bool {
    var catalog = %import("generated/m5_content_catalog");
    var expectedClears = state.entityIds.length * catalog.delveShopCount();
    if (entityIndex < 0 || entityIndex >= state.entityIds.length ||
        state.entityDelveMarks.length != state.entityIds.length ||
        state.entityDelveShopNormalClears.length != expectedClears ||
        state.entityDelveShopHeroicClears.length != expectedClears ||
        state.entityDelveShopOtherClears.length != expectedClears ||
        <int>state.entityDelveMarks[entityIndex] < 0) {
        return false;
    }
    var shopIndex = 0;
    while (shopIndex < catalog.delveShopCount()) {
        var clearIndex = delveShopClearIndex(entityIndex, shopIndex);
        if (<int>state.entityDelveShopNormalClears[clearIndex] < 0 ||
            <int>state.entityDelveShopHeroicClears[clearIndex] < 0 ||
            <int>state.entityDelveShopOtherClears[clearIndex] < 0) {
            return false;
        }
        if (<uint>state.entityKinds[entityIndex] != <uint>1 &&
            (<int>state.entityDelveShopNormalClears[clearIndex] != 0 ||
                <int>state.entityDelveShopHeroicClears[clearIndex] != 0 ||
                <int>state.entityDelveShopOtherClears[clearIndex] != 0)) {
            return false;
        }
        shopIndex = shopIndex + 1;
    }
    return <uint>state.entityKinds[entityIndex] == <uint>1 ||
        <int>state.entityDelveMarks[entityIndex] == 0;
}

delveCompanionRankIndex(entityIndex: int, companionIndex: int): int {
    return entityIndex * delveCompanionContent.companionCount(true) + companionIndex;
}

appendDefaultDelveCompanionColumns(state: WorldState): void {
    var entityIndex = state.entityIds.length - 1;
    var companionCount = delveCompanionContent.companionCount(true);
    if (entityIndex < 0 ||
        state.entityDelveCompanionRanks.length != entityIndex * companionCount) {
        throw "woc Delve companion default row is invalid";
    }
    var defaultRank = <uint>state.entityKinds[entityIndex] == <uint>1 ? 1 : 0;
    var companionIndex = 0;
    while (companionIndex < companionCount) {
        state.entityDelveCompanionRanks.add(defaultRank);
        companionIndex = companionIndex + 1;
    }
}

delveCompanionStateIsValid(state: WorldState): bool {
    var companionCount = delveCompanionContent.companionCount(true);
    if (state.entityDelveCompanionRanks.length !=
        state.entityIds.length * companionCount) {
        return false;
    }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var companionIndex = 0;
        while (companionIndex < companionCount) {
            var rank = <int>state.entityDelveCompanionRanks[
                delveCompanionRankIndex(entityIndex, companionIndex)
            ];
            if (<uint>state.entityKinds[entityIndex] == <uint>1) {
                if (rank < 1 || rank > delveCompanionContent.maxRank(true)) {
                    return false;
                }
            } else if (rank != 0) {
                return false;
            }
            companionIndex = companionIndex + 1;
        }
        entityIndex = entityIndex + 1;
    }
    return true;
}

pub setDelveShopState(
    state: WorldState, entityIndex: int, shopIndex: int, marks: int,
    normalClears: int, heroicClears: int, otherClears: int
): void {
    var catalog = %import("generated/m5_content_catalog");
    if (!delveShopStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1 ||
        shopIndex < 0 || shopIndex >= catalog.delveShopCount() || marks < 0 ||
        normalClears < 0 || heroicClears < 0 || otherClears < 0) {
        throw "woc Delve shop state mutation is invalid";
    }
    var clearIndex = delveShopClearIndex(entityIndex, shopIndex);
    state.entityDelveMarks[entityIndex] = marks;
    state.entityDelveShopNormalClears[clearIndex] = normalClears;
    state.entityDelveShopHeroicClears[clearIndex] = heroicClears;
    state.entityDelveShopOtherClears[clearIndex] = otherClears;
}

appendDefaultM5VendorBuybackColumns(state: WorldState): void {
    var index = state.entityIds.length - 1;
    if (index < 0 || state.entityVendorBuybackOffsets.length != index + 1 ||
        <uint>state.entityVendorBuybackOffsets[index] !=
            <uint>state.entityVendorBuybackItemCodes.length ||
        state.entityVendorBuybackItemCodes.length != state.entityVendorBuybackCounts.length) {
        throw "woc M5 vendor buyback default row is invalid";
    }
    state.entityVendorBuybackOffsets.add(
        <uint>state.entityVendorBuybackItemCodes.length
    );
}

m5InventoryBagCodeIndex(entityIndex: int, socket: int): int {
    return entityIndex * m5InventoryRules.bagSockets() + socket;
}

m5InventoryStateIsValid(state: WorldState, entityIndex: int): bool {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length ||
        state.entityInventoryCopper.length != state.entityIds.length ||
        state.entityInventoryBagCodes.length !=
            state.entityIds.length * m5InventoryRules.bagSockets() ||
        state.entityInventoryStackOffsets.length != state.entityIds.length + 1 ||
        <uint>state.entityInventoryStackOffsets[0] != <uint>0 ||
        <uint>state.entityInventoryStackOffsets[state.entityIds.length] !=
            <uint>state.entityInventoryStackItemCodes.length ||
        state.entityInventoryStackItemCodes.length != state.entityInventoryStackCounts.length ||
        state.entityInventoryStackItemCodes.length !=
            state.entityInventoryStackManualSlots.length ||
        state.entityVendorBuybackOffsets.length != state.entityIds.length + 1 ||
        <uint>state.entityVendorBuybackOffsets[0] != <uint>0 ||
        <uint>state.entityVendorBuybackOffsets[state.entityIds.length] !=
            <uint>state.entityVendorBuybackItemCodes.length ||
        state.entityVendorBuybackItemCodes.length != state.entityVendorBuybackCounts.length ||
        <int>state.entityInventoryCopper[entityIndex] < 0) {
        return false;
    }
    var start = <int><uint>state.entityInventoryStackOffsets[entityIndex];
    var end = <int><uint>state.entityInventoryStackOffsets[entityIndex + 1];
    if (start < 0 || end < start || end > state.entityInventoryStackItemCodes.length) {
        return false;
    }
    var socket = 0;
    while (socket < m5InventoryRules.bagSockets()) {
        var bagCode = <uint>state.entityInventoryBagCodes[
            m5InventoryBagCodeIndex(entityIndex, socket)
        ];
        if (bagCode != <uint>0 && !m5InventoryRules.bagCodeIsValid(bagCode)) {
            return false;
        }
        socket = socket + 1;
    }
    var stackIndex = start;
    while (stackIndex < end) {
        var itemCode = <uint>state.entityInventoryStackItemCodes[stackIndex];
        var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
        var count = <int>state.entityInventoryStackCounts[stackIndex];
        if (itemIndex < 0 || count < 1 ||
            count > m5InventoryRules.stackLimitForItemIndex(itemIndex)) {
            return false;
        }
        stackIndex = stackIndex + 1;
    }
    var buybackStart = <int><uint>state.entityVendorBuybackOffsets[entityIndex];
    var buybackEnd = <int><uint>state.entityVendorBuybackOffsets[entityIndex + 1];
    if (buybackStart < 0 || buybackEnd < buybackStart ||
        buybackEnd > state.entityVendorBuybackItemCodes.length ||
        buybackEnd - buybackStart > 12) {
        return false;
    }
    var priorBuybackCode: uint = <uint>0;
    var buybackIndex = buybackStart;
    while (buybackIndex < buybackEnd) {
        var buybackCode = <uint>state.entityVendorBuybackItemCodes[buybackIndex];
        var buybackCount = <int>state.entityVendorBuybackCounts[buybackIndex];
        if (!m5InventoryRules.itemCodeIsValid(buybackCode) || buybackCount < 1 ||
            buybackCount > 65535 || buybackCode == priorBuybackCode) {
            return false;
        }
        var priorIndex = buybackStart;
        while (priorIndex < buybackIndex) {
            if (<uint>state.entityVendorBuybackItemCodes[priorIndex] == buybackCode) {
                return false;
            }
            priorIndex = priorIndex + 1;
        }
        priorBuybackCode = buybackCode;
        buybackIndex = buybackIndex + 1;
    }
    if (<uint>state.entityKinds[entityIndex] == <uint>1) { return true; }
    if (<int>state.entityInventoryCopper[entityIndex] != 0 || start != end ||
        buybackStart != buybackEnd) { return false; }
    socket = 0;
    while (socket < m5InventoryRules.bagSockets()) {
        if (<uint>state.entityInventoryBagCodes[
                m5InventoryBagCodeIndex(entityIndex, socket)
            ] != <uint>0) {
            return false;
        }
        socket = socket + 1;
    }
    return true;
}

m5InventoryInsertStack(
    state: WorldState, entityIndex: int, stackIndex: int, itemCode: uint, count: int
): void {
    if (stackIndex < 0 || stackIndex > state.entityInventoryStackItemCodes.length ||
        !m5InventoryRules.itemCodeIsValid(itemCode) || count < 1) {
        throw "woc M5 inventory stack insertion is invalid";
    }
    state.entityInventoryStackItemCodes.add(<uint>0);
    state.entityInventoryStackCounts.add(0);
    state.entityInventoryStackManualSlots.add(-1);
    var copyIndex = state.entityInventoryStackItemCodes.length - 1;
    while (copyIndex > stackIndex) {
        state.entityInventoryStackItemCodes[copyIndex] =
            <uint>state.entityInventoryStackItemCodes[copyIndex - 1];
        state.entityInventoryStackCounts[copyIndex] =
            <int>state.entityInventoryStackCounts[copyIndex - 1];
        state.entityInventoryStackManualSlots[copyIndex] =
            <int>state.entityInventoryStackManualSlots[copyIndex - 1];
        copyIndex = copyIndex - 1;
    }
    state.entityInventoryStackItemCodes[stackIndex] = itemCode;
    state.entityInventoryStackCounts[stackIndex] = count;
    state.entityInventoryStackManualSlots[stackIndex] = -1;
    var offsetIndex = entityIndex + 1;
    while (offsetIndex < state.entityInventoryStackOffsets.length) {
        state.entityInventoryStackOffsets[offsetIndex] =
            <uint>state.entityInventoryStackOffsets[offsetIndex] + <uint>1;
        offsetIndex = offsetIndex + 1;
    }
}

m5InventoryRemoveStack(state: WorldState, entityIndex: int, stackIndex: int): void {
    state.entityInventoryStackItemCodes.removeAt(stackIndex);
    state.entityInventoryStackCounts.removeAt(stackIndex);
    state.entityInventoryStackManualSlots.removeAt(stackIndex);
    var offsetIndex = entityIndex + 1;
    while (offsetIndex < state.entityInventoryStackOffsets.length) {
        state.entityInventoryStackOffsets[offsetIndex] =
            <uint>state.entityInventoryStackOffsets[offsetIndex] - <uint>1;
        offsetIndex = offsetIndex + 1;
    }
}

pub m5InventoryItemCodeForId(itemId: string): uint {
    return m5InventoryRules.itemCodeForId(itemId);
}

pub m5InventoryItemCount(state: WorldState, entityIndex: int, itemCode: uint): int {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        !m5InventoryRules.itemCodeIsValid(itemCode)) {
        return 0;
    }
    var start = <int><uint>state.entityInventoryStackOffsets[entityIndex];
    var end = <int><uint>state.entityInventoryStackOffsets[entityIndex + 1];
    var total = 0;
    var stackIndex = start;
    while (stackIndex < end) {
        if (<uint>state.entityInventoryStackItemCodes[stackIndex] == itemCode) {
            total = total + <int>state.entityInventoryStackCounts[stackIndex];
        }
        stackIndex = stackIndex + 1;
    }
    return total;
}

pub m5InventoryUsedSlots(state: WorldState, entityIndex: int): int {
    if (!m5InventoryStateIsValid(state, entityIndex)) { return 0; }
    return <int><uint>state.entityInventoryStackOffsets[entityIndex + 1] -
        <int><uint>state.entityInventoryStackOffsets[entityIndex];
}

pub m5InventoryCapacity(state: WorldState, entityIndex: int): int {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1) {
        return 0;
    }
    var capacity = m5InventoryRules.backpackSlots();
    var socket = 0;
    while (socket < m5InventoryRules.bagSockets()) {
        capacity = capacity + m5InventoryRules.bagSlotsForCode(
            <uint>state.entityInventoryBagCodes[m5InventoryBagCodeIndex(entityIndex, socket)]
        );
        socket = socket + 1;
    }
    return capacity;
}

m5InventoryLayoutCellIndices(
    state: WorldState, entityIndex: int
): container.Array<int> {
    var capacity = m5InventoryCapacity(state, entityIndex);
    var cells = new container.Array<int>();
    var cellIndex = 0;
    while (cellIndex < capacity) {
        cells.add(-1);
        cellIndex = cellIndex + 1;
    }
    var start = <int><uint>state.entityInventoryStackOffsets[entityIndex];
    var end = <int><uint>state.entityInventoryStackOffsets[entityIndex + 1];
    var unplaced = new container.Array<int>();
    var stackIndex = start;
    while (stackIndex < end) {
        var localIndex = stackIndex - start;
        var hint = <int>state.entityInventoryStackManualSlots[stackIndex];
        if (hint >= 0 && hint < cells.length && <int>cells[hint] == -1) {
            cells[hint] = localIndex;
        } else {
            unplaced.add(localIndex);
        }
        stackIndex = stackIndex + 1;
    }
    var nextFree = 0;
    var unplacedOffset = 0;
    while (unplacedOffset < unplaced.length) {
        while (nextFree < cells.length && <int>cells[nextFree] != -1) {
            nextFree = nextFree + 1;
        }
        if (nextFree >= cells.length) {
            cells.add(<int>unplaced[unplacedOffset]);
        } else {
            cells[nextFree] = <int>unplaced[unplacedOffset];
        }
        unplacedOffset = unplacedOffset + 1;
    }
    return cells;
}

pub moveM5InventoryStackToCell(
    state: WorldState, entityIndex: int, from: int, to: int
): bool {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1) {
        return false;
    }
    var start = <int><uint>state.entityInventoryStackOffsets[entityIndex];
    var stackCount = <int><uint>state.entityInventoryStackOffsets[entityIndex + 1] - start;
    var capacity = m5InventoryCapacity(state, entityIndex);
    if (from < 0 || from >= stackCount || to < 0 || to >= capacity) {
        return false;
    }
    var cells = m5InventoryLayoutCellIndices(state, entityIndex);
    var fromCell = -1;
    var cellIndex = 0;
    while (cellIndex < cells.length) {
        if (<int>cells[cellIndex] == from) {
            fromCell = cellIndex;
            break;
        }
        cellIndex = cellIndex + 1;
    }
    if (fromCell < 0 || fromCell == to) { return false; }
    var displaced = <int>cells[to];
    cellIndex = 0;
    while (cellIndex < cells.length) {
        var localIndex = <int>cells[cellIndex];
        if (localIndex >= 0) {
            state.entityInventoryStackManualSlots[start + localIndex] = cellIndex;
        }
        cellIndex = cellIndex + 1;
    }
    state.entityInventoryStackManualSlots[start + from] = to;
    if (displaced >= 0) {
        state.entityInventoryStackManualSlots[start + displaced] = fromCell;
    }
    return true;
}

m5InventoryCapacityWithBag(
    state: WorldState, entityIndex: int, socket: int, itemCode: uint
): int {
    var capacity = m5InventoryRules.backpackSlots();
    var socketIndex = 0;
    while (socketIndex < m5InventoryRules.bagSockets()) {
        var code = socketIndex == socket ? itemCode :
            <uint>state.entityInventoryBagCodes[m5InventoryBagCodeIndex(entityIndex, socketIndex)];
        capacity = capacity + m5InventoryRules.bagSlotsForCode(code);
        socketIndex = socketIndex + 1;
    }
    return capacity;
}

pub m5InventoryCanAddItem(
    state: WorldState, entityIndex: int, itemCode: uint, requestedCount: int
): bool {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1 ||
        !m5InventoryRules.itemCodeIsValid(itemCode) || requestedCount < 0) {
        return false;
    }
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    var stackLimit = m5InventoryRules.stackLimitForItemIndex(itemIndex);
    var room = 0;
    var stackIndex = <int><uint>state.entityInventoryStackOffsets[entityIndex];
    var end = <int><uint>state.entityInventoryStackOffsets[entityIndex + 1];
    while (stackIndex < end) {
        if (<uint>state.entityInventoryStackItemCodes[stackIndex] == itemCode &&
            <int>state.entityInventoryStackCounts[stackIndex] < stackLimit) {
            room = room + stackLimit - <int>state.entityInventoryStackCounts[stackIndex];
        }
        stackIndex = stackIndex + 1;
    }
    var freeSlots = m5InventoryCapacity(state, entityIndex) - m5InventoryUsedSlots(state, entityIndex);
    if (freeSlots > 0) { room = room + freeSlots * stackLimit; }
    return room >= requestedCount;
}

// Like the target's addStacked path, this deliberately does not enforce the
// capacity gate. Command reducers must ask m5InventoryCanAddItem first; forced
// grants retain overflow rather than silently destroying an award.
pub grantM5InventoryItem(
    state: WorldState, entityIndex: int, itemCode: uint, count: int
): void {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1 ||
        !m5InventoryRules.itemCodeIsValid(itemCode) || count < 0) {
        throw "woc M5 inventory grant is invalid";
    }
    if (count == 0) { return; }
    var stackLimit = m5InventoryRules.stackLimitForItemIndex(
        m5InventoryRules.itemIndexFromCode(itemCode)
    );
    var remaining = count;
    var stackIndex = <int><uint>state.entityInventoryStackOffsets[entityIndex];
    var end = <int><uint>state.entityInventoryStackOffsets[entityIndex + 1];
    while (stackIndex < end && remaining > 0) {
        if (<uint>state.entityInventoryStackItemCodes[stackIndex] == itemCode &&
            <int>state.entityInventoryStackCounts[stackIndex] < stackLimit) {
            var room = stackLimit - <int>state.entityInventoryStackCounts[stackIndex];
            var take = remaining < room ? remaining : room;
            state.entityInventoryStackCounts[stackIndex] =
                <int>state.entityInventoryStackCounts[stackIndex] + take;
            remaining = remaining - take;
        }
        stackIndex = stackIndex + 1;
    }
    while (remaining > 0) {
        var fresh = remaining < stackLimit ? remaining : stackLimit;
        m5InventoryInsertStack(
            state, entityIndex,
            <int><uint>state.entityInventoryStackOffsets[entityIndex + 1], itemCode, fresh
        );
        remaining = remaining - fresh;
    }
    markOfflineM5ItemDiscovered(state, entityIndex, itemCode);
    syncOfflineQuestBoarHidesFromInventory(state);
}

// Exact source order: walk the dense inventory tail first, including every
// currently representable plain stack. Instance payloads remain outside this
// compact scalar partition until ZrVM can persist their structured values.
pub removeM5InventoryItem(
    state: WorldState, entityIndex: int, itemCode: uint, count: int
): int {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1 ||
        !m5InventoryRules.itemCodeIsValid(itemCode) || count <= 0) {
        return 0;
    }
    var remaining = count;
    var stackIndex = <int><uint>state.entityInventoryStackOffsets[entityIndex + 1] - 1;
    var start = <int><uint>state.entityInventoryStackOffsets[entityIndex];
    while (stackIndex >= start && remaining > 0) {
        if (<uint>state.entityInventoryStackItemCodes[stackIndex] == itemCode) {
            var available = <int>state.entityInventoryStackCounts[stackIndex];
            var take = remaining < available ? remaining : available;
            state.entityInventoryStackCounts[stackIndex] = available - take;
            remaining = remaining - take;
            if (<int>state.entityInventoryStackCounts[stackIndex] <= 0) {
                m5InventoryRemoveStack(state, entityIndex, stackIndex);
            }
        }
        stackIndex = stackIndex - 1;
    }
    syncOfflineQuestBoarHidesFromInventory(state);
    return count - remaining;
}

pub setM5InventoryCopper(state: WorldState, entityIndex: int, copper: int): void {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1 || copper < 0) {
        throw "woc M5 inventory currency is invalid";
    }
    state.entityInventoryCopper[entityIndex] = copper;
}

m5VendorBuybackInsert(
    state: WorldState, entityIndex: int, buybackIndex: int, itemCode: uint, count: int
): void {
    if (buybackIndex < 0 || buybackIndex > state.entityVendorBuybackItemCodes.length ||
        !m5InventoryRules.itemCodeIsValid(itemCode) || count < 1 || count > 65535) {
        throw "woc M5 vendor buyback insertion is invalid";
    }
    state.entityVendorBuybackItemCodes.add(<uint>0);
    state.entityVendorBuybackCounts.add(0);
    var copyIndex = state.entityVendorBuybackItemCodes.length - 1;
    while (copyIndex > buybackIndex) {
        state.entityVendorBuybackItemCodes[copyIndex] =
            <uint>state.entityVendorBuybackItemCodes[copyIndex - 1];
        state.entityVendorBuybackCounts[copyIndex] =
            <int>state.entityVendorBuybackCounts[copyIndex - 1];
        copyIndex = copyIndex - 1;
    }
    state.entityVendorBuybackItemCodes[buybackIndex] = itemCode;
    state.entityVendorBuybackCounts[buybackIndex] = count;
    var offsetIndex = entityIndex + 1;
    while (offsetIndex < state.entityVendorBuybackOffsets.length) {
        state.entityVendorBuybackOffsets[offsetIndex] =
            <uint>state.entityVendorBuybackOffsets[offsetIndex] + <uint>1;
        offsetIndex = offsetIndex + 1;
    }
}

m5VendorBuybackRemove(state: WorldState, entityIndex: int, buybackIndex: int): void {
    if (buybackIndex < <int><uint>state.entityVendorBuybackOffsets[entityIndex] ||
        buybackIndex >= <int><uint>state.entityVendorBuybackOffsets[entityIndex + 1]) {
        throw "woc M5 vendor buyback removal is invalid";
    }
    state.entityVendorBuybackItemCodes.removeAt(buybackIndex);
    state.entityVendorBuybackCounts.removeAt(buybackIndex);
    var offsetIndex = entityIndex + 1;
    while (offsetIndex < state.entityVendorBuybackOffsets.length) {
        state.entityVendorBuybackOffsets[offsetIndex] =
            <uint>state.entityVendorBuybackOffsets[offsetIndex] - <uint>1;
        offsetIndex = offsetIndex + 1;
    }
}

m5VendorRecordBuyback(
    state: WorldState, entityIndex: int, itemCode: uint, count: int
): void {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1 ||
        !m5InventoryRules.itemCodeIsValid(itemCode) || count < 1) {
        throw "woc M5 vendor buyback record is invalid";
    }
    var start = <int><uint>state.entityVendorBuybackOffsets[entityIndex];
    var end = <int><uint>state.entityVendorBuybackOffsets[entityIndex + 1];
    var existing = -1;
    var index = start;
    while (index < end) {
        if (<uint>state.entityVendorBuybackItemCodes[index] == itemCode) {
            existing = index;
        }
        index = index + 1;
    }
    var total = count;
    if (existing >= 0) {
        total = total + <int>state.entityVendorBuybackCounts[existing];
        m5VendorBuybackRemove(state, entityIndex, existing);
    }
    if (total > 65535) {
        throw "woc M5 vendor buyback count exceeds WOS limit";
    }
    start = <int><uint>state.entityVendorBuybackOffsets[entityIndex];
    m5VendorBuybackInsert(state, entityIndex, start, itemCode, total);
    end = <int><uint>state.entityVendorBuybackOffsets[entityIndex + 1];
    if (end - start > 12) {
        m5VendorBuybackRemove(state, entityIndex, end - 1);
    }
}

m5VendorBuybackAvailable(state: WorldState, entityIndex: int, itemCode: uint): bool {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        !m5InventoryRules.itemCodeIsValid(itemCode)) {
        return false;
    }
    var index = <int><uint>state.entityVendorBuybackOffsets[entityIndex];
    var end = <int><uint>state.entityVendorBuybackOffsets[entityIndex + 1];
    while (index < end) {
        if (<uint>state.entityVendorBuybackItemCodes[index] == itemCode &&
            <int>state.entityVendorBuybackCounts[index] > 0) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

m5VendorTakeBuyback(state: WorldState, entityIndex: int, itemCode: uint): bool {
    var index = <int><uint>state.entityVendorBuybackOffsets[entityIndex];
    var end = <int><uint>state.entityVendorBuybackOffsets[entityIndex + 1];
    while (index < end) {
        if (<uint>state.entityVendorBuybackItemCodes[index] == itemCode) {
            var nextCount = <int>state.entityVendorBuybackCounts[index] - 1;
            if (nextCount < 0) { throw "woc M5 vendor buyback count is invalid"; }
            if (nextCount == 0) {
                m5VendorBuybackRemove(state, entityIndex, index);
            } else {
                state.entityVendorBuybackCounts[index] = nextCount;
            }
            return true;
        }
        index = index + 1;
    }
    return false;
}

// The generated content module exposes UTF-8 bytes as scalar queries. This
// keeps payload parsing in WorldState and avoids crossing the unsafe ZrVM
// mutable-Array module ABI merely to construct a temporary string.
m5InventoryItemCodeFromPayload(
    payloadOffset: uint, itemLength: uint, payloadBytes: container.Array<uint>
): uint {
    var catalog = %import("generated/m5_content_catalog");
    var itemIndex = 0;
    while (itemIndex < catalog.count("item")) {
        if (catalog.itemIdUtf8Length(itemIndex) == <int>itemLength) {
            var matched = true;
            var byteIndex: uint = <uint>0;
            while (byteIndex < itemLength) {
                if (<uint>payloadBytes[<int>(payloadOffset + byteIndex)] !=
                    catalog.itemIdUtf8Byte(itemIndex, <int>byteIndex)) {
                    matched = false;
                }
                byteIndex = byteIndex + <uint>1;
            }
            if (matched) { return <uint>(itemIndex + 1); }
        }
        itemIndex = itemIndex + 1;
    }
    return <uint>0;
}

heroicVendorStaticNpcIndex(): int {
    var catalog = %import("generated/m5_content_catalog");
    var index = 0;
    while (index < npcPlacement.staticNpcCount(true)) {
        if (npcPlacement.staticNpcId(index, true) == catalog.heroicVendorNpcId()) {
            return index;
        }
        index = index + 1;
    }
    throw "woc Heroic Quartermaster is absent from the source roster";
}

heroicVendorInRange(state: WorldState, actorIndex: int): bool {
    var expectedTemplate = <uint>(heroicVendorStaticNpcIndex() + 1);
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>3 &&
            <uint>state.entityTemplates[index] == expectedTemplate) {
            var dx = <float>state.entityX[actorIndex] - <float>state.entityX[index];
            var dz = <float>state.entityZ[actorIndex] - <float>state.entityZ[index];
            if (dx * dx + dz * dz <= 49.0) { return true; }
        }
        index = index + 1;
    }
    return false;
}

heroicVendorOfferIndexForItemIndex(itemIndex: int): int {
    var catalog = %import("generated/m5_content_catalog");
    var offerIndex = 0;
    while (offerIndex < catalog.heroicVendorOfferCount()) {
        if (catalog.heroicVendorOfferItemIndex(offerIndex) == itemIndex) {
            return offerIndex;
        }
        offerIndex = offerIndex + 1;
    }
    return -1;
}

applyHeroicVendorBuyCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>4 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc heroic-buy payload is truncated";
    }
    var itemLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (itemLength > <uint>256 || payloadLength != itemLength + <uint>4) {
        throw "woc heroic-buy item payload is invalid";
    }
    var itemCode = m5InventoryItemCodeFromPayload(
        payloadOffset + <uint>4, itemLength, payloadBytes
    );
    if (itemCode == <uint>0) { return; }
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    var offerIndex = heroicVendorOfferIndexForItemIndex(itemIndex);
    if (offerIndex < 0) { return; }
    if (<bool>state.entityDead[actorIndex]) { return; }
    if (!heroicVendorInRange(state, actorIndex)) { return; }

    var catalog = %import("generated/m5_content_catalog");
    var marks = catalog.heroicVendorOfferMarks(offerIndex);
    var markCode = m5InventoryItemCodeForId(catalog.heroicVendorCurrencyItemId());
    if (m5InventoryItemCount(state, actorIndex, markCode) < marks) { return; }
    // Match source order: full bags are rejected before the currency debit.
    if (!m5InventoryCanAddItem(state, actorIndex, itemCode, 1)) { return; }
    if (removeM5InventoryItem(state, actorIndex, markCode, marks) != marks) {
        throw "woc Heroic Mark balance changed during purchase";
    }
    grantM5InventoryItem(state, actorIndex, itemCode, 1);
    // The source vendor event remains presentation-host output; inventory is
    // the complete authoritative mutation owned by this transaction.
}

delveShopIndexFromPayload(
    payloadOffset: uint, idLength: uint, payloadBytes: container.Array<uint>
): int {
    var catalog = %import("generated/m5_content_catalog");
    var shopIndex = 0;
    while (shopIndex < catalog.delveShopCount()) {
        if (catalog.delveShopIdUtf8Length(shopIndex) == <int>idLength) {
            var matched = true;
            var byteIndex: uint = <uint>0;
            while (byteIndex < idLength) {
                if (<uint>payloadBytes[<int>(payloadOffset + byteIndex)] !=
                    catalog.delveShopIdUtf8Byte(shopIndex, <int>byteIndex)) {
                    matched = false;
                }
                byteIndex = byteIndex + <uint>1;
            }
            if (matched) { return shopIndex; }
        }
        shopIndex = shopIndex + 1;
    }
    return -1;
}

delveShopOfferIndexForItemIndex(shopIndex: int, itemIndex: int): int {
    var catalog = %import("generated/m5_content_catalog");
    var offerIndex = 0;
    while (offerIndex < catalog.delveShopOfferCount(shopIndex)) {
        if (catalog.delveShopOfferItemIndex(shopIndex, offerIndex) == itemIndex) {
            return offerIndex;
        }
        offerIndex = offerIndex + 1;
    }
    return -1;
}

delveShopInRange(state: WorldState, actorIndex: int, shopIndex: int): bool {
    var catalog = %import("generated/m5_content_catalog");
    var dx = <float>state.entityX[actorIndex] - catalog.delveShopDoorX(shopIndex);
    var dz = <float>state.entityZ[actorIndex] - catalog.delveShopDoorZ(shopIndex);
    return dx * dx + dz * dz <= 144.0;
}

delveShopOfferGateMet(
    state: WorldState, actorIndex: int, shopIndex: int, offerIndex: int
): bool {
    var catalog = %import("generated/m5_content_catalog");
    var gateKind = catalog.delveShopOfferGateKind(shopIndex, offerIndex);
    if (gateKind == 1) { return true; }
    var clearIndex = delveShopClearIndex(actorIndex, shopIndex);
    if (gateKind == 2) {
        var totalClears = <int>state.entityDelveShopNormalClears[clearIndex] +
            <int>state.entityDelveShopHeroicClears[clearIndex] +
            <int>state.entityDelveShopOtherClears[clearIndex];
        return totalClears >=
            catalog.delveShopOfferRequiredClears(shopIndex, offerIndex);
    }
    if (gateKind == 3) {
        return <int>state.entityDelveShopHeroicClears[clearIndex] > 0;
    }
    throw "woc Delve shop offer gate is unknown";
}

applyDelveShopBuyCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (!delveBuyPayloadShapeIsValid(payloadOffset, payloadLength, payloadBytes)) {
        throw "woc delve-buy payload shape is invalid";
    }
    var delveLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    var itemLengthOffset = payloadOffset + <uint>4 + delveLength;
    var itemLength: uint = <uint>payloadBytes[<int>itemLengthOffset] +
        <uint>payloadBytes[<int>(itemLengthOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(itemLengthOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(itemLengthOffset + <uint>3)] * <uint>16777216;
    var shopIndex = delveShopIndexFromPayload(
        payloadOffset + <uint>4, delveLength, payloadBytes
    );
    var itemCode = m5InventoryItemCodeFromPayload(
        itemLengthOffset + <uint>4, itemLength, payloadBytes
    );
    if (shopIndex < 0 || itemCode == <uint>0) { return; }
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    var offerIndex = delveShopOfferIndexForItemIndex(shopIndex, itemIndex);
    if (offerIndex < 0) { return; }
    if (<bool>state.entityDead[actorIndex]) { return; }
    if (!delveShopInRange(state, actorIndex, shopIndex)) { return; }
    if (!delveShopOfferGateMet(state, actorIndex, shopIndex, offerIndex)) { return; }

    var catalog = %import("generated/m5_content_catalog");
    var marks = catalog.delveShopOfferMarks(shopIndex, offerIndex);
    if (<int>state.entityDelveMarks[actorIndex] < marks) { return; }
    state.entityDelveMarks[actorIndex] =
        <int>state.entityDelveMarks[actorIndex] - marks;
    // Source Sim.addItem is force-granting: no bag-capacity gate precedes it.
    grantM5InventoryItem(state, actorIndex, itemCode, 1);
}

delveBuyPayloadShapeIsValid(
    payloadOffset: uint, payloadLength: uint, payloadBytes: container.Array<uint>
): bool {
    if (payloadLength < <uint>8 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        return false;
    }
    var delveLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (delveLength > <uint>256 || delveLength > payloadLength - <uint>8) {
        return false;
    }
    var itemLengthOffset = payloadOffset + <uint>4 + delveLength;
    var itemLength: uint = <uint>payloadBytes[<int>itemLengthOffset] +
        <uint>payloadBytes[<int>(itemLengthOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(itemLengthOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(itemLengthOffset + <uint>3)] * <uint>16777216;
    return itemLength <= <uint>256 &&
        payloadLength == <uint>8 + delveLength + itemLength;
}

companionUpgradePayloadShapeIsValid(
    payloadOffset: uint, payloadLength: uint, payloadBytes: container.Array<uint>
): bool {
    if (payloadLength < <uint>4 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        return false;
    }
    var companionLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    return companionLength <= <uint>256 &&
        payloadLength == companionLength + <uint>4;
}

delveCompanionIndexFromPayload(
    payloadOffset: uint, companionLength: uint,
    payloadBytes: container.Array<uint>
): int {
    var companionIndex = 0;
    while (companionIndex < delveCompanionContent.companionCount(true)) {
        if (delveCompanionContent.companionIdUtf8Length(companionIndex, true) ==
            <int>companionLength) {
            var matched = true;
            var byteIndex: uint = <uint>0;
            while (byteIndex < companionLength) {
                if (<uint>payloadBytes[<int>(payloadOffset + byteIndex)] !=
                    delveCompanionContent.companionIdUtf8Byte(
                        companionIndex, <int>byteIndex, true
                    )) {
                    matched = false;
                }
                byteIndex = byteIndex + <uint>1;
            }
            if (matched) { return companionIndex; }
        }
        companionIndex = companionIndex + 1;
    }
    return -1;
}

delveShopIndexForCompanion(companionIndex: int): int {
    var catalog = %import("generated/m5_content_catalog");
    var companionId = delveCompanionContent.companionId(companionIndex, true);
    var shopIndex = 0;
    while (shopIndex < catalog.delveShopCount()) {
        if (catalog.delveShopCompanionId(shopIndex) == companionId) {
            return shopIndex;
        }
        shopIndex = shopIndex + 1;
    }
    throw "woc Delve companion has no source door";
}

applyCompanionUpgradeDeeds(
    state: WorldState, actorIndex: int, companionIndex: int
): void {
    if (actorIndex != offlineQuestPrimaryPlayerIndex(state)) { return; }
    var rankIndex = delveCompanionRankIndex(actorIndex, companionIndex);
    if (<int>state.entityDelveCompanionRanks[rankIndex] !=
        delveCompanionContent.maxRank(true)) {
        return;
    }
    earnOfflineDeedById(state, "dlv_companion_max");
    var allMaximum = true;
    var candidateIndex = 0;
    while (candidateIndex < delveCompanionContent.companionCount(true)) {
        if (<int>state.entityDelveCompanionRanks[
            delveCompanionRankIndex(actorIndex, candidateIndex)
        ] != delveCompanionContent.maxRank(true)) {
            allMaximum = false;
        }
        candidateIndex = candidateIndex + 1;
    }
    if (allMaximum) {
        earnOfflineDeedById(state, "dlv_companions_both");
    }
}

evaluateOfflineCompanionUpgradeDeeds(state: WorldState): void {
    var actorIndex = offlineQuestPrimaryPlayerIndex(state);
    if (actorIndex < 0) { return; }
    var companionIndex = 0;
    while (companionIndex < delveCompanionContent.companionCount(true)) {
        applyCompanionUpgradeDeeds(state, actorIndex, companionIndex);
        companionIndex = companionIndex + 1;
    }
}

applyDelveCompanionUpgradeCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (!companionUpgradePayloadShapeIsValid(
        payloadOffset, payloadLength, payloadBytes
    )) {
        throw "woc companion-upgrade payload shape is invalid";
    }
    var companionLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    var companionIndex = delveCompanionIndexFromPayload(
        payloadOffset + <uint>4, companionLength, payloadBytes
    );
    if (companionIndex < 0 ||
        <uint>state.entityKinds[actorIndex] != <uint>1) { return; }
    var shopIndex = delveShopIndexForCompanion(companionIndex);
    if (<bool>state.entityDead[actorIndex]) { return; }
    if (!delveShopInRange(state, actorIndex, shopIndex)) { return; }
    var rankIndex = delveCompanionRankIndex(actorIndex, companionIndex);
    var currentRank = <int>state.entityDelveCompanionRanks[rankIndex];
    if (currentRank >= delveCompanionContent.maxRank(true)) { return; }
    var nextRank = currentRank + 1;
    var marks = delveCompanionContent.upgradeMarks(nextRank, true);
    var copper = delveCompanionContent.upgradeCopper(nextRank, true);
    if (<int>state.entityDelveMarks[actorIndex] < marks) { return; }
    if (<int>state.entityInventoryCopper[actorIndex] < copper) { return; }
    state.entityDelveMarks[actorIndex] =
        <int>state.entityDelveMarks[actorIndex] - marks;
    state.entityInventoryCopper[actorIndex] =
        <int>state.entityInventoryCopper[actorIndex] - copper;
    state.entityDelveCompanionRanks[rankIndex] = nextRank;
    applyCompanionUpgradeDeeds(state, actorIndex, companionIndex);
}

m5VendorNpcIndex(state: WorldState, entityId: uint): int {
    var catalog = %import("generated/m5_content_catalog");
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityIds[index] == entityId &&
            <uint>state.entityKinds[index] == <uint>3) {
            var template = <uint>state.entityTemplates[index];
            var npcIndex = <int>template - 1;
            if (template == <uint>0 || npcIndex < 0 || npcIndex >= catalog.count("npc") ||
                !catalog.npcHasVendorStock(npcIndex)) {
                return -1;
            }
            return index;
        }
        index = index + 1;
    }
    return -1;
}

m5VendorInRange(state: WorldState, actorIndex: int): bool {
    var catalog = %import("generated/m5_content_catalog");
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>3) {
            var template = <uint>state.entityTemplates[index];
            var npcIndex = <int>template - 1;
            if (template != <uint>0 && npcIndex >= 0 && npcIndex < catalog.count("npc") &&
                catalog.npcHasVendorStock(npcIndex)) {
                var dx = <float>state.entityX[actorIndex] - <float>state.entityX[index];
                var dz = <float>state.entityZ[actorIndex] - <float>state.entityZ[index];
                if (dx * dx + dz * dz <= 49.0) { return true; }
            }
        }
        index = index + 1;
    }
    return false;
}

applyM5VendorBuyCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>5 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc M5 vendor buy payload is truncated";
    }
    var itemLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (itemLength > <uint>256 || itemLength > payloadLength - <uint>5) {
        throw "woc M5 vendor buy item payload is invalid";
    }
    var itemOffset = payloadOffset + <uint>4;
    var presenceOffset = itemOffset + itemLength;
    var trailing = payloadLength - <uint>4 - itemLength;
    var presence = <uint>payloadBytes[<int>presenceOffset];
    if (presence > <uint>1 ||
        (presence == <uint>0 && trailing != <uint>1) ||
        (presence == <uint>1 && trailing != <uint>9)) {
        throw "woc M5 vendor buy presence is invalid";
    }
    if (presence != <uint>1) { return; }
    var npcId: uint = <uint>payloadBytes[<int>(presenceOffset + <uint>1)] +
        <uint>payloadBytes[<int>(presenceOffset + <uint>2)] * <uint>256 +
        <uint>payloadBytes[<int>(presenceOffset + <uint>3)] * <uint>65536 +
        <uint>payloadBytes[<int>(presenceOffset + <uint>4)] * <uint>16777216 +
        <uint>payloadBytes[<int>(presenceOffset + <uint>5)] * <uint>4294967296 +
        <uint>payloadBytes[<int>(presenceOffset + <uint>6)] * <uint>1099511627776 +
        <uint>payloadBytes[<int>(presenceOffset + <uint>7)] * <uint>281474976710656 +
        <uint>payloadBytes[<int>(presenceOffset + <uint>8)] * <uint>72057594037927936;
    var itemCode = m5InventoryItemCodeFromPayload(itemOffset, itemLength, payloadBytes);
    var npcEntityIndex = m5VendorNpcIndex(state, npcId);
    if (itemCode == <uint>0 || npcEntityIndex < 0 || <bool>state.entityDead[actorIndex]) {
        return;
    }
    var catalog = %import("generated/m5_content_catalog");
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    var npcCatalogIndex = <int><uint>state.entityTemplates[npcEntityIndex] - 1;
    if (itemIndex < 0 || !catalog.npcSells(
            npcCatalogIndex, catalog.text("item", itemIndex, "id")
        )) {
        return;
    }
    var dx = <float>state.entityX[actorIndex] - <float>state.entityX[npcEntityIndex];
    var dz = <float>state.entityZ[actorIndex] - <float>state.entityZ[npcEntityIndex];
    if (dx * dx + dz * dz > 49.0) { return; }
    var unitPrice = <int>catalog.metric("item", itemIndex, "buyValue");
    if (unitPrice <= 0) { return; }
    var quantity = m5VendorStack.vendorPurchaseQuantity(
        catalog.text("item", itemIndex, "kind")
    );
    var copperCost = unitPrice * quantity;
    if (<int>state.entityInventoryCopper[actorIndex] < copperCost ||
        !m5InventoryCanAddItem(state, actorIndex, itemCode, quantity)) {
        return;
    }
    state.entityInventoryCopper[actorIndex] =
        <int>state.entityInventoryCopper[actorIndex] - copperCost;
    grantM5InventoryItem(state, actorIndex, itemCode, quantity);
}

applyM5VendorSellCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>5 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc M5 vendor sell payload is truncated";
    }
    var itemLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (itemLength > <uint>256 || itemLength > payloadLength - <uint>5) {
        throw "woc M5 vendor sell item payload is invalid";
    }
    var itemOffset = payloadOffset + <uint>4;
    var presenceOffset = itemOffset + itemLength;
    var trailing = payloadLength - <uint>4 - itemLength;
    var presence = <uint>payloadBytes[<int>presenceOffset];
    if (presence > <uint>1 || (presence == <uint>0 && trailing != <uint>1) ||
        (presence == <uint>1 && trailing != <uint>5)) {
        throw "woc M5 vendor sell count payload is invalid";
    }
    var requested = 1;
    if (presence == <uint>1) {
        requested = <int><uint>payloadBytes[<int>(presenceOffset + <uint>1)] +
            <int><uint>payloadBytes[<int>(presenceOffset + <uint>2)] * 256 +
            <int><uint>payloadBytes[<int>(presenceOffset + <uint>3)] * 65536 +
            <int><uint>payloadBytes[<int>(presenceOffset + <uint>4)] * 16777216;
    }
    var itemCode = m5InventoryItemCodeFromPayload(itemOffset, itemLength, payloadBytes);
    if (itemCode == <uint>0 || <bool>state.entityDead[actorIndex] ||
        !m5VendorInRange(state, actorIndex)) {
        return;
    }
    var available = m5InventoryItemCount(state, actorIndex, itemCode);
    if (requested > available) { requested = available; }
    if (requested <= 0) { return; }
    var catalog = %import("generated/m5_content_catalog");
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    if (itemIndex < 0 || catalog.text("item", itemIndex, "kind") == "quest" ||
        catalog.flag("item", itemIndex, "noVendorSell") ||
        catalog.flag("item", itemIndex, "soulbound")) {
        return;
    }
    var removed = removeM5InventoryItem(state, actorIndex, itemCode, requested);
    if (removed <= 0) { return; }
    m5VendorRecordBuyback(state, actorIndex, itemCode, removed);
    state.entityInventoryCopper[actorIndex] =
        <int>state.entityInventoryCopper[actorIndex] +
        <int>catalog.metric("item", itemIndex, "sellValue") * removed;
}

applyM5VendorBuybackCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>4 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc M5 vendor buyback payload is truncated";
    }
    var itemLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (itemLength > <uint>256 || payloadLength != <uint>4 + itemLength) {
        throw "woc M5 vendor buyback item payload is invalid";
    }
    var itemCode = m5InventoryItemCodeFromPayload(
        payloadOffset + <uint>4, itemLength, payloadBytes
    );
    if (itemCode == <uint>0 || <bool>state.entityDead[actorIndex] ||
        !m5VendorInRange(state, actorIndex) ||
        !m5VendorBuybackAvailable(state, actorIndex, itemCode)) {
        return;
    }
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    var catalog = %import("generated/m5_content_catalog");
    var copperCost = <int>catalog.metric("item", itemIndex, "sellValue");
    if (<int>state.entityInventoryCopper[actorIndex] < copperCost ||
        !m5InventoryCanAddItem(state, actorIndex, itemCode, 1)) {
        return;
    }
    state.entityInventoryCopper[actorIndex] =
        <int>state.entityInventoryCopper[actorIndex] - copperCost;
    if (!m5VendorTakeBuyback(state, actorIndex, itemCode)) {
        throw "woc M5 vendor buyback availability changed";
    }
    grantM5InventoryItem(state, actorIndex, itemCode, 1);
}

applyM5VendorSellAllJunkCommand(state: WorldState, actorIndex: int): void {
    if (!m5InventoryStateIsValid(state, actorIndex) ||
        <bool>state.entityDead[actorIndex] || !m5VendorInRange(state, actorIndex)) {
        return;
    }
    var catalog = %import("generated/m5_content_catalog");
    var stackIndex = <int><uint>state.entityInventoryStackOffsets[actorIndex];
    while (stackIndex < <int><uint>state.entityInventoryStackOffsets[actorIndex + 1]) {
        var itemCode = <uint>state.entityInventoryStackItemCodes[stackIndex];
        var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
        if (itemIndex >= 0 && catalog.text("item", itemIndex, "quality") == "poor" &&
            catalog.text("item", itemIndex, "kind") != "quest" &&
            !catalog.flag("item", itemIndex, "noVendorSell") &&
            !catalog.flag("item", itemIndex, "soulbound")) {
            var count = <int>state.entityInventoryStackCounts[stackIndex];
            var removed = removeM5InventoryItem(state, actorIndex, itemCode, count);
            if (removed > 0) {
                m5VendorRecordBuyback(state, actorIndex, itemCode, removed);
                state.entityInventoryCopper[actorIndex] =
                    <int>state.entityInventoryCopper[actorIndex] +
                    <int>catalog.metric("item", itemIndex, "sellValue") * removed;
            }
        } else {
            stackIndex = stackIndex + 1;
        }
    }
}

pub equipM5InventoryBag(
    state: WorldState, entityIndex: int, itemCode: uint, requestedSocket: int
): bool {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1 ||
        !m5InventoryRules.bagCodeIsValid(itemCode) ||
        m5InventoryItemCount(state, entityIndex, itemCode) <= 0) {
        return false;
    }
    var socket = requestedSocket;
    if (socket < 0) {
        socket = 0;
        while (socket < m5InventoryRules.bagSockets() &&
            <uint>state.entityInventoryBagCodes[m5InventoryBagCodeIndex(entityIndex, socket)] !=
                <uint>0) {
            socket = socket + 1;
        }
    }
    if (socket < 0 || socket >= m5InventoryRules.bagSockets()) { return false; }
    var bagIndex = m5InventoryBagCodeIndex(entityIndex, socket);
    var oldItemCode = <uint>state.entityInventoryBagCodes[bagIndex];
    var afterSlots = m5InventoryUsedSlots(state, entityIndex) - 1 +
        (oldItemCode == <uint>0 ? 0 : 1);
    if (afterSlots > m5InventoryCapacityWithBag(state, entityIndex, socket, itemCode)) {
        return false;
    }
    if (removeM5InventoryItem(state, entityIndex, itemCode, 1) != 1) {
        throw "woc M5 inventory bag removal is invalid";
    }
    if (oldItemCode != <uint>0) {
        grantM5InventoryItem(state, entityIndex, oldItemCode, 1);
    }
    state.entityInventoryBagCodes[bagIndex] = itemCode;
    return m5InventoryStateIsValid(state, entityIndex);
}

pub unequipM5InventoryBag(state: WorldState, entityIndex: int, socket: int): bool {
    if (!m5InventoryStateIsValid(state, entityIndex) ||
        <uint>state.entityKinds[entityIndex] != <uint>1 || socket < 0 ||
        socket >= m5InventoryRules.bagSockets()) {
        return false;
    }
    var bagIndex = m5InventoryBagCodeIndex(entityIndex, socket);
    var itemCode = <uint>state.entityInventoryBagCodes[bagIndex];
    if (itemCode == <uint>0 || m5InventoryUsedSlots(state, entityIndex) + 1 >
        m5InventoryCapacityWithBag(state, entityIndex, socket, <uint>0)) {
        return false;
    }
    state.entityInventoryBagCodes[bagIndex] = <uint>0;
    grantM5InventoryItem(state, entityIndex, itemCode, 1);
    return true;
}

m5EquipmentStateForRow(state: WorldState, index: int): m5Equipment.M5EquipmentState {
    if (index < 0 || index >= state.entityIds.length ||
        state.entityM5HelmetItemCodes.length != state.entityIds.length ||
        state.entityM5FeetItemCodes.length != state.entityIds.length ||
        state.entityM5MainhandItemCodes.length != state.entityIds.length) {
        throw "woc M5 equipment row is invalid";
    }
    var equipment = new m5Equipment.M5EquipmentState();
    equipment.helmetItemIndex = m5Equipment.storedItemCodeToIndex(
        "helmet", <uint>state.entityM5HelmetItemCodes[index]
    );
    equipment.feetItemIndex = m5Equipment.storedItemCodeToIndex(
        "feet", <uint>state.entityM5FeetItemCodes[index]
    );
    equipment.mainhandItemIndex = m5Equipment.storedItemCodeToIndex(
        "mainhand", <uint>state.entityM5MainhandItemCodes[index]
    );
    return equipment;
}

m5EquipmentStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length ||
        state.entityM5HelmetItemCodes.length != state.entityIds.length ||
        state.entityM5FeetItemCodes.length != state.entityIds.length ||
        state.entityM5MainhandItemCodes.length != state.entityIds.length ||
        !m5Equipment.storedItemCodeIsValidForSlot(
            "helmet", <uint>state.entityM5HelmetItemCodes[index]
        ) || !m5Equipment.storedItemCodeIsValidForSlot(
            "feet", <uint>state.entityM5FeetItemCodes[index]
        ) || !m5Equipment.storedItemCodeIsValidForSlot(
            "mainhand", <uint>state.entityM5MainhandItemCodes[index]
        )) {
        return false;
    }
    var profileCode = <uint>state.entityBaselineStatProfileCodes[index];
    if (profileCode == <uint>0) {
        return <uint>state.entityM5HelmetItemCodes[index] == <uint>0 &&
            <uint>state.entityM5FeetItemCodes[index] == <uint>0 &&
            <uint>state.entityM5MainhandItemCodes[index] == <uint>0;
    }
    var classIndex = <int>profileCode - 1;
    var equipment = m5EquipmentStateForRow(state, index);
    return m5Equipment.stateIsValid(equipment) &&
        (equipment.helmetItemIndex < 0 ||
            m5Equipment.canEquipForClass(classIndex, equipment.helmetItemIndex)) &&
        (equipment.feetItemIndex < 0 ||
            m5Equipment.canEquipForClass(classIndex, equipment.feetItemIndex)) &&
        (equipment.mainhandItemIndex < 0 ||
            m5Equipment.canEquipForClass(classIndex, equipment.mainhandItemIndex));
}

baselineStatProfileStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length ||
        state.entityBaselineStatProfileCodes.length != state.entityIds.length) {
        return false;
    }
    var profileCode = <uint>state.entityBaselineStatProfileCodes[index];
    return playerStatInputs.baselineProfileCodeIsValid(profileCode) &&
        m5EquipmentStateIsValid(state, index) &&
        (profileCode == <uint>0 || (<uint>state.entityKinds[index] == <uint>1 &&
            <int>state.entityLevels[index] >= 1 &&
            <int>state.entityLevels[index] <= playerStatInputs.baselineLevelCap()));
}

setM5BaselineStatProfile(state: WorldState, index: int, classIndex: int): void {
    if (index < 0 || index >= state.entityIds.length ||
        <uint>state.entityKinds[index] != <uint>1 || classIndex < 0 ||
        classIndex >= playerStatInputs.baselineClassCount()) {
        throw "woc M5 baseline stat profile is invalid";
    }
    state.entityBaselineStatProfileCodes[index] = <uint>(classIndex + 1);
    refreshOfflineWeaponSkinForEntity(state, index);
}

m5EquipmentStoredCodeAt(state: WorldState, index: int, slot: string): uint {
    if (slot == "helmet") { return <uint>state.entityM5HelmetItemCodes[index]; }
    if (slot == "feet") { return <uint>state.entityM5FeetItemCodes[index]; }
    if (slot == "mainhand") { return <uint>state.entityM5MainhandItemCodes[index]; }
    throw "woc M5 equipment slot is invalid";
}

pub setM5EquipmentItemCode(
    state: WorldState, index: int, slot: string, itemCode: uint
): void {
    if (!baselineStatProfileStateIsValid(state, index) ||
        <uint>state.entityBaselineStatProfileCodes[index] == <uint>0 ||
        !m5Equipment.storedItemCodeIsValidForSlot(slot, itemCode)) {
        throw "woc M5 equipment assignment is invalid";
    }
    var itemIndex = m5Equipment.storedItemCodeToIndex(slot, itemCode);
    var classIndex = <int><uint>state.entityBaselineStatProfileCodes[index] - 1;
    if (itemIndex >= 0 && !m5Equipment.canEquipForClass(classIndex, itemIndex)) {
        throw "woc M5 equipment class admission is invalid";
    }
    if (slot == "helmet") {
        state.entityM5HelmetItemCodes[index] = itemCode;
    } else if (slot == "feet") {
        state.entityM5FeetItemCodes[index] = itemCode;
    } else if (slot == "mainhand") {
        state.entityM5MainhandItemCodes[index] = itemCode;
    } else {
        throw "woc M5 equipment slot is invalid";
    }
    if (!m5EquipmentStateIsValid(state, index)) {
        throw "woc M5 equipment state is invalid";
    }
    recomputeBaselineFormDerivedStats(state, index);
    refreshOfflineWeaponSkinForEntity(state, index);
}

// Source equipItem removes the selected bag copy first, then returns the
// displaced gear without applying a capacity gate. This scalar bridge covers
// M5's helmet, feet and mainhand slots; instances and the remaining source
// paperdoll slots require the structured-value persistence boundary.
pub equipM5InventoryItem(state: WorldState, index: int, itemCode: uint): bool {
    if (!m5InventoryStateIsValid(state, index) ||
        !baselineStatProfileStateIsValid(state, index) ||
        <uint>state.entityBaselineStatProfileCodes[index] == <uint>0 ||
        <uint>state.entityKinds[index] != <uint>1 ||
        m5InventoryItemCount(state, index, itemCode) <= 0) {
        return false;
    }
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    var slot = m5Equipment.slotForItemIndex(itemIndex);
    var classIndex = <int><uint>state.entityBaselineStatProfileCodes[index] - 1;
    if (slot == "" || !m5Equipment.canEquipForClass(classIndex, itemIndex) ||
        !m5Equipment.itemContributesAtLevel(<int>state.entityLevels[index], itemIndex)) {
        return false;
    }
    var oldItemCode = m5EquipmentStoredCodeAt(state, index, slot);
    if (slot == "mainhand" && oldItemCode == <uint>0) {
        oldItemCode = m5Equipment.startingMainhandStoredCode(classIndex);
    } else if (slot == "mainhand" &&
        oldItemCode == m5Equipment.emptyMainhandStoredCode()) {
        oldItemCode = <uint>0;
    }
    if (removeM5InventoryItem(state, index, itemCode, 1) != 1) {
        throw "woc M5 inventory equip removal is invalid";
    }
    if (oldItemCode != <uint>0) {
        grantM5InventoryItem(state, index, oldItemCode, 1);
    }
    setM5EquipmentItemCode(state, index, slot, itemCode);
    return true;
}

pub unequipM5InventoryItem(state: WorldState, index: int, slot: string): bool {
    if (!m5InventoryStateIsValid(state, index) ||
        !baselineStatProfileStateIsValid(state, index) ||
        <uint>state.entityBaselineStatProfileCodes[index] == <uint>0 ||
        <uint>state.entityKinds[index] != <uint>1) {
        return false;
    }
    var itemCode = m5EquipmentStoredCodeAt(state, index, slot);
    var classIndex = <int><uint>state.entityBaselineStatProfileCodes[index] - 1;
    if (slot == "mainhand" && itemCode == <uint>0) {
        itemCode = m5Equipment.startingMainhandStoredCode(classIndex);
    } else if (itemCode == <uint>0 ||
        (slot == "mainhand" && itemCode == m5Equipment.emptyMainhandStoredCode())) {
        return false;
    }
    if (!m5InventoryCanAddItem(state, index, itemCode, 1)) {
        return false;
    }
    var emptyCode = slot == "mainhand" ? m5Equipment.emptyMainhandStoredCode() : <uint>0;
    setM5EquipmentItemCode(state, index, slot, emptyCode);
    grantM5InventoryItem(state, index, itemCode, 1);
    return true;
}

// This bridge applies M5's complete starting-gear baseline plus its already
// persisted talent selection. A zero profile deliberately leaves existing final
// columns untouched until equipment instances and live aura inputs can be
// represented exactly.
baselineProfileDerivedStats(
    state: WorldState, index: int
): formDerivedStats.FormDerivedOutput {
    var profileCode = <uint>state.entityBaselineStatProfileCodes[index];
    var equipment = m5EquipmentStateForRow(state, index);
    return playerStatInputs.deriveBaselineWithTalentsAndEquipment(
        <int>profileCode - 1,
        <int>state.entityLevels[index],
        <uint>state.entityActiveFormAbilityCodes[index],
        equipment,
        <uint>state.entityTalentSpecCodes[index],
        talentRowCodeAt(state, index, 0),
        talentRowCodeAt(state, index, 1),
        talentRowCodeAt(state, index, 2),
        talentRowCodeAt(state, index, 3),
        talentRowCodeAt(state, index, 4),
        talentRowCodeAt(state, index, 5)
    );
}

recomputeBaselineFormDerivedStats(state: WorldState, index: int): void {
    if (!baselineStatProfileStateIsValid(state, index)) {
        throw "woc baseline stat profile state is invalid";
    }
    var profileCode = <uint>state.entityBaselineStatProfileCodes[index];
    if (profileCode == <uint>0) { return; }
    var previousMaximum = <int>state.entityMaxHp[index];
    var hpFraction = previousMaximum > 0 ?
        <float>state.entityHp[index] / <float>previousMaximum : 1.0;
    var previousResourceMaximum = <float>state.entityMaxResources[index];
    var resourceFraction = previousResourceMaximum > 0 ?
        <float>state.entityResources[index] / <float>previousResourceMaximum : 1.0;
    var derived = baselineProfileDerivedStats(state, index);
    state.entityAttackPower[index] = derived.attackPower;
    state.entityRangedPower[index] = derived.rangedPower;
    state.entitySpellPower[index] = derived.spellPower;
    state.entityArmor[index] = derived.armor;
    state.entityCritChance[index] = derived.critChance;
    state.entityDodgeChance[index] = derived.dodgeChance;
    state.entityHitBonus[index] = derived.hitBonus;
    state.entityCritDamagePhysicalBonus[index] = derived.physicalCritDamageBonus;
    state.entityMeleeHaste[index] = derived.meleeHaste;
    state.entityRangedHaste[index] = derived.rangedHaste;
    state.entitySpellHaste[index] = derived.spellHaste;
    var classIndex = <int>profileCode - 1;
    var equipment = m5EquipmentStateForRow(state, index);
    state.entityWeaponMinimum[index] = m5Equipment.weaponMinimum(
        classIndex, <int>state.entityLevels[index], equipment
    );
    state.entityWeaponMaximum[index] = m5Equipment.weaponMaximum(
        classIndex, <int>state.entityLevels[index], equipment
    );
    state.entityWeaponSpeed[index] = m5Equipment.weaponSpeed(
        classIndex, <int>state.entityLevels[index], equipment
    );
    state.entityMaxHp[index] = derived.maxHp;
    if (<bool>state.entityDead[index]) {
        state.entityHp[index] = 0;
    } else {
        var hp = statCoreRules.roundJs(<float>derived.maxHp * hpFraction);
        state.entityHp[index] = hp < 1 ? 1 : hp;
    }
    if (<uint>state.entityResourceKinds[index] == <uint>1) {
        state.entityMaxResources[index] = derived.maxMana;
        state.entityResources[index] = statCoreRules.roundJs(
            <float>derived.maxMana * resourceFraction
        );
    } else if (forms.isResourceBarShiftFormAbilityCode(
            <uint>state.entityActiveFormAbilityCodes[index]
        )) {
        state.entitySavedManaMaximums[index] = derived.maxMana;
    }
}

floatMatches(left: float, right: float): bool {
    var difference = left - right;
    if (difference < 0.0) { difference = -difference; }
    return difference <= 0.000001;
}

baselineStatProfileMatchesDerivedColumns(state: WorldState, index: int): bool {
    if (!baselineStatProfileStateIsValid(state, index)) { return false; }
    var profileCode = <uint>state.entityBaselineStatProfileCodes[index];
    if (profileCode == <uint>0) { return true; }
    var derived = baselineProfileDerivedStats(state, index);
    return <int>state.entityMaxHp[index] == derived.maxHp &&
        <int>state.entityWeaponMinimum[index] == m5Equipment.weaponMinimum(
            <int>profileCode - 1, <int>state.entityLevels[index],
            m5EquipmentStateForRow(state, index)
        ) &&
        <int>state.entityWeaponMaximum[index] == m5Equipment.weaponMaximum(
            <int>profileCode - 1, <int>state.entityLevels[index],
            m5EquipmentStateForRow(state, index)
        ) &&
        floatMatches(<float>state.entityWeaponSpeed[index], m5Equipment.weaponSpeed(
            <int>profileCode - 1, <int>state.entityLevels[index],
            m5EquipmentStateForRow(state, index)
        )) &&
        <int>state.entityAttackPower[index] == derived.attackPower &&
        <int>state.entityRangedPower[index] == derived.rangedPower &&
        <int>state.entitySpellPower[index] == derived.spellPower &&
        <int>state.entityArmor[index] == derived.armor &&
        floatMatches(<float>state.entityCritChance[index], derived.critChance) &&
        floatMatches(<float>state.entityDodgeChance[index], derived.dodgeChance) &&
        floatMatches(<float>state.entityHitBonus[index], derived.hitBonus) &&
        floatMatches(
            <float>state.entityCritDamagePhysicalBonus[index],
            derived.physicalCritDamageBonus
        ) &&
        floatMatches(<float>state.entityMeleeHaste[index], derived.meleeHaste) &&
        floatMatches(<float>state.entityRangedHaste[index], derived.rangedHaste) &&
        floatMatches(<float>state.entitySpellHaste[index], derived.spellHaste) &&
        (<uint>state.entityResourceKinds[index] != <uint>1 ||
            <float>state.entityMaxResources[index] == derived.maxMana) &&
        (!forms.isResourceBarShiftFormAbilityCode(
            <uint>state.entityActiveFormAbilityCodes[index]
        ) || <float>state.entitySavedManaMaximums[index] == derived.maxMana);
}

loadFormTransitionState(state: WorldState, index: int): formTransitions.FormTransitionState {
    var form = new formTransitions.FormTransitionState();
    form.activeFormAbilityCode = <uint>state.entityActiveFormAbilityCodes[index];
    form.resourceKind = <uint>state.entityResourceKinds[index];
    form.resource = <float>state.entityResources[index];
    form.resourceMaximum = <float>state.entityMaxResources[index];
    form.savedMana = <float>state.entitySavedMana[index];
    form.savedManaMaximum = <float>state.entitySavedManaMaximums[index];
    return form;
}

storeFormTransitionState(
    state: WorldState, index: int, form: formTransitions.FormTransitionState
): void {
    state.entityActiveFormAbilityCodes[index] = form.activeFormAbilityCode;
    state.entityResourceKinds[index] = form.resourceKind;
    state.entityResources[index] = form.resource;
    state.entityMaxResources[index] = form.resourceMaximum;
    state.entitySavedMana[index] = form.savedMana;
    state.entitySavedManaMaximums[index] = form.savedManaMaximum;
    recomputeBaselineFormDerivedStats(state, index);
}

formTransitionStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length) {
        return false;
    }
    var activeCode = <uint>state.entityActiveFormAbilityCodes[index];
    if (<uint>state.entityResourceKinds[index] == <uint>0) {
        return activeCode == <uint>0 && <float>state.entitySavedManaMaximums[index] == 0;
    }
    if (activeCode != <uint>0 && <uint>state.entityKinds[index] != <uint>1) {
        return false;
    }
    return formTransitions.stateIsValid(loadFormTransitionState(state, index));
}

motionAuraStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length ||
        state.entityMotionAuraOffsets.length != state.entityIds.length + 1) {
        return false;
    }
    var start = <int><uint>state.entityMotionAuraOffsets[index];
    var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
    return motionAuras.rowsAreValid(
        state.entityMotionAuraAbilityCodes,
        state.entityMotionAuraSourceIds,
        state.entityMotionAuraKindCodes,
        state.entityMotionAuraRemaining,
        start,
        end,
        true
    );
}

// WOS58's values are stored in a tail so historical entity rows stay readable.
// A zero scale preserves the classic immediate break-on-damage behavior.
motionAuraDetailsStateIsValid(state: WorldState): bool {
    var auraCount = state.entityMotionAuraAbilityCodes.length;
    if (auraCount != state.entityMotionAuraValues.length ||
        auraCount != state.entityMotionAuraBreakChanceScales.length ||
        state.entityFearDrStages.length != state.entityIds.length ||
        state.entityFearDrResetAt.length != state.entityIds.length) {
        return false;
    }
    var auraIndex = 0;
    while (auraIndex < auraCount) {
        var scale = <float>state.entityMotionAuraBreakChanceScales[auraIndex];
        if (scale < 0.0 || scale > 1.0) { return false; }
        auraIndex = auraIndex + 1;
    }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        if (<int>state.entityFearDrStages[entityIndex] < 0 ||
            <float>state.entityFearDrResetAt[entityIndex] < 0.0) {
            return false;
        }
        entityIndex = entityIndex + 1;
    }
    return retainedSpeedMotionStateIsValid(state) && retainedArmorMotionStateIsValid(state) &&
        retainedDodgeMotionStateIsValid(state) && faerieFireMotionStateIsValid(state) &&
        retainedAttackPowerMotionStateIsValid(state) && coldBloodMotionStateIsValid(state) &&
        bladeFlurryMotionStateIsValid(state) &&
        hemorrhageBleedVulnerabilityMotionStateIsValid(state);
}

fireMageProcStateIsValid(state: WorldState): bool {
    if (state.entityHeatingUpRemaining.length != state.entityIds.length ||
        state.entityHotStreakRemaining.length != state.entityIds.length ||
        state.entityCombustionRemaining.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var heating = <float>state.entityHeatingUpRemaining[index];
        var hotStreak = <float>state.entityHotStreakRemaining[index];
        var combustion = <float>state.entityCombustionRemaining[index];
        if (heating < 0.0 || hotStreak < 0.0 || combustion < 0.0 ||
            ((heating > 0.0 || hotStreak > 0.0 || combustion > 0.0) &&
                <uint>state.entityKinds[index] != <uint>1)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

arcanePowerStateIsValid(state: WorldState): bool {
    if (state.entityArcanePowerRemaining.length != state.entityIds.length ||
        state.entityArcanePowerSpellHasteRemaining.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var damageRemaining = <float>state.entityArcanePowerRemaining[index];
        var hasteRemaining = <float>state.entityArcanePowerSpellHasteRemaining[index];
        if (damageRemaining < 0.0 || hasteRemaining < 0.0 ||
            ((damageRemaining > 0.0 || hasteRemaining > 0.0) &&
                <uint>state.entityKinds[index] != <uint>1) ||
            (damageRemaining > 0.0 &&
                <float>state.entitySpellDamageMultipliers[index] != 1.2)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

icyVeinsStateIsValid(state: WorldState): bool {
    if (state.entityIcyVeinsSpellHasteRemaining.length != state.entityIds.length ||
        state.entityIcyVeinsCastShieldRemaining.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var hasteRemaining = <float>state.entityIcyVeinsSpellHasteRemaining[index];
        var shieldRemaining = <float>state.entityIcyVeinsCastShieldRemaining[index];
        if (hasteRemaining < 0.0 || shieldRemaining < 0.0 ||
            ((hasteRemaining > 0.0 || shieldRemaining > 0.0) &&
                <uint>state.entityKinds[index] != <uint>1)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

icyVeinsStateIsLegacyCompatible(state: WorldState): bool {
    if (!icyVeinsStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<float>state.entityIcyVeinsSpellHasteRemaining[index] != 0.0 ||
            <float>state.entityIcyVeinsCastShieldRemaining[index] != 0.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

overflowingPowerStateIsValid(state: WorldState): bool {
    if (state.entityOverflowingPowerCapRemaining.length != state.entityIds.length ||
        state.entityOverflowingPowerCapUsed.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityOverflowingPowerCapRemaining[index];
        var used = <float>state.entityOverflowingPowerCapUsed[index];
        if (remaining < 0.0 || remaining > OFFLINE_OVERFLOWING_POWER_CAP_WINDOW_SECONDS ||
            used < 0.0 || used > OFFLINE_OVERFLOWING_POWER_CAP_SECONDS ||
            (remaining == 0.0 && used != 0.0) ||
            ((remaining > 0.0 || used > 0.0) &&
                <uint>state.entityKinds[index] != <uint>1)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

overflowingPowerStateIsLegacyCompatible(state: WorldState): bool {
    if (!overflowingPowerStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<float>state.entityOverflowingPowerCapRemaining[index] != 0.0 ||
            <float>state.entityOverflowingPowerCapUsed[index] != 0.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

overloadStateIsValid(state: WorldState): bool {
    if (state.entityOverloadRemaining.length != state.entityIds.length ||
        state.entityOverloadValues.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityOverloadRemaining[index];
        var value = <float>state.entityOverloadValues[index];
        if (remaining < 0.0 || remaining > 10.0 || value < 0.0 || value > 0.4 ||
            (remaining == 0.0 && value != 0.0) ||
            (remaining > 0.0 && value != 0.4) ||
            ((remaining > 0.0 || value > 0.0) &&
                <uint>state.entityKinds[index] != <uint>1)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

overloadStateIsLegacyCompatible(state: WorldState): bool {
    if (!overloadStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<float>state.entityOverloadRemaining[index] != 0.0 ||
            <float>state.entityOverloadValues[index] != 0.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

powerEchoStateIsLegacyCompatible(state: WorldState): bool {
    if (!powerEchoStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<float>state.entityPowerEchoRemaining[index] != 0.0 ||
            <float>state.entityPowerEchoValues[index] != 0.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

powerEchoStateIsValid(state: WorldState): bool {
    if (state.entityPowerEchoRemaining.length != state.entityIds.length ||
        state.entityPowerEchoValues.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityPowerEchoRemaining[index];
        var value = <float>state.entityPowerEchoValues[index];
        if (remaining < 0.0 || remaining > 10.0 || value < 0.0 || value > 0.5 ||
            (remaining == 0.0 && value != 0.0) ||
            (remaining > 0.0 && value != 0.5) ||
            ((remaining > 0.0 || value > 0.0) &&
                <uint>state.entityKinds[index] != <uint>1)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

aetherSurgeStateIsValid(state: WorldState): bool {
    if (state.entityAetherSurgeCharges.length != state.entityIds.length ||
        state.entityAetherSurgeChargeRemaining.length != state.entityIds.length ||
        state.entityAetherSurgeFreeRemaining.length != state.entityIds.length ||
        state.entityAetherSurgePerfectMomentRemaining.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var charges = <int>state.entityAetherSurgeCharges[index];
        var chargeRemaining = <float>state.entityAetherSurgeChargeRemaining[index];
        var freeRemaining = <float>state.entityAetherSurgeFreeRemaining[index];
        var perfectMomentRemaining =
            <float>state.entityAetherSurgePerfectMomentRemaining[index];
        if (charges < 0 || charges > aetherSurgeContract.maxCharges() ||
            chargeRemaining < 0.0 || chargeRemaining > aetherSurgeContract.chargeWindow() ||
            freeRemaining < 0.0 || freeRemaining > aetherSurgeContract.freeWindow() ||
            perfectMomentRemaining < 0.0 ||
                perfectMomentRemaining > aetherSurgeContract.perfectMomentDuration() ||
            (charges == 0 && chargeRemaining != 0.0) ||
            (charges > 0 && chargeRemaining <= 0.0) ||
            ((charges > 0 || chargeRemaining > 0.0 || freeRemaining > 0.0 ||
                perfectMomentRemaining > 0.0) &&
                <uint>state.entityKinds[index] != <uint>1)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

aetherSurgeStateIsLegacyCompatible(state: WorldState): bool {
    if (!aetherSurgeStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<int>state.entityAetherSurgeCharges[index] != 0 ||
            <float>state.entityAetherSurgeChargeRemaining[index] != 0.0 ||
            <float>state.entityAetherSurgeFreeRemaining[index] != 0.0 ||
            <float>state.entityAetherSurgePerfectMomentRemaining[index] != 0.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

aetherSurgePerfectMomentStateIsLegacyCompatible(state: WorldState): bool {
    if (!aetherSurgeStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<float>state.entityAetherSurgePerfectMomentRemaining[index] != 0.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

groupHasteStateIsValid(state: WorldState): bool {
    if (state.entityGroupHasteRemaining.length != state.entityIds.length ||
        state.entityGroupHasteAttackBonuses.length != state.entityIds.length ||
        state.entityGroupHasteSpellBonuses.length != state.entityIds.length ||
        state.entitySatedRemaining.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityGroupHasteRemaining[index];
        var attackBonus = <float>state.entityGroupHasteAttackBonuses[index];
        var spellBonus = <float>state.entityGroupHasteSpellBonuses[index];
        var satedRemaining = <float>state.entitySatedRemaining[index];
        if (remaining < 0.0 || attackBonus < 0.0 || spellBonus < 0.0 ||
            satedRemaining < 0.0 ||
            (remaining == 0.0 && (attackBonus != 0.0 || spellBonus != 0.0)) ||
            (remaining > 0.0 && attackBonus <= 0.0) ||
            ((remaining > 0.0 || satedRemaining > 0.0) &&
                <uint>state.entityKinds[index] != <uint>1)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

groupHasteStateIsLegacyCompatible(state: WorldState): bool {
    if (!groupHasteStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<float>state.entityGroupHasteRemaining[index] != 0.0 ||
            <float>state.entityGroupHasteAttackBonuses[index] != 0.0 ||
            <float>state.entityGroupHasteSpellBonuses[index] != 0.0 ||
            <float>state.entitySatedRemaining[index] != 0.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

temporalHourglassStateIsValid(state: WorldState): bool {
    if (state.entityTemporalHourglassRemaining.length != state.entityIds.length ||
        state.entityTemporalHourglassModes.length != state.entityIds.length ||
        state.entityTemporalHourglassCooldownRates.length != state.entityIds.length ||
        state.entityTemporalHourglassHealRemaining.length != state.entityIds.length ||
        state.entityTemporalHourglassHealTicksRemaining.length != state.entityIds.length ||
        state.entityTemporalHourglassHealTickTimers.length != state.entityIds.length ||
        state.offlineTemporalHourglassSourceIds.length != state.offlineTemporalHourglassX.length ||
        state.offlineTemporalHourglassSourceIds.length != state.offlineTemporalHourglassZ.length ||
        state.offlineTemporalHourglassSourceIds.length != state.offlineTemporalHourglassRadii.length ||
        state.offlineTemporalHourglassSourceIds.length != state.offlineTemporalHourglassRemaining.length ||
        state.offlineTemporalHourglassSourceIds.length !=
            state.offlineTemporalHourglassProtectiveDurations.length ||
        state.offlineTemporalHourglassSourceIds.length !=
            state.offlineTemporalHourglassHostilePveDurations.length ||
        state.offlineTemporalHourglassSourceIds.length !=
            state.offlineTemporalHourglassHostilePvpDurations.length ||
        state.offlineTemporalHourglassSourceIds.length !=
            state.offlineTemporalHourglassHealFractions.length ||
        state.offlineTemporalHourglassSourceIds.length !=
            state.offlineTemporalHourglassSelfCooldownRates.length ||
        state.offlineTemporalHourglassSourceIds.length !=
            state.offlineTemporalHourglassAllyCooldownRates.length ||
        state.offlineTemporalHourglassSourceIds.length !=
            state.offlineTemporalHourglassCreatedTicks.length ||
        state.offlineTemporalHourglassSourceIds.length > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityTemporalHourglassRemaining[index];
        var mode = <uint>state.entityTemporalHourglassModes[index];
        var cooldownRate = <float>state.entityTemporalHourglassCooldownRates[index];
        var healRemaining = <int>state.entityTemporalHourglassHealRemaining[index];
        var healTicks = <int>state.entityTemporalHourglassHealTicksRemaining[index];
        var healTimer = <float>state.entityTemporalHourglassHealTickTimers[index];
        if (remaining < 0.0 || remaining > 60.0 || mode > <uint>2 ||
            cooldownRate < 0.0 || cooldownRate > 2.0 || healRemaining < 0 ||
            healTicks < 0 || healTicks > 5 || healTimer < 0.0 || healTimer > 1.0 ||
            (mode == <uint>0 && (remaining != 0.0 || cooldownRate != 0.0 ||
                healRemaining != 0 || healTicks != 0 || healTimer != 0.0)) ||
            (mode == <uint>1 && (remaining <= 0.0 || cooldownRate <= 0.0 ||
                <uint>state.entityKinds[index] != <uint>1)) ||
            (mode == <uint>2 && (remaining <= 0.0 || cooldownRate != 0.0 ||
                healRemaining != 0 || healTicks != 0 || healTimer != 0.0))) {
            return false;
        }
        index = index + 1;
    }
    var groundIndex = 0;
    while (groundIndex < state.offlineTemporalHourglassSourceIds.length) {
        if (<uint>state.offlineTemporalHourglassSourceIds[groundIndex] == <uint>0 ||
            <float>state.offlineTemporalHourglassRadii[groundIndex] <= 0.0 ||
            <float>state.offlineTemporalHourglassRadii[groundIndex] > 1.75 ||
            <float>state.offlineTemporalHourglassRemaining[groundIndex] <= 0.0 ||
            <float>state.offlineTemporalHourglassRemaining[groundIndex] > 30.0 ||
            <float>state.offlineTemporalHourglassProtectiveDurations[groundIndex] <= 0.0 ||
            <float>state.offlineTemporalHourglassProtectiveDurations[groundIndex] > 5.0 ||
            <float>state.offlineTemporalHourglassHostilePveDurations[groundIndex] <= 0.0 ||
            <float>state.offlineTemporalHourglassHostilePveDurations[groundIndex] > 60.0 ||
            <float>state.offlineTemporalHourglassHostilePvpDurations[groundIndex] <= 0.0 ||
            <float>state.offlineTemporalHourglassHostilePvpDurations[groundIndex] > 10.0 ||
            <float>state.offlineTemporalHourglassHealFractions[groundIndex] <= 0.0 ||
            <float>state.offlineTemporalHourglassHealFractions[groundIndex] > 0.3 ||
            <float>state.offlineTemporalHourglassSelfCooldownRates[groundIndex] <= 0.0 ||
            <float>state.offlineTemporalHourglassSelfCooldownRates[groundIndex] > 2.0 ||
            <float>state.offlineTemporalHourglassAllyCooldownRates[groundIndex] <= 0.0 ||
            <float>state.offlineTemporalHourglassAllyCooldownRates[groundIndex] > 2.0 ||
            <uint>state.offlineTemporalHourglassCreatedTicks[groundIndex] > state.tick) {
            return false;
        }
        groundIndex = groundIndex + 1;
    }
    return true;
}

temporalHourglassStateIsLegacyCompatible(state: WorldState): bool {
    if (!temporalHourglassStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<float>state.entityTemporalHourglassRemaining[index] != 0.0 ||
            <uint>state.entityTemporalHourglassModes[index] != <uint>0 ||
            <float>state.entityTemporalHourglassCooldownRates[index] != 0.0 ||
            <int>state.entityTemporalHourglassHealRemaining[index] != 0 ||
            <int>state.entityTemporalHourglassHealTicksRemaining[index] != 0 ||
            <float>state.entityTemporalHourglassHealTickTimers[index] != 0.0) {
            return false;
        }
        index = index + 1;
    }
    return state.offlineTemporalHourglassSourceIds.length == 0;
}

temporalHourglassStateIsSchema102Compatible(state: WorldState): bool {
    return temporalHourglassStateIsValid(state) &&
        state.offlineTemporalHourglassSourceIds.length == 0;
}

groupHasteAttackBonus(state: WorldState, entityIndex: int): float {
    return entityIndex >= 0 && entityIndex < state.entityIds.length &&
        <float>state.entityGroupHasteRemaining[entityIndex] > 0.0 ?
        <float>state.entityGroupHasteAttackBonuses[entityIndex] : 0.0;
}

groupHasteSpellBonus(state: WorldState, entityIndex: int): float {
    return entityIndex >= 0 && entityIndex < state.entityIds.length &&
        <float>state.entityGroupHasteRemaining[entityIndex] > 0.0 ?
        <float>state.entityGroupHasteSpellBonuses[entityIndex] : 0.0;
}

aetherDartsStateIsValid(state: WorldState): bool {
    if (state.entityAetherDartsConsumePending.length != state.entityIds.length ||
        state.entityAetherDartsBonusPerBolt.length != state.entityIds.length ||
        state.entityAetherDartsTicks.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var pending = <bool>state.entityAetherDartsConsumePending[index];
        var bonus = <int>state.entityAetherDartsBonusPerBolt[index];
        var ticks = <int>state.entityAetherDartsTicks[index];
        if (bonus < 0 || bonus > aetherSurgeContract.dartsBonusPerCharge() *
                aetherSurgeContract.maxCharges() ||
            (ticks != 0 && ticks != aetherSurgeContract.fullChargeMissiles()) ||
            (pending && bonus != 0) ||
            ((pending || bonus != 0 || ticks != 0) &&
                <uint>state.entityKinds[index] != <uint>1)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

aetherDartsStateIsLegacyCompatible(state: WorldState): bool {
    if (!aetherDartsStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<bool>state.entityAetherDartsConsumePending[index] ||
            <int>state.entityAetherDartsBonusPerBolt[index] != 0 ||
            <int>state.entityAetherDartsTicks[index] != 0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

spellDamageModifierStateIsValid(state: WorldState): bool {
    if (state.entityCritDamageSpellBonus.length != state.entityIds.length ||
        state.entitySpellDamageMultipliers.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<float>state.entityCritDamageSpellBonus[index] < 0.0 ||
            <float>state.entitySpellDamageMultipliers[index] < 0.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// WOS138 extends generic aura rows with school identity. Lockouts must retain a
// non-physical school; ordinary control effects retain their source school.
motionAuraSchoolStateIsValid(state: WorldState): bool {
    var auraCount = state.entityMotionAuraAbilityCodes.length;
    if (auraCount != state.entityMotionAuraSchoolCodes.length) { return false; }
    var lockoutKind = ccContract.motionAuraKindCode("lockout");
    var auraIndex = 0;
    while (auraIndex < auraCount) {
        var schoolCode = <uint>state.entityMotionAuraSchoolCodes[auraIndex];
        var kindCode = <uint>state.entityMotionAuraKindCodes[auraIndex];
        if (schoolCode > OFFLINE_PROJECTILE_SCHOOL_FIRE ||
            (kindCode == lockoutKind && schoolCode == OFFLINE_PROJECTILE_SCHOOL_PHYSICAL)) {
            return false;
        }
        auraIndex = auraIndex + 1;
    }
    return true;
}

retainedArmorMotionStateIsValid(state: WorldState): bool {
    var kind = ccContract.motionAuraKindCode("buff_armor");
    if (kind == <uint>0) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        var aura = <int><uint>state.entityMotionAuraOffsets[index];
        var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
        while (aura < end) {
            if (<uint>state.entityMotionAuraKindCodes[aura] == kind) {
                if (<uint>state.entityMotionAuraSourceIds[aura] != <uint>state.entityIds[index] ||
                    !retainedArmorAuraProfileIsValid(
                        <uint>state.entityMotionAuraAbilityCodes[aura],
                        <float>state.entityMotionAuraRemaining[aura],
                        <float>state.entityMotionAuraValues[aura]
                    ) || <float>state.entityMotionAuraBreakChanceScales[aura] != 0.0) {
                    return false;
                }
            }
            aura = aura + 1;
        }
        index = index + 1;
    }
    return true;
}

retainedDodgeMotionStateIsValid(state: WorldState): bool {
    var kind = ccContract.motionAuraKindCode("buff_dodge");
    if (kind == <uint>0) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        var aura = <int><uint>state.entityMotionAuraOffsets[index];
        var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
        while (aura < end) {
            if (<uint>state.entityMotionAuraKindCodes[aura] == kind &&
                (<uint>state.entityMotionAuraSourceIds[aura] != <uint>state.entityIds[index] ||
                    !retainedDodgeAuraProfileIsValid(
                        <uint>state.entityMotionAuraAbilityCodes[aura],
                        <float>state.entityMotionAuraRemaining[aura],
                        <float>state.entityMotionAuraValues[aura]
                    ) ||
                    <float>state.entityMotionAuraBreakChanceScales[aura] != 0.0)) {
                return false;
            }
            aura = aura + 1;
        }
        index = index + 1;
    }
    return true;
}

// The source removes a triggered trap before the tick ends. Only untriggered
// source GroundAoE rider facts cross a snapshot boundary.
offlineHunterTrapStateIsValid(state: WorldState): bool {
    var count = state.offlineHunterTrapSourceIds.length;
    if (count != state.offlineHunterTrapAbilityCodes.length ||
        count != state.offlineHunterTrapX.length ||
        count != state.offlineHunterTrapZ.length ||
        count != state.offlineHunterTrapRadii.length ||
        count != state.offlineHunterTrapRemaining.length ||
        count != state.offlineHunterTrapArmRemaining.length ||
        count != state.offlineHunterTrapFreezeDurations.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var sourceId = <uint>state.offlineHunterTrapSourceIds[index];
        if (sourceId == <uint>0 ||
            <uint>state.offlineHunterTrapAbilityCodes[index] != frostTrapAbilityCode() ||
            <float>state.offlineHunterTrapRadii[index] != 3.0 ||
            <float>state.offlineHunterTrapRemaining[index] <= 0.0 ||
            <float>state.offlineHunterTrapRemaining[index] > 60.0 ||
            <float>state.offlineHunterTrapArmRemaining[index] < 0.0 ||
            <float>state.offlineHunterTrapArmRemaining[index] > 1.5 ||
            <float>state.offlineHunterTrapFreezeDurations[index] != 3.0) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.offlineHunterTrapSourceIds[prior] == sourceId) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

// Source procState survives a temporary selection change, but contains only
// one castNth counter for this retained Hunter proc per owner.
offlineLeanQuiverStateIsValid(state: WorldState): bool {
    var count = state.offlineLeanQuiverEntityIds.length;
    if (count != state.offlineLeanQuiverCounters.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        if (<uint>state.offlineLeanQuiverEntityIds[index] == <uint>0 ||
            <int>state.offlineLeanQuiverCounters[index] < 0 ||
            <int>state.offlineLeanQuiverCounters[index] >= 3) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.offlineLeanQuiverEntityIds[prior] ==
                <uint>state.offlineLeanQuiverEntityIds[index]) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

// Source procState survives a temporary selection change. Redline Draw owns
// one castNth counter and an eight-second ICD per retained Hunter owner.
offlineRedlineDrawStateIsValid(state: WorldState): bool {
    var count = state.offlineRedlineDrawEntityIds.length;
    if (count != state.offlineRedlineDrawCounters.length ||
        count != state.offlineRedlineDrawIcdRemaining.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        if (<uint>state.offlineRedlineDrawEntityIds[index] == <uint>0 ||
            <int>state.offlineRedlineDrawCounters[index] < 0 ||
            <int>state.offlineRedlineDrawCounters[index] >= 3 ||
            <float>state.offlineRedlineDrawIcdRemaining[index] < 0.0 ||
            <float>state.offlineRedlineDrawIcdRemaining[index] > 8.0) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.offlineRedlineDrawEntityIds[prior] ==
                <uint>state.offlineRedlineDrawEntityIds[index]) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

// Deathless Will has only the source big-hit ICD; the generic proc runtime
// does not retain a counter for this trigger.
offlineDeathlessWillStateIsValid(state: WorldState): bool {
    var count = state.offlineDeathlessWillEntityIds.length;
    if (count != state.offlineDeathlessWillIcdRemaining.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        if (<uint>state.offlineDeathlessWillEntityIds[index] == <uint>0 ||
            <float>state.offlineDeathlessWillIcdRemaining[index] < 0.0 ||
            <float>state.offlineDeathlessWillIcdRemaining[index] > 30.0) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.offlineDeathlessWillEntityIds[prior] ==
                <uint>state.offlineDeathlessWillEntityIds[index]) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

offlineNextAttackCritAuraIndex(state: WorldState, casterIndex: int): int {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length) { return -1; }
    var kind = ccContract.motionAuraKindCode("next_attack_crit");
    var abilityCode = coldBloodAbilityCode();
    if (kind == <uint>0 || abilityCode == <uint>0) { return -1; }
    var auraIndex = <int><uint>state.entityMotionAuraOffsets[casterIndex];
    var auraEnd = <int><uint>state.entityMotionAuraOffsets[casterIndex + 1];
    while (auraIndex < auraEnd) {
        if (<uint>state.entityMotionAuraKindCodes[auraIndex] == kind &&
            <uint>state.entityMotionAuraAbilityCodes[auraIndex] == abilityCode &&
            <uint>state.entityMotionAuraSourceIds[auraIndex] == <uint>state.entityIds[casterIndex] &&
            <float>state.entityMotionAuraRemaining[auraIndex] > 0.0 &&
            <float>state.entityMotionAuraValues[auraIndex] == 1.0) {
            return auraIndex;
        }
        auraIndex = auraIndex + 1;
    }
    return -1;
}

offlineNextAttackCritIsActive(state: WorldState, casterIndex: int): bool {
    return offlineNextAttackCritAuraIndex(state, casterIndex) >= 0;
}

consumeOfflineNextAttackCrit(state: WorldState, casterIndex: int): bool {
    var auraIndex = offlineNextAttackCritAuraIndex(state, casterIndex);
    if (auraIndex < 0) { return false; }
    removeMotionAuraAt(state, casterIndex, auraIndex);
    return true;
}

consumeOfflineNextAttackCritAfterAutoHit(
    state: WorldState,
    casterIndex: int,
    events: autoAttackState.AutoEvents
): void {
    if (events.hitEvents > 0) {
        consumeOfflineNextAttackCrit(state, casterIndex);
    }
}

offlineDamageCritChance(state: WorldState, casterIndex: int): float {
    return consumeOfflineNextAttackCrit(state, casterIndex) ? 1.0 :
        offlineSpellCritChance(state, casterIndex);
}

offlinePhysicalCritical(state: WorldState, casterIndex: int): bool {
    var forced = consumeOfflineNextAttackCrit(state, casterIndex);
    var rolled = nextAuthoritativeRandomUnit(state) <
        <float>state.entityCritChance[casterIndex];
    return forced || rolled;
}

coldBloodMotionStateIsValid(state: WorldState): bool {
    var kind = ccContract.motionAuraKindCode("next_attack_crit");
    var abilityCode = coldBloodAbilityCode();
    if (kind == <uint>0) { return false; }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var auraIndex = <int><uint>state.entityMotionAuraOffsets[entityIndex];
        var auraEnd = <int><uint>state.entityMotionAuraOffsets[entityIndex + 1];
        while (auraIndex < auraEnd) {
            if (<uint>state.entityMotionAuraKindCodes[auraIndex] == kind &&
                (<uint>state.entityMotionAuraAbilityCodes[auraIndex] != abilityCode ||
                    <uint>state.entityMotionAuraSourceIds[auraIndex] !=
                        <uint>state.entityIds[entityIndex] ||
                    <float>state.entityMotionAuraRemaining[auraIndex] <= 0.0 ||
                    <float>state.entityMotionAuraRemaining[auraIndex] > 60.0 ||
                    <float>state.entityMotionAuraValues[auraIndex] != 1.0 ||
                    <float>state.entityMotionAuraBreakChanceScales[auraIndex] != 0.0)) {
                return false;
            }
            auraIndex = auraIndex + 1;
        }
        entityIndex = entityIndex + 1;
    }
    return true;
}

bladeFlurryHasteAuraProfileIsValid(remaining: float, value: float): bool {
    return remaining > 0.0 && remaining <= 12.0 && value == 1.2;
}

rapidFireHasteAuraProfileIsValid(remaining: float, value: float): bool {
    return remaining > 0.0 && remaining <= 15.0 && value == 1.4;
}

offlineSwingHasteAuraProfileIsValid(
    state: WorldState, entityIndex: int, auraIndex: int
): bool {
    var abilityCode = <uint>state.entityMotionAuraAbilityCodes[auraIndex];
    if (<uint>state.entityMotionAuraSourceIds[auraIndex] !=
            <uint>state.entityIds[entityIndex] ||
        <float>state.entityMotionAuraBreakChanceScales[auraIndex] != 0.0) {
        return false;
    }
    if (abilityCode == bladeFlurryAbilityCode()) {
        return bladeFlurryHasteAuraProfileIsValid(
            <float>state.entityMotionAuraRemaining[auraIndex],
            <float>state.entityMotionAuraValues[auraIndex]
        );
    }
    return abilityCode == rapidFireAbilityCode() && rapidFireHasteAuraProfileIsValid(
        <float>state.entityMotionAuraRemaining[auraIndex],
        <float>state.entityMotionAuraValues[auraIndex]
    );
}

offlineSwingIntervalMultiplier(state: WorldState, entityIndex: int): float {
    var kind = ccContract.motionAuraKindCode("buff_haste");
    if (kind == <uint>0 || entityIndex < 0 || entityIndex >= state.entityIds.length) {
        throw "woc swing haste state is invalid";
    }
    var aura = <int><uint>state.entityMotionAuraOffsets[entityIndex];
    var end = <int><uint>state.entityMotionAuraOffsets[entityIndex + 1];
    var multiplier = 1.0;
    var bladeFlurryFound = false;
    var rapidFireFound = false;
    while (aura < end) {
        if (<uint>state.entityMotionAuraKindCodes[aura] == kind) {
            var abilityCode = <uint>state.entityMotionAuraAbilityCodes[aura];
            if (!offlineSwingHasteAuraProfileIsValid(state, entityIndex, aura)) {
                throw "woc swing haste aura is invalid";
            }
            if (abilityCode == bladeFlurryAbilityCode()) {
                if (bladeFlurryFound) { throw "woc duplicate Blade Flurry haste aura"; }
                bladeFlurryFound = true;
            } else {
                if (rapidFireFound) { throw "woc duplicate Rapid Fire haste aura"; }
                rapidFireFound = true;
            }
            multiplier = multiplier / <float>state.entityMotionAuraValues[aura];
        }
        aura = aura + 1;
    }
    return multiplier;
}

// Kept as the pre-WOS234 call-site name while all supported haste identities
// now share the source-shaped fold above.
bladeFlurrySwingIntervalMultiplier(state: WorldState, entityIndex: int): float {
    return offlineSwingIntervalMultiplier(state, entityIndex);
}

offlineSwingHasteMotionStateIsValid(state: WorldState): bool {
    var kind = ccContract.motionAuraKindCode("buff_haste");
    if (kind == <uint>0) { return false; }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var aura = <int><uint>state.entityMotionAuraOffsets[entityIndex];
        var end = <int><uint>state.entityMotionAuraOffsets[entityIndex + 1];
        var bladeFlurryFound = false;
        var rapidFireFound = false;
        while (aura < end) {
            if (<uint>state.entityMotionAuraKindCodes[aura] == kind) {
                if (!offlineSwingHasteAuraProfileIsValid(state, entityIndex, aura)) {
                    return false;
                }
                if (<uint>state.entityMotionAuraAbilityCodes[aura] == bladeFlurryAbilityCode()) {
                    if (bladeFlurryFound) { return false; }
                    bladeFlurryFound = true;
                } else {
                    if (rapidFireFound) { return false; }
                    rapidFireFound = true;
                }
            }
            aura = aura + 1;
        }
        entityIndex = entityIndex + 1;
    }
    return true;
}

bladeFlurryMotionStateIsValid(state: WorldState): bool {
    return offlineSwingHasteMotionStateIsValid(state);
}

hemorrhageBleedVulnerabilityProfileIsValid(
    state: WorldState, targetIndex: int, auraIndex: int
): bool {
    var sourceId = <uint>state.entityMotionAuraSourceIds[auraIndex];
    var sourceIndex = partyEntityIndexById(state, sourceId);
    return targetIndex >= 0 && targetIndex < state.entityIds.length &&
        isOfflineEastbrookLifecycleMob(state, targetIndex) && sourceIndex >= 0 &&
        <uint>state.entityKinds[sourceIndex] == <uint>1 && sourceId !=
            <uint>state.entityIds[targetIndex] &&
        <uint>state.entityMotionAuraAbilityCodes[auraIndex] == hemorrhageAbilityCode() &&
        <float>state.entityMotionAuraRemaining[auraIndex] > 0.0 &&
        <float>state.entityMotionAuraRemaining[auraIndex] <= 12.0 &&
        <float>state.entityMotionAuraValues[auraIndex] == 0.4 &&
        <float>state.entityMotionAuraBreakChanceScales[auraIndex] == 0.0 &&
        <uint>state.entityMotionAuraSchoolCodes[auraIndex] == OFFLINE_PROJECTILE_SCHOOL_PHYSICAL;
}

hemorrhageBleedVulnerabilityMotionStateIsValid(state: WorldState): bool {
    var kind = ccContract.motionAuraKindCode("bleed_vuln");
    if (kind == <uint>0) { return false; }
    var targetIndex = 0;
    while (targetIndex < state.entityIds.length) {
        var aura = <int><uint>state.entityMotionAuraOffsets[targetIndex];
        var end = <int><uint>state.entityMotionAuraOffsets[targetIndex + 1];
        while (aura < end) {
            if (<uint>state.entityMotionAuraKindCodes[aura] == kind) {
                if (!hemorrhageBleedVulnerabilityProfileIsValid(state, targetIndex, aura)) {
                    return false;
                }
                var duplicate = aura + 1;
                while (duplicate < end) {
                    if (<uint>state.entityMotionAuraKindCodes[duplicate] == kind &&
                        <uint>state.entityMotionAuraSourceIds[duplicate] ==
                            <uint>state.entityMotionAuraSourceIds[aura]) {
                        return false;
                    }
                    duplicate = duplicate + 1;
                }
            }
            aura = aura + 1;
        }
        targetIndex = targetIndex + 1;
    }
    return true;
}

offlineBleedVulnerabilityMultiplier(state: WorldState, targetIndex: int): float {
    if (!hemorrhageBleedVulnerabilityMotionStateIsValid(state)) {
        throw "woc Hemorrhage bleed-vulnerability state is invalid";
    }
    var kind = ccContract.motionAuraKindCode("bleed_vuln");
    var aura = <int><uint>state.entityMotionAuraOffsets[targetIndex];
    var end = <int><uint>state.entityMotionAuraOffsets[targetIndex + 1];
    var bonus = 0.0;
    while (aura < end) {
        if (<uint>state.entityMotionAuraKindCodes[aura] == kind) {
            bonus = bonus + <float>state.entityMotionAuraValues[aura];
        }
        aura = aura + 1;
    }
    return 1.0 + bonus;
}

applyOfflineHemorrhageBleedVulnerability(
    state: WorldState, targetIndex: int, sourceId: uint, duration: float, value: float
): void {
    if (duration != 12.0 || value != 0.4) {
        throw "woc Hemorrhage bleed-vulnerability profile is invalid";
    }
    applyOfflineMotionAuraWithDetails(
        state, targetIndex, hemorrhageAbilityCode(), sourceId,
        ccContract.motionAuraKindCode("bleed_vuln"), duration, value, 0.0
    );
}

faerieFireMotionStateIsValid(state: WorldState): bool {
    var kind = ccContract.motionAuraKindCode("faerie_fire");
    var abilityCode = faerieFireAbilityCode();
    if (kind == <uint>0) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        var aura = <int><uint>state.entityMotionAuraOffsets[index];
        var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
        while (aura < end) {
            if (<uint>state.entityMotionAuraKindCodes[aura] == kind &&
                (<uint>state.entityMotionAuraAbilityCodes[aura] != abilityCode ||
                    <uint>state.entityMotionAuraSourceIds[aura] == <uint>0 ||
                    <float>state.entityMotionAuraRemaining[aura] <= 0.0 ||
                    <float>state.entityMotionAuraRemaining[aura] > 40.0 ||
                    <float>state.entityMotionAuraValues[aura] != 0.0 ||
                    <float>state.entityMotionAuraBreakChanceScales[aura] != 0.0)) {
                return false;
            }
            aura = aura + 1;
        }
        index = index + 1;
    }
    return true;
}

retainedSpeedAuraProfileIsValid(abilityCode: uint, remaining: float, value: float): bool {
    if (abilityCode == ghostWolfAbilityCode()) {
        return remaining > 0.0 && remaining <= ghostWolfDuration() && value == 1.4;
    }
    if (abilityCode == dashAbilityCode()) {
        return remaining > 0.0 && remaining <= 15.0 && value == 1.5;
    }
    if (abilityCode == deathlessWillSelectionCode()) {
        return remaining > 0.0 && remaining <= 4.0 && value == 1.4;
    }
    return abilityCode == aspectOfTheCheetahAbilityCode() && remaining > 0.0 &&
        remaining <= 1800.0 && value == 1.3;
}

retainedSpeedMotionStateIsValid(state: WorldState): bool {
    var kindCode = ccContract.motionAuraKindCode("buff_speed");
    if (kindCode == <uint>0) { return false; }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var auraIndex = <int><uint>state.entityMotionAuraOffsets[entityIndex];
        var auraEnd = <int><uint>state.entityMotionAuraOffsets[entityIndex + 1];
        while (auraIndex < auraEnd) {
            if (<uint>state.entityMotionAuraKindCodes[auraIndex] == kindCode) {
                if (<uint>state.entityMotionAuraSourceIds[auraIndex] !=
                        <uint>state.entityIds[entityIndex] ||
                    !retainedSpeedAuraProfileIsValid(
                        <uint>state.entityMotionAuraAbilityCodes[auraIndex],
                        <float>state.entityMotionAuraRemaining[auraIndex],
                        <float>state.entityMotionAuraValues[auraIndex]
                    ) || <float>state.entityMotionAuraBreakChanceScales[auraIndex] != 0.0) {
                    return false;
                }
            }
            auraIndex = auraIndex + 1;
        }
        entityIndex = entityIndex + 1;
    }
    return true;
}

retainedAttackPowerAuraProfileIsValid(abilityCode: uint, remaining: float, value: float): bool {
    if (abilityCode == tigersFuryAbilityCode()) {
        return remaining > 0.0 && remaining <= 6.0 && value > 0.0;
    }
    return abilityCode == aspectOfTheHawkAbilityCode() && remaining > 0.0 &&
        remaining <= 1800.0 && (value == 20.0 || value == 35.0 || value == 50.0);
}

retainedAttackPowerMotionStateIsValid(state: WorldState): bool {
    var kind = ccContract.motionAuraKindCode("buff_ap");
    if (kind == <uint>0) { return false; }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var auraIndex = <int><uint>state.entityMotionAuraOffsets[entityIndex];
        var auraEnd = <int><uint>state.entityMotionAuraOffsets[entityIndex + 1];
        while (auraIndex < auraEnd) {
            if (<uint>state.entityMotionAuraKindCodes[auraIndex] == kind &&
                (<uint>state.entityMotionAuraSourceIds[auraIndex] !=
                        <uint>state.entityIds[entityIndex] ||
                    !retainedAttackPowerAuraProfileIsValid(
                        <uint>state.entityMotionAuraAbilityCodes[auraIndex],
                        <float>state.entityMotionAuraRemaining[auraIndex],
                        <float>state.entityMotionAuraValues[auraIndex]
                    ) ||
                    <float>state.entityMotionAuraBreakChanceScales[auraIndex] != 0.0)) {
                return false;
            }
            auraIndex = auraIndex + 1;
        }
        entityIndex = entityIndex + 1;
    }
    return true;
}

// Source Sunder Armor is one 30-second aura shared by all applications. Its
// generated armor value is presentation data; physical mitigation uses the
// fixed two-percent-per-stack rule in effectiveOfflineArmor.
sunderArmorStateIsValid(state: WorldState): bool {
    if (state.entitySunderArmorStacks.length != state.entityIds.length ||
        state.entitySunderArmorRemaining.length != state.entityIds.length ||
        state.entitySunderArmorValues.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var stacks = <int>state.entitySunderArmorStacks[index];
        var remaining = <float>state.entitySunderArmorRemaining[index];
        var value = <float>state.entitySunderArmorValues[index];
        if (stacks < 0 || stacks > 5 || remaining < 0.0 || remaining > 30.0 ||
            value < 0.0 ||
            (stacks == 0 && (remaining != 0.0 || value != 0.0)) ||
            (stacks > 0 && (remaining <= 0.0 || value <= 0.0))) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// Demoralizing Roar's source aura is unique per target and refreshes in place.
// WOC retains its two generated rank values, rather than widening this into a
// generic hostile aura partition.
demoralizingRoarStateIsValid(state: WorldState): bool {
    if (state.entityDemoralizingRoarRemaining.length != state.entityIds.length ||
        state.entityDemoralizingRoarValues.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityDemoralizingRoarRemaining[index];
        var value = <float>state.entityDemoralizingRoarValues[index];
        if (remaining < 0.0 || remaining > 20.0 || value < 0.0 || value > 35.0 ||
            (remaining == 0.0 && value != 0.0) ||
            (remaining > 0.0 && (value != 20.0 && value != 35.0))) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// Prowl's self-buff can exist only on a living Cat-form player. The source
// stores `stealth` as an ordinary aura, but WOC retains its identity in these
// fixed entity rows because idle aggro must read it before combat begins.
prowlStateIsValid(state: WorldState): bool {
    if (state.entityProwlRemaining.length != state.entityIds.length ||
        state.entityProwlValues.length != state.entityIds.length) {
        return false;
    }
    var cat = forms.formAbilityCode("form_cat");
    if (cat == <uint>0) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityProwlRemaining[index];
        var value = <float>state.entityProwlValues[index];
        if (remaining < 0.0 || remaining > 3600.0 || value < 0.0 || value > 0.5 ||
            (remaining == 0.0 && value != 0.0) ||
            (remaining > 0.0 &&
                (<uint>state.entityKinds[index] != <uint>1 ||
                    <uint>state.entityActiveFormAbilityCodes[index] != cat || value != 0.5))) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// WOS109 retains source-recognized imbues in one mutually-exclusive weapon
// row. A nonzero row captures its resolved aura endpoints and selection, so a
// later respec or level-up cannot reinterpret the active imbue.
imbueStateIsValid(state: WorldState): bool {
    if (state.entityImbueAbilityCodes.length != state.entityIds.length ||
        state.entityImbueRanks.length != state.entityIds.length ||
        state.entityImbueRemaining.length != state.entityIds.length ||
        state.entityImbueResolvedBonuses.length != state.entityIds.length ||
        state.entityImbueResolvedJudgementMinimums.length != state.entityIds.length ||
        state.entityImbueResolvedJudgementMaximums.length != state.entityIds.length ||
        state.entityImbueTalentSpecCodes.length != state.entityIds.length ||
        state.entityImbueTalentRowOptionCodes.length != state.entityIds.length * 6) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var abilityCode = <uint>state.entityImbueAbilityCodes[index];
        var rank = <uint>state.entityImbueRanks[index];
        var remaining = <float>state.entityImbueRemaining[index];
        var bonus = <int>state.entityImbueResolvedBonuses[index];
        var judgementMinimum = <int>state.entityImbueResolvedJudgementMinimums[index];
        var judgementMaximum = <int>state.entityImbueResolvedJudgementMaximums[index];
        if (abilityCode == <uint>0) {
            if (rank != <uint>0 || remaining != 0.0 || bonus != 0 ||
                judgementMinimum != 0 || judgementMaximum != 0 ||
                !offlineImbueTalentSnapshotIsEmpty(state, index)) {
                return false;
            }
        } else {
            var profileIsValid = <uint>state.entityKinds[index] == <uint>1 &&
                remaining > 0.0 &&
                ((abilityCode == sealOfRighteousnessAbilityCode() &&
                    sealOfRighteousnessProfileIsValid(rank) &&
                    remaining <= sealOfRighteousnessDuration(rank)) ||
                (abilityCode == flametongueWeaponAbilityCode() &&
                    flametongueWeaponProfileIsValid(rank) &&
                    remaining <= flametongueWeaponDuration(rank)) ||
                (abilityCode == frostbrandWeaponAbilityCode() &&
                    frostbrandWeaponProfileIsValid(rank) &&
                    remaining <= frostbrandWeaponDuration(rank)));
            var expected = offlineTalentImbueResolvedValues(state, index);
            if (!profileIsValid || !offlineImbueTalentSnapshotIsValid(state, index) ||
                bonus != expected.bonus ||
                judgementMinimum != expected.judgementMinimum ||
                judgementMaximum != expected.judgementMaximum) {
                return false;
            }
        }
        index = index + 1;
    }
    return true;
}

activityStateIsValid(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length &&
        <uint>state.entityAiStates[index] >= <uint>1 &&
        <uint>state.entityAiStates[index] <= <uint>6;
}

tapOwnershipStateIsValid(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length;
}

corpseInstanceStateIsValid(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length;
}

harvestClaimStateIsValid(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length;
}

lootFfaStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length) {
        return false;
    }
    var present = <bool>state.entityLootFfaTimerPresent[index];
    var seconds = <float>state.entityLootFfaTimers[index];
    return seconds >= 0.0 && (present || seconds == 0.0);
}

petRuntimeStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length) {
        return false;
    }
    var autoTauntPresent = <bool>state.entityPetAutoTauntPresent[index];
    var autoTaunt = <bool>state.entityPetAutoTaunt[index];
    var autoWaterJetPresent = <bool>state.entityPetAutoWaterJetPresent[index];
    var autoWaterJet = <bool>state.entityPetAutoWaterJet[index];
    var manualTauntPresent = <bool>state.entityPetManualTauntPendingPresent[index];
    var manualTaunt = <bool>state.entityPetManualTauntPending[index];
    return <uint>state.entityPetModes[index] >= <uint>1 &&
        <uint>state.entityPetModes[index] <= <uint>3 &&
        <float>state.entityPetTauntTimers[index] >= 0.0 &&
        <float>state.entityPetPathCooldowns[index] >= 0.0 &&
        (autoTauntPresent || !autoTaunt) &&
        (autoWaterJetPresent || !autoWaterJet) &&
        (manualTauntPresent || !manualTaunt);
}

bossCadenceStateIsValid(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length &&
        <float>state.entityBossPulseTimers[index] >= 0.0 &&
        <float>state.entityBossStompTimers[index] >= 0.0 &&
        <float>state.entityBossBigCastTimers[index] >= 0.0 &&
        <float>state.entityBossStoneskinTimers[index] >= 0.0;
}

bossSpecialStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length) {
        return false;
    }
    var detonatePresent = <bool>state.entityBossDetonateTimerPresent[index];
    var detonateSeconds = <float>state.entityBossDetonateTimers[index];
    return <float>state.entityBossTerrifyTimers[index] >= 0.0 &&
        <float>state.entityBossAoeSlowTimers[index] >= 0.0 &&
        <float>state.entityBossLoudYellTimers[index] >= 0.0 &&
        <int>state.entityBossLoudYellIndices[index] >= 0 &&
        detonateSeconds >= 0.0 && (detonatePresent || detonateSeconds == 0.0) &&
        <float>state.entityBossMendTimers[index] >= 0.0 &&
        <float>state.entityBossWardTimers[index] >= 0.0 &&
        <float>state.entityBossChannelTimers[index] >= 0.0 &&
        <float>state.entityBossChannelRamps[index] >= 0.0 &&
        <float>state.entityBossRallyTimers[index] >= 0.0 &&
        <float>state.entityBossWarcryTimers[index] >= 0.0 &&
        <int>state.entityBossFiredSummons[index] >= 0;
}

presentationIdentityIsValid(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length &&
        <float>state.entityPresentationScales[index] > 0.0 &&
        <uint>state.entityPresentationColors[index] <= <uint>16777215 &&
        (<uint>state.entitySkinCatalogs[index] == <uint>1 ||
            <uint>state.entitySkinCatalogs[index] == <uint>2);
}

combatLoadoutStateIsValid(state: WorldState, index: int): bool {
    var weaponMinimum = <int>state.entityWeaponMinimum[index];
    var weaponMaximum = <int>state.entityWeaponMaximum[index];
    var weaponSpeed = <float>state.entityWeaponSpeed[index];
    var offhandMinimum = <int>state.entityOffhandWeaponMinimum[index];
    var offhandMaximum = <int>state.entityOffhandWeaponMaximum[index];
    var offhandSpeed = <float>state.entityOffhandWeaponSpeed[index];
    var hasOffhand = <bool>state.entityHasOffhandWeapon[index];
    var dualWielding = <bool>state.entityDualWielding[index];
    if (weaponMinimum < 0 || weaponMaximum < 0 || weaponSpeed < 0.0 ||
        offhandMinimum < 0 || offhandMaximum < 0 || offhandSpeed < 0.0 ||
        <int>state.entityAttackPower[index] < 0 || <int>state.entityRangedPower[index] < 0 ||
        <int>state.entitySpellPower[index] < 0 || <int>state.entityArmor[index] < 0 ||
        <float>state.entityCritChance[index] < 0.0 || <float>state.entityDodgeChance[index] < 0.0 ||
        <float>state.entityHitBonus[index] < 0.0 ||
        <float>state.entityCritDamagePhysicalBonus[index] < 0.0 ||
        <float>state.entityMeleeHaste[index] < 0.0 || <float>state.entityRangedHaste[index] < 0.0 ||
        <float>state.entitySwingTimer[index] < 0.0 ||
        <float>state.entityOffhandSwingTimer[index] < 0.0 ||
        <float>state.entityBlockChance[index] < 0.0 || <int>state.entityBlockValue[index] < 0) {
        return false;
    }
    var weaponIsUnassigned = weaponMinimum == 0 && weaponMaximum == 0 && weaponSpeed == 0.0;
    if (!weaponIsUnassigned &&
        (weaponMinimum < 1 || weaponMaximum < weaponMinimum || weaponSpeed <= 0.0)) {
        return false;
    }
    if (hasOffhand) {
        return offhandMinimum >= 1 && offhandMaximum >= offhandMinimum && offhandSpeed > 0.0;
    }
    return !dualWielding && offhandMinimum == 0 && offhandMaximum == 0 && offhandSpeed == 0.0;
}

partyRowStateIsValid(state: WorldState, index: int): bool {
    var partyId = <uint>state.entityPartyIds[index];
    var leaderId = <uint>state.entityPartyLeaderIds[index];
    var raid = <bool>state.entityPartyRaids[index];
    var group = <uint>state.entityPartyRaidGroups[index];
    var memberOrder = <uint>state.entityPartyMemberOrders[index];
    var inviteFrom = <uint>state.entityPartyInviteFromIds[index];
    var inviteExpires = <uint>state.entityPartyInviteExpiresAtMicros[index];
    if (partyId == <uint>0) {
        return leaderId == <uint>0 && !raid && group == <uint>0 &&
            memberOrder == <uint>0 &&
            ((inviteFrom == <uint>0 && inviteExpires == <uint>0) ||
                (inviteFrom != <uint>0 && inviteExpires != <uint>0));
    }
    return <uint>state.entityKinds[index] == <uint>1 && leaderId != <uint>0 &&
        memberOrder != <uint>0 &&
        ((raid && (group == <uint>1 || group == <uint>2)) || (!raid && group == <uint>0)) &&
        ((inviteFrom == <uint>0 && inviteExpires == <uint>0) ||
            (inviteFrom != <uint>0 && inviteExpires != <uint>0));
}

partyDifficultyStateIsValid(state: WorldState): bool {
    if (state.entityDungeonDifficultyPersonalHeroic.length != state.entityIds.length ||
        state.entityPartyDungeonDifficultyHeroic.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var partyId = <uint>state.entityPartyIds[index];
        if (partyId == <uint>0) {
            if (<bool>state.entityPartyDungeonDifficultyHeroic[index]) {
                return false;
            }
        } else {
            var prior = 0;
            while (prior < index) {
                if (<uint>state.entityPartyIds[prior] == partyId &&
                    <bool>state.entityPartyDungeonDifficultyHeroic[prior] !=
                        <bool>state.entityPartyDungeonDifficultyHeroic[index]) {
                    return false;
                }
                prior = prior + 1;
            }
        }
        index = index + 1;
    }
    return true;
}

decodeState(bytes: container.Array<uint>): WorldState {
    var reader = new StateReader(bytes);
