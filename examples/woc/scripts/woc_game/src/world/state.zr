// Arcane Shot is instant but still a normal GCD action. The source charges and
// arms its cooldown before scheduling the nonphysical projectile; all hit
// resolution remains deferred to the landing reducer.
startOfflineArcaneShotCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = arcaneShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_shot");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var cooldown = m4AbilityCatalog.metric(abilityIndex, level, "cooldown");
    var modifiers = offlineTalentModifiersForEntity(state, casterIndex);
    var bonusCharges = talentModifiers.abilityField(modifiers, "arcane_shot", "bonusCharges");
    if (!arcaneShotProfileIsValid(abilityIndex, level) || rank <= 0 ||
        !offlineAbilityChargeReady(
            state, casterIndex, abilityCode, bonusCharges, cooldown
        ) ||
        <float>state.entityResources[casterIndex] < cost ||
        arcaneShotTargetIndex(state, casterIndex, targetId) < 0) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS;
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    armOfflineAbilityChargeCooldown(
        state, casterIndex, abilityCode, bonusCharges, cooldown
    );
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        effects.metric(abilityIndex, rank, 0, "min"),
        effects.metric(abilityIndex, rank, 0, "max"),
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_ARCANE,
        abilityCode,
        <uint>rank,
        0.0
    );
}

concussiveShotAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("concussive_shot");
    var abilityIndex = m4AbilityCatalog.indexOf("concussive_shot");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(<int>code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "concussive_shot") {
        throw "Concussive Shot is absent from the current ability catalog";
    }
    return code;
}

concussiveShotPayloadAbilityIsExact(
    bytes: container.Array<uint>, offset: uint, length: uint
): bool {
    return length == <uint>15 && <uint>bytes[<int>offset] == <uint>99 &&
        <uint>bytes[<int>(offset + <uint>1)] == <uint>111 &&
        <uint>bytes[<int>(offset + <uint>2)] == <uint>110 &&
        <uint>bytes[<int>(offset + <uint>3)] == <uint>99 &&
        <uint>bytes[<int>(offset + <uint>4)] == <uint>117 &&
        <uint>bytes[<int>(offset + <uint>5)] == <uint>115 &&
        <uint>bytes[<int>(offset + <uint>6)] == <uint>115 &&
        <uint>bytes[<int>(offset + <uint>7)] == <uint>105 &&
        <uint>bytes[<int>(offset + <uint>8)] == <uint>118 &&
        <uint>bytes[<int>(offset + <uint>9)] == <uint>101 &&
        <uint>bytes[<int>(offset + <uint>10)] == <uint>95 &&
        <uint>bytes[<int>(offset + <uint>11)] == <uint>115 &&
        <uint>bytes[<int>(offset + <uint>12)] == <uint>104 &&
        <uint>bytes[<int>(offset + <uint>13)] == <uint>111 &&
        <uint>bytes[<int>(offset + <uint>14)] == <uint>116;
}

concussiveShotProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    return abilityIndex >= 0 && level >= 8 && rank == 1 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "hunter" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "physical" &&
        m4AbilityCatalog.text(abilityIndex, "scalesWith") == "ranged" &&
        m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        m4AbilityCatalog.flag(abilityIndex, "projectile") &&
        !m4AbilityCatalog.flag(abilityIndex, "offGcd") &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 20.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 12.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 35.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "minRange") == 8.0 &&
        effects.count(abilityIndex, rank) == 2 &&
        effects.typeAt(abilityIndex, rank, 0) == "directDamage" &&
        effects.metric(abilityIndex, rank, 0, "min") == 4.0 &&
        effects.metric(abilityIndex, rank, 0, "max") == 6.0 &&
        effects.typeAt(abilityIndex, rank, 1) == "slow" &&
        effects.metric(abilityIndex, rank, 1, "mult") == 0.5 &&
        effects.metric(abilityIndex, rank, 1, "duration") == 4.0;
}

concussiveShotTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("concussive_shot");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var distanceSquared = dx * dx + dz * dz;
    var level = <int>state.entityLevels[casterIndex];
    var minimum = m4AbilityCatalog.metric(abilityIndex, level, "minRange");
    var maximum = m4AbilityCatalog.metric(abilityIndex, level, "range");
    return distanceSquared >= minimum * minimum && distanceSquared <= maximum * maximum &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <=
            OFFLINE_SOURCE_TARGET_FACING_HALF_ARC ? targetIndex : -1;
}

// A physical Hunter shot is instantaneous at cast admission but its range and
// critical draws, damage, and source-ordered slow resolve only when it lands.
startOfflineConcussiveShotCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = concussiveShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("concussive_shot");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!concussiveShotProfileIsValid(abilityIndex, level) || rank != 1 ||
        <float>state.entityResources[casterIndex] < cost ||
        concussiveShotTargetIndex(state, casterIndex, targetId) < 0) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS;
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        effects.metric(abilityIndex, rank, 0, "min"),
        effects.metric(abilityIndex, rank, 0, "max"),
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_PHYSICAL,
        abilityCode,
        <uint>rank,
        0.0
    );
}

