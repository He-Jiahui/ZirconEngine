applyEastbrookLocomotionRecovery(state: WorldState, entityIndex: int, spawnIndex: int): void {
    state.entityLeashAnchorPresent[entityIndex] =
        m8EastbrookEncounter.locomotionRecoveryFlag(spawnIndex, "leashAnchorPresent");
    state.entityLeashAnchorX[entityIndex] =
        m8EastbrookEncounter.locomotionRecoveryDecimal(spawnIndex, "leashAnchorX");
    state.entityLeashAnchorY[entityIndex] =
        m8EastbrookEncounter.locomotionRecoveryDecimal(spawnIndex, "leashAnchorY");
    state.entityLeashAnchorZ[entityIndex] =
        m8EastbrookEncounter.locomotionRecoveryDecimal(spawnIndex, "leashAnchorZ");
    state.entityEvadeStalls[entityIndex] =
        m8EastbrookEncounter.locomotionRecoveryDecimal(spawnIndex, "evadeStall");
    state.entityFleeTimers[entityIndex] =
        m8EastbrookEncounter.locomotionRecoveryDecimal(spawnIndex, "fleeTimer");
    state.entityFleeReturnTimers[entityIndex] =
        m8EastbrookEncounter.locomotionRecoveryDecimal(spawnIndex, "fleeReturnTimer");
    state.entityHasFled[entityIndex] =
