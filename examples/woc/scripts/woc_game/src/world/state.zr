    dotIndex = 0;
    while (dotIndex < state.offlineDotTargetIds.length) {
        writer.byte(<uint>state.offlineDotRanks[dotIndex], 1);
        writer.signed(<int>state.offlineDotSnapshotPowers[dotIndex], 1, 1, 2, 4);
        dotIndex = dotIndex + 1;
    }
    // WOS64 follows the same tail pattern for pure friendly HoTs. The WOS60
    // rows remain byte-for-byte compatible; rank zero denotes a pre-WOS64
    // Rejuvenation row whose resolved heal cannot recover an exact old power.
    writer.u16(<uint>state.offlineHotTargetIds.length, 1, 1);
    hotIndex = 0;
    while (hotIndex < state.offlineHotTargetIds.length) {
        writer.byte(<uint>state.offlineHotRanks[hotIndex], 1);
        writer.signed(<int>state.offlineHotSnapshotPowers[hotIndex], 1, 1, 2, 4);
        hotIndex = hotIndex + 1;
    }
    if (!offlineAbsorbStateIsValid(state)) {
        throw "woc offline absorb state is invalid";
    }
    // WOS65 retains source aura insertion order. That order is authoritative
    // because source damage consumes absorb rows from newest to oldest.
    writer.u16(<uint>state.offlineAbsorbTargetIds.length, 1, 1);
    var absorbIndex = 0;
    while (absorbIndex < state.offlineAbsorbTargetIds.length) {
        writer.u64(<uint>state.offlineAbsorbTargetIds[absorbIndex], 1, 1, 2, 4);
        writer.u64(<uint>state.offlineAbsorbSourceIds[absorbIndex], 1, 1, 2, 4);
        writer.u16(<uint>state.offlineAbsorbAbilityCodes[absorbIndex], 1, 1);
        writer.byte(<uint>state.offlineAbsorbRanks[absorbIndex], 1);
        writer.u16(<uint>state.offlineAbsorbAmounts[absorbIndex], 1, 1);
        writer.fixed6(<float>state.offlineAbsorbRemaining[absorbIndex], 1, 1, 2, 3, 5, 8);
        absorbIndex = absorbIndex + 1;
    }
    if (!demoralizingRoarStateIsValid(state)) {
        throw "woc Demoralizing Roar state is invalid";
    }
    var demoralizingRoarIndex = 0;
    while (demoralizingRoarIndex < entityCount) {
        writer.fixed6(
            <float>state.entityDemoralizingRoarRemaining[demoralizingRoarIndex],
            1, 1, 2, 3, 5, 8
        );
        writer.fixed6(
            <float>state.entityDemoralizingRoarValues[demoralizingRoarIndex],
            1, 1, 2, 3, 5, 8
        );
        demoralizingRoarIndex = demoralizingRoarIndex + 1;
    }
    if (!prowlStateIsValid(state)) {
        throw "woc Prowl state is invalid";
    }
    var prowlIndex = 0;
    while (prowlIndex < entityCount) {
        writer.fixed6(<float>state.entityProwlRemaining[prowlIndex], 1, 1, 2, 3, 5, 8);
        writer.fixed6(<float>state.entityProwlValues[prowlIndex], 1, 1, 2, 3, 5, 8);
        prowlIndex = prowlIndex + 1;
    }
    var motionAuraSchoolIndex = 0;
    while (motionAuraSchoolIndex < state.entityMotionAuraSchoolCodes.length) {
        writer.byte(<uint>state.entityMotionAuraSchoolCodes[motionAuraSchoolIndex], 1);
        motionAuraSchoolIndex = motionAuraSchoolIndex + 1;
    }
    var consumableIndex = 0;
    while (consumableIndex < entityCount) {
        if (!consumableStateIsValid(state, consumableIndex)) {
            throw "woc consumable state is invalid";
        }
        writer.u16(<uint>state.entityEatingItemCodes[consumableIndex], 1, 1);
        writer.u16(<uint>state.entityEatingHpPerTwoSeconds[consumableIndex], 1, 1);
        writer.fixed6(<float>state.entityEatingRemaining[consumableIndex], 1, 1, 2, 3, 5, 8);
        writer.u16(<uint>state.entityDrinkingItemCodes[consumableIndex], 1, 1);
        writer.u16(<uint>state.entityDrinkingManaPerTwoSeconds[consumableIndex], 1, 1);
        writer.fixed6(<float>state.entityDrinkingRemaining[consumableIndex], 1, 1, 2, 3, 5, 8);
        consumableIndex = consumableIndex + 1;
    }
    if (!partyMarkerStateIsValid(state)) {
        throw "woc party marker state is invalid";
    }
    writer.u16(<uint>state.partyMarkerPartyIds.length, 1, 1);
    var partyMarkerIndex = 0;
    while (partyMarkerIndex < state.partyMarkerPartyIds.length) {
        writer.u64(<uint>state.partyMarkerPartyIds[partyMarkerIndex], 1, 1, 2, 4);
        writer.u64(<uint>state.partyMarkerEntityIds[partyMarkerIndex], 1, 1, 2, 4);
        writer.byte(<uint>state.partyMarkerSymbols[partyMarkerIndex], 1);
        partyMarkerIndex = partyMarkerIndex + 1;
    }
    if (!partyMasterLootStateIsValid(state)) {
        throw "woc party master loot state is invalid";
    }
    var partyMasterLootIndex = 0;
    while (partyMasterLootIndex < entityCount) {
        writer.byte(
            <bool>state.entityPartyMasterLootEnabled[partyMasterLootIndex] ?
                <uint>1 : <uint>0,
            1
        );
        writer.u64(
            <uint>state.entityPartyMasterLooterIds[partyMasterLootIndex], 1, 1, 2, 4
        );
        writer.byte(
            <uint>state.entityPartyMasterLootThresholdCodes[partyMasterLootIndex], 1
        );
        partyMasterLootIndex = partyMasterLootIndex + 1;
    }
    if (!lootRollStateIsValid(state)) {
        throw "woc loot roll state is invalid";
    }
    writer.u64(state.nextLootRollId, 1, 1, 2, 4);
    writer.u16(<uint>state.pendingLootRollIds.length, 1, 1);
    var pendingLootRollIndex = 0;
    while (pendingLootRollIndex < state.pendingLootRollIds.length) {
        writer.u64(<uint>state.pendingLootRollIds[pendingLootRollIndex], 1, 1, 2, 4);
        writer.u64(<uint>state.pendingLootRollMobIds[pendingLootRollIndex], 1, 1, 2, 4);
        writer.u16(<uint>state.pendingLootRollItemCodes[pendingLootRollIndex], 1, 1);
        writer.byte(<uint>state.pendingLootRollQualityCodes[pendingLootRollIndex], 1);
        writer.u64(
            <uint>state.pendingLootRollExpiresAtMicros[pendingLootRollIndex], 1, 1, 2, 4
        );
        writer.u64(
            <uint>state.pendingLootRollMasterLooterIds[pendingLootRollIndex], 1, 1, 2, 4
        );
        pendingLootRollIndex = pendingLootRollIndex + 1;
    }
    writer.u16(<uint>state.lootRollCandidateRollIds.length, 1, 1);
    var lootRollCandidateIndex = 0;
    while (lootRollCandidateIndex < state.lootRollCandidateRollIds.length) {
        writer.u64(
            <uint>state.lootRollCandidateRollIds[lootRollCandidateIndex], 1, 1, 2, 4
        );
        writer.u64(
            <uint>state.lootRollCandidatePlayerIds[lootRollCandidateIndex], 1, 1, 2, 4
        );
        writer.byte(
            <uint>state.lootRollCandidateChoiceCodes[lootRollCandidateIndex], 1
        );
        writer.byte(<uint>state.lootRollCandidateValues[lootRollCandidateIndex], 1);
        lootRollCandidateIndex = lootRollCandidateIndex + 1;
    }
    if (!partyLootDistributionStateIsValid(state)) {
        throw "woc party loot distribution state is invalid";
    }
    writer.u16(<uint>state.partyLootTurnPartyIds.length, 1, 1);
    var partyLootTurnIndex = 0;
    while (partyLootTurnIndex < state.partyLootTurnPartyIds.length) {
        writer.u64(
            <uint>state.partyLootTurnPartyIds[partyLootTurnIndex], 1, 1, 2, 4
        );
        writer.u64(<uint>state.partyLootTurnValues[partyLootTurnIndex], 1, 1, 2, 4);
        partyLootTurnIndex = partyLootTurnIndex + 1;
    }
    writer.u16(<uint>state.corpseLootRecipientMobIds.length, 1, 1);
    var corpseLootRecipientIndex = 0;
    while (corpseLootRecipientIndex < state.corpseLootRecipientMobIds.length) {
        writer.u64(
            <uint>state.corpseLootRecipientMobIds[corpseLootRecipientIndex], 1, 1, 2, 4
        );
        writer.u64(
            <uint>state.corpseLootRecipientPlayerIds[corpseLootRecipientIndex], 1, 1, 2, 4
        );
        writer.byte(
            <uint>state.corpseLootRecipientOrders[corpseLootRecipientIndex], 1
        );
        corpseLootRecipientIndex = corpseLootRecipientIndex + 1;
    }
    return writer.finish(true);
}

// Capturing the profile and school makes a snapshot restore land with the
// source launch closure, while live attacker values (power, hit and crit)
// remain source-consistent landing-time reads.
offlineProjectileStateIsValid(state: WorldState): bool {
    var count = state.offlineProjectileSourceIds.length;
    if (count != state.offlineProjectileTargetIds.length ||
        count != state.offlineProjectileX.length ||
        count != state.offlineProjectileZ.length ||
        count != state.offlineProjectileTtls.length ||
        count != state.offlineProjectileWands.length ||
        count != state.offlineProjectileSchoolCodes.length ||
        count != state.offlineProjectileMinimums.length ||
        count != state.offlineProjectileMaximums.length ||
        count != state.offlineProjectileSpeeds.length ||
        count != state.offlineProjectileAbilityCodes.length ||
        count != state.offlineProjectileRanks.length ||
        count != state.offlineProjectileCastTimes.length ||
        count > <int>OFFLINE_PROJECTILE_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        if (<uint>state.offlineProjectileSourceIds[index] == <uint>0 ||
            <uint>state.offlineProjectileTargetIds[index] == <uint>0 ||
            <uint>state.offlineProjectileSourceIds[index] ==
                <uint>state.offlineProjectileTargetIds[index] ||
            <float>state.offlineProjectileTtls[index] <= 0.0 ||
            <float>state.offlineProjectileTtls[index] > projectileTravel.projectileMaxFlight()) {
            return false;
        }
        var wand = <bool>state.offlineProjectileWands[index];
        var school = <uint>state.offlineProjectileSchoolCodes[index];
        var abilityCode = <uint>state.offlineProjectileAbilityCodes[index];
        var rank = <uint>state.offlineProjectileRanks[index];
        var castTime = <float>state.offlineProjectileCastTimes[index];
        if (abilityCode == frostboltAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FROST ||
                !frostboltProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == shadowBoltAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !shadowBoltProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == wrathAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !wrathProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == starfireAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
                !starfireProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == entanglingRootsAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !entanglingRootsProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == searingPainAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                !searingPainProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == shadowburnAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !shadowburnProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == conflagrateAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                !conflagrateProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == immolateAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                !immolateProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == fireballAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                !fireballProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == earthShockAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !earthShockProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == frostShockAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FROST ||
                !frostShockProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == flameShockAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                !flameShockProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == moonfireAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
                !moonfireProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == serpentStingAbilityCode() ||
            abilityCode == insectSwarmAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !pureDotProjectileProfileIsValid(
                    abilityCode,
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == shadowWordPainAbilityCode() ||
            abilityCode == corruptionAbilityCode() ||
            abilityCode == curseOfAgonyAbilityCode() ||
            abilityCode == siphonLifeAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !pureDotProjectileProfileIsValid(
                    abilityCode,
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == drainLifeAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !drainLifeProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == hibernateAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !hibernateProjectileProfileIsValid(rank, castTime) ||
                <float>state.offlineProjectileMinimums[index] != 0.0 ||
                <float>state.offlineProjectileMaximums[index] != 0.0 ||
                <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == fearAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !fearProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode != <uint>0 || rank != <uint>0 || castTime != 0.0) {
            return false;
        } else if (offlineEmberkinFireboltProjectileProfileIsValid(state, index)) {
            // Emberkin Firebolt is an ability-code-zero spell projectile. The
            // template-owned source profile disambiguates it from player shots.
        } else if (wand) {
            if (school != OFFLINE_PROJECTILE_SCHOOL_ARCANE &&
                school != OFFLINE_PROJECTILE_SCHOOL_HOLY &&
                school != OFFLINE_PROJECTILE_SCHOOL_SHADOW &&
                school != OFFLINE_PROJECTILE_SCHOOL_NATURE) {
                return false;
            }
            if (<float>state.offlineProjectileMinimums[index] != 3.0 ||
                <float>state.offlineProjectileMaximums[index] != 6.0 ||
                <float>state.offlineProjectileSpeeds[index] != 1.8) {
                return false;
            }
        } else if (school != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL ||
            <float>state.offlineProjectileMinimums[index] != 5.0 ||
            <float>state.offlineProjectileMaximums[index] != 9.0 ||
            <float>state.offlineProjectileSpeeds[index] != 2.3) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

offlineDotStateIsValid(state: WorldState): bool {
    var effects = %import("generated/m4_ability_effects");
    var count = state.offlineDotTargetIds.length;
    if (count != state.offlineDotSourceIds.length ||
        count != state.offlineDotAbilityCodes.length ||
        count != state.offlineDotDamages.length ||
        count != state.offlineDotRanks.length ||
        count != state.offlineDotSnapshotPowers.length ||
        count != state.offlineDotRemaining.length ||
        count != state.offlineDotDurations.length ||
        count != state.offlineDotTickIntervals.length ||
        count != state.offlineDotTickTimers.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineDotTargetIds[index];
        var sourceId = <uint>state.offlineDotSourceIds[index];
        var duration = <float>state.offlineDotDurations[index];
        var interval = <float>state.offlineDotTickIntervals[index];
        var remaining = <float>state.offlineDotRemaining[index];
        var timer = <float>state.offlineDotTickTimers[index];
        var abilityCode = <uint>state.offlineDotAbilityCodes[index];
        var rank = <uint>state.offlineDotRanks[index];
        var snapshotPower = <int>state.offlineDotSnapshotPowers[index];
        var pureDotIndex = pureDotAbilityIndex(abilityCode);
        var profileIsValid = abilityCode == fireballAbilityCode() ?
            rank == <uint>0 && snapshotPower == 0 &&
                fireballDotProfileIsValid(<int>state.offlineDotDamages[index], duration, interval) :
            abilityCode == immolateAbilityCode() ?
                rank == <uint>0 && snapshotPower == 0 &&
                    immolateDotProfileIsValid(
                        <int>state.offlineDotDamages[index], duration, interval
                    ) :
            abilityCode == rakeAbilityCode() ?
                rank == <uint>0 && snapshotPower == 0 &&
                    rakeDotProfileIsValid(
                        <int>state.offlineDotDamages[index], duration, interval
                    ) :
            abilityCode == flameShockAbilityCode() ?
                rank == <uint>0 && snapshotPower == 0 &&
                    flameShockDotProfileIsValid(
                        <int>state.offlineDotDamages[index], duration, interval
                    ) :
            abilityCode == moonfireAbilityCode() ?
                rank == <uint>0 && snapshotPower == 0 &&
                    moonfireDotProfileIsValid(
                        <int>state.offlineDotDamages[index], duration, interval
                    ) :
            abilityCode == entanglingRootsAbilityCode() ?
                entanglingRootsDotProfileIsValid(
                    rank,
                    snapshotPower,
                    <int>state.offlineDotDamages[index],
                    duration,
                    interval
                ) :
                pureDotIndex >= 0 ? numericEffects.pureDotProfileMatches(
                    pureDotIndex,
                    <int>rank,
                    snapshotPower,
                    <int>state.offlineDotDamages[index],
                    duration,
                    interval
                ) && (abilityCode != siphonLifeAbilityCode() ||
                    effects.metric(pureDotIndex, <int>rank, 0, "leechPct") == 1.0) : false;
        if (targetId == <uint>0 || sourceId == <uint>0 || targetId == sourceId ||
            !profileIsValid || remaining <= 0.0 || remaining > duration || timer <= 0.0 ||
            timer > interval) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// WOS64 makes new pure-HoT rows reconstructable from rank plus application-time
// spell power. Rank zero is reserved for migrated WOS60-WOS63 Rejuvenation rows:
// their resolved value remains authoritative because the historic payload did
// not contain enough information to recover one exact old spell-power value.
offlineHotStateIsValid(state: WorldState): bool {
    var count = state.offlineHotTargetIds.length;
    if (count != state.offlineHotSourceIds.length ||
        count != state.offlineHotAbilityCodes.length ||
        count != state.offlineHotHeals.length ||
        count != state.offlineHotRanks.length ||
        count != state.offlineHotSnapshotPowers.length ||
        count != state.offlineHotRemaining.length ||
        count != state.offlineHotDurations.length ||
        count != state.offlineHotTickIntervals.length ||
        count != state.offlineHotTickTimers.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineHotTargetIds[index];
        var sourceId = <uint>state.offlineHotSourceIds[index];
        var duration = <float>state.offlineHotDurations[index];
        var interval = <float>state.offlineHotTickIntervals[index];
        var remaining = <float>state.offlineHotRemaining[index];
        var timer = <float>state.offlineHotTickTimers[index];
        var abilityCode = <uint>state.offlineHotAbilityCodes[index];
        var rank = <int><uint>state.offlineHotRanks[index];
        var snapshotPower = <int>state.offlineHotSnapshotPowers[index];
        var abilityIndex = pureHotAbilityIndex(abilityCode);
        var profileIsValid = false;
        if (rank == 0) {
            profileIsValid = abilityCode == rejuvenationAbilityCode() &&
                rejuvenationHotProfileIsValid(
                    <int>state.offlineHotHeals[index], duration, interval
                );
        } else if (abilityIndex >= 0) {
            profileIsValid = pureHotProfiles.pureHotProfileMatches(
                abilityIndex, rank, snapshotPower, <int>state.offlineHotHeals[index],
                duration, interval
            );
        } else if (abilityCode == regrowthAbilityCode()) {
            var regrowthIndex = m4AbilityCatalog.indexOf("regrowth");
            profileIsValid = snapshotPower == 0 &&
                hybridHotProfiles.hybridHotProfileMatches(
                    regrowthIndex, rank, <int>state.offlineHotHeals[index], duration, interval
                );
        }
        if (targetId == <uint>0 || sourceId == <uint>0 || !profileIsValid ||
            remaining <= 0.0 || remaining > duration || timer <= 0.0 || timer > interval) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// WOS65 retains only Power Word Shield's ordinary absorb aura. The bounded
// global row order is also its source damage-consumption order.
offlineAbsorbStateIsValid(state: WorldState): bool {
    var count = state.offlineAbsorbTargetIds.length;
    if (count != state.offlineAbsorbSourceIds.length ||
        count != state.offlineAbsorbAbilityCodes.length ||
        count != state.offlineAbsorbRanks.length ||
        count != state.offlineAbsorbAmounts.length ||
        count != state.offlineAbsorbRemaining.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var shieldIndex = m4AbilityCatalog.indexOf("power_word_shield");
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineAbsorbTargetIds[index];
        var sourceId = <uint>state.offlineAbsorbSourceIds[index];
        var abilityCode = <uint>state.offlineAbsorbAbilityCodes[index];
        var rank = <int><uint>state.offlineAbsorbRanks[index];
        if (targetId == <uint>0 || sourceId == <uint>0 || shieldIndex < 0 ||
            abilityCode != powerWordShieldAbilityCode() ||
            !absorbProfiles.absorbProfileMatches(
                shieldIndex,
                rank,
                <int>state.offlineAbsorbAmounts[index],
                <float>state.offlineAbsorbRemaining[index]
            )) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.offlineAbsorbTargetIds[prior] == targetId &&
                <uint>state.offlineAbsorbSourceIds[prior] == sourceId &&
                <uint>state.offlineAbsorbAbilityCodes[prior] == abilityCode) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

// WOS61 retains only the source-pinned Consecration GroundAoE profile. Its
// damage rider is already resolved from application-time spell power.
offlineGroundEffectStateIsValid(state: WorldState): bool {
    var count = state.offlineGroundEffectSourceIds.length;
    if (count != state.offlineGroundEffectAbilityCodes.length ||
        count != state.offlineGroundEffectX.length ||
        count != state.offlineGroundEffectZ.length ||
        count != state.offlineGroundEffectRadii.length ||
        count != state.offlineGroundEffectMinimums.length ||
        count != state.offlineGroundEffectMaximums.length ||
        count != state.offlineGroundEffectSpellPowerBonuses.length ||
        count != state.offlineGroundEffectRemaining.length ||
        count != state.offlineGroundEffectIntervals.length ||
        count != state.offlineGroundEffectTickTimers.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        if (<uint>state.offlineGroundEffectSourceIds[index] == <uint>0 ||
            <uint>state.offlineGroundEffectAbilityCodes[index] != consecrationAbilityCode() ||
            <float>state.offlineGroundEffectRadii[index] != 8.0 ||
            <float>state.offlineGroundEffectMinimums[index] != 28.0 ||
            <float>state.offlineGroundEffectMaximums[index] != 34.0 ||
            <float>state.offlineGroundEffectSpellPowerBonuses[index] < 0.0 ||
            <float>state.offlineGroundEffectRemaining[index] <= 0.0 ||
            <float>state.offlineGroundEffectRemaining[index] > 10.0 ||
            <float>state.offlineGroundEffectIntervals[index] != 2.0 ||
            <float>state.offlineGroundEffectTickTimers[index] <= 0.0 ||
            <float>state.offlineGroundEffectTickTimers[index] > 2.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

