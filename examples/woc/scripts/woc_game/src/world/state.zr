    pub var lootRollCandidatePlayerIds: container.Array<uint>;
    pub var lootRollCandidateChoiceCodes: container.Array<uint>;
    pub var lootRollCandidateValues: container.Array<uint>;
    // WOS71 snapshots source party loot eligibility at mob death and persists
    // the party-owned poor/common round-robin cursor. Recipient order is the
    // source party-members order, independent of later movement or regrouping.
    pub var partyLootTurnPartyIds: container.Array<uint>;
    pub var partyLootTurnValues: container.Array<uint>;
    pub var corpseLootRecipientMobIds: container.Array<uint>;
    pub var corpseLootRecipientPlayerIds: container.Array<uint>;
    pub var corpseLootRecipientOrders: container.Array<uint>;
    // WOS19 keeps the source's personal optional preference separate from the
    // party-owned selection. A party value is duplicated across its rows so it
    // remains in the transaction without a second mutable object graph.
    pub var entityDungeonDifficultyPersonalHeroic: container.Array<bool>;
    pub var entityPartyDungeonDifficultyHeroic: container.Array<bool>;
    // WOS20 stores the Sim-internal ready-check map as aligned party-member
    // rows. The source keeps only one check per party; duplicating its shared
    // metadata lets fixedTick reconstruct the candidate solely from WOS bytes.
    // Response values are pending=0, ready=1, and not-ready=2.
    pub var entityReadyCheckPartyIds: container.Array<uint>;
    pub var entityReadyCheckInitiatorIds: container.Array<uint>;
    pub var entityReadyCheckEndsAtMicros: container.Array<uint>;
    pub var entityReadyCheckResponses: container.Array<uint>;
    // WOS78 retains the Sim-side chat token bucket. Absent rows are canonical
    // zero state; a present row stores tokens in [0,8] and its last refill time.
    pub var entityChatTokenBucketPresent: container.Array<bool>;
    pub var entityChatTokenBuckets: container.Array<float>;
    pub var entityChatTokenAtMicros: container.Array<uint>;
    // WOS21 retains only the current-source arena queue admission state. The
    // unit order identifies an atomic solo/premade queue entry and stays
    // independent from mutable party membership after the entry is created.
    pub var nextArenaQueueUnitOrder: uint;
    // Stored formats are wire-format-plus-one: 0 means not queued, then
    // 1=1v1, 2=2v2, 3=Fiesta, 4=Yumi3 and 5=Yumi5.
    pub var entityArenaQueueFormats: container.Array<uint>;
    pub var entityArenaQueueUnitOrders: container.Array<uint>;
    // Member order is snapshotted from the premade when it enters a unit, so a
    // later party mutation cannot change the source queue's stored pids order.
    pub var entityArenaQueueMemberOrders: container.Array<uint>;
    // Source PlayerMeta owns two ranked ladders. Fiesta and Yumi use the
    // primary ladder for queue rating while 2v2 uses its dedicated ladder.
    pub var entityArenaRatings: container.Array<int>;
    pub var entityArenaWins: container.Array<int>;
    pub var entityArenaLosses: container.Array<int>;
    pub var entityArena2v2Ratings: container.Array<int>;
    pub var entityArena2v2Wins: container.Array<int>;
    pub var entityArena2v2Losses: container.Array<int>;
    // Team-format queues freeze arenaTeamRating at admission, matching the
    // source ArenaQueueUnit.rating rather than re-averaging at match time.
    pub var entityArenaQueueRatings: container.Array<float>;
    pub var entityThreatOffsets: container.Array<uint>;
    pub var entityThreatTargetIds: container.Array<uint>;
    pub var entityThreatValues: container.Array<float>;
    // WOS17 retains one opaque Card Duel service snapshot. The social module
    // retains match rules and queue state so no mutable object crosses the
    // ZrVM/plugin host boundary.
    pub var cardDuelStateBytes: container.Array<uint>;

