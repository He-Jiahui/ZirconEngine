        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>103 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>13)] == <uint>121;
}

siphonLifeAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("siphon_life");
    var abilityIndex = m4AbilityCatalog.indexOf("siphon_life");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "siphon_life") {
        throw "Siphon Life is absent from the current ability catalog";
    }
    return code;
}

siphonLifePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>11 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>101;
}

pureDotAbilityIndex(abilityCode: uint): int {
    if (abilityCode == serpentStingAbilityCode()) {
        return m4AbilityCatalog.indexOf("serpent_sting");
    }
    if (abilityCode == shadowWordPainAbilityCode()) {
        return m4AbilityCatalog.indexOf("shadow_word_pain");
    }
    if (abilityCode == corruptionAbilityCode()) {
        return m4AbilityCatalog.indexOf("corruption");
    }
    if (abilityCode == curseOfAgonyAbilityCode()) {
        return m4AbilityCatalog.indexOf("curse_of_agony");
    }
    if (abilityCode == siphonLifeAbilityCode()) {
        return m4AbilityCatalog.indexOf("siphon_life");
    }
    if (abilityCode == insectSwarmAbilityCode()) {
        return m4AbilityCatalog.indexOf("insect_swarm");
    }
    if (abilityCode == ripAbilityCode()) {
        return m4AbilityCatalog.indexOf("rip");
    }
    return -1;
}

// Every pure DoT retains an explicit rank-to-learn-level mapping so a saved
// projectile can prove both its rank and its source cast profile after load.
pureDotRankLevel(abilityCode: uint, rank: uint): int {
    if (abilityCode == serpentStingAbilityCode() ||
        abilityCode == shadowWordPainAbilityCode()) {
        if (rank == <uint>1) { return 4; }
        if (rank == <uint>2) { return 10; }
        if (rank == <uint>3) { return 16; }
        return 0;
    }
    if (abilityCode == corruptionAbilityCode()) {
        if (rank == <uint>1) { return 4; }
        if (rank == <uint>2) { return 12; }
        if (rank == <uint>3) { return 18; }
    }
    if (abilityCode == curseOfAgonyAbilityCode()) {
        if (rank == <uint>1) { return 8; }
        if (rank == <uint>2) { return 14; }
        if (rank == <uint>3) { return 20; }
    }
    if (abilityCode == siphonLifeAbilityCode() && rank == <uint>1) {
        return 10;
    }
    if (abilityCode == insectSwarmAbilityCode() && rank == <uint>1) {
        return 20;
    }
    if (abilityCode == ripAbilityCode() && rank == <uint>1) {
        return 14;
    }
    return 0;
}

pureDotProjectileProfileIsValid(
    abilityCode: uint,
    rank: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = pureDotAbilityIndex(abilityCode);
    var level = pureDotRankLevel(abilityCode, rank);
    return abilityCode != ripAbilityCode() && abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rank &&
        effects.count(abilityIndex, <int>rank) == 1 &&
        effects.typeAt(abilityIndex, <int>rank, 0) == "dot" &&
        minimum == 0.0 && maximum == 0.0 &&
        castTime == m4AbilityCatalog.metric(abilityIndex, level, "castTime") &&
        (abilityCode != siphonLifeAbilityCode() ||
            effects.metric(abilityIndex, <int>rank, 0, "leechPct") == 1.0);
}

pureDotTargetIndex(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    abilityIndex: int
): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex] ||
        abilityIndex < 0) {
        return -1;
    }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var distanceSquared = dx * dx + dz * dz;
    var maximumRange = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var minimumRange = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "minRange"
    );
    // Eastbrook has clear line of sight in the retained outdoor slice. The
    // source still requires its target-facing arc before a zero-cast spell is
    // admitted, so preserve that phase rather than accepting rear casts.
    return maximumRange > 0.0 && distanceSquared <= maximumRange * maximumRange &&
        distanceSquared >= minimumRange * minimumRange &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <=
            OFFLINE_SOURCE_TARGET_FACING_HALF_ARC ? targetIndex : -1;
}

pureDotGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS /
        mageSpellHasteMultiplier(state, casterIndex);
    return gcd < OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS ?
        OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS : gcd;
}

startOfflinePureDotCast(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    abilityCode: uint
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = pureDotAbilityIndex(abilityCode);
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || effects.count(abilityIndex, rank) != 1 ||
        effects.typeAt(abilityIndex, rank, 0) != "dot" ||
        <float>state.entityResources[casterIndex] < cost ||
        pureDotTargetIndex(state, casterIndex, targetId, abilityIndex) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = pureDotGlobalCooldownSeconds(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        0.0,
        0.0,
        projectileTravel.projectileSpeed(),
        false,
        offlineProjectileSchoolCode(m4AbilityCatalog.text(abilityIndex, "school")),
        abilityCode,
        <uint>rank,
        0.0
    );
}

startOfflineSerpentStingCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, serpentStingAbilityCode());
}

startOfflineShadowWordPainCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, shadowWordPainAbilityCode());
}

startOfflineCurseOfAgonyCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, curseOfAgonyAbilityCode());
}

startOfflineSiphonLifeCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, siphonLifeAbilityCode());
}

startOfflineInsectSwarmCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, insectSwarmAbilityCode());
}

fireballAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("fireball");
    var abilityIndex = m4AbilityCatalog.indexOf("fireball");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "fireball") {
        throw "Fireball is absent from the current ability catalog";
    }
    return code;
}

fireballPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>8 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>98 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>108;
}

fireballRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 1; }
    if (rank == <uint>2) { return 6; }
    if (rank == <uint>3) { return 12; }
    if (rank == <uint>4) { return 18; }
    return 0;
}

fireballProjectileProfileIsValid(
    rankCode: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("fireball");
    var level = fireballRankLevel(rankCode);
    if (abilityIndex < 0 || level <= 0 ||
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) != <int>rankCode ||
        m4AbilityEffects.typeAt(abilityIndex, <int>rankCode, 0) != "directDamage" ||
        m4AbilityEffects.typeAt(abilityIndex, <int>rankCode, 1) != "dot") {
        return false;
    }
    return minimum == m4AbilityEffects.metric(abilityIndex, <int>rankCode, 0, "min") &&
        maximum == m4AbilityEffects.metric(abilityIndex, <int>rankCode, 0, "max") &&
        castTime == m4AbilityCatalog.metric(abilityIndex, level, "castTime");
}

fireballDotProfileIsValid(damage: int, duration: float, interval: float): bool {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("fireball");
    var rank = 1;
    while (rank <= 4) {
        var level = fireballRankLevel(<uint>rank);
        if (abilityIndex >= 0 && level > 0 &&
            m4AbilityCatalog.rankAtLevel(abilityIndex, level) == rank &&
            m4AbilityEffects.typeAt(abilityIndex, rank, 1) == "dot") {
            var expectedDuration = m4AbilityEffects.metric(abilityIndex, rank, 1, "duration");
            var expectedInterval = m4AbilityEffects.metric(abilityIndex, rank, 1, "interval");
            var expectedDamage = <int>(m4AbilityEffects.metric(
                abilityIndex, rank, 1, "total"
            ) / (expectedDuration / expectedInterval) + 0.5);
            if (expectedDamage < 1) { expectedDamage = 1; }
            var overloadDamage = <int>(offlineOverloadScaledPositiveMetric(
                m4AbilityEffects.metric(abilityIndex, rank, 1, "total"), 1.4
            ) / (expectedDuration / expectedInterval) + 0.5);
            if (overloadDamage < 1) { overloadDamage = 1; }
            if ((damage == expectedDamage || damage == overloadDamage) &&
                duration == expectedDuration &&
                interval == expectedInterval) {
                return true;
            }
        }
        rank = rank + 1;
    }
    return false;
}

fireballTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("fireball");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

fireballCompletionTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("fireball");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

fireballCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

fireballGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 1.0 ? 1.0 : gcd;
}

// Aether Surge owns its retained charge/free/Perfect Moment aura representation here.
// Numeric charge decisions remain in the source-pinned combat module.
aetherSurgeAurasForEntity(
    state: WorldState, casterIndex: int
): container.Array<aetherSurge.SurgeAura> {
    var auras = new container.Array<aetherSurge.SurgeAura>();
    if (<int>state.entityAetherSurgeCharges[casterIndex] > 0 &&
        <float>state.entityAetherSurgeChargeRemaining[casterIndex] > 0.0) {
        auras.add(new aetherSurge.SurgeAura(
            aetherSurgeContract.surgeId(), <int>state.entityAetherSurgeCharges[casterIndex]
        ));
    }
    if (<float>state.entityAetherSurgeFreeRemaining[casterIndex] > 0.0) {
        auras.add(new aetherSurge.SurgeAura(aetherSurgeContract.freeId(), 0));
    }
    if (<float>state.entityAetherSurgePerfectMomentRemaining[casterIndex] > 0.0) {
        auras.add(new aetherSurge.SurgeAura(
            aetherSurgeContract.perfectMomentId(), 0
        ));
    }
    return auras;
}

perfectMomentProfileIsValid(abilityCode: uint, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("perfect_moment");
    return abilityCode == perfectMomentAbilityCode() && abilityIndex >= 0 &&
        level >= 10 && m4AbilityCatalog.rankAtLevel(abilityIndex, level) == 1 &&
        m4AbilityCatalog.metric(abilityIndex, level, "learnLevel") == 10.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 120.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 0.0 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "mage" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "arcane" &&
        !m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        m4AbilityCatalog.flag(abilityIndex, "offGcd") &&
        effects.typeAt(abilityIndex, 1, 0) == "perfectMoment";
}

// Perfect Moment is off-GCD but, like the source, remains unavailable while a
// normal cast is in flight. Its charge and anti-consumption auras are separate.
startOfflinePerfectMomentCast(state: WorldState, casterIndex: int): void {
    var abilityCode = perfectMomentAbilityCode();
    if (!state.offlineSessionActive ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        !perfectMomentProfileIsValid(
            abilityCode, <int>state.entityLevels[casterIndex]
        )) {
        return;
    }
    state.entityCastTargetIds[casterIndex] = <uint>0;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityAetherSurgeCharges[casterIndex] = aetherSurgeContract.maxCharges();
    state.entityAetherSurgeChargeRemaining[casterIndex] = aetherSurgeContract.perfectMomentDuration();
    state.entityAetherSurgePerfectMomentRemaining[casterIndex] = aetherSurgeContract.perfectMomentDuration();
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode, state.timeMicros + <uint>120000000
    );
}

temporalRewindAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("temporal_rewind");
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_rewind");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "temporal_rewind") {
        throw "Temporal Rewind is absent from the current ability catalog";
    }
    return code;
}

temporalRewindProfileIsValid(abilityCode: uint, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var contract = %import("generated/rewind_contract");
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_rewind");
    var rank = abilityIndex < 0 ? 0 : m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    return abilityCode == temporalRewindAbilityCode() && abilityIndex >= 0 && rank == 1 &&
        m4AbilityCatalog.metric(abilityIndex, level, "learnLevel") ==
            <float>contract.learnLevel(true) &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") ==
            <float>contract.resourceCost(true) &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") ==
            contract.castTimeSeconds(true) &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") ==
            <float>contract.cooldownSeconds(true) &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == contract.range(true) &&
        m4AbilityCatalog.text(abilityIndex, "class") == "mage" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "arcane" &&
        !m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        effects.typeAt(abilityIndex, rank, 0) == "rewind" &&
        effects.metric(abilityIndex, rank, 0, "fraction") ==
            <float>contract.fractionPercent(true) / 100.0 &&
        effects.metric(abilityIndex, rank, 0, "maxHpFraction") ==
            <float>contract.maxHpFractionPercent(true) / 100.0 &&
        effects.metric(abilityIndex, rank, 0, "windowSec") ==
            <float>contract.windowSeconds(true) &&
        effects.metric(abilityIndex, rank, 0, "radius") == contract.radius(true);
}

// This is the live WorldState counterpart to livingGroupRaidInRadius. It
// returns entity indexes in ascending stable entity-id order, not row order.
temporalRewindTargetIndices(
    state: WorldState, casterIndex: int, radius: float
): container.Array<int> {
    var candidates = new container.Array<int>();
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || radius < 0.0) {
        return candidates;
    }
    var partyId = partyIdForIndex(state, casterIndex);
    var radiusSquared = radius * radius;
    var index = 0;
    while (index < state.entityIds.length) {
        var sameGroup = partyId == <uint>0 ? index == casterIndex :
            <uint>state.entityPartyIds[index] == partyId;
        if (sameGroup && <uint>state.entityKinds[index] == <uint>1 &&
            !<bool>state.entityDead[index]) {
            var dx = <float>state.entityX[index] - <float>state.entityX[casterIndex];
            var dz = <float>state.entityZ[index] - <float>state.entityZ[casterIndex];
            if (dx * dx + dz * dz <= radiusSquared) { candidates.add(index); }
        }
        index = index + 1;
    }
    var outer = 0;
    while (outer < candidates.length) {
        var inner = 0;
        while (inner + 1 < candidates.length) {
            var leftIndex = <int>candidates[inner];
            var rightIndex = <int>candidates[inner + 1];
            if (<uint>state.entityIds[leftIndex] > <uint>state.entityIds[rightIndex]) {
                candidates[inner] = rightIndex;
                candidates[inner + 1] = leftIndex;
            }
            inner = inner + 1;
        }
        outer = outer + 1;
    }
    return candidates;
}

// Rewind deliberately reaches the resolved-heal transaction directly: it has
// no numeric range roll, cannot critically strike, and cannot consume Power
// Echo or trigger Arcane damage conversion.
applyOfflineTemporalRewind(state: WorldState, casterIndex: int): void {
    var contract = %import("generated/rewind_contract");
    var rewind = %import("combat/rewind_state");
    var targets = temporalRewindTargetIndices(
        state, casterIndex, contract.radius(true)
    );
    for (var targetIndex in targets) {
        var targetId = <uint>state.entityIds[targetIndex];
        var amount = rewind.rewindHealAmount(
            offlineRewindDamageTaken(state, targetId),
            <int>state.entityHp[targetIndex], <int>state.entityMaxHp[targetIndex],
            contract.fractionPercent(true), contract.maxHpFractionPercent(true)
        );
        if (amount > 0) {
            applyOfflineResolvedDirectHeal(
                state, casterIndex, targetId, targetIndex, <float>amount
            );
        }
    }
}

startOfflineTemporalRewindCast(state: WorldState, casterIndex: int): void {
    var contract = %import("generated/rewind_contract");
    var abilityCode = temporalRewindAbilityCode();
    if (!state.offlineSessionActive || casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        !temporalRewindProfileIsValid(abilityCode, <int>state.entityLevels[casterIndex]) ||
        <float>state.entityResources[casterIndex] < contract.resourceCost(true) ||
        !offlineRewindDamageStateIsValid(state)) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = arcanePowerGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>0;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, contract.resourceCost(true));
    applyOfflineTemporalRewind(state, casterIndex);
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(contract.cooldownSeconds(true) * 1000000)
    );
}

temporalAccelerationProfileIsValid(abilityCode: uint, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_acceleration");
    var rank = abilityIndex < 0 ? 0 : m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    return abilityCode == temporalAccelerationAbilityCode() && abilityIndex >= 0 &&
        rank == 1 && m4AbilityCatalog.metric(abilityIndex, level, "learnLevel") == 20.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 120.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 300.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 0.0 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "mage" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "arcane" &&
        !m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        effects.typeAt(abilityIndex, rank, 0) == "aoeAllyHaste" &&
        effects.metric(abilityIndex, rank, 0, "mult") == 1.3 &&
        effects.metric(abilityIndex, rank, 0, "duration") == 15.0 &&
        effects.metric(abilityIndex, rank, 0, "radius") == 40.0 &&
        effects.flag(abilityIndex, rank, 0, "spell") &&
        effects.flag(abilityIndex, rank, 0, "exhaust") &&
        effects.flag(abilityIndex, rank, 0, "groupOnly");
}

groupHasteCandidateIndices(
    state: WorldState, casterIndex: int, radius: float
): container.Array<int> {
    var candidates = new container.Array<int>();
    var partyId = partyIdForIndex(state, casterIndex);
    var index = 0;
    while (index < state.entityIds.length) {
        var sameGroup = partyId == <uint>0 ? index == casterIndex :
            <uint>state.entityPartyIds[index] == partyId;
        if (sameGroup && <uint>state.entityKinds[index] == <uint>1 &&
            !<bool>state.entityDead[index]) {
            var dx = <float>state.entityX[index] - <float>state.entityX[casterIndex];
            var dz = <float>state.entityZ[index] - <float>state.entityZ[casterIndex];
            if (dx * dx + dz * dz <= radius * radius) { candidates.add(index); }
        }
        index = index + 1;
    }
    return candidates;
}

startOfflineTemporalAccelerationCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var groupHaste = %import("combat/group_haste_state");
    var abilityCode = temporalAccelerationAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_acceleration");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        !groupHasteStateIsValid(state)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!temporalAccelerationProfileIsValid(abilityCode, level) ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    // The generic cast lifecycle applies normal GCD before this instant haste
    // aura changes the caster's spell-speed multiplier.
    var cast = loadCastingState(state, casterIndex);
    var preBuffGcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    if (preBuffGcd > cast.gcdRemaining) { cast.gcdRemaining = preBuffGcd; }
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>0;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);

    var candidates = new container.Array<groupHaste.GroupHasteTarget>();
    var candidateIndices = groupHasteCandidateIndices(
        state, casterIndex, effects.metric(abilityIndex, rank, 0, "radius")
    );
    for (var candidateIndex in candidateIndices) {
        candidates.add(new groupHaste.GroupHasteTarget(
            <int><uint>state.entityIds[candidateIndex],
            <float>state.entitySatedRemaining[candidateIndex] > 0.0
        ));
    }
    var applications = groupHaste.planGroupHaste(candidates, new groupHaste.GroupHasteParams(
        effects.metric(abilityIndex, rank, 0, "mult"),
        effects.metric(abilityIndex, rank, 0, "duration"),
        effects.flag(abilityIndex, rank, 0, "spell"),
        effects.flag(abilityIndex, rank, 0, "exhaust")
    ));
    for (var application in applications) {
        var targetIndex = partyEntityIndexById(state, <uint>application.targetId);
        if (targetIndex < 0) { throw "woc group haste target disappeared"; }
        state.entityGroupHasteRemaining[targetIndex] =
            effects.metric(abilityIndex, rank, 0, "duration");
        state.entityGroupHasteAttackBonuses[targetIndex] =
            application.attackHasteValue - 1.0;
        state.entityGroupHasteSpellBonuses[targetIndex] =
            application.addSpellHaste ? application.spellHasteValue : 0.0;
        if (application.addSated) {
            state.entitySatedRemaining[targetIndex] = application.satedDuration;
        }
    }
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode, state.timeMicros + <uint>300000000
    );
}

temporalHourglassProfileIsValid(abilityCode: uint, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_hourglass");
    var rank = abilityIndex < 0 ? 0 : m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    return abilityCode == temporalHourglassAbilityCode() && abilityIndex >= 0 && rank == 1 &&
        m4AbilityCatalog.metric(abilityIndex, level, "learnLevel") == 14.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 110.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 50.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 28.0 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "mage" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "arcane" &&
        m4AbilityCatalog.text(abilityIndex, "targetMode") == "position" &&
        !m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        effects.count(abilityIndex, rank) == 1 &&
        effects.typeAt(abilityIndex, rank, 0) == "temporalHourglass" &&
        effects.metric(abilityIndex, rank, 0, "duration") == 5.0 &&
        effects.metric(abilityIndex, rank, 0, "hostilePveDuration") == 60.0 &&
        effects.metric(abilityIndex, rank, 0, "hostilePvpDuration") == 10.0 &&
        effects.metric(abilityIndex, rank, 0, "groundDuration") == 30.0 &&
        effects.metric(abilityIndex, rank, 0, "selfRadius") == 1.75 &&
        effects.metric(abilityIndex, rank, 0, "captureRadius") == 1.75 &&
        effects.metric(abilityIndex, rank, 0, "healMaxHpPct") == 0.3 &&
        effects.metric(abilityIndex, rank, 0, "selfCooldownRate") == 2.0 &&
        effects.metric(abilityIndex, rank, 0, "allyCooldownRate") == 1.75;
}

temporalHourglassActionSuppressed(state: WorldState, entityIndex: int): bool {
    return entityIndex >= 0 && entityIndex < state.entityIds.length &&
        <uint>state.entityTemporalHourglassModes[entityIndex] != <uint>0 &&
        <float>state.entityTemporalHourglassRemaining[entityIndex] > 0.0;
}

temporalHourglassProtectsDamage(state: WorldState, entityIndex: int): bool {
    return temporalHourglassActionSuppressed(state, entityIndex) &&
        <uint>state.entityTemporalHourglassModes[entityIndex] == <uint>1;
}

clearOfflineTemporalHourglass(state: WorldState, entityIndex: int): void {
    state.entityTemporalHourglassRemaining[entityIndex] = 0.0;
    state.entityTemporalHourglassModes[entityIndex] = <uint>0;
    state.entityTemporalHourglassCooldownRates[entityIndex] = 0.0;
    state.entityTemporalHourglassHealRemaining[entityIndex] = 0;
    state.entityTemporalHourglassHealTicksRemaining[entityIndex] = 0;
    state.entityTemporalHourglassHealTickTimers[entityIndex] = 0.0;
}

applyOfflineProtectiveTemporalHourglass(
    state: WorldState, targetIndex: int, duration: float, cooldownRate: float, healFraction: float
): void {
    var cast = loadCastingState(state, targetIndex);
    if (cast.castingAbility != <uint>0) { casting.cancelCast(cast); }
    storeCastingState(state, targetIndex, cast);
    state.entityAutoAttack[targetIndex] = false;
    state.entityTemporalHourglassRemaining[targetIndex] = duration;
    state.entityTemporalHourglassModes[targetIndex] = <uint>1;
    state.entityTemporalHourglassCooldownRates[targetIndex] = cooldownRate;
    state.entityTemporalHourglassHealRemaining[targetIndex] = <int>(
        <int>state.entityMaxHp[targetIndex] * healFraction + 0.5
    );
    state.entityTemporalHourglassHealTicksRemaining[targetIndex] = <int>(duration + 0.5);
    state.entityTemporalHourglassHealTickTimers[targetIndex] = 1.0;
}

applyOfflineHostileTemporalHourglass(
    state: WorldState, targetIndex: int, duration: float
): void {
    var cast = loadCastingState(state, targetIndex);
    if (cast.castingAbility != <uint>0) { casting.cancelCast(cast); }
    storeCastingState(state, targetIndex, cast);
    state.entityAutoAttack[targetIndex] = false;
    state.entityTemporalHourglassRemaining[targetIndex] = duration;
    state.entityTemporalHourglassModes[targetIndex] = <uint>2;
    state.entityTemporalHourglassCooldownRates[targetIndex] = 0.0;
    state.entityTemporalHourglassHealRemaining[targetIndex] = 0;
    state.entityTemporalHourglassHealTicksRemaining[targetIndex] = 0;
    state.entityTemporalHourglassHealTickTimers[targetIndex] = 0.0;
}

appendOfflineTemporalHourglassGround(
    state: WorldState, sourceId: uint, x: float, z: float, radius: float, duration: float,
    protectiveDuration: float, hostilePveDuration: float, hostilePvpDuration: float,
    healFraction: float, selfCooldownRate: float, allyCooldownRate: float
): void {
    if (state.offlineTemporalHourglassSourceIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        return;
    }
    state.offlineTemporalHourglassSourceIds.add(sourceId);
    state.offlineTemporalHourglassX.add(x);
    state.offlineTemporalHourglassZ.add(z);
    state.offlineTemporalHourglassRadii.add(radius);
    state.offlineTemporalHourglassRemaining.add(duration);
    state.offlineTemporalHourglassProtectiveDurations.add(protectiveDuration);
    state.offlineTemporalHourglassHostilePveDurations.add(hostilePveDuration);
    state.offlineTemporalHourglassHostilePvpDurations.add(hostilePvpDuration);
    state.offlineTemporalHourglassHealFractions.add(healFraction);
    state.offlineTemporalHourglassSelfCooldownRates.add(selfCooldownRate);
    state.offlineTemporalHourglassAllyCooldownRates.add(allyCooldownRate);
    state.offlineTemporalHourglassCreatedTicks.add(state.tick);
}

// Source target order is self, then nearest living group ally, then nearest
// hostile. Empty space carries a short-lived first-contact selector instead.
applyOfflineTemporalHourglass(
    state: WorldState, casterIndex: int, aimX: float, aimZ: float,
    duration: float, hostilePveDuration: float, hostilePvpDuration: float, groundDuration: float,
    selfRadius: float, captureRadius: float, healFraction: float,
    selfCooldownRate: float, allyCooldownRate: float
): void {
    var selfDx = <float>state.entityX[casterIndex] - aimX;
    var selfDz = <float>state.entityZ[casterIndex] - aimZ;
    if (selfDx * selfDx + selfDz * selfDz <= selfRadius * selfRadius) {
        applyOfflineProtectiveTemporalHourglass(
            state, casterIndex, duration, selfCooldownRate, healFraction
        );
        return;
    }
    var partyId = partyIdForIndex(state, casterIndex);
    var allyIndex = -1;
    var allyDistance = 0.0;
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var dx = <float>state.entityX[entityIndex] - aimX;
        var dz = <float>state.entityZ[entityIndex] - aimZ;
        var distance = dx * dx + dz * dz;
        var validAlly = partyId != <uint>0 && entityIndex != casterIndex &&
            <uint>state.entityPartyIds[entityIndex] == partyId &&
            <uint>state.entityKinds[entityIndex] == <uint>1 &&
            !<bool>state.entityDead[entityIndex] && !<bool>state.entityHostile[entityIndex] &&
            distance <= captureRadius * captureRadius;
        if (validAlly && (allyIndex < 0 || distance < allyDistance ||
            (distance == allyDistance && <uint>state.entityIds[entityIndex] <
                <uint>state.entityIds[allyIndex]))) {
            allyIndex = entityIndex;
            allyDistance = distance;
        }
        entityIndex = entityIndex + 1;
    }
    if (allyIndex >= 0) {
        applyOfflineProtectiveTemporalHourglass(
            state, allyIndex, duration, allyCooldownRate, healFraction
        );
        return;
    }
    var hostileIndex = -1;
    var hostileDistance = 0.0;
    entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var hostileDx = <float>state.entityX[entityIndex] - aimX;
        var hostileDz = <float>state.entityZ[entityIndex] - aimZ;
        var hostileDistanceSq = hostileDx * hostileDx + hostileDz * hostileDz;
        if (!<bool>state.entityDead[entityIndex] && <bool>state.entityHostile[entityIndex] &&
            hostileDistanceSq <= captureRadius * captureRadius &&
            (hostileIndex < 0 || hostileDistanceSq < hostileDistance ||
                (hostileDistanceSq == hostileDistance && <uint>state.entityIds[entityIndex] <
                    <uint>state.entityIds[hostileIndex]))) {
            hostileIndex = entityIndex;
            hostileDistance = hostileDistanceSq;
        }
        entityIndex = entityIndex + 1;
    }
    if (hostileIndex >= 0) {
        applyOfflineHostileTemporalHourglass(state, hostileIndex, hostilePveDuration);
        enterOfflineSpellProjectileCombat(state, casterIndex, hostileIndex);
        return;
    }
    appendOfflineTemporalHourglassGround(
        state, <uint>state.entityIds[casterIndex], aimX, aimZ, captureRadius, groundDuration,
        duration, hostilePveDuration, hostilePvpDuration, healFraction,
        selfCooldownRate, allyCooldownRate
    );
}

startOfflineTemporalHourglassCast(
    state: WorldState, casterIndex: int, requestedX: float, requestedZ: float
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = temporalHourglassAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_hourglass");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        temporalHourglassActionSuppressed(state, casterIndex) ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        !temporalHourglassStateIsValid(state)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var range = m4AbilityCatalog.metric(abilityIndex, level, "range");
    if (!temporalHourglassProfileIsValid(abilityCode, level) ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    var aimX = requestedX;
    var aimZ = requestedZ;
    var deltaX = aimX - <float>state.entityX[casterIndex];
    var deltaZ = aimZ - <float>state.entityZ[casterIndex];
    var distance = math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
    if (distance > range && distance > 0.0) {
        aimX = <float>state.entityX[casterIndex] + deltaX * range / distance;
        aimZ = <float>state.entityZ[casterIndex] + deltaZ * range / distance;
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    applyOfflineTemporalHourglass(
        state, casterIndex, aimX, aimZ,
        effects.metric(abilityIndex, rank, 0, "duration"),
        effects.metric(abilityIndex, rank, 0, "hostilePveDuration"),
        effects.metric(abilityIndex, rank, 0, "hostilePvpDuration"),
        effects.metric(abilityIndex, rank, 0, "groundDuration"),
        effects.metric(abilityIndex, rank, 0, "selfRadius"),
        effects.metric(abilityIndex, rank, 0, "captureRadius"),
        effects.metric(abilityIndex, rank, 0, "healMaxHpPct"),
        effects.metric(abilityIndex, rank, 0, "selfCooldownRate"),
        effects.metric(abilityIndex, rank, 0, "allyCooldownRate")
    );
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode, state.timeMicros + <uint>50000000
    );
}

aetherSurgeTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_surge");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

aetherSurgeCompletionTargetIndex(
    state: WorldState, casterIndex: int, targetId: uint
): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_surge");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

aetherSurgeScaledCost(baseCost: int, profile: aetherSurge.SurgeProfile): int {
    var cost = <int>(<float>baseCost * profile.costMult + 0.5);
    return cost > 0 ? cost : 0;
}

aetherSurgeCastSeconds(
    state: WorldState, casterIndex: int, abilityIndex: int,
    profile: aetherSurge.SurgeProfile
): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) * profile.castMult / mageSpellHasteMultiplier(state, casterIndex);
}

startOfflineAetherSurgeCast(
    state: WorldState, casterIndex: int, targetId: uint
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = arcaneSurgeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_surge");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var profile = aetherSurge.profile(aetherSurgeAurasForEntity(state, casterIndex));
    var baseCost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var cost = <float>state.entityAetherSurgeFreeRemaining[casterIndex] > 0.0 ? 0 :
        aetherSurgeScaledCost(baseCost, profile);
    if (rank <= 0 || effects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        <float>state.entityResources[casterIndex] < cost ||
        aetherSurgeTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        aetherSurgeCastSeconds(state, casterIndex, abilityIndex, profile),
        fireballGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineAetherSurgeCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = arcaneSurgeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_surge");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = aetherSurgeCompletionTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var profile = aetherSurge.profile(aetherSurgeAurasForEntity(state, casterIndex));
    var freeCast = <float>state.entityAetherSurgeFreeRemaining[casterIndex] > 0.0;
    var baseCost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var cost = freeCast ? 0 : aetherSurgeScaledCost(baseCost, profile);
    if (rank <= 0 || effects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    if (freeCast) { state.entityAetherSurgeFreeRemaining[casterIndex] = 0.0; }
    spendOfflineAbilityResource(state, casterIndex, cost);

    // `projectile: false` keeps the ordinary direct-spell range/crit draws and
    // every subsequent state write in this completion reducer.
    var resolution = new timedSpell.TimedSpellResult();
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = effects.metric(abilityIndex, rank, 0, "min");
    spell.maximum = effects.metric(abilityIndex, rank, 0, "max");
    spell.spellPower = <float>state.entitySpellPower[casterIndex];
    spell.school = "arcane";
    spell.castTime = m4AbilityCatalog.metric(abilityIndex, level, "castTime");
    spell.critChance = offlineDamageCritChance(state, casterIndex);
    configureOfflineSpellDamageModifiers(state, casterIndex, spell);
    timedSpell.resolveTimedSpellHit(resolution, spell);
    var scaledRawDamage = terrainGradient.javascriptRound(
        <float>resolution.damage * profile.damageMult, true
    );
    if (scaledRawDamage < 0) { scaledRawDamage = 0; }
    var damage = resolveOfflineFixedSpellImpactDamage(
        state, casterIndex, targetIndex, abilityCode, OFFLINE_PROJECTILE_SCHOOL_ARCANE,
        scaledRawDamage, resolution.critical
    );
    var dealt = applyOfflineArcaneEffectiveDamage(state, targetIndex, damage);
    var hp = <int>state.entityHp[targetIndex];
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (dealt > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, dealt);
        applyOfflineTemporalEchoDamageConversion(
            state, casterIndex, dealt, OFFLINE_PROJECTILE_SCHOOL_ARCANE, false
        );
    }
    scheduleOfflinePowerEchoDamage(
        state, casterIndex, targetIndex, abilityCode, <uint>rank, scaledRawDamage, hp,
        resolution.critical
    );
    if (hp > 0) {
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }

    // The source banks the refreshed charge only after the direct effect. The
    // free-cast chance is deliberately the final draw in this local transaction.
    state.entityAetherSurgeCharges[casterIndex] = aetherSurge.nextChargeValue(
        aetherSurgeAurasForEntity(state, casterIndex)
    );
    state.entityAetherSurgeChargeRemaining[casterIndex] = aetherSurgeContract.chargeWindow();
    if (nextAuthoritativeRandomUnit(state) < aetherSurgeContract.freeProcChance()) {
        state.entityAetherSurgeFreeRemaining[casterIndex] = aetherSurgeContract.freeWindow();
    }
}

pyroblastAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("pyroblast");
    var abilityIndex = m4AbilityCatalog.indexOf("pyroblast");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "pyroblast") {
        throw "Pyroblast is absent from the current ability catalog";
    }
    return code;
}

pyroblastPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>9 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>121 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>98 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116;
}

pyroblastProjectileProfileIsValid(
    rankCode: uint, minimum: float, maximum: float, castTime: float
): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("pyroblast");
    return abilityIndex >= 0 && rankCode == <uint>1 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, 5) == 1 &&
        effects.typeAt(abilityIndex, 1, 0) == "directDamage" &&
        effects.typeAt(abilityIndex, 1, 1) == "dot" &&
        minimum == effects.metric(abilityIndex, 1, 0, "min") &&
        maximum == effects.metric(abilityIndex, 1, 0, "max") &&
        castTime == m4AbilityCatalog.metric(abilityIndex, 5, "castTime");
}

pyroblastDotProfileIsValid(damage: int, duration: float, interval: float): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("pyroblast");
    if (abilityIndex < 0 || effects.typeAt(abilityIndex, 1, 1) != "dot") {
        return false;
    }
    var expectedDuration = effects.metric(abilityIndex, 1, 1, "duration");
    var expectedInterval = effects.metric(abilityIndex, 1, 1, "interval");
    var expectedDamage = <int>(effects.metric(abilityIndex, 1, 1, "total") /
        (expectedDuration / expectedInterval) + 0.5);
    if (expectedDamage < 1) { expectedDamage = 1; }
    // Match the Fireball ordering: scale and round total first, then turn it
    // into an integer tick profile.
    var overloadDamage = <int>(offlineOverloadScaledPositiveMetric(
        effects.metric(abilityIndex, 1, 1, "total"), 1.4
    ) / (expectedDuration / expectedInterval) + 0.5);
    if (overloadDamage < 1) { overloadDamage = 1; }
    return (damage == expectedDamage || damage == overloadDamage) &&
        duration == expectedDuration &&
        interval == expectedInterval;
}

pyroblastTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("pyroblast");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

pyroblastCompletionTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("pyroblast");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

pyroblastCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

pyroblastGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    return fireballGlobalCooldownSeconds(state, casterIndex);
}

lesserHealAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("lesser_heal");
    var abilityIndex = m4AbilityCatalog.indexOf("lesser_heal");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "lesser_heal") {
        throw "Lesser Heal is absent from the current ability catalog";
    }
    return code;
}

lesserHealPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>12 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>108;
}

lesserHealRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 1; }
    if (rank == <uint>2) { return 6; }
    if (rank == <uint>3) { return 12; }
    return 0;
}

lesserHealProfileIsValid(rankCode: uint): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("lesser_heal");
    var level = lesserHealRankLevel(rankCode);
    return abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rankCode &&
        effects.typeAt(abilityIndex, <int>rankCode, 0) == "heal";
}

// The source accepts non-hostile players and a player's owned pet. The retained
// world has no PvP-controller or special encounter friendliness layer, so this
// projection admits exactly the player/pet forms represented by its state rows.
lesserHealFriendlyTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || targetIndex < 0 ||
        <bool>state.entityDead[targetIndex]) {
        return -1;
    }
    if (<uint>state.entityKinds[targetIndex] == <uint>1) {
        return !<bool>state.entityHostile[targetIndex] ? targetIndex : -1;
    }
    if (<uint>state.entityKinds[targetIndex] == <uint>2 &&
        <uint>state.entityOwnerIds[targetIndex] != <uint>0) {
        var ownerIndex = partyEntityIndexById(
            state, <uint>state.entityOwnerIds[targetIndex]
        );
        if (ownerIndex >= 0 && <uint>state.entityKinds[ownerIndex] == <uint>1 &&
            !<bool>state.entityHostile[ownerIndex]) {
            return targetIndex;
        }
    }
    return -1;
}

// Resolve source-friendly precedence before range validation: an out-of-range
// explicit target is a failed cast, not a reason to fall back to the current
// target or caster.
lesserHealResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

lesserHealTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("lesser_heal");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    // Source threshold: Math.max(range, 5.0) + 2.0. The retained outdoor
    // subset has no line-of-sight blockers for friendly casts.
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

lesserHealCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

lesserHealGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 1.0 ? 1.0 : gcd;
}

startOfflineLesserHealCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = lesserHealAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("lesser_heal");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = lesserHealResolvedTargetIndex(state, casterIndex, targetId);
    if (rank <= 0 || !lesserHealProfileIsValid(<uint>rank) ||
        <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        resolvedTargetIndex < 0 || lesserHealTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        lesserHealCastSeconds(state, casterIndex, abilityIndex),
        lesserHealGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>state.entityIds[resolvedTargetIndex];
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineLesserHealCast(state: WorldState, casterIndex: int): void {
    var abilityIndex = m4AbilityCatalog.indexOf("lesser_heal");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = lesserHealTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || !lesserHealProfileIsValid(<uint>rank) ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);

    // The source consumes its range draw inside the effect dispatcher, then its
    // heal-crit draw in applyHeal. Keep the authoritative stream in that order.
    var numeric = new numericEffects.NumericDispatchState();
    numeric.source.id = <uint>state.entityIds[casterIndex];
    numeric.source.level = level;
    numeric.source.spellPower = <float>state.entitySpellPower[casterIndex];
    numeric.target.id = targetId;
    numeric.target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ?
        "player" : "mob";
    numeric.target.hostileToSource = false;
    numeric.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (numericEffects.dispatchNumericAbility(numeric, abilityIndex, rank, 0) != 1 ||
        numeric.healAmounts.length != 1 || <uint>numeric.healTargetIds[0] != targetId) {
        return;
    }

    var source = new healState.HealEntity();
    source.id = <uint>state.entityIds[casterIndex];
    source.kind = "player";
    source.dead = <bool>state.entityDead[casterIndex];
    source.hp = <int>state.entityHp[casterIndex];
    source.maxHp = <int>state.entityMaxHp[casterIndex];
    source.spellCritChance = offlineSpellCritChance(state, casterIndex);
    var target = new healState.HealEntity();
    target.id = targetId;
    target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ? "player" : "mob";
    target.dead = <bool>state.entityDead[targetIndex];
    target.hp = <int>state.entityHp[targetIndex];
    target.maxHp = <int>state.entityMaxHp[targetIndex];

    var mobs = new healState.AwareMobProjection();
    var mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        var threatStart = <int><uint>state.entityThreatOffsets[mobIndex];
        var threatEnd = <int><uint>state.entityThreatOffsets[mobIndex + 1];
        var directTargetEntry = false;
        var ownedPetEntry = false;
        var threatIndex = threatStart;
        while (threatIndex < threatEnd) {
            var threatTargetId = <uint>state.entityThreatTargetIds[threatIndex];
            if (threatTargetId == targetId) { directTargetEntry = true; }
            if (target.kind == "player") {
                var threatTargetIndex = partyEntityIndexById(state, threatTargetId);
                if (threatTargetIndex >= 0 &&
                    <uint>state.entityOwnerIds[threatTargetIndex] == targetId) {
                    ownedPetEntry = true;
                }
            }
            threatIndex = threatIndex + 1;
        }
        mobs.addMob(
            <bool>state.entityDead[mobIndex],
            <uint>state.entityKinds[mobIndex] == <uint>2 &&
                <bool>state.entityHostile[mobIndex],
            <bool>state.entityInCombat[mobIndex],
            threatEnd > threatStart,
            directTargetEntry,
            ownedPetEntry
        );
        mobIndex = mobIndex + 1;
    }
    var events = new healState.HealEvents();
    events.randomUnits.add(nextAuthoritativeRandomUnit(state));
    healState.applyHeal(source, target, <float>numeric.healAmounts[0], mobs, events);
    state.entityHp[targetIndex] = target.hp;

    mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        if (<float>mobs.healerThreat[mobIndex] > 0.0) {
            state.setThreat(
                <uint>state.entityIds[mobIndex],
                <uint>state.entityIds[casterIndex],
                stateThreatValue(state, mobIndex, <uint>state.entityIds[casterIndex]) +
                    <float>mobs.healerThreat[mobIndex],
                1
            );
        }
        mobIndex = mobIndex + 1;
    }
}

// All retained direct friendly heals share this source ordering: the generated
// range/scaling draw is consumed before the healing kernel's critical draw.
// Each caller remains responsible for source-specific target, rank and cost gates.
applyOfflineDirectHeal(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    targetIndex: int,
    abilityIndex: int,
    rank: int
): int {
    var effects = %import("generated/m4_ability_effects");
    var level = <int>state.entityLevels[casterIndex];
    var numeric = new numericEffects.NumericDispatchState();
    numeric.source.id = <uint>state.entityIds[casterIndex];
    numeric.source.level = level;
    numeric.source.spellPower = <float>state.entitySpellPower[casterIndex];
    numeric.target.id = targetId;
    numeric.target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ?
        "player" : "mob";
    numeric.target.hostileToSource = false;
    // consumeAura effects are admitted by the world queue first. Mirror that
    // selected hot row here so the generic numeric dispatcher removes it before
    // drawing Swiftmend's range and the shared healing kernel draws its crit.
    if (effects.typeAt(abilityIndex, rank, 0) == "consumeAura") {
        if (effects.text(abilityIndex, rank, 0, "auraKind") != "hot") { return; }
        numeric.target.auraIds.add("woc_selected_hot");
        numeric.target.auraKinds.add("hot");
        numeric.target.auraValues.add(0.0);
        numeric.target.auraValues2.add(0.0);
        numeric.target.auraValues3.add(0.0);
        numeric.target.auraHasJudgement.add(false);
    }
    numeric.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (numericEffects.dispatchNumericAbility(numeric, abilityIndex, rank, 0) != 1 ||
        numeric.healAmounts.length != 1 || <uint>numeric.healTargetIds[0] != targetId) {
        return 0;
    }
    var effectType = effects.typeAt(abilityIndex, rank, 0);
    if (effectType == "heal" || effectType == "consumeAura") {
        var rawMinimum = effects.metric(abilityIndex, rank, 0, "min");
        var rawMaximum = effects.metric(abilityIndex, rank, 0, "max");
        var modifiers = offlineTalentModifiersForEntity(state, casterIndex);
        var resolvedRange = directHealTalentScaling.resolveDirectHealRange(
            <int>(rawMinimum + 0.5),
            <int>(rawMaximum + 0.5),
            modifiers,
            m4AbilityCatalog.text(abilityIndex, "id")
        );
        // The dispatcher has consumed the source range draw already. Replace
        // only that raw range component so spell power and the later crit draw
        // keep their established owners and ordering.
        var rangeUnit = <float>numeric.randomUnits[0];
        numeric.healAmounts[0] = <float>numeric.healAmounts[0] -
            (rawMinimum + rangeUnit * (rawMaximum - rawMinimum)) +
            <float>resolvedRange.minimum + rangeUnit *
                <float>(resolvedRange.maximum - resolvedRange.minimum);
    }

    var source = new healState.HealEntity();
    source.id = <uint>state.entityIds[casterIndex];
    source.kind = "player";
    source.dead = <bool>state.entityDead[casterIndex];
    source.hp = <int>state.entityHp[casterIndex];
    source.maxHp = <int>state.entityMaxHp[casterIndex];
    source.spellCritChance = offlineSpellCritChance(state, casterIndex);
    var target = new healState.HealEntity();
    target.id = targetId;
    target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ? "player" : "mob";
    target.dead = <bool>state.entityDead[targetIndex];
    target.hp = <int>state.entityHp[targetIndex];
    target.maxHp = <int>state.entityMaxHp[targetIndex];

    var mobs = new healState.AwareMobProjection();
    var mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        var threatStart = <int><uint>state.entityThreatOffsets[mobIndex];
        var threatEnd = <int><uint>state.entityThreatOffsets[mobIndex + 1];
        var directTargetEntry = false;
        var ownedPetEntry = false;
        var threatIndex = threatStart;
        while (threatIndex < threatEnd) {
            var threatTargetId = <uint>state.entityThreatTargetIds[threatIndex];
            if (threatTargetId == targetId) { directTargetEntry = true; }
            if (target.kind == "player") {
                var threatTargetIndex = partyEntityIndexById(state, threatTargetId);
                if (threatTargetIndex >= 0 &&
                    <uint>state.entityOwnerIds[threatTargetIndex] == targetId) {
                    ownedPetEntry = true;
                }
            }
            threatIndex = threatIndex + 1;
        }
        mobs.addMob(
            <bool>state.entityDead[mobIndex],
            <uint>state.entityKinds[mobIndex] == <uint>2 &&
                <bool>state.entityHostile[mobIndex],
            <bool>state.entityInCombat[mobIndex],
            threatEnd > threatStart,
            directTargetEntry,
            ownedPetEntry
        );
        mobIndex = mobIndex + 1;
    }
    var events = new healState.HealEvents();
    events.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var healed = healState.applyHeal(
        source, target, <float>numeric.healAmounts[0], mobs, events
    );
    state.entityHp[targetIndex] = target.hp;

    mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        if (<float>mobs.healerThreat[mobIndex] > 0.0) {
            state.setThreat(
                <uint>state.entityIds[mobIndex],
                <uint>state.entityIds[casterIndex],
                stateThreatValue(state, mobIndex, <uint>state.entityIds[casterIndex]) +
                    <float>mobs.healerThreat[mobIndex],
                1
            );
        }
        mobIndex = mobIndex + 1;
    }
    return healed;
}

// This world adapter preserves the ordinary absorb/cap/threat transaction for
// both resolved copies and source effects that own one normal heal crit draw.
applyOfflineWorldHeal(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    targetIndex: int,
    amount: float,
    resolveCritical: bool
): int {
    if (amount <= 0.0 || casterIndex < 0 || casterIndex >= state.entityIds.length ||
        targetIndex < 0 || targetIndex >= state.entityIds.length) {
        return 0;
    }
    var source = new healState.HealEntity();
    source.id = <uint>state.entityIds[casterIndex];
    source.kind = "player";
    source.dead = <bool>state.entityDead[casterIndex];
    source.hp = <int>state.entityHp[casterIndex];
    source.maxHp = <int>state.entityMaxHp[casterIndex];
    source.spellCritChance = offlineSpellCritChance(state, casterIndex);
    var target = new healState.HealEntity();
    target.id = targetId;
    target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ? "player" : "mob";
    target.dead = <bool>state.entityDead[targetIndex];
    target.hp = <int>state.entityHp[targetIndex];
    target.maxHp = <int>state.entityMaxHp[targetIndex];

    var mobs = new healState.AwareMobProjection();
    var mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        var threatStart = <int><uint>state.entityThreatOffsets[mobIndex];
        var threatEnd = <int><uint>state.entityThreatOffsets[mobIndex + 1];
        var directTargetEntry = false;
        var ownedPetEntry = false;
        var threatIndex = threatStart;
        while (threatIndex < threatEnd) {
            var threatTargetId = <uint>state.entityThreatTargetIds[threatIndex];
            if (threatTargetId == targetId) { directTargetEntry = true; }
            if (target.kind == "player") {
                var threatTargetIndex = partyEntityIndexById(state, threatTargetId);
                if (threatTargetIndex >= 0 &&
                    <uint>state.entityOwnerIds[threatTargetIndex] == targetId) {
                    ownedPetEntry = true;
                }
            }
            threatIndex = threatIndex + 1;
        }
        mobs.addMob(
            <bool>state.entityDead[mobIndex],
            <uint>state.entityKinds[mobIndex] == <uint>2 &&
                <bool>state.entityHostile[mobIndex],
            <bool>state.entityInCombat[mobIndex],
            threatEnd > threatStart,
            directTargetEntry,
            ownedPetEntry
        );
        mobIndex = mobIndex + 1;
    }
    var events = new healState.HealEvents();
    var healed = 0;
    if (resolveCritical) {
        events.randomUnits.add(nextAuthoritativeRandomUnit(state));
        healed = healState.applyHeal(source, target, amount, mobs, events);
    } else {
        healed = healState.applyResolvedHeal(source, target, amount, mobs, events);
    }
    state.entityHp[targetIndex] = target.hp;
    mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        if (<float>mobs.healerThreat[mobIndex] > 0.0) {
            state.setThreat(
                <uint>state.entityIds[mobIndex],
                <uint>state.entityIds[casterIndex],
                stateThreatValue(state, mobIndex, <uint>state.entityIds[casterIndex]) +
                    <float>mobs.healerThreat[mobIndex],
                1
            );
        }
        mobIndex = mobIndex + 1;
    }
    return healed;
}

// Power Echo copies an already-resolved primary heal. It deliberately reuses
// the ordinary absorb/cap/threat projection while skipping crit RNG and the
// primary-only on-heal weapon proc in heal_state.
applyOfflineResolvedDirectHeal(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    targetIndex: int,
    amount: float
): int {
    return applyOfflineWorldHeal(
        state, casterIndex, targetId, targetIndex, amount, false
    );
}

applyOfflinePowerEchoHeal(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    targetIndex: int,
    actualPrimaryHeal: int
): int {
    // Consume before considering the amount: a fully overhealed primary still
    // spends the one-shot aura exactly once, and a copy cannot recurse.
    var echoValue = consumeOfflinePowerEcho(state, casterIndex);
    if (echoValue <= 0.0 || actualPrimaryHeal <= 0) { return 0; }
    var copiedAmount = <int>(<float>actualPrimaryHeal * echoValue + 0.5);
    if (copiedAmount < 1) { copiedAmount = 1; }
    return applyOfflineResolvedDirectHeal(
        state, casterIndex, targetId, targetIndex, <float>copiedAmount
    );
}

healAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("heal");
    var abilityIndex = m4AbilityCatalog.indexOf("heal");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "heal") {
        throw "Heal is absent from the current ability catalog";
    }
    return code;
}

healPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>4 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>108;
}

healResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

healTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("heal");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

healCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

healGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineHealCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = healAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("heal");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = healResolvedTargetIndex(state, casterIndex, targetId);
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "heal" ||
        <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        resolvedTargetIndex < 0 || healTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        healCastSeconds(state, casterIndex, abilityIndex),
        healGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>state.entityIds[resolvedTargetIndex];
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineHealCast(state: WorldState, casterIndex: int): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("heal");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = healTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "heal" ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    applyOfflineDirectHeal(state, casterIndex, targetId, targetIndex, abilityIndex, rank);
}

temporalMendAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("temporal_mend");
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_mend");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "temporal_mend") {
