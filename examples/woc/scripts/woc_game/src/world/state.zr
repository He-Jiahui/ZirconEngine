// Consecration immediately pulses once, then retains independent fixed-center
// zones whose subsequent pulses draw only for targets currently in range.
pub consecrationCommandStateTest(): int {
    if (groundAoE.contractTest() != 1 || spellScaling.contractTest() != 1) { return -1; }
    var consecration = consecrationAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("consecration");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var wildBoar = <uint>(campMobCore.indexOf("wild_boar", true) + 1);
    if (consecration == <uint>0 || abilityIndex != 5 || forestWolf == <uint>0 ||
        wildBoar == <uint>0 || m4AbilityCatalog.text(abilityIndex, "class") != "paladin") {
        return -2;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>3;
    var playerId = state.spawnPlayer(<uint>4, 8, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var wolfId = state.spawnMob(forestWolf, 1, 6.0, 1.5, 0.0, 200, 8.0);
    var boarId = state.spawnMob(wildBoar, 1, 0.0, 1.5, 8.0, 200, 8.0);
    var outsideId = state.spawnMob(forestWolf, 1, 8.01, 1.5, 0.0, 200, 8.0);
    state.entityResources[0] = 120;
    state.entityMaxResources[0] = 120;
    state.entityKnownAbilityCodes.add(consecration);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (wolfId == <uint>0 || boarId == <uint>0 || outsideId == <uint>0 ||
        <int>state.entityResources[0] != 60 || <uint>state.rngDraws != <uint>2 ||
        <int>state.entityHp[1] >= 200 || <int>state.entityHp[2] >= 200 ||
        <int>state.entityHp[3] != 200 || state.offlineGroundEffectSourceIds.length != 1 ||
        <uint>state.offlineGroundEffectSourceIds[0] != playerId ||
        <uint>state.offlineGroundEffectAbilityCodes[0] != consecration ||
        !floatMatches(<float>state.offlineGroundEffectRemaining[0], 10.0) ||
        !floatMatches(<float>state.offlineGroundEffectTickTimers[0], 2.0) ||
        abilityCooldownExpiresAt(state, 0, consecration) != <uint>8000000) {
        return -3;
    }
    var restored = decodeState(encodeState(state));
    if (restored.offlineGroundEffectSourceIds.length != 1 ||
        !floatMatches(<float>restored.offlineGroundEffectRadii[0], 8.0) ||
        !floatMatches(<float>restored.offlineGroundEffectSpellPowerBonuses[0], 0.0)) {
        return -4;
    }
    var wolfHp = <int>restored.entityHp[1];
    var boarHp = <int>restored.entityHp[2];
    restored.offlineGroundEffectTickTimers[0] = 0.05;
    stepOfflineConsecrationGroundEffects(restored);
    if (<uint>restored.rngDraws != <uint>4 || <int>restored.entityHp[1] >= wolfHp ||
        <int>restored.entityHp[2] >= boarHp || <int>restored.entityHp[3] != 200 ||
        !floatMatches(<float>restored.offlineGroundEffectRemaining[0], 9.95) ||
        !floatMatches(<float>restored.offlineGroundEffectTickTimers[0], 2.0)) {
        return -5;
    }
    restored.offlineGroundEffectRemaining[0] = 0.05;
    stepOfflineConsecrationGroundEffects(restored);
    if (restored.offlineGroundEffectSourceIds.length != 0) { return -6; }
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 60;
    restored.timeMicros = <uint>8000000;
    var bytes = new container.Array<uint>();
    bytes.add(<uint>99); bytes.add(<uint>111); bytes.add(<uint>110); bytes.add(<uint>115);
    bytes.add(<uint>101); bytes.add(<uint>99); bytes.add(<uint>114); bytes.add(<uint>97);
    bytes.add(<uint>116); bytes.add(<uint>105); bytes.add(<uint>111); bytes.add(<uint>110);
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(typed, playerId, <uint>1, <uint>2, bytes);
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 0 &&
        restored.offlineGroundEffectSourceIds.length == 1 &&
        <uint>restored.rngDraws == <uint>6 &&
        abilityCooldownExpiresAt(restored, 0, consecration) == <uint>16000000 &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -7;
}

// Summon Imp shares the source cast lifecycle: it charges only when the
// five-second cast completes, creates a level-scaled Emberkin, and replacement
// leaves exactly one live owned pet in the retained world subset.
pub summonImpCommandStateTest(): int {
    var summonImp = summonImpAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("summon_imp");
    if (summonImp == <uint>0 || abilityIndex != 9 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "summon_imp" ||
        m4AbilityCatalog.text(abilityIndex, "class") != "warlock" ||
        !summonImpProfileIsValid(abilityIndex, 1)) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    state.entityResources[0] = 100;
    state.entityMaxResources[0] = 100;
    state.entitySpellHaste[0] = 0.25;
    state.entityKnownAbilityCodes.add(summonImp);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (<int>state.entityResources[0] != 100 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != summonImp ||
        !floatMatches(<float>state.entityCastRemaining[0], 4.0) ||
        !floatMatches(<float>state.entityCastTotal[0], 4.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.2) ||
        state.entityIds.length != 1) {
        return -2;
    }
    var restored = decodeState(encodeState(state));
    if (<uint>restored.entityCastingAbility[0] != summonImp ||
        !floatMatches(<float>restored.entityCastRemaining[0], 4.0) ||
        <int>restored.entityResources[0] != 100) {
        return -3;
    }
    restored.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(restored, 0, false);
    if (<int>restored.entityResources[0] != 50 || restored.entityIds.length != 2 ||
        <uint>restored.entityCastingAbility[0] != <uint>0 ||
        <uint>restored.entityOwnerIds[1] != playerId ||
        <uint>restored.entityTemplates[1] != OFFLINE_EMBERKIN_TEMPLATE_CODE ||
        <int>restored.entityLevels[1] != 1 || <int>restored.entityHp[1] != 30 ||
        <int>restored.entityMaxHp[1] != 30 || <bool>restored.entityHostile[1] ||
        <bool>restored.entityDead[1] || <int>restored.entityWeaponMinimum[1] != 4 ||
        <int>restored.entityWeaponMaximum[1] != 6 ||
        <int>restored.entityArmor[1] != 0 ||
        !floatMatches(<float>restored.entityMoveSpeed[1], 5.2) ||
        !floatMatches(<float>restored.entityPresentationScales[1], 0.55) ||
        <uint>restored.entityPresentationColors[1] != OFFLINE_EMBERKIN_PRESENTATION_COLOR ||
        offlineOwnedLivingPetIndex(restored, playerId) != 1) {
        return -4;
    }
    var persisted = decodeState(encodeState(restored));
    if (persisted.entityIds.length != 2 ||
        <uint>persisted.entityOwnerIds[1] != playerId ||
        <uint>persisted.entityTemplates[1] != OFFLINE_EMBERKIN_TEMPLATE_CODE ||
        <int>persisted.entityHp[1] != 30) {
        return -5;
    }
    persisted.entityCastGcdRemaining[0] = 0.0;
    var bytes = new container.Array<uint>();
    bytes.add(<uint>115); bytes.add(<uint>117); bytes.add(<uint>109); bytes.add(<uint>109);
    bytes.add(<uint>111); bytes.add(<uint>110); bytes.add(<uint>95); bytes.add(<uint>105);
    bytes.add(<uint>109); bytes.add(<uint>112);
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(typed, playerId, <uint>1, <uint>2, bytes);
    persisted.applyCommands(typed, 1);
    if (<uint>persisted.entityCastingAbility[0] != summonImp ||
        !floatMatches(<float>persisted.entityCastRemaining[0], 4.0) ||
        <int>persisted.entityResources[0] != 50) {
        return -6;
    }
    persisted.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(persisted, 0, false);
    return <int>persisted.entityResources[0] == 0 && persisted.entityIds.length == 3 &&
        <bool>persisted.entityDead[1] && <int>persisted.entityHp[1] == 0 &&
        !<bool>persisted.entityHostile[1] && offlineOwnedLivingPetIndex(persisted, playerId) == 2 &&
        <uint>persisted.entityTemplates[2] == OFFLINE_EMBERKIN_TEMPLATE_CODE &&
        <uint>persisted.entityOwnerIds[2] == playerId &&
        <uint>persisted.entityLastCommandSequence[0] == <uint>2 ? 1 : -7;
}

// Emberkin is a narrow Imp-family projection. These assertions keep its pet
// commands bound to the generated wire ids, existing scalar columns and the
// source distinction between a manual attack and capability-gated autocasts.
pub petCommandStateTest(): int {
    var payloads = %import("protocol/command_payloads");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (forestWolf == <uint>0 || payloads.petReviveCommandId(true) != <uint>55 ||
        payloads.petAttackCommandId(true) != <uint>56 ||
        payloads.petWaterJetCommandId(true) != <uint>57 ||
        payloads.petTauntCommandId(true) != <uint>58 ||
        payloads.petAutoTauntCommandId(true) != <uint>59 ||
        payloads.petAutoWaterJetCommandId(true) != <uint>60 ||
        payloads.petModeCommandId(true) != <uint>63) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 6.0, 100, 8.0);
    var petId = state.spawnMob(
        OFFLINE_EMBERKIN_TEMPLATE_CODE, 1, 2.0, 1.5, 1.0, 30, OFFLINE_EMBERKIN_MOVE_SPEED
    );
    var petIndex = 2;
    state.entityOwnerIds[petIndex] = playerId;
    state.entityHostile[petIndex] = false;
    state.entityAiStates[petIndex] = mobLifecycle.idleAiState();
    state.entityTargetIds[0] = targetId;

    var empty = new container.Array<uint>();
    var attack = new CommandBatch();
    appendPetCommandForTest(
        attack, payloads.petAttackCommandId(true), playerId, <uint>1, <uint>1, empty
    );
    state.applyCommands(attack, 1);
    if (petId == <uint>0 || <uint>state.entityAggroTargetIds[petIndex] != targetId ||
        !<bool>state.entityInCombat[petIndex] ||
        stateThreatValue(state, 1, petId) != 1.0) {
        return -2;
    }

    state.entityAutoAttack[petIndex] = true;
    state.entityPetManualTauntPending[petIndex] = true;
    var passive = new container.Array<uint>();
    passive.add(<uint>7); passive.add(<uint>0); passive.add(<uint>0); passive.add(<uint>0);
    passive.add(<uint>112); passive.add(<uint>97); passive.add(<uint>115); passive.add(<uint>115);
    passive.add(<uint>105); passive.add(<uint>118); passive.add(<uint>101);
    var passiveMode = new CommandBatch();
    appendPetCommandForTest(
        passiveMode, payloads.petModeCommandId(true), playerId, <uint>1, <uint>2, passive
    );
    state.applyCommands(passiveMode, 1);
    if (<uint>state.entityPetModes[petIndex] != <uint>1 ||
        <uint>state.entityAggroTargetIds[petIndex] != <uint>0 ||
        <bool>state.entityInCombat[petIndex] || <bool>state.entityAutoAttack[petIndex] ||
        <bool>state.entityPetManualTauntPending[petIndex]) {
        return -3;
    }

    var enabled = new container.Array<uint>();
    enabled.add(<uint>1);
    var autoTaunt = new CommandBatch();
    appendPetCommandForTest(
        autoTaunt, payloads.petAutoTauntCommandId(true), playerId, <uint>1, <uint>3, enabled
    );
    state.applyCommands(autoTaunt, 1);
    var autoWaterJet = new CommandBatch();
    appendPetCommandForTest(
        autoWaterJet, payloads.petAutoWaterJetCommandId(true), playerId, <uint>1, <uint>4, enabled
    );
    state.applyCommands(autoWaterJet, 1);
    if (<bool>state.entityPetAutoTaunt[petIndex] ||
        <bool>state.entityPetAutoWaterJet[petIndex]) {
        return -4;
    }

    state.entityDead[petIndex] = true;
    state.entityHp[petIndex] = 0;
    state.entityLootable[petIndex] = true;
    state.entityRespawnMicros[petIndex] = <uint>5000000;
    state.entityCorpseMicros[petIndex] = <uint>5000000;
    var revive = new CommandBatch();
    appendPetCommandForTest(
        revive, payloads.petReviveCommandId(true), playerId, <uint>1, <uint>5, empty
    );
    state.applyCommands(revive, 1);
    if (<bool>state.entityDead[petIndex] || <int>state.entityHp[petIndex] != 11 ||
        <bool>state.entityHostile[petIndex] || <bool>state.entityLootable[petIndex] ||
        <uint>state.entityRespawnMicros[petIndex] != <uint>0 ||
        <uint>state.entityCorpseMicros[petIndex] != <uint>0 ||
        <uint>state.entityOwnerIds[petIndex] != playerId ||
        !floatMatches(<float>state.entityX[petIndex], 2.0) ||
        !floatMatches(<float>state.entityZ[petIndex], 1.0)) {
        return -5;
    }

    var taunt = new CommandBatch();
    appendPetCommandForTest(
        taunt, payloads.petTauntCommandId(true), playerId, <uint>1, <uint>6, empty
    );
    state.applyCommands(taunt, 1);
    var waterJet = new CommandBatch();
    appendPetCommandForTest(
        waterJet, payloads.petWaterJetCommandId(true), playerId, <uint>1, <uint>7, empty
    );
    state.applyCommands(waterJet, 1);
    var restored = decodeState(encodeState(state));
    return !<bool>restored.entityDead[petIndex] &&
        <int>restored.entityHp[petIndex] == 11 &&
        <uint>restored.entityPetModes[petIndex] == <uint>1 &&
        <uint>restored.entityLastCommandSequence[0] == <uint>7 ? 1 : -6;
}

// WOS77 covers the source Firebolt fire/flight/impact split. A command arms
// the pet's target; this test proves no RNG is spent before launch or while the
// bolt flies, then exactly the source's crit/damage pair is spent at impact.
pub emberkinRangedProjectileStateTest(): int {
    if (emberkinRanged.contractTest() != 1) {
        return -1;
    }
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (forestWolf == <uint>0) {
        return -2;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 100, 8.0);
    var petId = spawnOfflineEmberkin(state, 0);
    var petIndex = 2;
    if (playerId == <uint>0 || targetId == <uint>0 || petId == <uint>0 ||
        <uint>state.entityTemplates[petIndex] != OFFLINE_EMBERKIN_TEMPLATE_CODE) {
        return -3;
    }
    state.entityAggroTargetIds[petIndex] = targetId;
    state.entityInCombat[petIndex] = true;
    state.entitySwingTimer[petIndex] = 0.0;
    state.entityAttackPower[petIndex] = 14;
    state.entityArmor[1] = 500;
    stepOfflineEmberkinRangedAttack(state);
    if (state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileSourceIds[0] != petId ||
        <uint>state.offlineProjectileTargetIds[0] != targetId ||
        <bool>state.offlineProjectileWands[0] ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
        <float>state.offlineProjectileMinimums[0] != 4.0 ||
        <float>state.offlineProjectileMaximums[0] != 6.0 ||
        <float>state.offlineProjectileSpeeds[0] != 2.0 ||
        <uint>state.rngDraws != <uint>0 ||
        !floatMatches(<float>state.entitySwingTimer[petIndex], 2.0)) {
        return -4;
    }
    var restored = decodeState(encodeState(state));
    var step = 0;
    while (step < 8) {
        stepOfflineEastbrookProjectiles(restored);
        step = step + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 ||
        <uint>restored.rngDraws != <uint>2 ||
        <int>restored.entityHp[1] >= 100 ||
        !<bool>restored.entityInCombat[petIndex] ||
        !<bool>restored.entityInCombat[1] ||
        <uint>restored.entityAggroTargetIds[1] != petId ||
        stateThreatValue(restored, 1, petId) <= 0.0) {
        return -5;
    }

    var fizzled = new WorldState();
    fizzled.offlineSessionActive = true;
    fizzled.offlinePlayerClass = <uint>7;
    fizzled.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var fizzleTargetId = fizzled.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 100, 8.0);
    var fizzlePetId = spawnOfflineEmberkin(fizzled, 0);
    fizzled.entityAggroTargetIds[2] = fizzleTargetId;
    fizzled.entitySwingTimer[2] = 0.0;
    stepOfflineEmberkinRangedAttack(fizzled);
    fizzled.entityDead[2] = true;
    stepOfflineEastbrookProjectiles(fizzled);
    if (fizzlePetId == <uint>0 || fizzled.offlineProjectileSourceIds.length != 0 ||
        <uint>fizzled.rngDraws != <uint>0) {
        return -6;
    }

    var leashed = new WorldState();
    leashed.offlineSessionActive = true;
    leashed.offlinePlayerClass = <uint>7;
    leashed.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var leashTargetId = leashed.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 100, 8.0);
    var leashPetId = spawnOfflineEmberkin(leashed, 0);
    leashed.entityX[2] = 40.1;
    leashed.entityAggroTargetIds[2] = leashTargetId;
    leashed.entityPetManualTauntPending[2] = true;
    stepOfflineEmberkinRangedAttack(leashed);
    return leashPetId != <uint>0 &&
        <uint>leashed.entityAggroTargetIds[2] == <uint>0 &&
        !<bool>leashed.entityInCombat[2] &&
        !<bool>leashed.entityPetManualTauntPending[2] ? 1 : -7;
}

// WOS78 connects the source petPickTarget assist predicates to retained entity
// rows. The anti-AFK active-tick clock is intentionally absent, so fresh
// aggressive pulls remain disabled while defensive assist remains executable.
pub emberkinAssistTargetStateTest(): int {
    if (petTarget.contractTest() != 1) {
        return -1;
    }
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (forestWolf == <uint>0) {
        return -2;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var engagedTargetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 12.0, 100, 8.0);
    var offenseTargetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 100, 8.0);
    var petId = spawnOfflineEmberkin(state, 0);
    var petIndex = 3;
    if (playerId == <uint>0 || engagedTargetId == <uint>0 ||
        offenseTargetId == <uint>0 || petId == <uint>0) {
        return -3;
    }
    state.entityAggroTargetIds[1] = playerId;
    if (offlineEmberkinAssistTargetIndex(state, petIndex, 0) != 1) {
        return -4;
    }
    state.entityAggroTargetIds[1] = <uint>0;
    state.entityTargetIds[0] = offenseTargetId;
    state.entityAutoAttack[0] = true;
    if (offlineEmberkinAssistTargetIndex(state, petIndex, 0) != 2) {
        return -5;
    }
    state.entityPetModes[petIndex] = <uint>1;
    if (offlineEmberkinAssistTargetIndex(state, petIndex, 0) != -1) {
        return -6;
    }
    state.entityPetModes[petIndex] = <uint>3;
    state.entityAutoAttack[0] = false;
    state.entityTargetIds[0] = <uint>0;
    if (offlineEmberkinAssistTargetIndex(state, petIndex, 0) != -1) {
        return -7;
    }
    state.entityAggroTargetIds[1] = petId;
    return offlineEmberkinAssistTargetIndex(state, petIndex, 0) == 1 ? 1 : -8;
}

// WOS79 preserves the no-target open-ground portion of the source heel path.
// Cached A*, obstacle resolution and forced recovery are deliberately absent.
pub emberkinFollowStateTest(): int {
    if (petFollow.contractTest() != 1) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var petId = spawnOfflineEmberkin(state, 0);
    var petIndex = 1;
    if (playerId == <uint>0 || petId == <uint>0) {
        return -2;
    }
    state.entityX[petIndex] = 0.0;
    state.entityY[petIndex] = 1.5;
    state.entityZ[petIndex] = 10.0;
    state.entityFacing[petIndex] = 0.0;
    stepOfflineEmberkinStraightFollow(state, petIndex, 0);
    if (!floatMatches(<float>state.entityPreviousX[petIndex], 0.0) ||
        !floatMatches(<float>state.entityPreviousY[petIndex], 1.5) ||
        !floatMatches(<float>state.entityPreviousZ[petIndex], 10.0) ||
        !floatMatches(<float>state.entityZ[petIndex], 9.615) ||
        !floatMatches(<float>state.entityFacing[petIndex], 3.141592653589793)) {
        return -3;
    }
    state.entityX[petIndex] = 0.0;
    state.entityZ[petIndex] = 3.5;
    state.entityPreviousX[petIndex] = 17.0;
    state.entityPreviousZ[petIndex] = 19.0;
    stepOfflineEmberkinStraightFollow(state, petIndex, 0);
    return floatMatches(<float>state.entityX[petIndex], 0.0) &&
        floatMatches(<float>state.entityZ[petIndex], 3.5) &&
        floatMatches(<float>state.entityPreviousX[petIndex], 17.0) &&
        floatMatches(<float>state.entityPreviousZ[petIndex], 19.0) ? 1 : -4;
}

// WOS80 retains the updatePet timer and cadence-driven heal before target
// resolution. It intentionally does not introduce generic pet auras/channels.
pub emberkinMaintenanceStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var petId = spawnOfflineEmberkin(state, 0);
    var petIndex = 1;
    if (playerId == <uint>0 || petId == <uint>0) {
        return -1;
    }
    state.tick = <uint>40;
    state.entityHp[petIndex] = 10;
    state.entityMaxHp[petIndex] = 30;
    state.entityPetTauntTimers[petIndex] = 0.025;
    stepOfflineEmberkinMaintenance(state, petIndex);
    if (<int>state.entityHp[petIndex] != 11 ||
        !floatMatches(<float>state.entityPetTauntTimers[petIndex], 0.0)) {
        return -2;
    }
    state.tick = <uint>41;
    state.entityHp[petIndex] = 10;
    state.entityPetTauntTimers[petIndex] = 1.0;
    stepOfflineEmberkinMaintenance(state, petIndex);
    if (<int>state.entityHp[petIndex] != 10 ||
        !floatMatches(<float>state.entityPetTauntTimers[petIndex], 0.95)) {
        return -3;
    }
    state.tick = <uint>80;
    state.entityHp[petIndex] = 29;
    state.entityInCombat[petIndex] = false;
    stepOfflineEmberkinMaintenance(state, petIndex);
    if (<int>state.entityHp[petIndex] != 30) {
        return -4;
    }
    state.entityHp[petIndex] = 10;
    state.entityInCombat[petIndex] = true;
    stepOfflineEmberkinMaintenance(state, petIndex);
    return <int>state.entityHp[petIndex] == 10 ? 1 : -5;
}

// WOS81 covers the source `updateRangedPetAttack` out-of-range movement arm.
// The retained direct leg must move before reducing its Firebolt timer.
pub emberkinChaseStateTest(): int {
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (forestWolf == <uint>0) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    state.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 30.0, 100, 8.0);
    var petId = spawnOfflineEmberkin(state, 0);
    var petIndex = 2;
    if (targetId == <uint>0 || petId == <uint>0) {
