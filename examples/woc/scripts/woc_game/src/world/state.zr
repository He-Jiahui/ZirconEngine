        return -4;
    }

    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>1 || <int>restored.entityHp[1] >= 1000 ||
