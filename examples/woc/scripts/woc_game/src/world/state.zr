    state.entityMaxResources[0] = 100;
    state.entityKnownAbilityCodes.add(enrage);
    var offset = 1;
    while (offset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    if (playerId == <uint>0 || !replaceOfflineTalentAllocation(
            state, 0, feral, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, enrage)) {
        return -3;
    }
    startOfflineEnrageCast(state, 0);
    if (<float>state.entityResources[0] != 23 ||
        abilityCooldownExpiresAt(state, 0, enrage) != <uint>60000000) {
