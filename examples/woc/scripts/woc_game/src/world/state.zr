    typed.offlinePlayerClass = <uint>hunter;
    var typedPlayer = typed.spawnPlayer(<uint>(hunter + 1), 8, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var typedTarget = typed.spawnMob(forestWolf, 8, 0.0, 1.5, 10.0, 1000, 7.0);
    typed.entityResources[0] = 100.0;
    typed.entityArmor[1] = 0;
