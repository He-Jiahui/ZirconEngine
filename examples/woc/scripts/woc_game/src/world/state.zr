offlineLockoutSchoolCode(school: string): uint {
    if (school == "arcane") { return OFFLINE_PROJECTILE_SCHOOL_ARCANE; }
    if (school == "holy") { return OFFLINE_PROJECTILE_SCHOOL_HOLY; }
    if (school == "shadow") { return OFFLINE_PROJECTILE_SCHOOL_SHADOW; }
    if (school == "nature") { return OFFLINE_PROJECTILE_SCHOOL_NATURE; }
    if (school == "frost") { return OFFLINE_PROJECTILE_SCHOOL_FROST; }
    if (school == "fire") { return OFFLINE_PROJECTILE_SCHOOL_FIRE; }
    return OFFLINE_PROJECTILE_SCHOOL_PHYSICAL;
}

offlineAbilitySchoolCode(abilityCode: uint): uint {
    if (!knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return OFFLINE_PROJECTILE_SCHOOL_PHYSICAL;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(
        knownAbilityCatalog.abilityId(<int>abilityCode)
    );
    return abilityIndex < 0 ? OFFLINE_PROJECTILE_SCHOOL_PHYSICAL :
        offlineLockoutSchoolCode(m4AbilityCatalog.text(abilityIndex, "school"));
}

m4AbilityCodeFromPayload(
    bytes: container.Array<uint>, offset: uint, length: uint
): uint {
    var catalogIndex = 0;
    while (catalogIndex < m4AbilityCatalog.count()) {
        if (m4AbilityCatalog.idUtf8Length(catalogIndex) == <int>length) {
            var matches = true;
            var byteIndex: uint = <uint>0;
            while (byteIndex < length) {
                if (<uint>bytes[<int>(offset + byteIndex)] !=
                    m4AbilityCatalog.idUtf8Byte(catalogIndex, <int>byteIndex)) {
                    matches = false;
                    break;
                }
                byteIndex = byteIndex + <uint>1;
            }
            if (matches) {
                return <uint>knownAbilityCatalog.abilityCode(
                    m4AbilityCatalog.text(catalogIndex, "id")
                );
            }
        }
        catalogIndex = catalogIndex + 1;
    }
    return <uint>0;
}

offlineCastSchoolLockoutAllows(
    state: WorldState, casterIndex: int, abilityCode: uint
): bool {
    return !offlineSchoolLockoutIsActive(
        state, casterIndex, offlineAbilitySchoolCode(abilityCode)
    );
}

offlineSchoolLockoutIsActive(
    state: WorldState, entityIndex: int, schoolCode: uint
): bool {
    if (schoolCode == OFFLINE_PROJECTILE_SCHOOL_PHYSICAL ||
        !motionAuraStateIsValid(state, entityIndex) ||
        !motionAuraDetailsStateIsValid(state) ||
        !motionAuraSchoolStateIsValid(state)) {
        return false;
    }
    var lockoutKind = ccContract.motionAuraKindCode("lockout");
    var auraIndex = <int><uint>state.entityMotionAuraOffsets[entityIndex];
    var auraEnd = <int><uint>state.entityMotionAuraOffsets[entityIndex + 1];
    while (auraIndex < auraEnd) {
        if (<uint>state.entityMotionAuraKindCodes[auraIndex] == lockoutKind &&
            <uint>state.entityMotionAuraSchoolCodes[auraIndex] == schoolCode &&
            <float>state.entityMotionAuraRemaining[auraIndex] > 0.0) {
            return true;
        }
        auraIndex = auraIndex + 1;
    }
    return false;
}

cancelOfflineTargetCast(state: WorldState, targetIndex: int): void {
    var cast = loadCastingState(state, targetIndex);
    if (cast.castingAbility == <uint>0) { return; }
    casting.cancelCast(cast);
    storeCastingState(state, targetIndex, cast);
    state.entityCastTargetIds[targetIndex] = <uint>0;
}

skullBashTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("skull_bash");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

startOfflineSkullBashCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = skullBashAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("skull_bash");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state, casterIndex, abilityCode,
            forms.formKindForAbilityCode(<uint>state.entityActiveFormAbilityCodes[casterIndex]),
            false
        )) { return; }
    var targetIndex = skullBashTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (targetIndex < 0 || !skullBashProfileIsValid(abilityIndex, level) ||
        <int>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rakeGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;
    var casterId = <uint>state.entityIds[casterIndex];
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    var interruptedAbility = <uint>state.entityCastingAbility[targetIndex];
    var interruptedSchool = offlineAbilitySchoolCode(interruptedAbility);
    var targetCast = loadCastingState(state, targetIndex);
    if (interruptedAbility != <uint>0 && !targetCast.fishing &&
        interruptedSchool != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL) {
        cancelOfflineTargetCast(state, targetIndex);
        applyOfflineMotionAuraWithDetailsAndSchool(
            state, targetIndex, abilityCode, casterId,
            ccContract.motionAuraKindCode("lockout"),
            effects.metric(abilityIndex, 1, 0, "lockout"), 0.0, 0.0,
            interruptedSchool
        );
    }
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
}

