    if (forestWolf == <uint>0 || playerId == <uint>0 || targetId == <uint>0 ||
        abilityCode == <uint>0 || fireSpec == <uint>0) {
        return -1;
    }
    state.entityTalentSpecCodes[0] = fireSpec;
    state.entityResources[0] = 180;
    state.entityMaxResources[0] = 180;
    state.entitySpellPower[0] = 0;
    state.entityCritChance[0] = 0.0;
    state.entityKnownAbilityCodes.add(abilityCode);
    state.entityKnownAbilityOffsets[1] = <uint>1;

    var dragonBytes = new container.Array<uint>();
    dragonBytes.add(<uint>100); dragonBytes.add(<uint>114); dragonBytes.add(<uint>97);
    dragonBytes.add(<uint>103); dragonBytes.add(<uint>111); dragonBytes.add(<uint>110);
    dragonBytes.add(<uint>115); dragonBytes.add(<uint>95); dragonBytes.add(<uint>98);
    dragonBytes.add(<uint>114); dragonBytes.add(<uint>101); dragonBytes.add(<uint>97);
    dragonBytes.add(<uint>116); dragonBytes.add(<uint>104);
    applyOfflineMotionAuraWithDetailsAndSchool(
        state, 0, abilityCode, targetId, ccContract.motionAuraKindCode("lockout"),
        4.0, 0.0, 0.0, OFFLINE_PROJECTILE_SCHOOL_FIRE
    );
    var denied = new CommandBatch();
    appendTypedCastCommandForTest(denied, playerId, <uint>1, <uint>1, dragonBytes);
    state.applyCommands(denied, 1);
    if (!offlineSchoolLockoutIsActive(state, 0, OFFLINE_PROJECTILE_SCHOOL_FIRE) ||
        offlineCastSchoolLockoutAllows(state, 0, abilityCode) ||
        <uint>state.entityCastingAbility[0] != <uint>0 ||
        <float>state.entityResources[0] != 180 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -2;
    }
    state.entityMotionAuraRemaining[0] = 0.0;

    startOfflineDragonsBreathCast(state, 0);
    if (<uint>state.entityCastingAbility[0] != abilityCode ||
        <float>state.entityCastRemaining[0] != 2.4 ||
        <float>state.entityResources[0] != 180) {
        return -3;
    }
    state.entityCastRemaining[0] = 1.8;
    var drawsBefore = state.rngDraws;
    var release = new CommandBatch();
    appendReleaseEmpoweredCommandForTest(release, playerId, <uint>1, <uint>2, dragonBytes);
    state.applyCommands(release, 1);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <int>state.entityLastResolvedEmpowerLevel[0] != 2 ||
        <float>state.entityResources[0] != 90 ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>20000000 ||
        <uint>state.rngDraws != drawsBefore + <uint>2 || <int>state.entityHp[1] >= 1000 ||
        state.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>state.entityMotionAuraAbilityCodes[0] != abilityCode ||
        <uint>state.entityMotionAuraKindCodes[0] !=
            ccContract.motionAuraKindCode("incapacitate") ||
        !floatMatches(<float>state.entityMotionAuraRemaining[0], 1.5) ||
        <uint>state.entityMotionAuraSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
        <float>state.entityHeatingUpRemaining[0] != 0.0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -4;
    }

    state.timeMicros = <uint>20000000;
    state.entityCastGcdRemaining[0] = 0.0;
    startOfflineDragonsBreathCast(state, 0);
    if (<uint>state.entityCastingAbility[0] != abilityCode) { return -5; }
    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <int>state.entityLastResolvedEmpowerLevel[0] != 4 ||
        <float>state.entityResources[0] != 0 ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>40000000 ||
        state.entityMotionAuraOffsets[2] != <uint>1 ||
        !floatMatches(<float>state.entityMotionAuraRemaining[0], 3.0) ||
        !floatMatches(<float>state.entityHeatingUpRemaining[0], 10.0)) {
        return -6;
    }
    return fireMageProcStateIsValid(state) && motionAuraDetailsStateIsValid(state) ? 1 : -6;
}

pub arcanePowerRuntimeStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>2, 5, 0.0, 1.5, 0.0, 100, 100.0, 1);
    var abilityCode = arcanePowerAbilityCode();
    if (playerId == <uint>0 || abilityCode == <uint>0 ||
        !arcanePowerProfileIsValid(abilityCode)) {
        return -1;
    }
    state.entitySpellHaste[0] = 0.25;
    state.entityKnownAbilityCodes.add(abilityCode);
    state.entityKnownAbilityOffsets[1] = <uint>1;
    var arcaneBytes = new container.Array<uint>();
    arcaneBytes.add(<uint>97); arcaneBytes.add(<uint>114); arcaneBytes.add(<uint>99);
    arcaneBytes.add(<uint>97); arcaneBytes.add(<uint>110); arcaneBytes.add(<uint>101);
    arcaneBytes.add(<uint>95); arcaneBytes.add(<uint>112); arcaneBytes.add(<uint>111);
    arcaneBytes.add(<uint>119); arcaneBytes.add(<uint>101); arcaneBytes.add(<uint>114);

    applyOfflineMotionAuraWithDetailsAndSchool(
        state, 0, abilityCode, playerId, ccContract.motionAuraKindCode("lockout"),
        4.0, 0.0, 0.0, OFFLINE_PROJECTILE_SCHOOL_ARCANE
    );
    var denied = new CommandBatch();
    appendTypedCastCommandForTest(denied, playerId, <uint>1, <uint>1, arcaneBytes);
    state.applyCommands(denied, 1);
    if (!offlineSchoolLockoutIsActive(state, 0, OFFLINE_PROJECTILE_SCHOOL_ARCANE) ||
        offlineCastSchoolLockoutAllows(state, 0, abilityCode) ||
        <float>state.entityArcanePowerRemaining[0] != 0.0 ||
        <float>state.entitySpellDamageMultipliers[0] != 1.0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -2;
    }
    state.entityMotionAuraRemaining[0] = 0.0;
    var cast = new CommandBatch();
    appendTypedCastCommandForTest(cast, playerId, <uint>1, <uint>2, arcaneBytes);
    state.applyCommands(cast, 1);
    if (!floatMatches(<float>state.entityCastGcdRemaining[0], 1.2) ||
        !floatMatches(<float>state.entityArcanePowerRemaining[0], 10.0) ||
        !floatMatches(<float>state.entityArcanePowerSpellHasteRemaining[0], 10.0) ||
        !floatMatches(<float>state.entitySpellDamageMultipliers[0], 1.2) ||
        !floatMatches(mageSpellHasteMultiplier(state, 0), 1.35) ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>90000000 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -3;
    }
    var spell = new timedSpell.TimedSpellSpec();
    configureOfflineSpellDamageModifiers(state, 0, spell);
    if (!floatMatches(spell.damageMultiplier, 1.2) ||
        <float>spell.critDamageBonus != <float>state.entityCritDamageSpellBonus[0]) {
        return -4;
    }
    var restored = decodeState(encodeState(state));
    if (!floatMatches(<float>restored.entityArcanePowerRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entityArcanePowerSpellHasteRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entitySpellDamageMultipliers[0], 1.2) ||
        !floatMatches(mageSpellHasteMultiplier(restored, 0), 1.35)) {
        return -5;
    }
    restored.entityArcanePowerRemaining[0] = 0.05;
    restored.entityArcanePowerSpellHasteRemaining[0] = 0.05;
    ageOfflineArcanePower(restored);
    if (<float>restored.entityArcanePowerRemaining[0] != 0.0 ||
        <float>restored.entitySpellDamageMultipliers[0] != 1.0 ||
        !floatMatches(mageSpellHasteMultiplier(restored, 0), 1.25)) {
        return -6;
    }
    var legacy = decodeState(encodeStateVersion(state, <uint>88));
    if (!floatMatches(<float>legacy.entityArcanePowerRemaining[0], 10.0) ||
        !floatMatches(<float>legacy.entityArcanePowerSpellHasteRemaining[0], 10.0)) {
        return -7;
    }
    var migrated = decodeState(encodeStateVersion(state, <uint>87));
    return <float>migrated.entityArcanePowerRemaining[0] == 0.0 &&
        <float>migrated.entityArcanePowerSpellHasteRemaining[0] == 0.0 &&
        arcanePowerStateIsValid(migrated) ? 1 : -8;
}

