    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

healingWaveCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

healingWaveGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineHealingWaveCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = healingWaveAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("healing_wave");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = healingWaveResolvedTargetIndex(state, casterIndex, targetId);
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "heal" ||
        <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        resolvedTargetIndex < 0 || healingWaveTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        healingWaveCastSeconds(state, casterIndex, abilityIndex),
        healingWaveGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>state.entityIds[resolvedTargetIndex];
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineHealingWaveCast(state: WorldState, casterIndex: int): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("healing_wave");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = healingWaveTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "heal" ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    applyOfflineDirectHeal(state, casterIndex, targetId, targetIndex, abilityIndex, rank);
}

chainHealAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("chain_heal");
    var abilityIndex = m4AbilityCatalog.indexOf("chain_heal");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "chain_heal") {
        throw "Chain Heal is absent from the current ability catalog";
    }
    return code;
}

chainHealPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>10 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>108;
}

chainHealResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

chainHealTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("chain_heal");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

chainHealProfileIsValid(abilityCode: uint, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("chain_heal");
    var rank = abilityIndex < 0 ? 0 : m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    return abilityCode == chainHealAbilityCode() && abilityIndex >= 0 && rank == 1 &&
        m4AbilityCatalog.metric(abilityIndex, level, "learnLevel") == 10.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 60.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 2.5 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 30.0 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "shaman" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "nature" &&
        m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        m4AbilityCatalog.text(abilityIndex, "targetType") == "friendly" &&
        effects.typeAt(abilityIndex, rank, 0) == "chainHeal" &&
        effects.metric(abilityIndex, rank, 0, "min") == 120.0 &&
        effects.metric(abilityIndex, rank, 0, "max") == 145.0 &&
        effects.metric(abilityIndex, rank, 0, "jumps") == 2.0 &&
        effects.metric(abilityIndex, rank, 0, "falloff") == 0.5 &&
        effects.metric(abilityIndex, rank, 0, "radius") == 12.0;
}

// `applyTalentMods` resolves a per-ability cost after the generated base
// profile, rounding once and clamping at zero. Both admission and completion
// must use this same result so a mid-cast resource check cannot change bill.
chainHealResolvedCost(
    state: WorldState, casterIndex: int, abilityIndex: int, level: int
): int {
    var baseCost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var modifiers = offlineTalentModifiersForEntity(state, casterIndex);
    var resolved = <float>baseCost * (
        1.0 + talentModifiers.abilityField(modifiers, "chain_heal", "costPct")
    );
    if (resolved <= 0.0) { return 0; }
    return <int>(resolved + 0.5);
}

chainHealCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

chainHealGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineChainHealCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = chainHealAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("chain_heal");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = chainHealResolvedCost(state, casterIndex, abilityIndex, level);
    var resolvedTargetIndex = chainHealResolvedTargetIndex(state, casterIndex, targetId);
    if (rank <= 0 || !chainHealProfileIsValid(abilityCode, level) ||
        effects.typeAt(abilityIndex, rank, 0) != "chainHeal" ||
        <float>state.entityResources[casterIndex] < cost ||
        resolvedTargetIndex < 0 || chainHealTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        chainHealCastSeconds(state, casterIndex, abilityIndex),
        chainHealGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>state.entityIds[resolvedTargetIndex];
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

chainHealContainsIndex(indices: container.Array<int>, candidate: int): bool {
    for (var index in indices) {
        if (index == candidate) { return true; }
    }
    return false;
}

// Source selection completes before the first heal mutates HP, preventing an
// earlier hop from changing which later ally belongs to the chain.
chainHealTargetIndices(
    state: WorldState,
    casterIndex: int,
    firstTargetIndex: int,
    jumps: int,
    radius: float
): container.Array<int> {
    var targets = new container.Array<int>();
    if (firstTargetIndex < 0 || jumps < 0 || radius < 0.0) { return targets; }
    targets.add(firstTargetIndex);
    var hop = 0;
    while (hop < jumps) {
        var fromIndex = <int>targets[targets.length - 1];
        var bestIndex = -1;
        var bestDistanceSquared = 0.0;
        var entityIndex = 0;
        while (entityIndex < state.entityIds.length) {
            if (!chainHealContainsIndex(targets, entityIndex) &&
                lesserHealFriendlyTargetIndex(
                    state, casterIndex, <uint>state.entityIds[entityIndex]
                ) == entityIndex) {
                var dx = <float>state.entityX[entityIndex] -
                    <float>state.entityX[fromIndex];
                var dz = <float>state.entityZ[entityIndex] -
                    <float>state.entityZ[fromIndex];
                var distanceSquared = dx * dx + dz * dz;
                if (distanceSquared <= radius * radius &&
                    chainHealState.betterCandidate(
                        <int>state.entityHp[entityIndex],
                        <int>state.entityMaxHp[entityIndex],
                        distanceSquared,
                        <uint>state.entityIds[entityIndex],
                        bestIndex >= 0,
                        bestIndex >= 0 ? <int>state.entityHp[bestIndex] : 0,
                        bestIndex >= 0 ? <int>state.entityMaxHp[bestIndex] : 0,
                        bestDistanceSquared,
                        bestIndex >= 0 ? <uint>state.entityIds[bestIndex] : <uint>0
                    )) {
                    bestIndex = entityIndex;
                    bestDistanceSquared = distanceSquared;
                }
            }
            entityIndex = entityIndex + 1;
        }
        if (bestIndex < 0) { break; }
        targets.add(bestIndex);
        hop = hop + 1;
    }
    return targets;
}

completeOfflineChainHealCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = chainHealAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("chain_heal");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = chainHealTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = chainHealResolvedCost(state, casterIndex, abilityIndex, level);
    if (rank <= 0 || !chainHealProfileIsValid(abilityCode, level) ||
        effects.typeAt(abilityIndex, rank, 0) != "chainHeal" ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    var resolvedRange = directHealTalentScaling.resolveDirectHealRange(
        <int>(effects.metric(abilityIndex, rank, 0, "min") + 0.5),
        <int>(effects.metric(abilityIndex, rank, 0, "max") + 0.5),
        offlineTalentModifiersForEntity(state, casterIndex),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
    var baseAmount = <float>resolvedRange.minimum + nextAuthoritativeRandomUnit(state) *
        <float>(resolvedRange.maximum - resolvedRange.minimum) +
        <float>spellScaling.directHealBonus(
            <float>state.entitySpellPower[casterIndex],
            m4AbilityCatalog.metric(abilityIndex, level, "castTime")
        );
    var targets = chainHealTargetIndices(
        state, casterIndex, targetIndex,
        <int>effects.metric(abilityIndex, rank, 0, "jumps"),
        effects.metric(abilityIndex, rank, 0, "radius")
    );
    var falloff = effects.metric(abilityIndex, rank, 0, "falloff");
    var hop = 0;
    while (hop < targets.length) {
        var hopTargetIndex = <int>targets[hop];
        applyOfflineWorldHeal(
            state, casterIndex, <uint>state.entityIds[hopTargetIndex], hopTargetIndex,
            <float>chainHealState.hopAmount(baseAmount, falloff, hop), true
        );
        hop = hop + 1;
    }
}

shamanShockCooldownIsActive(state: WorldState, casterIndex: int): bool {
    return abilityCooldownExpiresAt(state, casterIndex,
        <uint>knownAbilityCatalog.abilityCode("earth_shock")) > state.timeMicros ||
        abilityCooldownExpiresAt(state, casterIndex,
            <uint>knownAbilityCatalog.abilityCode("flame_shock")) > state.timeMicros ||
        abilityCooldownExpiresAt(state, casterIndex,
            <uint>knownAbilityCatalog.abilityCode("frost_shock")) > state.timeMicros;
}

armShamanShockCooldown(state: WorldState, casterIndex: int, expiresAtMicros: uint): void {
    setAbilityCooldownExpiration(state, casterIndex,
        <uint>knownAbilityCatalog.abilityCode("earth_shock"), expiresAtMicros);
    setAbilityCooldownExpiration(state, casterIndex,
        <uint>knownAbilityCatalog.abilityCode("flame_shock"), expiresAtMicros);
    setAbilityCooldownExpiration(state, casterIndex,
        <uint>knownAbilityCatalog.abilityCode("frost_shock"), expiresAtMicros);
}

earthShockAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("earth_shock");
    var abilityIndex = m4AbilityCatalog.indexOf("earth_shock");
    if (code == <uint>0 || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "earth_shock") {
        throw "Earth Shock is absent from the current ability catalog";
    }
    return code;
}

earthShockPayloadAbilityIsExact(bytes: container.Array<uint>, offset: uint, length: uint): bool {
    return length == <uint>11 && <uint>bytes[<int>offset] == <uint>101 &&
        <uint>bytes[<int>(offset + <uint>1)] == <uint>97 &&
        <uint>bytes[<int>(offset + <uint>2)] == <uint>114 &&
        <uint>bytes[<int>(offset + <uint>3)] == <uint>116 &&
        <uint>bytes[<int>(offset + <uint>4)] == <uint>104 &&
        <uint>bytes[<int>(offset + <uint>5)] == <uint>95 &&
        <uint>bytes[<int>(offset + <uint>6)] == <uint>115 &&
        <uint>bytes[<int>(offset + <uint>7)] == <uint>104 &&
        <uint>bytes[<int>(offset + <uint>8)] == <uint>111 &&
        <uint>bytes[<int>(offset + <uint>9)] == <uint>99 &&
        <uint>bytes[<int>(offset + <uint>10)] == <uint>107;
}

earthShockTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) { return -1; }
    var range = m4AbilityCatalog.metric(m4AbilityCatalog.indexOf("earth_shock"),
        <int>state.entityLevels[casterIndex], "range");
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ? targetIndex : -1;
}

earthShockProjectileProfileIsValid(rank: uint, minimum: float, maximum: float, castTime: float): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("earth_shock");
    return abilityIndex >= 0 && rank > <uint>0 &&
        effects.typeAt(abilityIndex, <int>rank, 0) == "directDamage" &&
        minimum == effects.metric(abilityIndex, <int>rank, 0, "min") &&
        maximum == effects.metric(abilityIndex, <int>rank, 0, "max") && castTime == 0.0;
}

startOfflineEarthShockCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = earthShockAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("earth_shock");
    if (!state.offlineSessionActive || abilityIndex < 0 || casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] || <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 || shamanShockCooldownIsActive(state, casterIndex) ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) || !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || effects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        <float>state.entityResources[casterIndex] < cost || earthShockTargetIndex(state, casterIndex, targetId) < 0) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    armShamanShockCooldown(state, casterIndex, state.timeMicros + <uint>(m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0));
    appendOfflineAbilityProjectile(state, <uint>state.entityIds[casterIndex], targetId,
        <float>state.entityX[casterIndex], <float>state.entityZ[casterIndex],
        effects.metric(abilityIndex, rank, 0, "min"), effects.metric(abilityIndex, rank, 0, "max"),
        projectileTravel.projectileSpeed(), false, OFFLINE_PROJECTILE_SCHOOL_NATURE, abilityCode,
        <uint>rank, 0.0);
}

landOfflineEarthShockProjectile(state: WorldState, projectileIndex: int, casterIndex: int, targetIndex: int): void {
    var abilityCode = earthShockAbilityCode();
    if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] != abilityCode) { return; }
    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex]; resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) { enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex); return; }
    var result = new timedSpell.TimedSpellResult();
    result.randomUnits.add(nextAuthoritativeRandomUnit(state)); result.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex]; spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    spell.spellPower = <float>state.entitySpellPower[casterIndex]; spell.school = "nature"; spell.castTime = 0.0;
    spell.critChance = offlineDamageCritChance(state, casterIndex); timedSpell.resolveTimedSpellHit(result, spell);
    var rawDamage = result.damage;
    var damage = resolveOfflineFixedSpellImpactDamage(
        state, casterIndex, targetIndex, abilityCode, OFFLINE_PROJECTILE_SCHOOL_NATURE,
        rawDamage, result.critical
    );
    var hp = <int>state.entityHp[targetIndex] - damage; state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (hp > 0) { state.setThreat(<uint>state.entityIds[targetIndex], <uint>state.entityIds[casterIndex],
        stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) + <float>damage, 1); }
    else { settleOfflineEastbrookLethal(state, targetIndex, casterIndex); }
}

