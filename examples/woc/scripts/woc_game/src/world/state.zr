// Eastbrook targets retain their supplied duration. The same durable rows now
// also preserve the source PvP fear ladder for a future player target.
offlineFearDuration(
    state: WorldState, casterIndex: int, targetIndex: int, baseDuration: float
): float {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length ||
        targetIndex < 0 || targetIndex >= state.entityIds.length || baseDuration <= 0.0) {
        throw "woc Fear duration state is invalid";
    }
    var resolution = fearDr.resolve(
        <uint>state.entityKinds[casterIndex] == <uint>1,
        <uint>state.entityKinds[targetIndex] == <uint>1,
        <bool>state.entityHostile[targetIndex],
        <int>state.entityFearDrStages[targetIndex],
        <float>state.entityFearDrResetAt[targetIndex],
        <float>state.timeMicros / 1000000.0,
        baseDuration
    );
    if (resolution.shouldStore) {
        state.entityFearDrStages[targetIndex] = resolution.nextStage;
        state.entityFearDrResetAt[targetIndex] = resolution.resetAt;
    }
    return resolution.duration;
}

landOfflineFearProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = fearAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("fear");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] !=
        abilityCode || rank <= 0) {
        return;
    }

    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }

    var duration = offlineFearDuration(
        state, casterIndex, targetIndex,
        m4AbilityEffects.metric(abilityIndex, rank, 0, "duration")
    );
    var direction = -3.141592653589793 + 6.283185307179586 *
        nextAuthoritativeRandomUnit(state);
    applyOfflineMotionAuraWithDetails(
        state,
        targetIndex,
        abilityCode,
        <uint>state.entityIds[casterIndex],
        ccContract.motionAuraKindCode("incapacitate"),
        duration,
        direction,
        0.1
    );
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
}

landOfflineHibernateProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = hibernateAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("hibernate");
    var rank = <uint>state.offlineProjectileRanks[projectileIndex];
    var castTime = <float>state.offlineProjectileCastTimes[projectileIndex];
    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] !=
        abilityCode || !hibernateProjectileProfileIsValid(rank, castTime)) {
        return;
    }
    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }
    var duration = effects.metric(abilityIndex, <int>rank, 0, "duration");
    if (duration != 8.0) { return; }
    applyOfflineMotionAuraWithDetails(
        state,
        targetIndex,
        abilityCode,
        <uint>state.entityIds[casterIndex],
        ccContract.motionAuraKindCode("incapacitate"),
        duration,
        0.0,
        0.0
    );
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
}

// Drain Life's heal is not a normal spell heal: source applies no heal crit or
// absorb processing, but it still distributes half effective healing as threat
// across every hostile that is already aware of the caster.
applyOfflineDrainLifeHealingThreat(
    state: WorldState,
    casterIndex: int,
    healed: int
): void {
    if (healed <= 0) { return; }
    var source = new healState.HealEntity();
    source.id = <uint>state.entityIds[casterIndex];
    source.kind = "player";
    source.dead = <bool>state.entityDead[casterIndex];
    var target = new healState.HealEntity();
    target.id = source.id;
    target.kind = "player";
    target.dead = source.dead;
    var mobs = new healState.AwareMobProjection();
    var mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        var threatStart = <int><uint>state.entityThreatOffsets[mobIndex];
        var threatEnd = <int><uint>state.entityThreatOffsets[mobIndex + 1];
        var directTargetEntry = false;
        var ownedPetEntry = false;
        var threatIndex = threatStart;
        while (threatIndex < threatEnd) {
            var threatTargetId = <uint>state.entityThreatTargetIds[threatIndex];
            if (threatTargetId == target.id) { directTargetEntry = true; }
            if (target.kind == "player") {
                var threatTargetIndex = partyEntityIndexById(state, threatTargetId);
                if (threatTargetIndex >= 0 &&
                    <uint>state.entityOwnerIds[threatTargetIndex] == target.id) {
                    ownedPetEntry = true;
                }
            }
            threatIndex = threatIndex + 1;
        }
        mobs.addMob(
            <bool>state.entityDead[mobIndex],
            <uint>state.entityKinds[mobIndex] == <uint>2 &&
                <bool>state.entityHostile[mobIndex],
            <bool>state.entityInCombat[mobIndex],
            threatEnd > threatStart,
            directTargetEntry,
            ownedPetEntry
        );
        mobIndex = mobIndex + 1;
    }
    healState.applyHealingThreat(source, target, healed, mobs);
    mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        if (<float>mobs.healerThreat[mobIndex] > 0.0) {
            state.setThreat(
                <uint>state.entityIds[mobIndex],
                source.id,
                stateThreatValue(state, mobIndex, source.id) +
                    <float>mobs.healerThreat[mobIndex],
                1
            );
        }
        mobIndex = mobIndex + 1;
    }
}

landOfflineDrainLifeProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = drainLifeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("drain_life");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    var minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    var maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    if (abilityIndex < 0 || rank <= 0 ||
        <uint>state.offlineProjectileAbilityCodes[projectileIndex] != abilityCode ||
        !drainLifeProjectileShapeIsValid(
            <uint>rank, <float>state.offlineProjectileCastTimes[projectileIndex]
        ) || !offlineTalentDrainTickProjectileRangeIsValid(state, projectileIndex)) {
        return;
    }

    // `rng.range` draws even where min == max. Drain ticks do not spell-resist
    // or crit; their sole landing draw is the range roll followed by the source
    // channel spell-power bonus.
    var bonus = spellScaling.channelTickBonus(
        <float>state.entitySpellPower[casterIndex],
        "shadow",
        false,
        m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[casterIndex], "channelDuration"),
        <int>m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[casterIndex], "channelTicks")
    );
    var damage = <int>(minimum + nextAuthoritativeRandomUnit(state) *
        (maximum - minimum) + <float>bonus + 0.5);
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage);
    }
    if (hp > 0) {
        var level = <int>state.entityLevels[casterIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }

    if (!<bool>state.entityDead[casterIndex]) {
        var heal = <int>(<float>damage * effects.metric(abilityIndex, rank, 0, "healFrac") + 0.5);
        var missing = <int>state.entityMaxHp[casterIndex] - <int>state.entityHp[casterIndex];
        if (heal > missing) { heal = missing; }
        if (heal > 0) {
            state.entityHp[casterIndex] = <int>state.entityHp[casterIndex] + heal;
            applyOfflineDrainLifeHealingThreat(state, casterIndex, heal);
        }
    }
}

landOfflineMindFlayProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = mindFlayAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("mind_flay");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    var minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    var maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    if (abilityIndex < 0 || rank <= 0 ||
        <uint>state.offlineProjectileAbilityCodes[projectileIndex] != abilityCode ||
        <uint>state.offlineProjectileSchoolCodes[projectileIndex] !=
            OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
        !mindFlayProjectileShapeIsValid(
            <uint>rank, <float>state.offlineProjectileCastTimes[projectileIndex]
        ) || !offlineTalentDrainTickProjectileRangeIsValid(state, projectileIndex) ||
        effects.metric(abilityIndex, rank, 0, "healFrac") != 0.0) {
        return;
    }

    // Source drainTicks have one range draw and a per-channel spell-power rider;
    // Mind Flay's zero healFrac intentionally produces no self-heal or heal threat.
    var bonus = spellScaling.channelTickBonus(
        <float>state.entitySpellPower[casterIndex],
        "shadow",
        false,
        m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[casterIndex], "channelDuration"),
        <int>m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[casterIndex], "channelTicks")
    );
    var damage = <int>(minimum + nextAuthoritativeRandomUnit(state) *
        (maximum - minimum) + <float>bonus + 0.5);
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage);
    }
    if (hp > 0) {
        var level = <int>state.entityLevels[casterIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

// Aether Darts resolves its held Surge charges only when the first missile
// actually lands. The source has no spell-resist stage here: its channel
// callback consumes the crit draw before the damage-range draw.
landOfflineAetherDartsProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = arcaneMissilesAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_missiles");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    var minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    var maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    if (abilityIndex < 0 || rank <= 0 ||
        <uint>state.offlineProjectileAbilityCodes[projectileIndex] != abilityCode ||
        <uint>state.offlineProjectileSchoolCodes[projectileIndex] !=
            OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
        !aetherDartsProjectileProfileIsValid(
            <uint>rank,
            minimum,
            maximum,
            <float>state.offlineProjectileCastTimes[projectileIndex]
        ) || effects.typeAt(abilityIndex, rank, 0) != "directDamage") {
        return;
    }

    var level = <int>state.entityLevels[casterIndex];
    var plan = aetherSurge.resolveDartsBolt(
        <bool>state.entityAetherDartsConsumePending[casterIndex],
        <int>state.entityAetherDartsBonusPerBolt[casterIndex],
        aetherSurgeAurasForEntity(state, casterIndex),
        <int>state.entityAetherDartsTicks[casterIndex],
        <int>m4AbilityCatalog.metric(abilityIndex, level, "channelTicks")
    );
    state.entityAetherDartsConsumePending[casterIndex] = plan.consumePending;
    state.entityAetherDartsBonusPerBolt[casterIndex] = plan.bonusPerBolt;
    if (plan.removeChargeAura) {
        state.entityAetherSurgeCharges[casterIndex] = 0;
        state.entityAetherSurgeChargeRemaining[casterIndex] = 0.0;
    }

    var critical = nextAuthoritativeRandomUnit(state) <
        offlineDamageCritChance(state, casterIndex);
    var channelBonus = spellScaling.channelTickBonus(
        <float>state.entitySpellPower[casterIndex],
        "arcane",
        false,
        m4AbilityCatalog.metric(abilityIndex, level, "channelDuration"),
        <int>m4AbilityCatalog.metric(abilityIndex, level, "channelTicks")
    );
    var rawDamage = terrainGradient.javascriptRound(
        (minimum + nextAuthoritativeRandomUnit(state) * (maximum - minimum) +
            <float>channelBonus + <float>plan.bonusPerBolt) *
            <float>state.entitySpellDamageMultipliers[casterIndex] *
            (critical ? 1.5 + <float>state.entityCritDamageSpellBonus[casterIndex] : 1.0),
        true
    );
    if (rawDamage < 0) { rawDamage = 0; }
    var damage = resolveOfflineFixedSpellImpactDamage(
        state, casterIndex, targetIndex, abilityCode, OFFLINE_PROJECTILE_SCHOOL_ARCANE,
        rawDamage, critical
    );
    var dealt = applyOfflineArcaneEffectiveDamage(state, targetIndex, damage);
    var hp = <int>state.entityHp[targetIndex];
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (dealt > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, dealt);
        applyOfflineTemporalEchoDamageConversion(
            state, casterIndex, dealt, OFFLINE_PROJECTILE_SCHOOL_ARCANE, false
        );
    }
    if (hp > 0) {
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

removeOfflineConsecrationGroundEffectAt(state: WorldState, index: int): void {
    state.offlineGroundEffectSourceIds.removeAt(index);
    state.offlineGroundEffectAbilityCodes.removeAt(index);
    state.offlineGroundEffectX.removeAt(index);
    state.offlineGroundEffectZ.removeAt(index);
    state.offlineGroundEffectRadii.removeAt(index);
    state.offlineGroundEffectMinimums.removeAt(index);
    state.offlineGroundEffectMaximums.removeAt(index);
    state.offlineGroundEffectSpellPowerBonuses.removeAt(index);
    state.offlineGroundEffectRemaining.removeAt(index);
    state.offlineGroundEffectIntervals.removeAt(index);
    state.offlineGroundEffectTickTimers.removeAt(index);
}

// The source traverses ground zones in reverse creation order. Time advances
// before a due pulse, and the duration-boundary pulse remains eligible.
stepOfflineConsecrationGroundEffects(state: WorldState): void {
    var index = state.offlineGroundEffectSourceIds.length - 1;
    while (index >= 0) {
        var remaining = <float>state.offlineGroundEffectRemaining[index] -
            projectileTravel.projectileTickSeconds();
        var timer = <float>state.offlineGroundEffectTickTimers[index] -
            projectileTravel.projectileTickSeconds();
        if (timer <= OFFLINE_PERIODIC_TICK_EPS && remaining > OFFLINE_PERIODIC_TICK_EPS) {
            timer = timer + <float>state.offlineGroundEffectIntervals[index];
            var pulse = new groundAoE.GroundEffectSpec();
            pulse.id = <uint>state.offlineGroundEffectAbilityCodes[index];
            pulse.sourceId = <uint>state.offlineGroundEffectSourceIds[index];
            pulse.x = <float>state.offlineGroundEffectX[index];
            pulse.z = <float>state.offlineGroundEffectZ[index];
            pulse.radius = <float>state.offlineGroundEffectRadii[index];
            pulse.minimum = <float>state.offlineGroundEffectMinimums[index];
            pulse.maximum = <float>state.offlineGroundEffectMaximums[index];
            pulse.school = "holy";
            pulse.spellPowerBonus = <float>state.offlineGroundEffectSpellPowerBonuses[index];
            pulse.threatFlat = 0.0;
            pulse.threatMultiplier = 1.0;
            resolveOfflineGroundAoEPulse(state, pulse, -1);
        }
        if (remaining <= OFFLINE_PERIODIC_TICK_EPS) {
            removeOfflineConsecrationGroundEffectAt(state, index);
        } else {
            state.offlineGroundEffectRemaining[index] = remaining;
            state.offlineGroundEffectTickTimers[index] = timer;
        }
        index = index - 1;
    }
}

// Mirrors the source GroundAoE tick: reverse creation order, lifetime before
// contact, an arming tick that cannot trigger, then first swept hostile contact.
stepOfflineHunterTraps(state: WorldState): void {
    if (!offlineHunterTrapStateIsValid(state)) {
        throw "woc Hunter trap state is invalid";
    }
    var trapIndex = state.offlineHunterTrapSourceIds.length - 1;
    while (trapIndex >= 0) {
        var sourceIndex = partyEntityIndexById(
            state, <uint>state.offlineHunterTrapSourceIds[trapIndex]
        );
        if (sourceIndex < 0) {
            removeOfflineHunterTrapAt(state, trapIndex);
            trapIndex = trapIndex - 1;
            continue;
        }
        var remaining = <float>state.offlineHunterTrapRemaining[trapIndex] -
            projectileTravel.projectileTickSeconds();
        if (remaining <= OFFLINE_PERIODIC_TICK_EPS) {
            removeOfflineHunterTrapAt(state, trapIndex);
            trapIndex = trapIndex - 1;
            continue;
        }
        var armRemaining = <float>state.offlineHunterTrapArmRemaining[trapIndex];
        if (armRemaining > 0.0) {
            armRemaining = armRemaining - projectileTravel.projectileTickSeconds();
            state.offlineHunterTrapRemaining[trapIndex] = remaining;
            state.offlineHunterTrapArmRemaining[trapIndex] =
                armRemaining > 0.0 ? armRemaining : 0.0;
            trapIndex = trapIndex - 1;
            continue;
        }
        var center = new ringOfFrostGeometry.PointXZ(
            <float>state.offlineHunterTrapX[trapIndex],
            <float>state.offlineHunterTrapZ[trapIndex]
        );
        var targetIndex = 0;
        var triggered = false;
        while (targetIndex < state.entityIds.length) {
            if (isOfflineEastbrookLifecycleMob(state, targetIndex) &&
                !<bool>state.entityDead[targetIndex] &&
                <bool>state.entityHostile[targetIndex] &&
                ringOfFrostGeometry.segmentTouchesAnnulus(
                    new ringOfFrostGeometry.PointXZ(
                        <float>state.entityPreviousX[targetIndex],
                        <float>state.entityPreviousZ[targetIndex]
                    ),
                    new ringOfFrostGeometry.PointXZ(
                        <float>state.entityX[targetIndex],
                        <float>state.entityZ[targetIndex]
                    ),
                    center,
                    0.0,
                    <float>state.offlineHunterTrapRadii[trapIndex]
                )) {
                applyOfflineMotionAuraWithDetailsAndSchool(
                    state,
                    targetIndex,
                    <uint>state.offlineHunterTrapAbilityCodes[trapIndex],
                    <uint>state.offlineHunterTrapSourceIds[trapIndex],
                    ccContract.motionAuraKindCode("stun"),
                    <float>state.offlineHunterTrapFreezeDurations[trapIndex],
                    0.0,
                    0.0,
                    OFFLINE_PROJECTILE_SCHOOL_FROST
                );
                state.entityInCombat[sourceIndex] = true;
                state.entityCombatTimers[sourceIndex] = 0.0;
                state.entityInCombat[targetIndex] = true;
                state.entityCombatTimers[targetIndex] = 0.0;
                if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
                    enterIdleMobAggro(
                        state, targetIndex, <uint>state.offlineHunterTrapSourceIds[trapIndex]
                    );
                } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
                    state.entityAggroTargetIds[targetIndex] =
                        <uint>state.offlineHunterTrapSourceIds[trapIndex];
                }
                triggered = true;
                break;
            }
            targetIndex = targetIndex + 1;
        }
        if (triggered) {
            // Source sets the rider's triggered flag then the parent ground
            // loop removes it in the same tick; no triggered row is durable.
            removeOfflineHunterTrapAt(state, trapIndex);
        } else {
            state.offlineHunterTrapRemaining[trapIndex] = remaining;
        }
        trapIndex = trapIndex - 1;
    }
}

removeOfflineRejuvenationHotAt(state: WorldState, index: int): void {
    state.offlineHotTargetIds.removeAt(index);
    state.offlineHotSourceIds.removeAt(index);
    state.offlineHotAbilityCodes.removeAt(index);
    state.offlineHotHeals.removeAt(index);
    state.offlineHotRanks.removeAt(index);
    state.offlineHotSnapshotPowers.removeAt(index);
    state.offlineHotRemaining.removeAt(index);
    state.offlineHotDurations.removeAt(index);
    state.offlineHotTickIntervals.removeAt(index);
    state.offlineHotTickTimers.removeAt(index);
}

removeOfflineAbsorbAt(state: WorldState, index: int): void {
    state.offlineAbsorbTargetIds.removeAt(index);
    state.offlineAbsorbSourceIds.removeAt(index);
    state.offlineAbsorbAbilityCodes.removeAt(index);
    state.offlineAbsorbRanks.removeAt(index);
    state.offlineAbsorbAmounts.removeAt(index);
    state.offlineAbsorbRemaining.removeAt(index);
    state.offlineAbsorbResolvedInitialAmounts.removeAt(index);
    state.offlineAbsorbTalentSpecCodes.removeAt(index);
    var row = 0;
    while (row < 6) {
        state.offlineAbsorbTalentRowOptionCodes.removeAt(index * 6);
        row = row + 1;
    }
}

// Source applyAura replaces the matching target/id/source row, then pushes the
// new aura. The retained queue keeps the same insertion order because damage
// consumes newest source auras before older independently cast shields.
applyOfflineFixedAbsorb(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    abilityCode: uint,
    rank: int,
    amount: int,
    duration: float
): void {
    if (targetId == <uint>0 || sourceId == <uint>0 || abilityCode == <uint>0 ||
        rank <= 0 || rank > 65535 || amount <= 0 || duration <= 0.0) {
        throw "woc offline absorb row is invalid";
    }
    var index = 0;
    while (index < state.offlineAbsorbTargetIds.length) {
        if (<uint>state.offlineAbsorbTargetIds[index] == targetId &&
            <uint>state.offlineAbsorbSourceIds[index] == sourceId &&
            <uint>state.offlineAbsorbAbilityCodes[index] == abilityCode) {
            removeOfflineAbsorbAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineAbsorbTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc offline absorb queue exceeds WOS cap";
    }
    state.offlineAbsorbTargetIds.add(targetId);
    state.offlineAbsorbSourceIds.add(sourceId);
    state.offlineAbsorbAbilityCodes.add(abilityCode);
    state.offlineAbsorbRanks.add(<uint>rank);
    state.offlineAbsorbAmounts.add(amount);
    state.offlineAbsorbRemaining.add(duration);
    state.offlineAbsorbResolvedInitialAmounts.add(amount);
    state.offlineAbsorbTalentSpecCodes.add(<uint>0);
    var row = 0;
    while (row < 6) {
        state.offlineAbsorbTalentRowOptionCodes.add(<uint>0);
        row = row + 1;
    }
}

captureOfflineTalentAbsorbState(
    state: WorldState, sourceId: uint, abilityCode: uint
): void {
    var index = state.offlineAbsorbTargetIds.length - 1;
    if (index < 0 || !offlineAbsorbIsTalentScalable(abilityCode) ||
        <uint>state.offlineAbsorbSourceIds[index] != sourceId ||
        <uint>state.offlineAbsorbAbilityCodes[index] != abilityCode) {
        return;
    }
    var sourceIndex = partyEntityIndexById(state, sourceId);
    if (sourceIndex < 0) return;
    state.offlineAbsorbTalentSpecCodes[index] =
        <uint>state.entityTalentSpecCodes[sourceIndex];
    var row = 0;
    while (row < 6) {
        state.offlineAbsorbTalentRowOptionCodes[index * 6 + row] =
            talentRowCodeAt(state, sourceIndex, row);
        row = row + 1;
    }
}

applyOfflinePowerWordShield(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    abilityCode: uint,
    rank: int
): void {
    var abilityIndex = m4AbilityCatalog.indexOf("power_word_shield");
    var profile = absorbProfiles.resolveAbsorbProfile(abilityIndex, rank);
    if (abilityCode != powerWordShieldAbilityCode() || !profile.valid) {
        throw "woc Power Word Shield profile is invalid";
    }
    var amount = resolveOfflineTalentAbsorbAmount(
        state, sourceId, abilityCode, rank, profile.amount
    );
    applyOfflineFixedAbsorb(
        state, targetId, sourceId, abilityCode, rank, amount, profile.duration
    );
    captureOfflineTalentAbsorbState(state, sourceId, abilityCode);
}

offlineWardedPersonalBarrierIsActive(state: WorldState, targetIndex: int): bool {
    if (targetIndex < 0 || targetIndex >= state.entityIds.length) { return false; }
    var targetId = <uint>state.entityIds[targetIndex];
    var index = 0;
    while (index < state.offlineAbsorbTargetIds.length) {
        if (<uint>state.offlineAbsorbTargetIds[index] == targetId &&
            <uint>state.offlineAbsorbSourceIds[index] == targetId &&
            (<uint>state.offlineAbsorbAbilityCodes[index] == iceBarrierAbilityCode() ||
                <uint>state.offlineAbsorbAbilityCodes[index] == blazingBarrierAbilityCode() ||
                <uint>state.offlineAbsorbAbilityCodes[index] == temporalBarrierAbilityCode()) &&
            <int>state.offlineAbsorbAmounts[index] > 0 &&
            <float>state.offlineAbsorbRemaining[index] > 0.0) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

offlineWardedIncomingDamage(state: WorldState, targetIndex: int, damage: int): int {
    if (damage <= 0 || targetIndex < 0 || targetIndex >= state.entityIds.length ||
        <uint>state.entityKinds[targetIndex] != <uint>1 ||
        !offlineWardedPersonalBarrierIsActive(state, targetIndex)) {
        return damage;
    }
    var modifiers = offlineTalentModifiersForEntity(state, targetIndex);
    var reduction = talentModifiers.globalField(modifiers, "barrierDrPct");
    if (reduction <= 0.0) { return damage; }
    var multiplier = 1.0 - reduction;
    if (multiplier < 0.0) { multiplier = 0.0; }
    return <int>(<float>damage * multiplier + 0.5);
}

wardedTalentProcIndex(): int {
    var index = 0;
    while (index < talentProcCatalog.procCount()) {
        if (talentProcCatalog.procId(index) == "mag_warded") { return index; }
        index = index + 1;
    }
    return -1;
}

applyOfflineWardedHeal(
    state: WorldState, sourceIndex: int, targetIndex: int, amount: int
): void {
    if (amount <= 0 || sourceIndex < 0 || targetIndex < 0 ||
        sourceIndex >= state.entityIds.length || targetIndex >= state.entityIds.length ||
        <bool>state.entityDead[sourceIndex] || <bool>state.entityDead[targetIndex]) {
        return;
    }
    var source = new healState.HealEntity();
    source.id = <uint>state.entityIds[sourceIndex];
    source.kind = "player";
    source.dead = false;
    source.hp = <int>state.entityHp[sourceIndex];
    source.maxHp = <int>state.entityMaxHp[sourceIndex];
    source.spellCritChance = offlineSpellCritChance(state, sourceIndex);
    var target = new healState.HealEntity();
    target.id = <uint>state.entityIds[targetIndex];
    target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ? "player" : "mob";
    target.dead = <bool>state.entityDead[targetIndex];
    target.hp = <int>state.entityHp[targetIndex];
    target.maxHp = <int>state.entityMaxHp[targetIndex];
    var mobs = new healState.AwareMobProjection();
    var mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        var threatStart = <int><uint>state.entityThreatOffsets[mobIndex];
        var threatEnd = <int><uint>state.entityThreatOffsets[mobIndex + 1];
        var directTargetEntry = false;
        var ownedPetEntry = false;
        var threatIndex = threatStart;
        while (threatIndex < threatEnd) {
            var threatTargetId = <uint>state.entityThreatTargetIds[threatIndex];
            if (threatTargetId == target.id) { directTargetEntry = true; }
            if (target.kind == "player") {
                var threatTargetIndex = partyEntityIndexById(state, threatTargetId);
                if (threatTargetIndex >= 0 &&
                    <uint>state.entityOwnerIds[threatTargetIndex] == target.id) {
                    ownedPetEntry = true;
                }
            }
            threatIndex = threatIndex + 1;
        }
        mobs.addMob(
            <bool>state.entityDead[mobIndex],
            <uint>state.entityKinds[mobIndex] == <uint>2 &&
                <bool>state.entityHostile[mobIndex],
            <bool>state.entityInCombat[mobIndex],
            threatEnd > threatStart,
            directTargetEntry,
            ownedPetEntry
        );
        mobIndex = mobIndex + 1;
    }
    var events = new healState.HealEvents();
    events.randomUnits.add(nextAuthoritativeRandomUnit(state));
    healState.applyHeal(source, target, <float>amount, mobs, events);
    state.entityHp[targetIndex] = target.hp;
    mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        if (<float>mobs.healerThreat[mobIndex] > 0.0) {
            state.setThreat(
                <uint>state.entityIds[mobIndex], source.id,
                stateThreatValue(state, mobIndex, source.id) +
                    <float>mobs.healerThreat[mobIndex],
                1
            );
        }
        mobIndex = mobIndex + 1;
    }
}

applyOfflineWardedShieldConsumed(
    state: WorldState, sourceId: uint, shieldAbilityCode: uint, targetIndex: int
): void {
    if ((shieldAbilityCode != iceBarrierAbilityCode() &&
            shieldAbilityCode != blazingBarrierAbilityCode() &&
            shieldAbilityCode != temporalBarrierAbilityCode()) || sourceId == <uint>0 ||
        targetIndex < 0 || targetIndex >= state.entityIds.length) {
        return;
    }
    var sourceIndex = partyEntityIndexById(state, sourceId);
    var procIndex = wardedTalentProcIndex();
    if (sourceIndex < 0 || procIndex < 0 ||
        !talentProcs.catalogEntryMatchesSelection(
            procIndex, talentRowCodeAt(state, sourceIndex, 1), false
        )) {
        return;
    }
    var definition = talentProcs.definitionFromCatalog(procIndex);
    var decision = talentProcs.onShieldConsumed(
        definition, knownAbilityCatalog.abilityId(<int>shieldAbilityCode), true
    );
    if (!decision.fired) { return; }
    var responseIndex = 0;
    while (responseIndex < talentProcCatalog.procResponseCount(procIndex)) {
        var response = talentProcs.responseFromCatalog(procIndex, responseIndex);
        var plan = talentProcs.planResponse(
            definition,
            response,
            sourceId,
            <uint>state.entityIds[targetIndex],
            <int>state.entityMaxHp[targetIndex],
            true,
            false,
            0.0
        );
        if (plan.applies && plan.healAmount > 0) {
            applyOfflineWardedHeal(state, sourceIndex, targetIndex, plan.healAmount);
        }
        responseIndex = responseIndex + 1;
    }
}

// The retained Eastbrook incoming-damage bridge calls this after the source
// hit table. It therefore returns only the post-absorb amount that may break
// incapacitates, push back casts, reduce HP or cause death.
applyOfflineAbsorbDamage(state: WorldState, targetIndex: int, damage: int): int {
    if (damage <= 0 || targetIndex < 0 || targetIndex >= state.entityIds.length) {
        return damage;
    }
    if (temporalHourglassProtectsDamage(state, targetIndex)) { return 0; }
    var remainingDamage = offlineWardedIncomingDamage(state, targetIndex, damage);
    var targetId = <uint>state.entityIds[targetIndex];
    var index = state.offlineAbsorbTargetIds.length - 1;
    while (index >= 0 && remainingDamage > 0) {
        if (<uint>state.offlineAbsorbTargetIds[index] == targetId &&
            offlineAbsorbProfileAndDurationMatches(
                <uint>state.offlineAbsorbAbilityCodes[index],
                <int><uint>state.offlineAbsorbRanks[index],
                <int>state.offlineAbsorbResolvedInitialAmounts[index],
                <float>state.offlineAbsorbRemaining[index]
            )) {
            var available = <int>state.offlineAbsorbAmounts[index];
            var soaked = available < remainingDamage ? available : remainingDamage;
            available = available - soaked;
            remainingDamage = remainingDamage - soaked;
            if (available <= 0) {
                var sourceId = <uint>state.offlineAbsorbSourceIds[index];
                var shieldAbilityCode = <uint>state.offlineAbsorbAbilityCodes[index];
                removeOfflineAbsorbAt(state, index);
                applyOfflineWardedShieldConsumed(
                    state, sourceId, shieldAbilityCode, targetIndex
                );
            } else {
                state.offlineAbsorbAmounts[index] = available;
            }
        }
        index = index - 1;
    }
    return remainingDamage;
}

// Source player aura ticking precedes source mob updates. Absorb rows age
// during that phase even when their target is dead, matching the source timer model.
ageOfflineAbsorbs(state: WorldState): void {
    var index = 0;
    while (index < state.offlineAbsorbTargetIds.length) {
        var remaining = <float>state.offlineAbsorbRemaining[index] -
            projectileTravel.projectileTickSeconds();
        if (remaining <= OFFLINE_PERIODIC_TICK_EPS) {
            removeOfflineAbsorbAt(state, index);
        } else {
            state.offlineAbsorbRemaining[index] = remaining;
            index = index + 1;
        }
    }
}

// applyAura replaces a normal HoT only when the target, aura id and source
// agree. The compact WOS row follows that source-aware identity and retains
// the profile selected at application, never a later gear value.
offlineResolvedHotTotal(
    state: WorldState,
    sourceId: uint,
    abilityId: string,
    abilityIndex: int,
    rank: int,
    effectIndex: int
): int {
    var effects = %import("generated/m4_ability_effects");
    var baseTotal = <int>(effects.metric(abilityIndex, rank, effectIndex, "total") + 0.5);
    var sourceIndex = partyEntityIndexById(state, sourceId);
    if (sourceIndex < 0) { return baseTotal; }
    var modifiers = offlineTalentModifiersForEntity(state, sourceIndex);
    return hotTalentScaling.resolveHotTotal(baseTotal, modifiers, abilityId);
}

applyOfflinePureHot(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    abilityCode: uint,
    rank: int,
    snapshotPower: int
): void {
    var abilityIndex = pureHotAbilityIndex(abilityCode);
    if (abilityIndex < 0) {
        throw "woc pure hot ability identity is invalid";
    }
    var resolvedTotal = offlineResolvedHotTotal(
        state, sourceId, m4AbilityCatalog.text(abilityIndex, "id"), abilityIndex, rank, 0
    );
    var profile = pureHotProfiles.resolvePureHotProfileWithResolvedTotal(
        abilityIndex, rank, snapshotPower, resolvedTotal
    );
    if (!profile.valid) {
        throw "woc pure hot profile is invalid";
    }
    var index = 0;
    while (index < state.offlineHotTargetIds.length) {
        if (<uint>state.offlineHotTargetIds[index] == targetId &&
            <uint>state.offlineHotSourceIds[index] == sourceId &&
            <uint>state.offlineHotAbilityCodes[index] == abilityCode) {
            removeOfflineRejuvenationHotAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineHotTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc offline hot queue exceeds WOS cap";
    }
    state.offlineHotTargetIds.add(targetId);
    state.offlineHotSourceIds.add(sourceId);
    state.offlineHotAbilityCodes.add(abilityCode);
    state.offlineHotHeals.add(profile.heal);
    state.offlineHotRanks.add(<uint>rank);
    state.offlineHotSnapshotPowers.add(profile.snapshotPower);
    state.offlineHotRemaining.add(profile.duration);
    state.offlineHotDurations.add(profile.duration);
    state.offlineHotTickIntervals.add(profile.interval);
    state.offlineHotTickTimers.add(profile.interval);
}

// Regrowth's HoT shares the normal source-aware Aura replacement identity,
// but must retain its zero-extra-scaling profile rather than the pure-HoT SP snapshot.
applyOfflineRegrowthHot(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    abilityCode: uint,
    rank: int
): void {
    if (abilityCode != regrowthAbilityCode()) {
        throw "woc Regrowth hot ability identity is invalid";
    }
    var abilityIndex = m4AbilityCatalog.indexOf("regrowth");
    if (abilityIndex < 0) {
        throw "woc Regrowth hot catalog entry is absent";
    }
    var resolvedTotal = offlineResolvedHotTotal(
        state, sourceId, "regrowth", abilityIndex, rank, 1
    );
    var profile = hybridHotProfiles.resolveHybridHotProfileWithResolvedTotal(
        abilityIndex, rank, resolvedTotal
    );
    if (!profile.valid) {
        throw "woc Regrowth hot profile is invalid";
    }
    var index = 0;
    while (index < state.offlineHotTargetIds.length) {
        if (<uint>state.offlineHotTargetIds[index] == targetId &&
            <uint>state.offlineHotSourceIds[index] == sourceId &&
            <uint>state.offlineHotAbilityCodes[index] == abilityCode) {
            removeOfflineRejuvenationHotAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineHotTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc offline hot queue exceeds WOS cap";
    }
    state.offlineHotTargetIds.add(targetId);
    state.offlineHotSourceIds.add(sourceId);
    state.offlineHotAbilityCodes.add(abilityCode);
    state.offlineHotHeals.add(profile.heal);
    state.offlineHotRanks.add(<uint>rank);
    state.offlineHotSnapshotPowers.add(0);
    state.offlineHotRemaining.add(profile.duration);
    state.offlineHotDurations.add(profile.duration);
    state.offlineHotTickIntervals.add(profile.interval);
    state.offlineHotTickTimers.add(profile.interval);
}

// Historic callers supplied only the already-resolved Rejuvenation tick. Keep
// the helper for WOS60 migration coverage; new casts always use the profile
// path above and therefore carry rank plus spell-power source facts.
applyOfflineRejuvenationHot(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    abilityCode: uint,
    heal: int,
    duration: float,
    interval: float
): void {
    if (abilityCode != rejuvenationAbilityCode() ||
        !rejuvenationHotProfileIsValid(heal, duration, interval)) {
        throw "woc Rejuvenation hot profile is invalid";
    }
    var index = 0;
    while (index < state.offlineHotTargetIds.length) {
        if (<uint>state.offlineHotTargetIds[index] == targetId &&
            <uint>state.offlineHotSourceIds[index] == sourceId &&
            <uint>state.offlineHotAbilityCodes[index] == abilityCode) {
            removeOfflineRejuvenationHotAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineHotTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc offline hot queue exceeds WOS cap";
    }
    state.offlineHotTargetIds.add(targetId);
    state.offlineHotSourceIds.add(sourceId);
    state.offlineHotAbilityCodes.add(abilityCode);
    state.offlineHotHeals.add(heal);
    state.offlineHotRanks.add(<uint>0);
    state.offlineHotSnapshotPowers.add(0);
    state.offlineHotRemaining.add(duration);
    state.offlineHotDurations.add(duration);
    state.offlineHotTickIntervals.add(interval);
    state.offlineHotTickTimers.add(interval);
}

// Rejuvenation ticks use the source hot branch: no crit roll, no heal-absorb
// drain, target healing modifiers only, then effective-healing threat.
applyOfflineRejuvenationHotTick(
    state: WorldState,
    hotIndex: int,
    sourceIndex: int,
    targetIndex: int
): void {
    var source = new healState.HealEntity();
    source.id = <uint>state.offlineHotSourceIds[hotIndex];
    source.kind = "player";
    source.dead = true;
    if (sourceIndex >= 0) {
        source.id = <uint>state.entityIds[sourceIndex];
        source.kind = <uint>state.entityKinds[sourceIndex] == <uint>1 ? "player" : "mob";
        source.dead = <bool>state.entityDead[sourceIndex];
    }
    var target = new healState.HealEntity();
    target.id = <uint>state.entityIds[targetIndex];
    target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ? "player" : "mob";
    target.dead = <bool>state.entityDead[targetIndex];
    target.hp = <int>state.entityHp[targetIndex];
    target.maxHp = <int>state.entityMaxHp[targetIndex];

    var mobs = new healState.AwareMobProjection();
    var mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        var threatStart = <int><uint>state.entityThreatOffsets[mobIndex];
        var threatEnd = <int><uint>state.entityThreatOffsets[mobIndex + 1];
        var directTargetEntry = false;
        var ownedPetEntry = false;
        var threatIndex = threatStart;
        while (threatIndex < threatEnd) {
            var threatTargetId = <uint>state.entityThreatTargetIds[threatIndex];
            if (threatTargetId == target.id) { directTargetEntry = true; }
            if (target.kind == "player") {
                var threatTargetIndex = partyEntityIndexById(state, threatTargetId);
                if (threatTargetIndex >= 0 &&
                    <uint>state.entityOwnerIds[threatTargetIndex] == target.id) {
                    ownedPetEntry = true;
                }
            }
            threatIndex = threatIndex + 1;
        }
        mobs.addMob(
            <bool>state.entityDead[mobIndex],
            <uint>state.entityKinds[mobIndex] == <uint>2 &&
                <bool>state.entityHostile[mobIndex],
            <bool>state.entityInCombat[mobIndex],
            threatEnd > threatStart,
            directTargetEntry,
            ownedPetEntry
        );
        mobIndex = mobIndex + 1;
    }
    var events = new healState.HealEvents();
    var sourcePresent = sourceIndex >= 0 && source.kind == "player" && !source.dead;
    healState.applyHotTick(
        source, target, <int>state.offlineHotHeals[hotIndex], sourcePresent, mobs, events
    );
    state.entityHp[targetIndex] = target.hp;
    mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        if (<float>mobs.healerThreat[mobIndex] > 0.0) {
            state.setThreat(
                <uint>state.entityIds[mobIndex],
                source.id,
                stateThreatValue(state, mobIndex, source.id) +
                    <float>mobs.healerThreat[mobIndex],
                1
            );
        }
        mobIndex = mobIndex + 1;
    }
}

// The reference advances player auras after player movement/timers and before
// mob update. This retained queue owns only Rejuvenation's player/owned-pet
// target subset, so it runs immediately after the retained player stage.
stepOfflineRejuvenationHots(state: WorldState): void {
    var hotIndex = 0;
    while (hotIndex < state.offlineHotTargetIds.length) {
        var targetIndex = partyEntityIndexById(
            state, <uint>state.offlineHotTargetIds[hotIndex]
        );
        if (targetIndex < 0 || <bool>state.entityDead[targetIndex] ||
            (<uint>state.entityKinds[targetIndex] == <uint>1 &&
                <bool>state.entityHostile[targetIndex]) ||
            (<uint>state.entityKinds[targetIndex] == <uint>2 &&
                <uint>state.entityOwnerIds[targetIndex] == <uint>0)) {
            removeOfflineRejuvenationHotAt(state, hotIndex);
            continue;
        }
        var remaining = <float>state.offlineHotRemaining[hotIndex] -
            projectileTravel.projectileTickSeconds();
        var timer = <float>state.offlineHotTickTimers[hotIndex] -
            projectileTravel.projectileTickSeconds();
        if (timer <= OFFLINE_PERIODIC_TICK_EPS) {
            timer = timer + <float>state.offlineHotTickIntervals[hotIndex];
            var sourceIndex = partyEntityIndexById(
                state, <uint>state.offlineHotSourceIds[hotIndex]
            );
            applyOfflineRejuvenationHotTick(state, hotIndex, sourceIndex, targetIndex);
        }
        if (remaining <= OFFLINE_PERIODIC_TICK_EPS || <bool>state.entityDead[targetIndex]) {
            removeOfflineRejuvenationHotAt(state, hotIndex);
        } else {
            state.offlineHotRemaining[hotIndex] = remaining;
            state.offlineHotTickTimers[hotIndex] = timer;
            hotIndex = hotIndex + 1;
        }
    }
}

removeOfflineDotAt(state: WorldState, index: int): void {
    state.offlineDotTargetIds.removeAt(index);
    state.offlineDotSourceIds.removeAt(index);
    state.offlineDotAbilityCodes.removeAt(index);
    state.offlineDotDamages.removeAt(index);
    state.offlineDotRanks.removeAt(index);
    state.offlineDotSnapshotPowers.removeAt(index);
    state.offlineDotResolvedTotals.removeAt(index);
    state.offlineDotTalentSpecCodes.removeAt(index);
    var talentRow = 0;
    while (talentRow < 6) {
        state.offlineDotTalentRowOptionCodes.removeAt(index * 6);
        talentRow = talentRow + 1;
    }
    state.offlineDotRemaining.removeAt(index);
    state.offlineDotDurations.removeAt(index);
    state.offlineDotTickIntervals.removeAt(index);
    state.offlineDotTickTimers.removeAt(index);
}

appendOfflineDotTalentState(
    state: WorldState,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    resolvedTotal: int,
    projectileIndex: int
): void {
    if (resolvedTotal <= 0) {
        throw "woc offline dot resolved total is invalid";
    }
    state.offlineDotResolvedTotals.add(resolvedTotal);
    appendOfflineDotTalentSnapshot(
        state, sourceId, abilityCode, rank, projectileIndex
    );
}

// Fireball's source aura replaces its prior row on the same target. The
// persisted row stores the resolved periodic profile, so reload never depends
// on a later caster-level change to reconstruct already-applied damage.
applyOfflineFireballDot(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    snapshotPower: int,
    resolvedTotal: int,
    projectileIndex: int,
    damage: int,
    duration: float,
    interval: float
): void {
    var abilityIndex = m4AbilityCatalog.indexOf("fireball");
    if (abilityCode != fireballAbilityCode() ||
        !numericEffects.dotProfileMatchesResolvedTotal(
            abilityIndex, <int>rank, 1, snapshotPower, resolvedTotal, damage, duration, interval
        )) {
        throw "woc Fireball dot profile is invalid";
    }
    var index = 0;
    while (index < state.offlineDotTargetIds.length) {
        if (<uint>state.offlineDotTargetIds[index] == targetId &&
            <uint>state.offlineDotAbilityCodes[index] == abilityCode) {
            removeOfflineDotAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineDotTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc offline dot queue exceeds WOS cap";
    }
    state.offlineDotTargetIds.add(targetId);
    state.offlineDotSourceIds.add(sourceId);
    state.offlineDotAbilityCodes.add(abilityCode);
    state.offlineDotDamages.add(damage);
    state.offlineDotRanks.add(rank);
    state.offlineDotSnapshotPowers.add(snapshotPower);
    appendOfflineDotTalentState(
        state, sourceId, abilityCode, rank, resolvedTotal, projectileIndex
    );
    state.offlineDotRemaining.add(duration);
    state.offlineDotDurations.add(duration);
    state.offlineDotTickIntervals.add(interval);
    state.offlineDotTickTimers.add(interval);
}

