// Renew uses the same pure-HoT source path as Rejuvenation, but its source
// ranks, 15-second duration and same-source aura replacement remain distinct.
pub renewCommandStateTest(): int {
    if (pureHotProfiles.contractTest() != 1 || healState.contractTest() != 1) {
        return -1;
    }
    var renew = renewAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("renew");
    if (renew == <uint>0 || abilityIndex != 25 ||
        m4AbilityCatalog.text(abilityIndex, "class") != "priest" ||
        m4AbilityCatalog.text(abilityIndex, "targetType") != "friendly") {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>5;
    var casterId = state.spawnPlayer(<uint>5, 8, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnPlayer(<uint>5, 1, 0.0, 1.5, 10.0, 100, 7.0, 1);
    state.entityHp[1] = 0;
    state.entityResources[0] = 100;
    state.entityMaxResources[0] = 100;
    state.entitySpellPower[0] = 150;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(renew);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, casterId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (<int>state.entityResources[0] != 70 || <uint>state.rngDraws != <uint>0 ||
        state.offlineProjectileSourceIds.length != 0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        state.offlineHotTargetIds.length != 1 ||
        <uint>state.offlineHotTargetIds[0] != targetId ||
        <uint>state.offlineHotSourceIds[0] != casterId ||
        <uint>state.offlineHotAbilityCodes[0] != renew ||
        <int>state.offlineHotHeals[0] != 39 ||
        <uint>state.offlineHotRanks[0] != <uint>1 ||
        <int>state.offlineHotSnapshotPowers[0] != 150 ||
        !floatMatches(<float>state.offlineHotDurations[0], 15.0) ||
        !floatMatches(<float>state.offlineHotTickIntervals[0], 3.0)) {
        return -3;
    }

    var restored = decodeState(encodeState(state));
    if (restored.offlineHotTargetIds.length != 1 ||
        <uint>restored.offlineHotAbilityCodes[0] != renew ||
        <uint>restored.offlineHotRanks[0] != <uint>1 ||
        <int>restored.offlineHotSnapshotPowers[0] != 150 ||
        <int>restored.offlineHotHeals[0] != 39) {
        return -4;
    }
    restored.offlineHotTickTimers[0] = 0.05;
    stepOfflineRejuvenationHots(restored);
    if (<int>restored.entityHp[1] != 39 || <uint>restored.rngDraws != <uint>0 ||
        !floatMatches(<float>restored.offlineHotRemaining[0], 14.95) ||
        !floatMatches(<float>restored.offlineHotTickTimers[0], 3.0)) {
        return -5;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    startOfflineRenewCast(restored, 0, targetId);
    if (<int>restored.entityResources[0] != 40 || restored.offlineHotTargetIds.length != 1 ||
        !floatMatches(<float>restored.offlineHotRemaining[0], 15.0) ||
        !floatMatches(<float>restored.offlineHotTickTimers[0], 3.0)) {
        return -6;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 30;
    restored.entitySpellHaste[0] = 2.0;
    var renewBytes = new container.Array<uint>();
    renewBytes.add(<uint>114); renewBytes.add(<uint>101); renewBytes.add(<uint>110);
    renewBytes.add(<uint>101); renewBytes.add(<uint>119);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, casterId, <uint>1, <uint>2, renewBytes, targetId
    );
    restored.applyCommands(typed, 1);
    if (<int>restored.entityResources[0] != 0 || restored.offlineHotTargetIds.length != 1 ||
        !floatMatches(<float>restored.entityCastGcdRemaining[0], 0.75) ||
        <uint>restored.entityLastCommandSequence[0] != <uint>2) {
        return -7;
    }
    applyOfflinePureHot(restored, targetId, <uint>777, renew, 1, 150);
    return restored.offlineHotTargetIds.length == 2 &&
        <uint>restored.offlineHotSourceIds[0] == casterId &&
        <uint>restored.offlineHotSourceIds[1] == <uint>777 ? 1 : -8;
