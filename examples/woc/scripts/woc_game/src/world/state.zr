pureDotAbilityIndex(abilityCode: uint): int {
    if (abilityCode == serpentStingAbilityCode()) {
        return m4AbilityCatalog.indexOf("serpent_sting");
    }
    if (abilityCode == shadowWordPainAbilityCode()) {
        return m4AbilityCatalog.indexOf("shadow_word_pain");
    }
    if (abilityCode == corruptionAbilityCode()) {
        return m4AbilityCatalog.indexOf("corruption");
    }
    if (abilityCode == curseOfAgonyAbilityCode()) {
        return m4AbilityCatalog.indexOf("curse_of_agony");
    }
    if (abilityCode == siphonLifeAbilityCode()) {
        return m4AbilityCatalog.indexOf("siphon_life");
    }
    if (abilityCode == insectSwarmAbilityCode()) {
        return m4AbilityCatalog.indexOf("insect_swarm");
    }
    if (abilityCode == ripAbilityCode()) {
        return m4AbilityCatalog.indexOf("rip");
    }
    return -1;
}

// Every pure DoT retains an explicit rank-to-learn-level mapping so a saved
// projectile can prove both its rank and its source cast profile after load.
pureDotRankLevel(abilityCode: uint, rank: uint): int {
    if (abilityCode == serpentStingAbilityCode() ||
        abilityCode == shadowWordPainAbilityCode()) {
        if (rank == <uint>1) { return 4; }
        if (rank == <uint>2) { return 10; }
        if (rank == <uint>3) { return 16; }
        return 0;
    }
    if (abilityCode == corruptionAbilityCode()) {
        if (rank == <uint>1) { return 4; }
        if (rank == <uint>2) { return 12; }
        if (rank == <uint>3) { return 18; }
    }
    if (abilityCode == curseOfAgonyAbilityCode()) {
        if (rank == <uint>1) { return 8; }
        if (rank == <uint>2) { return 14; }
        if (rank == <uint>3) { return 20; }
    }
    if (abilityCode == siphonLifeAbilityCode() && rank == <uint>1) {
        return 10;
    }
    if (abilityCode == insectSwarmAbilityCode() && rank == <uint>1) {
        return 20;
    }
    if (abilityCode == ripAbilityCode() && rank == <uint>1) {
        return 14;
    }
    return 0;
}

pureDotProjectileProfileIsValid(
    abilityCode: uint,
    rank: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = pureDotAbilityIndex(abilityCode);
    var level = pureDotRankLevel(abilityCode, rank);
    return abilityCode != ripAbilityCode() && abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rank &&
        effects.count(abilityIndex, <int>rank) == 1 &&
        effects.typeAt(abilityIndex, <int>rank, 0) == "dot" &&
        minimum == 0.0 && maximum == 0.0 &&
        castTime == m4AbilityCatalog.metric(abilityIndex, level, "castTime") &&
        (abilityCode != siphonLifeAbilityCode() ||
            effects.metric(abilityIndex, <int>rank, 0, "leechPct") == 1.0);
}

pureDotTargetIndex(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    abilityIndex: int
): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex] ||
        abilityIndex < 0) {
        return -1;
    }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var distanceSquared = dx * dx + dz * dz;
    var maximumRange = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var minimumRange = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "minRange"
    );
    // Eastbrook has clear line of sight in the retained outdoor slice. The
    // source still requires its target-facing arc before a zero-cast spell is
    // admitted, so preserve that phase rather than accepting rear casts.
    return maximumRange > 0.0 && distanceSquared <= maximumRange * maximumRange &&
        distanceSquared >= minimumRange * minimumRange &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <=
            OFFLINE_SOURCE_TARGET_FACING_HALF_ARC ? targetIndex : -1;
}

pureDotGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS /
        mageSpellHasteMultiplier(state, casterIndex);
    return gcd < OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS ?
        OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS : gcd;
}

startOfflinePureDotCast(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    abilityCode: uint
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = pureDotAbilityIndex(abilityCode);
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || effects.count(abilityIndex, rank) != 1 ||
        effects.typeAt(abilityIndex, rank, 0) != "dot" ||
        <int>state.entityResources[casterIndex] < cost ||
        pureDotTargetIndex(state, casterIndex, targetId, abilityIndex) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = pureDotGlobalCooldownSeconds(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        0.0,
        0.0,
        projectileTravel.projectileSpeed(),
        false,
        offlineProjectileSchoolCode(m4AbilityCatalog.text(abilityIndex, "school")),
        abilityCode,
        <uint>rank,
        0.0
    );
}

startOfflineSerpentStingCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, serpentStingAbilityCode());
}

startOfflineShadowWordPainCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, shadowWordPainAbilityCode());
}

startOfflineCurseOfAgonyCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, curseOfAgonyAbilityCode());
}

startOfflineSiphonLifeCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, siphonLifeAbilityCode());
}

startOfflineInsectSwarmCast(state: WorldState, casterIndex: int, targetId: uint): void {
    startOfflinePureDotCast(state, casterIndex, targetId, insectSwarmAbilityCode());
}

fireballAbilityCode(): uint {
