        return -3;
    }

    var restored = decodeState(encodeState(state));
    restored.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(restored, 0, false);
    if (<int>restored.entityResources[0] != 0 || <uint>restored.rngDraws != <uint>2 ||
        <uint>restored.entityCastingAbility[0] != <uint>0 ||
        <uint>restored.entityCastTargetIds[0] != <uint>0 ||
        <int>restored.entityHp[1] <= 40 || <int>restored.entityHp[1] >= 100 ||
        stateThreatValue(restored, 2, casterId) <= 0.0 ||
        stateThreatValue(restored, 2, targetId) != 10.0) {
