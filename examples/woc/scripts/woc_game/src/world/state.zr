        wolfId == <uint>0 || boarId == <uint>0 || outsideId == <uint>0 ||
        abilityCode == <uint>0 || !coneOfColdProfileIsValid(abilityCode)) {
        return -1;
    }
    state.entityResources[0] = 60;
    state.entityMaxResources[0] = 60;
    state.entitySpellDamageMultipliers[0] = 1.2;
    state.entityKnownAbilityCodes.add(abilityCode);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }
    var coneBytes = new container.Array<uint>();
    coneBytes.add(<uint>99); coneBytes.add(<uint>111); coneBytes.add(<uint>110);
    coneBytes.add(<uint>101); coneBytes.add(<uint>95); coneBytes.add(<uint>111);
    coneBytes.add(<uint>102); coneBytes.add(<uint>95); coneBytes.add(<uint>99);
    coneBytes.add(<uint>111); coneBytes.add(<uint>108); coneBytes.add(<uint>100);
    var cast = new CommandBatch();
