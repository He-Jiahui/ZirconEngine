    return <int>restored.entityResources[0] == 55 &&
        restored.offlineAbsorbTargetIds.length == 1 &&
        <uint>restored.offlineAbsorbSourceIds[0] == casterId &&
        <int>restored.offlineAbsorbAmounts[0] == 48 &&
        abilityCooldownExpiresAt(restored, 0, shield) == <uint>18000000 &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -8;
}

// Fear is a timed hostile cast with its resource spend deferred to completion.
// The snapshot must retain its zero-damage Shadow projectile, and the landed
// motion-aura row must retain the source direction and graded damage-break data.
pub fearCommandStateTest(): int {
    if (timedSpell.contractTest() != 1 || spellResist.contractTest() != 1) { return -1; }
    var fear = fearAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("fear");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (fear == <uint>0 || abilityIndex != 8 || forestWolf == <uint>0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "fear" ||
        m4AbilityCatalog.text(abilityIndex, "class") != "warlock" ||
        !fearProjectileProfileIsValid(<uint>1, 0.0, 0.0, 1.5)) {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 14, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 100, 8.0);
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 40;
    state.entityMaxResources[0] = 40;
    state.entityHitBonus[0] = 1.0;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(fear);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <int>state.entityResources[0] != 40 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != fear ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 1.5) ||
        !floatMatches(<float>state.entityCastTotal[0], 1.5) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5)) {
        return -3;
    }

    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<int>state.entityResources[0] != 0 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != <uint>0 ||
        <uint>state.entityCastTargetIds[0] != <uint>0 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileSourceIds[0] != playerId ||
        <uint>state.offlineProjectileTargetIds[0] != targetId ||
        <bool>state.offlineProjectileWands[0] ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
        <float>state.offlineProjectileMinimums[0] != 0.0 ||
        <float>state.offlineProjectileMaximums[0] != 0.0 ||
        <float>state.offlineProjectileSpeeds[0] != projectileTravel.projectileSpeed() ||
        <uint>state.offlineProjectileAbilityCodes[0] != fear ||
        <uint>state.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>state.offlineProjectileCastTimes[0], 1.5)) {
        return -4;
    }

    var launched = decodeState(encodeState(state));
    if (launched.offlineProjectileSourceIds.length != 1 ||
        <uint>launched.offlineProjectileAbilityCodes[0] != fear ||
        <uint>launched.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>launched.offlineProjectileCastTimes[0], 1.5)) {
        return -5;
    }

    var flightTicks = 0;
    while (launched.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(launched);
        flightTicks = flightTicks + 1;
    }
    if (launched.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>launched.rngDraws != <uint>2 ||
        <int>launched.entityHp[1] != 100 ||
        <uint>launched.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>launched.entityMotionAuraAbilityCodes[0] != fear ||
        <uint>launched.entityMotionAuraSourceIds[0] != playerId ||
        <uint>launched.entityMotionAuraKindCodes[0] !=
            ccContract.motionAuraKindCode("incapacitate") ||
        !floatMatches(<float>launched.entityMotionAuraRemaining[0], 8.0) ||
        <float>launched.entityMotionAuraValues[0] < -3.141592653589793 ||
        <float>launched.entityMotionAuraValues[0] > 3.141592653589793 ||
        !floatMatches(<float>launched.entityMotionAuraBreakChanceScales[0], 0.1) ||
        !<bool>launched.entityInCombat[0] || !<bool>launched.entityInCombat[1]) {
        return -6;
    }

    var feared = decodeState(encodeState(launched));
    if (feared.entityMotionAuraValues.length != 1 ||
        feared.entityMotionAuraBreakChanceScales.length != 1 ||
        !floatMatches(
            <float>feared.entityMotionAuraValues[0],
            <float>launched.entityMotionAuraValues[0]
        ) ||
        !floatMatches(<float>feared.entityMotionAuraBreakChanceScales[0], 0.1)) {
        return -7;
    }

    feared.entityAiStates[1] = mobLifecycle.attackAiState();
    feared.entityAggroTargetIds[1] = playerId;
    feared.entityInCombat[1] = true;
    feared.entitySwingTimer[1] = 2.0;
    var direction = <float>feared.entityMotionAuraValues[0];
    var beforeX = <float>feared.entityX[1];
    var beforeZ = <float>feared.entityZ[1];
    var fleeStep = fleeSpeed.fleeSpeed(<float>feared.entityMoveSpeed[1], 1.0) *
        projectileTravel.projectileTickSeconds();
    stepOfflineEastbrookMobMeleePursuit(feared);
    if (!floatMatches(<float>feared.entityX[1], beforeX + math.sin(direction) * fleeStep) ||
        !floatMatches(<float>feared.entityZ[1], beforeZ + math.cos(direction) * fleeStep) ||
        !floatMatches(<float>feared.entityFacing[1], direction) ||
        !floatMatches(<float>feared.entitySwingTimer[1], 2.0) ||
        !floatMatches(<float>feared.entityMotionAuraRemaining[0], 7.95)) {
        return -8;
    }

    // Damage equal to max health caps the 0.1-scale chance at one, still
    // consuming the source random draw before removing the incap row.
    clearOfflineBreakableIncapacitateOnDamage(feared, 1, 100);
    if (feared.entityMotionAuraOffsets[2] != <uint>0 ||
        feared.entityMotionAuraAbilityCodes.length != 0 ||
        <uint>feared.rngDraws != <uint>3) {
        return -9;
    }

    feared.entityCastGcdRemaining[0] = 0.0;
    feared.entityResources[0] = 40;
    var fearBytes = new container.Array<uint>();
    fearBytes.add(<uint>102);
    fearBytes.add(<uint>101);
    fearBytes.add(<uint>97);
    fearBytes.add(<uint>114);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, fearBytes, targetId
    );
    feared.applyCommands(typed, 1);
    return <int>feared.entityResources[0] == 40 &&
        <uint>feared.entityCastingAbility[0] == fear &&
        <uint>feared.entityCastTargetIds[0] == targetId &&
        floatMatches(<float>feared.entityCastRemaining[0], 1.5) &&
        <uint>feared.entityLastCommandSequence[0] == <uint>2 ? 1 : -10;
}

