        !floatMatches(<float>restored.offlineHotRemaining[0], 14.95) ||
        !floatMatches(<float>restored.offlineHotTickTimers[0], 3.0)) {
        return -5;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    startOfflineRenewCast(restored, 0, targetId);
    if (<int>restored.entityResources[0] != 40 || restored.offlineHotTargetIds.length != 1 ||
        !floatMatches(<float>restored.offlineHotRemaining[0], 15.0) ||
        !floatMatches(<float>restored.offlineHotTickTimers[0], 3.0)) {
