    var rejectedPlayer = rejected.spawnPlayer(
        <uint>(hunter + 1), 8, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    var rejectedTarget = rejected.spawnMob(forestWolf, 8, 0.0, 1.5, 7.0, 1000, 7.0);
    rejected.entityResources[0] = 100.0;
    rejected.entityMaxResources[0] = 100.0;
    rejected.entityKnownAbilityCodes.add(concussiveShot);
    offset = 1;
    while (offset < rejected.entityKnownAbilityOffsets.length) {
        rejected.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    rejected.entityZ[1] = 7.0;
    startOfflineConcussiveShotCast(rejected, 0, rejectedTarget);
    rejected.entityZ[1] = 36.0;
    startOfflineConcussiveShotCast(rejected, 0, rejectedTarget);
    rejected.entityZ[1] = 10.0;
    rejected.entityFacing[0] = 3.14159265;
    startOfflineConcussiveShotCast(rejected, 0, rejectedTarget);
    if (rejectedPlayer == <uint>0 ||
        !floatMatches(<float>rejected.entityResources[0], 100.0) ||
        !floatMatches(<float>rejected.entityCastGcdRemaining[0], 0.0) ||
        abilityCooldownExpiresAt(rejected, 0, concussiveShot) != <uint>0 ||
        rejected.offlineProjectileSourceIds.length != 0 || rejected.rngDraws != <uint>0) {
        return -6;
    }

