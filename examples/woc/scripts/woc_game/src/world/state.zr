// HoT talent modifiers are resolved before profile subdivision and are then
// retained by the existing aura snapshot, never recomputed by its future ticks.
pub hotTalentRuntimeStateTest(): int {
    if (hotTalentScaling.contractTest() != 1 || pureHotProfiles.contractTest() != 1 ||
        hybridHotProfiles.contractTest() != 1) {
        return -1;
    }
    var restoration = talentSelectionCatalog.specCode("druid", "restoration");
    var holy = talentSelectionCatalog.specCode("priest", "holy");
    var rejuvenation = rejuvenationAbilityCode();
    var regrowth = regrowthAbilityCode();
    var renew = renewAbilityCode();
    if (restoration == <uint>0 || holy == <uint>0 || rejuvenation == <uint>0 ||
        regrowth == <uint>0 || renew == <uint>0) {
        return -2;
    }

    var rejuvenationState = new WorldState();
    rejuvenationState.offlineSessionActive = true;
    rejuvenationState.offlinePlayerClass = <uint>8;
    var druidId = rejuvenationState.spawnPlayer(<uint>8, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    rejuvenationState.entityHp[0] = 0;
    if (!replaceOfflineTalentAllocation(
            rejuvenationState, 0, restoration, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -3;
    }
    applyOfflinePureHot(rejuvenationState, druidId, druidId, rejuvenation, 4, 150);
    if (druidId == <uint>0 || rejuvenationState.offlineHotTargetIds.length != 1 ||
        <int>rejuvenationState.offlineHotHeals[0] != 66) {
        return -4;
    }
    // Changing the source selection after aura creation must not alter its snapshot.
    if (!replaceOfflineTalentAllocation(
            rejuvenationState, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -5;
    }
    var rejuvenationRestored = decodeState(encodeState(rejuvenationState));
    if (rejuvenationRestored.offlineHotTargetIds.length != 1 ||
        <int>rejuvenationRestored.offlineHotHeals[0] != 66) {
        return -6;
    }
    var rejuvenationDraws = rejuvenationRestored.rngDraws;
    rejuvenationRestored.offlineHotTickTimers[0] = 0.05;
    stepOfflineRejuvenationHots(rejuvenationRestored);
    if (<int>rejuvenationRestored.entityHp[0] != 66 ||
        rejuvenationRestored.rngDraws != rejuvenationDraws) {
        return -7;
    }

    var regrowthState = new WorldState();
    regrowthState.offlineSessionActive = true;
    regrowthState.offlinePlayerClass = <uint>8;
    var regrowthDruidId = regrowthState.spawnPlayer(<uint>8, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    regrowthState.entityHp[0] = 0;
    if (!replaceOfflineTalentAllocation(
            regrowthState, 0, restoration, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -8;
    }
    applyOfflineRegrowthHot(regrowthState, regrowthDruidId, regrowthDruidId, regrowth, 1);
    var regrowthDraws = regrowthState.rngDraws;
    if (!replaceOfflineTalentAllocation(
            regrowthState, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -9;
    }
    var regrowthRestored = decodeState(encodeState(regrowthState));
    regrowthRestored.offlineHotTickTimers[0] = 0.05;
    stepOfflineRejuvenationHots(regrowthRestored);
    if (regrowthDruidId == <uint>0 || regrowthRestored.offlineHotTargetIds.length != 1 ||
        <int>regrowthRestored.offlineHotHeals[0] != 9 ||
        <int>regrowthRestored.entityHp[0] != 9 ||
        regrowthRestored.rngDraws != regrowthDraws) {
        return -10;
    }

    var renewState = new WorldState();
    renewState.offlineSessionActive = true;
    renewState.offlinePlayerClass = <uint>5;
    var priestId = renewState.spawnPlayer(<uint>5, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    renewState.entityHp[0] = 0;
    if (!replaceOfflineTalentAllocation(
            renewState, 0, holy, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -10;
    }
    applyOfflinePureHot(renewState, priestId, priestId, renew, 3, 150);
    var renewDraws = renewState.rngDraws;
    if (!replaceOfflineTalentAllocation(
            renewState, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -11;
    }
    var renewRestored = decodeState(encodeState(renewState));
    renewRestored.offlineHotTickTimers[0] = 0.05;
    stepOfflineRejuvenationHots(renewRestored);
    if (priestId == <uint>0 || renewRestored.offlineHotTargetIds.length != 1 ||
        <int>renewRestored.offlineHotHeals[0] != 64 ||
        <int>renewRestored.entityHp[0] != 64 ||
        renewRestored.rngDraws != renewDraws) {
        return -12;
    }
    return 1;
}

// Nature's Fury is a source/target spell-crit aura, not a permanent mutation
// of the recipient's derived crit stat. The runtime fixture covers the source
// pulse cadence, form and party/range gates, source-keyed stacking, snapshot
// migration and eventual lapse.
pub naturesFuryRuntimeStateTest(): int {
    var fury = %import("generated/natures_fury_contract");
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>8;
    var druidId = state.spawnPlayer(<uint>8, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var allyId = state.spawnPlayer(<uint>1, 20, 30.0, 1.5, 0.0, 100, 7.0, 1);
    var farAllyId = state.spawnPlayer(<uint>1, 20, 30.1, 1.5, 0.0, 100, 7.0, 1);
    var deadAllyId = state.spawnPlayer(<uint>1, 20, 5.0, 1.5, 0.0, 100, 7.0, 1);
    var furyOption = talentSelectionCatalog.optionCode(
        "druid", 20, "dru_r20_improved_hurricane"
    );
    var moonwing = forms.formAbilityCode("form_moonkin");
    if (druidId == <uint>0 || allyId == <uint>0 || farAllyId == <uint>0 ||
        deadAllyId == <uint>0 || furyOption == <uint>0 || moonwing == <uint>0 ||
        fury.radius() != 30.0 || fury.pulseTicks() != 20 ||
        fury.refreshSeconds() != 3.0) {
        return -1;
    }
    state.nextPartyId = <uint>2;
    var memberIndex = 0;
    while (memberIndex < 4) {
        state.entityPartyIds[memberIndex] = <uint>1;
        state.entityPartyLeaderIds[memberIndex] = druidId;
        state.entityPartyMemberOrders[memberIndex] = <uint>(memberIndex + 1);
        memberIndex = memberIndex + 1;
    }
    state.entityDead[3] = true;
    state.entityHp[3] = 0;
    state.entityActiveFormAbilityCodes[0] = moonwing;
    if (!replaceOfflineTalentAllocation(
            state, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, furyOption
        )) {
        return -2;
    }
    state.entityCritChance[1] = 0.1;
    state.tick = druidId % <uint>20;
    var rngDraws = state.rngDraws;
    stepOfflineNaturesFury(state);
    if (!offlineNaturesFuryStateIsValid(state) ||
        !floatMatches(offlineNaturesFurySpellCritBonus(state, 0), 0.03) ||
        !floatMatches(offlineNaturesFurySpellCritBonus(state, 1), 0.03) ||
        offlineNaturesFurySpellCritBonus(state, 2) != 0.0 ||
        offlineNaturesFurySpellCritBonus(state, 3) != 0.0 ||
        !floatMatches(offlineSpellCritChance(state, 1), 0.13) ||
        state.rngDraws != rngDraws) {
        return -3;
    }
    var restored = decodeState(encodeState(state));
    if (!offlineNaturesFuryStateIsValid(restored) ||
        !floatMatches(offlineNaturesFurySpellCritBonus(restored, 0), 0.03) ||
        !floatMatches(offlineNaturesFurySpellCritBonus(restored, 1), 0.03)) {
        return -4;
    }

    // WOS105 has the Rewind tail but no Nature's Fury tail. Keep a non-empty
    // preceding tail here so decode must advance correctly into later fields.
    var legacy = new WorldState();
    var legacyId = legacy.spawnPlayer(<uint>8, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    legacy.tick = <uint>1;
    recordOfflineRewindDamage(legacy, 0, 7);
    var legacyRestored = decodeState(encodeStateVersion(legacy, <uint>105));
    if (legacyId == <uint>0 || legacyRestored.offlineNaturesFuryTargetIds.length != 0 ||
        legacyRestored.offlineNaturesFurySourceIds.length != 0 ||
        legacyRestored.offlineNaturesFuryValues.length != 0 ||
        legacyRestored.offlineNaturesFuryRemaining.length != 0 ||
        legacyRestored.offlineRewindDamageTargetIds.length != 1 ||
        <int>legacyRestored.offlineRewindDamageAmounts[0] != 7 ||
        legacyRestored.entityAetherSurgeCharges.length != 1 ||
        <int>legacyRestored.entityAetherSurgeCharges[0] != 0) {
        return -5;
    }

    // Aura identity is (target, source). Refreshing the second source must
    // not duplicate its row or disturb the first source's independent window.
    applyOfflineNaturesFury(restored, 1, 1, 0.02, 1.0);
    applyOfflineNaturesFury(restored, 1, 1, 0.02, 2.0);
    if (!offlineNaturesFuryStateIsValid(restored) ||
        restored.offlineNaturesFuryTargetIds.length != 3 ||
        !floatMatches(offlineNaturesFurySpellCritBonus(restored, 1), 0.05) ||
        !floatMatches(<float>restored.offlineNaturesFuryRemaining[2], 2.0)) {
        return -6;
    }
    var secondSourceAgeTicks = 0;
    while (secondSourceAgeTicks < 40) {
        ageOfflineNaturesFury(restored);
        secondSourceAgeTicks = secondSourceAgeTicks + 1;
    }
    if (!offlineNaturesFuryStateIsValid(restored) ||
        restored.offlineNaturesFuryTargetIds.length != 2 ||
        !floatMatches(offlineNaturesFurySpellCritBonus(restored, 1), 0.03)) {
        return -7;
    }
    restored.entityActiveFormAbilityCodes[0] = <uint>0;
    var ageTicks = 0;
    while (ageTicks < 60) {
        ageOfflineNaturesFury(restored);
        stepOfflineNaturesFury(restored);
        ageTicks = ageTicks + 1;
    }
    if (restored.offlineNaturesFuryTargetIds.length != 0 ||
        offlineNaturesFurySpellCritBonus(restored, 0) != 0.0 ||
        offlineNaturesFurySpellCritBonus(restored, 1) != 0.0 ||
        !floatMatches(offlineSpellCritChance(restored, 1), 0.1) ||
        restored.rngDraws != rngDraws) {
        return -8;
    }
    return 1;
}

// Fear is a timed hostile cast with its resource spend deferred to completion.
// The snapshot must retain its zero-damage Shadow projectile, and the landed
// motion-aura row must retain the source direction and graded damage-break data.
pub fearCommandStateTest(): int {
    if (timedSpell.contractTest() != 1 || spellResist.contractTest() != 1) { return -1; }
    var fear = fearAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("fear");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (fear == <uint>0 || abilityIndex != 8 || forestWolf == <uint>0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "fear" ||
        m4AbilityCatalog.text(abilityIndex, "class") != "warlock" ||
        !fearProjectileProfileIsValid(<uint>1, 0.0, 0.0, 1.5)) {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 14, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 100, 8.0);
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 40;
    state.entityMaxResources[0] = 40;
    state.entityHitBonus[0] = 1.0;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(fear);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <float>state.entityResources[0] != 40 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != fear ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 1.5) ||
        !floatMatches(<float>state.entityCastTotal[0], 1.5) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5)) {
        return -3;
    }

    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<float>state.entityResources[0] != 0 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != <uint>0 ||
        <uint>state.entityCastTargetIds[0] != <uint>0 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileSourceIds[0] != playerId ||
        <uint>state.offlineProjectileTargetIds[0] != targetId ||
        <bool>state.offlineProjectileWands[0] ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
        <float>state.offlineProjectileMinimums[0] != 0.0 ||
        <float>state.offlineProjectileMaximums[0] != 0.0 ||
        <float>state.offlineProjectileSpeeds[0] != projectileTravel.projectileSpeed() ||
        <uint>state.offlineProjectileAbilityCodes[0] != fear ||
        <uint>state.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>state.offlineProjectileCastTimes[0], 1.5)) {
        return -4;
    }

    var launched = decodeState(encodeState(state));
    if (launched.offlineProjectileSourceIds.length != 1 ||
        <uint>launched.offlineProjectileAbilityCodes[0] != fear ||
        <uint>launched.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>launched.offlineProjectileCastTimes[0], 1.5)) {
        return -5;
    }

    var flightTicks = 0;
    while (launched.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(launched);
        flightTicks = flightTicks + 1;
    }
    if (launched.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>launched.rngDraws != <uint>2 ||
        <int>launched.entityHp[1] != 100 ||
        <uint>launched.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>launched.entityMotionAuraAbilityCodes[0] != fear ||
        <uint>launched.entityMotionAuraSourceIds[0] != playerId ||
        <uint>launched.entityMotionAuraKindCodes[0] !=
            ccContract.motionAuraKindCode("incapacitate") ||
        !floatMatches(<float>launched.entityMotionAuraRemaining[0], 8.0) ||
        <float>launched.entityMotionAuraValues[0] < -3.141592653589793 ||
        <float>launched.entityMotionAuraValues[0] > 3.141592653589793 ||
        !floatMatches(<float>launched.entityMotionAuraBreakChanceScales[0], 0.1) ||
        !<bool>launched.entityInCombat[0] || !<bool>launched.entityInCombat[1]) {
        return -6;
    }

    var feared = decodeState(encodeState(launched));
    if (feared.entityMotionAuraValues.length != 1 ||
        feared.entityMotionAuraBreakChanceScales.length != 1 ||
        !floatMatches(
            <float>feared.entityMotionAuraValues[0],
            <float>launched.entityMotionAuraValues[0]
        ) ||
        !floatMatches(<float>feared.entityMotionAuraBreakChanceScales[0], 0.1)) {
        return -7;
    }

    feared.entityAiStates[1] = mobLifecycle.attackAiState();
    feared.entityAggroTargetIds[1] = playerId;
    feared.entityInCombat[1] = true;
    feared.entitySwingTimer[1] = 2.0;
    var direction = <float>feared.entityMotionAuraValues[0];
    var beforeX = <float>feared.entityX[1];
    var beforeZ = <float>feared.entityZ[1];
    var fleeStep = fleeSpeed.fleeSpeed(<float>feared.entityMoveSpeed[1], 1.0) *
        projectileTravel.projectileTickSeconds();
    stepOfflineEastbrookMobMeleePursuit(feared);
    if (!floatMatches(<float>feared.entityX[1], beforeX + math.sin(direction) * fleeStep) ||
        !floatMatches(<float>feared.entityZ[1], beforeZ + math.cos(direction) * fleeStep) ||
        !floatMatches(<float>feared.entityFacing[1], direction) ||
        !floatMatches(<float>feared.entitySwingTimer[1], 2.0) ||
        !floatMatches(<float>feared.entityMotionAuraRemaining[0], 7.95)) {
        return -8;
    }

    // Damage equal to max health caps the 0.1-scale chance at one, still
    // consuming the source random draw before removing the incap row.
    clearOfflineBreakableIncapacitateOnDamage(feared, 1, 100);
    if (feared.entityMotionAuraOffsets[2] != <uint>0 ||
        feared.entityMotionAuraAbilityCodes.length != 0 ||
        <uint>feared.rngDraws != <uint>3) {
        return -9;
    }

    feared.entityCastGcdRemaining[0] = 0.0;
    feared.entityResources[0] = 40;
    var fearBytes = new container.Array<uint>();
    fearBytes.add(<uint>102);
    fearBytes.add(<uint>101);
    fearBytes.add(<uint>97);
    fearBytes.add(<uint>114);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, fearBytes, targetId
    );
    feared.applyCommands(typed, 1);
    return <int>feared.entityResources[0] == 40 &&
        <uint>feared.entityCastingAbility[0] == fear &&
        <uint>feared.entityCastTargetIds[0] == targetId &&
        floatMatches(<float>feared.entityCastRemaining[0], 1.5) &&
        <uint>feared.entityLastCommandSequence[0] == <uint>2 ? 1 : -10;
}

pub fireballCommandStateTest(): int {
