}

temporalMendPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>13 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>100;
}

temporalEchoPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>13 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>111;
}

temporalCascadePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>16 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>13)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>14)] == <uint>100 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>15)] == <uint>101;
}

temporalDirectHealResolvedTargetIndex(
    state: WorldState, casterIndex: int, overrideId: uint
): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

temporalDirectHealTargetIndex(
    state: WorldState, casterIndex: int, targetId: uint, abilityIndex: int
): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

temporalCascadeTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || targetIndex < 0 ||
        <bool>state.entityDead[targetIndex] || <bool>state.entityHostile[targetIndex] ||
        <uint>state.entityKinds[targetIndex] != <uint>1) {
        return -1;
    }
    var partyId = partyIdForIndex(state, casterIndex);
    if (targetIndex != casterIndex &&
        (partyId == <uint>0 || partyIdForIndex(state, targetIndex) != partyId)) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_cascade");
    if (abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ? targetIndex : -1;
}

temporalCascadeTargetIndices(
    state: WorldState, casterIndex: int, primaryIndex: int, radius: float, maxTargets: int
): container.Array<int> {
    var targets = new container.Array<int>();
    if (primaryIndex < 0 || maxTargets <= 0 || radius <= 0.0) { return targets; }
    targets.add(primaryIndex);
    var partyId = partyIdForIndex(state, casterIndex);
    while (targets.length < maxTargets) {
        var best = -1;
        var bestDistance = 0.0;
        var index = 0;
        while (index < state.entityIds.length) {
            var eligible = index != primaryIndex && <uint>state.entityKinds[index] == <uint>1 &&
                !<bool>state.entityDead[index] && !<bool>state.entityHostile[index] &&
                ((partyId == <uint>0 && index == casterIndex) ||
                    (partyId != <uint>0 && partyIdForIndex(state, index) == partyId));
            if (eligible) {
                var alreadySelected = false;
                for (var selected in targets) {
                    if (selected == index) { alreadySelected = true; }
                }
                var dx = <float>state.entityX[index] - <float>state.entityX[primaryIndex];
                var dz = <float>state.entityZ[index] - <float>state.entityZ[primaryIndex];
                var distance = dx * dx + dz * dz;
                if (!alreadySelected && distance <= radius * radius &&
                    (best < 0 || distance < bestDistance ||
                        (distance == bestDistance && <uint>state.entityIds[index] <
                            <uint>state.entityIds[best]))) {
                    best = index;
                    bestDistance = distance;
                }
            }
            index = index + 1;
        }
        if (best < 0) { break; }
        targets.add(best);
    }
    return targets;
}

temporalCascadeProfileIsValid(abilityIndex: int, rank: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 && rank >= 1 && rank <= 3 &&
        m4AbilityCatalog.text(abilityIndex, "id") == "temporal_cascade" &&
        m4AbilityCatalog.metric(abilityIndex, 12, "learnLevel") == 12.0 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "mage" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "arcane" &&
        m4AbilityCatalog.text(abilityIndex, "targetType") == "friendly" &&
        m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        m4AbilityCatalog.flag(abilityIndex, "partyOnlyTarget") &&
        effects.count(abilityIndex, rank) == 1 &&
        effects.typeAt(abilityIndex, rank, 0) == "massTemporalEcho" &&
        effects.metric(abilityIndex, rank, 0, "duration") == 10.0 &&
        effects.metric(abilityIndex, rank, 0, "radius") == 15.0 &&
        effects.metric(abilityIndex, rank, 0, "maxTargets") == 5.0 &&
        effects.metric(abilityIndex, rank, 0, "min") > 0.0 &&
        effects.metric(abilityIndex, rank, 0, "max") >=
            effects.metric(abilityIndex, rank, 0, "min");
}

temporalDirectHealProfileIsValid(abilityIndex: int, rank: int, mark: bool): bool {
    var effects = %import("generated/m4_ability_effects");
    if (abilityIndex < 0 || rank <= 0 ||
        effects.typeAt(abilityIndex, rank, 0) != "heal" ||
        effects.metric(abilityIndex, rank, 0, "min") <= 0.0 ||
        effects.metric(abilityIndex, rank, 0, "max") <
            effects.metric(abilityIndex, rank, 0, "min")) {
        return false;
    }
    return !mark || (effects.typeAt(abilityIndex, rank, 1) == "temporalEcho" &&
        effects.metric(abilityIndex, rank, 1, "duration") == 15.0);
}

temporalDirectHealCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

temporalDirectHealGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

temporalDirectHealCastAdmission(
    state: WorldState, casterIndex: int, abilityCode: uint, abilityIndex: int
): bool {
    return state.offlineSessionActive && abilityIndex >= 0 &&
        casterIndex == offlineQuestPrimaryPlayerIndex(state) &&
        !<bool>state.entityDead[casterIndex] &&
        <uint>state.entityCastingAbility[casterIndex] == <uint>0 &&
        <float>state.entityCastGcdRemaining[casterIndex] <= 0.0 &&
        <uint>state.entityActiveFormAbilityCodes[casterIndex] == <uint>0 &&
        knownAbilityPartitionContains(state, casterIndex, abilityCode) &&
        catalogAdmission(state, casterIndex, abilityCode, "", false);
}

startOfflineTemporalMendCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = temporalMendAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_mend");
    if (!temporalDirectHealCastAdmission(state, casterIndex, abilityCode, abilityIndex)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var targetIndex = temporalDirectHealResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!temporalDirectHealProfileIsValid(abilityIndex, rank, false) ||
        <float>state.entityResources[casterIndex] < cost || targetIndex < 0 ||
        temporalDirectHealTargetIndex(
            state, casterIndex, <uint>state.entityIds[targetIndex], abilityIndex
        ) < 0) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        temporalDirectHealCastSeconds(state, casterIndex, abilityIndex),
        temporalDirectHealGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>state.entityIds[targetIndex];
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineTemporalMendCast(state: WorldState, casterIndex: int): void {
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_mend");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = temporalDirectHealTargetIndex(state, casterIndex, targetId, abilityIndex);
    if (targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!temporalDirectHealProfileIsValid(abilityIndex, rank, false) ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    spendOfflineAbilityResource(state, casterIndex, cost);
    var primary = applyOfflineDirectHeal(
        state, casterIndex, targetId, targetIndex, abilityIndex, rank
    );
    applyOfflinePowerEchoHeal(state, casterIndex, targetId, targetIndex, primary);
}

startOfflineTemporalEchoCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = temporalEchoAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_echo");
    if (!temporalDirectHealCastAdmission(state, casterIndex, abilityCode, abilityIndex)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var targetIndex = temporalDirectHealResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!temporalDirectHealProfileIsValid(abilityIndex, rank, true) ||
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") != 0.0 ||
        <float>state.entityResources[casterIndex] < cost || targetIndex < 0 ||
        temporalDirectHealTargetIndex(
            state, casterIndex, <uint>state.entityIds[targetIndex], abilityIndex
        ) < 0) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = temporalDirectHealGlobalCooldownSeconds(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    var resolvedTargetId = <uint>state.entityIds[targetIndex];
    var primary = applyOfflineDirectHeal(
        state, casterIndex, resolvedTargetId, targetIndex, abilityIndex, rank
    );
    applyOfflineTemporalEchoMark(
        state, casterIndex, resolvedTargetId, targetIndex,
        effects.metric(abilityIndex, rank, 1, "duration")
    );
    applyOfflinePowerEchoHeal(
        state, casterIndex, resolvedTargetId, targetIndex, primary
    );
}

startOfflineTemporalCascadeCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = temporalCascadeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_cascade");
    if (!temporalDirectHealCastAdmission(state, casterIndex, abilityCode, abilityIndex) ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var targetIndex = temporalCascadeTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!temporalCascadeProfileIsValid(abilityIndex, rank) || targetIndex < 0 ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode, temporalDirectHealCastSeconds(state, casterIndex, abilityIndex),
        temporalDirectHealGlobalCooldownSeconds(state, casterIndex), false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

applyOfflineTemporalCascadeGroupEcho(
    state: WorldState, casterIndex: int, targetIndex: int, duration: float
): void {
    var contract = %import("generated/temporal_echo_contract");
    var sourceId = <uint>state.entityIds[casterIndex];
    var targetId = <uint>state.entityIds[targetIndex];
    var index = 0;
    while (index < state.offlineTemporalEchoSourceIds.length) {
        if (<uint>state.offlineTemporalEchoSourceIds[index] == sourceId &&
            <uint>state.offlineTemporalEchoTargetIds[index] == targetId) {
            if (!<bool>state.offlineTemporalEchoGroups[index]) {
                if (<float>state.offlineTemporalEchoRemaining[index] < duration) {
                    state.offlineTemporalEchoRemaining[index] = duration;
                }
                return;
            }
            removeOfflineTemporalEchoAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineTemporalEchoTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc Temporal Cascade echo queue exceeds WOS cap";
    }
    state.offlineTemporalEchoTargetIds.add(targetId);
    state.offlineTemporalEchoSourceIds.add(sourceId);
    state.offlineTemporalEchoRemaining.add(duration);
    state.offlineTemporalEchoGroups.add(true);
    state.offlineTemporalEchoConvertRates.add(contract.groupSingleRate());
}

completeOfflineTemporalCascadeCast(state: WorldState, casterIndex: int): void {
    var abilityCode = temporalCascadeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_cascade");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = temporalCascadeTargetIndex(state, casterIndex, targetId);
    if (targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var effects = %import("generated/m4_ability_effects");
    if (!temporalCascadeProfileIsValid(abilityIndex, rank) ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    var targets = temporalCascadeTargetIndices(
        state, casterIndex, targetIndex,
        effects.metric(abilityIndex, rank, 0, "radius"),
        <int>effects.metric(abilityIndex, rank, 0, "maxTargets")
    );
    if (targets.length == 0) { return; }
    spendOfflineAbilityResource(state, casterIndex, cost);
    for (var selectedIndex in targets) {
        var selectedId = <uint>state.entityIds[selectedIndex];
        applyOfflineDirectHeal(state, casterIndex, selectedId, selectedIndex, abilityIndex, rank);
        applyOfflineTemporalCascadeGroupEcho(
            state, casterIndex, selectedIndex,
            effects.metric(abilityIndex, rank, 0, "duration")
        );
    }
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode, state.timeMicros + <uint>17000000
    );
}

// Healing Touch is the Druid's four-rank friendly Nature hard cast. It shares
// the retained direct-heal kernel while keeping its source profile separate.
healingTouchAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("healing_touch");
    var abilityIndex = m4AbilityCatalog.indexOf("healing_touch");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "healing_touch") {
        throw "Healing Touch is absent from the current ability catalog";
    }
    return code;
}

healingTouchPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>13 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>103 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>104;
}

healingTouchResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

healingTouchTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("healing_touch");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

healingTouchCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

healingTouchGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineHealingTouchCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = healingTouchAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("healing_touch");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = healingTouchResolvedTargetIndex(state, casterIndex, targetId);
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "heal" ||
        <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        resolvedTargetIndex < 0 || healingTouchTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        healingTouchCastSeconds(state, casterIndex, abilityIndex),
        healingTouchGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>state.entityIds[resolvedTargetIndex];
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineHealingTouchCast(state: WorldState, casterIndex: int): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("healing_touch");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = healingTouchTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "heal" ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    applyOfflineDirectHeal(state, casterIndex, targetId, targetIndex, abilityIndex, rank);
}

// Regrowth is the source Druid hybrid heal: its direct component receives the
// cast-time coefficient, while the later HoT stores only its generated base tick.
regrowthAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("regrowth");
    var abilityIndex = m4AbilityCatalog.indexOf("regrowth");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "regrowth") {
