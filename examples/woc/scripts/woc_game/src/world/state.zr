pub overflowingPowerRuntimeStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 900, 7.0, 1);
    var mageSpec = talentSelectionCatalog.specCode("mage", "arcane");
    var overflowing = talentSelectionCatalog.optionCode(
        "mage", 20, "mag_r20_overflowing_power"
    );
    var blink = <uint>knownAbilityCatalog.abilityCode("blink");
    var iceBarrier = iceBarrierAbilityCode();
    var blazingBarrier = blazingBarrierAbilityCode();
    var icyVeins = icyVeinsAbilityCode();
    if (playerId == <uint>0 || mageSpec == <uint>0 || overflowing == <uint>0 ||
        blink == <uint>0 || iceBarrier == <uint>0 || blazingBarrier == <uint>0 ||
        icyVeins == <uint>0) {
        return -1;
    }
    state.entityTalentSpecCodes[0] = mageSpec;
    state.entityTalentRowOptionCodes[5] = overflowing;
    state.entityResources[0] = 900;
    state.entityMaxResources[0] = 900;
    state.entityKnownAbilityCodes.add(iceBarrier);
    state.entityKnownAbilityOffsets[1] = <uint>1;
    setAbilityCooldownExpiration(state, 0, blink, <uint>20000000);
    setAbilityCooldownExpiration(state, 0, icyVeins, <uint>20000000);
    startOfflineIceBarrierCast(state, 0);
    if (<float>state.entityResources[0] != 810 ||
        !floatMatches(<float>state.entityOverflowingPowerCapUsed[0], 2.0) ||
        !floatMatches(<float>state.entityOverflowingPowerCapRemaining[0], 30.0) ||
        abilityCooldownExpiresAt(state, 0, blink) != <uint>18000000 ||
        abilityCooldownExpiresAt(state, 0, icyVeins) != <uint>20000000 ||
        abilityCooldownExpiresAt(state, 0, iceBarrier) != <uint>30000000) {
        return -2;
    }
    setAbilityCooldownExpiration(state, 0, iceBarrier, <uint>5000000);
    setAbilityCooldownExpiration(state, 0, blazingBarrier, <uint>5000000);
    spendOfflineAbilityResource(state, 0, 360);
    if (<float>state.entityResources[0] != 450 ||
        !floatMatches(<float>state.entityOverflowingPowerCapUsed[0], 10.0) ||
        abilityCooldownExpiresAt(state, 0, blink) != <uint>10000000 ||
        abilityCooldownExpiresAt(state, 0, iceBarrier) != <uint>0 ||
        abilityCooldownExpiresAt(state, 0, blazingBarrier) != <uint>0) {
        return -3;
    }
    spendOfflineAbilityResource(state, 0, 90);
    if (<float>state.entityResources[0] != 360 ||
        abilityCooldownExpiresAt(state, 0, blink) != <uint>10000000 ||
        !floatMatches(<float>state.entityOverflowingPowerCapUsed[0], 10.0)) {
        return -4;
    }
    var restored = decodeState(encodeState(state));
    if (!floatMatches(<float>restored.entityOverflowingPowerCapUsed[0], 10.0) ||
        !floatMatches(<float>restored.entityOverflowingPowerCapRemaining[0], 30.0)) {
        return -5;
    }
    restored.entityOverflowingPowerCapRemaining[0] = 0.05;
    ageOfflineOverflowingPower(restored);
    if (<float>restored.entityOverflowingPowerCapRemaining[0] != 0.0 ||
        <float>restored.entityOverflowingPowerCapUsed[0] != 0.0) {
        return -6;
    }
    spendOfflineAbilityResource(restored, 0, 90);
    if (<int>restored.entityResources[0] != 270 ||
        abilityCooldownExpiresAt(restored, 0, blink) != <uint>8000000 ||
        !floatMatches(<float>restored.entityOverflowingPowerCapUsed[0], 2.0) ||
        !floatMatches(<float>restored.entityOverflowingPowerCapRemaining[0], 30.0)) {
        return -7;
    }

    // Temporal Reversal resolves its valid resurrection before source billing.
    // Its successful mana debit must therefore use the same post-spend CDR
    // bridge before the current cast's 600-second cooldown is armed.
    var temporal = new WorldState();
    temporal.offlineSessionActive = true;
    temporal.offlinePlayerClass = <uint>1;
    var temporalCasterId = temporal.spawnPlayer(
        <uint>2, 20, 0.0, 1.5, 0.0, 900, 7.0, 1
    );
    var temporalTargetId = temporal.spawnPlayer(
        <uint>1, 20, 20.0, 1.5, 0.0, 100, 7.0, 1
    );
    var temporalCode = temporalReversalAbilityCode();
    if (temporalCasterId == <uint>0 || temporalTargetId == <uint>0 ||
        temporalCode == <uint>0) {
        return -8;
    }
    temporal.entityTalentSpecCodes[0] = mageSpec;
    temporal.entityTalentRowOptionCodes[5] = overflowing;
    temporal.entityResources[0] = 900;
    temporal.entityMaxResources[0] = 900;
    temporal.nextPartyId = <uint>2;
    temporal.entityPartyIds[0] = <uint>1;
    temporal.entityPartyLeaderIds[0] = temporalCasterId;
    temporal.entityPartyMemberOrders[0] = <uint>1;
    temporal.entityPartyIds[1] = <uint>1;
    temporal.entityPartyLeaderIds[1] = temporalCasterId;
    temporal.entityPartyMemberOrders[1] = <uint>2;
    temporal.entityDead[1] = true;
    temporal.entityHp[1] = 0;
    temporal.entityCastTargetIds[0] = temporalTargetId;
    setAbilityCooldownExpiration(temporal, 0, blink, <uint>20000000);
    completeTemporalReversalCast(temporal, 0);
    if (<int>temporal.entityResources[0] != 840 ||
        !floatMatches(<float>temporal.entityOverflowingPowerCapUsed[0], 1.333333) ||
        !floatMatches(<float>temporal.entityOverflowingPowerCapRemaining[0], 30.0) ||
        abilityCooldownExpiresAt(temporal, 0, blink) != <uint>18666667 ||
        abilityCooldownExpiresAt(temporal, 0, temporalCode) != <uint>600000000 ||
        !<bool>temporal.entityResurrectionOfferPresent[1]) {
        return -9;
    }

    var control = new WorldState();
    control.offlineSessionActive = true;
    control.offlinePlayerClass = <uint>1;
    var controlPlayerId = control.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 900, 7.0, 1);
    if (controlPlayerId == <uint>0) { return -10; }
    control.entityResources[0] = 900;
    control.entityMaxResources[0] = 900;
    setAbilityCooldownExpiration(control, 0, blink, <uint>20000000);
    spendOfflineAbilityResource(control, 0, 90);
    return <int>control.entityResources[0] == 810 &&
        abilityCooldownExpiresAt(control, 0, blink) == <uint>20000000 &&
        <float>control.entityOverflowingPowerCapUsed[0] == 0.0 &&
        <float>control.entityOverflowingPowerCapRemaining[0] == 0.0 ? 1 : -11;
}

pub overloadArmingRuntimeStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>2, 14, 0.0, 1.5, 0.0, 300, 7.0, 1);
    var abilityCode = overloadAbilityCode();
    var mageSpec = talentSelectionCatalog.specCode("mage", "arcane");
    var optionCode = talentSelectionCatalog.optionCode(
        "mage", 14, "mag_r14_overload"
    );
    if (playerId == <uint>0 || abilityCode == <uint>0 || mageSpec == <uint>0 ||
        optionCode == <uint>0 || !overloadProfileIsValid(abilityCode)) {
        return -1;
    }
    // The generated choice only grants the stable id after selection. A caller
    // without that owned id cannot arm the state.
    startOfflineOverloadCast(state, 0);
    if (<float>state.entityOverloadRemaining[0] != 0.0 ||
        <float>state.entityOverloadValues[0] != 0.0) {
        return -2;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, mageSpec,
            <uint>0, <uint>0, <uint>0, optionCode,
            <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, abilityCode)) {
        return -3;
    }
    state.entityCastGcdRemaining[0] = 1.5;
    var overloadBytes = new container.Array<uint>();
    overloadBytes.add(<uint>111); overloadBytes.add(<uint>118);
    overloadBytes.add(<uint>101); overloadBytes.add(<uint>114);
    overloadBytes.add(<uint>108); overloadBytes.add(<uint>111);
    overloadBytes.add(<uint>97); overloadBytes.add(<uint>100);
    var cast = new CommandBatch();
    appendTypedCastCommandForTest(cast, playerId, <uint>1, <uint>1, overloadBytes);
    state.applyCommands(cast, 1);
    if (!floatMatches(<float>state.entityOverloadRemaining[0], 10.0) ||
        !floatMatches(<float>state.entityOverloadValues[0], 0.4) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>30000000 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -4;
    }
    var restored = decodeState(encodeState(state));
    if (!floatMatches(<float>restored.entityOverloadRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entityOverloadValues[0], 0.4) ||
        abilityCooldownExpiresAt(restored, 0, abilityCode) != <uint>30000000) {
        return -5;
    }
    restored.entityOverloadRemaining[0] = 0.05;
    ageOfflineOverload(restored);
    if (<float>restored.entityOverloadRemaining[0] != 0.0 ||
        <float>restored.entityOverloadValues[0] != 0.0) {
        return -6;
    }
    var legacy = decodeState(encodeStateVersion(restored, <uint>91));
    if (<float>legacy.entityOverloadRemaining[0] != 0.0 ||
        <float>legacy.entityOverloadValues[0] != 0.0) {
        return -7;
    }
    var cancel = new CommandBatch();
    appendCancelAuraCommandForTest(cancel, playerId, <uint>1, <uint>2, overloadBytes);
    state.applyCommands(cancel, 1);
    return <float>state.entityOverloadRemaining[0] == 0.0 &&
        <float>state.entityOverloadValues[0] == 0.0 &&
        abilityCooldownExpiresAt(state, 0, abilityCode) == <uint>30000000 &&
        <uint>state.entityLastCommandSequence[0] == <uint>2 &&
        overloadStateIsValid(state) ? 1 : -8;
}

pub overloadSpellResolutionStateTest(): int {
    var state = new WorldState();
    var playerId = state.spawnPlayer(<uint>2, 14, 0.0, 1.5, 0.0, 100, 7.0, 1);
    if (playerId == <uint>0 || !overloadStateIsValid(state)) { return -1; }
    state.entityOverloadRemaining[0] = 10.0;
    state.entityOverloadValues[0] = 0.4;
    var multiplier = consumeOfflineOverloadSpell(state, 0, 90);
    if (!floatMatches(multiplier, 1.4) ||
        offlineOverloadBillableCost(90, multiplier) != 135 ||
        offlineOverloadBillableCost(25, multiplier) != 38 ||
        offlineOverloadScaledPositiveMetric(130.0, multiplier) != 182.0 ||
        offlineOverloadScaledPositiveMetric(0.0, multiplier) != 0.0 ||
        <float>state.entityOverloadRemaining[0] != 0.0 ||
        <float>state.entityOverloadValues[0] != 0.0) {
        return -2;
    }
    spendOfflineAbilityResource(state, 0, offlineOverloadBillableCost(90, multiplier));
    if (<float>state.entityResources[0] != 0) { return -3; }

    state.entityResources[0] = 100;
    state.entityOverloadRemaining[0] = 10.0;
    state.entityOverloadValues[0] = 0.4;
    if (consumeOfflineOverloadSpell(state, 0, 0) != 1.0 ||
        <float>state.entityOverloadRemaining[0] != 10.0 ||
        <float>state.entityOverloadValues[0] != 0.4) {
        return -4;
    }
    var projectileState = new WorldState();
    var projectileCaster = projectileState.spawnPlayer(
        <uint>2, 14, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    var projectileTarget = projectileState.spawnMob(<uint>1, 14, 0.0, 1.5, 10.0, 100, 7.0);
    var effects = %import("generated/m4_ability_effects");
    var fireballIndex = m4AbilityCatalog.indexOf("fireball");
    var fireballRank = fireballIndex >= 0 ?
        m4AbilityCatalog.rankAtLevel(fireballIndex, 14) : 0;
    if (projectileCaster == <uint>0 || projectileTarget == <uint>0 ||
        fireballRank <= 0) {
        return -5;
    }
    var projectileMultiplier = 1.4;
    var expectedDotTotal = offlineOverloadScaledPositiveMetric(
        effects.metric(fireballIndex, fireballRank, 1, "total"), projectileMultiplier
    );
    appendOfflineAbilityProjectileWithDotTotal(
        projectileState,
        projectileCaster,
        projectileTarget,
        0.0,
        0.0,
        offlineOverloadScaledPositiveMetric(
            effects.metric(fireballIndex, fireballRank, 0, "min"), projectileMultiplier
        ),
        offlineOverloadScaledPositiveMetric(
            effects.metric(fireballIndex, fireballRank, 0, "max"), projectileMultiplier
        ),
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_FIRE,
        fireballAbilityCode(),
        <uint>fireballRank,
        m4AbilityCatalog.metric(fireballIndex, 14, "castTime"),
        expectedDotTotal
    );
    var restoredProjectileState = decodeState(encodeState(projectileState));
    if (restoredProjectileState.offlineProjectileDotTotals.length != 1 ||
        <float>restoredProjectileState.offlineProjectileDotTotals[0] != expectedDotTotal ||
        !offlineProjectileStateIsValid(restoredProjectileState)) {
        return -6;
    }

    // Exercise the actual landing path: the transformed periodic profile must
    // survive validation, absorb source-independent RNG, and round-trip after
    // its projectile row is gone.
    var landing = new WorldState();
    landing.offlineSessionActive = true;
    var landingCaster = landing.spawnPlayer(<uint>2, 14, 0.0, 1.5, 0.0, 1000, 7.0, 1);
    var landingTarget = landing.spawnMob(<uint>1, 1, 0.0, 1.5, 10.0, 10000, 7.0);
    var pyroblastIndex = m4AbilityCatalog.indexOf("pyroblast");
    if (landingCaster == <uint>0 || landingTarget == <uint>0 || pyroblastIndex < 0) {
        return -7;
    }
    // Spell-resist clamps this to a certain hit, while timed damage still uses
    // its authoritative draws. The target remains alive for both aura checks.
    landing.entityHitBonus[0] = 1.0;
    var fireballTotal = offlineOverloadScaledPositiveMetric(
        effects.metric(fireballIndex, fireballRank, 1, "total"), 1.4
    );
    appendOfflineAbilityProjectileWithDotTotal(
        landing, landingCaster, landingTarget, 0.0, 0.0,
        offlineOverloadScaledPositiveMetric(
            effects.metric(fireballIndex, fireballRank, 0, "min"), 1.4
        ),
        offlineOverloadScaledPositiveMetric(
            effects.metric(fireballIndex, fireballRank, 0, "max"), 1.4
        ),
        projectileTravel.projectileSpeed(), false, OFFLINE_PROJECTILE_SCHOOL_FIRE,
        fireballAbilityCode(), <uint>fireballRank,
        m4AbilityCatalog.metric(fireballIndex, 14, "castTime"), fireballTotal
    );
    landOfflineFireballProjectile(landing, 0, 0, 1);
    removeOfflineProjectileAt(landing, 0);
    var pyroblastTotal = offlineOverloadScaledPositiveMetric(
        effects.metric(pyroblastIndex, 1, 1, "total"), 1.4
    );
    appendOfflineAbilityProjectileWithDotTotal(
        landing, landingCaster, landingTarget, 0.0, 0.0,
        offlineOverloadScaledPositiveMetric(
            effects.metric(pyroblastIndex, 1, 0, "min"), 1.4
        ),
        offlineOverloadScaledPositiveMetric(
            effects.metric(pyroblastIndex, 1, 0, "max"), 1.4
        ),
        projectileTravel.projectileSpeed(), false, OFFLINE_PROJECTILE_SCHOOL_FIRE,
        pyroblastAbilityCode(), <uint>1,
        m4AbilityCatalog.metric(pyroblastIndex, 14, "castTime"), pyroblastTotal
    );
    landOfflinePyroblastProjectile(landing, 0, 0, 1);
    removeOfflineProjectileAt(landing, 0);
    var fireballDuration = effects.metric(fireballIndex, fireballRank, 1, "duration");
    var fireballInterval = effects.metric(fireballIndex, fireballRank, 1, "interval");
    var pyroblastDuration = effects.metric(pyroblastIndex, 1, 1, "duration");
    var pyroblastInterval = effects.metric(pyroblastIndex, 1, 1, "interval");
    if (landing.offlineDotTargetIds.length != 2 ||
        <int>landing.offlineDotDamages[0] != <int>(
            fireballTotal / (fireballDuration / fireballInterval) + 0.5
        ) || <int>landing.offlineDotDamages[1] != <int>(
            pyroblastTotal / (pyroblastDuration / pyroblastInterval) + 0.5
        )) {
        return -8;
    }
    var restoredLanding = decodeState(encodeState(landing));
    if (!offlineDotStateIsValid(restoredLanding) ||
        <int>restoredLanding.offlineDotDamages[0] != <int>landing.offlineDotDamages[0] ||
        <int>restoredLanding.offlineDotDamages[1] != <int>landing.offlineDotDamages[1]) {
        return -9;
    }
    return overloadStateIsValid(state) ? 1 : -10;
}

pub massBarrierRuntimeStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var casterId = state.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 150, 7.0, 1);
    var allyOne = state.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var allyTwo = state.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var allyThree = state.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var allyFour = state.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var allyFive = state.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var allySix = state.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var farAlly = state.spawnPlayer(<uint>1, 17, 31.0, 1.5, 0.0, 100, 7.0, 1);
    var deadAlly = state.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var outsider = state.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var abilityCode = massBarrierAbilityCode();
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    var massBarrierOption = talentSelectionCatalog.optionCode(
        "mage", 17, "mag_r17_mass_barrier"
    );
    var temporalBarrier = <uint>knownAbilityCatalog.abilityCode("temporal_barrier");
    if (casterId == <uint>0 || allyOne == <uint>0 || allyTwo == <uint>0 ||
        allyThree == <uint>0 || allyFour == <uint>0 || allyFive == <uint>0 ||
        allySix == <uint>0 || farAlly == <uint>0 || deadAlly == <uint>0 ||
        outsider == <uint>0 || abilityCode == <uint>0 || arcaneSpec == <uint>0 ||
        massBarrierOption == <uint>0 || temporalBarrier == <uint>0 ||
        !massBarrierProfileIsValid(abilityCode)) {
        return -1;
    }

    // The source's capped sort must retain the caster even when its entity id
    // is higher than all six colocated allies.
    casterId = <uint>100;
    state.entityIds[0] = casterId;
    state.nextEntityId = <uint>101;
    var partyIndex = 0;
    while (partyIndex < 9) {
        state.entityPartyIds[partyIndex] = <uint>1;
        state.entityPartyLeaderIds[partyIndex] = casterId;
        state.entityPartyRaids[partyIndex] = true;
        state.entityPartyRaidGroups[partyIndex] = partyIndex < 5 ? <uint>1 : <uint>2;
        state.entityPartyMemberOrders[partyIndex] = <uint>(partyIndex + 1);
        partyIndex = partyIndex + 1;
    }
    state.nextPartyId = <uint>2;
    state.entityDead[8] = true;
    state.entityHp[8] = 0;

    // Talent ownership remains an admission gate; an unselected level-17
    // ability cannot spend resource, arm a cooldown, or create absorbs.
    startOfflineMassBarrierCast(state, 0);
    if (<float>state.entityResources[0] != 150 ||
        state.offlineAbsorbTargetIds.length != 0 ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>0) {
        return -2;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec,
            <uint>0, <uint>0, <uint>0, <uint>0,
            massBarrierOption, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, abilityCode)) {
        return -3;
    }

    var massBytes = new container.Array<uint>();
    massBytes.add(<uint>109); massBytes.add(<uint>97); massBytes.add(<uint>115);
    massBytes.add(<uint>115); massBytes.add(<uint>95); massBytes.add(<uint>98);
    massBytes.add(<uint>97); massBytes.add(<uint>114); massBytes.add(<uint>114);
    massBytes.add(<uint>105); massBytes.add(<uint>101); massBytes.add(<uint>114);
    var cast = new CommandBatch();
    appendTypedCastCommandForTest(cast, casterId, <uint>1, <uint>1, massBytes);
    state.applyCommands(cast, 1);
    if (<float>state.entityResources[0] != 0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>90000000 ||
        abilityCooldownExpiresAt(state, 0, temporalBarrier) != <uint>12000000 ||
        offlineAbilitySchoolCode(abilityCode) != OFFLINE_PROJECTILE_SCHOOL_FROST ||
        <uint>state.entityLastCommandSequence[0] != <uint>1 ||
        state.offlineAbsorbTargetIds.length != 5 ||
        <uint>state.offlineAbsorbTargetIds[0] != casterId ||
        <uint>state.offlineAbsorbTargetIds[1] != allyOne ||
        <uint>state.offlineAbsorbTargetIds[2] != allyTwo ||
        <uint>state.offlineAbsorbTargetIds[3] != allyThree ||
        <uint>state.offlineAbsorbTargetIds[4] != allyFour ||
        <int>state.offlineAbsorbAmounts[0] != 130 ||
        !floatMatches(<float>state.offlineAbsorbRemaining[0], 60.0) ||
        !offlineAbsorbStateIsValid(state)) {
        return -4;
    }
    if (applyOfflineAbsorbDamage(state, 1, 50) != 0 ||
        <int>state.offlineAbsorbAmounts[1] != 80 || !offlineAbsorbStateIsValid(state)) {
        return -5;
    }
    var restored = decodeState(encodeState(state));
    if (restored.offlineAbsorbTargetIds.length != 5 ||
        <uint>restored.offlineAbsorbTargetIds[0] != casterId ||
        <int>restored.offlineAbsorbAmounts[1] != 80 ||
        !offlineAbsorbStateIsValid(restored)) {
        return -6;
    }

    // Source leaves a not-over-cap recipient list sorted by entity id. Solo
    // does not borrow unrelated friendly players.
    var ordering = new WorldState();
    var orderingCaster = ordering.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 150, 7.0, 1);
    var orderingOne = ordering.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var orderingTwo = ordering.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var orderingThree = ordering.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    if (orderingCaster == <uint>0 || orderingOne == <uint>0 || orderingTwo == <uint>0 ||
        orderingThree == <uint>0) {
        return -7;
    }
    orderingCaster = <uint>100;
    ordering.entityIds[0] = orderingCaster;
    ordering.nextEntityId = <uint>101;
    var orderingIndex = 0;
    while (orderingIndex < 4) {
        ordering.entityPartyIds[orderingIndex] = <uint>1;
        ordering.entityPartyLeaderIds[orderingIndex] = orderingCaster;
        ordering.entityPartyMemberOrders[orderingIndex] = <uint>(orderingIndex + 1);
        orderingIndex = orderingIndex + 1;
    }
    var orderedRecipients = massBarrierRecipientIndexes(ordering, 0);
    var solo = new WorldState();
    var soloCaster = solo.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 150, 7.0, 1);
    var soloOutsider = solo.spawnPlayer(<uint>1, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var soloRecipients = massBarrierRecipientIndexes(solo, 0);
    if (orderedRecipients.length != 4 ||
        <uint>ordering.entityIds[<int>orderedRecipients[0]] != orderingOne ||
        <uint>ordering.entityIds[<int>orderedRecipients[1]] != orderingTwo ||
        <uint>ordering.entityIds[<int>orderedRecipients[2]] != orderingThree ||
        <uint>ordering.entityIds[<int>orderedRecipients[3]] != orderingCaster ||
        soloCaster == <uint>0 || soloOutsider == <uint>0 || soloRecipients.length != 1 ||
        <uint>solo.entityIds[<int>soloRecipients[0]] != soloCaster) {
        return -8;
    }

    // Once the candidate set is over five, source makes the caster first and
    // then resolves distance squared before id. This uses a high-id caster so
    // the priority cannot pass merely because of the normal id ordering.
    var distance = new WorldState();
    var distanceCaster = distance.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 150, 7.0, 1);
    var distanceOne = distance.spawnPlayer(<uint>1, 17, 20.0, 1.5, 0.0, 100, 7.0, 1);
    var distanceTwo = distance.spawnPlayer(<uint>1, 17, 10.0, 1.5, 0.0, 100, 7.0, 1);
    var distanceThree = distance.spawnPlayer(<uint>1, 17, 5.0, 1.5, 0.0, 100, 7.0, 1);
    var distanceFour = distance.spawnPlayer(<uint>1, 17, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var distanceFive = distance.spawnPlayer(<uint>1, 17, 15.0, 1.5, 0.0, 100, 7.0, 1);
    var distanceSix = distance.spawnPlayer(<uint>1, 17, 2.0, 1.5, 0.0, 100, 7.0, 1);
    if (distanceCaster == <uint>0 || distanceOne == <uint>0 || distanceTwo == <uint>0 ||
        distanceThree == <uint>0 || distanceFour == <uint>0 || distanceFive == <uint>0 ||
        distanceSix == <uint>0) {
        return -9;
    }
    distanceCaster = <uint>100;
    distance.entityIds[0] = distanceCaster;
    distance.nextEntityId = <uint>101;
    var distanceIndex = 0;
    while (distanceIndex < 7) {
        distance.entityPartyIds[distanceIndex] = <uint>1;
        distance.entityPartyLeaderIds[distanceIndex] = distanceCaster;
        distance.entityPartyRaids[distanceIndex] = true;
        distance.entityPartyRaidGroups[distanceIndex] = distanceIndex < 5 ? <uint>1 : <uint>2;
        distance.entityPartyMemberOrders[distanceIndex] = <uint>(distanceIndex + 1);
        distanceIndex = distanceIndex + 1;
    }
    var distanceRecipients = massBarrierRecipientIndexes(distance, 0);
    if (distanceRecipients.length != 5 ||
        <uint>distance.entityIds[<int>distanceRecipients[0]] != distanceCaster ||
        <uint>distance.entityIds[<int>distanceRecipients[1]] != distanceFour ||
        <uint>distance.entityIds[<int>distanceRecipients[2]] != distanceSix ||
        <uint>distance.entityIds[<int>distanceRecipients[3]] != distanceThree ||
        <uint>distance.entityIds[<int>distanceRecipients[4]] != distanceTwo) {
        return -10;
    }

    // Fire/Frost retain the source's 30-second personal-barrier coupling,
    // distinct from Arcane's 12-second Temporal Barrier.
    var fire = new WorldState();
    fire.offlineSessionActive = true;
    fire.offlinePlayerClass = <uint>1;
    var fireCaster = fire.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 150, 7.0, 1);
    var fireSpec = talentSelectionCatalog.specCode("mage", "fire");
    var blazingBarrier = blazingBarrierAbilityCode();
    if (fireCaster == <uint>0 || fireSpec == <uint>0 || blazingBarrier == <uint>0 ||
        !replaceOfflineTalentAllocation(
            fire, 0, fireSpec,
            <uint>0, <uint>0, <uint>0, <uint>0,
            massBarrierOption, <uint>0
        )) {
        return -11;
    }
    startOfflineMassBarrierCast(fire, 0);
    var frost = new WorldState();
    frost.offlineSessionActive = true;
    frost.offlinePlayerClass = <uint>1;
    var frostCaster = frost.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 150, 7.0, 1);
    var frostSpec = talentSelectionCatalog.specCode("mage", "frost");
    var iceBarrier = iceBarrierAbilityCode();
    if (frostCaster == <uint>0 || frostSpec == <uint>0 || iceBarrier == <uint>0 ||
        !replaceOfflineTalentAllocation(
            frost, 0, frostSpec,
            <uint>0, <uint>0, <uint>0, <uint>0,
            massBarrierOption, <uint>0
        )) {
        return -12;
    }
    startOfflineMassBarrierCast(frost, 0);
    if (abilityCooldownExpiresAt(fire, 0, blazingBarrier) != <uint>30000000 ||
        abilityCooldownExpiresAt(frost, 0, iceBarrier) != <uint>30000000 ||
        abilityCooldownExpiresAt(fire, 0, abilityCode) != <uint>90000000 ||
        abilityCooldownExpiresAt(frost, 0, abilityCode) != <uint>90000000) {
        return -13;
    }

    // The slot transport resolves through the exact same reducer as a typed
    // cast, with the selected row's actual current known-ability slot.
    var slotState = new WorldState();
    slotState.offlineSessionActive = true;
    slotState.offlinePlayerClass = <uint>1;
    var slotCaster = slotState.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 150, 7.0, 1);
    if (slotCaster == <uint>0 || !replaceOfflineTalentAllocation(
            slotState, 0, arcaneSpec,
            <uint>0, <uint>0, <uint>0, <uint>0,
            massBarrierOption, <uint>0
        )) {
        return -14;
    }
    var massSlot = 0;
    while (massSlot < <int><uint>slotState.entityKnownAbilityOffsets[1] &&
        <uint>slotState.entityKnownAbilityCodes[massSlot] != abilityCode) {
        massSlot = massSlot + 1;
    }
    if (massSlot >= <int><uint>slotState.entityKnownAbilityOffsets[1]) { return -15; }
    var slotCast = new CommandBatch();
    appendCastSlotCommand(slotCast, slotCaster, <uint>1, <uint>1, <uint>massSlot);
    slotState.applyCommands(slotCast, 1);
    if (abilityCooldownExpiresAt(slotState, 0, abilityCode) != <uint>90000000 ||
        slotState.offlineAbsorbTargetIds.length != 1 ||
        <int>slotState.offlineAbsorbAmounts[0] != 130 ||
        <uint>slotState.entityLastCommandSequence[0] != <uint>1) {
        return -16;
    }

    var overload = new WorldState();
    overload.offlineSessionActive = true;
    overload.offlinePlayerClass = <uint>1;
    var overloadCaster = overload.spawnPlayer(
        <uint>2, 17, 0.0, 1.5, 0.0, 150, 7.0, 1
    );
    if (overloadCaster == <uint>0 || !replaceOfflineTalentAllocation(
            overload, 0, arcaneSpec,
            <uint>0, <uint>0, <uint>0, <uint>0,
            massBarrierOption, <uint>0
        )) {
        return -6;
    }
    overload.entityOverloadRemaining[0] = 10.0;
    overload.entityOverloadValues[0] = 0.4;
    startOfflineMassBarrierCast(overload, 0);
    return <int>overload.entityResources[0] == 0 &&
        <float>overload.entityOverloadRemaining[0] == 0.0 &&
        <float>overload.entityOverloadValues[0] == 0.0 &&
        abilityCooldownExpiresAt(overload, 0, abilityCode) == <uint>90000000 &&
        abilityCooldownExpiresAt(overload, 0, temporalBarrier) == <uint>12000000 &&
        overload.offlineAbsorbTargetIds.length == 1 &&
        <uint>overload.offlineAbsorbTargetIds[0] == overloadCaster &&
        <int>overload.offlineAbsorbAmounts[0] == 182 &&
        !floatMatches(<float>overload.entityCastGcdRemaining[0], 0.0) &&
        offlineAbsorbStateIsValid(overload) ? 1 : -17;
}

pub powerEchoRuntimeStateTest(): int {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var playerId = state.spawnPlayer(<uint>2, 14, 0.0, 1.5, 0.0, 300, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 8.0, 10000, 7.0);
    var powerEcho = powerEchoAbilityCode();
    var frostbolt = frostboltAbilityCode();
    var mageSpec = talentSelectionCatalog.specCode("mage", "arcane");
    var powerEchoOption = talentSelectionCatalog.optionCode(
        "mage", 14, "mag_r14_power_echo"
    );
    var frostboltIndex = m4AbilityCatalog.indexOf("frostbolt");
    var frostboltRank = frostboltIndex < 0 ? 0 :
        m4AbilityCatalog.rankAtLevel(frostboltIndex, 14);
    if (forestWolf == <uint>0 || playerId == <uint>0 || targetId == <uint>0 ||
        powerEcho == <uint>0 || frostbolt == <uint>0 || mageSpec == <uint>0 ||
        powerEchoOption == <uint>0 || frostboltRank <= 0 ||
        !powerEchoProfileIsValid(powerEcho)) {
        return -1;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, mageSpec,
            <uint>0, <uint>0, <uint>0, powerEchoOption,
            <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, powerEcho)) {
        return -2;
    }

    // Power Echo is off-GCD. A typed cast must arm it while an existing normal
    // global cooldown remains in force for the following spell.
    state.entityCastGcdRemaining[0] = 1.5;
    var powerEchoBytes = new container.Array<uint>();
    powerEchoBytes.add(<uint>112); powerEchoBytes.add(<uint>111);
    powerEchoBytes.add(<uint>119); powerEchoBytes.add(<uint>101);
    powerEchoBytes.add(<uint>114); powerEchoBytes.add(<uint>95);
    powerEchoBytes.add(<uint>101); powerEchoBytes.add(<uint>99);
    powerEchoBytes.add(<uint>104); powerEchoBytes.add(<uint>111);
    var arm = new CommandBatch();
    appendTypedCastCommandForTest(arm, playerId, <uint>1, <uint>1, powerEchoBytes);
    state.applyCommands(arm, 1);
    if (!floatMatches(<float>state.entityPowerEchoRemaining[0], 10.0) ||
        !floatMatches(<float>state.entityPowerEchoValues[0], 0.5) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, powerEcho) != <uint>30000000) {
        return -3;
    }

    state.entityHitBonus[0] = 1.0;
    state.entityCritChance[0] = 1.0;
    appendOfflineAbilityProjectile(
        state, playerId, targetId, 0.0, 0.0,
        m4AbilityEffects.metric(frostboltIndex, frostboltRank, 0, "min"),
        m4AbilityEffects.metric(frostboltIndex, frostboltRank, 0, "max"),
        projectileTravel.projectileSpeed(), false, OFFLINE_PROJECTILE_SCHOOL_FROST,
        frostbolt, <uint>frostboltRank,
        m4AbilityCatalog.metric(frostboltIndex, 14, "castTime")
    );
    var primaryDraws = state.rngDraws;
    landOfflineFrostboltProjectile(state, 0, 0, 1);
    if (<float>state.entityPowerEchoRemaining[0] != 0.0 ||
        <float>state.entityPowerEchoValues[0] != 0.0 ||
        state.offlineProjectileFixedDamages.length != 2 ||
        <int>state.offlineProjectileFixedDamages[0] != 0 ||
        <int>state.offlineProjectileFixedDamages[1] <= 0 ||
        state.offlineProjectileCriticals.length != 2 ||
        <bool>state.offlineProjectileCriticals[0] ||
        !<bool>state.offlineProjectileCriticals[1] ||
        state.rngDraws <= primaryDraws) {
        return -4;
    }
    removeOfflineProjectileAt(state, 0);
    var copiedDamage = <int>state.offlineProjectileFixedDamages[0];
    var copiedCritical = <bool>state.offlineProjectileCriticals[0];
    var fizzle = decodeState(encodeState(state));
    fizzle.entityHp[1] = 0;
    fizzle.entityDead[1] = true;
    var fizzleDraws = fizzle.rngDraws;
    stepOfflineEastbrookProjectiles(fizzle);
    if (fizzle.offlineProjectileFixedDamages.length != 0 ||
        fizzle.offlineProjectileCriticals.length != 0 ||
        fizzle.rngDraws != fizzleDraws) {
        return -5;
    }

    var restored = decodeState(encodeState(state));
    if (restored.offlineProjectileFixedDamages.length != 1 ||
        <int>restored.offlineProjectileFixedDamages[0] != copiedDamage ||
        restored.offlineProjectileCriticals.length != 1 ||
        <bool>restored.offlineProjectileCriticals[0] != copiedCritical ||
        !offlineProjectileStateIsValid(restored) || !powerEchoStateIsValid(restored)) {
        return -6;
    }
    var historical = decodeState(encodeState(state));
    historical.offlineProjectileCriticals[0] = false;
    var restoredHistorical = decodeState(
        encodeStateVersion(historical, <uint>94)
    );
    if (restoredHistorical.offlineProjectileFixedDamages.length != 1 ||
        <int>restoredHistorical.offlineProjectileFixedDamages[0] != copiedDamage ||
        restoredHistorical.offlineProjectileCriticals.length != 1 ||
        <bool>restoredHistorical.offlineProjectileCriticals[0]) {
        return -7;
    }
    var hpBeforeEcho = <int>restored.entityHp[1];
    var rngDraws = restored.rngDraws;
    landOfflineFixedSpellProjectile(restored, 0, 0, 1);
    removeOfflineProjectileAt(restored, 0);
    if (restored.rngDraws != rngDraws ||
        <int>restored.entityHp[1] != hpBeforeEcho - copiedDamage ||
        restored.offlineProjectileFixedDamages.length != 0 ||
        restored.offlineProjectileCriticals.length != 0) {
        return -8;
    }

    var cancelled = new WorldState();
    var cancelledPlayer = cancelled.spawnPlayer(
        <uint>2, 14, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    if (cancelledPlayer == <uint>0) { return -9; }
    cancelled.entityPowerEchoRemaining[0] = 10.0;
    cancelled.entityPowerEchoValues[0] = 0.5;
    setAbilityCooldownExpiration(cancelled, 0, powerEcho, <uint>30000000);
    var cancel = new CommandBatch();
    appendCancelAuraCommandForTest(
        cancel, cancelledPlayer, <uint>1, <uint>1, powerEchoBytes
    );
    cancelled.applyCommands(cancel, 1);
    if (<float>cancelled.entityPowerEchoRemaining[0] != 0.0 ||
        <float>cancelled.entityPowerEchoValues[0] != 0.0 ||
        <uint>cancelled.entityLastCommandSequence[0] != <uint>1 ||
        abilityCooldownExpiresAt(cancelled, 0, powerEcho) != <uint>30000000 ||
        !powerEchoStateIsValid(cancelled)) {
        return -10;
    }

    var expiration = new WorldState();
    var expirationPlayer = expiration.spawnPlayer(<uint>2, 14, 0.0, 1.5, 0.0, 100, 7.0, 1);
    if (expirationPlayer == <uint>0) { return -11; }
    expiration.entityPowerEchoRemaining[0] = 0.05;
    expiration.entityPowerEchoValues[0] = 0.5;
    ageOfflinePowerEcho(expiration);
    return <float>expiration.entityPowerEchoRemaining[0] == 0.0 &&
        <float>expiration.entityPowerEchoValues[0] == 0.0 &&
        offlineProjectileStateIsValid(restored) && powerEchoStateIsValid(expiration) ? 1 : -12;
}

pub criticalSpellImpactRuntimeStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var sourceId = state.spawnPlayer(<uint>2, 10, 0.0, 1.5, 0.0, 300, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 8.0, 10000, 7.0);
    var vulnSourceId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 10000, 7.0);
    var fireSpec = talentSelectionCatalog.specCode("mage", "fire");
    var fireball = fireballAbilityCode();
    var frostbolt = frostboltAbilityCode();
    var lightningBolt = lightningBoltAbilityCode();
    if (forestWolf == <uint>0 || sourceId == <uint>0 || targetId == <uint>0 ||
        vulnSourceId == <uint>0 || fireSpec == <uint>0 || fireball == <uint>0 ||
        frostbolt == <uint>0 || lightningBolt == <uint>0) {
        return -1;
    }
    state.entityTalentSpecCodes[0] = fireSpec;
    state.entityHeatingUpRemaining[0] = 8.0;
    applyOfflineCritVuln(state, targetId, sourceId, 0.2, 8.0);
    applyOfflineCritVuln(state, targetId, vulnSourceId, 0.5, 8.0);
    var rngDraws = state.rngDraws;
    var first = resolveOfflineFixedSpellImpactDamage(
        state, 0, 1, fireball, OFFLINE_PROJECTILE_SCHOOL_FIRE, 100, true
    );
    if (first != 150 || state.rngDraws != rngDraws ||
        offlineCritVulnBonus(state, 1) != 0.5 ||
        state.offlineDotTargetIds.length != 1 ||
        <uint>state.offlineDotTargetIds[0] != targetId ||
        <uint>state.offlineDotSourceIds[0] != sourceId ||
        <uint>state.offlineDotAbilityCodes[0] != ignitionAbilityCode() ||
        <int>state.offlineDotDamages[0] != 10 ||
        <float>state.offlineDotRemaining[0] != fireMageContract.igniteDuration() ||
        <float>state.offlineDotTickTimers[0] != fireMageContract.igniteInterval() ||
        <float>state.entityHeatingUpRemaining[0] != 8.0) {
        return -2;
    }
    state.offlineDotTickTimers[0] = 0.5;
    var second = resolveOfflineFixedSpellImpactDamage(
        state, 0, 1, fireball, OFFLINE_PROJECTILE_SCHOOL_FIRE, 100, true
    );
    if (second != 150 || state.offlineDotTargetIds.length != 1 ||
        <int>state.offlineDotDamages[0] != 20 ||
        <float>state.offlineDotRemaining[0] != fireMageContract.igniteDuration() ||
        <float>state.offlineDotTickTimers[0] != 0.5) {
        return -3;
    }
    resolveOfflineFixedSpellImpactDamage(
        state, 0, 1, fireball, OFFLINE_PROJECTILE_SCHOOL_FIRE, 100, false
    );
    resolveOfflineFixedSpellImpactDamage(
        state, 0, 1, frostbolt, OFFLINE_PROJECTILE_SCHOOL_FROST, 100, true
    );
    // CritVuln is target-owned: a non-Mage Nature critical receives it, but
    // cannot create the Mage-only Ignite row.
    var nonMageCritical = resolveOfflineFixedSpellImpactDamage(
        state, 2, 1, lightningBolt, OFFLINE_PROJECTILE_SCHOOL_NATURE, 100, true
    );
    if (state.offlineDotTargetIds.length != 1 ||
        <int>state.offlineDotDamages[0] != 20 ||
        <float>state.entityHeatingUpRemaining[0] != 8.0 ||
        nonMageCritical != 150 || !offlineDotStateIsValid(state)) {
        return -4;
    }
    var restored = decodeState(encodeState(state));
    if (!(restored.offlineDotTargetIds.length == 1 &&
        <uint>restored.offlineDotAbilityCodes[0] == ignitionAbilityCode() &&
        <int>restored.offlineDotDamages[0] == 20 &&
        <float>restored.offlineDotTickTimers[0] == 0.5 &&
        restored.offlineCritVulnTargetIds.length == 2 &&
        offlineCritVulnBonus(restored, 1) == 0.5 &&
        offlineDotStateIsValid(restored) && offlineCritVulnStateIsValid(restored))) {
        return -5;
    }
    restored.offlineCritVulnRemaining[0] = 0.05;
    restored.offlineCritVulnRemaining[1] = 0.05;
    ageOfflineCritVuln(restored);
    return restored.offlineCritVulnTargetIds.length == 0 &&
        offlineCritVulnStateIsValid(restored) ? 1 : -6;
}

// This ZrVM fixture executes both Chronomancy direct-heal routes through the
// regular spellbook rebuild, retained casting, Power Echo, mark, and snapshot
// state. It deliberately compares armed and unarmed copies with identical
// seeds so Power Echo cannot hide an accidental second heal-critical roll.
pub chronomancyDirectHealRuntimeStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var casterId = state.spawnPlayer(<uint>2, 8, 0.0, 1.5, 0.0, 500, 7.0, 1);
    var allyId = state.spawnPlayer(<uint>1, 8, 0.0, 1.5, 6.0, 500, 7.0, 1);
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    var mend = temporalMendAbilityCode();
    var echo = temporalEchoAbilityCode();
    var mendIndex = m4AbilityCatalog.indexOf("temporal_mend");
    var echoIndex = m4AbilityCatalog.indexOf("temporal_echo");
    if (casterId == <uint>0 || allyId == <uint>0 || arcaneSpec == <uint>0 ||
        mend == <uint>0 || echo == <uint>0 || mendIndex < 0 || echoIndex < 0 ||
        m4AbilityCatalog.rankAtLevel(mendIndex, 5) != 1 ||
        m4AbilityCatalog.rankAtLevel(mendIndex, 12) != 2 ||
        m4AbilityCatalog.rankAtLevel(mendIndex, 18) != 3 ||
        m4AbilityCatalog.metric(mendIndex, 5, "cost") != 45.0 ||
        m4AbilityCatalog.metric(mendIndex, 12, "cost") != 70.0 ||
        m4AbilityCatalog.metric(mendIndex, 18, "cost") != 95.0 ||
        m4AbilityCatalog.rankAtLevel(echoIndex, 8) != 1 ||
        m4AbilityCatalog.rankAtLevel(echoIndex, 12) != 2 ||
        m4AbilityCatalog.rankAtLevel(echoIndex, 18) != 3 ||
        m4AbilityCatalog.metric(echoIndex, 8, "cost") != 40.0 ||
        m4AbilityCatalog.metric(echoIndex, 12, "cost") != 60.0 ||
        m4AbilityCatalog.metric(echoIndex, 18, "cost") != 85.0) {
        return -1;
    }
    state.nextPartyId = <uint>2;
    state.entityPartyIds[0] = <uint>1;
    state.entityPartyLeaderIds[0] = casterId;
    state.entityPartyMemberOrders[0] = <uint>1;
    state.entityPartyIds[1] = <uint>1;
    state.entityPartyLeaderIds[1] = casterId;
    state.entityPartyMemberOrders[1] = <uint>2;
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, mend) ||
        !knownAbilityPartitionContains(state, 0, echo)) {
        return -2;
    }
    state.entityResources[0] = 500;
    state.entityMaxResources[0] = 500;
    state.entityMaxHp[1] = 10000;
    state.entityHp[1] = 1;
    state.entityTargetIds[0] = allyId;
    var mendSlot = -1;
    var echoSlot = -1;
    var knownSlot = <int><uint>state.entityKnownAbilityOffsets[0];
    var knownEnd = <int><uint>state.entityKnownAbilityOffsets[1];
    while (knownSlot < knownEnd) {
        if (<uint>state.entityKnownAbilityCodes[knownSlot] == mend) {
            mendSlot = knownSlot;
        }
        if (<uint>state.entityKnownAbilityCodes[knownSlot] == echo) {
            echoSlot = knownSlot;
        }
        knownSlot = knownSlot + 1;
    }
    if (mendSlot < 0 || echoSlot < 0) { return -2; }
    var mendBytes = new container.Array<uint>();
    mendBytes.add(<uint>116); mendBytes.add(<uint>101); mendBytes.add(<uint>109);
    mendBytes.add(<uint>112); mendBytes.add(<uint>111); mendBytes.add(<uint>114);
    mendBytes.add(<uint>97); mendBytes.add(<uint>108); mendBytes.add(<uint>95);
    mendBytes.add(<uint>109); mendBytes.add(<uint>101); mendBytes.add(<uint>110);
    mendBytes.add(<uint>100);

    // Both direct-heal paths share the friendly-target range gate and cannot
    // reserve a cast or GCD when the target is outside the projected reach.
    state.entityZ[1] = 40.0;
    var rejectedTyped = new CommandBatch();
    appendTypedCastCommandForTest(rejectedTyped, casterId, <uint>1, <uint>1, mendBytes);
    state.applyCommands(rejectedTyped, 1);
    var rejectedSlot = new CommandBatch();
    appendCastSlotCommand(rejectedSlot, casterId, <uint>1, <uint>2, <uint>echoSlot);
    state.applyCommands(rejectedSlot, 1);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <float>state.entityCastGcdRemaining[0] != 0.0 ||
        <float>state.entityResources[0] != 500) {
        return -3;
    }
    state.entityZ[1] = 6.0;

    var mendBaseline = decodeState(encodeState(state));
    state.entityPowerEchoRemaining[0] = 10.0;
    state.entityPowerEchoValues[0] = 0.5;
    var typedMend = new CommandBatch();
    appendTypedCastCommandForTest(typedMend, casterId, <uint>1, <uint>3, mendBytes);
    state.applyCommands(typedMend, 1);
    startOfflineTemporalMendCast(mendBaseline, 0, allyId);
    if (<uint>state.entityCastingAbility[0] != mend ||
        <uint>mendBaseline.entityCastingAbility[0] != mend ||
        <uint>state.entityCastTargetIds[0] != allyId ||
        <uint>mendBaseline.entityCastTargetIds[0] != allyId) {
        return -4;
    }
    var tick = 0;
    while (tick < 40) {
        advanceState(state, state.tick + <uint>1, state.generation, 1);
        stepRetainedCasting(state, 0, false);
        advanceState(
            mendBaseline, mendBaseline.tick + <uint>1, mendBaseline.generation, 1
        );
        stepRetainedCasting(mendBaseline, 0, false);
        tick = tick + 1;
    }
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <uint>mendBaseline.entityCastingAbility[0] != <uint>0 ||
        <float>state.entityResources[0] != <int>mendBaseline.entityResources[0] ||
        state.rngDraws != mendBaseline.rngDraws ||
        <int>state.entityHp[1] <= <int>mendBaseline.entityHp[1] ||
        <float>state.entityPowerEchoRemaining[0] != 0.0 ||
        <float>state.entityPowerEchoValues[0] != 0.0) {
        return -5;
    }

    state.entityHp[1] = 1;
    state.entityCastGcdRemaining[0] = 0.0;
    var echoBaseline = decodeState(encodeState(state));
    state.entityPowerEchoRemaining[0] = 10.0;
    state.entityPowerEchoValues[0] = 0.5;
    var slotEcho = new CommandBatch();
    appendCastSlotCommand(slotEcho, casterId, <uint>1, <uint>4, <uint>echoSlot);
    state.applyCommands(slotEcho, 1);
    startOfflineTemporalEchoCast(echoBaseline, 0, allyId);
    if (<float>state.entityResources[0] != <int>echoBaseline.entityResources[0] ||
        state.rngDraws != echoBaseline.rngDraws ||
        <int>state.entityHp[1] <= <int>echoBaseline.entityHp[1] ||
        <float>state.entityPowerEchoRemaining[0] != 0.0 ||
        <float>state.entityPowerEchoValues[0] != 0.0 ||
        state.offlineTemporalEchoTargetIds.length != 1 ||
        <uint>state.offlineTemporalEchoTargetIds[0] != allyId ||
        <uint>state.offlineTemporalEchoSourceIds[0] != casterId ||
        <float>state.offlineTemporalEchoRemaining[0] != 15.0 ||
        !offlineTemporalEchoStateIsValid(state)) {
        return -6;
    }

    // A recast moves the one-caster mark instead of accumulating a second
    // durable row. It remains present after a current-schema round trip.
    state.entityCastGcdRemaining[0] = 0.0;
    state.entityResources[0] = 500;
    state.entityMaxHp[0] = 10000;
    state.entityHp[0] = 1;
    startOfflineTemporalEchoCast(state, 0, casterId);
    if (state.offlineTemporalEchoTargetIds.length != 1 ||
        <uint>state.offlineTemporalEchoTargetIds[0] != casterId ||
        <uint>state.offlineTemporalEchoSourceIds[0] != casterId) {
        return -7;
    }
    var restored = decodeState(encodeState(state));
    if (restored.offlineTemporalEchoTargetIds.length != 1 ||
        <uint>restored.offlineTemporalEchoTargetIds[0] != casterId ||
        <uint>restored.offlineTemporalEchoSourceIds[0] != casterId ||
        !offlineTemporalEchoStateIsValid(restored)) {
        return -8;
    }
    restored.offlineTemporalEchoRemaining[0] = 0.05;
    ageOfflineTemporalEcho(restored);
    return restored.offlineTemporalEchoTargetIds.length == 0 &&
        offlineTemporalEchoStateIsValid(restored) ? 1 : -9;
}

pub temporalEchoConversionRuntimeStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var casterId = state.spawnPlayer(<uint>2, 8, 0.0, 1.5, 0.0, 300, 7.0, 1);
    var allyId = state.spawnPlayer(<uint>1, 8, 0.0, 1.5, 4.0, 300, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 8, 0.0, 1.5, 7.0, 100, 7.0);
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    var fireSpec = talentSelectionCatalog.specCode("mage", "fire");
    if (forestWolf == <uint>0 || casterId == <uint>0 || allyId == <uint>0 ||
        targetId == <uint>0 || arcaneSpec == <uint>0 || fireSpec == <uint>0) {
        return -1;
    }
    state.nextPartyId = <uint>2;
    state.entityPartyIds[0] = <uint>1;
    state.entityPartyLeaderIds[0] = casterId;
    state.entityPartyMemberOrders[0] = <uint>1;
    state.entityPartyIds[1] = <uint>1;
    state.entityPartyLeaderIds[1] = casterId;
    state.entityPartyMemberOrders[1] = <uint>2;
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -2;
    }
    state.entityMaxHp[1] = 1000;
    state.entityHp[1] = 1;
    applyOfflineTemporalEchoMark(state, 0, allyId, 1, 15.0);
    state.entityInCombat[2] = true;
    state.setThreat(targetId, allyId, 1.0, 1);
    var rngDraws = state.rngDraws;

    // Fifty actual damage has a 17.5 single-target conversion. The resolved
    // heal rounds once to 18 and creates normal effective-healing threat.
    var dealt = applyOfflineArcaneEffectiveDamage(state, 2, 50);
    applyOfflineTemporalEchoDamageConversion(
        state, 0, dealt, OFFLINE_PROJECTILE_SCHOOL_ARCANE, false
    );
    if (dealt != 50 || <int>state.entityHp[2] != 50 ||
        <int>state.entityHp[1] != 19 || state.rngDraws != rngDraws ||
        stateThreatValue(state, 2, casterId) <= 0.0) {
        return -3;
    }

    // Area conversion uses the independent 15% coefficient. The source base
    // is a post-floor HP delta, not the incoming 100 damage request.
    state.entityHp[2] = 20;
    dealt = applyOfflineArcaneEffectiveDamage(state, 2, 100);
    applyOfflineTemporalEchoDamageConversion(
        state, 0, dealt, OFFLINE_PROJECTILE_SCHOOL_ARCANE, true
    );
    if (dealt != 20 || <int>state.entityHp[2] != 0 ||
        <int>state.entityHp[1] != 22 || state.rngDraws != rngDraws) {
        return -4;
    }

    applyOfflineTemporalEchoDamageConversion(
        state, 0, 100, OFFLINE_PROJECTILE_SCHOOL_FROST, false
    );
    if (<int>state.entityHp[1] != 22 || state.rngDraws != rngDraws) {
        return -5;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, fireSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || state.offlineTemporalEchoTargetIds.length != 0 ||
        !offlineTemporalEchoStateIsValid(state)) {
        return -6;
    }
    return 1;
}
