pub useItemCommandStateTest(): int {
    var state = new WorldState();
    var playerId = state.spawnPlayer(<uint>1, 10, 0.0, 1.5, 0.0, 30, 7.0, 1);
    var healingPotion = m5InventoryItemCodeForId("minor_healing_potion");
    var manaPotion = m5InventoryItemCodeForId("minor_mana_potion");
    if (playerId == <uint>0 || healingPotion == <uint>0 || manaPotion == <uint>0) {
        return -1;
    }
    state.entityMaxHp[0] = 100;
    state.entityResources[0] = 0;
    state.entityMaxResources[0] = 200;
    state.entityResourceKinds[0] = formTransitions.manaResourceKind();
    grantM5InventoryItem(state, 0, healingPotion, 1);
    grantM5InventoryItem(state, 0, manaPotion, 1);
    var heal = new CommandBatch();
    appendUseItemCommandForTest(heal, playerId, <uint>1, <uint>1, healingPotion);
    state.applyCommands(heal, 1);
    if (<int>state.entityHp[0] != 100 ||
        m5InventoryItemCount(state, 0, healingPotion) != 0 ||
        !floatMatches(<float>state.entityPotionCooldownUntil[0], 120.0) ||
        !floatMatches(<float>state.entityPotionCooldownRemaining[0], 120.0)) {
        return -2;
    }
    var blocked = new CommandBatch();
    appendUseItemCommandForTest(blocked, playerId, <uint>1, <uint>2, manaPotion);
    state.applyCommands(blocked, 1);
    if (<float>state.entityResources[0] != 0 ||
        m5InventoryItemCount(state, 0, manaPotion) != 1 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -3;
    }
    state.timeMicros = <uint>120000000;
    updateOfflinePotionCooldowns(state);
    if (!floatMatches(<float>state.entityPotionCooldownUntil[0], -1.0) ||
        !floatMatches(<float>state.entityPotionCooldownRemaining[0], 0.0)) {
        return -4;
    }
    var mana = new CommandBatch();
    appendUseItemCommandForTest(mana, playerId, <uint>1, <uint>3, manaPotion);
    state.applyCommands(mana, 1);
    return <float>state.entityResources[0] == 120 &&
        m5InventoryItemCount(state, 0, manaPotion) == 0 &&
        floatMatches(<float>state.entityPotionCooldownUntil[0], 240.0) &&
        floatMatches(<float>state.entityPotionCooldownRemaining[0], 120.0) &&
        <uint>state.entityLastCommandSequence[0] == <uint>3 ? 1 : -5;
}

