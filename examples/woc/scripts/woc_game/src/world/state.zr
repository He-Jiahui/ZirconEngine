        rejected, playerId, <uint>1, <uint>4, rejectedName, true,
        <uint>0, clearedRows, emptyBar
    );
    state.applyCommands(rejected, 1);
    if (state.offlineTalentLoadoutSpecCodes.length !=
            talentLoadoutContract.maxLoadouts(true) ||
        state.offlineTalentActiveLoadoutIndex != 1 ||
        <uint>state.entityTalentSpecCodes[0] != <uint>0 ||
        talentRowCodeAt(state, 0, 0) != <uint>0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>4 ||
        !offlineTalentLoadoutStateIsValid(state)) {
