tauntTargetIndex(
    state: WorldState, casterIndex: int, targetId: uint, abilityIndex: int
): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    // The retained Eastbrook rows have no static occluder state; its source
    // outdoor encounter subset therefore has a trivially clear line of sight.
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

completeOfflineTauntCast(
    state: WorldState, casterIndex: int, targetId: uint, abilityCode: uint, abilityIndex: int
): void {
    var targetIndex = tauntTargetIndex(state, casterIndex, targetId, abilityIndex);
    if (targetIndex < 0) { return; }
    var casterId = <uint>state.entityIds[casterIndex];
    var mobId = <uint>state.entityIds[targetIndex];
    var threat = stateThreatValue(state, targetIndex, casterId);
    var topThreat = stateTopThreatValue(state, targetIndex);
    if (threat < topThreat) { threat = topThreat; }
    if (threat < 1.0) { threat = 1.0; }
    state.setThreat(mobId, casterId, threat, 1);
    state.entityForcedTargetIds[targetIndex] = casterId;
    state.entityForcedTargetTimers[targetIndex] = 3.0;
    var aiState = <uint>state.entityAiStates[targetIndex];
    if (aiState == mobLifecycle.idleAiState()) {
        enterIdleMobAggroWithoutSocial(state, targetIndex, casterId);
    } else if (aiState == mobLifecycle.chaseAiState() ||
        aiState == mobLifecycle.attackAiState()) {
        state.entityAggroTargetIds[targetIndex] = casterId;
    } else if (aiState == mobLifecycle.fleeAiState()) {
        state.entityAggroTargetIds[targetIndex] = casterId;
        state.entityAiStates[targetIndex] = mobLifecycle.attackAiState();
        state.entityFleeTimers[targetIndex] = 0.0;
        state.entityFleeReturnTimers[targetIndex] = 0.0;
    }
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityCombatTimers[targetIndex] = 0.0;
    state.entityInCombat[casterIndex] = true;
    state.entityInCombat[targetIndex] = true;
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(
                abilityIndex, <int>state.entityLevels[casterIndex], "cooldown"
            ) * 1000000.0
        )
    );
}

startOfflineTauntCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = tauntAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("taunt");
    if (!state.offlineSessionActive || casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) || abilityIndex < 0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros) {
        return;
    }
    completeOfflineTauntCast(state, casterIndex, targetId, abilityCode, abilityIndex);
}

startOfflineGrowlCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = growlAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("growl");
    if (!state.offlineSessionActive || casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state,
            casterIndex,
            abilityCode,
            forms.formKindForAbilityCode(
                <uint>state.entityActiveFormAbilityCodes[casterIndex]
            ),
            false
        ) || abilityIndex < 0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros) {
        return;
    }
    completeOfflineTauntCast(state, casterIndex, targetId, abilityCode, abilityIndex);
}

demoralizingRoarGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

// The source effect dispatch applies one reusable `debuff_ap` aura to every
// living hostile in radius, enters combat, then adds ten neutral physical
// threat. The retained Eastbrook entities have no static obstruction state.
startOfflineDemoralizingRoarCast(state: WorldState, casterIndex: int): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = demoralizingRoarAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("demoralizing_roar");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state,
            casterIndex,
            abilityCode,
            forms.formKindForAbilityCode(
                <uint>state.entityActiveFormAbilityCodes[casterIndex]
            ),
            false
        )) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) !=
        "aoeAttackPower") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var amount = m4AbilityEffects.metric(abilityIndex, rank, 0, "amount");
    var duration = m4AbilityEffects.metric(abilityIndex, rank, 0, "duration");
    var radius = m4AbilityEffects.metric(abilityIndex, rank, 0, "radius");
    if (<float>state.entityResources[casterIndex] < cost ||
        (amount != 20.0 && amount != 35.0) || duration != 20.0 || radius != 8.0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = demoralizingRoarGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);

    var casterId = <uint>state.entityIds[casterIndex];
    var targetIndex = 0;
    while (targetIndex < state.entityIds.length) {
        if (isOfflineEastbrookLifecycleMob(state, targetIndex) &&
            !<bool>state.entityDead[targetIndex] &&
            <bool>state.entityHostile[targetIndex]) {
            var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
            var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
            if (dx * dx + dz * dz <= radius * radius) {
                state.entityDemoralizingRoarRemaining[targetIndex] = duration;
                state.entityDemoralizingRoarValues[targetIndex] = amount;
                enterOfflineSunderArmorCombat(state, casterIndex, targetIndex);
                state.setThreat(
                    <uint>state.entityIds[targetIndex],
                    casterId,
                    stateThreatValue(state, targetIndex, casterId) + 10.0,
                    1
                );
            }
        }
        targetIndex = targetIndex + 1;
    }
}

prowlProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 && m4AbilityCatalog.rankAtLevel(abilityIndex, level) == 1 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 0.0 &&
        !m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        effects.typeAt(abilityIndex, 1, 0) == "selfBuff" &&
        effects.text(abilityIndex, 1, 0, "kind") == "stealth" &&
        effects.metric(abilityIndex, 1, 0, "value") == 0.5 &&
        effects.metric(abilityIndex, 1, 0, "duration") == 3600.0;
}

prowlGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

// Source Prowl is an instant stealth toggle. It preserves itself when toggled
// off, but it cannot be started or cancelled while the player is in combat.
startOfflineProwlCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = prowlAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("prowl");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] || <bool>state.entityInCombat[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state,
            casterIndex,
            abilityCode,
            forms.formKindForAbilityCode(
                <uint>state.entityActiveFormAbilityCodes[casterIndex]
            ),
            false
        )) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    if (!prowlProfileIsValid(abilityIndex, level) ||
        effects.text(abilityIndex, 1, 0, "kind") != "stealth") {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = prowlGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    if (offlineProwlIsActive(state, casterIndex)) {
        clearOfflineProwl(state, casterIndex);
        return;
    }
    state.entityProwlRemaining[casterIndex] = effects.metric(abilityIndex, 1, 0, "duration");
    state.entityProwlValues[casterIndex] = effects.metric(abilityIndex, 1, 0, "value");
}

rakeDotProfileIsValid(damage: int, duration: float, interval: float): bool {
    return (damage == 10 || damage == 16) && duration == 9.0 && interval == 3.0;
}

hemorrhageProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 && level >= 10 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == 1 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 35.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "awardsCombo") == 1.0 &&
        m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        !m4AbilityCatalog.flag(abilityIndex, "offGcd") &&
        m4AbilityCatalog.text(abilityIndex, "school") == "physical" &&
        effects.count(abilityIndex, 1) == 3 &&
        effects.typeAt(abilityIndex, 1, 0) == "weaponStrike" &&
        effects.metric(abilityIndex, 1, 0, "bonus") == 16.0 &&
        effects.typeAt(abilityIndex, 1, 1) == "dot" &&
        effects.metric(abilityIndex, 1, 1, "total") == 36.0 &&
        effects.metric(abilityIndex, 1, 1, "duration") == 12.0 &&
        effects.metric(abilityIndex, 1, 1, "interval") == 3.0 &&
        effects.typeAt(abilityIndex, 1, 2) == "applyDebuff" &&
        effects.text(abilityIndex, 1, 2, "kind") == "bleed_vuln" &&
        effects.metric(abilityIndex, 1, 2, "value") == 0.4 &&
        effects.metric(abilityIndex, 1, 2, "duration") == 12.0;
}

rakeGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    return prowlGlobalCooldownSeconds(state, casterIndex);
}

rakeTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("rake");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[casterIndex], "range");
    if (range <= 0.0) { range = 5.0; }
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

// Rake admits its stealth opener before revealing the caster, then runs the
// source weapon strike and independent hybrid bleed in effect-array order.
startOfflineRakeCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = rakeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("rake");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !offlineProwlIsActive(state, casterIndex) ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode,
            forms.formKindForAbilityCode(<uint>state.entityActiveFormAbilityCodes[casterIndex]), false)) {
        return;
    }
    var targetIndex = rakeTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        effects.typeAt(abilityIndex, rank, 0) != "weaponStrike" ||
        effects.typeAt(abilityIndex, rank, 1) != "dot") { return; }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var resolvedTotal = offlineTalentDotResolvedTotal(
        state, <uint>state.entityIds[casterIndex], abilityCode, <uint>rank
    );
    var duration = effects.metric(abilityIndex, rank, 1, "duration");
    var interval = effects.metric(abilityIndex, rank, 1, "interval");
    var snapshotPower = <int>effectiveOfflineAttackPower(state, casterIndex);
    var dotDamage = terrainGradient.javascriptRound(
        <float>resolvedTotal / (duration / interval), true
    ) + spellScaling.dotTickBonus(
        <float>snapshotPower, "physical", false, duration, interval
    );
    if (<float>state.entityResources[casterIndex] < cost ||
        resolvedTotal <= 0 || !numericEffects.dotProfileMatchesResolvedTotal(
            abilityIndex, rank, 1, snapshotPower, resolvedTotal,
            dotDamage, duration, interval
        )) { return; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rakeGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    clearOfflineProwl(state, casterIndex);

    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, casterIndex, targetIndex, actor);
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    if (offlineMobTemplateId(state, targetIndex) == "wild_boar") { target.spikedHideDamage = 2; }
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(events, state.rngState, state.rngDraws, state.rngDigest, true);
    var physical = resolveOfflineTalentWeaponStrike(
        state, <uint>state.entityIds[casterIndex], abilityCode, <uint>rank,
        effects.metric(abilityIndex, rank, 0, "bonus"), 1.0
    );
    var landed = autoAttackState.meleeSwing(actor, target,
        <float>physical.bonus, m4AbilityCatalog.text(abilityIndex, "name"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatMult"), false,
        physical.weaponMultiplier, events);
    consumeOfflineNextAttackCritAfterAutoHit(state, casterIndex, events);
    commitOfflineAutoAttackRng(state, events);
    commitOfflineAutoActor(state, casterIndex, actor);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage); }
    state.entityInCombat[targetIndex] = target.inCombat;
    var casterId = <uint>state.entityIds[casterIndex];
    if (target.hp > 0) {
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        if (events.lastDamage > 0) {
            state.setThreat(<uint>state.entityIds[targetIndex], casterId,
                stateThreatValue(state, targetIndex, casterId) + <float>events.lastDamage *
                events.lastThreatMultiplier + events.lastThreatFlat, 1);
        }
        applyOfflineRakeDot(
            state, <uint>state.entityIds[targetIndex], casterId, abilityCode,
            <uint>rank, snapshotPower, resolvedTotal, -1,
            dotDamage, duration, interval
        );
    } else { settleOfflineEastbrookLethal(state, targetIndex, casterIndex); }
    if (landed) {
        var combo = <int>state.entityComboPoints[casterIndex] +
            <int>m4AbilityCatalog.metric(abilityIndex, level, "awardsCombo");
        state.entityComboPoints[casterIndex] = combo > 5 ? 5 : combo;
        state.entityComboUntil[casterIndex] = <float>state.timeMicros / 1000000.0 + 30.0;
    }
    if (actor.dead || actor.hp <= 0) { applyOfflineMobMeleePlayerDeath(state, casterIndex); }
    else { state.entityHp[casterIndex] = actor.hp; }
}

hemorrhageTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("hemorrhage");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[casterIndex], "range");
    if (range <= 0.0) { range = 5.0; }
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

// The source executes all three effect rows in order. A missed weapon strike
// with a surviving target therefore still applies the periodic bleed and its
// target vulnerability; only the combo award is landed-gated.
startOfflineHemorrhageCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = hemorrhageAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("hemorrhage");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var targetIndex = hemorrhageTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var resolvedTotal = offlineTalentDotResolvedTotal(
        state, <uint>state.entityIds[casterIndex], abilityCode, <uint>rank
    );
    var duration = effects.metric(abilityIndex, rank, 1, "duration");
    var interval = effects.metric(abilityIndex, rank, 1, "interval");
    var snapshotPower = <int>effectiveOfflineAttackPower(state, casterIndex);
    var dotDamage = terrainGradient.javascriptRound(
        <float>resolvedTotal / (duration / interval), true
    ) + spellScaling.dotTickBonus(
        <float>snapshotPower, "physical", false, duration, interval
    );
    if (targetIndex < 0 || !hemorrhageProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost || resolvedTotal <= 0 ||
        !numericEffects.dotProfileMatchesResolvedTotal(
            abilityIndex, rank, 1, snapshotPower, resolvedTotal,
            dotDamage, duration, interval
        )) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = sinisterStrikeGlobalCooldownSeconds();
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, casterIndex, targetIndex, actor);
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    if (offlineMobTemplateId(state, targetIndex) == "wild_boar") { target.spikedHideDamage = 2; }
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(events, state.rngState, state.rngDraws, state.rngDigest, true);
    var physical = resolveOfflineTalentWeaponStrike(
        state, <uint>state.entityIds[casterIndex], abilityCode, <uint>rank,
        effects.metric(abilityIndex, rank, 0, "bonus"), 1.0
    );
    var landed = autoAttackState.meleeSwing(actor, target,
        <float>physical.bonus, m4AbilityCatalog.text(abilityIndex, "name"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatMult"), false,
        physical.weaponMultiplier, events);
    consumeOfflineNextAttackCritAfterAutoHit(state, casterIndex, events);
    commitOfflineAutoAttackRng(state, events);
    commitOfflineAutoActor(state, casterIndex, actor);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage); }
    state.entityInCombat[targetIndex] = target.inCombat;
    var casterId = <uint>state.entityIds[casterIndex];
    if (target.hp > 0) {
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        if (events.lastDamage > 0) {
            state.setThreat(<uint>state.entityIds[targetIndex], casterId,
                stateThreatValue(state, targetIndex, casterId) + <float>events.lastDamage *
                events.lastThreatMultiplier + events.lastThreatFlat, 1);
        }
        applyOfflineHemorrhageDot(
            state, <uint>state.entityIds[targetIndex], casterId, abilityCode,
            <uint>rank, snapshotPower, resolvedTotal, -1, dotDamage, duration, interval
        );
        applyOfflineHemorrhageBleedVulnerability(
            state, targetIndex, casterId,
            effects.metric(abilityIndex, rank, 2, "duration"),
            effects.metric(abilityIndex, rank, 2, "value")
        );
    } else { settleOfflineEastbrookLethal(state, targetIndex, casterIndex); }
    if (landed) {
        var combo = <int>state.entityComboPoints[casterIndex] +
            <int>m4AbilityCatalog.metric(abilityIndex, level, "awardsCombo");
        state.entityComboPoints[casterIndex] = combo > 5 ? 5 : combo;
        state.entityComboUntil[casterIndex] = <float>state.timeMicros / 1000000.0 + 30.0;
    }
    if (actor.dead || actor.hp <= 0) { applyOfflineMobMeleePlayerDeath(state, casterIndex); }
    else { state.entityHp[casterIndex] = actor.hp; }
}

clawTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) { return -1; }
    var abilityIndex = m4AbilityCatalog.indexOf("claw");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[casterIndex], "range");
    if (range <= 0.0) { range = 5.0; }
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ? targetIndex : -1;
}

// Claw is the non-stealth Cat builder: one source weaponStrike and a landed-only combo award.
startOfflineClawCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = clawAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("claw");
    if (!state.offlineSessionActive || abilityIndex < 0 || casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] || <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode,
            forms.formKindForAbilityCode(<uint>state.entityActiveFormAbilityCodes[casterIndex]), false)) { return; }
    var targetIndex = clawTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 || effects.typeAt(abilityIndex, rank, 0) != "weaponStrike") { return; }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<float>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rakeGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false; state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    clearOfflineProwl(state, casterIndex);
    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, casterIndex, targetIndex, actor);
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    if (offlineMobTemplateId(state, targetIndex) == "wild_boar") { target.spikedHideDamage = 2; }
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(events, state.rngState, state.rngDraws, state.rngDigest, true);
    var physical = resolveOfflineTalentWeaponStrike(
        state, <uint>state.entityIds[casterIndex], abilityCode, <uint>rank,
        effects.metric(abilityIndex, rank, 0, "bonus"), 1.0
    );
    var landed = autoAttackState.meleeSwing(actor, target, <float>physical.bonus,
        m4AbilityCatalog.text(abilityIndex, "name"), m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatMult"), false,
        physical.weaponMultiplier, events);
    consumeOfflineNextAttackCritAfterAutoHit(state, casterIndex, events);
    commitOfflineAutoAttackRng(state, events); commitOfflineAutoActor(state, casterIndex, actor);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage); }
    state.entityInCombat[targetIndex] = target.inCombat;
    var casterId = <uint>state.entityIds[casterIndex];
    if (target.hp > 0) {
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) { enterIdleMobAggro(state, targetIndex, casterId); }
        else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) { state.entityAggroTargetIds[targetIndex] = casterId; }
        if (events.lastDamage > 0) {
            state.setThreat(<uint>state.entityIds[targetIndex], casterId,
                stateThreatValue(state, targetIndex, casterId) + <float>events.lastDamage * events.lastThreatMultiplier + events.lastThreatFlat, 1);
        }
    } else { settleOfflineEastbrookLethal(state, targetIndex, casterIndex); }
    if (landed) {
        var combo = <int>state.entityComboPoints[casterIndex] + <int>m4AbilityCatalog.metric(abilityIndex, level, "awardsCombo");
        state.entityComboPoints[casterIndex] = combo > 5 ? 5 : combo;
        state.entityComboUntil[casterIndex] = <float>state.timeMicros / 1000000.0 + 30.0;
    }
    if (actor.dead || actor.hp <= 0) { applyOfflineMobMeleePlayerDeath(state, casterIndex); }
    else { state.entityHp[casterIndex] = actor.hp; }
}

ferociousBiteTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) { return -1; }
    var abilityIndex = m4AbilityCatalog.indexOf("ferocious_bite");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[casterIndex], "range");
    if (range <= 0.0) { range = 5.0; }
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ? targetIndex : -1;
}

// Ferocious Bite snapshots combo before source effect dispatch, reveals any
// Prowl state, then resolves one physical Cat-form finisher and consumes combo.
startOfflineFerociousBiteCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = ferociousBiteAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("ferocious_bite");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode,
            forms.formKindForAbilityCode(<uint>state.entityActiveFormAbilityCodes[casterIndex]), false) ||
        <int>state.entityComboPoints[casterIndex] <= 0) { return; }
    var targetIndex = ferociousBiteTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 || effects.typeAt(abilityIndex, rank, 0) != "finisherDamage") { return; }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<float>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rakeGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);

    // `runEffects` breaks non-preserving stealth before the finisher effect.
    clearOfflineProwl(state, casterIndex);
    var spentCombo = <int>state.entityComboPoints[casterIndex];
    var physical = resolveOfflineTalentFinisher(
        state,
        <uint>state.entityIds[casterIndex],
        abilityCode,
        <uint>rank,
        effects.metric(abilityIndex, rank, 0, "base"),
        effects.metric(abilityIndex, rank, 0, "perCombo")
    );
    var damage = <float>physical.base + <float>physical.perCombo * <float>spentCombo +
        nextAuthoritativeRandomUnit(state) * effects.metric(abilityIndex, rank, 0, "variance") +
        effectiveOfflineAttackPower(state, casterIndex) / 14.0;
    var crit = offlinePhysicalCritical(state, casterIndex);
    if (crit) { damage = damage * (2.0 + <float>state.entityCritDamagePhysicalBonus[casterIndex]); }
    damage = damage * (1.0 - mobSwing.armorReductionFromArmor(
        effectiveOfflineArmor(state, targetIndex), level, true
    ));
    var roundedDamage = terrainGradient.javascriptRound(damage, true);
    if (roundedDamage < 0) { roundedDamage = 0; }
    var hp = <int>state.entityHp[targetIndex] - roundedDamage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    if (roundedDamage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, roundedDamage); }
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    var casterId = <uint>state.entityIds[casterIndex];
    if (hp > 0) {
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        state.setThreat(
            <uint>state.entityIds[targetIndex], casterId,
            stateThreatValue(state, targetIndex, casterId) +
                <float>roundedDamage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    }
    if (hp <= 0) { settleOfflineEastbrookLethal(state, targetIndex, casterIndex); }
    // Source `runEffects` consumes the snapshot after all effects, retaining comboUntil.
    state.entityComboPoints[casterIndex] = 0;
}

// Swipe is a targetless Bear-form physical AoE. The current retained outdoor
// rows have trivially clear line of sight, so stable entity-index order is the
// source candidate collection order and each candidate consumes exactly one RNG draw.
startOfflineSwipeCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = swipeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("swipe");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode,
            forms.formKindForAbilityCode(<uint>state.entityActiveFormAbilityCodes[casterIndex]), false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (rank <= 0 || effects.typeAt(abilityIndex, rank, 0) != "aoeDamage") { return; }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var minimum = effects.metric(abilityIndex, rank, 0, "min");
    var maximum = effects.metric(abilityIndex, rank, 0, "max");
    var radius = effects.metric(abilityIndex, rank, 0, "radius");
    if (<float>state.entityResources[casterIndex] < cost || minimum != 12.0 ||
        maximum != 15.0 || radius != 5.0 ||
        m4AbilityCatalog.metric(abilityIndex, level, "threatMult") != 1.75) { return; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rakeGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    clearOfflineProwl(state, casterIndex);

    var casterId = <uint>state.entityIds[casterIndex];
    var talentRange = resolveOfflineTalentAoEDamageRange(
        state, casterId, abilityCode, <uint>rank, 0, minimum, maximum
    );
    minimum = <float>talentRange.minimum;
    maximum = <float>talentRange.maximum;
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        if (isOfflineEastbrookLifecycleMob(state, entityIndex) &&
            !<bool>state.entityDead[entityIndex] && <bool>state.entityHostile[entityIndex]) {
            var dx = <float>state.entityX[entityIndex] - <float>state.entityX[casterIndex];
            var dz = <float>state.entityZ[entityIndex] - <float>state.entityZ[casterIndex];
            if (dx * dx + dz * dz <= radius * radius) {
                var damage = minimum + nextAuthoritativeRandomUnit(state) * (maximum - minimum);
                damage = damage * (1.0 - mobSwing.armorReductionFromArmor(
                    effectiveOfflineArmor(state, entityIndex), level, true
                ));
                var roundedDamage = terrainGradient.javascriptRound(damage, true);
                if (roundedDamage < 0) { roundedDamage = 0; }
                var hp = <int>state.entityHp[entityIndex] - roundedDamage;
                state.entityHp[entityIndex] = hp > 0 ? hp : 0;
                if (roundedDamage > 0) {
                    clearOfflineBreakableIncapacitateOnDamage(state, entityIndex, roundedDamage);
                }
                state.entityInCombat[casterIndex] = true;
                state.entityCombatTimers[casterIndex] = 0.0;
                state.entityInCombat[entityIndex] = true;
                state.entityCombatTimers[entityIndex] = 0.0;
                if (hp > 0) {
                    if (<uint>state.entityAiStates[entityIndex] == mobLifecycle.idleAiState()) {
                        enterIdleMobAggro(state, entityIndex, casterId);
                    } else if (<uint>state.entityAggroTargetIds[entityIndex] == <uint>0) {
                        state.entityAggroTargetIds[entityIndex] = casterId;
                    }
                    state.setThreat(
                        <uint>state.entityIds[entityIndex], casterId,
                        stateThreatValue(state, entityIndex, casterId) +
                            <float>roundedDamage *
                                m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                            m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
                        1
                    );
                } else {
                    settleOfflineEastbrookLethal(state, entityIndex, casterIndex);
                }
            }
        }
        entityIndex = entityIndex + 1;
    }
}

sinisterStrikeAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("sinister_strike");
    var abilityIndex = m4AbilityCatalog.indexOf("sinister_strike");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "sinister_strike") {
        throw "Sinister Strike is absent from the current ability catalog";
    }
    return code;
}

sinisterStrikePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>15 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>13)] == <uint>107 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>14)] == <uint>101;
}

sinisterStrikeTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("sinister_strike");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    if (range <= 0.0) { range = 5.0; }
    // The retained Eastbrook rows have no static occluder state; its source
    // outdoor encounter subset therefore has a trivially clear line of sight.
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

// The source gives Rogues a one-second GCD. No retained haste modifier changes
// it in this offline subset, so do not borrow the 1.5-second form value.
sinisterStrikeGlobalCooldownSeconds(): float { return 1.0; }

startOfflineSinisterStrikeCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = sinisterStrikeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("sinister_strike");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var targetIndex = sinisterStrikeTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "weaponStrike") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<float>state.entityResources[casterIndex] < cost) { return; }

    // An instant source cast arms the GCD before applyAbility spends its cost
    // and calls the shared weapon-strike reducer.
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = sinisterStrikeGlobalCooldownSeconds();
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);

    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, casterIndex, targetIndex, actor);
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    if (offlineMobTemplateId(state, targetIndex) == "wild_boar") {
        target.spikedHideDamage = 2;
    }
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(
        events, state.rngState, state.rngDraws, state.rngDigest, true
    );
    var physical = resolveOfflineTalentWeaponStrike(
        state, <uint>state.entityIds[casterIndex], abilityCode, <uint>rank,
        m4AbilityEffects.metric(abilityIndex, rank, 0, "bonus"), 1.0
    );
    var landed = autoAttackState.meleeSwing(
        actor,
        target,
        <float>physical.bonus,
        m4AbilityCatalog.text(abilityIndex, "name"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatMult"),
        false,
        physical.weaponMultiplier,
        events
    );
    consumeOfflineNextAttackCritAfterAutoHit(state, casterIndex, events);
    commitOfflineAutoAttackRng(state, events);
    commitOfflineAutoActor(state, casterIndex, actor);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage);
    }
    state.entityInCombat[targetIndex] = target.inCombat;
    // meleeSwing enters combat even on a miss or dodge. The source's
    // enterCombat owns idle social aggro and only backfills a missing target
    // for an already active mob, so retain that distinction here.
    if (target.hp > 0) {
        var casterId = <uint>state.entityIds[casterIndex];
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        if (events.lastDamage > 0) {
            state.setThreat(
                <uint>state.entityIds[targetIndex],
                casterId,
                stateThreatValue(state, targetIndex, casterId) +
                    <float>events.lastDamage * events.lastThreatMultiplier +
                    events.lastThreatFlat,
                1
            );
        }
    }
    if (target.hp <= 0) {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
    // `meleeSwing` reports a landed weapon strike even when the source's
    // post-hit boar reaction then kills the actor, so award before terminal
    // cleanup just as effect_dispatch does.
    if (landed) {
        var awarded = <int>m4AbilityCatalog.metric(abilityIndex, level, "awardsCombo");
        var comboPoints = <int>state.entityComboPoints[casterIndex] + awarded;
        state.entityComboPoints[casterIndex] = comboPoints > 5 ? 5 : comboPoints;
        state.entityComboUntil[casterIndex] = <float>state.timeMicros / 1000000.0 + 30.0;
    }
    if (actor.dead || actor.hp <= 0) {
        applyOfflineMobMeleePlayerDeath(state, casterIndex);
    } else {
        state.entityHp[casterIndex] = actor.hp;
    }
}

stormstrikeAbilityCode(): uint {
