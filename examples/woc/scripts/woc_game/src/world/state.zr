        state.offlineAbsorbTargetIds.length != 1 ||
        <uint>state.offlineAbsorbTargetIds[0] != targetId ||
        <uint>state.offlineAbsorbSourceIds[0] != casterId ||
        <uint>state.offlineAbsorbAbilityCodes[0] != shield ||
        <uint>state.offlineAbsorbRanks[0] != <uint>1 ||
