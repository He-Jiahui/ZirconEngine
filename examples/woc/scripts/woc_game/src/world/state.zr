pub icyVeinsRuntimeStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>2, 12, 0.0, 1.5, 0.0, 100, 100.0, 1);
    var abilityCode = icyVeinsAbilityCode();
    var frostbolt = frostboltAbilityCode();
    var frostSpec = talentSelectionCatalog.specCode("mage", "frost");
    if (playerId == <uint>0 || abilityCode == <uint>0 || frostbolt == <uint>0 ||
        frostSpec == <uint>0) {
        return -1;
    }
    state.entityResources[0] = 100;
    state.entityMaxResources[0] = 100;
    state.entitySpellHaste[0] = 0.25;
    if (frostbolt < abilityCode) {
        state.entityKnownAbilityCodes.add(frostbolt);
        state.entityKnownAbilityCodes.add(abilityCode);
    } else {
        state.entityKnownAbilityCodes.add(abilityCode);
        state.entityKnownAbilityCodes.add(frostbolt);
    }
    state.entityKnownAbilityOffsets[1] = <uint>2;
    var icyBytes = new container.Array<uint>();
    icyBytes.add(<uint>105); icyBytes.add(<uint>99); icyBytes.add(<uint>121);
    icyBytes.add(<uint>95); icyBytes.add(<uint>118); icyBytes.add(<uint>101);
    icyBytes.add(<uint>105); icyBytes.add(<uint>110); icyBytes.add(<uint>115);
    var shieldBytes = new container.Array<uint>();
    shieldBytes.add(<uint>105); shieldBytes.add(<uint>99); shieldBytes.add(<uint>121);
    shieldBytes.add(<uint>95); shieldBytes.add(<uint>118); shieldBytes.add(<uint>101);
    shieldBytes.add(<uint>105); shieldBytes.add(<uint>110); shieldBytes.add(<uint>115);
    shieldBytes.add(<uint>95); shieldBytes.add(<uint>99); shieldBytes.add(<uint>97);
    shieldBytes.add(<uint>115); shieldBytes.add(<uint>116); shieldBytes.add(<uint>95);
    shieldBytes.add(<uint>115); shieldBytes.add(<uint>104); shieldBytes.add(<uint>105);
    shieldBytes.add(<uint>101); shieldBytes.add(<uint>108); shieldBytes.add(<uint>100);

    var denied = new CommandBatch();
    appendTypedCastCommandForTest(denied, playerId, <uint>1, <uint>1, icyBytes);
    state.applyCommands(denied, 1);
    if (<float>state.entityCastGcdRemaining[0] != 0.0 ||
        <float>state.entityIcyVeinsSpellHasteRemaining[0] != 0.0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -2;
    }
    var legacy = decodeState(encodeStateVersion(state, <uint>89));
    if (legacy.entityIcyVeinsSpellHasteRemaining.length != legacy.entityIds.length ||
        <float>legacy.entityIcyVeinsSpellHasteRemaining[0] != 0.0 ||
        <float>legacy.entityIcyVeinsCastShieldRemaining[0] != 0.0) {
        return -3;
    }

    state.entityTalentSpecCodes[0] = frostSpec;
    var cast = new CommandBatch();
    appendTypedCastCommandForTest(cast, playerId, <uint>1, <uint>2, icyBytes);
    state.applyCommands(cast, 1);
    if (!floatMatches(<float>state.entityCastGcdRemaining[0], 1.2) ||
        !floatMatches(<float>state.entityIcyVeinsSpellHasteRemaining[0], 10.0) ||
        !floatMatches(<float>state.entityIcyVeinsCastShieldRemaining[0], 10.0) ||
        !floatMatches(mageSpellHasteMultiplier(state, 0), 1.55) ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>180000000) {
        return -4;
    }
    var restored = decodeState(encodeState(state));
    if (!floatMatches(<float>restored.entityIcyVeinsSpellHasteRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entityIcyVeinsCastShieldRemaining[0], 10.0) ||
        !floatMatches(mageSpellHasteMultiplier(restored, 0), 1.55)) {
        return -5;
    }
    restored.entityIcyVeinsSpellHasteRemaining[0] = 0.05;
    restored.entityIcyVeinsCastShieldRemaining[0] = 0.05;
    ageOfflineIcyVeins(restored);
    if (<float>restored.entityIcyVeinsSpellHasteRemaining[0] != 0.0 ||
        <float>restored.entityIcyVeinsCastShieldRemaining[0] != 0.0) {
        return -6;
    }

    state.entityCastGcdRemaining[0] = 0.0;
    // Cast shield is a generic cast-lifecycle gate; arm a retained Frostbolt
    // directly so this test isolates pushback from target acquisition.
    state.entityCastingAbility[0] = frostbolt;
    state.entityCastRemaining[0] = 1.0;
    state.entityCastTotal[0] = 1.0;
    var castBefore = <float>state.entityCastRemaining[0];
    if (castBefore <= 0.0) { return -7; }
    applyOfflineDamageCastPushback(state, 0, 1);
    if (!floatMatches(<float>state.entityCastRemaining[0], castBefore)) { return -8; }
    var removeHaste = new CommandBatch();
    appendCancelAuraCommandForTest(removeHaste, playerId, <uint>1, <uint>3, icyBytes);
    state.applyCommands(removeHaste, 1);
    applyOfflineDamageCastPushback(state, 0, 1);
    if (<float>state.entityIcyVeinsSpellHasteRemaining[0] != 0.0 ||
        !floatMatches(<float>state.entityIcyVeinsCastShieldRemaining[0], 10.0) ||
        !floatMatches(mageSpellHasteMultiplier(state, 0), 1.25) ||
        !floatMatches(<float>state.entityCastRemaining[0], castBefore) ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>180000000) {
        return -9;
    }
    var removeShield = new CommandBatch();
    appendCancelAuraCommandForTest(removeShield, playerId, <uint>1, <uint>4, shieldBytes);
    state.applyCommands(removeShield, 1);
    applyOfflineDamageCastPushback(state, 0, 1);
    return <float>state.entityIcyVeinsCastShieldRemaining[0] == 0.0 &&
        floatMatches(<float>state.entityCastRemaining[0], castBefore + 0.5) &&
        abilityCooldownExpiresAt(state, 0, abilityCode) == <uint>180000000 &&
        <uint>state.entityLastCommandSequence[0] == <uint>4 && icyVeinsStateIsValid(state) ?
            1 : -10;
}

pub coneOfColdRuntimeStateTest(): int {
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var wildBoar = <uint>(campMobCore.indexOf("wild_boar", true) + 1);
    var state = new WorldState();
