    return distanceSquared >= minimum * minimum && distanceSquared <= maximum * maximum &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <=
            OFFLINE_SOURCE_TARGET_FACING_HALF_ARC ? targetIndex : -1;
}

// Startle Shot is an immediate, non-damaging physical control action. Its
// plain incapacitate consumes no random draw and breaks on every positive hit.
startOfflineStartleShotCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = startleShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("startle_shot");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var targetIndex = startleShotTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (targetIndex < 0 || !startleShotProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS;
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    var casterId = <uint>state.entityIds[casterIndex];
    applyOfflineMotionAuraWithDetailsAndSchool(
        state, targetIndex, abilityCode, casterId,
        ccContract.motionAuraKindCode("incapacitate"),
        effects.metric(abilityIndex, 1, 0, "duration"), 0.0, 0.0,
        OFFLINE_PROJECTILE_SCHOOL_PHYSICAL
    );
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
        enterIdleMobAggro(state, targetIndex, casterId);
    } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
        state.entityAggroTargetIds[targetIndex] = casterId;
    }
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
}

wingClipAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("wing_clip");
    var abilityIndex = m4AbilityCatalog.indexOf("wing_clip");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(<int>code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "wing_clip") {
        throw "Wing Clip is absent from the current ability catalog";
    }
    return code;
}

wingClipPayloadAbilityIsExact(
    bytes: container.Array<uint>, offset: uint, length: uint
): bool {
    return length == <uint>9 && <uint>bytes[<int>offset] == <uint>119 &&
        <uint>bytes[<int>(offset + <uint>1)] == <uint>105 &&
        <uint>bytes[<int>(offset + <uint>2)] == <uint>110 &&
        <uint>bytes[<int>(offset + <uint>3)] == <uint>103 &&
        <uint>bytes[<int>(offset + <uint>4)] == <uint>95 &&
        <uint>bytes[<int>(offset + <uint>5)] == <uint>99 &&
        <uint>bytes[<int>(offset + <uint>6)] == <uint>108 &&
        <uint>bytes[<int>(offset + <uint>7)] == <uint>105 &&
        <uint>bytes[<int>(offset + <uint>8)] == <uint>112;
}

wingClipProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    return abilityIndex >= 0 && level >= 10 && rank == 1 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "hunter" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "physical" &&
        m4AbilityCatalog.text(abilityIndex, "scalesWith") == "" &&
        m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        !m4AbilityCatalog.flag(abilityIndex, "projectile") &&
        !m4AbilityCatalog.flag(abilityIndex, "offGcd") &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 20.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 0.0 &&
        effects.typeAt(abilityIndex, rank, 0) == "directDamage" &&
        effects.metric(abilityIndex, rank, 0, "min") == 3.0 &&
        effects.metric(abilityIndex, rank, 0, "max") == 5.0 &&
        effects.typeAt(abilityIndex, rank, 1) == "slow" &&
        effects.metric(abilityIndex, rank, 1, "mult") == 0.6 &&
        effects.metric(abilityIndex, rank, 1, "duration") == 10.0;
}

wingClipTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("wing_clip");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[casterIndex], "range");
    if (range <= 0.0) { range = 5.0; }
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <=
            OFFLINE_SOURCE_TARGET_FACING_HALF_ARC ? targetIndex : -1;
}

// The source directDamage row rolls its interval and physical critical chance
// immediately, then applies the slow only if that first effect left a target.
// It is deliberately not a projectile or an Auto Attack weapon strike.
startOfflineWingClipCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = wingClipAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("wing_clip");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var targetIndex = wingClipTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!wingClipProfileIsValid(abilityIndex, level) || targetIndex < 0 || rank != 1 ||
        <float>state.entityResources[casterIndex] < cost) { return; }

    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS;
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);

    var casterId = <uint>state.entityIds[casterIndex];
    var directRange = resolveOfflineTalentDirectDamageRange(
        state, casterId, abilityCode, <uint>rank,
        effects.metric(abilityIndex, rank, 0, "min"),
        effects.metric(abilityIndex, rank, 0, "max")
    );
    var rangeRandomUnit = nextAuthoritativeRandomUnit(state);
    var critical = offlinePhysicalCritical(state, casterIndex);
    var resolvedDamage = wingClipResolution.resolveDirectDamage(
        <float>directRange.minimum,
        <float>directRange.maximum,
        effectiveOfflineAttackPower(state, casterIndex),
        m4AbilityCatalog.metric(abilityIndex, level, "castTime"),
        critical,
        <float>state.entityCritDamagePhysicalBonus[casterIndex],
        effectiveOfflineArmor(state, targetIndex),
        level,
        rangeRandomUnit
    );
    var hp = <int>state.entityHp[targetIndex] - resolvedDamage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    if (resolvedDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, resolvedDamage);
    }
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    if (hp > 0) {
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        state.setThreat(
            <uint>state.entityIds[targetIndex], casterId,
            stateThreatValue(state, targetIndex, casterId) +
                <float>resolvedDamage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
        applyOfflineMotionAuraWithDetailsAndSchool(
            state, targetIndex, abilityCode, casterId,
            ccContract.motionAuraKindCode("slow"),
            effects.metric(abilityIndex, rank, 1, "duration"),
            effects.metric(abilityIndex, rank, 1, "mult"), 0.0,
            OFFLINE_PROJECTILE_SCHOOL_PHYSICAL
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

arcaneShotProjectileProfileIsValid(state: WorldState, index: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_shot");
    var rank = <uint>state.offlineProjectileRanks[index];
    var level = arcaneShotRankLevel(rank);
    return abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rank &&
        <uint>state.offlineProjectileSchoolCodes[index] == OFFLINE_PROJECTILE_SCHOOL_ARCANE &&
        <float>state.offlineProjectileMinimums[index] ==
            effects.metric(abilityIndex, <int>rank, 0, "min") &&
        <float>state.offlineProjectileMaximums[index] ==
            effects.metric(abilityIndex, <int>rank, 0, "max") &&
        <float>state.offlineProjectileCastTimes[index] == 0.0;
}

clearOfflineHunterAspectConflicts(
    state: WorldState, casterIndex: int, newAbilityCode: uint
): void {
    var auraIndex = <int><uint>state.entityMotionAuraOffsets[casterIndex + 1] - 1;
    var start = <int><uint>state.entityMotionAuraOffsets[casterIndex];
    while (auraIndex >= start) {
        var auraAbilityCode = <uint>state.entityMotionAuraAbilityCodes[auraIndex];
        if (auraAbilityCode != newAbilityCode && hunterAspectAbilityCodeIsKnown(auraAbilityCode)) {
            removeMotionAuraAt(state, casterIndex, auraIndex);
        }
        auraIndex = auraIndex - 1;
    }
}

// The source's `exclusiveGroup: aspect` cancels siblings before applying the
// new self aura. Re-casts keep their own row and refresh it in place.
startOfflineHunterAspectCast(
    state: WorldState, casterIndex: int, abilityCode: uint
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = -1;
    var kindCode = <uint>0;
    var rank = <uint>1;
    var profileIsValid = false;
    if (abilityCode == aspectOfTheHawkAbilityCode()) {
        abilityIndex = m4AbilityCatalog.indexOf("aspect_of_the_hawk");
        rank = <uint>m4AbilityCatalog.rankAtLevel(abilityIndex, <int>state.entityLevels[casterIndex]);
        profileIsValid = aspectOfTheHawkProfileIsValid(abilityIndex, rank);
        kindCode = ccContract.motionAuraKindCode("buff_ap");
    } else if (abilityCode == aspectOfTheMonkeyAbilityCode()) {
        abilityIndex = m4AbilityCatalog.indexOf("aspect_of_the_monkey");
        profileIsValid = aspectOfTheMonkeyProfileIsValid(
            abilityIndex, <int>state.entityLevels[casterIndex]
        );
        kindCode = ccContract.motionAuraKindCode("buff_dodge");
    } else if (abilityCode == aspectOfTheCheetahAbilityCode()) {
        abilityIndex = m4AbilityCatalog.indexOf("aspect_of_the_cheetah");
        profileIsValid = aspectOfTheCheetahProfileIsValid(
            abilityIndex, <int>state.entityLevels[casterIndex]
        );
        kindCode = ccContract.motionAuraKindCode("buff_speed");
    } else { return; }
    if (!state.offlineSessionActive || abilityIndex < 0 || kindCode == <uint>0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!profileIsValid || <float>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = ghostWolfGlobalCooldownSeconds(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    clearOfflineHunterAspectConflicts(state, casterIndex, abilityCode);
    applyOfflineMotionAuraWithDetails(
        state,
        casterIndex,
        abilityCode,
        <uint>state.entityIds[casterIndex],
        kindCode,
        effects.metric(abilityIndex, <int>rank, 0, "duration"),
        effects.metric(abilityIndex, <int>rank, 0, "value"),
        0.0
    );
}

startOfflineEnrageCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = enrageAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("enrage");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state,
            casterIndex,
            abilityCode,
            forms.formKindForAbilityCode(
                <uint>state.entityActiveFormAbilityCodes[casterIndex]
            ),
            false
        )) { return; }
    var level = <int>state.entityLevels[casterIndex];
    if (!enrageProfileIsValid(abilityIndex, level) ||
        !m4AbilityCatalog.flag(abilityIndex, "offGcd")) { return; }
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    var amount = gainResourceTalentScaling.resolveGainResourceAmount(
        <int>effects.metric(abilityIndex, 1, 0, "amount"),
        offlineTalentModifiersForEntity(state, casterIndex),
        m4AbilityCatalog.text(abilityIndex, "school"),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
    offlineCappedResourceGain(state, casterIndex, amount);
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
}

bashTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
