corruptionGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS ?
        OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS : gcd;
