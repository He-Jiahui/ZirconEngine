appendTownFocusCommandForTest(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    allocation: townFocusWireState.WireFocusAllocation
): void {
    if (!townFocusWireState.allocationShapeValid(allocation) ||
        allocation.points.length > 256) {
        throw "woc town-focus command test payload is invalid";
    }
    var payloads = %import("protocol/command_payloads");
    var payloadLength: uint = <uint>2;
    var entryIndex = 0;
    while (entryIndex < allocation.points.length) {
        var start = <uint>allocation.componentOffsets[entryIndex];
        var end = <uint>allocation.componentOffsets[entryIndex + 1];
        payloadLength = payloadLength + <uint>8 + end - start;
        entryIndex = entryIndex + 1;
    }
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.setTownFocusCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(payloadLength);
    var entryCount = <uint>allocation.points.length;
    batch.commandPayloadBytes.add(entryCount & <uint>255);
    batch.commandPayloadBytes.add((entryCount >> 8) & <uint>255);
    entryIndex = 0;
    while (entryIndex < allocation.points.length) {
        var componentStart = <uint>allocation.componentOffsets[entryIndex];
        var componentEnd = <uint>allocation.componentOffsets[entryIndex + 1];
        var componentLength = componentEnd - componentStart;
        batch.commandPayloadBytes.add(componentLength & <uint>255);
        batch.commandPayloadBytes.add((componentLength >> 8) & <uint>255);
        batch.commandPayloadBytes.add((componentLength >> 16) & <uint>255);
        batch.commandPayloadBytes.add((componentLength >> 24) & <uint>255);
        var cursor = componentStart;
        while (cursor < componentEnd) {
            batch.commandPayloadBytes.add(<uint>allocation.componentBytes[<int>cursor]);
            cursor = cursor + <uint>1;
        }
        var points = <int>allocation.points[entryIndex];
        var pointBits = points < 0 ? <uint>4294967295 : <uint>points;
        batch.commandPayloadBytes.add(pointBits & <uint>255);
        batch.commandPayloadBytes.add((pointBits >> 8) & <uint>255);
        batch.commandPayloadBytes.add((pointBits >> 16) & <uint>255);
        batch.commandPayloadBytes.add((pointBits >> 24) & <uint>255);
        entryIndex = entryIndex + 1;
    }
}

appendTelemetryCommandForTest(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.telemetryCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>43);

    batch.commandPayloadBytes.add(<uint>6); batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>0); batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>114); batch.commandPayloadBytes.add(<uint>101);
    batch.commandPayloadBytes.add(<uint>110); batch.commandPayloadBytes.add(<uint>100);
    batch.commandPayloadBytes.add(<uint>101); batch.commandPayloadBytes.add(<uint>114);
    batch.commandPayloadBytes.add(<uint>2); batch.commandPayloadBytes.add(<uint>0);

    batch.commandPayloadBytes.add(<uint>3); batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>0); batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>102); batch.commandPayloadBytes.add(<uint>112);
    batch.commandPayloadBytes.add(<uint>115);
    appendExactSmallIntegerF64ForTest(batch.commandPayloadBytes, <uint>1);

    batch.commandPayloadBytes.add(<uint>4); batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>0); batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>112); batch.commandPayloadBytes.add(<uint>105);
    batch.commandPayloadBytes.add(<uint>110); batch.commandPayloadBytes.add(<uint>103);
    appendExactSmallIntegerF64ForTest(batch.commandPayloadBytes, <uint>2);
}

