massBarrierPersonalBarrierAbilityCode(state: WorldState, casterIndex: int): uint {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length) { return <uint>0; }
    var specCode = <uint>state.entityTalentSpecCodes[casterIndex];
    var specId = specCode == <uint>0 ? "" : talentSelectionCatalog.specId(specCode);
    if (specId == "arcane") {
        return <uint>knownAbilityCatalog.abilityCode("temporal_barrier");
    }
    if (specId == "fire") {
        return <uint>knownAbilityCatalog.abilityCode("blazing_barrier");
    }
    if (specId == "frost") {
        return <uint>knownAbilityCatalog.abilityCode("ice_barrier");
    }
    return <uint>0;
}

massBarrierPersonalBarrierCooldownMicros(state: WorldState, casterIndex: int): uint {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length) { return <uint>0; }
    var specCode = <uint>state.entityTalentSpecCodes[casterIndex];
    var specId = specCode == <uint>0 ? "" : talentSelectionCatalog.specId(specCode);
    return specId == "arcane" ? <uint>12000000 :
        (specId == "fire" || specId == "frost" ? <uint>30000000 : <uint>0);
}

massBarrierRecipientPrecedes(
    state: WorldState,
    casterIndex: int,
    candidateIndex: int,
    selectedIndex: int,
    candidateCount: int
): bool {
    var candidateId = <uint>state.entityIds[candidateIndex];
    var selectedId = <uint>state.entityIds[selectedIndex];
    if (candidateCount <= 5) { return candidateId < selectedId; }
    if (candidateIndex == casterIndex) { return true; }
    if (selectedIndex == casterIndex) { return false; }
    var candidateDx = <float>state.entityX[candidateIndex] -
        <float>state.entityX[casterIndex];
    var candidateDz = <float>state.entityZ[candidateIndex] -
        <float>state.entityZ[casterIndex];
    var selectedDx = <float>state.entityX[selectedIndex] -
        <float>state.entityX[casterIndex];
    var selectedDz = <float>state.entityZ[selectedIndex] -
        <float>state.entityZ[casterIndex];
    var candidateDistance = candidateDx * candidateDx + candidateDz * candidateDz;
    var selectedDistance = selectedDx * selectedDx + selectedDz * selectedDz;
    return candidateDistance != selectedDistance ? candidateDistance < selectedDistance :
        candidateId < selectedId;
}

massBarrierRecipientIndexes(state: WorldState, casterIndex: int): container.Array<int> {
    var candidates = new container.Array<int>();
    var recipients = new container.Array<int>();
    if (casterIndex < 0 || casterIndex >= state.entityIds.length ||
        <uint>state.entityKinds[casterIndex] != <uint>1 ||
        <bool>state.entityDead[casterIndex]) {
        return recipients;
    }
    var partyId = partyIdForIndex(state, casterIndex);
    var candidateIndex = 0;
    while (candidateIndex < state.entityIds.length) {
        if (<uint>state.entityKinds[candidateIndex] != <uint>1 ||
            <bool>state.entityDead[candidateIndex]) {
            candidateIndex = candidateIndex + 1;
            continue;
        }
        if ((partyId == <uint>0 && candidateIndex != casterIndex) ||
            (partyId != <uint>0 && partyIdForIndex(state, candidateIndex) != partyId)) {
            candidateIndex = candidateIndex + 1;
            continue;
        }
        var dx = <float>state.entityX[candidateIndex] - <float>state.entityX[casterIndex];
        var dz = <float>state.entityZ[candidateIndex] - <float>state.entityZ[casterIndex];
        if (dx * dx + dz * dz > 900.0) {
            candidateIndex = candidateIndex + 1;
            continue;
        }
        candidates.add(candidateIndex);
        candidateIndex = candidateIndex + 1;
    }
    var candidateCount = candidates.length;
    var limit = candidateCount > 5 ? 5 : candidateCount;
    while (recipients.length < limit) {
        var selected = -1;
        var candidateCursor = 0;
        while (candidateCursor < candidates.length) {
            var candidate = <int>candidates[candidateCursor];
            var alreadySelected = false;
            for (var recipient in recipients) {
                if (<int>recipient == candidate) { alreadySelected = true; }
            }
            if (!alreadySelected && (selected < 0 ||
                massBarrierRecipientPrecedes(
                    state, casterIndex, candidate, selected, candidateCount
                ))) {
                selected = candidate;
            }
            candidateCursor = candidateCursor + 1;
        }
        if (selected < 0) { break; }
        recipients.add(selected);
    }
    return recipients;
}

coldSnapResetAbilityCodes(): container.Array<uint> {
    var blink = <uint>knownAbilityCatalog.abilityCode("blink");
    var iceBarrier = <uint>knownAbilityCatalog.abilityCode("ice_barrier");
    var blazingBarrier = <uint>knownAbilityCatalog.abilityCode("blazing_barrier");
    var temporalBarrier = <uint>knownAbilityCatalog.abilityCode("temporal_barrier");
    var greaterInvisibility = <uint>knownAbilityCatalog.abilityCode("greater_invisibility");
    if (blink == <uint>0 || iceBarrier == <uint>0 || blazingBarrier == <uint>0 ||
        temporalBarrier == <uint>0 || greaterInvisibility == <uint>0) {
        throw "Cold Snap cooldown reset catalog is invalid";
    }
    var codes = new container.Array<uint>();
    codes.add(blink);
    codes.add(iceBarrier);
    codes.add(blazingBarrier);
    codes.add(temporalBarrier);
    codes.add(greaterInvisibility);
    return codes;
}

