    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    state.entityX[0] = harvestNodeState.nodeX(0);
    state.entityZ[0] = harvestNodeState.nodeZ(0);
    var playerId = <uint>state.entityIds[0];
    var materialCode = harvestNodeState.itemCode(0);
    var drawsBefore = state.rngDraws;
    var harvest = new CommandBatch();
    appendHarvestNodeCommandForTest(harvest, playerId, <uint>1, <uint>1, 0);
    state.applyCommands(harvest, 1);
    if (materialCode != <uint>36 ||
        <uint>state.offlineGatherNodeReadyAtMicros[0] != <uint>120000000 ||
        <uint>state.offlinePendingGatheringGains[0] != <uint>1 ||
        <uint>state.offlineGatheringProficiencies[0] != <uint>0 ||
        m5InventoryItemCount(state, 0, materialCode) != 1 ||
        state.rngDraws != drawsBefore + <uint>1 ||
        state.offlineQuestExperience != <uint>21 ||
        state.offlineQuestLifetimeExperience != <uint>21 ||
        state.offlineGatherVisitedMask != <uint>1 ||
        state.offlineGatherResultSequence != <uint>1 ||
        state.offlineGatherResultNodeCode != <uint>1 ||
        state.offlineGatherResultProfessionCode != <uint>1 ||
        state.offlineGatherResultItemCode != materialCode ||
        state.offlineGatherResultRarityCode != <uint>1) {
        return -2;
    }

    drainOfflineGatheringGains(state);
    if (<uint>state.offlineGatheringProficiencies[0] != <uint>1 ||
        <uint>state.offlinePendingGatheringGains[0] != <uint>0) {
        return -3;
    }
    var rejected = new CommandBatch();
    appendHarvestNodeCommandForTest(rejected, playerId, <uint>1, <uint>2, 0);
    state.applyCommands(rejected, 1);
    if (state.rngDraws != drawsBefore + <uint>1 ||
        m5InventoryItemCount(state, 0, materialCode) != 1 ||
        state.offlineGatherResultSequence != <uint>1 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -4;
    }

    var restored = decodeState(encodeState(state));
    if (restored.offlineGatheringProficiencies.length != 3 ||
        restored.offlineGatherNodeReadyAtMicros.length != 24 ||
        <uint>restored.offlineGatheringProficiencies[0] != <uint>1 ||
        <uint>restored.offlineGatherNodeReadyAtMicros[0] != <uint>120000000 ||
        restored.offlineGatherVisitedMask != <uint>1 ||
        restored.offlineGatherResultSequence != <uint>1 ||
        restored.offlineGatherResultItemCode != <uint>36) {
        return -5;
    }
    restored.offlineGatherResultItemCode = <uint>37;
    return !offlineGatheringStateIsValid(restored) ? 1 : -6;
}

pub offlineCraftItemCommandStateTest(): int {
    if (craftItemState.contractTest() != 1) return -1;
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    var playerId = <uint>state.entityIds[0];
    var linenCode = craftItemState.reagentItemCode(1, 0);
    var spiderCode = craftItemState.reagentItemCode(1, 1);
    var potionCode = craftItemState.resultItemCode(1);
    var drawsBefore = state.rngDraws;

    var denied = new CommandBatch();
    appendCraftItemCommandForTest(denied, playerId, <uint>1, <uint>1, 0);
    state.applyCommands(denied, 1);
    if (state.offlineCraftResultSequence != <uint>1 ||
        state.offlineCraftResultReasonCode !=
            craftItemState.reasonInsufficientMaterials() ||
        state.rngDraws != drawsBefore || state.offlineCraftAlchemySkill != <uint>0 ||
        state.offlineCraftThrottleCount != <uint>0 ||
        m5InventoryItemCount(state, 0, potionCode) != 0) return -2;

    var unsupported = new CommandBatch();
    appendCraftItemCommandForTest(unsupported, playerId, <uint>1, <uint>2, 1);
    state.applyCommands(unsupported, 1);
    if (state.offlineCraftResultSequence != <uint>2 ||
        state.offlineCraftResultReasonCode !=
            craftItemState.reasonUnsupportedInstanceOutput() ||
        state.rngDraws != drawsBefore) return -3;

    setM5InventoryCopper(state, 0, 5);
    grantM5InventoryItem(state, 0, linenCode, 1);
    grantM5InventoryItem(state, 0, spiderCode, 1);
    state.entityDead[0] = true;
    var success = new CommandBatch();
    appendCraftItemCommandForTest(success, playerId, <uint>1, <uint>3, 0);
    state.applyCommands(success, 1);
    if (state.offlineCraftResultSequence != <uint>3 ||
        state.offlineCraftResultReasonCode != craftItemState.reasonSuccess() ||
        state.offlineCraftResultItemCode != potionCode ||
        state.offlineCraftResultCount != <uint>1 ||
        state.offlineCraftResultQualityCode != <uint>1 ||
        state.offlineCraftResultMasterwork || state.rngDraws != drawsBefore + <uint>1 ||
        m5InventoryItemCount(state, 0, linenCode) != 0 ||
        m5InventoryItemCount(state, 0, spiderCode) != 0 ||
        m5InventoryItemCount(state, 0, potionCode) != 1 ||
        <int>state.entityInventoryCopper[0] != 3 ||
        state.offlineCraftAlchemySkill != <uint>1 ||
        state.offlineCraftThrottleCount != <uint>1 ||
        state.offlineCraftsPerformed != <uint>1 ||
        state.offlineQuestExperience != <uint>24 ||
        state.offlineQuestLifetimeExperience != <uint>24) return -4;

    state.offlineCraftThrottleCount = craftItemState.throttleMaximum();
    grantM5InventoryItem(state, 0, linenCode, 1);
    grantM5InventoryItem(state, 0, spiderCode, 1);
    var throttled = new CommandBatch();
    appendCraftItemCommandForTest(throttled, playerId, <uint>1, <uint>4, 0);
    state.applyCommands(throttled, 1);
    if (state.offlineCraftResultReasonCode != craftItemState.reasonThrottled() ||
        state.rngDraws != drawsBefore + <uint>1 ||
        m5InventoryItemCount(state, 0, linenCode) != 1 ||
        m5InventoryItemCount(state, 0, spiderCode) != 1) return -5;

    state.timeMicros = craftItemState.throttleWindowMicros();
    var rolled = new CommandBatch();
    appendCraftItemCommandForTest(rolled, playerId, <uint>1, <uint>5, 0);
    state.applyCommands(rolled, 1);
    if (state.offlineCraftResultReasonCode != craftItemState.reasonSuccess() ||
        state.offlineCraftThrottleWindowStartMicros != state.timeMicros ||
        state.offlineCraftThrottleCount != <uint>1 ||
        state.offlineCraftAlchemySkill != <uint>2 ||
        state.offlineCraftsPerformed != <uint>2 ||
        state.rngDraws != drawsBefore + <uint>2 ||
        m5InventoryItemCount(state, 0, potionCode) != 2 ||
        <int>state.entityInventoryCopper[0] != 1 ||
        state.offlineQuestExperience != <uint>48 ||
        state.offlineQuestLifetimeExperience != <uint>48) return -6;

    var unknownBytes = new container.Array<uint>();
    unknownBytes.add(<uint>120);
    var unknown = new CommandBatch();
    appendCraftItemBytesForTest(unknown, playerId, <uint>1, <uint>6, unknownBytes);
    state.applyCommands(unknown, 1);
    if (state.offlineCraftResultSequence != <uint>6 ||
        state.offlineCraftResultReasonCode != craftItemState.reasonUnknownRecipe() ||
        state.offlineCraftResultRecipeBytes.length != 1 ||
        <uint>state.offlineCraftResultRecipeBytes[0] != <uint>120 ||
        state.rngDraws != drawsBefore + <uint>2) return -7;

    var invalidUtf8 = new container.Array<uint>();
    invalidUtf8.add(<uint>192); invalidUtf8.add(<uint>128);
    var malformed = new CommandBatch();
    appendCraftItemBytesForTest(malformed, playerId, <uint>1, <uint>7, invalidUtf8);
    state.applyCommands(malformed, 1);
    if (state.offlineCraftResultSequence != <uint>6 ||
        state.offlineCraftResultReasonCode != craftItemState.reasonUnknownRecipe() ||
        state.rngDraws != drawsBefore + <uint>2 ||
        <uint>state.entityLastCommandSequence[0] != <uint>7) return -8;

    var restored = decodeState(encodeState(state));
    if (restored.offlineCraftAlchemySkill != <uint>2 ||
        restored.offlineCraftThrottleWindowStartMicros != <uint>60000000 ||
        restored.offlineCraftThrottleCount != <uint>1 ||
        restored.offlineCraftsPerformed != <uint>2 ||
        restored.offlineCraftResultSequence != <uint>6 ||
        restored.offlineCraftResultRecipeBytes.length != 1 ||
        <uint>restored.offlineCraftResultRecipeBytes[0] != <uint>120 ||
        restored.offlineCraftResultReasonCode != craftItemState.reasonUnknownRecipe() ||
        !offlineCraftStateIsValid(restored)) return -9;
    restored.offlineCraftResultReasonCode = craftItemState.reasonSuccess();
    return !offlineCraftStateIsValid(restored) ? 1 : -10;
}

pub heroicVendorCommandStateTest(): int {
    var catalog = %import("generated/m5_content_catalog");
    if (catalog.heroicVendorOfferCount() != 10 ||
        catalog.heroicVendorOfferMarks(0) != 12 ||
        catalog.heroicVendorOfferMarks(9) != 16 ||
        heroicVendorStaticNpcIndex() != 23) return -1;
    var state = new WorldState();
    var vendorX = npcPlacement.finalStaticNpcCoordinate(
        state.worldSeed, heroicVendorStaticNpcIndex(), 1, true
    );
    var vendorZ = npcPlacement.finalStaticNpcCoordinate(
        state.worldSeed, heroicVendorStaticNpcIndex(), 2, true
    );
    var playerId = state.spawnPlayer(<uint>1, 20, vendorX, 1.5, vendorZ, 100, 7.0, 1);
    state.spawnQuestNpc(<uint>24, vendorX, vendorZ, 1);
    var markCode = m5InventoryItemCodeForId("heroic_mark");
    var ringCode = m5InventoryItemCodeForId("seal_of_the_nine_oaths");
    var neckCode = m5InventoryItemCodeForId("medallion_of_endless_profit");

    var fullBagState = new WorldState();
    var fullBagPlayerId = fullBagState.spawnPlayer(
        <uint>1, 20, vendorX, 1.5, vendorZ, 100, 7.0, 1
    );
    fullBagState.spawnQuestNpc(<uint>24, vendorX, vendorZ, 1);
    grantM5InventoryItem(fullBagState, 0, markCode, 12);
    var fillItemIndex = 0;
    while (fillItemIndex < catalog.count("item") &&
           m5InventoryUsedSlots(fullBagState, 0) <
               m5InventoryCapacity(fullBagState, 0)) {
        var fillItemCode = <uint>(fillItemIndex + 1);
        if (fillItemCode != ringCode &&
            m5InventoryRules.stackLimitForItemIndex(fillItemIndex) == 1) {
            grantM5InventoryItem(fullBagState, 0, fillItemCode, 1);
        }
        fillItemIndex = fillItemIndex + 1;
    }
    if (m5InventoryUsedSlots(fullBagState, 0) !=
        m5InventoryCapacity(fullBagState, 0)) return -2;
    var fullBagBuy = new CommandBatch();
    appendHeroicBuyCommandForTest(
        fullBagBuy, fullBagPlayerId, <uint>1, <uint>1, 0
    );
    fullBagState.applyCommands(fullBagBuy, 1);
    if (m5InventoryItemCount(fullBagState, 0, markCode) != 12 ||
        m5InventoryItemCount(fullBagState, 0, ringCode) != 0 ||
        m5InventoryUsedSlots(fullBagState, 0) !=
            m5InventoryCapacity(fullBagState, 0)) return -3;

    grantM5InventoryItem(state, 0, markCode, 20);
    if (m5InventoryUsedSlots(state, 0) != 1) return -4;

    var buyRing = new CommandBatch();
    appendHeroicBuyCommandForTest(buyRing, playerId, <uint>1, <uint>1, 0);
    state.applyCommands(buyRing, 1);
    if (m5InventoryItemCount(state, 0, markCode) != 8 ||
        m5InventoryItemCount(state, 0, ringCode) != 1 ||
        m5InventoryUsedSlots(state, 0) != 2) return -5;

    var insufficient = new CommandBatch();
    appendHeroicBuyCommandForTest(insufficient, playerId, <uint>1, <uint>2, 9);
    state.applyCommands(insufficient, 1);
    if (m5InventoryItemCount(state, 0, markCode) != 8 ||
        m5InventoryItemCount(state, 0, neckCode) != 0) return -6;

    grantM5InventoryItem(state, 0, markCode, 8);
    state.entityDead[0] = true;
    var dead = new CommandBatch();
    appendHeroicBuyCommandForTest(dead, playerId, <uint>1, <uint>3, 9);
    state.applyCommands(dead, 1);
    if (m5InventoryItemCount(state, 0, markCode) != 16 ||
        m5InventoryItemCount(state, 0, neckCode) != 0) return -7;

    state.entityDead[0] = false;
    state.entityX[0] = vendorX + 8.0;
    var distant = new CommandBatch();
    appendHeroicBuyCommandForTest(distant, playerId, <uint>1, <uint>4, 9);
    state.applyCommands(distant, 1);
    if (m5InventoryItemCount(state, 0, markCode) != 16 ||
        m5InventoryItemCount(state, 0, neckCode) != 0) return -8;

    state.entityX[0] = vendorX + 7.0;
    var buyNeck = new CommandBatch();
    appendHeroicBuyCommandForTest(buyNeck, playerId, <uint>1, <uint>5, 9);
    state.applyCommands(buyNeck, 1);
    var restored = decodeState(encodeState(state));
    return m5InventoryItemCount(restored, 0, markCode) == 0 &&
        m5InventoryItemCount(restored, 0, ringCode) == 1 &&
        m5InventoryItemCount(restored, 0, neckCode) == 1 &&
        <uint>restored.entityLastCommandSequence[0] == <uint>5 ? 1 : -9;
}

pub delveShopCommandStateTest(): int {
    var catalog = %import("generated/m5_content_catalog");
    if (catalog.delveShopCount() != 2 ||
        catalog.delveShopId(0) != "collapsed_reliquary" ||
        catalog.delveShopId(1) != "drowned_litany" ||
        catalog.delveShopOfferCount(0) != 9 ||
        catalog.delveShopOfferCount(1) != 9 ||
        catalog.delveShopOfferItemIndex(0, 0) !=
            catalog.indexOf("item", "reliquary_legs") ||
        catalog.delveShopDoorX(0) != -5.0 ||
        catalog.delveShopDoorZ(0) != -52.0 ||
        catalog.delveShopDoorX(1) != -95.0 ||
        catalog.delveShopDoorZ(1) != 505.0 ||
        catalog.delveShopOfferMarks(0, 0) != 8 ||
        catalog.delveShopOfferMarks(1, 0) != 16) return -1;

    var legsCode = <uint>(catalog.delveShopOfferItemIndex(0, 0) + 1);
    var shoulderCode = <uint>(catalog.delveShopOfferItemIndex(0, 1) + 1);
    var helmCode = <uint>(catalog.delveShopOfferItemIndex(0, 6) + 1);
    var heroicCode = <uint>(catalog.delveShopOfferItemIndex(0, 7) + 1);
    var litanyLegsCode = <uint>(catalog.delveShopOfferItemIndex(1, 0) + 1);

    // Source addItem force-grants the offer after admission, even when every
    // ordinary bag slot is occupied.
    var fullBagState = new WorldState();
    var fullBagPlayerId = fullBagState.spawnPlayer(
        <uint>1, 20, -5.0, 1.5, -52.0, 100, 7.0, 1
    );
    setDelveShopState(fullBagState, 0, 0, 8, 0, 0, 0);
    var fillItemIndex = 0;
    while (fillItemIndex < catalog.count("item") &&
        m5InventoryUsedSlots(fullBagState, 0) < m5InventoryCapacity(fullBagState, 0)) {
        var fillItemCode = <uint>(fillItemIndex + 1);
        if (fillItemCode != legsCode &&
            m5InventoryRules.stackLimitForItemIndex(fillItemIndex) == 1) {
            grantM5InventoryItem(fullBagState, 0, fillItemCode, 1);
        }
        fillItemIndex = fillItemIndex + 1;
    }
    if (m5InventoryUsedSlots(fullBagState, 0) !=
        m5InventoryCapacity(fullBagState, 0)) return -2;
    var fullBagBuy = new CommandBatch();
    appendDelveBuyCommandForTest(
        fullBagBuy, fullBagPlayerId, <uint>1, <uint>1, 0, 0
    );
    fullBagState.applyCommands(fullBagBuy, 1);
    if (<int>fullBagState.entityDelveMarks[0] != 0 ||
        m5InventoryItemCount(fullBagState, 0, legsCode) != 1 ||
        m5InventoryUsedSlots(fullBagState, 0) !=
            m5InventoryCapacity(fullBagState, 0) + 1) return -3;

    var boundaryState = new WorldState();
    var boundaryPlayerId = boundaryState.spawnPlayer(
        <uint>1, 20, 7.0, 1.5, -52.0, 100, 7.0, 1
    );
    setDelveShopState(boundaryState, 0, 0, 8, 0, 0, 0);
    var boundaryBuy = new CommandBatch();
    appendDelveBuyCommandForTest(
        boundaryBuy, boundaryPlayerId, <uint>1, <uint>1, 0, 0
    );
    boundaryState.applyCommands(boundaryBuy, 1);
    if (<int>boundaryState.entityDelveMarks[0] != 0 ||
        m5InventoryItemCount(boundaryState, 0, legsCode) != 1) return -12;

    var state = new WorldState();
    var playerId = state.spawnPlayer(<uint>1, 20, -5.0, 1.5, -52.0, 100, 7.0, 1);
    setDelveShopState(state, 0, 0, 100, 0, 0, 0);
    var available = new CommandBatch();
    appendDelveBuyCommandForTest(available, playerId, <uint>1, <uint>1, 0, 0);
    state.applyCommands(available, 1);
    if (<int>state.entityDelveMarks[0] != 92 ||
        m5InventoryItemCount(state, 0, legsCode) != 1) return -4;

    var lockedClears = new CommandBatch();
    appendDelveBuyCommandForTest(lockedClears, playerId, <uint>1, <uint>2, 0, 6);
    state.applyCommands(lockedClears, 1);
    if (<int>state.entityDelveMarks[0] != 92 ||
        m5InventoryItemCount(state, 0, helmCode) != 0) return -5;

    // Any tier contributes to clears:N; only the explicit Heroic partition
    // satisfies heroicClear.
    setDelveShopState(state, 0, 0, 92, 1, 0, 2);
    var unlockedClears = new CommandBatch();
    appendDelveBuyCommandForTest(unlockedClears, playerId, <uint>1, <uint>3, 0, 6);
    state.applyCommands(unlockedClears, 1);
    if (<int>state.entityDelveMarks[0] != 80 ||
        m5InventoryItemCount(state, 0, helmCode) != 1) return -6;

    var lockedHeroic = new CommandBatch();
    appendDelveBuyCommandForTest(lockedHeroic, playerId, <uint>1, <uint>4, 0, 7);
    state.applyCommands(lockedHeroic, 1);
    if (<int>state.entityDelveMarks[0] != 80 ||
        m5InventoryItemCount(state, 0, heroicCode) != 0) return -7;

    setDelveShopState(state, 0, 0, 80, 1, 1, 2);
    state.entityDead[0] = true;
    var dead = new CommandBatch();
    appendDelveBuyCommandForTest(dead, playerId, <uint>1, <uint>5, 0, 7);
    state.applyCommands(dead, 1);
    state.entityDead[0] = false;
    state.entityX[0] = 8.0;
    var distant = new CommandBatch();
    appendDelveBuyCommandForTest(distant, playerId, <uint>1, <uint>6, 0, 7);
    state.applyCommands(distant, 1);
    if (<int>state.entityDelveMarks[0] != 80 ||
        m5InventoryItemCount(state, 0, heroicCode) != 0) return -8;

    state.entityX[0] = -5.0;
    var heroic = new CommandBatch();
    appendDelveBuyCommandForTest(heroic, playerId, <uint>1, <uint>7, 0, 7);
    state.applyCommands(heroic, 1);
    if (<int>state.entityDelveMarks[0] != 52 ||
        m5InventoryItemCount(state, 0, heroicCode) != 1) return -9;

    setDelveShopState(state, 0, 0, 7, 1, 1, 2);
    var insufficient = new CommandBatch();
    appendDelveBuyCommandForTest(insufficient, playerId, <uint>1, <uint>8, 0, 1);
    state.applyCommands(insufficient, 1);
    if (<int>state.entityDelveMarks[0] != 7 ||
        m5InventoryItemCount(state, 0, shoulderCode) != 0) return -10;

    var parserState = new WorldState();
    var parserPlayerId = parserState.spawnPlayer(
        <uint>1, 20, -5.0, 1.5, -52.0, 100, 7.0, 1
    );
    setDelveShopState(parserState, 0, 0, 100, 0, 0, 0);
    var knownShopBytes = new container.Array<uint>();
    var knownShopByteIndex = 0;
    while (knownShopByteIndex < catalog.delveShopIdUtf8Length(0)) {
        knownShopBytes.add(catalog.delveShopIdUtf8Byte(0, knownShopByteIndex));
        knownShopByteIndex = knownShopByteIndex + 1;
    }
    var knownItemBytes = new container.Array<uint>();
    var knownItemByteIndex = 0;
    var knownItemIndex = catalog.delveShopOfferItemIndex(0, 0);
    while (knownItemByteIndex < catalog.itemIdUtf8Length(knownItemIndex)) {
        knownItemBytes.add(catalog.itemIdUtf8Byte(knownItemIndex, knownItemByteIndex));
        knownItemByteIndex = knownItemByteIndex + 1;
    }
    var unknownBytes = new container.Array<uint>();
    unknownBytes.add(<uint>120);
    var unknownShop = new CommandBatch();
    appendRawDelveBuyCommandForTest(
        unknownShop, parserPlayerId, <uint>1, <uint>1,
        unknownBytes, knownItemBytes, false
    );
    parserState.applyCommands(unknownShop, 1);
    var unknownItem = new CommandBatch();
    appendRawDelveBuyCommandForTest(
        unknownItem, parserPlayerId, <uint>1, <uint>2,
        knownShopBytes, unknownBytes, false
    );
    parserState.applyCommands(unknownItem, 1);
    var oversizedBytes = new container.Array<uint>();
    var oversizedByteIndex = 0;
    while (oversizedByteIndex < 257) {
        oversizedBytes.add(<uint>120);
        oversizedByteIndex = oversizedByteIndex + 1;
    }
    var oversizedShop = new CommandBatch();
    appendRawDelveBuyCommandForTest(
        oversizedShop, parserPlayerId, <uint>1, <uint>3,
        oversizedBytes, knownItemBytes, false
    );
    if (delveBuyPayloadShapeIsValid(
        <uint>oversizedShop.commandPayloadOffsets[0],
        <uint>oversizedShop.commandPayloadLengths[0],
        oversizedShop.commandPayloadBytes
    )) return -13;
    var oversizedItem = new CommandBatch();
    appendRawDelveBuyCommandForTest(
        oversizedItem, parserPlayerId, <uint>1, <uint>4,
        knownShopBytes, oversizedBytes, false
    );
    if (delveBuyPayloadShapeIsValid(
        <uint>oversizedItem.commandPayloadOffsets[0],
        <uint>oversizedItem.commandPayloadLengths[0],
        oversizedItem.commandPayloadBytes
    )) return -13;
    var trailingPayload = new CommandBatch();
    appendRawDelveBuyCommandForTest(
        trailingPayload, parserPlayerId, <uint>1, <uint>5,
        knownShopBytes, knownItemBytes, true
    );
    if (delveBuyPayloadShapeIsValid(
        <uint>trailingPayload.commandPayloadOffsets[0],
        <uint>trailingPayload.commandPayloadLengths[0],
        trailingPayload.commandPayloadBytes
    )) return -13;
    if (<int>parserState.entityDelveMarks[0] != 100 ||
        m5InventoryItemCount(parserState, 0, legsCode) != 0 ||
        <uint>parserState.entityLastCommandSequence[0] != <uint>2) return -13;

    // Empty WOS81 snapshots have no per-entity WOS80/WOS81 tail. Removing the
    // fixed discovery suffix and re-labeling the shared prefix as WOS79 exercises
    // the exact migration path without fabricating a serialized entity row.
    var legacyWos79Bytes = encodeStateVersion(new WorldState(), <uint>80);
    legacyWos79Bytes[4] = <uint>79;
    legacyWos79Bytes[5] = <uint>0;
    var legacyWos79 = decodeState(legacyWos79Bytes);
    legacyWos79.spawnPlayer(<uint>1, 20, -5.0, 1.5, -52.0, 100, 7.0, 1);
    if (<int>legacyWos79.entityDelveMarks[0] != 0 ||
        <int>legacyWos79.entityDelveShopNormalClears[0] != 0 ||
        <int>legacyWos79.entityDelveShopHeroicClears[0] != 0 ||
        <int>legacyWos79.entityDelveShopOtherClears[0] != 0) return -14;

    state.entityX[0] = -95.0;
    state.entityZ[0] = 505.0;
    setDelveShopState(state, 0, 1, 56, 0, 0, 0);
    var drowned = new CommandBatch();
    appendDelveBuyCommandForTest(drowned, playerId, <uint>1, <uint>9, 1, 0);
    state.applyCommands(drowned, 1);
    var restored = decodeState(encodeState(state));
    var reliquaryClearIndex = delveShopClearIndex(0, 0);
    var drownedClearIndex = delveShopClearIndex(0, 1);
    var firstRareCode = deedTitleState.deedCodeForId("col_first_rare");
    return <int>restored.entityDelveMarks[0] == 40 &&
        <int>restored.entityDelveShopNormalClears[reliquaryClearIndex] == 1 &&
        <int>restored.entityDelveShopHeroicClears[reliquaryClearIndex] == 1 &&
        <int>restored.entityDelveShopOtherClears[reliquaryClearIndex] == 2 &&
        <int>restored.entityDelveShopNormalClears[drownedClearIndex] == 0 &&
        m5InventoryItemCount(restored, 0, legsCode) == 1 &&
        m5InventoryItemCount(restored, 0, helmCode) == 1 &&
        m5InventoryItemCount(restored, 0, heroicCode) == 1 &&
        m5InventoryItemCount(restored, 0, litanyLegsCode) == 1 &&
        <bool>restored.offlineM5ItemsDiscovered[<int>heroicCode - 1] &&
        <bool>restored.offlineDeedsEarned[<int>firstRareCode - 1] &&
        <uint>restored.entityLastCommandSequence[0] == <uint>9 ? 1 : -11;
}

pub companionUpgradeCommandStateTest(): int {
    var catalog = %import("generated/m5_content_catalog");
    if (delveCompanionContent.contractTest() != 1 ||
        delveCompanionContent.companionCount(true) != 2 ||
        delveCompanionContent.companionId(0, true) != "companion_tessa" ||
        delveCompanionContent.companionId(1, true) != "companion_edda" ||
        catalog.delveShopCompanionId(0) != "companion_tessa" ||
        catalog.delveShopCompanionId(1) != "companion_edda") return -1;

    var state = new WorldState();
    var playerId = state.spawnPlayer(
        <uint>1, 20, -5.0, 1.5, -52.0, 100, 7.0, 1
    );
    setDelveShopState(state, 0, 0, 8, 0, 0, 0);
    setM5InventoryCopper(state, 0, 77);
    var tessaRankIndex = delveCompanionRankIndex(0, 0);
    var eddaRankIndex = delveCompanionRankIndex(0, 1);

    state.entityDead[0] = true;
    var dead = new CommandBatch();
    appendCompanionUpgradeCommandForTest(dead, playerId, <uint>1, <uint>1, 0);
    state.applyCommands(dead, 1);
    state.entityDead[0] = false;
    state.entityX[0] = 8.0;
    var distant = new CommandBatch();
    appendCompanionUpgradeCommandForTest(distant, playerId, <uint>1, <uint>2, 0);
    state.applyCommands(distant, 1);
    if (<int>state.entityDelveCompanionRanks[tessaRankIndex] != 1 ||
        <int>state.entityDelveMarks[0] != 8) return -2;

    state.entityX[0] = 7.0;
    var tessaRankTwo = new CommandBatch();
    appendCompanionUpgradeCommandForTest(
        tessaRankTwo, playerId, <uint>1, <uint>3, 0
    );
    state.applyCommands(tessaRankTwo, 1);
    var tessaRankThree = new CommandBatch();
    appendCompanionUpgradeCommandForTest(
        tessaRankThree, playerId, <uint>1, <uint>4, 0
    );
    state.applyCommands(tessaRankThree, 1);
    var maximumDeedCode = deedTitleState.deedCodeForId("dlv_companion_max");
    var bothDeedCode = deedTitleState.deedCodeForId("dlv_companions_both");
    if (<int>state.entityDelveCompanionRanks[tessaRankIndex] != 3 ||
        <int>state.entityDelveMarks[0] != 0 ||
        <int>state.entityInventoryCopper[0] != 77 ||
        !<bool>state.offlineDeedsEarned[<int>maximumDeedCode - 1] ||
        <bool>state.offlineDeedsEarned[<int>bothDeedCode - 1]) return -3;

    state.entityX[0] = -95.0;
    state.entityZ[0] = 505.0;
    setDelveShopState(state, 0, 1, 2, 0, 0, 0);
    var insufficient = new CommandBatch();
    appendCompanionUpgradeCommandForTest(
        insufficient, playerId, <uint>1, <uint>5, 1
    );
    state.applyCommands(insufficient, 1);
    if (<int>state.entityDelveCompanionRanks[eddaRankIndex] != 1 ||
        <int>state.entityDelveMarks[0] != 2) return -4;

    setDelveShopState(state, 0, 1, 8, 0, 0, 0);
    var eddaRankTwo = new CommandBatch();
    appendCompanionUpgradeCommandForTest(
        eddaRankTwo, playerId, <uint>1, <uint>6, 1
    );
    state.applyCommands(eddaRankTwo, 1);
    var eddaRankThree = new CommandBatch();
    appendCompanionUpgradeCommandForTest(
        eddaRankThree, playerId, <uint>1, <uint>7, 1
    );
    state.applyCommands(eddaRankThree, 1);
    if (<int>state.entityDelveCompanionRanks[eddaRankIndex] != 3 ||
        <int>state.entityDelveMarks[0] != 0 ||
        !<bool>state.offlineDeedsEarned[<int>bothDeedCode - 1]) return -5;

    setDelveShopState(state, 0, 1, 10, 0, 0, 0);
    var maximum = new CommandBatch();
    appendCompanionUpgradeCommandForTest(maximum, playerId, <uint>1, <uint>8, 1);
    state.applyCommands(maximum, 1);
    var unknownCompanionBytes = new container.Array<uint>();
    unknownCompanionBytes.add(<uint>120);
    var unknownCompanion = new CommandBatch();
    appendRawCompanionUpgradeCommandForTest(
        unknownCompanion, playerId, <uint>1, <uint>9,
        unknownCompanionBytes, false
    );
    state.applyCommands(unknownCompanion, 1);
    if (<int>state.entityDelveCompanionRanks[eddaRankIndex] != 3 ||
        <int>state.entityDelveMarks[0] != 10) return -6;

    var maximumCompanionBytes = new container.Array<uint>();
    var maximumCompanionByteIndex = 0;
    while (maximumCompanionByteIndex < 256) {
        maximumCompanionBytes.add(<uint>120);
        maximumCompanionByteIndex = maximumCompanionByteIndex + 1;
    }
    var maximumCompanion = new CommandBatch();
    appendRawCompanionUpgradeCommandForTest(
        maximumCompanion, playerId, <uint>1, <uint>10,
        maximumCompanionBytes, false
    );
    if (!companionUpgradePayloadShapeIsValid(
        <uint>maximumCompanion.commandPayloadOffsets[0],
        <uint>maximumCompanion.commandPayloadLengths[0],
        maximumCompanion.commandPayloadBytes
    )) return -7;

    var oversizedCompanionBytes = new container.Array<uint>();
    var oversizedCompanionByteIndex = 0;
    while (oversizedCompanionByteIndex < 257) {
        oversizedCompanionBytes.add(<uint>120);
        oversizedCompanionByteIndex = oversizedCompanionByteIndex + 1;
    }
    var oversizedCompanion = new CommandBatch();
    appendRawCompanionUpgradeCommandForTest(
        oversizedCompanion, playerId, <uint>1, <uint>11,
        oversizedCompanionBytes, false
    );
    if (companionUpgradePayloadShapeIsValid(
        <uint>oversizedCompanion.commandPayloadOffsets[0],
        <uint>oversizedCompanion.commandPayloadLengths[0],
        oversizedCompanion.commandPayloadBytes
    )) return -8;
    var tessaBytes = new container.Array<uint>();
    var tessaByteIndex = 0;
    while (tessaByteIndex < delveCompanionContent.companionIdUtf8Length(0, true)) {
        tessaBytes.add(
            delveCompanionContent.companionIdUtf8Byte(0, tessaByteIndex, true)
        );
        tessaByteIndex = tessaByteIndex + 1;
    }
    var trailingCompanionPayload = new CommandBatch();
    appendRawCompanionUpgradeCommandForTest(
        trailingCompanionPayload, playerId, <uint>1, <uint>12, tessaBytes, true
    );
    if (companionUpgradePayloadShapeIsValid(
        <uint>trailingCompanionPayload.commandPayloadOffsets[0],
        <uint>trailingCompanionPayload.commandPayloadLengths[0],
        trailingCompanionPayload.commandPayloadBytes
    )) return -9;

    var restored = decodeState(encodeState(state));
    if (<int>restored.entityDelveCompanionRanks[tessaRankIndex] != 3 ||
        <int>restored.entityDelveCompanionRanks[eddaRankIndex] != 3 ||
        <int>restored.entityDelveMarks[0] != 10 ||
        <int>restored.entityInventoryCopper[0] != 77 ||
        !<bool>restored.offlineDeedsEarned[<int>maximumDeedCode - 1] ||
        !<bool>restored.offlineDeedsEarned[<int>bothDeedCode - 1] ||
        <uint>restored.entityLastCommandSequence[0] != <uint>9) return -10;

    var retroClosureState = new WorldState();
    retroClosureState.spawnPlayer(
        <uint>1, 20, -5.0, 1.5, -52.0, 100, 7.0, 1
    );
    var retroRareItemCode = <uint>(
        catalog.indexOf("item", "deacon_reliquary_helm") + 1
    );
    grantM5InventoryItem(retroClosureState, 0, retroRareItemCode, 1);
    grantM5InventoryItem(retroClosureState, 0, retroRareItemCode, 1);
    var firstRareDeedCode = deedTitleState.deedCodeForId("col_first_rare");
    retroClosureState.offlineDeedsEarned[<int>firstRareDeedCode - 1] = false;
    retroClosureState.entityDelveCompanionRanks[
        delveCompanionRankIndex(0, 0)
    ] = 3;
    retroClosureState.entityDelveCompanionRanks[
        delveCompanionRankIndex(0, 1)
    ] = 3;
    retroClosureState.offlineDeedsEarned[<int>maximumDeedCode - 1] = false;
    retroClosureState.offlineDeedsEarned[<int>bothDeedCode - 1] = false;
    var retroClosure = decodeState(encodeState(retroClosureState));
    if (m5InventoryItemCount(retroClosure, 0, retroRareItemCode) != 2 ||
        !<bool>retroClosure.offlineM5ItemsDiscovered[
            <int>retroRareItemCode - 1
        ] ||
        !<bool>retroClosure.offlineDeedsEarned[<int>firstRareDeedCode - 1] ||
        !<bool>retroClosure.offlineDeedsEarned[<int>maximumDeedCode - 1] ||
        !<bool>retroClosure.offlineDeedsEarned[<int>bothDeedCode - 1]) return -11;

    var legacyWos80State = new WorldState();
    legacyWos80State.spawnPlayer(
        <uint>1, 20, -5.0, 1.5, -52.0, 100, 7.0, 1
    );
    var legacyHeldItemCode = <uint>(catalog.indexOf("item", "reliquary_legs") + 1);
    grantM5InventoryItem(legacyWos80State, 0, legacyHeldItemCode, 1);
    var legacyWos80Bytes = encodeStateVersion(legacyWos80State, <uint>80);
    var legacyWos80 = decodeState(legacyWos80Bytes);
    return <int>legacyWos80.entityDelveCompanionRanks[0] == 1 &&
        <int>legacyWos80.entityDelveCompanionRanks[1] == 1 &&
        <bool>legacyWos80.offlineM5ItemsDiscovered[
            <int>legacyHeldItemCode - 1
        ] && m5InventoryItemCount(legacyWos80, 0, legacyHeldItemCode) == 1 ? 1 : -12;
}

pub offlineDeedSetTitleCommandStateTest(): int {
    if (deedTitleState.contractTest() != 1) return -1;
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    var playerId = <uint>state.entityIds[0];
    var veteranCode = deedTitleState.deedCodeForId("prog_veteran");
    var championCode = deedTitleState.deedCodeForId("prog_champion");
    var firstStepsCode = deedTitleState.deedCodeForId("prog_first_steps");
    state.offlineDeedsEarned[<int>veteranCode - 1] = true;
    state.offlineDeedsEarned[<int>firstStepsCode - 1] = true;
    var drawsBefore = state.rngDraws;

    var select = new CommandBatch();
    appendDeedSetTitleCommandForTest(
        select, playerId, <uint>1, <uint>1, <int>veteranCode - 1
    );
    state.applyCommands(select, 1);
    if (state.offlineActiveTitleDeedCode != veteranCode ||
        <uint>state.entityActiveTitleDeedCodes[0] != veteranCode ||
        state.rngDraws != drawsBefore) {
        return -2;
    }

    var unearned = new CommandBatch();
    appendDeedSetTitleCommandForTest(
        unearned, playerId, <uint>1, <uint>2, <int>championCode - 1
    );
    state.applyCommands(unearned, 1);
    var rewardless = new CommandBatch();
    appendDeedSetTitleCommandForTest(
        rewardless, playerId, <uint>1, <uint>3, <int>firstStepsCode - 1
    );
    state.applyCommands(rewardless, 1);
    if (state.offlineActiveTitleDeedCode != veteranCode ||
        <uint>state.entityActiveTitleDeedCodes[0] != veteranCode ||
        <uint>state.entityLastCommandSequence[0] != <uint>3) {
        return -3;
    }

    var clear = new CommandBatch();
    appendDeedSetTitleCommandForTest(clear, playerId, <uint>1, <uint>4, -1);
    state.applyCommands(clear, 1);
    if (state.offlineActiveTitleDeedCode != <uint>0 ||
        <uint>state.entityActiveTitleDeedCodes[0] != <uint>0) {
        return -4;
    }
    var reselect = new CommandBatch();
    appendDeedSetTitleCommandForTest(
        reselect, playerId, <uint>1, <uint>5, <int>veteranCode - 1
    );
    state.applyCommands(reselect, 1);
    var restored = decodeState(encodeState(state));
    if (!<bool>restored.offlineDeedsEarned[<int>veteranCode - 1] ||
        restored.offlineActiveTitleDeedCode != veteranCode ||
        <uint>restored.entityActiveTitleDeedCodes[0] != veteranCode ||
        !offlineDeedTitleStateIsValid(restored)) {
        return -5;
    }

    restored.offlineDeedsEarned[<int>veteranCode - 1] = false;
    normalizeOfflineDeedTitleState(restored);
    return restored.offlineActiveTitleDeedCode == <uint>0 &&
        <uint>restored.entityActiveTitleDeedCodes[0] == <uint>0 &&
        offlineDeedTitleStateIsValid(restored) ? 1 : -6;
}

pub offlineSetTownFocusCommandStateTest(): int {
    if (townFocusState.contractTest() != 1 || townFocusWireState.contractTest() != 1) {
        return -1;
    }
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    state.entityX[0] = 0.0;
    state.entityZ[0] = 0.0;
    var playerId = <uint>state.entityIds[0];
    var drawsBefore = state.rngDraws;

    var hide = new container.Array<uint>();
    hide.add(<uint>104); hide.add(<uint>105); hide.add(<uint>100); hide.add(<uint>101);
    var herb = new container.Array<uint>();
    herb.add(<uint>104); herb.add(<uint>101); herb.add(<uint>114); herb.add(<uint>98);
    var ore = new container.Array<uint>();
    ore.add(<uint>111); ore.add(<uint>114); ore.add(<uint>101);
    var request = new townFocusWireState.WireFocusAllocation();
    townFocusWireState.addEntry(request, hide, 6);
    townFocusWireState.addEntry(request, herb, 0);
    townFocusWireState.addEntry(request, ore, 4);
    var accepted = new CommandBatch();
    appendTownFocusCommandForTest(accepted, playerId, <uint>1, <uint>1, request);
    state.applyCommands(accepted, 1);
    if (state.offlineTownFocusPoints.length != 2 ||
        <int>state.offlineTownFocusPoints[0] != 6 ||
        <int>state.offlineTownFocusPoints[1] != 4 ||
        state.offlineTownFocusComponentOffsets.length != 3 ||
        <uint>state.offlineTownFocusComponentOffsets[1] != <uint>4 ||
        <uint>state.offlineTownFocusComponentOffsets[2] != <uint>7 ||
        state.rngDraws != drawsBefore || !offlineTownFocusStateIsValid(state)) {
        return -2;
    }

    state.entityX[0] = 1000.0;
    var outOfTownRequest = new townFocusWireState.WireFocusAllocation();
    townFocusWireState.addEntry(outOfTownRequest, ore, 10);
    var outOfTown = new CommandBatch();
    appendTownFocusCommandForTest(
        outOfTown, playerId, <uint>1, <uint>2, outOfTownRequest
    );
    state.applyCommands(outOfTown, 1);
    if (state.offlineTownFocusPoints.length != 2 ||
        <int>state.offlineTownFocusPoints[0] != 6) return -3;

    state.entityX[0] = 0.0;
    var overRequest = new townFocusWireState.WireFocusAllocation();
    townFocusWireState.addEntry(overRequest, hide, 11);
    var over = new CommandBatch();
    appendTownFocusCommandForTest(over, playerId, <uint>1, <uint>3, overRequest);
    state.applyCommands(over, 1);
    var emptyKey = new container.Array<uint>();
    var invalidRequest = new townFocusWireState.WireFocusAllocation();
    townFocusWireState.addEntry(invalidRequest, emptyKey, 1);
    var invalid = new CommandBatch();
    appendTownFocusCommandForTest(invalid, playerId, <uint>1, <uint>4, invalidRequest);
    state.applyCommands(invalid, 1);
    if (state.offlineTownFocusPoints.length != 2 ||
        <uint>state.entityLastCommandSequence[0] != <uint>4) return -4;

    var clearRequest = new townFocusWireState.WireFocusAllocation();
    var clear = new CommandBatch();
    appendTownFocusCommandForTest(clear, playerId, <uint>1, <uint>5, clearRequest);
    state.applyCommands(clear, 1);
    if (state.offlineTownFocusPoints.length != 0 ||
        state.offlineTownFocusComponentBytes.length != 0 ||
        state.offlineTownFocusComponentOffsets.length != 1) return -5;

    // U+77FF ("ore") proves arbitrary validated UTF-8 bytes survive without
    // requiring a VM byte-to-string conversion. Dead players remain eligible,
    // matching the source method's lack of a dead-state gate.
    var unicode = new container.Array<uint>();
    unicode.add(<uint>231); unicode.add(<uint>159); unicode.add(<uint>191);
    var unicodeRequest = new townFocusWireState.WireFocusAllocation();
    townFocusWireState.addEntry(unicodeRequest, unicode, 10);
    state.entityDead[0] = true;
    var unicodeCommand = new CommandBatch();
    appendTownFocusCommandForTest(
        unicodeCommand, playerId, <uint>1, <uint>6, unicodeRequest
    );
    state.applyCommands(unicodeCommand, 1);
    var restored = decodeState(encodeState(state));
    return restored.offlineTownFocusPoints.length == 1 &&
        <int>restored.offlineTownFocusPoints[0] == 10 &&
        restored.offlineTownFocusComponentBytes.length == 3 &&
        <uint>restored.offlineTownFocusComponentBytes[0] == <uint>231 &&
        <uint>restored.offlineTownFocusComponentBytes[1] == <uint>159 &&
        <uint>restored.offlineTownFocusComponentBytes[2] == <uint>191 &&
        restored.rngDraws == drawsBefore && offlineTownFocusStateIsValid(restored) ? 1 : -6;
}

pub offlineResurrectRespondCommandStateTest(): int {
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    var playerId = <uint>state.entityIds[0];
    var payloads = %import("protocol/command_payloads");
    var accept = new CommandBatch();
    appendBooleanCommand(
        accept, payloads.resurrectRespondCommandId(true), playerId, <uint>1,
        <uint>1, true
    );
    state.applyCommands(accept, 1);
    if (<bool>state.entityDead[0] || <int>state.entityHp[0] <= 0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -1;
    }
    state.entityDead[0] = true;
    state.entityHp[0] = 0;
    var casterId = state.spawnPlayer(<uint>1, 1, 600.1, 7.0, 0.0, 54, 8.0, 1);
    var casterIndex = state.entityIds.length - 1;
    if (!offerOfflineTemporalReversal(state, casterIndex, 0) ||
        !<bool>state.entityResurrectionOfferPresent[0] ||
        <uint>state.entityResurrectionOfferCasterIds[0] != casterId) {
        return -2;
    }
    var offeredRoundTrip = decodeState(encodeState(state));
    if (!<bool>offeredRoundTrip.entityResurrectionOfferPresent[0] ||
        <uint>offeredRoundTrip.entityResurrectionOfferCasterIds[0] != casterId ||
        <float>offeredRoundTrip.entityResurrectionOfferHpFractions[0] != 0.35 ||
        <float>offeredRoundTrip.entityResurrectionOfferFallbackX[0] != 600.1 ||
        <uint>offeredRoundTrip.entityResurrectionOfferExpiresAtMicros[0] != <uint>30000000) {
        return -3;
    }
    var decline = new CommandBatch();
    appendBooleanCommand(
        decline, payloads.resurrectRespondCommandId(true), playerId, <uint>1,
        <uint>2, false
    );
    state.applyCommands(decline, 1);
    if (!<bool>state.entityDead[0] || <bool>state.entityResurrectionOfferPresent[0] ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -4;
    }
    if (!offerOfflineResurrection(state, casterIndex, 0, 0.35)) {
        return -5;
    }
    // The source chooses the offer-time fallback when the caster has died.
    state.entityDead[casterIndex] = true;
    state.entityX[casterIndex] = 700.0;
    var revive = new CommandBatch();
    appendBooleanCommand(
        revive, payloads.resurrectRespondCommandId(true), playerId, <uint>1,
        <uint>3, true
    );
    state.applyCommands(revive, 1);
    if (<bool>state.entityDead[0] || <bool>state.entityResurrectionOfferPresent[0] ||
        <int>state.entityHp[0] != 19 || <float>state.entityX[0] != 600.1 ||
        <float>state.entityY[0] != 0.0 || <float>state.entityZ[0] != 0.0 ||
        <float>state.entityPreviousX[0] != 600.1 ||
        <float>state.entityPreviousY[0] != 0.0 || <float>state.entityPreviousZ[0] != 0.0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>3) {
        return -6;
    }
    state.entityDead[0] = true;
    state.entityHp[0] = 0;
    state.entityDead[casterIndex] = false;
    if (!offerOfflineResurrection(state, casterIndex, 0, 0.35)) {
        return -7;
    }
    state.entityResurrectionOfferExpiresAtMicros[0] = state.timeMicros;
    clearExpiredResurrectionOffers(state);
    var restored = decodeState(encodeState(state));
    if (<bool>state.entityResurrectionOfferPresent[0] ||
        <bool>restored.entityResurrectionOfferPresent[0] ||
        <uint>restored.entityLastCommandSequence[0] != <uint>3) {
        return -8;
    }
    return 1;
}

pub offlineSpiritLoopCommandStateTest(): int {
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    var playerId = <uint>state.entityIds[0];
    var payloads = %import("protocol/command_payloads");

    state.entityDead[0] = true;
    state.entityHp[0] = 0;
    state.entityX[0] = -15.0;
    state.entityY[0] = 0.0;
    state.entityZ[0] = -14.0;
    var release = new CommandBatch();
    appendEmptyCommand(release, payloads.releaseCommandId(true), playerId, <uint>1, <uint>1);
    state.applyCommands(release, 1);
    if (!<bool>state.entityDead[0] || !<bool>state.entityGhost[0] ||
        !<bool>state.entityCorpsePresent[0] || <float>state.entityCorpseX[0] != -15.0 ||
        <float>state.entityCorpseZ[0] != -14.0 || <float>state.entityX[0] != -14.0 ||
        <float>state.entityZ[0] != -14.0 || <int>state.entityHp[0] != 54 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -1;
    }
    var releasedRoundTrip = decodeState(encodeState(state));
    if (!<bool>releasedRoundTrip.entityGhost[0] ||
        !<bool>releasedRoundTrip.entityCorpsePresent[0] ||
        <float>releasedRoundTrip.entityCorpseX[0] != -15.0 ||
        <float>releasedRoundTrip.entityX[0] != -14.0) {
        return -2;
    }

    var resurrectCorpse = new CommandBatch();
    appendEmptyCommand(
        resurrectCorpse, payloads.resurrectCorpseCommandId(true), playerId, <uint>1, <uint>2
    );
    state.applyCommands(resurrectCorpse, 1);
    if (<bool>state.entityDead[0] || <bool>state.entityGhost[0] ||
        <bool>state.entityCorpsePresent[0] || <int>state.entityHp[0] != 27 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -3;
    }

    state.entityLevels[0] = 10;
    state.entityDead[0] = true;
    state.entityHp[0] = 0;
    state.entityX[0] = -14.0;
    state.entityY[0] = 0.0;
    state.entityZ[0] = -14.0;
    var releaseAgain = new CommandBatch();
    appendEmptyCommand(
        releaseAgain, payloads.releaseCommandId(true), playerId, <uint>1, <uint>3
    );
    state.applyCommands(releaseAgain, 1);
    var resurrectHealer = new CommandBatch();
    appendEmptyCommand(
        resurrectHealer, payloads.resurrectHealerCommandId(true), playerId, <uint>1, <uint>4
    );
    state.applyCommands(resurrectHealer, 1);
    if (<bool>state.entityDead[0] || <bool>state.entityGhost[0] ||
        <bool>state.entityCorpsePresent[0] || <int>state.entityHp[0] != 11 ||
        <uint>state.entityResurrectionSicknessMicros[0] != <uint>60000000 ||
        <uint>state.entityLastCommandSequence[0] != <uint>4) {
        return -4;
    }
    tickResurrectionSickness(state);
    if (<uint>state.entityResurrectionSicknessMicros[0] != <uint>59950000) {
        return -5;
    }
    return 1;
}

