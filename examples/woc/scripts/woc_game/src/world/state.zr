        <uint>payloadBytes[<int>abilityOffset] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>119 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>119 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>100 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>13)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>14)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>15)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>16)] == <uint>100;
}

rejuvenationPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>12 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>106 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>118 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>110;
}

rejuvenationRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 4; }
    if (rank == <uint>2) { return 10; }
    if (rank == <uint>3) { return 16; }
    if (rank == <uint>4) { return 20; }
    return 0;
}

rejuvenationProfileIsValid(rankCode: uint): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("rejuvenation");
    var level = rejuvenationRankLevel(rankCode);
    return abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rankCode &&
        effects.typeAt(abilityIndex, <int>rankCode, 0) == "hot";
}

rejuvenationHotProfileIsValid(heal: int, duration: float, interval: float): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("rejuvenation");
    if (heal < 1 || heal > 65535) { return false; }
    var rank = <uint>1;
    while (rank <= <uint>4) {
        if (rejuvenationProfileIsValid(rank)) {
            var expectedDuration = effects.metric(abilityIndex, <int>rank, 0, "duration");
            var expectedInterval = effects.metric(abilityIndex, <int>rank, 0, "interval");
            var base = <int>(effects.metric(abilityIndex, <int>rank, 0, "total") /
                (expectedDuration / expectedInterval) + 0.5);
            if (base < 1) { base = 1; }
            if (duration == expectedDuration && interval == expectedInterval && heal >= base) {
                return true;
            }
        }
        rank = rank + <uint>1;
    }
    return false;
}

// The WOS60 queue now carries two source-pinned pure HoTs. This lookup remains
// in the state owner because it maps generated ability identity to WOS rows;
// all rank/power arithmetic lives in pure_hot_profile_state.zr.
pureHotAbilityIndex(abilityCode: uint): int {
    if (abilityCode == rejuvenationAbilityCode()) {
        return m4AbilityCatalog.indexOf("rejuvenation");
    }
    if (abilityCode == renewAbilityCode()) {
        return m4AbilityCatalog.indexOf("renew");
    }
    return -1;
}

// Rejuvenation and Lesser Heal share the represented player/owned-pet
// friendliness rule; the M4 range lookup remains ability-specific below.
rejuvenationResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

rejuvenationTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("rejuvenation");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    // The retained outdoor subset has no friendly-cast line-of-sight blocker.
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

powerWordShieldTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("power_word_shield");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

rejuvenationGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineRejuvenationCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = rejuvenationAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("rejuvenation");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = rejuvenationResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || !rejuvenationProfileIsValid(<uint>rank) ||
        <int>state.entityResources[casterIndex] < cost || resolvedTargetIndex < 0 ||
        rejuvenationTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var profile = pureHotProfiles.resolvePureHotProfile(
        abilityIndex, rank, <int>state.entitySpellPower[casterIndex]
    );
    if (!profile.valid) {
        throw "woc Rejuvenation hot profile is invalid";
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rejuvenationGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;
    applyOfflinePureHot(
        state,
        <uint>state.entityIds[resolvedTargetIndex],
        <uint>state.entityIds[casterIndex],
        abilityCode,
        rank,
        profile.snapshotPower
    );
}

renewGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineRenewCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = renewAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("renew");
