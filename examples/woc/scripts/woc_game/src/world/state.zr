// Power Word Shield is an instant friendly aura. The test keeps its source
// order observable: a different source is newest and must absorb first.
pub powerWordShieldCommandStateTest(): int {
    if (absorbProfiles.contractTest() != 1) { return -1; }
    var shield = powerWordShieldAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("power_word_shield");
    if (shield == <uint>0 || abilityIndex != 26 ||
        m4AbilityCatalog.text(abilityIndex, "class") != "priest" ||
        m4AbilityCatalog.text(abilityIndex, "targetType") != "friendly") {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>5;
    var casterId = state.spawnPlayer(<uint>5, 8, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnPlayer(<uint>5, 1, 0.0, 1.5, 10.0, 100, 7.0, 1);
    state.entityResources[0] = 100;
    state.entityMaxResources[0] = 100;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(shield);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, casterId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (<int>state.entityResources[0] != 55 || <uint>state.rngDraws != <uint>0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, shield) != <uint>6000000 ||
        state.offlineAbsorbTargetIds.length != 1 ||
        <uint>state.offlineAbsorbTargetIds[0] != targetId ||
        <uint>state.offlineAbsorbSourceIds[0] != casterId ||
        <uint>state.offlineAbsorbAbilityCodes[0] != shield ||
        <uint>state.offlineAbsorbRanks[0] != <uint>1 ||
        <int>state.offlineAbsorbAmounts[0] != 48 ||
        !floatMatches(<float>state.offlineAbsorbRemaining[0], 30.0)) {
        return -3;
    }

    var restored = decodeState(encodeState(state));
    if (restored.offlineAbsorbTargetIds.length != 1 ||
        <uint>restored.offlineAbsorbAbilityCodes[0] != shield ||
        <int>restored.offlineAbsorbAmounts[0] != 48 ||
        !floatMatches(<float>restored.offlineAbsorbRemaining[0], 30.0)) {
        return -4;
    }
    restored.entityCastGcdRemaining[0] = 0.0;
    startOfflinePowerWordShieldCast(restored, 0, targetId);
    if (<int>restored.entityResources[0] != 55 || restored.offlineAbsorbTargetIds.length != 1) {
        return -5;
    }

    restored.timeMicros = <uint>6000000;
    restored.entityResources[0] = 100;
    startOfflinePowerWordShieldCast(restored, 0, targetId);
    if (<int>restored.entityResources[0] != 55 || restored.offlineAbsorbTargetIds.length != 1 ||
        <int>restored.offlineAbsorbAmounts[0] != 48 ||
        !floatMatches(<float>restored.offlineAbsorbRemaining[0], 30.0)) {
        return -6;
    }

    applyOfflinePowerWordShield(restored, targetId, <uint>777, shield, 1);
    ageOfflineAbsorbs(restored);
    if (restored.offlineAbsorbTargetIds.length != 2 ||
        !floatMatches(<float>restored.offlineAbsorbRemaining[0], 29.95) ||
        !floatMatches(<float>restored.offlineAbsorbRemaining[1], 29.95) ||
        applyOfflineAbsorbDamage(restored, 1, 60) != 0 ||
        restored.offlineAbsorbTargetIds.length != 1 ||
        <uint>restored.offlineAbsorbSourceIds[0] != casterId ||
        <int>restored.offlineAbsorbAmounts[0] != 36 ||
        applyOfflineAbsorbDamage(restored, 1, 48) != 12 ||
        restored.offlineAbsorbTargetIds.length != 0) {
        return -7;
    }

    restored.timeMicros = <uint>12000000;
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 100;
    var shieldBytes = new container.Array<uint>();
    shieldBytes.add(<uint>112); shieldBytes.add(<uint>111); shieldBytes.add(<uint>119);
    shieldBytes.add(<uint>101); shieldBytes.add(<uint>114); shieldBytes.add(<uint>95);
    shieldBytes.add(<uint>119); shieldBytes.add(<uint>111); shieldBytes.add(<uint>114);
    shieldBytes.add(<uint>100); shieldBytes.add(<uint>95); shieldBytes.add(<uint>115);
    shieldBytes.add(<uint>104); shieldBytes.add(<uint>105); shieldBytes.add(<uint>101);
    shieldBytes.add(<uint>108); shieldBytes.add(<uint>100);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, casterId, <uint>1, <uint>2, shieldBytes, targetId
    );
