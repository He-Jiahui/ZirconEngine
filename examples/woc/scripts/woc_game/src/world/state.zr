rejuvenationRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 4; }
    if (rank == <uint>2) { return 10; }
    if (rank == <uint>3) { return 16; }
    if (rank == <uint>4) { return 20; }
    return 0;
}

rejuvenationProfileIsValid(rankCode: uint): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("rejuvenation");
    var level = rejuvenationRankLevel(rankCode);
    return abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rankCode &&
        effects.typeAt(abilityIndex, <int>rankCode, 0) == "hot";
}

rejuvenationHotProfileIsValid(heal: int, duration: float, interval: float): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("rejuvenation");
    if (heal < 1 || heal > 65535) { return false; }
    var rank = <uint>1;
    while (rank <= <uint>4) {
        if (rejuvenationProfileIsValid(rank)) {
            var expectedDuration = effects.metric(abilityIndex, <int>rank, 0, "duration");
            var expectedInterval = effects.metric(abilityIndex, <int>rank, 0, "interval");
            var base = <int>(effects.metric(abilityIndex, <int>rank, 0, "total") /
                (expectedDuration / expectedInterval) + 0.5);
            if (base < 1) { base = 1; }
            if (duration == expectedDuration && interval == expectedInterval && heal >= base) {
                return true;
            }
        }
        rank = rank + <uint>1;
    }
    return false;
}

// The WOS60 queue now carries two source-pinned pure HoTs. This lookup remains
// in the state owner because it maps generated ability identity to WOS rows;
// all rank/power arithmetic lives in pure_hot_profile_state.zr.
pureHotAbilityIndex(abilityCode: uint): int {
    if (abilityCode == rejuvenationAbilityCode()) {
        return m4AbilityCatalog.indexOf("rejuvenation");
    }
    if (abilityCode == renewAbilityCode()) {
        return m4AbilityCatalog.indexOf("renew");
    }
    return -1;
}

// Rejuvenation and Lesser Heal share the represented player/owned-pet
// friendliness rule; the M4 range lookup remains ability-specific below.
rejuvenationResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

rejuvenationTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("rejuvenation");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    // The retained outdoor subset has no friendly-cast line-of-sight blocker.
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

powerWordShieldTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("power_word_shield");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

temporalBarrierTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_barrier");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

temporalBarrierProfileIsValid(abilityIndex: int, rank: int): bool {
    var profile = absorbProfiles.resolveAbsorbProfile(abilityIndex, rank);
    return profile.valid;
}

rejuvenationGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineRejuvenationCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = rejuvenationAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("rejuvenation");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = rejuvenationResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || !rejuvenationProfileIsValid(<uint>rank) ||
        <float>state.entityResources[casterIndex] < cost || resolvedTargetIndex < 0 ||
        rejuvenationTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var profile = pureHotProfiles.resolvePureHotProfile(
        abilityIndex, rank, <int>state.entitySpellPower[casterIndex]
    );
    if (!profile.valid) {
        throw "woc Rejuvenation hot profile is invalid";
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rejuvenationGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    applyOfflinePureHot(
        state,
        <uint>state.entityIds[resolvedTargetIndex],
        <uint>state.entityIds[casterIndex],
        abilityCode,
        rank,
        profile.snapshotPower
    );
}

renewGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineRenewCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = renewAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("renew");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = rejuvenationResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || <float>state.entityResources[casterIndex] < cost ||
        resolvedTargetIndex < 0 || rejuvenationTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var profile = pureHotProfiles.resolvePureHotProfile(
        abilityIndex, rank, <int>state.entitySpellPower[casterIndex]
    );
    if (!profile.valid) { throw "woc Renew hot profile is invalid"; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = renewGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    applyOfflinePureHot(
        state,
        <uint>state.entityIds[resolvedTargetIndex],
        <uint>state.entityIds[casterIndex],
        abilityCode,
        rank,
        profile.snapshotPower
    );
}

// Swiftmend is an instant helpful spell: source resolves it before the generic
// spell-projectile branch, pays cost/cooldown first, then consumes the oldest
// matching hot on the selected friendly target before it rolls the direct heal.
swiftmendAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("swiftmend");
    var abilityIndex = m4AbilityCatalog.indexOf("swiftmend");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "swiftmend") {
        throw "Swiftmend is absent from the current ability catalog";
    }
    return code;
}

swiftmendPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>9 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>119 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>100;
}

swiftmendProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 &&
        m4AbilityCatalog.text(abilityIndex, "id") == "swiftmend" &&
        m4AbilityCatalog.text(abilityIndex, "class") == "druid" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "nature" &&
        m4AbilityCatalog.text(abilityIndex, "targetType") == "friendly" &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == 1 &&
        m4AbilityCatalog.metric(abilityIndex, level, "learnLevel") == 10.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 55.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 8.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 30.0 &&
        m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        effects.count(abilityIndex, 1) == 1 &&
        effects.typeAt(abilityIndex, 1, 0) == "consumeAura" &&
        effects.consumeAuraIdAt(abilityIndex, 1, 0, 0) == "" &&
        effects.text(abilityIndex, 1, 0, "auraKind") == "hot" &&
        effects.metric(abilityIndex, 1, 0, "min") == 105.0 &&
        effects.metric(abilityIndex, 1, 0, "max") == 125.0;
}

swiftmendResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

swiftmendTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("swiftmend");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

swiftmendGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    return renewGlobalCooldownSeconds(state, casterIndex);
}

applyOfflineSwiftmendEffect(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    targetIndex: int,
    abilityIndex: int,
    rank: int
): void {
    var hotIndex = 0;
    while (hotIndex < state.offlineHotTargetIds.length &&
        <uint>state.offlineHotTargetIds[hotIndex] != targetId) {
        hotIndex = hotIndex + 1;
    }
    // The source leaves the cast paid and on cooldown when no matching aura
    // exists, and performs no range or critical draws in that case.
    if (hotIndex >= state.offlineHotTargetIds.length) { return; }
    removeOfflineRejuvenationHotAt(state, hotIndex);
    applyOfflineDirectHeal(state, casterIndex, targetId, targetIndex, abilityIndex, rank);
}

startOfflineSwiftmendCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = swiftmendAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("swiftmend");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = swiftmendResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank != 1 || !swiftmendProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost || resolvedTargetIndex < 0 ||
        swiftmendTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = swiftmendGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0)
    );
    applyOfflineSwiftmendEffect(
        state,
        casterIndex,
        <uint>state.entityIds[resolvedTargetIndex],
        resolvedTargetIndex,
        abilityIndex,
        rank
    );
}

// This is deliberately the bounded retained PWS closure: it maps the generated
// instant friendly spell into the WOS65 aura row, while generic aura behavior
// and unsupported incoming damage sources remain outside this MVP slice.
startOfflinePowerWordShieldCast(
    state: WorldState, casterIndex: int, targetId: uint
): void {
    var abilityCode = powerWordShieldAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("power_word_shield");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = rejuvenationResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || <float>state.entityResources[casterIndex] < cost ||
        resolvedTargetIndex < 0 || powerWordShieldTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var profile = absorbProfiles.resolveAbsorbProfile(abilityIndex, rank);
    if (!profile.valid) { throw "woc Power Word Shield profile is invalid"; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rejuvenationGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(state, casterIndex, abilityCode, state.timeMicros + <uint>6000000);
    applyOfflinePowerWordShield(
        state,
        <uint>state.entityIds[resolvedTargetIndex],
        <uint>state.entityIds[casterIndex],
        abilityCode,
        rank
    );
}

// The source resolves this one instant friendly absorb through the ordinary
// aura dispatcher. Keep all numeric data in the M4 contract and reuse the
// source-keyed retained absorb queue so a same-caster refresh replaces its row.
startOfflineTemporalBarrierCast(
    state: WorldState, casterIndex: int, targetId: uint
): void {
    var abilityCode = temporalBarrierAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("temporal_barrier");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = rejuvenationResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!temporalBarrierProfileIsValid(abilityIndex, rank) ||
        <float>state.entityResources[casterIndex] < cost || resolvedTargetIndex < 0 ||
        temporalBarrierTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var profile = absorbProfiles.resolveAbsorbProfile(abilityIndex, rank);
    var cast = loadCastingState(state, casterIndex);
    var gcd = temporalDirectHealGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(m4AbilityCatalog.metric(abilityIndex, level, "cooldown") *
            1000000.0)
    );
    var amount = resolveOfflineTalentAbsorbAmount(
        state, <uint>state.entityIds[casterIndex], abilityCode, rank, profile.amount
    );
    applyOfflineFixedAbsorb(
        state,
        <uint>state.entityIds[resolvedTargetIndex],
        <uint>state.entityIds[casterIndex],
        abilityCode,
        rank,
        amount,
        profile.duration
    );
    captureOfflineTalentAbsorbState(
        state, <uint>state.entityIds[casterIndex], abilityCode
    );
}

sealOfRighteousnessAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("seal_of_righteousness");
    var abilityIndex = m4AbilityCatalog.indexOf("seal_of_righteousness");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "seal_of_righteousness") {
        throw "Seal of Righteousness is absent from the current ability catalog";
    }
    return code;
}

sealOfRighteousnessPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>21 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>103 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>13)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>14)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>15)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>16)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>17)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>18)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>19)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>20)] == <uint>115;
}

sealOfRighteousnessRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 1; }
    if (rank == <uint>2) { return 10; }
    if (rank == <uint>3) { return 16; }
    return 0;
}

sealOfRighteousnessProfileIsValid(rank: uint): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("seal_of_righteousness");
    var level = sealOfRighteousnessRankLevel(rank);
    return abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rank &&
        effects.typeAt(abilityIndex, <int>rank, 0) == "imbue" &&
        effects.metric(abilityIndex, <int>rank, 0, "duration") == 30.0;
}

sealOfRighteousnessDuration(rank: uint): float {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("seal_of_righteousness");
    if (!sealOfRighteousnessProfileIsValid(rank)) {
        throw "woc Seal of Righteousness profile is invalid";
    }
    return effects.metric(abilityIndex, <int>rank, 0, "duration");
}

