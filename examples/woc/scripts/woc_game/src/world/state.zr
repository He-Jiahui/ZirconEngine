pub queuedOnSwingCommandStateTest(): int {
    var raptor = <uint>knownAbilityCatalog.abilityCode("raptor_strike");
    var raptorIndex = queuedOnSwingM4AbilityIndex(raptor);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (raptor == <uint>0 || raptorIndex < 0 || forestWolf == <uint>0) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>4;
    var playerId = state.spawnPlayer(<uint>5, 20, 0.0, 1.5, 4.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 0.0, 100, 8.0);
    state.entityResources[0] = 45;
    state.entityMaxResources[0] = 45;
    state.entityWeaponMinimum[0] = 10;
    state.entityWeaponMaximum[0] = 10;
    state.entityWeaponSpeed[0] = 2.0;
    state.entityAttackPower[0] = 0;
    state.entityCritChance[0] = 0.0;
    state.entityArmor[1] = 0;
    state.entityFacing[0] = 3.141592653589793;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(raptor);
    state.entityKnownAbilityOffsets[1] = <uint>1;
    state.entityKnownAbilityOffsets[2] = <uint>1;

    var armed = new CommandBatch();
    appendCastSlotCommand(armed, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(armed, 1);
    if (<uint>state.entityQueuedOnSwingAbilityCodes[0] != raptor ||
        <bool>state.entityQueuedOnSwingFree[0] ||
        <float>state.entityQueuedOnSwingCostMultipliers[0] != 1.0 ||
        !<bool>state.entityAutoAttack[0] || <float>state.entityResources[0] != 45) {
        return -2;
    }
    var restored = decodeState(encodeState(state));
    if (<uint>restored.entityQueuedOnSwingAbilityCodes[0] != raptor ||
        <float>restored.entityQueuedOnSwingCostMultipliers[0] != 1.0) {
        return -3;
    }
    var raptorBytes = new container.Array<uint>();
    raptorBytes.add(<uint>114);
    raptorBytes.add(<uint>97);
    raptorBytes.add(<uint>112);
    raptorBytes.add(<uint>116);
    raptorBytes.add(<uint>111);
    raptorBytes.add(<uint>114);
    raptorBytes.add(<uint>95);
    raptorBytes.add(<uint>115);
    raptorBytes.add(<uint>116);
    raptorBytes.add(<uint>114);
    raptorBytes.add(<uint>105);
    raptorBytes.add(<uint>107);
    raptorBytes.add(<uint>101);
    var toggled = new CommandBatch();
    appendTypedCastCommandForTest(toggled, playerId, <uint>1, <uint>2, raptorBytes);
    restored.applyCommands(toggled, 1);
    if (<uint>restored.entityQueuedOnSwingAbilityCodes[0] != <uint>0 ||
        <bool>restored.entityQueuedOnSwingFree[0] ||
        <float>restored.entityQueuedOnSwingCostMultipliers[0] != 1.0) {
        return -4;
    }
    var rearmed = new CommandBatch();
    appendCastSlotCommand(rearmed, playerId, <uint>1, <uint>3, <uint>0);
    restored.applyCommands(rearmed, 1);
    stepOfflineDirectMeleeAutoAttack(restored);
    if (<uint>restored.entityQueuedOnSwingAbilityCodes[0] != <uint>0 ||
        <bool>restored.entityQueuedOnSwingFree[0] ||
        <float>restored.entityQueuedOnSwingCostMultipliers[0] != 1.0 ||
        <int>restored.entityResources[0] != 0 ||
        abilityCooldownExpiresAt(restored, 0, raptor) != <uint>6000000 ||
        <float>restored.entitySwingTimer[0] != 2.0 ||
        <uint>restored.entityLastCommandSequence[0] != <uint>3) {
        return -5;
    }
    return 1;
}

// Maul is the retained Bear-only queued melee special: source form admission
// happens when it is queued, while cost, rank bonus and threat wait for the swing.
pub maulCommandStateTest(): int {
    var maul = <uint>knownAbilityCatalog.abilityCode("maul");
    var maulIndex = m4AbilityCatalog.indexOf("maul");
    var bear = forms.formAbilityCode("form_bear");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (maul == <uint>0 || maulIndex < 0 || bear == <uint>0 ||
        forestWolf == <uint>0 || m4AbilityCatalog.rankAtLevel(maulIndex, 16) != 2 ||
        m4AbilityCatalog.metric(maulIndex, 16, "cost") != 15.0 ||
        m4AbilityCatalog.metric(maulIndex, 16, "threatFlat") != 50.0) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>8;
    var playerId = state.spawnPlayer(<uint>5, 16, 0.0, 1.5, 4.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 0.0, 100, 8.0);
    state.entityActiveFormAbilityCodes[0] = bear;
    state.entityResourceKinds[0] = formTransitions.rageResourceKind();
    state.entityResources[0] = 15;
