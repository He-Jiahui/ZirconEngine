pub resourcePrecisionWorldStateTest(): int {
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (forestWolf == <uint>0) { return -1; }

    var legacy = new WorldState();
    legacy.spawnPlayer(<uint>1, 8, 0.0, 1.5, 0.0, 100, 7.0, 1);
    legacy.entityResources[0] = 10;
    legacy.entityMaxResources[0] = 100;
    if (!resourcePrecisionStateIsSchema112Compatible(legacy)) { return -2; }
    if (!resourcePrecisionStateCanEncodeVersion(legacy, <uint>112)) { return -3; }
    var migrated = decodeState(encodeStateVersion(legacy, <uint>112));
    if (!floatMatches(<float>migrated.entityResources[0], 10.0) ||
        !floatMatches(<float>migrated.entityMaxResources[0], 100.0)) {
        return -4;
    }

    var fractional = new WorldState();
    fractional.spawnPlayer(<uint>1, 8, 0.0, 1.5, 0.0, 100, 7.0, 1);
    fractional.entityResources[0] = 11.5;
    fractional.entityMaxResources[0] = 100.0;
    fractional.entitySavedMana[0] = 41.5;
    fractional.entitySavedManaMaximums[0] = 100.0;
    if (resourcePrecisionStateIsSchema112Compatible(fractional)) { return -5; }
    if (resourcePrecisionStateCanEncodeVersion(fractional, <uint>112) ||
        !resourcePrecisionStateCanEncodeVersion(fractional, <uint>113)) {
        return -6;
    }
    var autoActor = new autoAttackState.AutoActor();
    autoActor.resource = 11.5;
    commitOfflineAutoActor(fractional, 0, autoActor);
    if (!floatMatches(<float>fractional.entityResources[0], 11.5)) { return -7; }
    var encoded = encodeState(fractional);
    if (<uint>encoded[4] != <uint>114 || <uint>encoded[5] != <uint>0) { return -8; }
    var restored = decodeState(encoded);
    return floatMatches(<float>restored.entityResources[0], 11.5) &&
        floatMatches(<float>restored.entityMaxResources[0], 100.0) &&
        floatMatches(<float>restored.entitySavedMana[0], 41.5) &&
        floatMatches(<float>restored.entitySavedManaMaximums[0], 100.0) ? 1 : -9;
}

