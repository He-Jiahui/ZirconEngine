    // WOS15 retains the portions of a resolved ability that cast lifecycle
    // alone cannot represent: the resource pool, a timed cast's locked target,
    // and per-ability cooldown expirations. Entries are canonical by ability
    // code so the flattened map is deterministic across snapshot round trips.
    pub var entityResources: container.Array<int>;
    pub var entityMaxResources: container.Array<int>;
    pub var entityCastTargetIds: container.Array<uint>;
