pub lootRollCommandStateTest(): int {
    if (lootRollRuntime.contractTest() != 1) { return -1; }
    var state = new WorldState();
    var leader = state.spawnPlayer(<uint>1, 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var member = state.spawnPlayer(<uint>1, 10, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var mobId = state.spawnMob(forestWolf, 10, 2.0, 1.5, 0.0, 100, 8.0);
    if (leader == <uint>0 || member == <uint>0 || mobId == <uint>0) { return -2; }
    var payloads = %import("protocol/command_payloads");
    var formation = new CommandBatch();
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>1, member
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), member, <uint>1, <uint>1
    );
    state.applyCommands(formation, 1);
    var mobIndex = 2;
    var itemCode = m5InventoryRules.itemCodeForId("greyjaw_hide_boots");
    var sharedIndex = corpseSharedLootSlotIndex(mobIndex, 0);
    state.entityDead[mobIndex] = true;
    state.entityLootable[mobIndex] = true;
    state.entityTappedByIds[mobIndex] = leader;
    state.entityCorpseMicros[mobIndex] = <uint>60000000;
    state.entityCorpseSharedItemCodes[sharedIndex] = itemCode;
    state.entityCorpseSharedItemCounts[sharedIndex] = <uint>1;
    var loot = new CommandBatch();
    appendPartyTargetCommand(
        loot, payloads.lootCommandId(true), leader, <uint>1, <uint>2, mobId
    );
    state.applyCommands(loot, 1);
    if (state.pendingLootRollIds.length != 1 || state.nextLootRollId != <uint>2 ||
        state.lootRollCandidateRollIds.length != 2 ||
        <uint>state.entityCorpseSharedItemCodes[sharedIndex] != <uint>0 ||
        !<bool>state.entityLootable[mobIndex]) { return -3; }

    var restored = decodeState(encodeState(state));
    var greed = new CommandBatch();
    appendLootRollCommandForTest(
        greed, leader, <uint>1, <uint>3, <uint>1, <uint>1
    );
    restored.applyCommands(greed, 1);
    if (restored.pendingLootRollIds.length != 1 ||
        <uint>restored.lootRollCandidateChoiceCodes[0] != lootRollRuntime.greedChoice() ||
        <uint>restored.lootRollCandidateValues[0] < <uint>1) { return -4; }
    var need = new CommandBatch();
    appendLootRollCommandForTest(
        need, member, <uint>1, <uint>2, <uint>1, <uint>0
    );
    restored.applyCommands(need, 1);
    if (restored.pendingLootRollIds.length != 0 ||
        m5InventoryItemCount(restored, 1, itemCode) != 1 ||
        m5InventoryItemCount(restored, 0, itemCode) != 0 ||
        <bool>restored.entityLootable[mobIndex]) { return -5; }

    restored.entityCorpseSharedItemCodes[sharedIndex] = itemCode;
    restored.entityCorpseSharedItemCounts[sharedIndex] = <uint>1;
    restored.entityLootable[mobIndex] = true;
    if (!startOfflineNeedGreedRoll(restored, mobIndex, itemCode)) { return -6; }
    restored.entityCorpseSharedItemCodes[sharedIndex] = <uint>0;
    restored.entityCorpseSharedItemCounts[sharedIndex] = <uint>0;
    restored.pendingLootRollExpiresAtMicros[0] = restored.timeMicros;
    updateOfflineLootRolls(restored);
    if (restored.pendingLootRollIds.length != 0 ||
        <uint>restored.entityCorpseSharedItemCodes[sharedIndex] != itemCode ||
        !<bool>restored.entityLootable[mobIndex]) { return -7; }

    restored.entityCorpseSharedItemCodes[sharedIndex] = <uint>0;
    restored.entityCorpseSharedItemCounts[sharedIndex] = <uint>0;
    partySetMasterLoot(restored, <uint>1, true, leader, <uint>0);
    if (!startOfflineNeedGreedRoll(restored, mobIndex, itemCode) ||
        <uint>restored.pendingLootRollMasterLooterIds[0] != leader) { return -8; }
    restored.pendingLootRollExpiresAtMicros[0] = restored.timeMicros;
    updateOfflineLootRolls(restored);
    var finalState = decodeState(encodeState(restored));
    return finalState.pendingLootRollIds.length == 1 &&
        <uint>finalState.pendingLootRollMasterLooterIds[0] == <uint>0 &&
        <uint>finalState.pendingLootRollExpiresAtMicros[0] ==
            finalState.timeMicros + <uint>60000000 &&
        <uint>finalState.lootRollCandidateChoiceCodes[0] ==
            lootRollRuntime.pendingChoice() && lootRollStateIsValid(finalState) ? 1 : -9;
}

pub masterLootAssignmentCommandStateTest(): int {
    var state = new WorldState();
    var leader = state.spawnPlayer(<uint>1, 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var member = state.spawnPlayer(<uint>1, 10, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var mobId = state.spawnMob(forestWolf, 10, 2.0, 1.5, 0.0, 100, 8.0);
    if (leader == <uint>0 || member == <uint>0 || mobId == <uint>0) { return -1; }
    var payloads = %import("protocol/command_payloads");
    var formation = new CommandBatch();
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>1, member
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), member, <uint>1, <uint>1
    );
    state.applyCommands(formation, 1);
    partySetMasterLoot(state, <uint>1, true, leader, <uint>0);
    var mobIndex = 2;
    var itemCode = m5InventoryRules.itemCodeForId("greyjaw_hide_boots");
    state.entityDead[mobIndex] = true;
    state.entityTappedByIds[mobIndex] = leader;
    state.entityCorpseMicros[mobIndex] = <uint>300000000;
    if (!startOfflineNeedGreedRoll(state, mobIndex, itemCode)) { return -2; }

    var memberOnly = new container.Array<uint>();
    memberOnly.add(member);
    var rejected = new CommandBatch();
    appendMasterLootAssignmentCommandForTest(
        rejected, member, <uint>1, <uint>2, <uint>1, memberOnly
    );
    state.applyCommands(rejected, 1);
    if (state.pendingLootRollIds.length != 1 ||
        <uint>state.pendingLootRollMasterLooterIds[0] != leader) { return -3; }

    var emptyTargets = new container.Array<uint>();
    var empty = new CommandBatch();
    appendMasterLootAssignmentCommandForTest(
        empty, leader, <uint>1, <uint>2, <uint>1, emptyTargets
    );
    state.applyCommands(empty, 1);
    if (state.pendingLootRollIds.length != 1 ||
        <uint>state.pendingLootRollMasterLooterIds[0] != leader) { return -4; }

    var direct = new CommandBatch();
    appendMasterLootAssignmentCommandForTest(
        direct, leader, <uint>1, <uint>3, <uint>1, memberOnly
    );
    state.applyCommands(direct, 1);
    if (state.pendingLootRollIds.length != 0 ||
        m5InventoryItemCount(state, 1, itemCode) != 1) { return -5; }

    state.entityLootable[mobIndex] = true;
    state.entityCorpseMicros[mobIndex] = <uint>300000000;
    if (!startOfflineNeedGreedRoll(state, mobIndex, itemCode)) { return -6; }
    var both = new container.Array<uint>();
    both.add(leader);
    both.add(member);
    var subset = new CommandBatch();
    appendMasterLootAssignmentCommandForTest(
        subset, leader, <uint>1, <uint>4, <uint>2, both
    );
    state.applyCommands(subset, 1);
    var restored = decodeState(encodeState(state));
    return restored.pendingLootRollIds.length == 1 &&
        <uint>restored.pendingLootRollMasterLooterIds[0] == <uint>0 &&
        <uint>restored.pendingLootRollExpiresAtMicros[0] ==
            restored.timeMicros + <uint>60000000 &&
        lootRollCandidateCount(restored, <uint>2) == 2 &&
        lootRollStateIsValid(restored) ? 1 : -7;
}

pub partyLootDistributionStateTest(): int {
    var state = new WorldState();
    var leader = state.spawnPlayer(<uint>1, 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var member = state.spawnPlayer(<uint>1, 10, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var mobId = state.spawnMob(forestWolf, 10, 2.0, 1.5, 0.0, 100, 8.0);
    if (leader == <uint>0 || member == <uint>0 || mobId == <uint>0) { return -1; }
    var payloads = %import("protocol/command_payloads");
    var formation = new CommandBatch();
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>1, member
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), member, <uint>1, <uint>1
    );
    state.applyCommands(formation, 1);
    var mobIndex = 2;
    state.entityTappedByIds[mobIndex] = leader;
    state.entityDead[mobIndex] = true;
    state.entityCorpseMicros[mobIndex] = <uint>60000000;
    captureOfflineCorpseLootRecipients(state, mobIndex, 0);
    if (offlineCorpseLootCandidateIds(state, mobIndex).length != 2) { return -2; }

    // Eligibility is frozen at death; later range changes cannot rewrite it.
    state.entityX[1] = 1000.0;
    if (offlineCorpseLootCandidateIds(state, mobIndex).length != 2) { return -3; }
    var drawsBefore = state.rngDraws;
    if (!tryAwardOfflineCopperByFairSplit(state, mobIndex, 7) ||
        state.rngDraws != drawsBefore + <uint>1 ||
        <int>state.entityInventoryCopper[0] +
            <int>state.entityInventoryCopper[1] != 7 ||
        <int>state.entityInventoryCopper[0] < 3 ||
        <int>state.entityInventoryCopper[1] < 3) {
        return -4;
    }

    var commonItemCode = m5InventoryRules.itemCodeForId("wolf_fang");
    if (commonItemCode == <uint>0 || offlineLootItemQualityCode(commonItemCode) > <uint>1 ||
        !tryAwardOfflineItemByRoundRobin(state, mobIndex, commonItemCode) ||
        !tryAwardOfflineItemByRoundRobin(state, mobIndex, commonItemCode) ||
        m5InventoryItemCount(state, 0, commonItemCode) != 1 ||
        m5InventoryItemCount(state, 1, commonItemCode) != 1 ||
        partyLootTurn(state, <uint>1) != <uint>2) {
        return -5;
    }

    var premiumItemCode = m5InventoryRules.itemCodeForId("greyjaw_hide_boots");
    if (!startOfflineNeedGreedRoll(state, mobIndex, premiumItemCode) ||
        lootRollCandidateCount(state, <uint>1) != 2) {
        return -6;
    }
    var restored = decodeState(encodeState(state));
    return offlineCorpseLootCandidateIds(restored, mobIndex).length == 2 &&
        partyLootTurn(restored, <uint>1) == <uint>2 &&
        lootRollCandidateCount(restored, <uint>1) == 2 &&
        partyLootDistributionStateIsValid(restored) ? 1 : -7;
}

pub linkedQuestAcceptanceStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    var receiver = state.spawnPlayer(<uint>1, 10, 1000.0, 1.5, 1000.0, 100, 7.0, 1);
    var sharer = state.spawnPlayer(<uint>1, 10, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var outsider = state.spawnPlayer(<uint>1, 10, 2.0, 1.5, 0.0, 100, 7.0, 1);
    if (receiver == <uint>0 || sharer == <uint>0 || outsider == <uint>0) { return -1; }
    var payloads = %import("protocol/command_payloads");
    var formation = new CommandBatch();
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), receiver, <uint>1, <uint>1, sharer
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), sharer, <uint>1, <uint>1
    );
    state.applyCommands(formation, 1);

    var accepted = new CommandBatch();
    appendLinkedQuestAcceptCommandForTest(
        accepted, receiver, <uint>1, <uint>2, 1, sharer
    );
    state.applyCommands(accepted, 1);
    if (offlineQuestStateFor(state, 1) != <uint>1 ||
        offlineQuestObjectiveCount(state, 1) != <uint>0) {
        return -2;
    }

    setOfflineQuestObjectiveCount(state, 1, <uint>3);
    var duplicate = new CommandBatch();
    appendLinkedQuestAcceptCommandForTest(
        duplicate, receiver, <uint>1, <uint>3, 1, sharer
    );
    state.applyCommands(duplicate, 1);
    if (offlineQuestStateFor(state, 1) != <uint>1 ||
        offlineQuestObjectiveCount(state, 1) != <uint>3) {
        return -3;
    }

    setOfflineQuestState(state, 1, <uint>0);
    setOfflineQuestObjectiveCount(state, 1, <uint>0);
    var foreign = new CommandBatch();
    appendLinkedQuestAcceptCommandForTest(
        foreign, receiver, <uint>1, <uint>4, 1, outsider
    );
    state.applyCommands(foreign, 1);
    return offlineQuestStateFor(state, 1) == <uint>0 &&
        <uint>state.entityLastCommandSequence[0] == <uint>4 ? 1 : -4;
}

pub equipmentCommandStateTest(): int {
    var state = new WorldState();
    var player = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    setM5BaselineStatProfile(state, 0, 0);
    var staffCode = m5InventoryItemCodeForId("gnarled_staff");
    var startingSwordCode = m5Equipment.startingMainhandStoredCode(0);
    grantM5InventoryItem(state, 0, staffCode, 1);

    var wrongSlot = new CommandBatch();
    appendEquipItemCommandForTest(
        wrongSlot, player, <uint>1, <uint>1, staffCode, <uint>3
    );
    state.applyCommands(wrongSlot, 1);
    if (m5InventoryItemCount(state, 0, staffCode) != 1 ||
        <uint>state.entityM5MainhandItemCodes[0] != <uint>0) {
        return -1;
    }

    var automatic = new CommandBatch();
    appendEquipItemCommandForTest(
        automatic, player, <uint>1, <uint>2, staffCode, <uint>0
    );
    state.applyCommands(automatic, 1);
    if (m5InventoryItemCount(state, 0, staffCode) != 0 ||
        m5InventoryItemCount(state, 0, startingSwordCode) != 1 ||
        <uint>state.entityM5MainhandItemCodes[0] != staffCode) {
        return -2;
    }

    var unsupportedSlot = new CommandBatch();
    appendUnequipItemCommandForTest(
        unsupportedSlot, player, <uint>1, <uint>3, <uint>4
    );
    state.applyCommands(unsupportedSlot, 1);
    if (<uint>state.entityM5MainhandItemCodes[0] != staffCode ||
        m5InventoryItemCount(state, 0, staffCode) != 0) {
        return -3;
    }

    var unequip = new CommandBatch();
    appendUnequipItemCommandForTest(
        unequip, player, <uint>1, <uint>4, <uint>1
    );
    state.applyCommands(unequip, 1);
    var restored = decodeState(encodeState(state));
    return <uint>restored.entityM5MainhandItemCodes[0] ==
            m5Equipment.emptyMainhandStoredCode() &&
        m5InventoryItemCount(restored, 0, staffCode) == 1 &&
        m5InventoryItemCount(restored, 0, startingSwordCode) == 1 &&
        <uint>restored.entityLastCommandSequence[0] == <uint>4 &&
        baselineStatProfileMatchesDerivedColumns(restored, 0) ? 1 : -4;
}

pub telemetryNoopStateTest(): int {
    var state = new WorldState();
    var player = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    setM5BaselineStatProfile(state, 0, 0);
    var before = encodeState(state);

    var telemetry = new CommandBatch();
    appendTelemetryCommandForTest(telemetry, player, <uint>1, <uint>1);
    state.applyCommands(telemetry, 1);
    var after = encodeState(state);
    if (!<bool>state.entityCommandSequenceInitialized[0] ||
        <uint>state.entityLastCommandSequence[0] != <uint>1 ||
        after.length != before.length) {
        return -1;
    }

    state.entityCommandSequenceInitialized[0] = false;
    state.entityLastCommandSequence[0] = <uint>0;
    var normalized = encodeState(state);
    return stateDigest(before, 1) == stateDigest(normalized, 1) ? 1 : -2;
}

pub inventoryMoveCommandStateTest(): int {
    var state = new WorldState();
    var player = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    setM5BaselineStatProfile(state, 0, 0);
    grantM5InventoryItem(state, 0, m5InventoryItemCodeForId("baked_bread"), 1);
    grantM5InventoryItem(state, 0, m5InventoryItemCodeForId("boar_hide"), 1);
    grantM5InventoryItem(state, 0, m5InventoryItemCodeForId("wolf_fang"), 1);
    if (m5InventoryUsedSlots(state, 0) != 3 ||
        state.entityInventoryStackManualSlots.length != 3) {
        return -1;
    }

    var park = new CommandBatch();
    appendInventoryMoveCommandForTest(
        park, player, <uint>1, <uint>1, 0, 5
    );
    state.applyCommands(park, 1);
    if (<int>state.entityInventoryStackManualSlots[0] != 5 ||
        <int>state.entityInventoryStackManualSlots[1] != 1 ||
        <int>state.entityInventoryStackManualSlots[2] != 2 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -2;
    }
    var parked = decodeState(encodeState(state));
    if (<int>parked.entityInventoryStackManualSlots[0] != 5 ||
        <int>parked.entityInventoryStackManualSlots[1] != 1 ||
        <int>parked.entityInventoryStackManualSlots[2] != 2) {
        return -3;
    }

    var swap = new CommandBatch();
    appendInventoryMoveCommandForTest(
        swap, player, <uint>1, <uint>2, 1, 5
    );
    state.applyCommands(swap, 1);
    if (<int>state.entityInventoryStackManualSlots[0] != 1 ||
        <int>state.entityInventoryStackManualSlots[1] != 5 ||
        <int>state.entityInventoryStackManualSlots[2] != 2) {
        return -4;
    }

    var invalid = new CommandBatch();
    appendInventoryMoveCommandForTest(
        invalid, player, <uint>1, <uint>3, 99, 0
    );
    state.applyCommands(invalid, 1);
    var restored = decodeState(encodeState(state));
    return <int>restored.entityInventoryStackManualSlots[0] == 1 &&
        <int>restored.entityInventoryStackManualSlots[1] == 5 &&
        <int>restored.entityInventoryStackManualSlots[2] == 2 &&
        <uint>restored.entityLastCommandSequence[0] == <uint>3 ? 1 : -5;
}

pub emoteCommandStateTest(): int {
    var state = new WorldState();
    var player = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var cheer = new CommandBatch();
    appendEmoteCommandForTest(cheer, player, <uint>1, <uint>1, <uint>4);
    state.applyCommands(cheer, 1);
    if (<uint>state.entityOverheadEmoteCodes[0] != <uint>4 ||
        <uint>state.entityOverheadEmoteUntil[0] != <uint>3200000 ||
        <uint>state.entityOverheadEmoteSequences[0] != <uint>1) {
        return -1;
    }
    var restored = decodeState(encodeState(state));
    if (<uint>restored.entityOverheadEmoteCodes[0] != <uint>4 ||
        <uint>restored.entityOverheadEmoteUntil[0] != <uint>3200000 ||
        <uint>restored.entityOverheadEmoteSequences[0] != <uint>1) {
        return -2;
    }
    restored.timeMicros = <uint>3199999;
    expireOverheadEmotes(restored);
    if (<uint>restored.entityOverheadEmoteCodes[0] != <uint>4) { return -3; }
    restored.timeMicros = <uint>3200000;
    expireOverheadEmotes(restored);
    if (<uint>restored.entityOverheadEmoteCodes[0] != <uint>0 ||
        <uint>restored.entityOverheadEmoteUntil[0] != <uint>0 ||
        <uint>restored.entityOverheadEmoteSequences[0] != <uint>1) {
        return -4;
    }

    // The authoritative source path has no dead gate; only the optimistic client does.
    restored.entityDead[0] = true;
    var wave = new CommandBatch();
    appendEmoteCommandForTest(wave, player, <uint>1, <uint>2, <uint>1);
    restored.applyCommands(wave, 1);
    var deadRoundTrip = decodeState(encodeState(restored));
    return <uint>deadRoundTrip.entityOverheadEmoteCodes[0] == <uint>1 &&
        <uint>deadRoundTrip.entityOverheadEmoteUntil[0] == <uint>6400000 &&
        <uint>deadRoundTrip.entityOverheadEmoteSequences[0] == <uint>2 &&
        <uint>deadRoundTrip.entityLastCommandSequence[0] == <uint>2 ? 1 : -5;
}

appendMovementFrame(
    input: binary.TickInput,
    actorId: uint,
    generation: uint,
    sequence: uint,
    forward: bool,
    back: bool,
    turnLeft: bool,
    turnRight: bool,
    strafeLeft: bool,
    strafeRight: bool,
    jump: bool,
    hasFacing: bool,
    facing: float
): void {
    input.movementFrameCount = input.movementFrameCount + 1;
    input.movementActorIds.add(actorId);
    input.movementActorGenerations.add(generation);
    input.movementSequences.add(sequence);
    input.movementForward.add(forward);
    input.movementBack.add(back);
    input.movementTurnLeft.add(turnLeft);
    input.movementTurnRight.add(turnRight);
    input.movementStrafeLeft.add(strafeLeft);
    input.movementStrafeRight.add(strafeRight);
    input.movementJump.add(jump);
    input.movementFacingPresent.add(hasFacing);
    input.movementFacing.add(facing);
}

movementDispatchTest(): int {
    var state = new WorldState();
    var playerId = state.spawnPlayer(<uint>1, 13, 0.0, 1.5, 0.0, 1000, 7.0, 1);
    var first = new binary.TickInput();
    appendMovementFrame(first, playerId, <uint>1, <uint>5,
        true, false, false, false, false, false, false, true, 0.0);
    applyMovementFrames(state, first, <uint>1);
    advanceState(state, <uint>1, <uint>0, 1);
    clearStaleMovement(state, state.tick);
    stepRetainedPlayerMovement(state, 0, false, false);
    if (<uint>state.entityMovementAcknowledgements[0] != <uint>5 ||
        <uint>state.entityMovementAcceptedTicks[0] != <uint>1 ||
        !<bool>state.entityMovementForward[0] || state.entityFacing[0] != 0.0 ||
        state.entityPreviousZ[0] != 0.0 || state.entityZ[0] < 0.349999 ||
        state.entityZ[0] > 0.350001) {
        return -1;
    }
    var lowerSequence = new binary.TickInput();
    appendMovementFrame(lowerSequence, playerId, <uint>1, <uint>3,
        false, true, false, false, false, false, false, false, 0.0);
    applyMovementFrames(state, lowerSequence, <uint>2);
    advanceState(state, <uint>2, <uint>0, 1);
    clearStaleMovement(state, state.tick);
    stepRetainedPlayerMovement(state, 0, false, false);
    if (<uint>state.entityMovementAcknowledgements[0] != <uint>5 ||
        <uint>state.entityMovementAcceptedTicks[0] != <uint>2 ||
        <bool>state.entityMovementForward[0] || !<bool>state.entityMovementBack[0] ||
        state.entityFacing[0] != 0.0) {
        return -2;
    }
    state.tick = <uint>18;
    clearStaleMovement(state, state.tick);
    if (<bool>state.entityMovementBack[0] || <bool>state.entityMovementJump[0]) {
        return -3;
    }
    var staleRoundTrip = decodeState(encodeState(state));
    if (<uint>staleRoundTrip.entityMovementAcknowledgements[0] != <uint>5 ||
        <uint>staleRoundTrip.entityMovementAcceptedTicks[0] != <uint>2 ||
        <bool>staleRoundTrip.entityMovementForward[0] ||
        <bool>staleRoundTrip.entityMovementBack[0] ||
        <bool>staleRoundTrip.entityMovementTurnLeft[0] ||
        <bool>staleRoundTrip.entityMovementTurnRight[0] ||
        <bool>staleRoundTrip.entityMovementStrafeLeft[0] ||
        <bool>staleRoundTrip.entityMovementStrafeRight[0] ||
        <bool>staleRoundTrip.entityMovementJump[0]) {
        return -4;
    }
    var jumpState = new WorldState();
    var jumpPlayer = jumpState.spawnPlayer(<uint>1, 13, 0.0, 1.5, 0.0, 1000, 7.0, 1);
    var jump = new binary.TickInput();
    appendMovementFrame(jump, jumpPlayer, <uint>1, <uint>1,
        true, false, false, false, false, false, true, false, 0.0);
    applyMovementFrames(jumpState, jump, <uint>1);
    advanceState(jumpState, <uint>1, <uint>0, 1);
    stepRetainedPlayerMovement(jumpState, 0, false, false);
    if (jumpState.entityY[0] < 1.759999 || jumpState.entityY[0] > 1.760001 ||
        !<bool>jumpState.entityJumping[0] || <bool>jumpState.entityOnGround[0] ||
        jumpState.entityVelocityY[0] < 5.199999 || jumpState.entityVelocityY[0] > 5.200001) {
        return -5;
    }
    return 1;
}

pub commandDispatchTest(): int {
    var payloads = %import("protocol/command_payloads");
    var state = new WorldState();
    var playerId = state.spawnPlayer(<uint>1, 13, 2.0, 1.5, -2.0, 546, 7.0, 1);
    var targetId = state.spawnMob(<uint>2, 4, 4.0, 1.5, -2.0, 60000, 8.5);
    var socialAllyId = state.spawnMob(<uint>2, 4, 7.0, 3.5, -2.0, 60000, 8.5);
    var socialEdgeId = state.spawnMob(<uint>2, 4, 9.0, 1.5, -2.0, 60000, 8.5);
    var otherTemplateId = state.spawnMob(<uint>3, 4, 5.0, 1.5, -2.0, 60000, 8.5);

    var engage = new CommandBatch();
    engage.commandCount = 2;
    engage.commandIds.add(payloads.targetCommandId(true));
    engage.commandIds.add(payloads.attackCommandId(true));
    engage.commandActorIds.add(playerId);
    engage.commandActorIds.add(playerId);
    engage.commandActorGenerations.add(<uint>1);
    engage.commandActorGenerations.add(<uint>1);
    engage.commandSequences.add(<uint>1);
    engage.commandSequences.add(<uint>2);
    engage.commandPayloadOffsets.add(<uint>0);
    engage.commandPayloadOffsets.add(<uint>8);
    engage.commandPayloadLengths.add(<uint>8);
    engage.commandPayloadLengths.add(<uint>0);
    engage.commandPayloadBytes.add(targetId & <uint>255);
    engage.commandPayloadBytes.add((targetId >> 8) & <uint>255);
    engage.commandPayloadBytes.add((targetId >> 16) & <uint>255);
    engage.commandPayloadBytes.add((targetId >> 24) & <uint>255);
    engage.commandPayloadBytes.add((targetId >> 32) & <uint>255);
    engage.commandPayloadBytes.add((targetId >> 40) & <uint>255);
    engage.commandPayloadBytes.add((targetId >> 48) & <uint>255);
    engage.commandPayloadBytes.add((targetId >> 56) & <uint>255);
    state.applyCommands(engage, 1);
    if (<uint>state.entityTargetIds[0] != targetId ||
        !<bool>state.entityAutoAttack[0] ||
        !<bool>state.entityCommandSequenceInitialized[0] ||
        <uint>state.entityLastCommandSequence[0] != <uint>2 ||
        <uint>state.entityAiStates[1] != <uint>2 ||
        <uint>state.entityTargetIds[1] != playerId ||
        <uint>state.entityAggroTargetIds[1] != playerId ||
        !<bool>state.entityInCombat[0] || !<bool>state.entityInCombat[1] ||
        <float>state.entityCombatTimers[0] != 0.0 ||
        !<bool>state.entityLeashAnchorPresent[1] ||
        <float>state.entityLeashAnchorX[1] != 4.0 ||
        <float>state.entityLeashAnchorY[1] != 1.5 ||
        <float>state.entityLeashAnchorZ[1] != -2.0 ||
        <uint>state.entityThreatOffsets[1] != <uint>0 ||
        <uint>state.entityThreatOffsets[2] != <uint>1 ||
        <uint>state.entityThreatTargetIds[0] != playerId ||
        <float>state.entityThreatValues[0] != 2.0 ||
        socialAllyId == <uint>0 || socialEdgeId == <uint>0 || otherTemplateId == <uint>0 ||
        <uint>state.entityAiStates[2] != <uint>2 ||
        <uint>state.entityTargetIds[2] != playerId ||
        <uint>state.entityAggroTargetIds[2] != playerId ||
        !<bool>state.entityInCombat[2] ||
        !<bool>state.entityLeashAnchorPresent[2] ||
        <float>state.entityLeashAnchorX[2] != 7.0 ||
        <float>state.entityLeashAnchorY[2] != 3.5 ||
        <float>state.entityLeashAnchorZ[2] != -2.0 ||
        <uint>state.entityAiStates[3] != <uint>1 ||
        <uint>state.entityAiStates[4] != <uint>1 ||
        <uint>state.entityThreatOffsets[3] != <uint>2 ||
        <uint>state.entityThreatTargetIds[1] != playerId ||
        <float>state.entityThreatValues[1] != 1.0) {
        return -1;
    }

    var stop = new CommandBatch();
    stop.commandCount = 1;
    stop.commandIds.add(payloads.stopAttackCommandId(true));
    stop.commandActorIds.add(playerId);
    stop.commandActorGenerations.add(<uint>1);
    stop.commandSequences.add(<uint>3);
    stop.commandPayloadOffsets.add(<uint>0);
    stop.commandPayloadLengths.add(<uint>0);
    state.applyCommands(stop, 1);
    if (<bool>state.entityAutoAttack[0] ||
        <uint>state.entityLastCommandSequence[0] != <uint>3) {
        return -2;
    }

    var clear = new CommandBatch();
    clear.commandCount = 1;
    clear.commandIds.add(payloads.targetCommandId(true));
    clear.commandActorIds.add(playerId);
    clear.commandActorGenerations.add(<uint>1);
    clear.commandSequences.add(<uint>4);
    clear.commandPayloadOffsets.add(<uint>0);
    clear.commandPayloadLengths.add(<uint>8);
    var clearByte = 0;
    while (clearByte < 8) {
        clear.commandPayloadBytes.add(<uint>0);
        clearByte = clearByte + 1;
    }
    state.applyCommands(clear, 1);
    if (<uint>state.entityTargetIds[0] != <uint>0 ||
        <bool>state.entityAutoAttack[0] ||
        <uint>state.entityLastCommandSequence[0] != <uint>4) {
        return -3;
    }

    var fallenPlayerId = state.spawnPlayer(<uint>1, 13, 3.0, 1.5, -2.0, 546, 7.0, 1);
    var fallenPlayerIndex = state.entityIds.length - 1;
    state.entityDead[fallenPlayerIndex] = true;
    var lootCorpseId = state.spawnMob(<uint>3, 4, 5.0, 1.5, -2.0, 100, 8.5);
    var lootCorpseIndex = state.entityIds.length - 1;
    state.entityDead[lootCorpseIndex] = true;
    state.entityLootable[lootCorpseIndex] = true;
    var ownedPetId = state.spawnMob(<uint>4, 4, 6.0, 1.5, -2.0, 100, 8.5);
    var ownedPetIndex = state.entityIds.length - 1;
    state.entityDead[ownedPetIndex] = true;
    state.entityOwnerIds[ownedPetIndex] = playerId;
    var otherPetId = state.spawnMob(<uint>5, 4, 7.0, 1.5, -2.0, 100, 8.5);
    var otherPetIndex = state.entityIds.length - 1;
    state.entityDead[otherPetIndex] = true;
    state.entityOwnerIds[otherPetIndex] = fallenPlayerId;

    var deadTargets = new CommandBatch();
    appendPartyTargetCommand(
        deadTargets, payloads.targetCommandId(true), playerId, <uint>1, <uint>5, fallenPlayerId
    );
    appendPartyTargetCommand(
        deadTargets, payloads.targetCommandId(true), playerId, <uint>1, <uint>6, lootCorpseId
    );
    appendPartyTargetCommand(
        deadTargets, payloads.targetCommandId(true), playerId, <uint>1, <uint>7, ownedPetId
    );
    appendPartyTargetCommand(
        deadTargets, payloads.targetCommandId(true), playerId, <uint>1, <uint>8, otherPetId
    );
    state.applyCommands(deadTargets, 1);
    if (<uint>state.entityTargetIds[0] != ownedPetId ||
        <bool>state.entityAutoAttack[0] ||
        <uint>state.entityLastCommandSequence[0] != <uint>8) {
        return -4;
    }

    var stow = new CommandBatch();
    appendEmptyCommand(stow, payloads.weaponStowCommandId(true), playerId, <uint>1, <uint>9);
    state.applyCommands(stow, 1);
    if (!<bool>state.entityWeaponStowed[0] ||
        <uint>state.entityLastCommandSequence[0] != <uint>9) {
        return -5;
    }
    state.entityDead[0] = true;
    var deadStow = new CommandBatch();
    appendEmptyCommand(deadStow, payloads.weaponStowCommandId(true), playerId, <uint>1, <uint>10);
    state.applyCommands(deadStow, 1);
    if (!<bool>state.entityWeaponStowed[0] ||
        <uint>state.entityLastCommandSequence[0] != <uint>10) {
        return -6;
    }
    state.entityDead[0] = false;
    var draw = new CommandBatch();
    appendPartyTargetCommand(
        draw, payloads.targetCommandId(true), playerId, <uint>1, <uint>11, targetId
    );
    appendEmptyCommand(draw, payloads.attackCommandId(true), playerId, <uint>1, <uint>12);
    state.applyCommands(draw, 1);
    if (<bool>state.entityWeaponStowed[0] || !<bool>state.entityAutoAttack[0] ||
        <uint>state.entityTargetIds[0] != targetId ||
        <uint>state.entityLastCommandSequence[0] != <uint>12) {
        return -7;
    }

    var travelAttack = new WorldState();
    var travelPlayerId = travelAttack.spawnPlayer(
        <uint>8, 13, 0.0, 1.5, 0.0, 546, 7.0, 1
    );
    var travelTargetId = travelAttack.spawnMob(
        <uint>2, 4, 2.0, 1.5, 0.0, 100, 8.5
    );
    travelAttack.entityTargetIds[0] = travelTargetId;
    travelAttack.entityActiveFormAbilityCodes[0] =
        forms.formAbilityCode("form_travel");
    travelAttack.entitySitting[0] = true;
    travelAttack.entityWeaponStowed[0] = true;
    var travelAttackCommand = new CommandBatch();
    appendEmptyCommand(
        travelAttackCommand,
        payloads.attackCommandId(true),
        travelPlayerId,
        <uint>1,
        <uint>1
    );
    travelAttack.applyCommands(travelAttackCommand, 1);
    if (<bool>travelAttack.entityAutoAttack[0] ||
        !<bool>travelAttack.entitySitting[0] ||
        !<bool>travelAttack.entityWeaponStowed[0] ||
        <uint>travelAttack.entityAiStates[1] != mobLifecycle.idleAiState() ||
        <uint>travelAttack.entityAggroTargetIds[1] != <uint>0 ||
        <uint>travelAttack.entityTargetIds[1] != <uint>0 ||
        <bool>travelAttack.entityInCombat[0] ||
        <bool>travelAttack.entityInCombat[1] ||
        <uint>travelAttack.entityLastCommandSequence[0] != <uint>1) {
        return -9;
    }

    var persisted = encodeState(state);
    var restored = decodeState(persisted);
    if (<uint>persisted[4] != <uint>19 ||
        <uint>restored.entityOwnerIds[ownedPetIndex] != playerId ||
        <uint>restored.entityOwnerIds[otherPetIndex] != fallenPlayerId ||
        !<bool>restored.entityLootable[lootCorpseIndex] ||
        <bool>restored.entityLootable[ownedPetIndex] ||
        <bool>restored.entityWeaponStowed[0]) {
        return -8;
    }
    return 1;
}

// Exercises the source tab-target ordering through the command envelope. The
// WOS relationship projection currently has hostile entities only; arena,
// Vale Cup and friendly-pet relations remain owned by their later state rows.
pub tabTargetCommandStateTest(): int {
    var payloads = %import("protocol/command_payloads");
    var state = new WorldState();
    var playerId = state.spawnPlayer(<uint>1, 13, 0.0, 1.5, 0.0, 546, 7.0, 1);
    var engagedVisibleId = state.spawnMob(<uint>2, 4, 0.0, 1.5, 35.0, 100, 8.5);
    var idleVisibleId = state.spawnMob(<uint>3, 4, 0.0, 1.5, 10.0, 100, 8.5);
    var engagedBehindId = state.spawnMob(<uint>4, 4, 0.0, 1.5, -5.0, 100, 8.5);
    var idleSideId = state.spawnMob(<uint>5, 4, 5.0, 1.5, 0.0, 100, 8.5);
    state.entityTargetIds[1] = playerId;
    state.entityTargetIds[3] = playerId;

    var first = new CommandBatch();
    appendEmptyCommand(first, payloads.tabCommandId(true), playerId, <uint>1, <uint>1);
    state.applyCommands(first, 1);
    if (<uint>state.entityTargetIds[0] != engagedVisibleId) {
        return -1;
    }
    var firstRestored = decodeState(encodeState(state));
    if (<uint>firstRestored.entityTargetIds[0] != engagedVisibleId ||
        <uint>firstRestored.entityLastCommandSequence[0] != <uint>1) {
        return -6;
    }

    var next = new CommandBatch();
    appendEmptyCommand(next, payloads.tabCommandId(true), playerId, <uint>1, <uint>2);
    state.applyCommands(next, 1);
    if (<uint>state.entityTargetIds[0] != idleVisibleId) {
        return -2;
    }

    var wrap = new CommandBatch();
    appendEmptyCommand(wrap, payloads.tabCommandId(true), playerId, <uint>1, <uint>3);
    state.applyCommands(wrap, 1);
    if (<uint>state.entityTargetIds[0] != engagedVisibleId) {
        return -3;
    }

    state.entityTargetIds[0] = engagedBehindId;
    var fallback = new CommandBatch();
    appendEmptyCommand(fallback, payloads.tabCommandId(true), playerId, <uint>1, <uint>4);
    state.applyCommands(fallback, 1);
    if (<uint>state.entityTargetIds[0] != idleSideId) {
        return -4;
    }

    state.entityDead[1] = true;
    state.entityDead[2] = true;
    state.entityDead[3] = true;
    state.entityDead[4] = true;
    state.entityTargetIds[0] = <uint>0;
    var noCandidates = new CommandBatch();
    appendEmptyCommand(noCandidates, payloads.tabCommandId(true), playerId, <uint>1, <uint>5);
    state.applyCommands(noCandidates, 1);
    if (<uint>state.entityTargetIds[0] != <uint>0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>5) {
        return -5;
    }

    state.entityDead[0] = true;
    state.entityDead[3] = false;
    var deadFriendlyCycle = new CommandBatch();
    appendEmptyCommand(
        deadFriendlyCycle, payloads.tabFriendlyCommandId(true), playerId, <uint>1, <uint>6
    );
    state.applyCommands(deadFriendlyCycle, 1);
    if (<uint>state.entityTargetIds[0] != nearestFriendlyId ||
        <uint>state.entityLastCommandSequence[0] != <uint>6) {
        return -6;
    }

    state.entityTargetIds[0] = <uint>0;
    var deadNearestFriendly = new CommandBatch();
    appendEmptyCommand(
        deadNearestFriendly, payloads.targetNearestFriendlyCommandId(true),
        playerId, <uint>1, <uint>7
    );
    state.applyCommands(deadNearestFriendly, 1);
    if (<uint>state.entityTargetIds[0] != nearestFriendlyId ||
        <uint>state.entityLastCommandSequence[0] != <uint>7) {
        return -7;
    }
    return 1;
}

// Exercises the nearest-enemy and friendly target command envelopes through
// the WOS relationship projection. Arena, Vale Cup, ownership and party
// relations are intentionally excluded until their authoritative rows exist.
pub targetingCommandsStateTest(): int {
    var payloads = %import("protocol/command_payloads");
    var state = new WorldState();
    var playerId = state.spawnPlayer(<uint>1, 13, 0.0, 1.5, 0.0, 546, 7.0, 1);
    var nearestEnemyId = state.spawnMob(<uint>2, 4, 10.0, 1.5, 0.0, 100, 8.5);
    state.spawnMob(<uint>3, 4, 40.0, 1.5, 0.0, 100, 8.5);
    var nearestFriendlyId = state.spawnPlayer(<uint>4, 13, 4.0, 1.5, 0.0, 546, 7.0, 1);
    var nextFriendlyId = state.spawnPlayer(<uint>5, 13, 12.0, 1.5, 0.0, 546, 7.0, 1);
    state.spawnPlayer(<uint>6, 13, 41.0, 1.5, 0.0, 546, 7.0, 1);

    var nearestEnemy = new CommandBatch();
    appendEmptyCommand(
        nearestEnemy, payloads.targetNearestCommandId(true), playerId, <uint>1, <uint>1
    );
    state.applyCommands(nearestEnemy, 1);
    if (<uint>state.entityTargetIds[0] != nearestEnemyId ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -1;
    }

    var nearestFriendly = new CommandBatch();
    appendEmptyCommand(
        nearestFriendly, payloads.targetNearestFriendlyCommandId(true), playerId, <uint>1, <uint>2
    );
    state.applyCommands(nearestFriendly, 1);
    if (<uint>state.entityTargetIds[0] != nearestFriendlyId) {
        return -2;
    }

    var nextFriendly = new CommandBatch();
    appendEmptyCommand(
        nextFriendly, payloads.tabFriendlyCommandId(true), playerId, <uint>1, <uint>3
    );
    state.applyCommands(nextFriendly, 1);
    if (<uint>state.entityTargetIds[0] != nextFriendlyId) {
        return -3;
    }

    var wrapFriendly = new CommandBatch();
    appendEmptyCommand(
        wrapFriendly, payloads.tabFriendlyCommandId(true), playerId, <uint>1, <uint>4
    );
    state.applyCommands(wrapFriendly, 1);
    var restored = decodeState(encodeState(state));
    if (<uint>restored.entityTargetIds[0] != nearestFriendlyId ||
        <uint>restored.entityLastCommandSequence[0] != <uint>4) {
        return -4;
    }

    state.entityDead[1] = true;
    state.entityDead[2] = true;
    state.entityDead[3] = true;
    state.entityDead[4] = true;
    state.entityDead[5] = true;
    state.entityTargetIds[0] = <uint>0;
    var noCandidates = new CommandBatch();
    appendEmptyCommand(
        noCandidates, payloads.targetNearestCommandId(true), playerId, <uint>1, <uint>5
    );
    state.applyCommands(noCandidates, 1);
    if (<uint>state.entityTargetIds[0] != <uint>0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>5) {
        return -5;
    }
    return 1;
}

// Exercises the public command envelope, source-equivalent Card Master range,
// fixed-step pairing, retained Card Duel snapshot, and an in-match card value.
pub cardDuelWorldStateTest(): int {
    var payloads = %import("protocol/command_payloads");
    var state = new WorldState();
    var cardMasterIndex = cardMasterStaticNpcIndex();
    var masterX = npcPlacement.finalStaticNpcCoordinate(state.worldSeed, cardMasterIndex, 1, true);
    var masterZ = npcPlacement.finalStaticNpcCoordinate(state.worldSeed, cardMasterIndex, 2, true);
    var playerA = state.spawnPlayer(<uint>1, 1, masterX, 1.5, masterZ, 100, 7.0, 1);
    var playerB = state.spawnPlayer(<uint>1, 1, masterX + 1.0, 1.5, masterZ, 100, 7.0, 1);

    var queue = new CommandBatch();
    appendEmptyCommand(queue, payloads.cardQueueJoinCommandId(true), playerA, <uint>1, <uint>1);
    appendEmptyCommand(queue, payloads.cardQueueJoinCommandId(true), playerB, <uint>1, <uint>1);
    state.applyCommands(queue, 1);
    updateCardDuelService(state);
    var paired = restoreCardDuelService(state);
    // Card Duel must advance the one WOS-authoritative Mulberry32 cursor.
    // Each of the two initial hands performs an exact Fisher-Yates shuffle.
    var rng = %import("kernel/rng");
    var cardContract = %import("generated/card_duel_contract");
    var expectedRng = new rng.Mulberry32(<uint>1);
    var expectedDraws = 0;
    while (expectedDraws < (cardContract.deckSize(true) - 1) * 2) {
        expectedRng.nextU32();
        expectedDraws = expectedDraws + 1;
    }
    if (state.rngState != expectedRng.state || state.rngDraws != expectedRng.draws ||
        state.rngDigest != expectedRng.drawDigest || paired.rng.state != state.rngState ||
        paired.rng.draws != state.rngDraws || paired.rng.drawDigest != state.rngDigest) {
        return -1;
    }
    if (!cardDuelService.inMatch(paired, playerA) || !cardDuelService.inMatch(paired, playerB) ||
        cardDuelService.handCount(paired, playerA) != 4 ||
        cardDuelService.handCount(paired, playerB) != 4) {
        return -2;
    }

    var cardValue = cardDuelService.heldCardAt(paired, playerA, 0);
    if (cardValue == <uint>0) {
        return -3;
    }
    var play = new CommandBatch();
    play.commandCount = 1;
    play.commandIds.add(payloads.cardPlayCommandId(true));
    play.commandActorIds.add(playerA);
    play.commandActorGenerations.add(<uint>1);
    play.commandSequences.add(<uint>2);
    play.commandPayloadOffsets.add(<uint>0);
    play.commandPayloadLengths.add(<uint>4);
    play.commandPayloadBytes.add(cardValue & <uint>255);
    play.commandPayloadBytes.add((cardValue >> 8) & <uint>255);
    play.commandPayloadBytes.add((cardValue >> 16) & <uint>255);
    play.commandPayloadBytes.add((cardValue >> 24) & <uint>255);
    state.applyCommands(play, 1);

    var persisted = encodeState(state);
    if (persisted.length <= 99 || <uint>persisted[4] != <uint>19 ||
        state.cardDuelStateBytes.length == 0) {
        return -4;
    }
    var restored = decodeState(persisted);
    var restoredDuel = restoreCardDuelService(restored);
    if (!cardDuelService.inMatch(restoredDuel, playerA) ||
        !cardDuelService.inMatch(restoredDuel, playerB) ||
        !cardDuelService.waitingOnOpponent(restoredDuel, playerA) ||
        cardDuelService.handCount(restoredDuel, playerA) != 3 ||
        <uint>restored.entityLastCommandSequence[0] != <uint>2 ||
        restored.rngState != state.rngState || restored.rngDraws != state.rngDraws ||
        restored.rngDigest != state.rngDigest || restoredDuel.rng.state != restored.rngState ||
        restoredDuel.rng.draws != restored.rngDraws ||
        restoredDuel.rng.drawDigest != restored.rngDigest) {
        return -5;
    }
    return 1;
}

// WOS14 keeps the current source PartyMachine's mutable state alongside the
// candidate world so social commands participate in the same sequence and
// transaction boundary as combat and movement.
pub partyRaidCommandStateTest(): int {
    var payloads = %import("protocol/command_payloads");
    var state = new WorldState();
    var leader = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var player2 = state.spawnPlayer(<uint>1, 1, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var player3 = state.spawnPlayer(<uint>1, 1, 2.0, 1.5, 0.0, 100, 7.0, 1);
    var player4 = state.spawnPlayer(<uint>1, 1, 3.0, 1.5, 0.0, 100, 7.0, 1);
    var player5 = state.spawnPlayer(<uint>1, 1, 4.0, 1.5, 0.0, 100, 7.0, 1);
    var player6 = state.spawnPlayer(<uint>1, 1, 5.0, 1.5, 0.0, 100, 7.0, 1);

    var formation = new CommandBatch();
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>1, player2
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), player2, <uint>1, <uint>1
    );
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>2, player3
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), player3, <uint>1, <uint>1
    );
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>3, player4
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), player4, <uint>1, <uint>1
    );
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>4, player5
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), player5, <uint>1, <uint>1
    );
    appendEmptyCommand(
        formation, payloads.partyRaidCommandId(true), leader, <uint>1, <uint>5
    );
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>6, player6
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), player6, <uint>1, <uint>1
    );
    appendPartyMoveRaidCommand(
        formation, payloads.partyMoveRaidCommandId(true), leader, <uint>1, <uint>7, player2, <uint>2
    );
    state.applyCommands(formation, 1);
    if (state.nextPartyId != <uint>2 || <uint>state.entityPartyIds[0] != <uint>1 ||
        <uint>state.entityPartyLeaderIds[0] != leader || !<bool>state.entityPartyRaids[0] ||
        <uint>state.entityPartyMemberOrders[0] != <uint>1 ||
        <uint>state.entityPartyMemberOrders[5] != <uint>6 ||
        <uint>state.entityPartyRaidGroups[1] != <uint>2 ||
        <uint>state.entityPartyRaidGroups[5] != <uint>2) {
        return -1;
    }
    var restored = decodeState(encodeState(state));
    if (<uint>restored.entityPartyIds[5] != <uint>1 ||
        <uint>restored.entityPartyLeaderIds[5] != leader ||
        !<bool>restored.entityPartyRaids[5] ||
        <uint>restored.entityPartyRaidGroups[1] != <uint>2) {
        return -2;
    }

    var management = new CommandBatch();
    appendPartyTargetCommand(
        management, payloads.partyPromoteCommandId(true), leader, <uint>1, <uint>8, player2
    );
    appendPartyTargetCommand(
        management, payloads.partyKickCommandId(true), player2, <uint>1, <uint>2, player6
    );
    appendEmptyCommand(
        management, payloads.partyUnraidCommandId(true), player2, <uint>1, <uint>3
    );
    appendEmptyCommand(
        management, payloads.partyLeaveCommandId(true), player2, <uint>1, <uint>4
    );
    restored.applyCommands(management, 1);
    if (<uint>restored.entityPartyIds[5] != <uint>0 ||
        <uint>restored.entityPartyIds[1] != <uint>0 ||
        <uint>restored.entityPartyLeaderIds[0] != leader ||
        <bool>restored.entityPartyRaids[0] ||
        <uint>restored.entityPartyRaidGroups[0] != <uint>0 ||
        <uint>restored.entityPartyMemberOrders[0] != <uint>1) {
        return -3;
    }

    var expiry = new WorldState();
    var expiryLeader = expiry.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var expiryTarget = expiry.spawnPlayer(<uint>1, 1, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var pending = new CommandBatch();
    appendPartyTargetCommand(
        pending, payloads.partyInviteCommandId(true), expiryLeader, <uint>1, <uint>1, expiryTarget
    );
    expiry.applyCommands(pending, 1);
    expiry.timeMicros = <uint>30000000;
    var atExpiry = new CommandBatch();
    appendEmptyCommand(
        atExpiry, payloads.partyAcceptCommandId(true), expiryTarget, <uint>1, <uint>1
    );
    expiry.applyCommands(atExpiry, 1);
    if (<uint>expiry.entityPartyIds[0] != <uint>1 ||
        <uint>expiry.entityPartyIds[1] != <uint>1) {
        return -4;
    }

    var expired = new WorldState();
    var expiredLeader = expired.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var expiredTarget = expired.spawnPlayer(<uint>1, 1, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var stalePending = new CommandBatch();
    appendPartyTargetCommand(
        stalePending, payloads.partyInviteCommandId(true), expiredLeader, <uint>1, <uint>1, expiredTarget
    );
    expired.applyCommands(stalePending, 1);
    expired.timeMicros = <uint>30000001;
    var staleAccept = new CommandBatch();
    appendEmptyCommand(
        staleAccept, payloads.partyAcceptCommandId(true), expiredTarget, <uint>1, <uint>1
    );
    expired.applyCommands(staleAccept, 1);
    if (<uint>expired.entityPartyIds[0] != <uint>0 ||
        <uint>expired.entityPartyIds[1] != <uint>0 ||
        <uint>expired.entityPartyInviteFromIds[1] != expiredLeader) {
        return -5;
    }
    return 1;
}

// Covers the target's personal-preference retention, party-leader mutation
// gate, party-first resolution, and automatic party-field removal on disband.
pub dungeonDifficultyCommandStateTest(): int {
    var state = new WorldState();
    var leader = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var member = state.spawnPlayer(<uint>1, 1, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var payloads = %import("protocol/command_payloads");
    var formation = new CommandBatch();
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>1, member
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), member, <uint>1, <uint>1
    );
    state.applyCommands(formation, 1);
    var nonLeader = new CommandBatch();
    appendDungeonDifficultyCommand(nonLeader, member, <uint>1, <uint>2, <uint>1);
    state.applyCommands(nonLeader, 1);
    if (<bool>state.entityDungeonDifficultyPersonalHeroic[1] ||
        <bool>state.entityPartyDungeonDifficultyHeroic[0] ||
        effectiveDungeonDifficultyForIndex(state, 1) != <uint>0 ||
        <uint>state.entityLastCommandSequence[1] != <uint>2) {
        return -1;
    }
    var selectHeroic = new CommandBatch();
    appendDungeonDifficultyCommand(selectHeroic, leader, <uint>1, <uint>2, <uint>1);
    state.applyCommands(selectHeroic, 1);
    if (!<bool>state.entityDungeonDifficultyPersonalHeroic[0] ||
        !<bool>state.entityPartyDungeonDifficultyHeroic[0] ||
        !<bool>state.entityPartyDungeonDifficultyHeroic[1] ||
        effectiveDungeonDifficultyForIndex(state, 0) != <uint>1 ||
        effectiveDungeonDifficultyForIndex(state, 1) != <uint>1) {
        return -2;
    }
    var restored = decodeState(encodeState(state));
    if (!<bool>restored.entityDungeonDifficultyPersonalHeroic[0] ||
        !<bool>restored.entityPartyDungeonDifficultyHeroic[1] ||
        effectiveDungeonDifficultyForIndex(restored, 1) != <uint>1) {
        return -3;
    }
    var leave = new CommandBatch();
    appendEmptyCommand(leave, payloads.partyLeaveCommandId(true), member, <uint>1, <uint>3);
    restored.applyCommands(leave, 1);
    if (<uint>restored.entityPartyIds[0] != <uint>0 ||
        <uint>restored.entityPartyIds[1] != <uint>0 ||
        <bool>restored.entityPartyDungeonDifficultyHeroic[0] ||
        <bool>restored.entityPartyDungeonDifficultyHeroic[1] ||
        effectiveDungeonDifficultyForIndex(restored, 0) != <uint>1 ||
        effectiveDungeonDifficultyForIndex(restored, 1) != <uint>0) {
        return -4;
    }
    var invalid = new CommandBatch();
    appendDungeonDifficultyCommand(invalid, leader, <uint>1, <uint>3, <uint>2);
    restored.applyCommands(invalid, 1);
    if (effectiveDungeonDifficultyForIndex(restored, 0) != <uint>1 ||
        <uint>restored.entityLastCommandSequence[0] != <uint>3) {
        return -5;
    }
    return 1;
}

pub chatCommandStateTest(): int {
    if (chatWireState.contractTest() != 1) return -1;
    var state = new WorldState();
    var player = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var burst = new CommandBatch();
    var sequence: uint = <uint>1;
    while (sequence <= <uint>8) {
        appendChatCommandForTest(burst, player, <uint>1, sequence, 1);
        sequence = sequence + <uint>1;
    }
    state.applyCommands(burst, 1);
    if (!<bool>state.entityChatTokenBucketPresent[0] ||
        <float>state.entityChatTokenBuckets[0] != 0.0 ||
        <uint>state.entityChatTokenAtMicros[0] != <uint>0) return -2;
    var denied = new CommandBatch();
    appendChatCommandForTest(denied, player, <uint>1, <uint>9, 0);
    state.applyCommands(denied, 1);
    if (<float>state.entityChatTokenBuckets[0] != 0.0 ||
        <uint>state.entityReadyCheckPartyIds[0] != <uint>0) return -3;
    var empty = new CommandBatch();
    appendChatCommandForTest(empty, player, <uint>1, <uint>10, 2);
    state.applyCommands(empty, 1);
    if (<float>state.entityChatTokenBuckets[0] != 0.0) return -4;
    state.timeMicros = <uint>500000;
    var refilled = new CommandBatch();
    appendChatCommandForTest(refilled, player, <uint>1, <uint>11, 1);
    state.applyCommands(refilled, 1);
    if (<float>state.entityChatTokenBuckets[0] != 0.0 ||
        <uint>state.entityChatTokenAtMicros[0] != <uint>500000 ||
        <uint>state.entityLastCommandSequence[0] != <uint>11) return -5;
    var restored = decodeState(encodeState(state));
    return chatTokenStateIsValid(restored, 0) &&
        <bool>restored.entityChatTokenBucketPresent[0] &&
        <float>restored.entityChatTokenBuckets[0] == 0.0 &&
        <uint>restored.entityChatTokenAtMicros[0] == <uint>500000 ? 1 : -6;
}

// WOS158 routes `/ready` through chat admission, then exercises the retained
// start, boolean answer, early completion, member removal and timeout behavior.
pub partyReadyCheckCommandStateTest(): int {
    var state = new WorldState();
    var leader = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var member = state.spawnPlayer(<uint>1, 1, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var pendingMember = state.spawnPlayer(<uint>1, 1, 2.0, 1.5, 0.0, 100, 7.0, 1);
    var payloads = %import("protocol/command_payloads");
    var invite = new CommandBatch();
    appendPartyTargetCommand(
        invite, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>1, member
    );
    state.applyCommands(invite, 1);
    var accept = new CommandBatch();
    appendEmptyCommand(accept, payloads.partyAcceptCommandId(true), member, <uint>1, <uint>1);
    state.applyCommands(accept, 1);
    var secondInvite = new CommandBatch();
    appendPartyTargetCommand(
        secondInvite, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>2,
        pendingMember
    );
    state.applyCommands(secondInvite, 1);
    var secondAccept = new CommandBatch();
    appendEmptyCommand(
        secondAccept, payloads.partyAcceptCommandId(true), pendingMember, <uint>1, <uint>1
    );
    state.applyCommands(secondAccept, 1);
    var readyChat = new CommandBatch();
    appendChatCommandForTest(readyChat, leader, <uint>1, <uint>3, 0);
    state.applyCommands(readyChat, 1);
    if (<uint>state.entityReadyCheckPartyIds[0] != <uint>1 ||
        <uint>state.entityReadyCheckInitiatorIds[1] != leader ||
        <uint>state.entityReadyCheckEndsAtMicros[2] != <uint>30000000 ||
        <uint>state.entityReadyCheckResponses[0] != <uint>1 ||
        <uint>state.entityReadyCheckResponses[1] != <uint>0 ||
        <uint>state.entityReadyCheckResponses[2] != <uint>0 ||
        !<bool>state.entityChatTokenBucketPresent[0] ||
        <float>state.entityChatTokenBuckets[0] != 7.0) {
        return -1;
    }
    var restored = decodeState(encodeState(state));
    if (!partyReadyCheckStateIsValid(restored) ||
        <uint>restored.entityReadyCheckPartyIds[2] != <uint>1 ||
        <float>restored.entityChatTokenBuckets[0] != 7.0) {
        return -2;
    }
    var responses = new CommandBatch();
    appendPartyReadyRespondCommand(responses, member, <uint>1, <uint>2, false);
    restored.applyCommands(responses, 1);
    if (<uint>restored.entityReadyCheckResponses[1] != <uint>2 ||
        <uint>restored.entityReadyCheckPartyIds[0] != <uint>1) {
        return -3;
    }
    var finalResponse = new CommandBatch();
    appendPartyReadyRespondCommand(finalResponse, pendingMember, <uint>1, <uint>2, true);
    restored.applyCommands(finalResponse, 1);
    if (<uint>restored.entityReadyCheckPartyIds[0] != <uint>0 ||
        <uint>restored.entityReadyCheckInitiatorIds[1] != <uint>0 ||
        <uint>restored.entityReadyCheckEndsAtMicros[2] != <uint>0 ||
        <uint>restored.entityReadyCheckResponses[2] != <uint>0) {
        return -4;
    }
    startPartyReadyCheck(restored, 0);
    var answered = new CommandBatch();
    appendPartyReadyRespondCommand(answered, member, <uint>1, <uint>3, true);
    restored.applyCommands(answered, 1);
    partyRemoveMember(restored, 2);
    updatePartyReadyChecks(restored);
    if (<uint>restored.entityPartyIds[2] != <uint>0 ||
        <uint>restored.entityReadyCheckPartyIds[0] != <uint>0 ||
        <uint>restored.entityReadyCheckPartyIds[1] != <uint>0) {
        return -5;
    }
    startPartyReadyCheck(restored, 0);
    restored.timeMicros = <uint>30000000;
    updatePartyReadyChecks(restored);
    if (<uint>restored.entityReadyCheckPartyIds[0] != <uint>0 ||
        <uint>restored.entityReadyCheckPartyIds[1] != <uint>0) {
        return -6;
    }
    return 1;
}

// Current-source social/arena.ts admission projection: source wire formats
// 0..4, party size and leader gates, atomic premade rows, WOS21 round-trip,
// and unit-level leave. Match start remains part of the later PvP lifecycle.
pub arenaQueueCommandStateTest(): int {
    var state = new WorldState();
    var leader = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var member = state.spawnPlayer(<uint>1, 1, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var third = state.spawnPlayer(<uint>1, 1, 2.0, 1.5, 0.0, 100, 7.0, 1);
    state.entityArena2v2Ratings[0] = 1600;
    state.entityArena2v2Ratings[1] = 1400;
    state.entityArena2v2Ratings[2] = 1500;
    var payloads = %import("protocol/command_payloads");
    var formation = new CommandBatch();
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>1, member
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), member, <uint>1, <uint>1
    );
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>2, third
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), third, <uint>1, <uint>1
    );
    state.applyCommands(formation, 1);

    var rejectedOneVOne = new CommandBatch();
    appendArenaQueueCommand(rejectedOneVOne, leader, <uint>1, <uint>3, <uint>0);
    state.applyCommands(rejectedOneVOne, 1);
    if (<uint>state.entityArenaQueueFormats[0] != <uint>0 ||
        <uint>state.entityArenaQueueUnitOrders[0] != <uint>0) {
        return -1;
    }

    var yumi = new CommandBatch();
    appendArenaQueueCommand(yumi, leader, <uint>1, <uint>4, <uint>3);
    state.applyCommands(yumi, 1);
    if (<uint>state.entityArenaQueueFormats[0] != <uint>4 ||
        <uint>state.entityArenaQueueFormats[1] != <uint>4 ||
        <uint>state.entityArenaQueueFormats[2] != <uint>4 ||
        <uint>state.entityArenaQueueUnitOrders[0] != <uint>1 ||
        <uint>state.entityArenaQueueUnitOrders[1] != <uint>1 ||
        <uint>state.entityArenaQueueUnitOrders[2] != <uint>1 ||
        <uint>state.entityArenaQueueMemberOrders[0] != <uint>1 ||
        <uint>state.entityArenaQueueMemberOrders[1] != <uint>2 ||
        <uint>state.entityArenaQueueMemberOrders[2] != <uint>3 ||
        <float>state.entityArenaQueueRatings[0] != 1500.0 ||
        <float>state.entityArenaQueueRatings[2] != 1500.0 ||
        arenaQueuePositionForIndex(state, 0) != 1 ||
        arenaQueuePositionForIndex(state, 2) != 1 ||
        state.nextArenaQueueUnitOrder != <uint>2 || !arenaQueueStateIsValid(state)) {
        return -2;
    }
    var restored = decodeState(encodeState(state));
    if (!arenaQueueStateIsValid(restored) ||
        <uint>restored.entityArenaQueueFormats[2] != <uint>4 ||
        <uint>restored.entityArenaQueueUnitOrders[1] != <uint>1 ||
        <uint>restored.entityArenaQueueMemberOrders[2] != <uint>3 ||
        <float>restored.entityArenaQueueRatings[1] != 1500.0) {
        return -3;
    }

    var leave = new CommandBatch();
    appendEmptyCommand(leave, payloads.arenaLeaveCommandId(true), member, <uint>1, <uint>2);
    restored.applyCommands(leave, 1);
    if (<uint>restored.entityArenaQueueFormats[0] != <uint>0 ||
        <uint>restored.entityArenaQueueFormats[1] != <uint>0 ||
        <uint>restored.entityArenaQueueFormats[2] != <uint>0) {
        return -4;
    }

    partyRemoveMember(restored, 2);
    var pair = new CommandBatch();
    appendArenaQueueCommand(pair, leader, <uint>1, <uint>5, <uint>1);
    restored.applyCommands(pair, 1);
    if (<uint>restored.entityArenaQueueFormats[0] != <uint>2 ||
        <uint>restored.entityArenaQueueFormats[1] != <uint>2 ||
        <uint>restored.entityArenaQueueFormats[2] != <uint>0 ||
        <uint>restored.entityArenaQueueUnitOrders[0] != <uint>2 ||
        <uint>restored.entityArenaQueueUnitOrders[1] != <uint>2 ||
        <uint>restored.entityArenaQueueMemberOrders[0] != <uint>1 ||
        <uint>restored.entityArenaQueueMemberOrders[1] != <uint>2 ||
        <float>restored.entityArenaQueueRatings[0] != 1500.0 ||
        arenaQueuePositionForIndex(restored, 1) != 1 ||
        restored.nextArenaQueueUnitOrder != <uint>3) {
        return -5;
    }
    var finalState = decodeState(encodeState(restored));
    if (!arenaQueueStateIsValid(finalState) ||
        <uint>finalState.entityArenaQueueFormats[0] != <uint>2 ||
        <uint>finalState.entityArenaQueueUnitOrders[1] != <uint>2 ||
        <uint>finalState.entityArenaQueueMemberOrders[1] != <uint>2) {
        return -6;
    }
    return 1;
}

appendChatCommandForTest(
    batch: CommandBatch, actorId: uint, generation: uint, sequence: uint, textKind: int
): void {
    var payloads = %import("protocol/command_payloads");
    var length: uint = textKind == 0 ? <uint>6 : (textKind == 1 ? <uint>1 : <uint>2);
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.chatCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(length + <uint>4);
    batch.commandPayloadBytes.add(length);
    batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>0);
    if (textKind == 0) {
        batch.commandPayloadBytes.add(<uint>47);
        batch.commandPayloadBytes.add(<uint>114);
        batch.commandPayloadBytes.add(<uint>101);
        batch.commandPayloadBytes.add(<uint>97);
        batch.commandPayloadBytes.add(<uint>100);
        batch.commandPayloadBytes.add(<uint>121);
    } else if (textKind == 1) {
        batch.commandPayloadBytes.add(<uint>120);
    } else {
        batch.commandPayloadBytes.add(<uint>32);
        batch.commandPayloadBytes.add(<uint>32);
    }
}

appendPartyReadyRespondCommand(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    ready: bool
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.partyReadyRespondCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>1);
    batch.commandPayloadBytes.add(ready ? <uint>1 : <uint>0);
}

appendArenaQueueCommand(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    wireFormat: uint
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.arenaQueueCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>1);
    batch.commandPayloadBytes.add(wireFormat);
}

appendTemporalReversalCastCommand(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    targetId: uint
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.castCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>30);
    batch.commandPayloadBytes.add(<uint>17);
    batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>116); // t
    batch.commandPayloadBytes.add(<uint>101); // e
    batch.commandPayloadBytes.add(<uint>109); // m
    batch.commandPayloadBytes.add(<uint>112); // p
    batch.commandPayloadBytes.add(<uint>111); // o
    batch.commandPayloadBytes.add(<uint>114); // r
    batch.commandPayloadBytes.add(<uint>97);  // a
    batch.commandPayloadBytes.add(<uint>108); // l
    batch.commandPayloadBytes.add(<uint>95);  // _
    batch.commandPayloadBytes.add(<uint>114); // r
    batch.commandPayloadBytes.add(<uint>101); // e
    batch.commandPayloadBytes.add(<uint>118); // v
    batch.commandPayloadBytes.add(<uint>101); // e
    batch.commandPayloadBytes.add(<uint>114); // r
    batch.commandPayloadBytes.add(<uint>115); // s
    batch.commandPayloadBytes.add(<uint>97);  // a
    batch.commandPayloadBytes.add(<uint>108); // l
    batch.commandPayloadBytes.add(<uint>1);
    var byteIndex: uint = <uint>0;
    var value = targetId;
    while (byteIndex < <uint>8) {
        batch.commandPayloadBytes.add(value & <uint>255);
        value = value >> 8;
        byteIndex = byteIndex + <uint>1;
    }
}

pub temporalReversalCommandStateTest(): int {
    var code = temporalReversalAbilityCode();
    var state = new WorldState();
    var casterId = state.spawnPlayer(<uint>2, 16, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnPlayer(<uint>1, 16, 20.0, 1.5, 0.0, 100, 7.0, 1);
    state.entityResources[0] = temporalReversal.resourceCost(true);
    state.entityMaxResources[0] = temporalReversal.resourceCost(true);
    var arcaneCode = talentSelectionCatalog.specCode("mage", "arcane");
    if (arcaneCode == <uint>0) { return -6; }
    if (temporalReversalCatalogAdmission(state, 0, code)) { return -7; }
    state.entityTalentSpecCodes[0] = arcaneCode;
    if (!temporalReversalCatalogAdmission(state, 0, code)) { return -8; }
    state.entityKnownAbilityCodes.add(code);
    state.entityKnownAbilityOffsets[1] = <uint>1;
    state.entityKnownAbilityOffsets[2] = <uint>1;
    state.nextPartyId = <uint>2;
    state.entityPartyIds[0] = <uint>1;
    state.entityPartyLeaderIds[0] = casterId;
    state.entityPartyMemberOrders[0] = <uint>1;
    state.entityPartyIds[1] = <uint>1;
    state.entityPartyLeaderIds[1] = casterId;
    state.entityPartyMemberOrders[1] = <uint>2;
    state.entityDead[1] = true;
    state.entityHp[1] = 0;
    var cast = new CommandBatch();
    appendTemporalReversalCastCommand(cast, casterId, <uint>1, <uint>1, targetId);
    state.applyCommands(cast, 1);
    if (<uint>state.entityCastingAbility[0] != code ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        <float>state.entityResources[0] != temporalReversal.resourceCost(true) ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -1;
    }
    var tick = 0;
    while (tick < 40) {
        advanceState(state, state.tick + <uint>1, state.generation, 1);
        stepRetainedCasting(state, 0, false);
        tick = tick + 1;
    }
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <uint>state.entityCastTargetIds[0] != <uint>0 ||
        <float>state.entityResources[0] != 0 ||
        !<bool>state.entityResurrectionOfferPresent[1] ||
        <uint>state.entityResurrectionOfferCasterIds[1] != casterId ||
        abilityCooldownExpiresAt(state, 0, code) != <uint>602000000) {
        return -2;
    }
    var restored = decodeState(encodeState(state));
    if (<int>restored.entityResources[0] != 0 ||
        <int>restored.entityMaxResources[0] != temporalReversal.resourceCost(true) ||
        <uint>restored.entityAbilityCooldownCodes[0] != code ||
        <uint>restored.entityAbilityCooldownExpiresAtMicros[0] != <uint>602000000 ||
        !<bool>restored.entityResurrectionOfferPresent[1]) {
        return -3;
    }
    restored.timeMicros = <uint>602000000;
    clearExpiredAbilityCooldowns(restored);
    clearExpiredResurrectionOffers(restored);
    if (restored.entityAbilityCooldownCodes.length != 0 ||
        decodeState(encodeState(restored)).entityAbilityCooldownCodes.length != 0) {
        return -4;
    }

    // A target that is revived or leaves the group during the two-second cast
    // invalidates completion before cost or cooldown, matching applyAbility.
    var fizzled = new WorldState();
    var fizzleCaster = fizzled.spawnPlayer(<uint>2, 16, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var fizzleTarget = fizzled.spawnPlayer(<uint>1, 16, 20.0, 1.5, 0.0, 100, 7.0, 1);
    fizzled.entityResources[0] = temporalReversal.resourceCost(true);
    fizzled.entityMaxResources[0] = temporalReversal.resourceCost(true);
    fizzled.entityTalentSpecCodes[0] = arcaneCode;
    fizzled.entityKnownAbilityCodes.add(code);
    fizzled.entityKnownAbilityOffsets[1] = <uint>1;
    fizzled.entityKnownAbilityOffsets[2] = <uint>1;
    fizzled.nextPartyId = <uint>2;
    fizzled.entityPartyIds[0] = <uint>1;
    fizzled.entityPartyLeaderIds[0] = fizzleCaster;
    fizzled.entityPartyMemberOrders[0] = <uint>1;
    fizzled.entityPartyIds[1] = <uint>1;
    fizzled.entityPartyLeaderIds[1] = fizzleCaster;
    fizzled.entityPartyMemberOrders[1] = <uint>2;
    fizzled.entityDead[1] = true;
    fizzled.entityHp[1] = 0;
    var fizzleCast = new CommandBatch();
    appendTemporalReversalCastCommand(
        fizzleCast, fizzleCaster, <uint>1, <uint>1, fizzleTarget
    );
    fizzled.applyCommands(fizzleCast, 1);
    fizzled.entityPartyIds[1] = <uint>0;
    fizzled.entityPartyLeaderIds[1] = <uint>0;
    fizzled.entityPartyMemberOrders[1] = <uint>0;
    tick = 0;
    while (tick < 40) {
        advanceState(fizzled, fizzled.tick + <uint>1, fizzled.generation, 1);
        stepRetainedCasting(fizzled, 0, false);
        tick = tick + 1;
    }
    if (<bool>fizzled.entityResurrectionOfferPresent[1] ||
        <int>fizzled.entityResources[0] != temporalReversal.resourceCost(true) ||
        abilityCooldownExpiresAt(fizzled, 0, code) != <uint>0) {
        return -5;
    }
    return 1;
}

// The source selects PlayerMeta.known[slot], not a separately persisted action
// bar. This test keeps that actor-local partition and silent invalid-slot rule.
pub temporalReversalSlotCommandStateTest(): int {
    var code = temporalReversalAbilityCode();
    var state = new WorldState();
    var targetId = state.spawnPlayer(<uint>1, 16, 20.0, 1.5, 0.0, 100, 7.0, 1);
    var casterId = state.spawnPlayer(<uint>2, 16, 0.0, 1.5, 0.0, 100, 7.0, 1);
    state.entityResources[1] = temporalReversal.resourceCost(true);
    state.entityMaxResources[1] = temporalReversal.resourceCost(true);
    var arcaneCode = talentSelectionCatalog.specCode("mage", "arcane");
    if (arcaneCode == <uint>0) { return -4; }
    state.entityTalentSpecCodes[1] = arcaneCode;
    state.entityKnownAbilityCodes.add(<uint>143);
    state.entityKnownAbilityCodes.add(code);
    state.entityKnownAbilityOffsets[1] = <uint>1;
    state.entityKnownAbilityOffsets[2] = <uint>2;
    state.nextPartyId = <uint>2;
    state.entityPartyIds[0] = <uint>1;
    state.entityPartyLeaderIds[0] = casterId;
    state.entityPartyMemberOrders[0] = <uint>1;
    state.entityPartyIds[1] = <uint>1;
    state.entityPartyLeaderIds[1] = casterId;
    state.entityPartyMemberOrders[1] = <uint>2;
    state.entityDead[0] = true;
    state.entityHp[0] = 0;
    state.entityTargetIds[1] = targetId;

    var selected = new CommandBatch();
    appendCastSlotCommand(selected, casterId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(selected, 1);
    if (<uint>state.entityCastingAbility[1] != code ||
        <uint>state.entityCastTargetIds[1] != targetId ||
        <uint>state.entityLastCommandSequence[1] != <uint>1) {
        return -1;
    }

    var negative = new CommandBatch();
    appendCastSlotCommand(negative, casterId, <uint>1, <uint>2, <uint>4294967295);
    state.applyCommands(negative, 1);
    if (<uint>state.entityCastingAbility[1] != code ||
        <uint>state.entityCastTargetIds[1] != targetId ||
        <uint>state.entityLastCommandSequence[1] != <uint>2) {
        return -2;
    }

    var missing = new CommandBatch();
    appendCastSlotCommand(missing, casterId, <uint>1, <uint>3, <uint>1);
    state.applyCommands(missing, 1);
    if (<uint>state.entityCastingAbility[1] != code ||
        <uint>state.entityCastTargetIds[1] != targetId ||
        <uint>state.entityLastCommandSequence[1] != <uint>3) {
        return -3;
    }
    return 1;
}

// WOS40 accepts source-known form casts through both action-bar slots and the
// exact typed identifier path. This keeps form-specific resource transitions
// separate from the generic cast boundary for all other abilities.
pub formCastCommandStateTest(): int {
    var bear = forms.formAbilityCode("form_bear");
    var cat = forms.formAbilityCode("form_cat");
    var fireball = forms.formAbilityCode("form_fireball");
    if (bear == <uint>0 || cat == <uint>0 || fireball == <uint>0) { return -1; }

    var druidState = new WorldState();
    var druidId = druidState.spawnPlayer(<uint>9, 11, 0.0, 1.5, 0.0, 100, 7.0, 1);
    setM5BaselineStatProfile(druidState, 0, 8);
    druidState.entityResourceKinds[0] = formTransitions.manaResourceKind();
    druidState.entityResources[0] = 100;
    druidState.entityMaxResources[0] = 200;
    druidState.entityKnownAbilityCodes.add(bear);
    druidState.entityKnownAbilityCodes.add(cat);
    druidState.entityKnownAbilityOffsets[1] = <uint>2;

    var bearSlot = new CommandBatch();
    appendCastSlotCommand(bearSlot, druidId, <uint>1, <uint>1, <uint>0);
    druidState.applyCommands(bearSlot, 1);
    if (<uint>druidState.entityActiveFormAbilityCodes[0] != bear ||
        <uint>druidState.entityResourceKinds[0] != formTransitions.rageResourceKind() ||
        <int>druidState.entityResources[0] != 0 ||
        <int>druidState.entitySavedMana[0] != 70 ||
        <int>druidState.entitySavedManaMaximums[0] != 200) {
        return -2;
    }
    var expectedBearStats = playerStatInputs.deriveBaseline(8, 11, bear);
    if (<int>druidState.entityMaxHp[0] != expectedBearStats.maxHp ||
        <int>druidState.entityHp[0] != expectedBearStats.maxHp ||
        <int>druidState.entityAttackPower[0] != expectedBearStats.attackPower ||
        <int>druidState.entityArmor[0] != expectedBearStats.armor) {
        return -3;
    }

    druidState.entityCastGcdRemaining[0] = 0.0;
    var catSlot = new CommandBatch();
    appendCastSlotCommand(catSlot, druidId, <uint>1, <uint>2, <uint>1);
    druidState.applyCommands(catSlot, 1);
    if (<uint>druidState.entityActiveFormAbilityCodes[0] != cat ||
        <uint>druidState.entityResourceKinds[0] != formTransitions.energyResourceKind() ||
        <int>druidState.entityResources[0] != 100 ||
        <int>druidState.entitySavedMana[0] != 40) {
        return -4;
    }
    var expectedCatStats = playerStatInputs.deriveBaseline(8, 11, cat);
    if (<int>druidState.entityMaxHp[0] != expectedCatStats.maxHp ||
        <int>druidState.entityAttackPower[0] != expectedCatStats.attackPower ||
        <int>druidState.entityArmor[0] != expectedCatStats.armor) {
        return -5;
    }

    druidState.entityCastGcdRemaining[0] = 0.0;
    var catExit = new CommandBatch();
    appendCastSlotCommand(catExit, druidId, <uint>1, <uint>3, <uint>1);
    druidState.applyCommands(catExit, 1);
    if (<uint>druidState.entityActiveFormAbilityCodes[0] != <uint>0 ||
        <uint>druidState.entityResourceKinds[0] != formTransitions.manaResourceKind() ||
        <int>druidState.entityResources[0] != 40 ||
        <int>druidState.entityMaxResources[0] != 200) {
        return -6;
    }
    var expectedBaseStats = playerStatInputs.deriveBaseline(8, 11, <uint>0);
    if (<int>druidState.entityMaxHp[0] != expectedBaseStats.maxHp ||
        <int>druidState.entityAttackPower[0] != expectedBaseStats.attackPower ||
        <int>druidState.entityArmor[0] != expectedBaseStats.armor) {
        return -7;
    }
    var restoredDruid = decodeState(encodeState(druidState));
    if (<uint>restoredDruid.entityBaselineStatProfileCodes[0] != <uint>9 ||
        <int>restoredDruid.entityMaxHp[0] != expectedBaseStats.maxHp) {
        return -8;
    }

    var mageState = new WorldState();
    var mageId = mageState.spawnPlayer(<uint>2, 11, 0.0, 1.5, 0.0, 100, 7.0, 1);
    mageState.entityResourceKinds[0] = formTransitions.manaResourceKind();
    mageState.entityResources[0] = 100;
    mageState.entityMaxResources[0] = 200;
    mageState.entityAutoAttack[0] = true;
    mageState.entityKnownAbilityCodes.add(fireball);
    mageState.entityKnownAbilityOffsets[1] = <uint>1;
    var fireballBytes = new container.Array<uint>();
    fireballBytes.add(<uint>102); // f
    fireballBytes.add(<uint>105); // i
    fireballBytes.add(<uint>114); // r
    fireballBytes.add(<uint>101); // e
    fireballBytes.add(<uint>98); // b
    fireballBytes.add(<uint>97); // a
    fireballBytes.add(<uint>108); // l
    fireballBytes.add(<uint>108); // l
    fireballBytes.add(<uint>95); // _
    fireballBytes.add(<uint>102); // f
    fireballBytes.add(<uint>111); // o
    fireballBytes.add(<uint>114); // r
    fireballBytes.add(<uint>109); // m
    var fireballCast = new CommandBatch();
    appendTypedCastCommandForTest(
        fireballCast, mageId, <uint>1, <uint>1, fireballBytes
    );
    mageState.applyCommands(fireballCast, 1);
    if (<uint>mageState.entityCastingAbility[0] != fireball ||
        <int>mageState.entityResources[0] != 100) {
        return -9;
    }
    var tick = 0;
    while (tick < 40) {
        advanceState(mageState, mageState.tick + <uint>1, mageState.generation, 1);
        stepRetainedCasting(mageState, 0, false);
        tick = tick + 1;
    }
    if (<uint>mageState.entityCastingAbility[0] != <uint>0 ||
        <uint>mageState.entityActiveFormAbilityCodes[0] != fireball ||
        <uint>mageState.entityResourceKinds[0] != formTransitions.manaResourceKind() ||
        <int>mageState.entityResources[0] != 50 ||
        <int>mageState.entityMaxResources[0] != 200 ||
        <bool>mageState.entityAutoAttack[0] ||
        abilityCooldownExpiresAt(mageState, 0, fireball) <= mageState.timeMicros) {
        return -10;
    }
    if (retainedPlayerMovementSpeedMultiplier(mageState, 0) != 1.4) {
        return -11;
    }

    // M5 base-resource values and persisted selected mastery must share the
    // same authoritative recalc path. Keep its resource percentage stable.
    var talentState = new WorldState();
    talentState.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    talentState.entityResourceKinds[0] = formTransitions.manaResourceKind();
    talentState.entityMaxResources[0] = 1506;
    talentState.entityResources[0] = 753;
    talentState.entityTalentSpecCodes[0] = <uint>19;
    setM5BaselineStatProfile(talentState, 0, 1);
    recomputeBaselineFormDerivedStats(talentState, 0);
    if (<int>talentState.entityMaxResources[0] != 1581 ||
        <int>talentState.entityResources[0] != 791 ||
        !baselineStatProfileMatchesDerivedColumns(talentState, 0)) {
        return -12;
    }
    // WOS42 owns the source-derived spell-haste final column. Survival's
    // retained specialization contributes a nonzero value, so this catches
    // an accidental zero-default round trip.
    var hasteState = new WorldState();
    hasteState.spawnPlayer(<uint>5, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    hasteState.entityResourceKinds[0] = formTransitions.manaResourceKind();
    hasteState.entityMaxResources[0] = 100;
    hasteState.entityResources[0] = 50;
    var survival = talentSelectionCatalog.specCode("hunter", "survival");
    if (survival != <uint>9) { return -13; }
    hasteState.entityTalentSpecCodes[0] = survival;
    setM5BaselineStatProfile(hasteState, 0, 4);
    recomputeBaselineFormDerivedStats(hasteState, 0);
    var restoredHasteState = decodeState(encodeState(hasteState));
    if (!floatMatches(<float>hasteState.entitySpellHaste[0], 0.15) ||
        !floatMatches(<float>restoredHasteState.entitySpellHaste[0], 0.15) ||
        !baselineStatProfileMatchesDerivedColumns(restoredHasteState, 0)) {
        return -14;
    }
    // WOS43 persists source identity rather than an equipment-derived stat
    // snapshot. Warrior's source starting sword has no intellect; replacing
    // it with the pinned gnarled staff raises spell power from 5 to 6.
    var equipmentState = new WorldState();
    equipmentState.spawnPlayer(<uint>6, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    setM5BaselineStatProfile(equipmentState, 0, 0);
    var gnarledStaff = m5Equipment.itemIndexForId("gnarled_staff");
    if (gnarledStaff < 0) { return -15; }
    setM5EquipmentItemCode(
        equipmentState, 0, "mainhand", <uint>(gnarledStaff + 1)
    );
    var restoredEquipmentState = decodeState(encodeState(equipmentState));
    if (<uint>equipmentState.entityM5MainhandItemCodes[0] != <uint>(gnarledStaff + 1) ||
        <int>equipmentState.entityWeaponMinimum[0] != 3 ||
        <int>equipmentState.entityWeaponMaximum[0] != 6 ||
        !floatMatches(<float>equipmentState.entityWeaponSpeed[0], 2.9) ||
        <int>equipmentState.entitySpellPower[0] != 6 ||
        <uint>restoredEquipmentState.entityM5MainhandItemCodes[0] !=
            <uint>(gnarledStaff + 1) ||
        <int>restoredEquipmentState.entityWeaponMinimum[0] != 3 ||
        <int>restoredEquipmentState.entitySpellPower[0] != 6 ||
        !baselineStatProfileMatchesDerivedColumns(restoredEquipmentState, 0)) {
        return -16;
    }
    // WOS44 keeps the target's source-order flat inventory: addStacked fills a
    // 20-count stack first, removal consumes the newest matching stack, and a
    // bag only raises the pooled capacity after its own inventory slot is freed.
    var inventoryState = new WorldState();
    inventoryState.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 90, 7.0, 1);
    var breadCode = m5InventoryItemCodeForId("baked_bread");
    var fangCode = m5InventoryItemCodeForId("wolf_fang");
    var satchelCode = m5InventoryItemCodeForId("wolfhide_satchel");
    grantM5InventoryItem(inventoryState, 0, breadCode, 21);
    grantM5InventoryItem(inventoryState, 0, satchelCode, 1);
    setM5InventoryCopper(inventoryState, 0, 321);
    if (!m5InventoryCanAddItem(inventoryState, 0, fangCode, 20) ||
        !equipM5InventoryBag(inventoryState, 0, satchelCode, 0) ||
        m5InventoryUsedSlots(inventoryState, 0) != 2 ||
        m5InventoryCapacity(inventoryState, 0) != 26) {
        return -17;
    }
    grantM5InventoryItem(inventoryState, 0, fangCode, 2);
    if (removeM5InventoryItem(inventoryState, 0, breadCode, 1) != 1 ||
        m5InventoryItemCount(inventoryState, 0, breadCode) != 20 ||
        m5InventoryItemCount(inventoryState, 0, fangCode) != 2 ||
        m5InventoryUsedSlots(inventoryState, 0) != 2) {
        return -18;
    }
    var restoredInventoryState = decodeState(encodeState(inventoryState));
    if (<int>restoredInventoryState.entityInventoryCopper[0] != 321 ||
        <uint>restoredInventoryState.entityInventoryBagCodes[0] != satchelCode ||
        m5InventoryCapacity(restoredInventoryState, 0) != 26 ||
        m5InventoryItemCount(restoredInventoryState, 0, breadCode) != 20 ||
        m5InventoryItemCount(restoredInventoryState, 0, fangCode) != 2 ||
        !m5InventoryStateIsValid(restoredInventoryState, 0)) {
        return -19;
    }
    // WOS45 distinguishes an equipped source starting weapon from an empty
    // mainhand, and keeps equip/unequip inventory transfers source-ordered.
    var equipmentInventoryState = new WorldState();
    equipmentInventoryState.spawnPlayer(<uint>2, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    setM5BaselineStatProfile(equipmentInventoryState, 0, 0);
    var staffCode = m5InventoryItemCodeForId("gnarled_staff");
    var startingSwordCode = m5Equipment.startingMainhandStoredCode(0);
    grantM5InventoryItem(equipmentInventoryState, 0, staffCode, 1);
    if (!equipM5InventoryItem(equipmentInventoryState, 0, staffCode) ||
        m5InventoryItemCount(equipmentInventoryState, 0, staffCode) != 0 ||
        m5InventoryItemCount(equipmentInventoryState, 0, startingSwordCode) != 1 ||
        <uint>equipmentInventoryState.entityM5MainhandItemCodes[0] != staffCode ||
        !unequipM5InventoryItem(equipmentInventoryState, 0, "mainhand") ||
        <uint>equipmentInventoryState.entityM5MainhandItemCodes[0] !=
            m5Equipment.emptyMainhandStoredCode() ||
        m5InventoryItemCount(equipmentInventoryState, 0, staffCode) != 1 ||
        m5InventoryItemCount(equipmentInventoryState, 0, startingSwordCode) != 1 ||
        <int>equipmentInventoryState.entityWeaponMinimum[0] != 1 ||
        <int>equipmentInventoryState.entityWeaponMaximum[0] != 2 ||
        !floatMatches(<float>equipmentInventoryState.entityWeaponSpeed[0], 2.0)) {
        return -20;
    }
    var restoredEquipmentInventoryState = decodeState(encodeState(equipmentInventoryState));
    if (<uint>restoredEquipmentInventoryState.entityM5MainhandItemCodes[0] !=
            m5Equipment.emptyMainhandStoredCode() ||
        m5InventoryItemCount(restoredEquipmentInventoryState, 0, staffCode) != 1 ||
        m5InventoryItemCount(restoredEquipmentInventoryState, 0, startingSwordCode) != 1 ||
        !baselineStatProfileMatchesDerivedColumns(restoredEquipmentInventoryState, 0)) {
        return -21;
    }
    // WOS46 routes the target's existing equip_bag / unequip_bag command ids
    // through the persistent WOS44 bag partition rather than a side ledger.
    var bagCommandState = new WorldState();
    bagCommandState.spawnPlayer(<uint>3, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var commandSatchelCode = m5InventoryItemCodeForId("wolfhide_satchel");
    grantM5InventoryItem(bagCommandState, 0, commandSatchelCode, 1);
    var payloadCatalog = %import("protocol/command_payloads");
    var equipBagBatch = new CommandBatch();
    appendM5EquipBagCommand(
        equipBagBatch, payloadCatalog.equipBagCommandId(true),
        <uint>bagCommandState.entityIds[0], <uint>bagCommandState.entityGenerations[0],
        <uint>1
    );
    bagCommandState.applyCommands(equipBagBatch, 1);
    var unequipBagBatch = new CommandBatch();
    appendM5UnequipBagCommand(
        unequipBagBatch, payloadCatalog.unequipBagCommandId(true),
        <uint>bagCommandState.entityIds[0], <uint>bagCommandState.entityGenerations[0],
        <uint>2, <uint>0
    );
    bagCommandState.applyCommands(unequipBagBatch, 1);
    if (<uint>bagCommandState.entityInventoryBagCodes[0] != <uint>0 ||
        m5InventoryItemCount(bagCommandState, 0, commandSatchelCode) != 1 ||
        !<bool>bagCommandState.entityCommandSequenceInitialized[0] ||
        <uint>bagCommandState.entityLastCommandSequence[0] != <uint>2) {
        return -22;
    }
    // WOS47 puts vendor purchases, sales, buyback, and sell-all-junk through
    // the same command sequencing path as the reference game. The compact
    // state persists the newest-first buyback entry across an encode/decode.
    var vendorState = new WorldState();
    var vendorPlayerId = vendorState.spawnPlayer(<uint>4, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var vendorId = vendorState.spawnQuestNpc(<uint>6, 1.0, 0.0, 1);
    setM5InventoryCopper(vendorState, 0, 100);
    var vendorBatch = new CommandBatch();
    appendM5VendorBuyCommand(
        vendorBatch, payloadCatalog.buyCommandId(true), vendorPlayerId,
        <uint>vendorState.entityGenerations[0], <uint>1, vendorId, 0
    );
    vendorState.applyCommands(vendorBatch, 1);
    var vendorBreadCode = m5InventoryItemCodeForId("baked_bread");
    var vendorBandanaCode = m5InventoryItemCodeForId("bandit_bandana");
    if (m5InventoryItemCount(vendorState, 0, vendorBreadCode) != 5 ||
        <int>vendorState.entityInventoryCopper[0] >= 100) {
        return -23;
    }
    grantM5InventoryItem(vendorState, 0, vendorBandanaCode, 1);
    var vendorSellBatch = new CommandBatch();
    appendM5VendorSellCommand(
        vendorSellBatch, payloadCatalog.sellCommandId(true), vendorPlayerId,
        <uint>vendorState.entityGenerations[0], <uint>2, 1, 1
    );
    vendorState.applyCommands(vendorSellBatch, 1);
    if (m5InventoryItemCount(vendorState, 0, vendorBandanaCode) != 0 ||
        !m5VendorBuybackAvailable(vendorState, 0, vendorBandanaCode)) {
        return -24;
    }
    var vendorBuybackBatch = new CommandBatch();
    appendM5VendorBuybackCommand(
        vendorBuybackBatch, payloadCatalog.buybackCommandId(true), vendorPlayerId,
        <uint>vendorState.entityGenerations[0], <uint>3, 1
    );
    vendorState.applyCommands(vendorBuybackBatch, 1);
    if (m5InventoryItemCount(vendorState, 0, vendorBandanaCode) != 1 ||
        m5VendorBuybackAvailable(vendorState, 0, vendorBandanaCode)) {
        return -25;
    }
    var vendorJunkBatch = new CommandBatch();
    appendM5CommandHeader(
        vendorJunkBatch, payloadCatalog.sellAllJunkCommandId(true), vendorPlayerId,
        <uint>vendorState.entityGenerations[0], <uint>4, <uint>0
    );
    vendorState.applyCommands(vendorJunkBatch, 1);
    var restoredVendorState = decodeState(encodeState(vendorState));
    if (m5InventoryItemCount(restoredVendorState, 0, vendorBandanaCode) != 0 ||
        !m5VendorBuybackAvailable(restoredVendorState, 0, vendorBandanaCode) ||
        <uint>restoredVendorState.entityLastCommandSequence[0] != <uint>4 ||
        !m5InventoryStateIsValid(restoredVendorState, 0)) {
        return -26;
    }
    // WOS49 routes the existing discard packet through the scalar inventory
    // authority. Its omitted count defaults to one; an explicit overlarge
    // count clamps to the available tail stacks and q_boars immediately
    // transitions from ready back to active when one hide is discarded.
    var discardBootstrap = new OfflineBootstrap();
    discardBootstrap.launchVersion = <uint>1;
    discardBootstrap.worldSeed = <uint>20061;
    discardBootstrap.playerClass = <uint>0;
    discardBootstrap.playerName.add(<uint>86);
    discardBootstrap.playerName.add(<uint>97);
    discardBootstrap.playerName.add(<uint>108);
    discardBootstrap.playerName.add(<uint>101);
    discardBootstrap.skinVariant = <uint>0;
    var discardState = new WorldState();
    applyOfflineBootstrap(discardState, discardBootstrap);
    discardState.entityX[0] = -7.0;
    discardState.entityZ[0] = 3.0;
    var discardPlayerId = <uint>discardState.entityIds[0];
    var acceptDiscardQuest = new CommandBatch();
    appendQuestCommand(
        acceptDiscardQuest, payloadCatalog.acceptQuestCommandId(true), discardPlayerId,
        <uint>discardState.entityGenerations[0], <uint>1, 2
    );
    discardState.applyCommands(acceptDiscardQuest, 1);
    var discardBoarHideCode = m5InventoryItemCodeForId("boar_hide");
    var discardWolfFangCode = m5InventoryItemCodeForId("wolf_fang");
    grantM5InventoryItem(discardState, 0, discardBoarHideCode, 5);
    grantM5InventoryItem(discardState, 0, discardWolfFangCode, 2);
    var discardDefault = new CommandBatch();
    appendM5DiscardCommand(
        discardDefault, payloadCatalog.discardItemCommandId(true), discardPlayerId,
        <uint>discardState.entityGenerations[0], <uint>2, 2, -1
    );
    discardState.applyCommands(discardDefault, 1);
    if (m5InventoryItemCount(discardState, 0, discardBoarHideCode) != 4 ||
        discardState.offlineQuestBoarsState != <uint>1 ||
        discardState.offlineQuestBoarsObjectiveCount != <uint>4) {
        return -27;
    }
    var discardAllFangs = new CommandBatch();
    appendM5DiscardCommand(
        discardAllFangs, payloadCatalog.discardItemCommandId(true), discardPlayerId,
        <uint>discardState.entityGenerations[0], <uint>3, 11, 99
    );
    discardState.applyCommands(discardAllFangs, 1);
    var restoredDiscardState = decodeState(encodeState(discardState));
    if (m5InventoryItemCount(restoredDiscardState, 0, discardBoarHideCode) != 4 ||
        m5InventoryItemCount(restoredDiscardState, 0, discardWolfFangCode) != 0 ||
        restoredDiscardState.offlineQuestBoarsState != <uint>1 ||
        <uint>restoredDiscardState.entityLastCommandSequence[0] != <uint>3) {
        return -28;
    }
    return 1;
}

appendM5CommandHeader(
    batch: CommandBatch, commandId: uint, actorId: uint, generation: uint,
    sequence: uint, payloadLength: uint
): void {
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(commandId);
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(payloadLength);
}

appendM5EquipBagCommand(
    batch: CommandBatch, commandId: uint, actorId: uint, generation: uint, sequence: uint
): void {
    appendM5CommandHeader(batch, commandId, actorId, generation, sequence, <uint>21);
    batch.commandPayloadBytes.add(<uint>16);
    batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>0);
    batch.commandPayloadBytes.add(<uint>119); // w
    batch.commandPayloadBytes.add(<uint>111); // o
    batch.commandPayloadBytes.add(<uint>108); // l
    batch.commandPayloadBytes.add(<uint>102); // f
    batch.commandPayloadBytes.add(<uint>104); // h
    batch.commandPayloadBytes.add(<uint>105); // i
    batch.commandPayloadBytes.add(<uint>100); // d
    batch.commandPayloadBytes.add(<uint>101); // e
    batch.commandPayloadBytes.add(<uint>95);  // _
    batch.commandPayloadBytes.add(<uint>115); // s
    batch.commandPayloadBytes.add(<uint>97);  // a
    batch.commandPayloadBytes.add(<uint>116); // t
    batch.commandPayloadBytes.add(<uint>99);  // c
    batch.commandPayloadBytes.add(<uint>104); // h
    batch.commandPayloadBytes.add(<uint>101); // e
    batch.commandPayloadBytes.add(<uint>108); // l
    batch.commandPayloadBytes.add(<uint>0);   // optional socket absent
}

appendM5UnequipBagCommand(
    batch: CommandBatch, commandId: uint, actorId: uint, generation: uint,
    sequence: uint, socket: uint
): void {
    appendM5CommandHeader(batch, commandId, actorId, generation, sequence, <uint>4);
    batch.commandPayloadBytes.add(socket & <uint>255);
    batch.commandPayloadBytes.add((socket >> 8) & <uint>255);
    batch.commandPayloadBytes.add((socket >> 16) & <uint>255);
    batch.commandPayloadBytes.add((socket >> 24) & <uint>255);
}

appendM5VendorItemId(batch: CommandBatch, itemIndex: int): void {
    var catalog = %import("generated/m5_content_catalog");
    var itemLength = catalog.itemIdUtf8Length(itemIndex);
    if (itemLength < 1 || itemLength > 256) {
        throw "woc M5 vendor test item is invalid";
    }
    batch.commandPayloadBytes.add(<uint>itemLength & <uint>255);
    batch.commandPayloadBytes.add((<uint>itemLength >> 8) & <uint>255);
    batch.commandPayloadBytes.add((<uint>itemLength >> 16) & <uint>255);
    batch.commandPayloadBytes.add((<uint>itemLength >> 24) & <uint>255);
    var byteIndex = 0;
    while (byteIndex < itemLength) {
        batch.commandPayloadBytes.add(catalog.itemIdUtf8Byte(itemIndex, byteIndex));
        byteIndex = byteIndex + 1;
    }
}

