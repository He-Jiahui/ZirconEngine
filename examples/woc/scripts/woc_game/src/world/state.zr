pub mechChromaCommandStateTest(): int {
    var catalog = %import("generated/m5_content_catalog");
    if (catalog.mechChromaCount() != 15 || catalog.count("item") != 82) {
        return -1;
    }
    var mappingIndex = 0;
    while (mappingIndex < catalog.mechChromaCount()) {
        var mappedItemIndex = catalog.mechChromaItemIndex(mappingIndex);
        if (mappedItemIndex != 67 + mappingIndex ||
            catalog.mechChromaSkinIndex(mappingIndex) != mappingIndex ||
            !catalog.flag("item", mappedItemIndex, "noVendorSell") ||
            !catalog.flag("item", mappedItemIndex, "noDiscard") ||
            !catalog.flag("item", mappedItemIndex, "noMarketList")) {
            return -2;
        }
        var mappingState = new WorldState();
        var mappingPlayerId = mappingState.spawnPlayer(
            <uint>1, 20, 0.0, 1.5, 0.0, 100, 7.0, 1
        );
        mappingState.offlineMechChromaOwned[mappingIndex] = true;
        mappingState.entitySkinCatalogs[0] = <uint>2;
        mappingState.entitySkinIndices[0] =
            <uint>catalog.mechChromaSkinIndex(mappingIndex);
        var mappingCommand = new CommandBatch();
        appendMechChromaCommandForTest(
            mappingCommand, mappingPlayerId, <uint>1, <uint>1, mappingIndex
        );
        mappingState.applyCommands(mappingCommand, 1);
        if (<bool>mappingState.offlineMechChromaOwned[mappingIndex] ||
            <uint>mappingState.entitySkinCatalogs[0] != <uint>1 ||
            <uint>mappingState.entitySkinIndices[0] != <uint>0 ||
            m5InventoryItemCount(
                mappingState, 0, <uint>mappedItemIndex + <uint>1
            ) != 1) {
            return -3;
        }
        mappingIndex = mappingIndex + 1;
    }

    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    var playerId = <uint>state.entityIds[0];
    var payloads = %import("protocol/command_payloads");
    state.offlineMechChromaOwned[0] = true;
    var equipOwned = new CommandBatch();
    appendSkinCommand(
        equipOwned, payloads.changeSkinCommandId(true), playerId, <uint>1,
        <uint>1, <uint>1, <uint>0
    );
    state.applyCommands(equipOwned, 1);
    var secondPlayerId = state.spawnPlayer(
        <uint>1, 20, 1.0, 1.5, 0.0, 100, 7.0, 1
    );
    var secondPlayerIndex = state.entityIds.length - 1;
    state.entitySkinCatalogs[secondPlayerIndex] = <uint>2;
    state.entitySkinIndices[secondPlayerIndex] = <uint>0;
    state.entityDead[0] = true;
    var deadChroma = new CommandBatch();
    appendMechChromaCommandForTest(
        deadChroma, playerId, <uint>1, <uint>2, 0
    );
    state.applyCommands(deadChroma, 1);
    var firstPlateCode = <uint>catalog.mechChromaItemIndex(0) + <uint>1;
    if (<bool>state.offlineMechChromaOwned[0] ||
        <uint>state.entitySkinCatalogs[0] != <uint>1 ||
        <uint>state.entitySkinCatalogs[secondPlayerIndex] != <uint>1 ||
        <uint>state.entitySkinIndices[secondPlayerIndex] != <uint>0 ||
        m5InventoryItemCount(state, 0, firstPlateCode) != 1) {
        return -4;
    }
    var repeatedUnequip = new CommandBatch();
    appendMechChromaCommandForTest(
        repeatedUnequip, playerId, <uint>1, <uint>3, 0
    );
    state.applyCommands(repeatedUnequip, 1);
    if (m5InventoryItemCount(state, 0, firstPlateCode) != 1) return -5;

    state.entityDead[0] = false;
    var reuse = new CommandBatch();
    appendUseItemCommandForTest(reuse, playerId, <uint>1, <uint>4, firstPlateCode);
    state.applyCommands(reuse, 1);
    if (!<bool>state.offlineMechChromaOwned[0] ||
        <uint>state.entitySkinCatalogs[0] != <uint>2 ||
        <uint>state.entitySkinIndices[0] != <uint>0 ||
        m5InventoryItemCount(state, 0, firstPlateCode) != 0) {
        return -6;
    }

    var unownedChroma = new CommandBatch();
    appendMechChromaCommandForTest(
        unownedChroma, playerId, <uint>1, <uint>5, 1
    );
    state.applyCommands(unownedChroma, 1);
    var secondPlateCode = <uint>catalog.mechChromaItemIndex(1) + <uint>1;
    var unknownBytes = new container.Array<uint>();
    unknownBytes.add(<uint>120);
    var unknownChroma = new CommandBatch();
    appendRawMechChromaCommandForTest(
        unknownChroma, playerId, <uint>1, <uint>6, unknownBytes, false
    );
    state.applyCommands(unknownChroma, 1);
    if (m5InventoryItemCount(state, 0, secondPlateCode) != 0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>6) {
        return -7;
    }

    // Unequipping an owned but inactive chroma returns its plate without
    // disturbing a different active mech skin.
    state.offlineMechChromaOwned[1] = true;
    var inactiveChroma = new CommandBatch();
    appendMechChromaCommandForTest(
        inactiveChroma, playerId, <uint>1, <uint>7, 1
    );
    state.applyCommands(inactiveChroma, 1);
    if (<bool>state.offlineMechChromaOwned[1] ||
        <uint>state.entitySkinCatalogs[0] != <uint>2 ||
        <uint>state.entitySkinIndices[0] != <uint>0 ||
        m5InventoryItemCount(state, 0, secondPlateCode) != 1) {
        return -8;
    }

    var protectedChroma = new CommandBatch();
    appendM5DiscardCommand(
        protectedChroma, payloads.discardItemCommandId(true), playerId, <uint>1,
        <uint>8, catalog.mechChromaItemIndex(1), 1
    );
    state.applyCommands(protectedChroma, 1);
    if (m5InventoryItemCount(state, 0, secondPlateCode) != 1) return -9;

    var restored = decodeState(encodeState(state));
    if (!<bool>restored.offlineMechChromaOwned[0] ||
        <bool>restored.offlineMechChromaOwned[1] ||
        <uint>restored.entitySkinCatalogs[0] != <uint>2 ||
        m5InventoryItemCount(restored, 0, secondPlateCode) != 1 ||
        !<bool>restored.offlineM5ItemsDiscovered[
            catalog.mechChromaItemIndex(1)
        ]) {
        return -10;
    }

    var fullBagState = new WorldState();
    var fullBagPlayerId = fullBagState.spawnPlayer(
        <uint>1, 20, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    var fullBagChromaIndex = 14;
    var fullBagPlateCode =
        <uint>catalog.mechChromaItemIndex(fullBagChromaIndex) + <uint>1;
    var fillItemIndex = 0;
    while (fillItemIndex < catalog.count("item") &&
        m5InventoryUsedSlots(fullBagState, 0) < m5InventoryCapacity(fullBagState, 0)) {
        var fillItemCode = <uint>fillItemIndex + <uint>1;
        if (fillItemCode != fullBagPlateCode &&
            m5InventoryRules.stackLimitForItemIndex(fillItemIndex) == 1) {
            grantM5InventoryItem(fullBagState, 0, fillItemCode, 1);
        }
        fillItemIndex = fillItemIndex + 1;
    }
    fullBagState.offlineMechChromaOwned[fullBagChromaIndex] = true;
    var fullBagUnequip = new CommandBatch();
    appendMechChromaCommandForTest(
        fullBagUnequip, fullBagPlayerId, <uint>1, <uint>1, fullBagChromaIndex
    );
    fullBagState.applyCommands(fullBagUnequip, 1);
    if (m5InventoryItemCount(fullBagState, 0, fullBagPlateCode) != 1 ||
        m5InventoryUsedSlots(fullBagState, 0) !=
            m5InventoryCapacity(fullBagState, 0) + 1) {
        return -11;
    }

    var maximumChroma = new container.Array<uint>();
    var maximumIndex = 0;
    while (maximumIndex < 256) {
        maximumChroma.add(<uint>120);
        maximumIndex = maximumIndex + 1;
    }
    var maximumPayload = new CommandBatch();
    appendRawMechChromaCommandForTest(
        maximumPayload, secondPlayerId, <uint>1, <uint>1, maximumChroma, false
    );
    if (!mechChromaPayloadShapeIsValid(
        <uint>maximumPayload.commandPayloadOffsets[0],
        <uint>maximumPayload.commandPayloadLengths[0],
        maximumPayload.commandPayloadBytes
    )) return -12;
    var oversizedChroma = new container.Array<uint>();
    var oversizedIndex = 0;
    while (oversizedIndex < 257) {
        oversizedChroma.add(<uint>120);
        oversizedIndex = oversizedIndex + 1;
    }
    var oversizedPayload = new CommandBatch();
    appendRawMechChromaCommandForTest(
        oversizedPayload, secondPlayerId, <uint>1, <uint>2, oversizedChroma, false
    );
    if (mechChromaPayloadShapeIsValid(
        <uint>oversizedPayload.commandPayloadOffsets[0],
        <uint>oversizedPayload.commandPayloadLengths[0],
        oversizedPayload.commandPayloadBytes
    )) return -13;
    var firstChromaBytes = new container.Array<uint>();
    var firstChromaByteIndex = 0;
    while (firstChromaByteIndex < catalog.mechChromaIdUtf8Length(0)) {
        firstChromaBytes.add(catalog.mechChromaIdUtf8Byte(0, firstChromaByteIndex));
        firstChromaByteIndex = firstChromaByteIndex + 1;
    }
    var trailingChroma = new CommandBatch();
    appendRawMechChromaCommandForTest(
        trailingChroma, secondPlayerId, <uint>1, <uint>3, firstChromaBytes, true
    );
    if (mechChromaPayloadShapeIsValid(
        <uint>trailingChroma.commandPayloadOffsets[0],
        <uint>trailingChroma.commandPayloadLengths[0],
        trailingChroma.commandPayloadBytes
    )) return -14;
    var invalidUtf8Chroma = new container.Array<uint>();
    invalidUtf8Chroma.add(<uint>192);
    invalidUtf8Chroma.add(<uint>128);
    var invalidUtf8Payload = new CommandBatch();
    appendRawMechChromaCommandForTest(
        invalidUtf8Payload, secondPlayerId, <uint>1, <uint>4,
        invalidUtf8Chroma, false
    );
    if (mechChromaPayloadShapeIsValid(
        <uint>invalidUtf8Payload.commandPayloadOffsets[0],
        <uint>invalidUtf8Payload.commandPayloadLengths[0],
        invalidUtf8Payload.commandPayloadBytes
    )) return -15;

    var legacyWos81State = new WorldState();
    legacyWos81State.offlineM5ItemsDiscovered[0] = true;
    legacyWos81State.offlineM5ItemsDiscovered[67] = true;
    legacyWos81State.offlineMechChromaOwned[0] = true;
    var legacyWos81 = decodeState(
        encodeStateVersion(legacyWos81State, <uint>81)
    );
    return <bool>legacyWos81.offlineM5ItemsDiscovered[0] &&
        !<bool>legacyWos81.offlineM5ItemsDiscovered[67] &&
        !<bool>legacyWos81.offlineMechChromaOwned[0] ? 1 : -16;
}

pub weaponSkinCommandStateTest(): int {
    if (weaponSkinState.contractTest() != 1 ||
        weaponSkinContract.weaponSkinCount() != 29 ||
        weaponSkinContract.weaponSkinTypeCount() != 8) {
        return -1;
    }
    var catalogIndex = 0;
    while (catalogIndex < weaponSkinContract.weaponSkinCount()) {
        var skinId = weaponSkinContract.weaponSkinId(catalogIndex);
        var typeCode = <uint>weaponSkinContract.weaponSkinTypeCode(catalogIndex);
        if (weaponSkinContract.weaponSkinCodeForId(skinId) !=
                <uint>(catalogIndex + 1) ||
            typeCode < <uint>1 || typeCode > <uint>8) {
            return -2;
        }
        catalogIndex = catalogIndex + 1;
    }

    var state = new WorldState();
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>2;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    bootstrap.weaponSkinOwned[0] = true;
    bootstrap.weaponSkinOwned[6] = true;
    bootstrap.weaponSkinOwned[13] = true;
    applyOfflineBootstrap(state, bootstrap);
    var firstPlayerId = <uint>state.entityIds[0];
    var secondPlayerId = state.spawnPlayer(
        <uint>1, 20, 1.0, 1.5, 0.0, 100, 7.0, 1
    );
    var secondPlayerIndex = state.entityIds.length - 1;
    setM5BaselineStatProfile(
        state, secondPlayerIndex, m5ClassBaseline.classIndex("warrior")
    );
    state.entityDead[0] = true;
    var rngState = state.rngState;
    var rngDraws = state.rngDraws;
    var rngDigest = state.rngDigest;
    var deadApply = new CommandBatch();
    appendWeaponSkinApplyCommandForTest(
        deadApply, firstPlayerId, <uint>1, <uint>1, 0
    );
    state.applyCommands(deadApply, 1);
    if (<uint>state.offlineWeaponSkinLoadoutCodes[0] != <uint>1 ||
        <uint>state.entityWeaponSkinCodes[0] != <uint>1 ||
        <uint>state.entityWeaponSkinCodes[secondPlayerIndex] != <uint>1 ||
        !<bool>state.entityDead[0] || state.rngState != rngState ||
        state.rngDraws != rngDraws || state.rngDigest != rngDigest) {
        return -3;
    }

    var unownedApply = new CommandBatch();
    appendWeaponSkinApplyCommandForTest(
        unownedApply, firstPlayerId, <uint>1, <uint>2, 1
    );
    state.applyCommands(unownedApply, 1);
    state.offlineWeaponSkinOwned[1] = true;
    var mismatchedApply = new CommandBatch();
    appendWeaponSkinApplyCommandForTest(
        mismatchedApply, firstPlayerId, <uint>1, <uint>3, 1
    );
    state.applyCommands(mismatchedApply, 1);
    if (<uint>state.offlineWeaponSkinLoadoutCodes[1] != <uint>0 ||
        <uint>state.entityWeaponSkinCodes[0] != <uint>1) {
        return -4;
    }

    var detachSword = new CommandBatch();
    appendWeaponSkinDetachCommandForTest(
        detachSword, firstPlayerId, <uint>1, <uint>4, <uint>1
    );
    state.applyCommands(detachSword, 1);
    var repeatedDetach = new CommandBatch();
    appendWeaponSkinDetachCommandForTest(
        repeatedDetach, firstPlayerId, <uint>1, <uint>5, <uint>1
    );
    state.applyCommands(repeatedDetach, 1);
    if (<uint>state.entityWeaponSkinCodes[0] != <uint>0 ||
        <uint>state.entityWeaponSkinCodes[secondPlayerIndex] != <uint>0) {
        return -5;
    }
    var reapplySword = new CommandBatch();
    appendWeaponSkinApplyCommandForTest(
        reapplySword, firstPlayerId, <uint>1, <uint>6, 0
    );
    state.applyCommands(reapplySword, 1);
    setM5EquipmentItemCode(
        state, 0, "mainhand", m5Equipment.emptyMainhandStoredCode()
    );
    if (<uint>state.entityWeaponSkinCodes[0] != <uint>0 ||
        <uint>state.entityWeaponSkinCodes[secondPlayerIndex] != <uint>1) {
        return -6;
    }
    setM5EquipmentItemCode(state, 0, "mainhand", <uint>0);
    if (<uint>state.entityWeaponSkinCodes[0] != <uint>1) { return -7; }

    var hunterId = state.spawnPlayer(
        <uint>1, 20, 2.0, 1.5, 0.0, 100, 7.0, 1
    );
    var hunterIndex = state.entityIds.length - 1;
    setM5BaselineStatProfile(
        state, hunterIndex, m5ClassBaseline.classIndex("hunter")
    );
    var applyBow = new CommandBatch();
    appendWeaponSkinApplyCommandForTest(
        applyBow, hunterId, <uint>1, <uint>1, 6
    );
    state.applyCommands(applyBow, 1);
    var applyCrossbow = new CommandBatch();
    appendWeaponSkinApplyCommandForTest(
        applyCrossbow, hunterId, <uint>1, <uint>2, 13
    );
    state.applyCommands(applyCrossbow, 1);
    if (<uint>state.offlineWeaponSkinLoadoutCodes[6] != <uint>0 ||
        <uint>state.offlineWeaponSkinLoadoutCodes[7] != <uint>14 ||
        <uint>state.entityWeaponSkinCodes[hunterIndex] != <uint>14) {
        return -8;
    }
    state.offlineWeaponSkinLoadoutCodes[6] = <uint>7;
    refreshAllOfflineWeaponSkins(state);
    if (<uint>state.entityWeaponSkinCodes[hunterIndex] != <uint>14) { return -9; }
    var detachCrossbow = new CommandBatch();
    appendWeaponSkinDetachCommandForTest(
        detachCrossbow, hunterId, <uint>1, <uint>3, <uint>8
    );
    state.applyCommands(detachCrossbow, 1);
    if (<uint>state.entityWeaponSkinCodes[hunterIndex] != <uint>7 ||
        <uint>state.entityWeaponSkinCodes[0] != <uint>1) {
        return -10;
    }

    var restored = decodeState(encodeState(state));
    if (!offlineWeaponSkinStateIsValid(restored) ||
        !<bool>restored.offlineWeaponSkinOwned[0] ||
        !<bool>restored.offlineWeaponSkinOwned[6] ||
        <uint>restored.offlineWeaponSkinLoadoutCodes[0] != <uint>1 ||
        <uint>restored.offlineWeaponSkinLoadoutCodes[6] != <uint>7 ||
        <uint>restored.entityWeaponSkinCodes[hunterIndex] != <uint>7) {
        return -11;
    }
    var legacyWos82 = decodeState(encodeStateVersion(state, <uint>82));
    if (<bool>legacyWos82.offlineWeaponSkinOwned[0] ||
        <uint>legacyWos82.offlineWeaponSkinLoadoutCodes[0] != <uint>0 ||
        <uint>legacyWos82.entityWeaponSkinCodes[0] != <uint>0) {
        return -12;
    }

    var maximumPayload = new container.Array<uint>();
    maximumPayload.add(<uint>1);
    maximumPayload.add(<uint>0);
    maximumPayload.add(<uint>1);
    maximumPayload.add(<uint>0);
    maximumPayload.add(<uint>0);
    var maximumIndex = 0;
    while (maximumIndex < 256) {
        maximumPayload.add(<uint>120);
        maximumIndex = maximumIndex + 1;
    }
    if (!weaponSkinState.payloadShapeIsValid(
            <uint>0, <uint>maximumPayload.length, maximumPayload
        )) {
        return -13;
    }
    var oversizedPayload = new container.Array<uint>();
    oversizedPayload.add(<uint>1);
    oversizedPayload.add(<uint>1);
    oversizedPayload.add(<uint>1);
    oversizedPayload.add(<uint>0);
    oversizedPayload.add(<uint>0);
    var oversizedIndex = 0;
    while (oversizedIndex < 257) {
        oversizedPayload.add(<uint>120);
        oversizedIndex = oversizedIndex + 1;
    }
    if (weaponSkinState.payloadShapeIsValid(
            <uint>0, <uint>oversizedPayload.length, oversizedPayload
        )) {
        return -14;
    }
    var invalidUtf8Payload = new container.Array<uint>();
    invalidUtf8Payload.add(<uint>1);
    invalidUtf8Payload.add(<uint>2);
    invalidUtf8Payload.add(<uint>0);
    invalidUtf8Payload.add(<uint>0);
    invalidUtf8Payload.add(<uint>0);
    invalidUtf8Payload.add(<uint>192);
    invalidUtf8Payload.add(<uint>128);
    var invalidDetachPayload = new container.Array<uint>();
    invalidDetachPayload.add(<uint>0);
    invalidDetachPayload.add(<uint>9);
    return !weaponSkinState.payloadShapeIsValid(
            <uint>0, <uint>invalidUtf8Payload.length, invalidUtf8Payload
        ) && !weaponSkinState.payloadShapeIsValid(
            <uint>0, <uint>invalidDetachPayload.length, invalidDetachPayload
        ) && secondPlayerId != <uint>0 ? 1 : -15;
}

pub offlineTalentLoadoutCommandStateTest(): int {
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
