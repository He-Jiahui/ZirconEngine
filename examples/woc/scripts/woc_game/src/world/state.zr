pub offlineEastbrookCorpseQuestLootStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    var playerId = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 4.0, 100, 7.0, 1);
    var wildBoar = <uint>(campMobCore.indexOf("wild_boar", true) + 1);
    var boarId = state.spawnMob(wildBoar, 1, 0.0, 1.5, 0.0, 5, 8.0);
    state.offlineQuestBoarsState = <uint>1;
    rollOfflineEastbrookCorpseLoot(state, 1, 0);
    var boarHideCode = m5InventoryRules.itemCodeForId("boar_hide");
    var toughJerkyCode = m5InventoryRules.itemCodeForId("tough_jerky");
    var corpseCopper = <int>state.entityCorpseCopper[1];
    if (playerId == <uint>0 || boarId == <uint>0 ||
        <uint>state.rngDraws != <uint>5 ||
        corpseCopper <= 0 ||
        <uint>state.entityCorpseQuestItemCodes[1] != boarHideCode ||
        <uint>state.entityCorpseQuestItemCounts[1] != <uint>1 ||
        !<bool>state.entityLootable[1]) {
        return -1;
    }
    var restored = decodeState(encodeState(state));
    if (<int>restored.entityCorpseCopper[1] != corpseCopper ||
        <uint>restored.entityCorpseQuestItemCodes[1] != boarHideCode ||
        <uint>restored.entityCorpseQuestItemCounts[1] != <uint>1 ||
        !<bool>restored.entityLootable[1]) {
        return -2;
    }
    var sharedIndex = corpseSharedLootSlotIndex(1, 0);
    state.entityCorpseSharedItemCodes[sharedIndex] = toughJerkyCode;
    state.entityCorpseSharedItemCounts[sharedIndex] = <uint>1;
    state.entityDead[1] = true;
    state.entityTargetIds[0] = boarId;
    var payloads = %import("protocol/command_payloads");
    var loot = new CommandBatch();
    appendPartyTargetCommand(
        loot, payloads.lootCommandId(true), playerId, <uint>1, <uint>1, boarId
    );
    state.applyCommands(loot, 1);
    if (<int>state.entityInventoryCopper[0] != corpseCopper ||
        m5InventoryItemCount(state, 0, boarHideCode) != 1 ||
        m5InventoryItemCount(state, 0, toughJerkyCode) != 1 ||
        <int>state.entityCorpseCopper[1] != 0 ||
        <uint>state.entityCorpseQuestItemCodes[1] != <uint>0 ||
        <uint>state.entityCorpseQuestItemCounts[1] != <uint>0 ||
        <uint>state.entityCorpseSharedItemCodes[sharedIndex] != <uint>0 ||
        <uint>state.entityCorpseSharedItemCounts[sharedIndex] != <uint>0 ||
        <bool>state.entityLootable[1] || <uint>state.entityTargetIds[0] != <uint>0 ||
        state.offlineQuestBoarsObjectiveCount != <uint>1 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -3;
    }
    return 1;
}

