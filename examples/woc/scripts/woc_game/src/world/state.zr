startOfflineExorcismCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = exorcismAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("exorcism");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank != 1 || effects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        <float>state.entityResources[casterIndex] < cost ||
        exorcismTargetIndex(state, casterIndex, targetId) < 0) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0)
    );
    appendOfflineAbilityProjectile(
        state, <uint>state.entityIds[casterIndex], targetId,
        <float>state.entityX[casterIndex], <float>state.entityZ[casterIndex],
        effects.metric(abilityIndex, rank, 0, "min"), effects.metric(abilityIndex, rank, 0, "max"),
        projectileTravel.projectileSpeed(), false, OFFLINE_PROJECTILE_SCHOOL_HOLY, abilityCode,
        <uint>rank, 0.0
    );
}

landOfflineExorcismProjectile(
    state: WorldState, projectileIndex: int, casterIndex: int, targetIndex: int
): void {
    var abilityCode = exorcismAbilityCode();
    if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] != abilityCode) { return; }
    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) { enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex); return; }
    var result = new timedSpell.TimedSpellResult();
    result.randomUnits.add(nextAuthoritativeRandomUnit(state));
    result.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    spell.spellPower = <float>state.entitySpellPower[casterIndex];
    spell.school = "holy";
    spell.castTime = 0.0;
    spell.critChance = offlineDamageCritChance(state, casterIndex);
    timedSpell.resolveTimedSpellHit(result, spell);
    var damage = resolveOfflineFixedSpellImpactDamage(
        state, casterIndex, targetIndex, abilityCode, OFFLINE_PROJECTILE_SCHOOL_HOLY,
        result.damage, result.critical
    );
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (hp > 0) {
        state.setThreat(
            <uint>state.entityIds[targetIndex], <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) + <float>damage, 1
        );
    } else { settleOfflineEastbrookLethal(state, targetIndex, casterIndex); }
}

flameShockAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("flame_shock");
    var abilityIndex = m4AbilityCatalog.indexOf("flame_shock");
    if (code == <uint>0 || abilityIndex < 0 || m4AbilityCatalog.text(abilityIndex, "id") != "flame_shock") {
        throw "Flame Shock is absent from the current ability catalog";
    }
    return code;
}

flameShockPayloadAbilityIsExact(bytes: container.Array<uint>, offset: uint, length: uint): bool {
    return length == <uint>11 && <uint>bytes[<int>offset] == <uint>102 &&
        <uint>bytes[<int>(offset + <uint>1)] == <uint>108 && <uint>bytes[<int>(offset + <uint>2)] == <uint>97 &&
        <uint>bytes[<int>(offset + <uint>3)] == <uint>109 && <uint>bytes[<int>(offset + <uint>4)] == <uint>101 &&
        <uint>bytes[<int>(offset + <uint>5)] == <uint>95 && <uint>bytes[<int>(offset + <uint>6)] == <uint>115 &&
        <uint>bytes[<int>(offset + <uint>7)] == <uint>104 && <uint>bytes[<int>(offset + <uint>8)] == <uint>111 &&
        <uint>bytes[<int>(offset + <uint>9)] == <uint>99 && <uint>bytes[<int>(offset + <uint>10)] == <uint>107;
}

flameShockRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 8; }
    if (rank == <uint>2) { return 16; }
    return 0;
}

flameShockProjectileProfileIsValid(rank: uint, minimum: float, maximum: float, castTime: float): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("flame_shock");
    var level = flameShockRankLevel(rank);
    return abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rank &&
        effects.typeAt(abilityIndex, <int>rank, 0) == "directDamage" &&
        effects.typeAt(abilityIndex, <int>rank, 1) == "dot" &&
        minimum == effects.metric(abilityIndex, <int>rank, 0, "min") &&
        maximum == effects.metric(abilityIndex, <int>rank, 0, "max") && castTime == 0.0;
}

flameShockDotProfileIsValid(damage: int, duration: float, interval: float): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("flame_shock");
    var rank = 1;
    while (rank <= 2) {
        var level = flameShockRankLevel(<uint>rank);
        if (abilityIndex >= 0 && level > 0 &&
            m4AbilityCatalog.rankAtLevel(abilityIndex, level) == rank &&
            effects.typeAt(abilityIndex, rank, 1) == "dot") {
            var expectedDuration = effects.metric(abilityIndex, rank, 1, "duration");
            var expectedInterval = effects.metric(abilityIndex, rank, 1, "interval");
            var expectedDamage = <int>(effects.metric(abilityIndex, rank, 1, "total") /
                (expectedDuration / expectedInterval) + 0.5);
            if (expectedDamage < 1) { expectedDamage = 1; }
            if (damage == expectedDamage && duration == expectedDuration && interval == expectedInterval) { return true; }
        }
        rank = rank + 1;
    }
    return false;
}

flameShockTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) { return -1; }
    var range = m4AbilityCatalog.metric(m4AbilityCatalog.indexOf("flame_shock"), <int>state.entityLevels[casterIndex], "range");
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex]; var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ? targetIndex : -1;
}

