// Shadowburn preserves the source instant ordering: after admission it arms
// GCD and cooldown, bills its cost, then leaves the nonphysical bolt in flight.
shadowburnAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("shadowburn");
    var abilityIndex = m4AbilityCatalog.indexOf("shadowburn");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "shadowburn") {
        throw "Shadowburn is absent from the current ability catalog";
    }
    return code;
}

shadowburnPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>10 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>100 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>119 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>98 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>110;
