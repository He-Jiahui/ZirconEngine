    bytes.add(<uint>108); bytes.add(<uint>102);
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(typed, playerId, <uint>1, <uint>2, bytes);
    persisted.applyCommands(typed, 1);
    persisted.entityCastRemaining[0] = 0.05; stepRetainedCasting(persisted, 0, false);
    if (<int>persisted.entityResources[0] != 35 ||
        persisted.entityMotionAuraAbilityCodes.length != 0 ||
        <uint>persisted.entityLastCommandSequence[0] != <uint>2) { return -6; }
    persisted.entityCastGcdRemaining[0] = 0.0;
