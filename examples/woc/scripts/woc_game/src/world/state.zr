// Swiftmend is an instant helpful spell: source resolves it before the generic
// spell-projectile branch, pays cost/cooldown first, then consumes the oldest
// matching hot on the selected friendly target before it rolls the direct heal.
swiftmendAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("swiftmend");
    var abilityIndex = m4AbilityCatalog.indexOf("swiftmend");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "swiftmend") {
        throw "Swiftmend is absent from the current ability catalog";
    }
    return code;
}

swiftmendPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>9 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>119 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>100;
}

swiftmendProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 &&
        m4AbilityCatalog.text(abilityIndex, "id") == "swiftmend" &&
        m4AbilityCatalog.text(abilityIndex, "class") == "druid" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "nature" &&
        m4AbilityCatalog.text(abilityIndex, "targetType") == "friendly" &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == 1 &&
        m4AbilityCatalog.metric(abilityIndex, level, "learnLevel") == 10.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 55.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 8.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 30.0 &&
        m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        effects.count(abilityIndex, 1) == 1 &&
        effects.typeAt(abilityIndex, 1, 0) == "consumeAura" &&
        effects.consumeAuraIdAt(abilityIndex, 1, 0, 0) == "" &&
        effects.text(abilityIndex, 1, 0, "auraKind") == "hot" &&
        effects.metric(abilityIndex, 1, 0, "min") == 105.0 &&
        effects.metric(abilityIndex, 1, 0, "max") == 125.0;
}

swiftmendResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

swiftmendTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("swiftmend");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

swiftmendGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    return renewGlobalCooldownSeconds(state, casterIndex);
}

applyOfflineSwiftmendEffect(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    targetIndex: int,
    abilityIndex: int,
    rank: int
): void {
    var hotIndex = 0;
    while (hotIndex < state.offlineHotTargetIds.length &&
        <uint>state.offlineHotTargetIds[hotIndex] != targetId) {
        hotIndex = hotIndex + 1;
    }
    // The source leaves the cast paid and on cooldown when no matching aura
    // exists, and performs no range or critical draws in that case.
    if (hotIndex >= state.offlineHotTargetIds.length) { return; }
    removeOfflineRejuvenationHotAt(state, hotIndex);
    applyOfflineDirectHeal(state, casterIndex, targetId, targetIndex, abilityIndex, rank);
}

startOfflineSwiftmendCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = swiftmendAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("swiftmend");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = swiftmendResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank != 1 || !swiftmendProfileIsValid(abilityIndex, level) ||
        <int>state.entityResources[casterIndex] < cost || resolvedTargetIndex < 0 ||
        swiftmendTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = swiftmendGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0)
    );
    applyOfflineSwiftmendEffect(
        state,
        casterIndex,
        <uint>state.entityIds[resolvedTargetIndex],
        resolvedTargetIndex,
        abilityIndex,
        rank
    );
}

// This is deliberately the bounded retained PWS closure: it maps the generated
// instant friendly spell into the WOS65 aura row, while generic aura behavior
// and unsupported incoming damage sources remain outside this MVP slice.
startOfflinePowerWordShieldCast(
    state: WorldState, casterIndex: int, targetId: uint
): void {
    var abilityCode = powerWordShieldAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("power_word_shield");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = rejuvenationResolvedTargetIndex(state, casterIndex, targetId);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || <int>state.entityResources[casterIndex] < cost ||
        resolvedTargetIndex < 0 || powerWordShieldTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var profile = absorbProfiles.resolveAbsorbProfile(abilityIndex, rank);
    if (!profile.valid) { throw "woc Power Word Shield profile is invalid"; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rejuvenationGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;
    setAbilityCooldownExpiration(state, casterIndex, abilityCode, state.timeMicros + <uint>6000000);
    applyOfflinePowerWordShield(
        state,
        <uint>state.entityIds[resolvedTargetIndex],
        <uint>state.entityIds[casterIndex],
        abilityCode,
        rank
    );
}

