        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rankCode &&
        effects.typeAt(abilityIndex, <int>rankCode, 0) == "heal";
}

// The source accepts non-hostile players and a player's owned pet. The retained
// world has no PvP-controller or special encounter friendliness layer, so this
// projection admits exactly the player/pet forms represented by its state rows.
lesserHealFriendlyTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || targetIndex < 0 ||
        <bool>state.entityDead[targetIndex]) {
        return -1;
    }
    if (<uint>state.entityKinds[targetIndex] == <uint>1) {
        return !<bool>state.entityHostile[targetIndex] ? targetIndex : -1;
    }
    if (<uint>state.entityKinds[targetIndex] == <uint>2 &&
        <uint>state.entityOwnerIds[targetIndex] != <uint>0) {
        var ownerIndex = partyEntityIndexById(
            state, <uint>state.entityOwnerIds[targetIndex]
        );
        if (ownerIndex >= 0 && <uint>state.entityKinds[ownerIndex] == <uint>1 &&
            !<bool>state.entityHostile[ownerIndex]) {
            return targetIndex;
        }
    }
    return -1;
}

// Resolve source-friendly precedence before range validation: an out-of-range
// explicit target is a failed cast, not a reason to fall back to the current
// target or caster.
lesserHealResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

lesserHealTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("lesser_heal");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    // Source threshold: Math.max(range, 5.0) + 2.0. The retained outdoor
    // subset has no line-of-sight blockers for friendly casts.
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

lesserHealCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

lesserHealGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 1.0 ? 1.0 : gcd;
}

startOfflineLesserHealCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = lesserHealAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("lesser_heal");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = lesserHealResolvedTargetIndex(state, casterIndex, targetId);
    if (rank <= 0 || !lesserHealProfileIsValid(<uint>rank) ||
        <int>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        resolvedTargetIndex < 0 || lesserHealTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        lesserHealCastSeconds(state, casterIndex, abilityIndex),
        lesserHealGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>state.entityIds[resolvedTargetIndex];
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineLesserHealCast(state: WorldState, casterIndex: int): void {
    var abilityIndex = m4AbilityCatalog.indexOf("lesser_heal");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = lesserHealTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || !lesserHealProfileIsValid(<uint>rank) ||
        <int>state.entityResources[casterIndex] < cost) {
        return;
    }
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;

    // The source consumes its range draw inside the effect dispatcher, then its
    // heal-crit draw in applyHeal. Keep the authoritative stream in that order.
    var numeric = new numericEffects.NumericDispatchState();
    numeric.source.id = <uint>state.entityIds[casterIndex];
    numeric.source.level = level;
    numeric.source.spellPower = <float>state.entitySpellPower[casterIndex];
    numeric.target.id = targetId;
    numeric.target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ?
        "player" : "mob";
    numeric.target.hostileToSource = false;
    numeric.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (numericEffects.dispatchNumericAbility(numeric, abilityIndex, rank, 0) != 1 ||
        numeric.healAmounts.length != 1 || <uint>numeric.healTargetIds[0] != targetId) {
        return;
    }

    var source = new healState.HealEntity();
    source.id = <uint>state.entityIds[casterIndex];
    source.kind = "player";
    source.dead = <bool>state.entityDead[casterIndex];
    source.hp = <int>state.entityHp[casterIndex];
    source.maxHp = <int>state.entityMaxHp[casterIndex];
    source.spellCritChance = <float>state.entityCritChance[casterIndex];
    var target = new healState.HealEntity();
    target.id = targetId;
    target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ? "player" : "mob";
    target.dead = <bool>state.entityDead[targetIndex];
    target.hp = <int>state.entityHp[targetIndex];
    target.maxHp = <int>state.entityMaxHp[targetIndex];

    var mobs = new healState.AwareMobProjection();
    var mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        var threatStart = <int><uint>state.entityThreatOffsets[mobIndex];
        var threatEnd = <int><uint>state.entityThreatOffsets[mobIndex + 1];
        var directTargetEntry = false;
        var ownedPetEntry = false;
        var threatIndex = threatStart;
        while (threatIndex < threatEnd) {
            var threatTargetId = <uint>state.entityThreatTargetIds[threatIndex];
            if (threatTargetId == targetId) { directTargetEntry = true; }
            if (target.kind == "player") {
                var threatTargetIndex = partyEntityIndexById(state, threatTargetId);
                if (threatTargetIndex >= 0 &&
                    <uint>state.entityOwnerIds[threatTargetIndex] == targetId) {
                    ownedPetEntry = true;
                }
            }
            threatIndex = threatIndex + 1;
        }
        mobs.addMob(
            <bool>state.entityDead[mobIndex],
            <uint>state.entityKinds[mobIndex] == <uint>2 &&
                <bool>state.entityHostile[mobIndex],
            <bool>state.entityInCombat[mobIndex],
            threatEnd > threatStart,
            directTargetEntry,
            ownedPetEntry
        );
        mobIndex = mobIndex + 1;
    }
    var events = new healState.HealEvents();
    events.randomUnits.add(nextAuthoritativeRandomUnit(state));
    healState.applyHeal(source, target, <float>numeric.healAmounts[0], mobs, events);
    state.entityHp[targetIndex] = target.hp;

    mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        if (<float>mobs.healerThreat[mobIndex] > 0.0) {
            state.setThreat(
                <uint>state.entityIds[mobIndex],
                <uint>state.entityIds[casterIndex],
                stateThreatValue(state, mobIndex, <uint>state.entityIds[casterIndex]) +
                    <float>mobs.healerThreat[mobIndex],
                1
            );
        }
        mobIndex = mobIndex + 1;
    }
}

// All retained direct friendly heals share this source ordering: the generated
// range/scaling draw is consumed before the healing kernel's critical draw.
// Each caller remains responsible for source-specific target, rank and cost gates.
applyOfflineDirectHeal(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    targetIndex: int,
    abilityIndex: int,
    rank: int
): void {
    var effects = %import("generated/m4_ability_effects");
    var level = <int>state.entityLevels[casterIndex];
    var numeric = new numericEffects.NumericDispatchState();
    numeric.source.id = <uint>state.entityIds[casterIndex];
    numeric.source.level = level;
    numeric.source.spellPower = <float>state.entitySpellPower[casterIndex];
    numeric.target.id = targetId;
    numeric.target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ?
        "player" : "mob";
    numeric.target.hostileToSource = false;
    // consumeAura effects are admitted by the world queue first. Mirror that
    // selected hot row here so the generic numeric dispatcher removes it before
    // drawing Swiftmend's range and the shared healing kernel draws its crit.
    if (effects.typeAt(abilityIndex, rank, 0) == "consumeAura") {
        if (effects.text(abilityIndex, rank, 0, "auraKind") != "hot") { return; }
        numeric.target.auraIds.add("woc_selected_hot");
        numeric.target.auraKinds.add("hot");
        numeric.target.auraValues.add(0.0);
        numeric.target.auraValues2.add(0.0);
        numeric.target.auraValues3.add(0.0);
        numeric.target.auraHasJudgement.add(false);
    }
    numeric.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (numericEffects.dispatchNumericAbility(numeric, abilityIndex, rank, 0) != 1 ||
        numeric.healAmounts.length != 1 || <uint>numeric.healTargetIds[0] != targetId) {
        return;
    }

    var source = new healState.HealEntity();
    source.id = <uint>state.entityIds[casterIndex];
    source.kind = "player";
    source.dead = <bool>state.entityDead[casterIndex];
    source.hp = <int>state.entityHp[casterIndex];
    source.maxHp = <int>state.entityMaxHp[casterIndex];
    source.spellCritChance = <float>state.entityCritChance[casterIndex];
    var target = new healState.HealEntity();
    target.id = targetId;
    target.kind = <uint>state.entityKinds[targetIndex] == <uint>1 ? "player" : "mob";
    target.dead = <bool>state.entityDead[targetIndex];
    target.hp = <int>state.entityHp[targetIndex];
    target.maxHp = <int>state.entityMaxHp[targetIndex];

    var mobs = new healState.AwareMobProjection();
    var mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        var threatStart = <int><uint>state.entityThreatOffsets[mobIndex];
        var threatEnd = <int><uint>state.entityThreatOffsets[mobIndex + 1];
        var directTargetEntry = false;
        var ownedPetEntry = false;
        var threatIndex = threatStart;
        while (threatIndex < threatEnd) {
            var threatTargetId = <uint>state.entityThreatTargetIds[threatIndex];
            if (threatTargetId == targetId) { directTargetEntry = true; }
            if (target.kind == "player") {
                var threatTargetIndex = partyEntityIndexById(state, threatTargetId);
                if (threatTargetIndex >= 0 &&
                    <uint>state.entityOwnerIds[threatTargetIndex] == targetId) {
                    ownedPetEntry = true;
                }
            }
            threatIndex = threatIndex + 1;
        }
        mobs.addMob(
            <bool>state.entityDead[mobIndex],
            <uint>state.entityKinds[mobIndex] == <uint>2 &&
                <bool>state.entityHostile[mobIndex],
            <bool>state.entityInCombat[mobIndex],
            threatEnd > threatStart,
            directTargetEntry,
            ownedPetEntry
        );
        mobIndex = mobIndex + 1;
    }
    var events = new healState.HealEvents();
    events.randomUnits.add(nextAuthoritativeRandomUnit(state));
    healState.applyHeal(source, target, <float>numeric.healAmounts[0], mobs, events);
    state.entityHp[targetIndex] = target.hp;

    mobIndex = 0;
    while (mobIndex < state.entityIds.length) {
        if (<float>mobs.healerThreat[mobIndex] > 0.0) {
            state.setThreat(
                <uint>state.entityIds[mobIndex],
                <uint>state.entityIds[casterIndex],
                stateThreatValue(state, mobIndex, <uint>state.entityIds[casterIndex]) +
                    <float>mobs.healerThreat[mobIndex],
                1
            );
        }
        mobIndex = mobIndex + 1;
    }
}

healAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("heal");
    var abilityIndex = m4AbilityCatalog.indexOf("heal");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "heal") {
        throw "Heal is absent from the current ability catalog";
    }
    return code;
}

healPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>4 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>108;
}

healResolvedTargetIndex(state: WorldState, casterIndex: int, overrideId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, overrideId);
    if (targetIndex >= 0) { return targetIndex; }
    targetIndex = lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityTargetIds[casterIndex]
    );
    if (targetIndex >= 0) { return targetIndex; }
    return lesserHealFriendlyTargetIndex(
        state, casterIndex, <uint>state.entityIds[casterIndex]
    );
}

healTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("heal");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    return dx * dx + dz * dz <=
        (rangeWithMinimum + 2.0) * (rangeWithMinimum + 2.0) ? targetIndex : -1;
}

healCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

healGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineHealCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = healAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("heal");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var resolvedTargetIndex = healResolvedTargetIndex(state, casterIndex, targetId);
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "heal" ||
        <int>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        resolvedTargetIndex < 0 || healTargetIndex(
            state, casterIndex, <uint>state.entityIds[resolvedTargetIndex]
        ) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        healCastSeconds(state, casterIndex, abilityIndex),
        healGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = <uint>state.entityIds[resolvedTargetIndex];
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineHealCast(state: WorldState, casterIndex: int): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("heal");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = healTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "heal" ||
        <int>state.entityResources[casterIndex] < cost) {
        return;
    }
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;
    applyOfflineDirectHeal(state, casterIndex, targetId, targetIndex, abilityIndex, rank);
}

// Healing Touch is the Druid's four-rank friendly Nature hard cast. It shares
// the retained direct-heal kernel while keeping its source profile separate.
healingTouchAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("healing_touch");
    var abilityIndex = m4AbilityCatalog.indexOf("healing_touch");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "healing_touch") {
