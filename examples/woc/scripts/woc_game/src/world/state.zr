            writer.u64(<uint>state.offlineRewindDamageTargetIds[rewindDamageIndex], 1, 1, 2, 4);
            writer.u64(<uint>state.offlineRewindDamageTicks[rewindDamageIndex], 1, 1, 2, 4);
            writer.u32(<uint>state.offlineRewindDamageAmounts[rewindDamageIndex], 1, 1, 2);
            rewindDamageIndex = rewindDamageIndex + 1;
        }
    }
    if (!offlineNaturesFuryStateIsValid(state)) {
        throw "woc Nature's Fury state is invalid";
    }
    if (schemaVersion < <uint>106 && state.offlineNaturesFuryTargetIds.length != 0) {
        throw "woc Nature's Fury state cannot be encoded by a historical schema";
    }
    if (schemaVersion >= <uint>106) {
        writer.u16(<uint>state.offlineNaturesFuryTargetIds.length, 1, 1);
        var naturesFuryIndex = 0;
        while (naturesFuryIndex < state.offlineNaturesFuryTargetIds.length) {
            writer.u64(<uint>state.offlineNaturesFuryTargetIds[naturesFuryIndex], 1, 1, 2, 4);
            writer.u64(<uint>state.offlineNaturesFurySourceIds[naturesFuryIndex], 1, 1, 2, 4);
            writer.fixed6(<float>state.offlineNaturesFuryValues[naturesFuryIndex], 1, 1, 2, 3, 5, 8);
            writer.fixed6(<float>state.offlineNaturesFuryRemaining[naturesFuryIndex], 1, 1, 2, 3, 5, 8);
            naturesFuryIndex = naturesFuryIndex + 1;
        }
    }
    if (!aetherSurgeStateIsValid(state)) {
        throw "woc Aether Surge state is invalid";
    }
    if (schemaVersion < <uint>98 && !aetherSurgeStateIsLegacyCompatible(state)) {
        throw "woc Aether Surge state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>100 &&
        !aetherSurgePerfectMomentStateIsLegacyCompatible(state)) {
        throw "woc Perfect Moment state cannot be encoded by a historical schema";
    }
    if (schemaVersion >= <uint>98) {
        var aetherSurgeIndex = 0;
        while (aetherSurgeIndex < entityCount) {
            writer.byte(<uint>state.entityAetherSurgeCharges[aetherSurgeIndex], 1);
            writer.fixed6(
                <float>state.entityAetherSurgeChargeRemaining[aetherSurgeIndex],
                1, 1, 2, 3, 5, 8
            );
            writer.fixed6(
                <float>state.entityAetherSurgeFreeRemaining[aetherSurgeIndex],
                1, 1, 2, 3, 5, 8
            );
            if (schemaVersion >= <uint>100) {
                writer.fixed6(
                    <float>state.entityAetherSurgePerfectMomentRemaining[aetherSurgeIndex],
                    1, 1, 2, 3, 5, 8
                );
            }
            aetherSurgeIndex = aetherSurgeIndex + 1;
        }
    }
    if (!aetherDartsStateIsValid(state)) {
        throw "woc Aether Darts state is invalid";
    }
    if (schemaVersion < <uint>99 && !aetherDartsStateIsLegacyCompatible(state)) {
        throw "woc Aether Darts state cannot be encoded by a historical schema";
    }
    if (schemaVersion >= <uint>99) {
        var aetherDartsIndex = 0;
        while (aetherDartsIndex < entityCount) {
            writer.byte(
                <bool>state.entityAetherDartsConsumePending[aetherDartsIndex] ?
                    <uint>1 : <uint>0,
                1
            );
            writer.byte(<uint>state.entityAetherDartsBonusPerBolt[aetherDartsIndex], 1);
            writer.byte(<uint>state.entityAetherDartsTicks[aetherDartsIndex], 1);
            aetherDartsIndex = aetherDartsIndex + 1;
        }
    }
    if (!groupHasteStateIsValid(state)) {
        throw "woc group haste state is invalid";
    }
    if (schemaVersion < <uint>101 && !groupHasteStateIsLegacyCompatible(state)) {
        throw "woc group haste state cannot be encoded by a historical schema";
    }
    if (schemaVersion >= <uint>101) {
        var groupHasteIndex = 0;
        while (groupHasteIndex < entityCount) {
            writer.fixed6(
                <float>state.entityGroupHasteRemaining[groupHasteIndex], 1, 1, 2, 3, 5, 8
            );
            writer.fixed6(
                <float>state.entityGroupHasteAttackBonuses[groupHasteIndex], 1, 1, 2, 3, 5, 8
            );
            writer.fixed6(
                <float>state.entityGroupHasteSpellBonuses[groupHasteIndex], 1, 1, 2, 3, 5, 8
            );
            writer.fixed6(
                <float>state.entitySatedRemaining[groupHasteIndex], 1, 1, 2, 3, 5, 8
            );
            groupHasteIndex = groupHasteIndex + 1;
        }
    }
    if (!temporalHourglassStateIsValid(state)) {
        throw "woc Temporal Hourglass state is invalid";
    }
    if (schemaVersion < <uint>102 && !temporalHourglassStateIsLegacyCompatible(state)) {
        throw "woc Temporal Hourglass state cannot be encoded by a historical schema";
    }
    if (schemaVersion == <uint>102 && !temporalHourglassStateIsSchema102Compatible(state)) {
        throw "woc Temporal Hourglass ground state cannot be encoded by schema 102";
    }
    if (schemaVersion >= <uint>102) {
        var hourglassIndex = 0;
        while (hourglassIndex < entityCount) {
            writer.fixed6(
                <float>state.entityTemporalHourglassRemaining[hourglassIndex],
                1, 1, 2, 3, 5, 8
            );
            writer.byte(<uint>state.entityTemporalHourglassModes[hourglassIndex], 1);
            writer.fixed6(
                <float>state.entityTemporalHourglassCooldownRates[hourglassIndex],
                1, 1, 2, 3, 5, 8
            );
            writer.u32(
                <uint><int>state.entityTemporalHourglassHealRemaining[hourglassIndex], 1, 1, 2
            );
            writer.byte(
                <uint><int>state.entityTemporalHourglassHealTicksRemaining[hourglassIndex], 1
            );
            writer.fixed6(
                <float>state.entityTemporalHourglassHealTickTimers[hourglassIndex],
                1, 1, 2, 3, 5, 8
            );
            hourglassIndex = hourglassIndex + 1;
        }
        writer.u16(<uint>state.offlineTemporalHourglassSourceIds.length, 1, 1);
        var groundHourglassIndex = 0;
        while (groundHourglassIndex < state.offlineTemporalHourglassSourceIds.length) {
            writer.u64(
                <uint>state.offlineTemporalHourglassSourceIds[groundHourglassIndex], 1, 1, 2, 4
            );
            writer.fixed6(
                <float>state.offlineTemporalHourglassX[groundHourglassIndex], 1, 1, 2, 3, 5, 8
            );
            writer.fixed6(
                <float>state.offlineTemporalHourglassZ[groundHourglassIndex], 1, 1, 2, 3, 5, 8
            );
            writer.fixed6(
                <float>state.offlineTemporalHourglassRadii[groundHourglassIndex], 1, 1, 2, 3, 5, 8
            );
            writer.fixed6(
                <float>state.offlineTemporalHourglassRemaining[groundHourglassIndex],
                1, 1, 2, 3, 5, 8
            );
            if (schemaVersion >= <uint>103) {
                writer.fixed6(
                    <float>state.offlineTemporalHourglassProtectiveDurations[groundHourglassIndex],
                    1, 1, 2, 3, 5, 8
                );
                writer.fixed6(
                    <float>state.offlineTemporalHourglassHostilePveDurations[groundHourglassIndex],
                    1, 1, 2, 3, 5, 8
                );
                writer.fixed6(
                    <float>state.offlineTemporalHourglassHostilePvpDurations[groundHourglassIndex],
                    1, 1, 2, 3, 5, 8
                );
                writer.fixed6(
                    <float>state.offlineTemporalHourglassHealFractions[groundHourglassIndex],
                    1, 1, 2, 3, 5, 8
                );
                writer.fixed6(
                    <float>state.offlineTemporalHourglassSelfCooldownRates[groundHourglassIndex],
                    1, 1, 2, 3, 5, 8
                );
                writer.fixed6(
                    <float>state.offlineTemporalHourglassAllyCooldownRates[groundHourglassIndex],
                    1, 1, 2, 3, 5, 8
                );
                writer.u64(
                    <uint>state.offlineTemporalHourglassCreatedTicks[groundHourglassIndex],
                    1, 1, 2, 4
                );
            }
            groundHourglassIndex = groundHourglassIndex + 1;
        }
    }
    if (!offlineAbilityChargeStateIsValid(state)) {
        throw "woc ability charge state is invalid";
    }
    if (schemaVersion >= <uint>114) {
        writer.u16(<uint>state.offlineAbilityChargeEntityIds.length, 1, 1);
        var abilityChargeIndex = 0;
        while (abilityChargeIndex < state.offlineAbilityChargeEntityIds.length) {
            writer.u64(<uint>state.offlineAbilityChargeEntityIds[abilityChargeIndex], 1, 1, 2, 4);
            writer.u16(<uint>state.offlineAbilityChargeCodes[abilityChargeIndex], 1, 1);
            writer.byte(<uint><int>state.offlineAbilityChargeCounts[abilityChargeIndex], 1);
            writer.byte(<uint><int>state.offlineAbilityChargeMaximums[abilityChargeIndex], 1);
            writer.fixed6(
                <float>state.offlineAbilityChargeRechargeLengths[abilityChargeIndex],
                1, 1, 2, 3, 5, 8
            );
            var timerStart = <int><uint>state.offlineAbilityChargeRechargeOffsets[
                abilityChargeIndex
            ];
            var timerEnd = <int><uint>state.offlineAbilityChargeRechargeOffsets[
                abilityChargeIndex + 1
            ];
            writer.byte(<uint>(timerEnd - timerStart), 1);
            while (timerStart < timerEnd) {
                writer.fixed6(
                    <float>state.offlineAbilityChargeRechargeRemaining[timerStart],
                    1, 1, 2, 3, 5, 8
                );
                timerStart = timerStart + 1;
            }
            abilityChargeIndex = abilityChargeIndex + 1;
        }
    }
    if (!offlineHunterTrapStateIsValid(state)) {
        throw "woc Hunter trap state is invalid";
    }
    if (schemaVersion >= <uint>115) {
        writer.u16(<uint>state.offlineHunterTrapSourceIds.length, 1, 1);
        var hunterTrapIndex = 0;
        while (hunterTrapIndex < state.offlineHunterTrapSourceIds.length) {
            writer.u64(<uint>state.offlineHunterTrapSourceIds[hunterTrapIndex], 1, 1, 2, 4);
            writer.u16(<uint>state.offlineHunterTrapAbilityCodes[hunterTrapIndex], 1, 1);
            writer.fixed6(<float>state.offlineHunterTrapX[hunterTrapIndex], 1, 1, 2, 3, 5, 8);
            writer.fixed6(<float>state.offlineHunterTrapZ[hunterTrapIndex], 1, 1, 2, 3, 5, 8);
            writer.fixed6(<float>state.offlineHunterTrapRadii[hunterTrapIndex], 1, 1, 2, 3, 5, 8);
            writer.fixed6(<float>state.offlineHunterTrapRemaining[hunterTrapIndex], 1, 1, 2, 3, 5, 8);
            writer.fixed6(<float>state.offlineHunterTrapArmRemaining[hunterTrapIndex], 1, 1, 2, 3, 5, 8);
            writer.fixed6(<float>state.offlineHunterTrapFreezeDurations[hunterTrapIndex], 1, 1, 2, 3, 5, 8);
            hunterTrapIndex = hunterTrapIndex + 1;
        }
    }
    if (!offlineLeanQuiverStateIsValid(state)) {
        throw "woc Lean Quiver proc state is invalid";
    }
    if (schemaVersion >= <uint>116) {
        writer.u16(<uint>state.offlineLeanQuiverEntityIds.length, 1, 1);
        var leanQuiverIndex = 0;
        while (leanQuiverIndex < state.offlineLeanQuiverEntityIds.length) {
            writer.u64(<uint>state.offlineLeanQuiverEntityIds[leanQuiverIndex], 1, 1, 2, 4);
            writer.byte(<uint><int>state.offlineLeanQuiverCounters[leanQuiverIndex], 1);
            leanQuiverIndex = leanQuiverIndex + 1;
        }
    }
    if (!offlineRedlineDrawStateIsValid(state)) {
        throw "woc Redline Draw proc state is invalid";
    }
    if (schemaVersion >= <uint>117) {
        writer.u16(<uint>state.offlineRedlineDrawEntityIds.length, 1, 1);
        var redlineDrawIndex = 0;
        while (redlineDrawIndex < state.offlineRedlineDrawEntityIds.length) {
            writer.u64(<uint>state.offlineRedlineDrawEntityIds[redlineDrawIndex], 1, 1, 2, 4);
            writer.byte(<uint><int>state.offlineRedlineDrawCounters[redlineDrawIndex], 1);
            writer.fixed6(
                <float>state.offlineRedlineDrawIcdRemaining[redlineDrawIndex],
                1, 1, 2, 3, 5, 8
            );
            redlineDrawIndex = redlineDrawIndex + 1;
        }
    }
    if (!offlineDeathlessWillStateIsValid(state)) {
        throw "woc Deathless Will proc state is invalid";
    }
    if (schemaVersion >= <uint>118) {
        writer.u16(<uint>state.offlineDeathlessWillEntityIds.length, 1, 1);
        var deathlessWillIndex = 0;
        while (deathlessWillIndex < state.offlineDeathlessWillEntityIds.length) {
            writer.u64(<uint>state.offlineDeathlessWillEntityIds[deathlessWillIndex], 1, 1, 2, 4);
            writer.fixed6(
                <float>state.offlineDeathlessWillIcdRemaining[deathlessWillIndex],
                1, 1, 2, 3, 5, 8
            );
            deathlessWillIndex = deathlessWillIndex + 1;
        }
    }
    return writer.finish(true);
}

encodeState(state: WorldState): container.Array<uint> {
    return encodeStateVersion(state, <uint>118);
}

// Capturing the profile and school makes a snapshot restore land with the
// source launch closure, while live attacker values (power, hit and crit)
// remain source-consistent landing-time reads.
offlineProjectileStateIsValid(state: WorldState): bool {
    var effects = %import("generated/m4_ability_effects");
    var count = state.offlineProjectileSourceIds.length;
    if (count != state.offlineProjectileTargetIds.length ||
        count != state.offlineProjectileX.length ||
        count != state.offlineProjectileZ.length ||
        count != state.offlineProjectileTtls.length ||
        count != state.offlineProjectileWands.length ||
        count != state.offlineProjectileSchoolCodes.length ||
        count != state.offlineProjectileMinimums.length ||
        count != state.offlineProjectileMaximums.length ||
        count != state.offlineProjectileSpeeds.length ||
        count != state.offlineProjectileAbilityCodes.length ||
        count != state.offlineProjectileRanks.length ||
        count != state.offlineProjectileCastTimes.length ||
        count != state.offlineProjectileTalentSpecCodes.length ||
        state.offlineProjectileTalentRowOptionCodes.length != count * 6 ||
        count != state.offlineProjectileDotTotals.length ||
        count != state.offlineProjectileFixedDamages.length ||
        count != state.offlineProjectileCriticals.length ||
        count > <int>OFFLINE_PROJECTILE_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        if (<uint>state.offlineProjectileSourceIds[index] == <uint>0 ||
            <uint>state.offlineProjectileTargetIds[index] == <uint>0 ||
            <uint>state.offlineProjectileSourceIds[index] ==
                <uint>state.offlineProjectileTargetIds[index] ||
            <float>state.offlineProjectileTtls[index] <= 0.0 ||
            <float>state.offlineProjectileTtls[index] > projectileTravel.projectileMaxFlight()) {
            return false;
        }
        var wand = <bool>state.offlineProjectileWands[index];
        var school = <uint>state.offlineProjectileSchoolCodes[index];
        var abilityCode = <uint>state.offlineProjectileAbilityCodes[index];
        var rank = <uint>state.offlineProjectileRanks[index];
        var castTime = <float>state.offlineProjectileCastTimes[index];
        var dotTotal = <float>state.offlineProjectileDotTotals[index];
        var fixedDamage = <int>state.offlineProjectileFixedDamages[index];
        var critical = <bool>state.offlineProjectileCriticals[index];
        if (fixedDamage < 0 || fixedDamage > 65535) { return false; }
        if (fixedDamage > 0) {
            if (wand || abilityCode == <uint>0 || rank == <uint>0 ||
                !knownAbilityCatalog.abilityExists(<int>abilityCode) ||
                school != offlineAbilitySchoolCode(abilityCode) ||
                <float>state.offlineProjectileMinimums[index] != 0.0 ||
                <float>state.offlineProjectileMaximums[index] != 0.0 ||
                <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed() ||
                castTime != 0.0 || dotTotal != 0.0 ||
                !offlineProjectileTalentSnapshotIsEmpty(state, index)) {
                return false;
            }
            index = index + 1;
            continue;
        }
        if (critical) { return false; }
        if (dotTotal < 0.0 ||
            (abilityCode != fireballAbilityCode() && abilityCode != pyroblastAbilityCode() &&
                dotTotal != 0.0)) {
            return false;
        }
        if (!offlineTalentDirectDamageProjectileRangeIsValid(state, index)) {
            return false;
        }
        if (abilityCode == aimedShotAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL ||
                !aimedShotProjectileProfileIsValid(state, index) ||
                <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == arcaneShotAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
                !arcaneShotProjectileProfileIsValid(state, index) ||
                <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == frostboltAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FROST ||
                !frostboltProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == shadowBoltAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !shadowBoltProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == wrathAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !wrathProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == starfireAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
                !starfireProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == entanglingRootsAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !entanglingRootsProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == searingPainAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                !searingPainProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == shadowburnAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !shadowburnProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == conflagrateAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                !conflagrateProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == immolateAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                !immolateProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == fireballAbilityCode()) {
            var fireballIndex = m4AbilityCatalog.indexOf("fireball");
            var normalFireball = fireballIndex >= 0 &&
                dotTotal == effects.metric(fireballIndex, <int>rank, 1, "total") &&
                fireballProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                );
            var overloadFireball = fireballIndex >= 0 &&
                dotTotal == offlineOverloadScaledPositiveMetric(
                    effects.metric(fireballIndex, <int>rank, 1, "total"), 1.4
                ) && fireballProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                );
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                (!normalFireball && !overloadFireball) ||
                <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == pyroblastAbilityCode()) {
            var pyroblastIndex = m4AbilityCatalog.indexOf("pyroblast");
            var normalPyroblast = pyroblastIndex >= 0 &&
                dotTotal == effects.metric(pyroblastIndex, <int>rank, 1, "total") &&
                pyroblastProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                );
            var overloadPyroblast = pyroblastIndex >= 0 &&
                dotTotal == offlineOverloadScaledPositiveMetric(
                    effects.metric(pyroblastIndex, <int>rank, 1, "total"), 1.4
                ) && pyroblastProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                );
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                (!normalPyroblast && !overloadPyroblast) ||
                <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == earthShockAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !earthShockProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == exorcismAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_HOLY ||
                !exorcismProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == frostShockAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FROST ||
                !frostShockProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == flameShockAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
                !flameShockProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == moonfireAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
                !moonfireProjectileProfileIsValid(
                    rank,
                    offlineTalentDirectDamageProfileMinimum(state, index),
                    offlineTalentDirectDamageProfileMaximum(state, index),
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == serpentStingAbilityCode() ||
            abilityCode == insectSwarmAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !pureDotProjectileProfileIsValid(
                    abilityCode,
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == shadowWordPainAbilityCode() ||
            abilityCode == corruptionAbilityCode() ||
            abilityCode == curseOfAgonyAbilityCode() ||
            abilityCode == siphonLifeAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !pureDotProjectileProfileIsValid(
                    abilityCode,
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == drainLifeAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !drainLifeProjectileShapeIsValid(rank, castTime) ||
                !offlineTalentDrainTickProjectileRangeIsValid(state, index) ||
                <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == mindFlayAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !mindFlayProjectileShapeIsValid(rank, castTime) ||
                !offlineTalentDrainTickProjectileRangeIsValid(state, index) ||
                <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == hibernateAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
                !hibernateProjectileProfileIsValid(rank, castTime) ||
                <float>state.offlineProjectileMinimums[index] != 0.0 ||
                <float>state.offlineProjectileMaximums[index] != 0.0 ||
                <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode == fearAbilityCode()) {
            if (wand || school != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
                !fearProjectileProfileIsValid(
                    rank,
                    <float>state.offlineProjectileMinimums[index],
                    <float>state.offlineProjectileMaximums[index],
                    castTime
                ) || <float>state.offlineProjectileSpeeds[index] !=
                    projectileTravel.projectileSpeed()) {
                return false;
            }
        } else if (abilityCode != <uint>0 || rank != <uint>0 || castTime != 0.0) {
            return false;
        } else if (offlineEmberkinFireboltProjectileProfileIsValid(state, index)) {
            // Emberkin Firebolt is an ability-code-zero spell projectile. The
            // template-owned source profile disambiguates it from player shots.
        } else if (wand) {
            if (school != OFFLINE_PROJECTILE_SCHOOL_ARCANE &&
                school != OFFLINE_PROJECTILE_SCHOOL_HOLY &&
                school != OFFLINE_PROJECTILE_SCHOOL_SHADOW &&
                school != OFFLINE_PROJECTILE_SCHOOL_NATURE) {
                return false;
            }
            if (<float>state.offlineProjectileMinimums[index] != 3.0 ||
                <float>state.offlineProjectileMaximums[index] != 6.0 ||
                <float>state.offlineProjectileSpeeds[index] != 1.8) {
                return false;
            }
        } else if (school != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL ||
            <float>state.offlineProjectileMinimums[index] != 5.0 ||
            <float>state.offlineProjectileMaximums[index] != 9.0 ||
            <float>state.offlineProjectileSpeeds[index] != 2.3) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

offlineCritVulnStateIsValid(state: WorldState): bool {
    var count = state.offlineCritVulnTargetIds.length;
    if (count != state.offlineCritVulnSourceIds.length ||
        count != state.offlineCritVulnValues.length ||
        count != state.offlineCritVulnRemaining.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineCritVulnTargetIds[index];
        var sourceId = <uint>state.offlineCritVulnSourceIds[index];
        var value = <float>state.offlineCritVulnValues[index];
        var remaining = <float>state.offlineCritVulnRemaining[index];
        if (abilityCode == hemorrhageAbilityCode()) {
            var duplicate = 0;
            while (duplicate < index) {
                if (<uint>state.offlineDotAbilityCodes[duplicate] == abilityCode &&
                    <uint>state.offlineDotTargetIds[duplicate] == targetId &&
                    <uint>state.offlineDotSourceIds[duplicate] == sourceId) {
                    return false;
                }
                duplicate = duplicate + 1;
            }
        }
        if (targetId == <uint>0 || sourceId == <uint>0 || targetId == sourceId ||
            value <= 0.0 || remaining <= 0.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

offlineTemporalEchoStateIsValid(state: WorldState): bool {
    var count = state.offlineTemporalEchoTargetIds.length;
    if (count != state.offlineTemporalEchoSourceIds.length ||
        count != state.offlineTemporalEchoRemaining.length ||
        count != state.offlineTemporalEchoGroups.length ||
        count != state.offlineTemporalEchoConvertRates.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineTemporalEchoTargetIds[index];
        var sourceId = <uint>state.offlineTemporalEchoSourceIds[index];
        if (targetId == <uint>0 || sourceId == <uint>0 ||
            <float>state.offlineTemporalEchoRemaining[index] <= 0.0 ||
            <float>state.offlineTemporalEchoRemaining[index] > 15.0 ||
            <float>state.offlineTemporalEchoConvertRates[index] <= 0.0 ||
            (<bool>state.offlineTemporalEchoGroups[index] &&
                (<float>state.offlineTemporalEchoRemaining[index] > 10.0 ||
                    <float>state.offlineTemporalEchoConvertRates[index] != 0.13)) ||
            (!<bool>state.offlineTemporalEchoGroups[index] &&
                <float>state.offlineTemporalEchoConvertRates[index] != 0.35)) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.offlineTemporalEchoTargetIds[prior] == targetId &&
                <uint>state.offlineTemporalEchoSourceIds[prior] == sourceId) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

offlineTemporalEchoStateIsSchema103Compatible(state: WorldState): bool {
    if (!offlineTemporalEchoStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.offlineTemporalEchoTargetIds.length) {
        if (<bool>state.offlineTemporalEchoGroups[index] ||
            <float>state.offlineTemporalEchoConvertRates[index] != 0.35) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

removeOfflineRewindDamageAt(state: WorldState, index: int): void {
    state.offlineRewindDamageTargetIds.removeAt(index);
    state.offlineRewindDamageTicks.removeAt(index);
    state.offlineRewindDamageAmounts.removeAt(index);
}

// The source prunes on writes, not reads. WOC retains that timing but merges
// multiple landed hits for one player/tick because Rewind observes only their
// sum. This keeps the serialized VM tail bounded without changing any query.
applyOfflineRewindDamagePrune(state: WorldState): void {
    var contract = %import("generated/rewind_contract");
    var cutoff = <int>state.tick - contract.windowTicks(true);
    var index = 0;
    while (index < state.offlineRewindDamageTicks.length) {
        if (<int><uint>state.offlineRewindDamageTicks[index] <= cutoff) {
            removeOfflineRewindDamageAt(state, index);
        } else {
            index = index + 1;
        }
    }
}

recordOfflineRewindDamage(state: WorldState, targetIndex: int, amount: int): void {
    if (amount <= 0 || targetIndex < 0 || targetIndex >= state.entityIds.length ||
        <uint>state.entityKinds[targetIndex] != <uint>1) {
        return;
    }
    applyOfflineRewindDamagePrune(state);
    var targetId = <uint>state.entityIds[targetIndex];
    var tick = state.tick;
    var index = 0;
    while (index < state.offlineRewindDamageTargetIds.length) {
        if (<uint>state.offlineRewindDamageTargetIds[index] == targetId &&
            <uint>state.offlineRewindDamageTicks[index] == tick) {
            var current = <int>state.offlineRewindDamageAmounts[index];
            if (current > 2147483647 - amount) {
                throw "woc Rewind damage history amount overflows";
            }
            state.offlineRewindDamageAmounts[index] = current + amount;
            return;
        }
        index = index + 1;
    }
    if (state.offlineRewindDamageTargetIds.length >=
        <int>OFFLINE_REWIND_DAMAGE_PENDING_MAX) {
        throw "woc Rewind damage history exceeds WOS cap";
    }
    state.offlineRewindDamageTargetIds.add(targetId);
    state.offlineRewindDamageTicks.add(tick);
    state.offlineRewindDamageAmounts.add(amount);
}

offlineRewindDamageTaken(state: WorldState, targetId: uint): int {
    var contract = %import("generated/rewind_contract");
    if (targetId == <uint>0) { return 0; }
    var cutoff = <int>state.tick - contract.windowTicks(true);
    var sum = 0;
    var index = 0;
    while (index < state.offlineRewindDamageTargetIds.length) {
        if (<uint>state.offlineRewindDamageTargetIds[index] == targetId &&
            <int><uint>state.offlineRewindDamageTicks[index] > cutoff) {
            sum = sum + <int>state.offlineRewindDamageAmounts[index];
        }
        index = index + 1;
    }
    return sum;
}

offlineRewindDamageStateIsValid(state: WorldState): bool {
    var count = state.offlineRewindDamageTargetIds.length;
    if (count != state.offlineRewindDamageTicks.length ||
        count != state.offlineRewindDamageAmounts.length ||
        count > <int>OFFLINE_REWIND_DAMAGE_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineRewindDamageTargetIds[index];
        var targetIndex = partyEntityIndexById(state, targetId);
        var tick = <uint>state.offlineRewindDamageTicks[index];
        if (targetId == <uint>0 || targetIndex < 0 ||
            <uint>state.entityKinds[targetIndex] != <uint>1 || tick > state.tick ||
            <int>state.offlineRewindDamageAmounts[index] <= 0) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.offlineRewindDamageTargetIds[prior] == targetId &&
                <uint>state.offlineRewindDamageTicks[prior] == tick) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

removeOfflineNaturesFuryAt(state: WorldState, index: int): void {
    state.offlineNaturesFuryTargetIds.removeAt(index);
    state.offlineNaturesFurySourceIds.removeAt(index);
    state.offlineNaturesFuryValues.removeAt(index);
    state.offlineNaturesFuryRemaining.removeAt(index);
}

offlineNaturesFuryStateIsValid(state: WorldState): bool {
    var fury = %import("generated/natures_fury_contract");
    var count = state.offlineNaturesFuryTargetIds.length;
    if (count != state.offlineNaturesFurySourceIds.length ||
        count != state.offlineNaturesFuryValues.length ||
        count != state.offlineNaturesFuryRemaining.length ||
        count > <int>OFFLINE_NATURES_FURY_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineNaturesFuryTargetIds[index];
        var sourceId = <uint>state.offlineNaturesFurySourceIds[index];
        var targetIndex = partyEntityIndexById(state, targetId);
        var sourceIndex = partyEntityIndexById(state, sourceId);
        var value = <float>state.offlineNaturesFuryValues[index];
        var remaining = <float>state.offlineNaturesFuryRemaining[index];
        if (targetId == <uint>0 || sourceId == <uint>0 || targetIndex < 0 ||
            sourceIndex < 0 || <uint>state.entityKinds[targetIndex] != <uint>1 ||
            <uint>state.entityKinds[sourceIndex] != <uint>1 || value <= 0.0 ||
            value > 1.0 || remaining <= 0.0 || remaining > fury.refreshSeconds()) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.offlineNaturesFuryTargetIds[prior] == targetId &&
                <uint>state.offlineNaturesFurySourceIds[prior] == sourceId) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

applyOfflineNaturesFury(
    state: WorldState, sourceIndex: int, targetIndex: int, value: float, remaining: float
): void {
    if (sourceIndex < 0 || sourceIndex >= state.entityIds.length ||
        targetIndex < 0 || targetIndex >= state.entityIds.length || value <= 0.0 ||
        remaining <= 0.0 || <uint>state.entityKinds[sourceIndex] != <uint>1 ||
        <uint>state.entityKinds[targetIndex] != <uint>1 ||
        <bool>state.entityDead[targetIndex]) {
        return;
    }
    var sourceId = <uint>state.entityIds[sourceIndex];
    var targetId = <uint>state.entityIds[targetIndex];
    var index = 0;
    while (index < state.offlineNaturesFuryTargetIds.length) {
        if (<uint>state.offlineNaturesFuryTargetIds[index] == targetId &&
            <uint>state.offlineNaturesFurySourceIds[index] == sourceId) {
            state.offlineNaturesFuryValues[index] = value;
            state.offlineNaturesFuryRemaining[index] = remaining;
            return;
        }
        index = index + 1;
    }
    if (state.offlineNaturesFuryTargetIds.length >=
        <int>OFFLINE_NATURES_FURY_PENDING_MAX) {
        throw "woc Nature's Fury aura state exceeds WOS cap";
    }
    state.offlineNaturesFuryTargetIds.add(targetId);
    state.offlineNaturesFurySourceIds.add(sourceId);
    state.offlineNaturesFuryValues.add(value);
    state.offlineNaturesFuryRemaining.add(remaining);
}

offlineNaturesFurySpellCritBonus(state: WorldState, targetIndex: int): float {
    if (!offlineNaturesFuryStateIsValid(state)) {
        throw "woc Nature's Fury state is invalid";
    }
    if (targetIndex < 0 || targetIndex >= state.entityIds.length ||
        <uint>state.entityKinds[targetIndex] != <uint>1 ||
        <bool>state.entityDead[targetIndex]) {
        return 0.0;
    }
    var targetId = <uint>state.entityIds[targetIndex];
    var bonus = 0.0;
    var index = 0;
    while (index < state.offlineNaturesFuryTargetIds.length) {
        if (<uint>state.offlineNaturesFuryTargetIds[index] == targetId) {
            bonus = bonus + <float>state.offlineNaturesFuryValues[index];
        }
        index = index + 1;
    }
    return bonus;
}

offlineSpellCritChance(state: WorldState, casterIndex: int): float {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length) { return 0.0; }
    return <float>state.entityCritChance[casterIndex] +
        offlineNaturesFurySpellCritBonus(state, casterIndex);
}

ageOfflineNaturesFury(state: WorldState): void {
    if (!offlineNaturesFuryStateIsValid(state)) {
        throw "woc Nature's Fury state is invalid";
    }
    var index = 0;
    while (index < state.offlineNaturesFuryTargetIds.length) {
        var targetIndex = partyEntityIndexById(
            state, <uint>state.offlineNaturesFuryTargetIds[index]
        );
        var remaining = <float>state.offlineNaturesFuryRemaining[index] -
            projectileTravel.projectileTickSeconds();
        if (targetIndex < 0 || <bool>state.entityDead[targetIndex] ||
            remaining <= OFFLINE_PERIODIC_TICK_EPS) {
            removeOfflineNaturesFuryAt(state, index);
        } else {
            state.offlineNaturesFuryRemaining[index] = remaining;
            index = index + 1;
        }
    }
}

stepOfflineNaturesFury(state: WorldState): void {
    if (!offlineNaturesFuryStateIsValid(state)) {
        throw "woc Nature's Fury state is invalid";
    }
    var fury = %import("generated/natures_fury_contract");
    var moonwing = forms.formAbilityCode("form_moonkin");
    var sourceIndex = 0;
    while (sourceIndex < state.entityIds.length) {
        if (<uint>state.entityKinds[sourceIndex] == <uint>1 &&
            !<bool>state.entityDead[sourceIndex] &&
            <uint>state.entityActiveFormAbilityCodes[sourceIndex] == moonwing) {
            var modifiers = offlineTalentModifiersForEntity(state, sourceIndex);
            var pct = talentModifiers.globalField(modifiers, "moonwingPartyCritPct");
            if (pct > 0.0 && fury.pulseTicks() > 0 &&
                state.tick % <uint>fury.pulseTicks() ==
                    <uint>state.entityIds[sourceIndex] % <uint>fury.pulseTicks()) {
                applyOfflineNaturesFury(
                    state, sourceIndex, sourceIndex, pct, fury.refreshSeconds()
                );
                var partyId = <uint>state.entityPartyIds[sourceIndex];
                if (partyId != <uint>0) {
                    var targetIndex = 0;
                    while (targetIndex < state.entityIds.length) {
                        if (targetIndex != sourceIndex &&
                            <uint>state.entityKinds[targetIndex] == <uint>1 &&
                            !<bool>state.entityDead[targetIndex] &&
                            <uint>state.entityPartyIds[targetIndex] == partyId) {
                            var dx = <float>state.entityX[targetIndex] -
                                <float>state.entityX[sourceIndex];
                            var dz = <float>state.entityZ[targetIndex] -
                                <float>state.entityZ[sourceIndex];
                            if (dx * dx + dz * dz <= fury.radius() * fury.radius()) {
                                applyOfflineNaturesFury(
                                    state, sourceIndex, targetIndex, pct, fury.refreshSeconds()
                                );
                            }
                        }
                        targetIndex = targetIndex + 1;
                    }
                }
            }
        }
        sourceIndex = sourceIndex + 1;
    }
}

// WOS108 retains each periodic total and the selection that resolved it. Rank
// zero is reserved for historical hybrid rows whose old payload contained only
// their final ticks; they stay forward-readable but new casts never create it.
offlineLegacyDotProfileIsValid(
    state: WorldState, index: int, duration: float, interval: float
): bool {
    var abilityCode = <uint>state.offlineDotAbilityCodes[index];
    var damage = <int>state.offlineDotDamages[index];
    return abilityCode == fireballAbilityCode() ?
        fireballDotProfileIsValid(damage, duration, interval) :
        abilityCode == pyroblastAbilityCode() ?
        pyroblastDotProfileIsValid(damage, duration, interval) :
        abilityCode == immolateAbilityCode() ?
        immolateDotProfileIsValid(damage, duration, interval) :
        abilityCode == rakeAbilityCode() ?
        rakeDotProfileIsValid(damage, duration, interval) :
        abilityCode == flameShockAbilityCode() ?
        flameShockDotProfileIsValid(damage, duration, interval) :
        abilityCode == moonfireAbilityCode() ?
        moonfireDotProfileIsValid(damage, duration, interval) : false;
}

// Serpents Venom is an addEffect rather than Arcane Shot's native profile.
// The source stores its resolved periodic aura, so a later respec must not
// re-run the selection; rank plus total and tick geometry are sufficient.
arcaneShotVenomDotProfileIsValid(
    state: WorldState, index: int, duration: float, interval: float
): bool {
    var rank = <uint>state.offlineDotRanks[index];
    var rankLevel = arcaneShotRankLevel(rank);
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_shot");
    var total = <int>state.offlineDotResolvedTotals[index];
    var damage = <int>state.offlineDotDamages[index];
    var expectedDamage = <int>(<float>total / 3.0 + 0.5);
    if (expectedDamage < 1) { expectedDamage = 1; }
    return abilityIndex >= 0 && rankLevel > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, rankLevel) == <int>rank &&
        <int>state.offlineDotSnapshotPowers[index] == 0 &&
        offlineDotTalentSnapshotIsEmpty(state, index) && total > 0 &&
        damage == expectedDamage && duration == 3.0 && interval == 1.0;
}

offlineDotStateIsValid(state: WorldState): bool {
    var effects = %import("generated/m4_ability_effects");
    var count = state.offlineDotTargetIds.length;
    if (count != state.offlineDotSourceIds.length ||
        count != state.offlineDotAbilityCodes.length ||
        count != state.offlineDotDamages.length ||
        count != state.offlineDotRanks.length ||
        count != state.offlineDotSnapshotPowers.length ||
        count != state.offlineDotResolvedTotals.length ||
        count != state.offlineDotTalentSpecCodes.length ||
        state.offlineDotTalentRowOptionCodes.length != count * 6 ||
        count != state.offlineDotRemaining.length ||
        count != state.offlineDotDurations.length ||
        count != state.offlineDotTickIntervals.length ||
        count != state.offlineDotTickTimers.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineDotTargetIds[index];
        var sourceId = <uint>state.offlineDotSourceIds[index];
        var duration = <float>state.offlineDotDurations[index];
        var interval = <float>state.offlineDotTickIntervals[index];
        var remaining = <float>state.offlineDotRemaining[index];
        var timer = <float>state.offlineDotTickTimers[index];
        var abilityCode = <uint>state.offlineDotAbilityCodes[index];
        var rank = <uint>state.offlineDotRanks[index];
        var snapshotPower = <int>state.offlineDotSnapshotPowers[index];
        var resolvedTotal = <int>state.offlineDotResolvedTotals[index];
        var profileIsValid = false;
        if (abilityCode == arcaneShotAbilityCode()) {
            profileIsValid = arcaneShotVenomDotProfileIsValid(state, index, duration, interval);
        } else if (abilityCode == ignitionAbilityCode()) {
            var ticks = <int>(duration / interval + 0.5);
            profileIsValid = rank == <uint>0 && snapshotPower == 0 &&
                offlineDotTalentSnapshotIsEmpty(state, index) &&
                igniteDotProfileIsValid(<int>state.offlineDotDamages[index], duration, interval) &&
                resolvedTotal == <int>state.offlineDotDamages[index] * ticks;
        } else if (rank == <uint>0) {
            profileIsValid = offlineDotTalentSnapshotIsEmpty(state, index) &&
                offlineLegacyDotProfileIsValid(state, index, duration, interval) &&
                resolvedTotal == <int>state.offlineDotDamages[index] *
                    <int>(duration / interval + 0.5);
        } else {
            var abilityIndex = (abilityCode == <uint>0 ||
                !knownAbilityCatalog.abilityExists(<int>abilityCode)) ? -1 :
                m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
            var effectIndex = offlineTalentDotEffectIndex(abilityIndex, rank);
            var expectedTotal = offlineTalentDotResolvedTotalForDot(state, index);
            profileIsValid = effectIndex >= 0 && expectedTotal > 0 &&
                offlineTalentDotResolvedTotalMatchesAura(
                    abilityCode, expectedTotal, resolvedTotal
                ) && offlineDotTalentSnapshotIsValid(state, index) &&
                numericEffects.dotProfileMatchesResolvedTotal(
                    abilityIndex,
                    <int>rank,
                    effectIndex,
                    snapshotPower,
                    resolvedTotal,
                    <int>state.offlineDotDamages[index],
                    duration,
                    interval
                ) && (abilityCode != siphonLifeAbilityCode() ||
                    effects.metric(abilityIndex, <int>rank, effectIndex, "leechPct") == 1.0);
        }
        if (targetId == <uint>0 || sourceId == <uint>0 || targetId == sourceId ||
            resolvedTotal <= 0 || !profileIsValid || remaining <= 0.0 ||
            remaining > duration || timer <= 0.0 || timer > interval) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// WOS64 makes new pure-HoT rows reconstructable from rank plus application-time
// spell power. Rank zero is reserved for migrated WOS60-WOS63 Rejuvenation rows:
// their resolved value remains authoritative because the historic payload did
// not contain enough information to recover one exact old spell-power value.
offlineHotStateIsValid(state: WorldState): bool {
    var count = state.offlineHotTargetIds.length;
    if (count != state.offlineHotSourceIds.length ||
        count != state.offlineHotAbilityCodes.length ||
        count != state.offlineHotHeals.length ||
        count != state.offlineHotRanks.length ||
        count != state.offlineHotSnapshotPowers.length ||
        count != state.offlineHotRemaining.length ||
        count != state.offlineHotDurations.length ||
        count != state.offlineHotTickIntervals.length ||
        count != state.offlineHotTickTimers.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineHotTargetIds[index];
        var sourceId = <uint>state.offlineHotSourceIds[index];
        var duration = <float>state.offlineHotDurations[index];
        var interval = <float>state.offlineHotTickIntervals[index];
        var remaining = <float>state.offlineHotRemaining[index];
        var timer = <float>state.offlineHotTickTimers[index];
        var abilityCode = <uint>state.offlineHotAbilityCodes[index];
        var rank = <int><uint>state.offlineHotRanks[index];
        var snapshotPower = <int>state.offlineHotSnapshotPowers[index];
        var abilityIndex = pureHotAbilityIndex(abilityCode);
        var profileIsValid = false;
        if (rank == 0) {
            profileIsValid = abilityCode == rejuvenationAbilityCode() &&
                rejuvenationHotProfileIsValid(
                    <int>state.offlineHotHeals[index], duration, interval
                );
        } else if (abilityIndex >= 0) {
            profileIsValid = pureHotProfiles.pureHotProfileSnapshotMatches(
                abilityIndex, rank, snapshotPower, <int>state.offlineHotHeals[index],
                duration, interval
            );
        } else if (abilityCode == regrowthAbilityCode()) {
            var regrowthIndex = m4AbilityCatalog.indexOf("regrowth");
            profileIsValid = snapshotPower == 0 &&
                hybridHotProfiles.hybridHotProfileSnapshotMatches(
                    regrowthIndex, rank, <int>state.offlineHotHeals[index], duration, interval
                );
        }
        if (targetId == <uint>0 || sourceId == <uint>0 || !profileIsValid ||
            remaining <= 0.0 || remaining > duration || timer <= 0.0 || timer > interval) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// The retained absorb queue supports the generated Power Word Shield profile
// and the source-pinned Ice Barrier profile. Its bounded global row order is
// also the source damage-consumption order.
offlineAbsorbProfileMatches(
    abilityCode: uint, rank: int, amount: int, remaining: float
): bool {
    if (abilityCode == powerWordShieldAbilityCode()) {
        var shieldIndex = m4AbilityCatalog.indexOf("power_word_shield");
        return shieldIndex >= 0 && absorbProfiles.absorbProfileMatches(
            shieldIndex, rank, amount, remaining
        );
    }
    if (abilityCode == temporalBarrierAbilityCode()) {
        var barrierIndex = m4AbilityCatalog.indexOf("temporal_barrier");
        return barrierIndex >= 0 && absorbProfiles.absorbProfileMatches(
            barrierIndex, rank, amount, remaining
        );
    }
    return iceBarrierAbsorbProfileMatches(abilityCode, rank, amount, remaining) ||
        blazingBarrierAbsorbProfileMatches(abilityCode, rank, amount, remaining) ||
        massBarrierAbsorbProfileMatches(abilityCode, rank, amount, remaining);
}

offlineAbsorbTalentSnapshotRowCodeAt(state: WorldState, index: int, row: int): uint {
    return <uint>state.offlineAbsorbTalentRowOptionCodes[index * 6 + row];
}

offlineAbsorbTalentSnapshotIsEmpty(state: WorldState, index: int): bool {
    if (<uint>state.offlineAbsorbTalentSpecCodes[index] != <uint>0) return false;
    var row = 0;
    while (row < 6) {
        if (offlineAbsorbTalentSnapshotRowCodeAt(state, index, row) != <uint>0) return false;
        row = row + 1;
    }
    return true;
}

offlineAbsorbTalentSnapshotIsValid(state: WorldState, index: int): bool {
    if (offlineAbsorbTalentSnapshotIsEmpty(state, index)) return true;
    var sourceIndex = partyEntityIndexById(state, <uint>state.offlineAbsorbSourceIds[index]);
    return sourceIndex >= 0 && offlineTalentAllocationValuesAreValid(
        state, sourceIndex, <uint>state.offlineAbsorbTalentSpecCodes[index],
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 0),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 1),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 2),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 3),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 4),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 5)
    );
}

offlineAbsorbRawInitialAmount(abilityCode: uint, rank: int, fallback: int): int {
    var abilityIndex = abilityCode == powerWordShieldAbilityCode() ?
        m4AbilityCatalog.indexOf("power_word_shield") :
        abilityCode == temporalBarrierAbilityCode() ?
            m4AbilityCatalog.indexOf("temporal_barrier") : -1;
    if (abilityIndex < 0) return fallback;
    var profile = absorbProfiles.resolveAbsorbProfile(abilityIndex, rank);
    return profile.valid ? profile.amount : fallback;
}

offlineAbsorbIsTalentScalable(abilityCode: uint): bool {
    return abilityCode == powerWordShieldAbilityCode() ||
        abilityCode == temporalBarrierAbilityCode();
}

offlineAbsorbProfileAndDurationMatches(
    abilityCode: uint, rank: int, initial: int, remaining: float
): bool {
    // M4 absorb rows retain a talent-scaled initial value. Reuse the generated
    // profile only for rank and duration validation, not its raw amount.
    var profileAmount = offlineAbsorbIsTalentScalable(abilityCode) ?
        offlineAbsorbRawInitialAmount(abilityCode, rank, 0) : initial;
    return profileAmount > 0 && offlineAbsorbProfileMatches(
        abilityCode, rank, profileAmount, remaining
    );
}

offlineTalentAbsorbSnapshotModifiers(
    state: WorldState, index: int, sourceIndex: int
): talentModifiers.TalentModifierState {
    var snapshot = new talentModifiers.TalentModifierState();
    snapshot.playerLevel = <int>state.entityLevels[sourceIndex];
    talentModifiers.recompute(
        snapshot, <uint>state.offlineAbsorbTalentSpecCodes[index],
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 0),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 1),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 2),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 3),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 4),
        offlineAbsorbTalentSnapshotRowCodeAt(state, index, 5)
    );
    return snapshot;
}

resolveOfflineTalentAbsorbAmount(
    state: WorldState, sourceId: uint, abilityCode: uint, rank: int, baseAmount: int
): int {
    var abilityIndex = abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode) ?
        -1 : m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var effects = %import("generated/m4_ability_effects");
    var sourceIndex = partyEntityIndexById(state, sourceId);
    if (abilityIndex < 0 || rank <= 0 || sourceIndex < 0 ||
        effects.typeAt(abilityIndex, rank, 0) != "absorb") {
        return baseAmount;
    }
    return absorbTalentScaling.resolveAbsorbAmount(
        baseAmount, offlineTalentModifiersForEntity(state, sourceIndex),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

offlineAbsorbExpectedInitialAmount(state: WorldState, index: int): int {
    var abilityCode = <uint>state.offlineAbsorbAbilityCodes[index];
    var rank = <int><uint>state.offlineAbsorbRanks[index];
    var base = offlineAbsorbRawInitialAmount(
        abilityCode, rank, <int>state.offlineAbsorbResolvedInitialAmounts[index]
    );
    if (offlineAbsorbTalentSnapshotIsEmpty(state, index)) return base;
    if (!offlineAbsorbIsTalentScalable(abilityCode) ||
        !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return base;
    }
    var sourceIndex = partyEntityIndexById(state, <uint>state.offlineAbsorbSourceIds[index]);
    if (sourceIndex < 0 || !offlineAbsorbTalentSnapshotIsValid(state, index)) return base;
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    return absorbTalentScaling.resolveAbsorbAmount(
        base, offlineTalentAbsorbSnapshotModifiers(state, index, sourceIndex),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

offlineAbsorbStateIsSchema109Compatible(state: WorldState): bool {
    if (!offlineAbsorbStateIsValid(state)) return false;
    var index = 0;
    while (index < state.offlineAbsorbTargetIds.length) {
        if (!offlineAbsorbTalentSnapshotIsEmpty(state, index)) return false;
        index = index + 1;
    }
    return true;
}

normalizeOfflineLegacyAbsorbTalentRows(state: WorldState): void {
    var index = 0;
    while (index < state.offlineAbsorbTargetIds.length) {
        state.offlineAbsorbResolvedInitialAmounts[index] = offlineAbsorbRawInitialAmount(
            <uint>state.offlineAbsorbAbilityCodes[index],
            <int><uint>state.offlineAbsorbRanks[index],
            <int>state.offlineAbsorbAmounts[index]
        );
        state.offlineAbsorbTalentSpecCodes[index] = <uint>0;
        var row = 0;
        while (row < 6) {
            state.offlineAbsorbTalentRowOptionCodes[index * 6 + row] = <uint>0;
            row = row + 1;
        }
        index = index + 1;
    }
}

offlineAbsorbStateIsValid(state: WorldState): bool {
    var count = state.offlineAbsorbTargetIds.length;
    if (count != state.offlineAbsorbSourceIds.length ||
        count != state.offlineAbsorbAbilityCodes.length ||
        count != state.offlineAbsorbRanks.length ||
        count != state.offlineAbsorbAmounts.length ||
        count != state.offlineAbsorbRemaining.length ||
        count != state.offlineAbsorbResolvedInitialAmounts.length ||
        count != state.offlineAbsorbTalentSpecCodes.length ||
        state.offlineAbsorbTalentRowOptionCodes.length != count * 6 ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var targetId = <uint>state.offlineAbsorbTargetIds[index];
        var sourceId = <uint>state.offlineAbsorbSourceIds[index];
        var abilityCode = <uint>state.offlineAbsorbAbilityCodes[index];
        var rank = <int><uint>state.offlineAbsorbRanks[index];
        var amount = <int>state.offlineAbsorbAmounts[index];
        var initial = <int>state.offlineAbsorbResolvedInitialAmounts[index];
        var snapshotIsEmpty = offlineAbsorbTalentSnapshotIsEmpty(state, index);
        if (targetId == <uint>0 || sourceId == <uint>0 ||
            !offlineAbsorbProfileAndDurationMatches(
                abilityCode, rank, initial,
                <float>state.offlineAbsorbRemaining[index]
            ) || amount <= 0 || amount > initial ||
            !offlineAbsorbTalentSnapshotIsValid(state, index) ||
            (!snapshotIsEmpty && !offlineAbsorbIsTalentScalable(abilityCode)) ||
            initial != offlineAbsorbExpectedInitialAmount(state, index)) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.offlineAbsorbTargetIds[prior] == targetId &&
                <uint>state.offlineAbsorbSourceIds[prior] == sourceId &&
                <uint>state.offlineAbsorbAbilityCodes[prior] == abilityCode) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

// WOS61 retains only the source-pinned Consecration GroundAoE profile. Its
// damage rider is already resolved from application-time spell power.
offlineGroundEffectStateIsValid(state: WorldState): bool {
    var count = state.offlineGroundEffectSourceIds.length;
    if (count != state.offlineGroundEffectAbilityCodes.length ||
        count != state.offlineGroundEffectX.length ||
        count != state.offlineGroundEffectZ.length ||
        count != state.offlineGroundEffectRadii.length ||
        count != state.offlineGroundEffectMinimums.length ||
        count != state.offlineGroundEffectMaximums.length ||
        count != state.offlineGroundEffectSpellPowerBonuses.length ||
        count != state.offlineGroundEffectRemaining.length ||
        count != state.offlineGroundEffectIntervals.length ||
        count != state.offlineGroundEffectTickTimers.length ||
        count > <int>OFFLINE_DOT_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        if (<uint>state.offlineGroundEffectSourceIds[index] == <uint>0 ||
            <uint>state.offlineGroundEffectAbilityCodes[index] != consecrationAbilityCode() ||
            <float>state.offlineGroundEffectRadii[index] != 8.0 ||
            <float>state.offlineGroundEffectMinimums[index] != 28.0 ||
            <float>state.offlineGroundEffectMaximums[index] != 34.0 ||
            <float>state.offlineGroundEffectSpellPowerBonuses[index] < 0.0 ||
            <float>state.offlineGroundEffectRemaining[index] <= 0.0 ||
            <float>state.offlineGroundEffectRemaining[index] > 10.0 ||
            <float>state.offlineGroundEffectIntervals[index] != 2.0 ||
            <float>state.offlineGroundEffectTickTimers[index] <= 0.0 ||
            <float>state.offlineGroundEffectTickTimers[index] > 2.0) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

appendDefaultCastingColumns(state: WorldState): void {
    state.entityCastingAbility.add(<uint>0);
    state.entityCastRemaining.add(0.0);
    state.entityCastTotal.add(0.0);
    state.entityCastingFlags.add(<uint>0);
    state.entityChannelTickEvery.add(0.0);
    state.entityChannelTickTimer.add(0.0);
    state.entityChannelTicksLeft.add(0);
    state.entityCastPushbackReduction.add(0.0);
    state.entityCastGcdRemaining.add(0.0);
    state.entityQueuedCastAbility.add(<uint>0);
    state.entityQueuedCastDuration.add(0.0);
    state.entityQueuedChannelTickEvery.add(0.0);
    state.entityQueuedChannelTickCount.add(0);
    state.entityQueuedCastGcd.add(0.0);
    state.entityEmpowerStages.add(0);
    state.entityIceFloesUses.add(0);
    state.entityLastResolvedEmpowerLevel.add(0);
    state.entityCastStartedCount.add(0);
    state.entityCastSuccessfulStops.add(0);
    state.entityCastCancelledStops.add(0);
    state.entityCastResolvedCount.add(0);
    state.entityFishingCompletions.add(0);
    state.entityCastChannelTicks.add(0);
    state.entityCastCancelReason.add(0);
}

appendDefaultAbilityRuntimeColumns(state: WorldState): void {
    state.entityResources.add(0.0);
    state.entityMaxResources.add(0.0);
    state.entityCastTargetIds.add(<uint>0);
    state.entityAbilityCooldownOffsets.add(
        <uint>state.entityAbilityCooldownCodes.length
    );
}

appendDefaultNextCastModifierColumns(state: WorldState): void {
    var index = state.entityIds.length - 1;
    if (index < 0 ||
        state.entityNextCastModifierOffsets.length != index + 1) {
        throw "woc next-cast modifier default row is invalid";
    }
    state.entityNextCastModifierOffsets.add(
        <uint>state.nextCastModifierIdentityCodes.length
    );
}

abilityRuntimeRowStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length ||
        <float>state.entityResources[index] < 0 ||
        <float>state.entityMaxResources[index] < <float>state.entityResources[index] ||
        state.entityAbilityCooldownOffsets.length != state.entityIds.length + 1) {
        return false;
    }
    var start = <int><uint>state.entityAbilityCooldownOffsets[index];
    var end = <int><uint>state.entityAbilityCooldownOffsets[index + 1];
    if (start < 0 || end < start ||
        end > state.entityAbilityCooldownCodes.length ||
        state.entityAbilityCooldownCodes.length !=
            state.entityAbilityCooldownExpiresAtMicros.length) {
        return false;
    }
    var priorCode: uint = <uint>0;
    var cooldownIndex = start;
    while (cooldownIndex < end) {
        var code = <uint>state.entityAbilityCooldownCodes[cooldownIndex];
        if (code == <uint>0 || code <= priorCode ||
            <uint>state.entityAbilityCooldownExpiresAtMicros[cooldownIndex] <= state.timeMicros) {
            return false;
        }
        priorCode = code;
        cooldownIndex = cooldownIndex + 1;
    }
    return <uint>state.entityCastingAbility[index] != <uint>0 ||
        <uint>state.entityCastTargetIds[index] == <uint>0;
}

nextCastModifierStateIsValid(state: WorldState): bool {
    var entityCount = state.entityIds.length;
    var modifierCount = state.nextCastModifierIdentityCodes.length;
    if (state.entityNextCastModifierOffsets.length != entityCount + 1 ||
        <uint>state.entityNextCastModifierOffsets[0] != <uint>0 ||
        <uint>state.entityNextCastModifierOffsets[entityCount] !=
            <uint>modifierCount ||
        modifierCount != state.nextCastModifierKindCodes.length ||
        modifierCount != state.nextCastModifierRemaining.length ||
        modifierCount != state.nextCastModifierValues.length ||
        state.nextCastModifierTargetOffsets.length != modifierCount + 1 ||
        <uint>state.nextCastModifierTargetOffsets[0] != <uint>0 ||
        <uint>state.nextCastModifierTargetOffsets[modifierCount] !=
            <uint>state.nextCastModifierTargetAbilityCodes.length) {
        return false;
    }
    var entityIndex = 0;
    while (entityIndex < entityCount) {
        var modifierStart = <int><uint>state.entityNextCastModifierOffsets[
            entityIndex
        ];
        var modifierEnd = <int><uint>state.entityNextCastModifierOffsets[
            entityIndex + 1
        ];
        if (modifierStart < 0 || modifierEnd < modifierStart ||
            modifierEnd > modifierCount) {
            return false;
        }
        var priorIdentity: uint = <uint>0;
        var modifierIndex = modifierStart;
        while (modifierIndex < modifierEnd) {
            var identityCode = <uint>state.nextCastModifierIdentityCodes[
                modifierIndex
            ];
            if (identityCode <= priorIdentity || !nextCastModifiers.validModifier(
                identityCode,
                <uint>state.nextCastModifierKindCodes[modifierIndex],
                <float>state.nextCastModifierRemaining[modifierIndex],
                <float>state.nextCastModifierValues[modifierIndex]
            )) {
                return false;
            }
            var targetStart = <int><uint>state.nextCastModifierTargetOffsets[
                modifierIndex
            ];
            var targetEnd = <int><uint>state.nextCastModifierTargetOffsets[
                modifierIndex + 1
            ];
            if (!nextCastModifiers.canonicalTargets(
                state.nextCastModifierTargetAbilityCodes, targetStart, targetEnd
            )) {
                return false;
            }
            var targetIndex = targetStart;
            while (targetIndex < targetEnd) {
                if (!knownAbilityCatalog.abilityExists(
                    <uint>state.nextCastModifierTargetAbilityCodes[targetIndex]
                )) {
                    return false;
                }
                targetIndex = targetIndex + 1;
            }
            priorIdentity = identityCode;
            modifierIndex = modifierIndex + 1;
        }
        entityIndex = entityIndex + 1;
    }
    return true;
}

nextCastModifierIndexForAbility(
    state: WorldState, entityIndex: int, kindCode: uint, abilityCode: uint
): int {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length ||
        !nextCastModifiers.supportedKind(kindCode) || abilityCode == <uint>0 ||
        !nextCastModifierStateIsValid(state)) {
        return -1;
    }
    var modifierIndex = <int><uint>state.entityNextCastModifierOffsets[
        entityIndex
    ];
    var modifierEnd = <int><uint>state.entityNextCastModifierOffsets[
        entityIndex + 1
    ];
    while (modifierIndex < modifierEnd) {
        if (<uint>state.nextCastModifierKindCodes[modifierIndex] == kindCode &&
            nextCastModifiers.appliesToAbility(
                state.nextCastModifierTargetAbilityCodes,
                <int><uint>state.nextCastModifierTargetOffsets[modifierIndex],
                <int><uint>state.nextCastModifierTargetOffsets[modifierIndex + 1],
                abilityCode
            )) {
            return modifierIndex;
        }
        modifierIndex = modifierIndex + 1;
    }
    return -1;
}

nextCastModifierActiveForAbility(
    state: WorldState, entityIndex: int, kindCode: uint, abilityCode: uint
): bool {
    return nextCastModifierIndexForAbility(
        state, entityIndex, kindCode, abilityCode
    ) >= 0;
}

nextCastModifierValueForAbility(
    state: WorldState, entityIndex: int, kindCode: uint, abilityCode: uint
): float {
    var modifierIndex = nextCastModifierIndexForAbility(
        state, entityIndex, kindCode, abilityCode
    );
    return modifierIndex < 0 ? -1.0 :
        <float>state.nextCastModifierValues[modifierIndex];
}

appendNextCastModifierRow(
    identityCodes: container.Array<uint>, kindCodes: container.Array<uint>,
    remaining: container.Array<float>, values: container.Array<float>,
    targetOffsets: container.Array<uint>, targetCodes: container.Array<uint>,
    identityCode: uint, kindCode: uint, remainingValue: float, value: float,
    sourceTargetCodes: container.Array<uint>, sourceTargetStart: int,
    sourceTargetEnd: int
): void {
    if (!nextCastModifiers.validModifier(
        identityCode, kindCode, remainingValue, value
    ) || !nextCastModifiers.canonicalTargets(
        sourceTargetCodes, sourceTargetStart, sourceTargetEnd
    )) {
        throw "woc next-cast modifier row is invalid";
    }
    identityCodes.add(identityCode);
    kindCodes.add(kindCode);
    remaining.add(remainingValue);
    values.add(value);
    var targetIndex = sourceTargetStart;
    while (targetIndex < sourceTargetEnd) {
        targetCodes.add(<uint>sourceTargetCodes[targetIndex]);
        targetIndex = targetIndex + 1;
    }
    targetOffsets.add(<uint>targetCodes.length);
}

appendStoredNextCastModifierRow(
    state: WorldState, modifierIndex: int,
    identityCodes: container.Array<uint>, kindCodes: container.Array<uint>,
    remaining: container.Array<float>, values: container.Array<float>,
    targetOffsets: container.Array<uint>, targetCodes: container.Array<uint>,
    remainingValue: float
): void {
    appendNextCastModifierRow(
        identityCodes, kindCodes, remaining, values, targetOffsets, targetCodes,
        <uint>state.nextCastModifierIdentityCodes[modifierIndex],
        <uint>state.nextCastModifierKindCodes[modifierIndex], remainingValue,
        <float>state.nextCastModifierValues[modifierIndex],
        state.nextCastModifierTargetAbilityCodes,
        <int><uint>state.nextCastModifierTargetOffsets[modifierIndex],
        <int><uint>state.nextCastModifierTargetOffsets[modifierIndex + 1]
    );
}

setNextCastModifier(
    state: WorldState, entityIndex: int, identityCode: uint, kindCode: uint,
    remainingValue: float, value: float, targetAbilityCodes: container.Array<uint>
): void {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length ||
        !nextCastModifierStateIsValid(state) || !nextCastModifiers.validModifier(
            identityCode, kindCode, remainingValue, value
        ) || !nextCastModifiers.canonicalTargets(
            targetAbilityCodes, 0, targetAbilityCodes.length
        )) {
        throw "woc next-cast modifier update is invalid";
    }
    var targetIndex = 0;
    while (targetIndex < targetAbilityCodes.length) {
        if (!knownAbilityCatalog.abilityExists(<uint>targetAbilityCodes[targetIndex])) {
            throw "woc next-cast modifier target ability is invalid";
        }
        targetIndex = targetIndex + 1;
    }
    var nextEntityOffsets = new container.Array<uint>();
    var nextIdentityCodes = new container.Array<uint>();
    var nextKindCodes = new container.Array<uint>();
    var nextRemaining = new container.Array<float>();
    var nextValues = new container.Array<float>();
    var nextTargetOffsets = new container.Array<uint>();
    var nextTargetCodes = new container.Array<uint>();
    nextEntityOffsets.add(<uint>0);
    nextTargetOffsets.add(<uint>0);
    var currentEntityIndex = 0;
    while (currentEntityIndex < state.entityIds.length) {
        var modifierIndex = <int><uint>state.entityNextCastModifierOffsets[
            currentEntityIndex
        ];
        var modifierEnd = <int><uint>state.entityNextCastModifierOffsets[
            currentEntityIndex + 1
        ];
        var inserted = false;
        while (modifierIndex < modifierEnd) {
            var currentIdentityCode = <uint>state.nextCastModifierIdentityCodes[
                modifierIndex
            ];
            if (currentEntityIndex == entityIndex &&
                currentIdentityCode == identityCode) {
                if (!inserted) {
                    appendNextCastModifierRow(
                        nextIdentityCodes, nextKindCodes, nextRemaining, nextValues,
                        nextTargetOffsets, nextTargetCodes, identityCode, kindCode,
                        remainingValue, value, targetAbilityCodes, 0,
                        targetAbilityCodes.length
                    );
                    inserted = true;
                }
            } else {
                if (currentEntityIndex == entityIndex && !inserted &&
                    currentIdentityCode > identityCode) {
                    appendNextCastModifierRow(
                        nextIdentityCodes, nextKindCodes, nextRemaining, nextValues,
                        nextTargetOffsets, nextTargetCodes, identityCode, kindCode,
                        remainingValue, value, targetAbilityCodes, 0,
                        targetAbilityCodes.length
                    );
                    inserted = true;
                }
                appendStoredNextCastModifierRow(
                    state, modifierIndex, nextIdentityCodes, nextKindCodes,
                    nextRemaining, nextValues, nextTargetOffsets, nextTargetCodes,
                    <float>state.nextCastModifierRemaining[modifierIndex]
                );
            }
            modifierIndex = modifierIndex + 1;
        }
        if (currentEntityIndex == entityIndex && !inserted) {
            appendNextCastModifierRow(
                nextIdentityCodes, nextKindCodes, nextRemaining, nextValues,
                nextTargetOffsets, nextTargetCodes, identityCode, kindCode,
                remainingValue, value, targetAbilityCodes, 0,
                targetAbilityCodes.length
            );
        }
        nextEntityOffsets.add(<uint>nextIdentityCodes.length);
        currentEntityIndex = currentEntityIndex + 1;
    }
    state.entityNextCastModifierOffsets = nextEntityOffsets;
    state.nextCastModifierIdentityCodes = nextIdentityCodes;
    state.nextCastModifierKindCodes = nextKindCodes;
    state.nextCastModifierRemaining = nextRemaining;
    state.nextCastModifierValues = nextValues;
    state.nextCastModifierTargetOffsets = nextTargetOffsets;
    state.nextCastModifierTargetAbilityCodes = nextTargetCodes;
}

removeNextCastModifierAt(state: WorldState, removeIndex: int): void {
    if (!nextCastModifierStateIsValid(state) || removeIndex < 0 ||
        removeIndex >= state.nextCastModifierIdentityCodes.length) {
        throw "woc next-cast modifier removal is invalid";
    }
    var nextEntityOffsets = new container.Array<uint>();
    var nextIdentityCodes = new container.Array<uint>();
    var nextKindCodes = new container.Array<uint>();
    var nextRemaining = new container.Array<float>();
    var nextValues = new container.Array<float>();
    var nextTargetOffsets = new container.Array<uint>();
    var nextTargetCodes = new container.Array<uint>();
    nextEntityOffsets.add(<uint>0);
    nextTargetOffsets.add(<uint>0);
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var modifierIndex = <int><uint>state.entityNextCastModifierOffsets[
            entityIndex
        ];
        var modifierEnd = <int><uint>state.entityNextCastModifierOffsets[
            entityIndex + 1
        ];
        while (modifierIndex < modifierEnd) {
            if (modifierIndex != removeIndex) {
                appendStoredNextCastModifierRow(
                    state, modifierIndex, nextIdentityCodes, nextKindCodes,
                    nextRemaining, nextValues, nextTargetOffsets, nextTargetCodes,
                    <float>state.nextCastModifierRemaining[modifierIndex]
                );
            }
            modifierIndex = modifierIndex + 1;
        }
        nextEntityOffsets.add(<uint>nextIdentityCodes.length);
        entityIndex = entityIndex + 1;
    }
    state.entityNextCastModifierOffsets = nextEntityOffsets;
    state.nextCastModifierIdentityCodes = nextIdentityCodes;
    state.nextCastModifierKindCodes = nextKindCodes;
    state.nextCastModifierRemaining = nextRemaining;
    state.nextCastModifierValues = nextValues;
    state.nextCastModifierTargetOffsets = nextTargetOffsets;
    state.nextCastModifierTargetAbilityCodes = nextTargetCodes;
}

consumeNextCastModifierForAbility(
    state: WorldState, entityIndex: int, kindCode: uint, abilityCode: uint
): bool {
    var modifierIndex = nextCastModifierIndexForAbility(
        state, entityIndex, kindCode, abilityCode
    );
    if (modifierIndex < 0 || !nextCastModifiers.consumesOnSuccessfulCast(kindCode)) {
        return false;
    }
    removeNextCastModifierAt(state, modifierIndex);
    return true;
}

ageOfflineNextCastModifiers(state: WorldState): void {
    if (!nextCastModifierStateIsValid(state)) {
        throw "woc next-cast modifier state is invalid";
    }
    var nextEntityOffsets = new container.Array<uint>();
    var nextIdentityCodes = new container.Array<uint>();
    var nextKindCodes = new container.Array<uint>();
    var nextRemaining = new container.Array<float>();
    var nextValues = new container.Array<float>();
    var nextTargetOffsets = new container.Array<uint>();
    var nextTargetCodes = new container.Array<uint>();
    nextEntityOffsets.add(<uint>0);
    nextTargetOffsets.add(<uint>0);
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var modifierIndex = <int><uint>state.entityNextCastModifierOffsets[
            entityIndex
        ];
        var modifierEnd = <int><uint>state.entityNextCastModifierOffsets[
            entityIndex + 1
        ];
        while (modifierIndex < modifierEnd) {
            var remaining = <float>state.nextCastModifierRemaining[modifierIndex];
            if (remaining > 0.05) {
                appendStoredNextCastModifierRow(
                    state, modifierIndex, nextIdentityCodes, nextKindCodes,
                    nextRemaining, nextValues, nextTargetOffsets, nextTargetCodes,
                    remaining - 0.05
                );
            }
            modifierIndex = modifierIndex + 1;
        }
        nextEntityOffsets.add(<uint>nextIdentityCodes.length);
        entityIndex = entityIndex + 1;
    }
    state.entityNextCastModifierOffsets = nextEntityOffsets;
    state.nextCastModifierIdentityCodes = nextIdentityCodes;
    state.nextCastModifierKindCodes = nextKindCodes;
    state.nextCastModifierRemaining = nextRemaining;
    state.nextCastModifierValues = nextValues;
    state.nextCastModifierTargetOffsets = nextTargetOffsets;
    state.nextCastModifierTargetAbilityCodes = nextTargetCodes;
}

