            state.entityOverloadValues.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            overloadIndex = overloadIndex + 1;
        }
    } else {
        var historicalOverloadIndex = 0;
        while (historicalOverloadIndex < state.entityIds.length) {
            state.entityOverloadRemaining.add(0.0);
            state.entityOverloadValues.add(0.0);
            historicalOverloadIndex = historicalOverloadIndex + 1;
        }
    }
    if (!overloadStateIsValid(state)) {
        throw "woc Overload state is invalid";
    }
    if (schemaVersion >= <uint>94) {
        var powerEchoIndex = 0;
        while (powerEchoIndex < state.entityIds.length) {
            state.entityPowerEchoRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.entityPowerEchoValues.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            powerEchoIndex = powerEchoIndex + 1;
        }
    } else {
        var historicalPowerEchoIndex = 0;
        while (historicalPowerEchoIndex < state.entityIds.length) {
            state.entityPowerEchoRemaining.add(0.0);
            state.entityPowerEchoValues.add(0.0);
            historicalPowerEchoIndex = historicalPowerEchoIndex + 1;
        }
    }
    if (!powerEchoStateIsValid(state)) {
        throw "woc Power Echo state is invalid";
    }
    if (schemaVersion >= <uint>96) {
        var critVulnCount = reader.u16(1, 1);
        if (critVulnCount > OFFLINE_DOT_PENDING_MAX) {
            throw "woc crit vulnerability count exceeds WOS cap";
        }
        var critVulnIndex: uint = <uint>0;
        while (critVulnIndex < critVulnCount) {
            state.offlineCritVulnTargetIds.add(reader.u64(1, 1, 2, 4));
            state.offlineCritVulnSourceIds.add(reader.u64(1, 1, 2, 4));
            state.offlineCritVulnValues.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineCritVulnRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            critVulnIndex = critVulnIndex + <uint>1;
        }
    }
    if (!offlineCritVulnStateIsValid(state)) {
        throw "woc crit vulnerability state is invalid";
    }
    if (schemaVersion >= <uint>97) {
        var temporalEchoCount = reader.u16(1, 1);
        if (temporalEchoCount > OFFLINE_DOT_PENDING_MAX) {
            throw "woc Temporal Echo count exceeds WOS cap";
        }
        var temporalEchoIndex: uint = <uint>0;
        while (temporalEchoIndex < temporalEchoCount) {
            state.offlineTemporalEchoTargetIds.add(reader.u64(1, 1, 2, 4));
            state.offlineTemporalEchoSourceIds.add(reader.u64(1, 1, 2, 4));
            state.offlineTemporalEchoRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            if (schemaVersion >= <uint>104) {
                var group = reader.byte(1);
                if (group > <uint>1) { throw "woc Temporal Echo group code is invalid"; }
                state.offlineTemporalEchoGroups.add(group == <uint>1);
                state.offlineTemporalEchoConvertRates.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            } else {
                state.offlineTemporalEchoGroups.add(false);
                state.offlineTemporalEchoConvertRates.add(0.35);
            }
            temporalEchoIndex = temporalEchoIndex + <uint>1;
        }
    }
    if (!offlineTemporalEchoStateIsValid(state)) {
        throw "woc Temporal Echo state is invalid";
    }
    if (schemaVersion >= <uint>105) {
        var rewindDamageCount = reader.u16(1, 1);
        if (rewindDamageCount > OFFLINE_REWIND_DAMAGE_PENDING_MAX) {
            throw "woc Rewind damage history count exceeds WOS cap";
        }
        var rewindDamageIndex: uint = <uint>0;
        while (rewindDamageIndex < rewindDamageCount) {
            state.offlineRewindDamageTargetIds.add(reader.u64(1, 1, 2, 4));
            state.offlineRewindDamageTicks.add(reader.u64(1, 1, 2, 4));
            state.offlineRewindDamageAmounts.add(<int>reader.u32(1, 1, 2));
            rewindDamageIndex = rewindDamageIndex + <uint>1;
        }
    }
    if (!offlineRewindDamageStateIsValid(state)) {
        throw "woc Rewind damage history state is invalid";
    }
    if (schemaVersion >= <uint>106) {
        var naturesFuryCount = reader.u16(1, 1);
        if (naturesFuryCount > OFFLINE_NATURES_FURY_PENDING_MAX) {
            throw "woc Nature's Fury count exceeds WOS cap";
        }
        var naturesFuryIndex: uint = <uint>0;
        while (naturesFuryIndex < naturesFuryCount) {
            state.offlineNaturesFuryTargetIds.add(reader.u64(1, 1, 2, 4));
            state.offlineNaturesFurySourceIds.add(reader.u64(1, 1, 2, 4));
            state.offlineNaturesFuryValues.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineNaturesFuryRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            naturesFuryIndex = naturesFuryIndex + <uint>1;
        }
    }
    if (!offlineNaturesFuryStateIsValid(state)) {
        throw "woc Nature's Fury state is invalid";
    }
    if (schemaVersion >= <uint>98) {
        var aetherSurgeIndex = 0;
        while (aetherSurgeIndex < state.entityIds.length) {
            state.entityAetherSurgeCharges.add(<int>reader.byte(1));
            state.entityAetherSurgeChargeRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.entityAetherSurgeFreeRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            if (schemaVersion >= <uint>100) {
                state.entityAetherSurgePerfectMomentRemaining.add(
                    reader.fixed6(1, 1, 2, 3, 5, 8)
                );
            } else {
                state.entityAetherSurgePerfectMomentRemaining.add(0.0);
            }
            aetherSurgeIndex = aetherSurgeIndex + 1;
        }
    } else {
        var historicalAetherSurgeIndex = 0;
        while (historicalAetherSurgeIndex < state.entityIds.length) {
            state.entityAetherSurgeCharges.add(0);
            state.entityAetherSurgeChargeRemaining.add(0.0);
            state.entityAetherSurgeFreeRemaining.add(0.0);
            state.entityAetherSurgePerfectMomentRemaining.add(0.0);
            historicalAetherSurgeIndex = historicalAetherSurgeIndex + 1;
        }
    }
    if (!aetherSurgeStateIsValid(state)) {
        throw "woc Aether Surge state is invalid";
    }
    if (schemaVersion >= <uint>99) {
        var aetherDartsIndex = 0;
        while (aetherDartsIndex < state.entityIds.length) {
            var pendingCode = reader.byte(1);
            if (pendingCode > <uint>1) {
                throw "woc Aether Darts pending code is invalid";
            }
            state.entityAetherDartsConsumePending.add(pendingCode == <uint>1);
            state.entityAetherDartsBonusPerBolt.add(<int>reader.byte(1));
            state.entityAetherDartsTicks.add(<int>reader.byte(1));
            aetherDartsIndex = aetherDartsIndex + 1;
        }
    } else {
        var historicalAetherDartsIndex = 0;
        while (historicalAetherDartsIndex < state.entityIds.length) {
            state.entityAetherDartsConsumePending.add(false);
            state.entityAetherDartsBonusPerBolt.add(0);
            state.entityAetherDartsTicks.add(0);
            historicalAetherDartsIndex = historicalAetherDartsIndex + 1;
        }
    }
    if (!aetherDartsStateIsValid(state)) {
        throw "woc Aether Darts state is invalid";
    }
    if (schemaVersion >= <uint>101) {
        var groupHasteIndex = 0;
        while (groupHasteIndex < state.entityIds.length) {
            state.entityGroupHasteRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.entityGroupHasteAttackBonuses.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.entityGroupHasteSpellBonuses.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.entitySatedRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            groupHasteIndex = groupHasteIndex + 1;
        }
    } else {
        var historicalGroupHasteIndex = 0;
        while (historicalGroupHasteIndex < state.entityIds.length) {
            state.entityGroupHasteRemaining.add(0.0);
            state.entityGroupHasteAttackBonuses.add(0.0);
            state.entityGroupHasteSpellBonuses.add(0.0);
            state.entitySatedRemaining.add(0.0);
            historicalGroupHasteIndex = historicalGroupHasteIndex + 1;
        }
    }
    if (!groupHasteStateIsValid(state)) {
        throw "woc group haste state is invalid";
    }
    if (schemaVersion >= <uint>102) {
        var hourglassIndex = 0;
        while (hourglassIndex < state.entityIds.length) {
            state.entityTemporalHourglassRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            var mode = reader.byte(1);
            if (mode > <uint>2) { throw "woc Temporal Hourglass mode is invalid"; }
            state.entityTemporalHourglassModes.add(mode);
            state.entityTemporalHourglassCooldownRates.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.entityTemporalHourglassHealRemaining.add(<int>reader.u32(1, 1, 2));
            state.entityTemporalHourglassHealTicksRemaining.add(<int>reader.byte(1));
            state.entityTemporalHourglassHealTickTimers.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            hourglassIndex = hourglassIndex + 1;
        }
        var groundHourglassCount = reader.u16(1, 1);
        if (groundHourglassCount > OFFLINE_DOT_PENDING_MAX) {
            throw "woc Temporal Hourglass ground count exceeds WOS cap";
        }
        var groundHourglassIndex: uint = <uint>0;
        while (groundHourglassIndex < groundHourglassCount) {
            state.offlineTemporalHourglassSourceIds.add(reader.u64(1, 1, 2, 4));
            state.offlineTemporalHourglassX.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineTemporalHourglassZ.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineTemporalHourglassRadii.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineTemporalHourglassRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            if (schemaVersion >= <uint>103) {
                state.offlineTemporalHourglassProtectiveDurations.add(
                    reader.fixed6(1, 1, 2, 3, 5, 8)
                );
                state.offlineTemporalHourglassHostilePveDurations.add(
                    reader.fixed6(1, 1, 2, 3, 5, 8)
                );
                state.offlineTemporalHourglassHostilePvpDurations.add(
                    reader.fixed6(1, 1, 2, 3, 5, 8)
                );
                state.offlineTemporalHourglassHealFractions.add(
                    reader.fixed6(1, 1, 2, 3, 5, 8)
                );
                state.offlineTemporalHourglassSelfCooldownRates.add(
                    reader.fixed6(1, 1, 2, 3, 5, 8)
                );
                state.offlineTemporalHourglassAllyCooldownRates.add(
                    reader.fixed6(1, 1, 2, 3, 5, 8)
                );
                state.offlineTemporalHourglassCreatedTicks.add(reader.u64(1, 1, 2, 4));
            } else {
                state.offlineTemporalHourglassProtectiveDurations.add(5.0);
                state.offlineTemporalHourglassHostilePveDurations.add(60.0);
                state.offlineTemporalHourglassHostilePvpDurations.add(10.0);
                state.offlineTemporalHourglassHealFractions.add(0.3);
                state.offlineTemporalHourglassSelfCooldownRates.add(2.0);
                state.offlineTemporalHourglassAllyCooldownRates.add(1.75);
                state.offlineTemporalHourglassCreatedTicks.add(state.tick);
            }
            groundHourglassIndex = groundHourglassIndex + <uint>1;
        }
    } else {
        var historicalHourglassIndex = 0;
        while (historicalHourglassIndex < state.entityIds.length) {
            state.entityTemporalHourglassRemaining.add(0.0);
            state.entityTemporalHourglassModes.add(<uint>0);
            state.entityTemporalHourglassCooldownRates.add(0.0);
            state.entityTemporalHourglassHealRemaining.add(0);
            state.entityTemporalHourglassHealTicksRemaining.add(0);
            state.entityTemporalHourglassHealTickTimers.add(0.0);
            historicalHourglassIndex = historicalHourglassIndex + 1;
        }
    }
    if (!temporalHourglassStateIsValid(state)) {
        throw "woc Temporal Hourglass state is invalid";
    }
    if (schemaVersion >= <uint>114) {
        var abilityChargeCount = reader.u16(1, 1);
        if (abilityChargeCount > OFFLINE_ABILITY_CHARGE_PENDING_MAX) {
            throw "woc ability charge count exceeds WOS cap";
        }
        var abilityChargeIndex: uint = <uint>0;
        while (abilityChargeIndex < abilityChargeCount) {
            state.offlineAbilityChargeEntityIds.add(reader.u64(1, 1, 2, 4));
            state.offlineAbilityChargeCodes.add(reader.u16(1, 1));
            state.offlineAbilityChargeCounts.add(<int>reader.byte(1));
            state.offlineAbilityChargeMaximums.add(<int>reader.byte(1));
            state.offlineAbilityChargeRechargeLengths.add(
                reader.fixed6(1, 1, 2, 3, 5, 8)
            );
            var rechargeCount = reader.byte(1);
            if (rechargeCount > <uint>255) {
                throw "woc ability charge recharge count is invalid";
            }
            var rechargeIndex: uint = <uint>0;
            while (rechargeIndex < rechargeCount) {
                state.offlineAbilityChargeRechargeRemaining.add(
                    reader.fixed6(1, 1, 2, 3, 5, 8)
                );
                rechargeIndex = rechargeIndex + <uint>1;
            }
            state.offlineAbilityChargeRechargeOffsets.add(
                <uint>state.offlineAbilityChargeRechargeRemaining.length
            );
            abilityChargeIndex = abilityChargeIndex + <uint>1;
        }
    }
    if (!offlineAbilityChargeStateIsValid(state)) {
        throw "woc ability charge state is invalid";
    }
    if (schemaVersion >= <uint>115) {
        var hunterTrapCount = reader.u16(1, 1);
        if (hunterTrapCount > OFFLINE_DOT_PENDING_MAX) {
            throw "woc Hunter trap count exceeds WOS cap";
        }
        var hunterTrapIndex: uint = <uint>0;
        while (hunterTrapIndex < hunterTrapCount) {
            state.offlineHunterTrapSourceIds.add(reader.u64(1, 1, 2, 4));
            state.offlineHunterTrapAbilityCodes.add(reader.u16(1, 1));
            state.offlineHunterTrapX.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineHunterTrapZ.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineHunterTrapRadii.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineHunterTrapRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineHunterTrapArmRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            state.offlineHunterTrapFreezeDurations.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            hunterTrapIndex = hunterTrapIndex + <uint>1;
        }
    }
    if (!offlineHunterTrapStateIsValid(state)) {
        throw "woc Hunter trap state is invalid";
    }
    if (schemaVersion >= <uint>116) {
        var leanQuiverCount = reader.u16(1, 1);
        if (leanQuiverCount > OFFLINE_DOT_PENDING_MAX) {
            throw "woc Lean Quiver proc count exceeds WOS cap";
        }
        var leanQuiverIndex: uint = <uint>0;
        while (leanQuiverIndex < leanQuiverCount) {
            state.offlineLeanQuiverEntityIds.add(reader.u64(1, 1, 2, 4));
            state.offlineLeanQuiverCounters.add(<int>reader.byte(1));
            leanQuiverIndex = leanQuiverIndex + <uint>1;
        }
    }
    if (!offlineLeanQuiverStateIsValid(state)) {
        throw "woc Lean Quiver proc state is invalid";
    }
    if (schemaVersion >= <uint>117) {
        var redlineDrawCount = reader.u16(1, 1);
        if (redlineDrawCount > OFFLINE_DOT_PENDING_MAX) {
            throw "woc Redline Draw proc count exceeds WOS cap";
        }
        var redlineDrawIndex: uint = <uint>0;
        while (redlineDrawIndex < redlineDrawCount) {
            state.offlineRedlineDrawEntityIds.add(reader.u64(1, 1, 2, 4));
            state.offlineRedlineDrawCounters.add(<int>reader.byte(1));
            state.offlineRedlineDrawIcdRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            redlineDrawIndex = redlineDrawIndex + <uint>1;
        }
    }
    if (!offlineRedlineDrawStateIsValid(state)) {
        throw "woc Redline Draw proc state is invalid";
    }
    if (schemaVersion >= <uint>118) {
        var deathlessWillCount = reader.u16(1, 1);
        if (deathlessWillCount > OFFLINE_DOT_PENDING_MAX) {
            throw "woc Deathless Will proc count exceeds WOS cap";
        }
        var deathlessWillIndex: uint = <uint>0;
        while (deathlessWillIndex < deathlessWillCount) {
            state.offlineDeathlessWillEntityIds.add(reader.u64(1, 1, 2, 4));
            state.offlineDeathlessWillIcdRemaining.add(reader.fixed6(1, 1, 2, 3, 5, 8));
            deathlessWillIndex = deathlessWillIndex + <uint>1;
        }
    }
    if (!offlineDeathlessWillStateIsValid(state)) {
        throw "woc Deathless Will proc state is invalid";
    }
    refreshAllOfflineWeaponSkins(state);
    if (!offlineWeaponSkinStateIsValid(state)) {
        throw "woc offline weapon skin state is invalid";
    }
    if (!partyMarkerStateIsValid(state)) {
        throw "woc party marker state is invalid";
    }
    if (!partyMasterLootStateIsValid(state)) {
        throw "woc party master loot state is invalid";
    }
    if (!lootRollStateIsValid(state)) {
        throw "woc loot roll state is invalid";
    }
    if (!partyLootDistributionStateIsValid(state)) {
        throw "woc party loot distribution state is invalid";
    }
    reader.finish(true);
    if (schemaVersion < <uint>48) {
        migrateWos47QuestBoarHidesToInventory(state);
    } else if (!offlineQuestInventoryStateIsValid(state)) {
        throw "woc WOS48 inventory-derived quest state is invalid";
    }
    seedOfflineM5ItemDiscoveryFromHoldings(state);
    // Source join runs a full retro deed pass even when the persisted trigger
    // state was already present. Re-evaluate the WOS81 predicates here so a
    // valid interrupted snapshot cannot strand a permanently satisfied deed.
    evaluateOfflineItemDiscoveryDeeds(state);
    evaluateOfflineCompanionUpgradeDeeds(state);
    ensureOfflineQuestNpcs(state);
    normalizeOfflineDeedTitleState(state);
    if (!offlineDeedTitleStateIsValid(state)) {
        throw "woc offline deed title state is invalid";
    }
    if (!offlineTownFocusStateIsValid(state)) {
        throw "woc offline town-focus state is invalid";
    }
    return state;
}

advanceState(state: WorldState, tick: uint, generation: uint, marker: int): void {
    if (marker != 1) {
        throw "woc world state advance marker is invalid";
    }
    if (tick != state.tick + <uint>1) {
        throw "woc fixed tick is not the next authoritative tick";
    }
    if (generation != state.generation && generation != state.generation + <uint>1) {
        throw "woc fixed tick generation is neither current nor the next reload generation";
    }
    state.tick = tick;
    state.timeMicros = state.timeMicros + <uint>50000;
    state.generation = generation;
}

movementColumnsMatch(input: binary.TickInput): bool {
    var count = input.movementFrameCount;
    return count >= 0 && input.movementActorIds.length == count &&
        input.movementActorGenerations.length == count &&
        input.movementSequences.length == count && input.movementForward.length == count &&
        input.movementBack.length == count && input.movementTurnLeft.length == count &&
        input.movementTurnRight.length == count && input.movementStrafeLeft.length == count &&
        input.movementStrafeRight.length == count && input.movementJump.length == count &&
        input.movementFacingPresent.length == count && input.movementFacing.length == count;
}

clearHeldMovement(state: WorldState, entityIndex: int): void {
    state.entityMovementForward[entityIndex] = false;
    state.entityMovementBack[entityIndex] = false;
    state.entityMovementTurnLeft[entityIndex] = false;
    state.entityMovementTurnRight[entityIndex] = false;
    state.entityMovementStrafeLeft[entityIndex] = false;
    state.entityMovementStrafeRight[entityIndex] = false;
    state.entityMovementJump[entityIndex] = false;
}

applyMovementFrames(state: WorldState, input: binary.TickInput, acceptedTick: uint): void {
    if (!movementColumnsMatch(input)) {
        throw "woc movement frame columns have different lengths";
    }
    var previousActorId: uint = <uint>0;
    var previousActorGeneration: uint = <uint>0;
    var frameIndex = 0;
    while (frameIndex < input.movementFrameCount) {
        var actorId = <uint>input.movementActorIds[frameIndex];
        var actorGeneration = <uint>input.movementActorGenerations[frameIndex];
        var sequence = <uint>input.movementSequences[frameIndex];
        if (actorId == <uint>0 || sequence == <uint>0 ||
            (frameIndex > 0 && (actorId < previousActorId ||
                (actorId == previousActorId && actorGeneration <= previousActorGeneration)))) {
            throw "woc movement frame identity or order is invalid";
        }
        previousActorId = actorId;
        previousActorGeneration = actorGeneration;
        var entityIndex = 0;
        while (entityIndex < state.entityIds.length &&
            <uint>state.entityIds[entityIndex] != actorId) {
            entityIndex = entityIndex + 1;
        }
        if (entityIndex >= state.entityIds.length ||
            <uint>state.entityGenerations[entityIndex] != actorGeneration ||
            <uint>state.entityKinds[entityIndex] != <uint>1) {
            throw "woc movement actor reference is invalid";
        }
        if (sequence > <uint>state.entityMovementAcknowledgements[entityIndex]) {
            state.entityMovementAcknowledgements[entityIndex] = sequence;
        }
        state.entityMovementAcceptedTicks[entityIndex] = acceptedTick;
        state.entityMovementForward[entityIndex] = <bool>input.movementForward[frameIndex];
        state.entityMovementBack[entityIndex] = <bool>input.movementBack[frameIndex];
        state.entityMovementTurnLeft[entityIndex] = <bool>input.movementTurnLeft[frameIndex];
        state.entityMovementTurnRight[entityIndex] = <bool>input.movementTurnRight[frameIndex];
        state.entityMovementStrafeLeft[entityIndex] = <bool>input.movementStrafeLeft[frameIndex];
        state.entityMovementStrafeRight[entityIndex] = <bool>input.movementStrafeRight[frameIndex];
        state.entityMovementJump[entityIndex] = <bool>input.movementJump[frameIndex];
        if (<bool>input.movementFacingPresent[frameIndex]) {
            state.entityFacing[entityIndex] = playerMotion.normalizeFacing(
                <float>input.movementFacing[frameIndex], true
            );
        }
        frameIndex = frameIndex + 1;
    }
}

clearStaleMovement(state: WorldState, currentTick: uint): void {
    var index = 0;
    while (index < state.entityIds.length) {
        var acknowledgement = <uint>state.entityMovementAcknowledgements[index];
        var acceptedTick = <uint>state.entityMovementAcceptedTicks[index];
        if (acknowledgement != <uint>0 && currentTick >= acceptedTick &&
            currentTick - acceptedTick > <uint>15) {
            clearHeldMovement(state, index);
        }
        index = index + 1;
    }
}

// Source updateResurrectionOffers runs once per simulation update. It removes
// proposals whose target is no longer dead as well as proposals expiring at the
// current authoritative time; later effect dispatch can create proposals before
// this shared sweep without retaining another timing path.
clearExpiredResurrectionOffers(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<bool>state.entityResurrectionOfferPresent[index] &&
            (!<bool>state.entityDead[index] ||
                state.timeMicros >= <uint>state.entityResurrectionOfferExpiresAtMicros[index])) {
            clearOfflineResurrectionOffer(state, index);
        }
        index = index + 1;
    }
}

tickResurrectionSickness(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <uint>state.entityResurrectionSicknessMicros[index];
        if (remaining != <uint>0) {
            state.entityResurrectionSicknessMicros[index] = remaining <= <uint>50000 ?
                <uint>0 : remaining - <uint>50000;
        }
        index = index + 1;
    }
}

retainedPlayerMovementSpeedMultiplier(state: WorldState, index: int): float {
    var speedMultiplier = <float>state.entityMoveSpeed[index] / playerMotion.runSpeed(true);
    // The source returns from its ghost branch before scanning any aura, so an
    // active form cannot alter dead-player movement.
    if (<bool>state.entityGhost[index]) {
        return speedMultiplier * 1.25;
    }
    return speedMultiplier * motionAuras.movementMultiplierWithStealth(
        frostboltSlowMultiplier(),
        offlineProwlIsActive(state, index) ? <float>state.entityProwlValues[index] : 1.0,
        formDerivedStats.formMovementSpeedMultiplier(
            <uint>state.entityActiveFormAbilityCodes[index]
        ),
        state.entityMotionAuraAbilityCodes,
        state.entityMotionAuraSourceIds,
        state.entityMotionAuraKindCodes,
        state.entityMotionAuraRemaining,
        state.entityMotionAuraValues,
        <int><uint>state.entityMotionAuraOffsets[index],
        <int><uint>state.entityMotionAuraOffsets[index + 1],
        true
    );
}

stepRetainedPlayerMovement(
    state: WorldState,
    index: int,
    stunned: bool,
    rooted: bool
): void {
    var transition = new motionTransition.PlayerMotionState();
    motionTransition.initialize(
        transition,
        <float>state.entityX[index],
        <float>state.entityY[index],
        <float>state.entityZ[index],
        <float>state.entityFacing[index],
        <float>state.entityVelocityX[index],
        <float>state.entityVelocityY[index],
        <float>state.entityVelocityZ[index],
        <bool>state.entityOnGround[index],
        <bool>state.entityJumping[index],
        <float>state.entityFallStartY[index],
        true
    );
    var speedMultiplier = retainedPlayerMovementSpeedMultiplier(state, index);
    motionTransition.step(
        transition,
        <bool>state.entityMovementTurnLeft[index],
        <bool>state.entityMovementTurnRight[index],
        <bool>state.entityMovementForward[index],
        <bool>state.entityMovementBack[index],
        <bool>state.entityMovementStrafeLeft[index],
        <bool>state.entityMovementStrafeRight[index],
        <bool>state.entityMovementJump[index],
        stunned,
        rooted,
        speedMultiplier,
        1.0,
        <int>state.entityMaxHp[index],
        state.worldSeed,
        true
    );
    state.entityX[index] = transition.x;
    state.entityY[index] = transition.y;
    state.entityZ[index] = transition.z;
    state.entityPreviousX[index] = transition.previousX;
    state.entityPreviousY[index] = transition.previousY;
    state.entityPreviousZ[index] = transition.previousZ;
    state.entityFacing[index] = transition.facing;
    state.entityPreviousFacing[index] = transition.previousFacing;
    state.entityVelocityX[index] = transition.velocityX;
    state.entityVelocityY[index] = transition.velocityY;
    state.entityVelocityZ[index] = transition.velocityZ;
    state.entityFallStartY[index] = transition.fallStartY;
    state.entityOnGround[index] = transition.onGround;
    state.entityJumping[index] = transition.jumping;
    if (!<bool>state.entityGhost[index] && transition.landingDamage > 0) {
        var hp = <int>state.entityHp[index] - transition.landingDamage;
        state.entityHp[index] = hp > 0 ? hp : 0;
        applyOfflineDeathlessWillDamageTaken(state, index, transition.landingDamage);
        if (hp <= 0) {
            state.entityDead[index] = true;
            clearQueuedOnSwing(state, index);
            clearOfflineComboPoints(state, index);
            clearHeldMovement(state, index);
        }
    }
}

loadCastingState(state: WorldState, index: int): casting.CastState {
    var cast = new casting.CastState();
    var flags = <uint>state.entityCastingFlags[index];
    cast.castingAbility = <uint>state.entityCastingAbility[index];
    cast.castRemaining = <float>state.entityCastRemaining[index];
    cast.castTotal = <float>state.entityCastTotal[index];
    cast.channeling = (flags & <uint>1) != <uint>0;
    cast.castAimLocked = (flags & <uint>2) != <uint>0;
    cast.castTargetLocked = (flags & <uint>4) != <uint>0;
    cast.castSchoolPhysical = (flags & <uint>8) != <uint>0;
    cast.fishing = (flags & <uint>16) != <uint>0;
    cast.stunned = (flags & <uint>32) != <uint>0;
    cast.silenced = (flags & <uint>64) != <uint>0;
    cast.schoolLockedOut = (flags & <uint>128) != <uint>0;
    cast.castShield = (flags & <uint>256) != <uint>0 ||
        icyVeinsCastShieldActive(state, index);
    cast.queuedChanneling = (flags & <uint>512) != <uint>0;
    cast.queuedPhysical = (flags & <uint>1024) != <uint>0;
    cast.queuedFishing = (flags & <uint>2048) != <uint>0;
    cast.queuedAimLocked = (flags & <uint>4096) != <uint>0;
    cast.massResurrection = (flags & <uint>8192) != <uint>0;
    cast.inCombat = (flags & <uint>16384) != <uint>0;
    cast.hasDeadGroupMember = (flags & <uint>32768) != <uint>0;
    cast.channelTickEvery = <float>state.entityChannelTickEvery[index];
    cast.channelTickTimer = <float>state.entityChannelTickTimer[index];
    cast.channelTicksLeft = <int>state.entityChannelTicksLeft[index];
    cast.castPushbackReduction = <float>state.entityCastPushbackReduction[index];
    cast.gcdRemaining = <float>state.entityCastGcdRemaining[index];
    cast.queuedAbility = <uint>state.entityQueuedCastAbility[index];
    cast.queuedDuration = <float>state.entityQueuedCastDuration[index];
    cast.queuedTickEvery = <float>state.entityQueuedChannelTickEvery[index];
    cast.queuedTickCount = <int>state.entityQueuedChannelTickCount[index];
    cast.queuedGcd = <float>state.entityQueuedCastGcd[index];
    cast.empowerStages = <int>state.entityEmpowerStages[index];
    cast.iceFloesUses = <int>state.entityIceFloesUses[index];
    cast.lastResolvedEmpowerLevel = <int>state.entityLastResolvedEmpowerLevel[index];
    cast.startedCasts = <int>state.entityCastStartedCount[index];
    cast.successfulStops = <int>state.entityCastSuccessfulStops[index];
    cast.cancelledStops = <int>state.entityCastCancelledStops[index];
    cast.resolvedCasts = <int>state.entityCastResolvedCount[index];
    cast.fishingCompletions = <int>state.entityFishingCompletions[index];
    cast.channelTicks = <int>state.entityCastChannelTicks[index];
    cast.lastCancelReason = <int>state.entityCastCancelReason[index];
    return cast;
}

storeCastingState(state: WorldState, index: int, cast: casting.CastState): void {
    var flags: uint = <uint>0;
    if (cast.channeling) { flags = flags | <uint>1; }
    if (cast.castAimLocked) { flags = flags | <uint>2; }
    if (cast.castTargetLocked) { flags = flags | <uint>4; }
    if (cast.castSchoolPhysical) { flags = flags | <uint>8; }
    if (cast.fishing) { flags = flags | <uint>16; }
    if (cast.stunned) { flags = flags | <uint>32; }
    if (cast.silenced) { flags = flags | <uint>64; }
    if (cast.schoolLockedOut) { flags = flags | <uint>128; }
    // Timed Icy Veins shielding is derived on load. Persist only a pre-existing
    // non-Icy shield bit so the aura cannot become sticky after it expires.
    if (cast.castShield && !icyVeinsCastShieldActive(state, index)) {
        flags = flags | <uint>256;
    }
    if (cast.queuedChanneling) { flags = flags | <uint>512; }
    if (cast.queuedPhysical) { flags = flags | <uint>1024; }
    if (cast.queuedFishing) { flags = flags | <uint>2048; }
    if (cast.queuedAimLocked) { flags = flags | <uint>4096; }
    if (cast.massResurrection) { flags = flags | <uint>8192; }
    if (cast.inCombat) { flags = flags | <uint>16384; }
    if (cast.hasDeadGroupMember) { flags = flags | <uint>32768; }
    state.entityCastingAbility[index] = cast.castingAbility;
    state.entityCastRemaining[index] = cast.castRemaining;
    state.entityCastTotal[index] = cast.castTotal;
    state.entityCastingFlags[index] = flags;
    state.entityChannelTickEvery[index] = cast.channelTickEvery;
    state.entityChannelTickTimer[index] = cast.channelTickTimer;
    state.entityChannelTicksLeft[index] = cast.channelTicksLeft;
    state.entityCastPushbackReduction[index] = cast.castPushbackReduction;
    state.entityCastGcdRemaining[index] = cast.gcdRemaining;
    state.entityQueuedCastAbility[index] = cast.queuedAbility;
    state.entityQueuedCastDuration[index] = cast.queuedDuration;
    state.entityQueuedChannelTickEvery[index] = cast.queuedTickEvery;
    state.entityQueuedChannelTickCount[index] = cast.queuedTickCount;
    state.entityQueuedCastGcd[index] = cast.queuedGcd;
    state.entityEmpowerStages[index] = cast.empowerStages;
    state.entityIceFloesUses[index] = cast.iceFloesUses;
    state.entityLastResolvedEmpowerLevel[index] = cast.lastResolvedEmpowerLevel;
    state.entityCastStartedCount[index] = cast.startedCasts;
    state.entityCastSuccessfulStops[index] = cast.successfulStops;
    state.entityCastCancelledStops[index] = cast.cancelledStops;
    state.entityCastResolvedCount[index] = cast.resolvedCasts;
    state.entityFishingCompletions[index] = cast.fishingCompletions;
    state.entityCastChannelTicks[index] = cast.channelTicks;
    state.entityCastCancelReason[index] = cast.lastCancelReason;
}

talentCastMobility(state: WorldState, index: int, abilityCode: uint): bool {
    if (abilityCode == <uint>0) return false;
    var modifiers = new talentModifiers.TalentModifierState();
    talentModifiers.recompute(
        modifiers,
        <uint>state.entityTalentSpecCodes[index],
        talentRowCodeAt(state, index, 0),
        talentRowCodeAt(state, index, 1),
        talentRowCodeAt(state, index, 2),
        talentRowCodeAt(state, index, 3),
        talentRowCodeAt(state, index, 4),
        talentRowCodeAt(state, index, 5)
    );
    return talentModifiers.abilityCastWhileMoving(modifiers, abilityCode);
}

offlineTalentModifiersForEntity(
    state: WorldState, entityIndex: int
): talentModifiers.TalentModifierState {
    var modifiers = new talentModifiers.TalentModifierState();
    if (entityIndex < 0 || entityIndex >= state.entityIds.length ||
        state.entityTalentSpecCodes.length != state.entityIds.length ||
        state.entityTalentRowOptionCodes.length != state.entityIds.length * 6) {
        return modifiers;
    }
    modifiers.playerLevel = <int>state.entityLevels[entityIndex];
    talentModifiers.recompute(
        modifiers,
        <uint>state.entityTalentSpecCodes[entityIndex],
        talentRowCodeAt(state, entityIndex, 0),
        talentRowCodeAt(state, entityIndex, 1),
        talentRowCodeAt(state, entityIndex, 2),
        talentRowCodeAt(state, entityIndex, 3),
        talentRowCodeAt(state, entityIndex, 4),
        talentRowCodeAt(state, entityIndex, 5)
    );
    return modifiers;
}

reduceOfflineAbilityCooldown(
    state: WorldState, casterIndex: int, abilityCode: uint, seconds: float
): void {
    if (abilityCode == <uint>0 || seconds <= 0.0) { return; }
    var expiresAt = abilityCooldownExpiresAt(state, casterIndex, abilityCode);
    if (expiresAt <= state.timeMicros) { return; }
    var reductionMicros = <uint>(seconds * 1000000.0 + 0.5);
    if (reductionMicros == <uint>0) { return; }
    var remainingMicros = expiresAt - state.timeMicros;
    if (remainingMicros <= reductionMicros) {
        clearAbilityCooldown(state, casterIndex, abilityCode);
    } else {
        setAbilityCooldownExpiration(
            state, casterIndex, abilityCode, expiresAt - reductionMicros
        );
    }
}

// Source calls this immediately after `spendResource`. The current cast has
// not armed its own cooldown yet, so only cooldown rows that predate the debit
// can be reduced.
applyOfflineOverflowingPowerCdr(
    state: WorldState, casterIndex: int, cost: int
): void {
    if (cost <= 0 || casterIndex < 0 || casterIndex >= state.entityIds.length ||
        <uint>state.entityKinds[casterIndex] != <uint>1 ||
        <uint>state.entityResourceKinds[casterIndex] != <uint>1 ||
        <float>state.entityMaxResources[casterIndex] <= 0) {
        return;
    }
    if (!overflowingPowerStateIsValid(state)) {
        throw "woc Overflowing Power state is invalid";
    }
    var modifiers = offlineTalentModifiersForEntity(state, casterIndex);
    var manaDefCdrPer10 = talentModifiers.globalField(modifiers, "manaDefCdrPer10");
    if (manaDefCdrPer10 <= 0.0) { return; }
    var used = <float>state.entityOverflowingPowerCapUsed[casterIndex];
    var available = OFFLINE_OVERFLOWING_POWER_CAP_SECONDS - used;
    if (available <= 0.0) { return; }
    var reduction = <float>cost / <float>state.entityMaxResources[casterIndex] *
        10.0 * manaDefCdrPer10;
    if (reduction > available) { reduction = available; }
    if (reduction <= 0.0) { return; }
    if (<float>state.entityOverflowingPowerCapRemaining[casterIndex] <= 0.0) {
        state.entityOverflowingPowerCapRemaining[casterIndex] =
            OFFLINE_OVERFLOWING_POWER_CAP_WINDOW_SECONDS;
    }
    state.entityOverflowingPowerCapUsed[casterIndex] = used + reduction;
    var blink = <uint>knownAbilityCatalog.abilityCode("blink");
    var iceBarrier = iceBarrierAbilityCode();
    var blazingBarrier = blazingBarrierAbilityCode();
    var greaterInvisibility = <uint>knownAbilityCatalog.abilityCode("greater_invisibility");
    reduceOfflineAbilityCooldown(state, casterIndex, blink, reduction);
    reduceOfflineAbilityCooldown(state, casterIndex, iceBarrier, reduction);
    reduceOfflineAbilityCooldown(state, casterIndex, blazingBarrier, reduction);
    reduceOfflineAbilityCooldown(state, casterIndex, greaterInvisibility, reduction);
}

// Source consumes the one-shot aura after normal cast admission, then rounds
// effect fields and the bill independently. Keep the transform at resolvers so
// it never becomes a standing spell-damage multiplier.
offlineOverloadBillableCost(baseCost: int, multiplier: float): int {
    if (baseCost <= 0) { return baseCost; }
    return multiplier > 1.0 ?
        <int>(<float>baseCost * OFFLINE_OVERLOAD_COST_MULTIPLIER + 0.5) : baseCost;
}

offlineOverloadScaledPositiveMetric(value: float, multiplier: float): float {
    if (value <= 0.0 || multiplier <= 1.0) { return value; }
    return <float><int>(value * multiplier + 0.5);
}

consumeOfflineOverloadSpell(state: WorldState, casterIndex: int, baseCost: int): float {
    if (baseCost <= 0 || casterIndex < 0 || casterIndex >= state.entityIds.length) {
        return 1.0;
    }
    if (!overloadStateIsValid(state)) {
        throw "woc Overload state is invalid before spell resolution";
    }
    var remaining = <float>state.entityOverloadRemaining[casterIndex];
    if (remaining <= 0.0) { return 1.0; }
    var value = <float>state.entityOverloadValues[casterIndex];
    state.entityOverloadRemaining[casterIndex] = 0.0;
    state.entityOverloadValues[casterIndex] = 0.0;
    return 1.0 + value;
}

consumeOfflinePowerEcho(state: WorldState, casterIndex: int): float {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length ||
        !powerEchoStateIsValid(state) ||
        <float>state.entityPowerEchoRemaining[casterIndex] <= 0.0) {
        return 0.0;
    }
    var value = <float>state.entityPowerEchoValues[casterIndex];
    state.entityPowerEchoRemaining[casterIndex] = 0.0;
    state.entityPowerEchoValues[casterIndex] = 0.0;
    return value;
}

offlineCappedResourceGain(
    state: WorldState, casterIndex: int, amount: float
): void {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || amount < 0.0 ||
        !resourcePrecisionStateIsValid(state)) {
        throw "woc offline ability resource gain is invalid";
    }
    var precision = %import("combat/resource_precision_state");
    var exact = new precision.ExactResourceState(
        <float>state.entityResources[casterIndex],
        <float>state.entityMaxResources[casterIndex]
    );
    state.entityResources[casterIndex] = precision.cappedAdd(exact, amount).current;
}

leanQuiverTalentProcIndex(): int {
    var index = 0;
    while (index < talentProcCatalog.procCount()) {
        if (talentProcCatalog.procId(index) == "hun_lean_quiver") { return index; }
        index = index + 1;
    }
    return -1;
}

offlineLeanQuiverCounterIndex(state: WorldState, ownerId: uint): int {
    var index = 0;
    while (index < state.offlineLeanQuiverEntityIds.length) {
        if (<uint>state.offlineLeanQuiverEntityIds[index] == ownerId) { return index; }
        index = index + 1;
    }
    return -1;
}

offlineLeanQuiverCounter(state: WorldState, ownerId: uint): int {
    var index = offlineLeanQuiverCounterIndex(state, ownerId);
    return index < 0 ? 0 : <int>state.offlineLeanQuiverCounters[index];
}

setOfflineLeanQuiverCounter(state: WorldState, ownerId: uint, counter: int): void {
    if (ownerId == <uint>0 || counter < 0 || counter >= 3) {
        throw "woc Lean Quiver proc counter is invalid";
    }
    var index = offlineLeanQuiverCounterIndex(state, ownerId);
    if (index >= 0) {
        state.offlineLeanQuiverCounters[index] = counter;
        return;
    }
    if (state.offlineLeanQuiverEntityIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc Lean Quiver proc state exceeds WOS cap";
    }
    state.offlineLeanQuiverEntityIds.add(ownerId);
    state.offlineLeanQuiverCounters.add(counter);
}

// The source invokes castNth from onCastCompleted. Current Hunter content has
// no free-cast producer; the explicit flag keeps a future producer on the
// generic source rule without letting a free cast advance this persisted row.
applyOfflineLeanQuiverCastCompleted(
    state: WorldState, casterIndex: int, abilityCode: uint, castConsumedEmpower: bool
): void {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length ||
        abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return;
    }
    var procIndex = leanQuiverTalentProcIndex();
    if (procIndex < 0 || !talentProcs.catalogEntryMatchesSelection(
            procIndex, talentRowCodeAt(state, casterIndex, 2), false
        )) {
        return;
    }
    var definition = talentProcs.definitionFromCatalog(procIndex);
    var ownerId = <uint>state.entityIds[casterIndex];
    var runtime = new talentProcs.TalentProcRuntimeState();
    runtime.ids.add(definition.id);
    runtime.counters.add(offlineLeanQuiverCounter(state, ownerId));
    runtime.icdRemaining.add(0.0);
    var decision = talentProcs.onCastCompleted(
        runtime,
        definition,
        knownAbilityCatalog.abilityId(<int>abilityCode),
        castConsumedEmpower,
        0.0
    );
    if (!decision.matched) { return; }
    setOfflineLeanQuiverCounter(state, ownerId, <int>runtime.counters[0]);
    if (!decision.fired) { return; }
    var responseIndex = 0;
    while (responseIndex < talentProcCatalog.procResponseCount(procIndex)) {
        var response = talentProcs.responseFromCatalog(procIndex, responseIndex);
        var plan = talentProcs.planResponse(
            definition,
            response,
            ownerId,
            ownerId,
            <int>state.entityMaxHp[casterIndex],
            true,
            false,
            0.0
        );
        if (plan.applies && plan.resourceDelta > 0.0) {
            offlineCappedResourceGain(state, casterIndex, plan.resourceDelta);
        }
        responseIndex = responseIndex + 1;
    }
}

deathlessWillTalentProcIndex(): int {
    var index = 0;
    while (index < talentProcCatalog.procCount()) {
        if (talentProcCatalog.procId(index) == "hun_deathless_will") { return index; }
        index = index + 1;
    }
    return -1;
}

deathlessWillSelectionCode(): uint {
    return talentSelectionCatalog.optionCode("hunter", 11, "hun_r11_survival_instincts");
}

offlineDeathlessWillStateIndex(state: WorldState, ownerId: uint): int {
    var index = 0;
    while (index < state.offlineDeathlessWillEntityIds.length) {
        if (<uint>state.offlineDeathlessWillEntityIds[index] == ownerId) { return index; }
        index = index + 1;
    }
    return -1;
}

offlineDeathlessWillIcdRemaining(state: WorldState, ownerId: uint): float {
    var index = offlineDeathlessWillStateIndex(state, ownerId);
    return index < 0 ? 0.0 : <float>state.offlineDeathlessWillIcdRemaining[index];
}

setOfflineDeathlessWillIcd(state: WorldState, ownerId: uint, icdRemaining: float): void {
    if (ownerId == <uint>0 || icdRemaining < 0.0 || icdRemaining > 30.0) {
        throw "woc Deathless Will proc state is invalid";
    }
    var index = offlineDeathlessWillStateIndex(state, ownerId);
    if (index >= 0) {
        state.offlineDeathlessWillIcdRemaining[index] = icdRemaining;
        return;
    }
    if (state.offlineDeathlessWillEntityIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc Deathless Will proc state exceeds WOS cap";
    }
    state.offlineDeathlessWillEntityIds.add(ownerId);
    state.offlineDeathlessWillIcdRemaining.add(icdRemaining);
}

ageOfflineDeathlessWill(state: WorldState): void {
    if (!offlineDeathlessWillStateIsValid(state)) {
        throw "woc Deathless Will proc state is invalid";
    }
    if (state.offlineDeathlessWillEntityIds.length == 0) { return; }
    var procIndex = deathlessWillTalentProcIndex();
    if (procIndex < 0) { throw "woc Deathless Will proc catalog is missing"; }
    var definition = talentProcs.definitionFromCatalog(procIndex);
    var index = 0;
    while (index < state.offlineDeathlessWillEntityIds.length) {
        var runtime = new talentProcs.TalentProcRuntimeState();
        runtime.ids.add(definition.id);
        runtime.counters.add(0);
        runtime.icdRemaining.add(<float>state.offlineDeathlessWillIcdRemaining[index]);
        talentProcs.tickProcState(runtime, 0.05);
        state.offlineDeathlessWillIcdRemaining[index] = <float>runtime.icdRemaining[0];
        index = index + 1;
    }
}

// The source invokes this only after a player's HP has received the resolved,
// post-absorb hit amount and before its death transaction marks it dead.
applyOfflineDeathlessWillDamageTaken(
    state: WorldState, targetIndex: int, resolvedDamage: int
): void {
    if (resolvedDamage <= 0 || targetIndex < 0 || targetIndex >= state.entityIds.length ||
        <uint>state.entityKinds[targetIndex] != <uint>1 || <bool>state.entityDead[targetIndex]) {
        return;
    }
    var procIndex = deathlessWillTalentProcIndex();
    var selectionCode = deathlessWillSelectionCode();
    if (procIndex < 0 || selectionCode == <uint>0 ||
        selectionCode != talentProcCatalog.selectionCode(procIndex) ||
        !talentProcs.catalogEntryMatchesSelection(
            procIndex, talentRowCodeAt(state, targetIndex, 2), false
        )) {
        return;
    }
    var definition = talentProcs.definitionFromCatalog(procIndex);
    var ownerId = <uint>state.entityIds[targetIndex];
    var runtime = new talentProcs.TalentProcRuntimeState();
    runtime.ids.add(definition.id);
    runtime.counters.add(0);
    runtime.icdRemaining.add(offlineDeathlessWillIcdRemaining(state, ownerId));
    var decision = talentProcs.onBigHitTaken(
        runtime, definition, resolvedDamage, <int>state.entityMaxHp[targetIndex]
    );
    if (!decision.matched) { return; }
    if (decision.consumesRandom) {
        throw "woc Deathless Will must not consume a random draw";
    }
    setOfflineDeathlessWillIcd(state, ownerId, <float>runtime.icdRemaining[0]);
    if (!decision.fired) { return; }
    var responseIndex = 0;
    while (responseIndex < talentProcCatalog.procResponseCount(procIndex)) {
        var response = talentProcs.responseFromCatalog(procIndex, responseIndex);
        var plan = talentProcs.planResponse(
            definition,
            response,
            ownerId,
            ownerId,
            <int>state.entityMaxHp[targetIndex],
            true,
            false,
            0.0
        );
        if (plan.applies && plan.auraTargetId == ownerId && plan.auraKind == "buff_speed" &&
            plan.auraSourceId == ownerId && plan.auraSchool == "nature") {
            applyOfflineMotionAuraWithDetailsAndSchool(
                state,
                targetIndex,
                selectionCode,
                ownerId,
                ccContract.motionAuraKindCode("buff_speed"),
                plan.auraDuration,
                plan.auraValue,
                0.0,
                OFFLINE_PROJECTILE_SCHOOL_NATURE
            );
        }
        responseIndex = responseIndex + 1;
    }
}

redlineDrawTalentProcIndex(): int {
    var index = 0;
    while (index < talentProcCatalog.procCount()) {
        if (talentProcCatalog.procId(index) == "hun_redline_draw") { return index; }
        index = index + 1;
    }
    return -1;
}

offlineRedlineDrawStateIndex(state: WorldState, ownerId: uint): int {
    var index = 0;
    while (index < state.offlineRedlineDrawEntityIds.length) {
        if (<uint>state.offlineRedlineDrawEntityIds[index] == ownerId) { return index; }
        index = index + 1;
    }
    return -1;
}

offlineRedlineDrawCounter(state: WorldState, ownerId: uint): int {
    var index = offlineRedlineDrawStateIndex(state, ownerId);
    return index < 0 ? 0 : <int>state.offlineRedlineDrawCounters[index];
}

offlineRedlineDrawIcdRemaining(state: WorldState, ownerId: uint): float {
    var index = offlineRedlineDrawStateIndex(state, ownerId);
    return index < 0 ? 0.0 : <float>state.offlineRedlineDrawIcdRemaining[index];
}

setOfflineRedlineDrawState(
    state: WorldState, ownerId: uint, counter: int, icdRemaining: float
): void {
    if (ownerId == <uint>0 || counter < 0 || counter >= 3 ||
        icdRemaining < 0.0 || icdRemaining > 8.0) {
        throw "woc Redline Draw proc state is invalid";
    }
    var index = offlineRedlineDrawStateIndex(state, ownerId);
    if (index >= 0) {
        state.offlineRedlineDrawCounters[index] = counter;
        state.offlineRedlineDrawIcdRemaining[index] = icdRemaining;
        return;
    }
    if (state.offlineRedlineDrawEntityIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc Redline Draw proc state exceeds WOS cap";
    }
    state.offlineRedlineDrawEntityIds.add(ownerId);
    state.offlineRedlineDrawCounters.add(counter);
    state.offlineRedlineDrawIcdRemaining.add(icdRemaining);
}

// The source ticks procState independently of current selection. Rehydrating
// the one retained definition keeps its counter and ICD state deterministic.
ageOfflineRedlineDraw(state: WorldState): void {
    if (!offlineRedlineDrawStateIsValid(state)) {
        throw "woc Redline Draw proc state is invalid";
    }
    if (state.offlineRedlineDrawEntityIds.length == 0) { return; }
    var procIndex = redlineDrawTalentProcIndex();
    if (procIndex < 0) { throw "woc Redline Draw proc catalog is missing"; }
    var definition = talentProcs.definitionFromCatalog(procIndex);
    var index = 0;
    while (index < state.offlineRedlineDrawEntityIds.length) {
        var runtime = new talentProcs.TalentProcRuntimeState();
        runtime.ids.add(definition.id);
        runtime.counters.add(<int>state.offlineRedlineDrawCounters[index]);
        runtime.icdRemaining.add(<float>state.offlineRedlineDrawIcdRemaining[index]);
        talentProcs.tickProcState(runtime, 0.05);
        state.offlineRedlineDrawIcdRemaining[index] = <float>runtime.icdRemaining[0];
        index = index + 1;
    }
}

// Source onCastCompleted resets a third-shot counter before its response,
// blocks all matching casts during the ICD, and has no chance draw here.
applyOfflineRedlineDrawCastCompleted(
    state: WorldState, casterIndex: int, abilityCode: uint, castConsumedEmpower: bool
): void {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length ||
        abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return;
    }
    var procIndex = redlineDrawTalentProcIndex();
    if (procIndex < 0 || !talentProcs.catalogEntryMatchesSelection(
            procIndex, talentRowCodeAt(state, casterIndex, 5), false
        )) {
        return;
    }
    var definition = talentProcs.definitionFromCatalog(procIndex);
    var ownerId = <uint>state.entityIds[casterIndex];
    var runtime = new talentProcs.TalentProcRuntimeState();
    runtime.ids.add(definition.id);
    runtime.counters.add(offlineRedlineDrawCounter(state, ownerId));
    runtime.icdRemaining.add(offlineRedlineDrawIcdRemaining(state, ownerId));
    var decision = talentProcs.onCastCompleted(
        runtime,
        definition,
        knownAbilityCatalog.abilityId(<int>abilityCode),
        castConsumedEmpower,
        0.0
    );
    if (!decision.matched) { return; }
    if (decision.consumesRandom) {
        throw "woc Redline Draw must not consume a random draw";
    }
    setOfflineRedlineDrawState(
        state, ownerId, <int>runtime.counters[0], <float>runtime.icdRemaining[0]
    );
    if (!decision.fired) { return; }
    var rapidFire = rapidFireAbilityCode();
    var responseIndex = 0;
    while (responseIndex < talentProcCatalog.procResponseCount(procIndex)) {
        var response = talentProcs.responseFromCatalog(procIndex, responseIndex);
        var expiresAt = abilityCooldownExpiresAt(state, casterIndex, rapidFire);
        var hasCooldown = expiresAt > state.timeMicros;
        var currentCooldown = hasCooldown ?
            <float>(expiresAt - state.timeMicros) / 1000000.0 : 0.0;
        var plan = talentProcs.planResponse(
            definition,
            response,
            ownerId,
            ownerId,
            <int>state.entityMaxHp[casterIndex],
            true,
            hasCooldown,
            currentCooldown
        );
        if (plan.applies && plan.cooldownAbilityId == "rapid_fire") {
            if (plan.cooldownMutation == 2) {
                clearAbilityCooldown(state, casterIndex, rapidFire);
            } else if (plan.cooldownMutation == 1) {
                var nextExpires = state.timeMicros + <uint>(
                    plan.cooldownRemaining * 1000000.0 + 0.5
                );
                if (nextExpires <= state.timeMicros) {
                    clearAbilityCooldown(state, casterIndex, rapidFire);
                } else {
                    setAbilityCooldownExpiration(state, casterIndex, rapidFire, nextExpires);
                }
            }
        }
        responseIndex = responseIndex + 1;
    }
}

spendOfflineAbilityResource(state: WorldState, casterIndex: int, cost: int): void {
    if (cost <= 0 || casterIndex < 0 || casterIndex >= state.entityIds.length) {
        throw "woc offline ability resource spend is invalid";
    }
    if (!resourcePrecisionStateIsValid(state)) {
        throw "woc offline ability resource state is invalid";
    }
    var precision = %import("combat/resource_precision_state");
    var exact = new precision.ExactResourceState(
        <float>state.entityResources[casterIndex],
        <float>state.entityMaxResources[casterIndex]
    );
    state.entityResources[casterIndex] = precision.canSpend(exact, <float>cost) ?
        precision.spend(exact, <float>cost).current : 0.0;
    applyOfflineOverflowingPowerCdr(state, casterIndex, cost);
}

motionAuraEntityIsStunned(state: WorldState, index: int): bool {
    if (!motionAuraStateIsValid(state, index)) {
        throw "woc entity motion aura state is invalid";
    }
    return motionAuras.isStunned(
        state.entityMotionAuraAbilityCodes,
        state.entityMotionAuraSourceIds,
        state.entityMotionAuraKindCodes,
        state.entityMotionAuraRemaining,
        <int><uint>state.entityMotionAuraOffsets[index],
        <int><uint>state.entityMotionAuraOffsets[index + 1],
        true
    );
}

motionAuraEntityIsRooted(state: WorldState, index: int): bool {
    if (!motionAuraStateIsValid(state, index)) {
        throw "woc entity motion aura state is invalid";
    }
    return motionAuras.isRooted(
        state.entityMotionAuraAbilityCodes,
        state.entityMotionAuraSourceIds,
        state.entityMotionAuraKindCodes,
        state.entityMotionAuraRemaining,
        <int><uint>state.entityMotionAuraOffsets[index],
        <int><uint>state.entityMotionAuraOffsets[index + 1],
        true
    );
}

removeMotionAuraAt(state: WorldState, entityIndex: int, auraIndex: int): void {
    var removedAbilityCode = <uint>state.entityMotionAuraAbilityCodes[auraIndex];
    state.entityMotionAuraAbilityCodes.removeAt(auraIndex);
    state.entityMotionAuraSourceIds.removeAt(auraIndex);
    state.entityMotionAuraSchoolCodes.removeAt(auraIndex);
    state.entityMotionAuraKindCodes.removeAt(auraIndex);
    state.entityMotionAuraRemaining.removeAt(auraIndex);
    state.entityMotionAuraValues.removeAt(auraIndex);
    state.entityMotionAuraBreakChanceScales.removeAt(auraIndex);
    var offsetIndex = entityIndex + 1;
    while (offsetIndex < state.entityMotionAuraOffsets.length) {
        state.entityMotionAuraOffsets[offsetIndex] =
            <uint>state.entityMotionAuraOffsets[offsetIndex] - <uint>1;
        offsetIndex = offsetIndex + 1;
    }
    if (removedAbilityCode == tigersFuryAbilityCode()) {
        clearOfflineTigersFuryTalentState(state, entityIndex);
    }
}

toggleOfflineGhostWolf(state: WorldState, casterIndex: int): void {
    var abilityCode = ghostWolfAbilityCode();
    var start = <int><uint>state.entityMotionAuraOffsets[casterIndex];
    var end = <int><uint>state.entityMotionAuraOffsets[casterIndex + 1];
    var auraIndex = start;
    while (auraIndex < end) {
        if (<uint>state.entityMotionAuraAbilityCodes[auraIndex] == abilityCode) {
            removeMotionAuraAt(state, casterIndex, auraIndex);
            return;
        }
        auraIndex = auraIndex + 1;
    }
    applyOfflineMotionAuraWithDetails(
        state,
        casterIndex,
        abilityCode,
        <uint>state.entityIds[casterIndex],
        ccContract.motionAuraKindCode("buff_speed"),
        ghostWolfDuration(),
        1.4,
        0.0
    );
}

// Source aura ids distinguish effects from the same ability (for example,
// Glacial Front's slow and maximum-stage root), so this compact projection uses
// ability plus kind as its refresh key. Hemorrhage's source id also includes
// the caster, so its `bleed_vuln` rows refresh per source and stack across
// distinct Rogues.
applyOfflineMotionAura(
    state: WorldState,
    targetIndex: int,
    abilityCode: uint,
    sourceId: uint,
    kindCode: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAuraWithDetails(
        state,
        targetIndex,
        abilityCode,
        sourceId,
        kindCode,
        durationSeconds,
        0.0,
        0.0
    );
}

applyOfflineMotionAuraWithDetails(
    state: WorldState,
    targetIndex: int,
    abilityCode: uint,
    sourceId: uint,
    kindCode: uint,
    durationSeconds: float,
    value: float,
    breakChanceScale: float
): void {
    applyOfflineMotionAuraWithDetailsAndSchool(
        state, targetIndex, abilityCode, sourceId, kindCode, durationSeconds,
        value, breakChanceScale, OFFLINE_PROJECTILE_SCHOOL_PHYSICAL
    );
}

applyOfflineMotionAuraWithDetailsAndSchool(
    state: WorldState,
    targetIndex: int,
    abilityCode: uint,
    sourceId: uint,
    kindCode: uint,
    durationSeconds: float,
    value: float,
    breakChanceScale: float,
    schoolCode: uint
): void {
    if (!motionAuraStateIsValid(state, targetIndex) || abilityCode == <uint>0 ||
        kindCode == <uint>0 || sourceId == <uint>0 || durationSeconds <= 0.0 ||
        !motionAuraDetailsStateIsValid(state) || breakChanceScale < 0.0 ||
        breakChanceScale > 1.0 || !motionAuraSchoolStateIsValid(state) ||
        schoolCode > OFFLINE_PROJECTILE_SCHOOL_FIRE ||
        (kindCode == ccContract.motionAuraKindCode("lockout") &&
            schoolCode == OFFLINE_PROJECTILE_SCHOOL_PHYSICAL)) {
        throw "woc motion aura state is invalid";
    }
    var start = <int><uint>state.entityMotionAuraOffsets[targetIndex];
    var end = <int><uint>state.entityMotionAuraOffsets[targetIndex + 1];
    var bleedVulnerability = ccContract.motionAuraKindCode("bleed_vuln");
    // Source aura replacement is keyed by same aura id and source. This WOC
    // projection normally uses ability plus kind as the source identity, while
    // damage debuffs and movement snares must additionally retain the caster.
    var slow = ccContract.motionAuraKindCode("slow");
    var auraIndex = start;
    while (auraIndex < end) {
        if (<uint>state.entityMotionAuraAbilityCodes[auraIndex] == abilityCode &&
            <uint>state.entityMotionAuraKindCodes[auraIndex] == kindCode &&
            ((kindCode != bleedVulnerability && kindCode != slow) ||
                <uint>state.entityMotionAuraSourceIds[auraIndex] == sourceId)) {
            state.entityMotionAuraSourceIds[auraIndex] = sourceId;
            state.entityMotionAuraSchoolCodes[auraIndex] = schoolCode;
            state.entityMotionAuraKindCodes[auraIndex] = kindCode;
            state.entityMotionAuraRemaining[auraIndex] = durationSeconds;
            state.entityMotionAuraValues[auraIndex] = value;
            state.entityMotionAuraBreakChanceScales[auraIndex] = breakChanceScale;
            return;
        }
        auraIndex = auraIndex + 1;
    }
    state.entityMotionAuraAbilityCodes.add(<uint>0);
    state.entityMotionAuraSourceIds.add(<uint>0);
    state.entityMotionAuraSchoolCodes.add(<uint>0);
    state.entityMotionAuraKindCodes.add(<uint>0);
    state.entityMotionAuraRemaining.add(0.0);
    state.entityMotionAuraValues.add(0.0);
    state.entityMotionAuraBreakChanceScales.add(0.0);
    var cursor = state.entityMotionAuraAbilityCodes.length - 1;
    while (cursor > end) {
        state.entityMotionAuraAbilityCodes[cursor] =
            <uint>state.entityMotionAuraAbilityCodes[cursor - 1];
        state.entityMotionAuraSourceIds[cursor] =
            <uint>state.entityMotionAuraSourceIds[cursor - 1];
        state.entityMotionAuraSchoolCodes[cursor] =
            <uint>state.entityMotionAuraSchoolCodes[cursor - 1];
        state.entityMotionAuraKindCodes[cursor] =
            <uint>state.entityMotionAuraKindCodes[cursor - 1];
        state.entityMotionAuraRemaining[cursor] =
            <float>state.entityMotionAuraRemaining[cursor - 1];
        state.entityMotionAuraValues[cursor] =
            <float>state.entityMotionAuraValues[cursor - 1];
        state.entityMotionAuraBreakChanceScales[cursor] =
            <float>state.entityMotionAuraBreakChanceScales[cursor - 1];
        cursor = cursor - 1;
    }
    state.entityMotionAuraAbilityCodes[end] = abilityCode;
    state.entityMotionAuraSourceIds[end] = sourceId;
    state.entityMotionAuraSchoolCodes[end] = schoolCode;
    state.entityMotionAuraKindCodes[end] = kindCode;
    state.entityMotionAuraRemaining[end] = durationSeconds;
    state.entityMotionAuraValues[end] = value;
    state.entityMotionAuraBreakChanceScales[end] = breakChanceScale;
    var offsetIndex = targetIndex + 1;
    while (offsetIndex < state.entityMotionAuraOffsets.length) {
        state.entityMotionAuraOffsets[offsetIndex] =
            <uint>state.entityMotionAuraOffsets[offsetIndex] + <uint>1;
        offsetIndex = offsetIndex + 1;
    }
}

// WOS60's source identity is `gouge_incap`, which this ability-keyed row
// preserves while leaving its break-on-damage rule to the dedicated reducer.
applyOfflineGougeIncapacitate(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAura(
        state,
        targetIndex,
        gougeAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("incapacitate"),
        durationSeconds
    );
}

applyOfflineKidneyShotStun(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAura(
        state,
        targetIndex,
        kidneyShotAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("stun"),
        durationSeconds
    );
}

applyOfflineBashStun(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAura(
        state,
        targetIndex,
        bashAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("stun"),
        durationSeconds
    );
}

applyOfflinePounceStun(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAura(
        state,
        targetIndex,
        pounceAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("stun"),
        durationSeconds
    );
}

applyOfflineFaerieFire(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAuraWithDetails(
        state,
        targetIndex,
        faerieFireAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("faerie_fire"),
        durationSeconds,
        0.0,
        0.0
    );
}

// The retained damage paths call this only after they have resolved positive
// post-mitigation damage. Gouge follows the classic immediate break path;
// Fear consumes exactly one draw for its source graded chance while it remains.
clearOfflineBreakableIncapacitateOnDamage(
    state: WorldState,
    targetIndex: int,
    amount: int
): void {
    if (amount <= 0) { return; }
    if (<uint>state.entityTemporalHourglassModes[targetIndex] == <uint>2) {
        clearOfflineTemporalHourglass(state, targetIndex);
    }
    clearOfflineProwl(state, targetIndex);
    clearOfflineConsumables(state, targetIndex);
    state.entitySitting[targetIndex] = false;
    if (!motionAuraStateIsValid(state, targetIndex) ||
        !motionAuraDetailsStateIsValid(state)) { return; }
    var gougeCode = gougeAbilityCode();
    var fearCode = fearAbilityCode();
    var hibernateCode = hibernateAbilityCode();
    var dragonsBreathCode = dragonsBreathAbilityCode();
    var startleShotCode = startleShotAbilityCode();
    var incapKind = ccContract.motionAuraKindCode("incapacitate");
    var auraIndex = <int><uint>state.entityMotionAuraOffsets[targetIndex];
    var auraEnd = <int><uint>state.entityMotionAuraOffsets[targetIndex + 1];
    while (auraIndex < auraEnd) {
        var abilityCode = <uint>state.entityMotionAuraAbilityCodes[auraIndex];
        if (<uint>state.entityMotionAuraKindCodes[auraIndex] != incapKind ||
            (abilityCode != gougeCode && abilityCode != fearCode &&
                abilityCode != hibernateCode && abilityCode != dragonsBreathCode &&
                abilityCode != startleShotCode)) {
            auraIndex = auraIndex + 1;
            continue;
        }
        if (abilityCode == fearCode) {
            var scale = <float>state.entityMotionAuraBreakChanceScales[auraIndex];
            var maximum = <int>state.entityMaxHp[targetIndex];
            if (scale > 0.0 && maximum > 0) {
                var chance = <float>amount / (scale * <float>maximum);
                if (chance > 1.0) { chance = 1.0; }
                if (nextAuthoritativeRandomUnit(state) >= chance) {
                    auraIndex = auraIndex + 1;
                    continue;
                }
            }
        }
        if (abilityCode == gougeCode || abilityCode == fearCode ||
            abilityCode == hibernateCode || abilityCode == dragonsBreathCode ||
            abilityCode == startleShotCode) {
            removeMotionAuraAt(state, targetIndex, auraIndex);
            auraEnd = auraEnd - 1;
        }
    }
}

// Expiry runs after that entity's cast progression. Removing a row shifts the
// later entity partitions in lockstep, preserving source aura order.
ageMotionAurasForEntity(state: WorldState, index: int): void {
    var auraIndex = <int><uint>state.entityMotionAuraOffsets[index];
    var auraEnd = <int><uint>state.entityMotionAuraOffsets[index + 1];
    while (auraIndex < auraEnd) {
        var seconds = <float>state.entityMotionAuraRemaining[auraIndex];
        if (motionAuras.remainsActiveAfterTick(seconds, true)) {
            state.entityMotionAuraRemaining[auraIndex] =
                motionAuras.remainingAfterTick(seconds, true);
            auraIndex = auraIndex + 1;
        } else {
            removeMotionAuraAt(state, index, auraIndex);
            auraEnd = auraEnd - 1;
        }
    }
}

// Sunder's source aura ticks independently of movement and casting. Keep its
// 50ms WOS age sweep global because its target is an Eastbrook mob rather than
// the player-only motion-aura owner.
ageOfflineSunderArmor(state: WorldState): void {
    if (!sunderArmorStateIsValid(state)) {
        throw "woc Sunder Armor state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<int>state.entitySunderArmorStacks[index] > 0) {
            var remaining = <float>state.entitySunderArmorRemaining[index];
            if (remaining > 0.05) {
                state.entitySunderArmorRemaining[index] = remaining - 0.05;
            } else {
                state.entitySunderArmorStacks[index] = 0;
                state.entitySunderArmorRemaining[index] = 0.0;
                state.entitySunderArmorValues[index] = 0.0;
            }
        }
        index = index + 1;
    }
}

ageOfflineCritVuln(state: WorldState): void {
    if (!offlineCritVulnStateIsValid(state)) {
        throw "woc crit vulnerability state is invalid";
    }
    var index = 0;
    while (index < state.offlineCritVulnTargetIds.length) {
        var remaining = <float>state.offlineCritVulnRemaining[index] -
            projectileTravel.projectileTickSeconds();
        if (remaining <= OFFLINE_PERIODIC_TICK_EPS) {
            removeOfflineCritVulnAt(state, index);
        } else {
            state.offlineCritVulnRemaining[index] = remaining;
            index = index + 1;
        }
    }
}

// Fire's source auras age with the same fixed 50ms WOS cadence as other
// retained aura state. One Hot Streak row represents its inseparable free and
// instant aura pair; Heating Up remains an independent source window.
ageOfflineFireMageProcs(state: WorldState): void {
    if (!fireMageProcStateIsValid(state)) {
        throw "woc Fire Mage proc state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var heating = <float>state.entityHeatingUpRemaining[index];
        if (heating > 0.05) {
            state.entityHeatingUpRemaining[index] = heating - 0.05;
        } else if (heating > 0.0) {
            state.entityHeatingUpRemaining[index] = 0.0;
        }
        var hotStreak = <float>state.entityHotStreakRemaining[index];
        if (hotStreak > 0.05) {
            state.entityHotStreakRemaining[index] = hotStreak - 0.05;
        } else if (hotStreak > 0.0) {
            state.entityHotStreakRemaining[index] = 0.0;
        }
        var combustion = <float>state.entityCombustionRemaining[index];
        if (combustion > 0.05) {
            state.entityCombustionRemaining[index] = combustion - 0.05;
        } else if (combustion > 0.0) {
            state.entityCombustionRemaining[index] = 0.0;
        }
        index = index + 1;
    }
}

// Arcane Power's source aura ids age independently: cancel_aura may strip one
// while the other continues. The damage multiplier is materialized for
// projectile/burst reducers; haste remains a live multiplier read.
ageOfflineArcanePower(state: WorldState): void {
    if (!arcanePowerStateIsValid(state)) {
        throw "woc Arcane Power state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityArcanePowerRemaining[index];
        if (remaining > 0.05) {
            state.entityArcanePowerRemaining[index] = remaining - 0.05;
        } else if (remaining > 0.0) {
            state.entityArcanePowerRemaining[index] = 0.0;
            state.entitySpellDamageMultipliers[index] = 1.0;
        }
        var hasteRemaining = <float>state.entityArcanePowerSpellHasteRemaining[index];
        if (hasteRemaining > 0.05) {
            state.entityArcanePowerSpellHasteRemaining[index] = hasteRemaining - 0.05;
        } else if (hasteRemaining > 0.0) {
            state.entityArcanePowerSpellHasteRemaining[index] = 0.0;
        }
        index = index + 1;
    }
}

// Icy Veins has two source aura identities, so cancellation and expiry age the
// haste contribution and cast shield independently.
ageOfflineIcyVeins(state: WorldState): void {
    if (!icyVeinsStateIsValid(state)) {
        throw "woc Icy Veins state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var hasteRemaining = <float>state.entityIcyVeinsSpellHasteRemaining[index];
        if (hasteRemaining > 0.05) {
            state.entityIcyVeinsSpellHasteRemaining[index] = hasteRemaining - 0.05;
        } else if (hasteRemaining > 0.0) {
            state.entityIcyVeinsSpellHasteRemaining[index] = 0.0;
        }
        var shieldRemaining = <float>state.entityIcyVeinsCastShieldRemaining[index];
        if (shieldRemaining > 0.05) {
            state.entityIcyVeinsCastShieldRemaining[index] = shieldRemaining - 0.05;
        } else if (shieldRemaining > 0.0) {
            state.entityIcyVeinsCastShieldRemaining[index] = 0.0;
        }
        index = index + 1;
    }
}

// The source's `overflowing_power_cap` internal-cooldown aura owns both the
// rolling-window lifetime and its accumulated reduction. Keep the accumulator
// until expiry, then clear both values atomically for the next mana debit.
ageOfflineOverflowingPower(state: WorldState): void {
    if (!overflowingPowerStateIsValid(state)) {
        throw "woc Overflowing Power state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityOverflowingPowerCapRemaining[index];
        if (remaining > 0.05) {
            state.entityOverflowingPowerCapRemaining[index] = remaining - 0.05;
        } else if (remaining > 0.0) {
            state.entityOverflowingPowerCapRemaining[index] = 0.0;
            state.entityOverflowingPowerCapUsed[index] = 0.0;
        }
        index = index + 1;
    }
}

ageOfflineOverload(state: WorldState): void {
    if (!overloadStateIsValid(state)) {
        throw "woc Overload state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityOverloadRemaining[index];
        if (remaining > 0.05) {
            state.entityOverloadRemaining[index] = remaining - 0.05;
        } else if (remaining > 0.0) {
            state.entityOverloadRemaining[index] = 0.0;
            state.entityOverloadValues[index] = 0.0;
        }
        index = index + 1;
    }
}

ageOfflinePowerEcho(state: WorldState): void {
    if (!powerEchoStateIsValid(state)) {
        throw "woc Power Echo state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityPowerEchoRemaining[index];
        if (remaining > 0.05) {
            state.entityPowerEchoRemaining[index] = remaining - 0.05;
        } else if (remaining > 0.0) {
            state.entityPowerEchoRemaining[index] = 0.0;
            state.entityPowerEchoValues[index] = 0.0;
        }
        index = index + 1;
    }
}

// Charge and Aether Rush are distinct source aura identities. The fixed tick
// may expire either while a timed Surge is armed, so completion reads live
// state after this aging pass just as the source does.
ageOfflineAetherSurge(state: WorldState): void {
    if (!aetherSurgeStateIsValid(state)) {
        throw "woc Aether Surge state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var chargeRemaining = <float>state.entityAetherSurgeChargeRemaining[index];
        if (chargeRemaining > 0.05) {
            state.entityAetherSurgeChargeRemaining[index] = chargeRemaining - 0.05;
        } else if (chargeRemaining > 0.0) {
            state.entityAetherSurgeChargeRemaining[index] = 0.0;
            state.entityAetherSurgeCharges[index] = 0;
        }
        var freeRemaining = <float>state.entityAetherSurgeFreeRemaining[index];
        if (freeRemaining > 0.05) {
            state.entityAetherSurgeFreeRemaining[index] = freeRemaining - 0.05;
        } else if (freeRemaining > 0.0) {
            state.entityAetherSurgeFreeRemaining[index] = 0.0;
        }
        var perfectMomentRemaining =
            <float>state.entityAetherSurgePerfectMomentRemaining[index];
        if (perfectMomentRemaining > 0.05) {
            state.entityAetherSurgePerfectMomentRemaining[index] =
                perfectMomentRemaining - 0.05;
        } else if (perfectMomentRemaining > 0.0) {
            state.entityAetherSurgePerfectMomentRemaining[index] = 0.0;
        }
        index = index + 1;
    }
}

ageOfflineGroupHaste(state: WorldState): void {
    if (!groupHasteStateIsValid(state)) {
        throw "woc group haste state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityGroupHasteRemaining[index];
        if (remaining > 0.05) {
            state.entityGroupHasteRemaining[index] = remaining - 0.05;
        } else if (remaining > 0.0) {
            state.entityGroupHasteRemaining[index] = 0.0;
            state.entityGroupHasteAttackBonuses[index] = 0.0;
            state.entityGroupHasteSpellBonuses[index] = 0.0;
        }
        var satedRemaining = <float>state.entitySatedRemaining[index];
        if (satedRemaining > 0.05) {
            state.entitySatedRemaining[index] = satedRemaining - 0.05;
        } else if (satedRemaining > 0.0) {
            state.entitySatedRemaining[index] = 0.0;
        }
        index = index + 1;
    }
}

removeOfflineTemporalHourglassGroundAt(state: WorldState, index: int): void {
    state.offlineTemporalHourglassSourceIds.removeAt(index);
    state.offlineTemporalHourglassX.removeAt(index);
    state.offlineTemporalHourglassZ.removeAt(index);
    state.offlineTemporalHourglassRadii.removeAt(index);
    state.offlineTemporalHourglassRemaining.removeAt(index);
    state.offlineTemporalHourglassProtectiveDurations.removeAt(index);
    state.offlineTemporalHourglassHostilePveDurations.removeAt(index);
    state.offlineTemporalHourglassHostilePvpDurations.removeAt(index);
    state.offlineTemporalHourglassHealFractions.removeAt(index);
    state.offlineTemporalHourglassSelfCooldownRates.removeAt(index);
    state.offlineTemporalHourglassAllyCooldownRates.removeAt(index);
    state.offlineTemporalHourglassCreatedTicks.removeAt(index);
}

// Returns the first segment/disk contact fraction or -1 when the target did
// not enter the zone this fixed tick. The contact ordering matches source.
temporalHourglassGroundContact(
    startX: float, startZ: float, endX: float, endZ: float,
    centerX: float, centerZ: float, radius: float
): float {
    var sx = startX - centerX;
    var sz = startZ - centerZ;
    if (sx * sx + sz * sz <= radius * radius) { return 0.0; }
    var dx = endX - startX;
    var dz = endZ - startZ;
    var a = dx * dx + dz * dz;
    if (a <= 0.0) { return -1.0; }
    var b = 2.0 * (sx * dx + sz * dz);
    var c = sx * sx + sz * sz - radius * radius;
    var discriminant = b * b - 4.0 * a * c;
    if (discriminant < 0.0) { return -1.0; }
    var contact = (-b - math.sqrt(discriminant)) / (2.0 * a);
    return contact >= 0.0 && contact <= 1.0 ? contact : -1.0;
}

stepOfflineTemporalHourglassGround(state: WorldState): void {
    if (!temporalHourglassStateIsValid(state)) {
        throw "woc Temporal Hourglass state is invalid";
    }
    var groundIndex = state.offlineTemporalHourglassSourceIds.length - 1;
    while (groundIndex >= 0) {
        var sourceIndex = partyEntityIndexById(
            state, <uint>state.offlineTemporalHourglassSourceIds[groundIndex]
        );
        if (sourceIndex < 0 || <bool>state.entityDead[sourceIndex]) {
            removeOfflineTemporalHourglassGroundAt(state, groundIndex);
            groundIndex = groundIndex - 1;
            continue;
        }
        var winner = -1;
        var winnerContact = 0.0;
        var targetIndex = 0;
        while (targetIndex < state.entityIds.length) {
            if (!<bool>state.entityDead[targetIndex]) {
                var contactStartX = <float>state.entityPreviousX[targetIndex];
                var contactStartZ = <float>state.entityPreviousZ[targetIndex];
                if (state.tick ==
                    <uint>state.offlineTemporalHourglassCreatedTicks[groundIndex] + <uint>1) {
                    contactStartX = <float>state.entityX[targetIndex];
                    contactStartZ = <float>state.entityZ[targetIndex];
                }
                var contact = temporalHourglassGroundContact(
                    contactStartX,
                    contactStartZ,
                    <float>state.entityX[targetIndex],
                    <float>state.entityZ[targetIndex],
                    <float>state.offlineTemporalHourglassX[groundIndex],
                    <float>state.offlineTemporalHourglassZ[groundIndex],
                    <float>state.offlineTemporalHourglassRadii[groundIndex]
                );
                var isSelf = targetIndex == sourceIndex;
                var isAlly = !isSelf && partyIdForIndex(state, sourceIndex) != <uint>0 &&
                    partyIdForIndex(state, targetIndex) == partyIdForIndex(state, sourceIndex) &&
                    <uint>state.entityKinds[targetIndex] == <uint>1 &&
                    !<bool>state.entityHostile[targetIndex];
                var isHostile = <bool>state.entityHostile[targetIndex];
                if (contact >= 0.0 && (isSelf || isAlly || isHostile) &&
                    (winner < 0 || contact < winnerContact ||
                        (contact == winnerContact && <uint>state.entityIds[targetIndex] <
                            <uint>state.entityIds[winner]))) {
                    winner = targetIndex;
                    winnerContact = contact;
                }
            }
            targetIndex = targetIndex + 1;
        }
        if (winner >= 0) {
            if (winner == sourceIndex ||
                (<uint>state.entityKinds[winner] == <uint>1 &&
                    !<bool>state.entityHostile[winner] &&
                    partyIdForIndex(state, winner) == partyIdForIndex(state, sourceIndex))) {
                var rate = winner == sourceIndex ?
                    <float>state.offlineTemporalHourglassSelfCooldownRates[groundIndex] :
                    <float>state.offlineTemporalHourglassAllyCooldownRates[groundIndex];
                applyOfflineProtectiveTemporalHourglass(
                    state, winner,
                    <float>state.offlineTemporalHourglassProtectiveDurations[groundIndex],
                    rate, <float>state.offlineTemporalHourglassHealFractions[groundIndex]
                );
            } else {
                applyOfflineHostileTemporalHourglass(
                    state, winner,
                    <float>state.offlineTemporalHourglassHostilePveDurations[groundIndex]
                );
                enterOfflineSpellProjectileCombat(state, sourceIndex, winner);
            }
            removeOfflineTemporalHourglassGroundAt(state, groundIndex);
        } else {
            var remaining = <float>state.offlineTemporalHourglassRemaining[groundIndex] - 0.05;
            if (remaining <= 0.0) {
                removeOfflineTemporalHourglassGroundAt(state, groundIndex);
            } else {
                state.offlineTemporalHourglassRemaining[groundIndex] = remaining;
            }
        }
        groundIndex = groundIndex - 1;
    }
}

accelerateTemporalHourglassCooldowns(state: WorldState, entityIndex: int, rate: float): void {
    var aura = new temporalHourglass.TemporalHourglassState();
    aura.id = temporalHourglassContract.id(true);
    aura.kind = temporalHourglassContract.stasisKind(true);
    aura.cooldownRate = rate;
    var extraSeconds = temporalHourglass.temporalHourglassCooldownDelta(
        aura, "other"
    ) - temporalHourglassContract.defaultCooldownDelta(true);
    if (extraSeconds <= 0.0) { return; }
    var extraMicros = <uint>(extraSeconds * 1000000.0 + 0.5);
    var hourglassAbility = temporalHourglassAbilityCode();
    var index = <int><uint>state.entityAbilityCooldownOffsets[entityIndex];
    var end = <int><uint>state.entityAbilityCooldownOffsets[entityIndex + 1];
    while (index < end) {
        if (<uint>state.entityAbilityCooldownCodes[index] != hourglassAbility &&
            <uint>state.entityAbilityCooldownExpiresAtMicros[index] > state.timeMicros) {
            var expiresAt = <uint>state.entityAbilityCooldownExpiresAtMicros[index];
            if (expiresAt - state.timeMicros <= extraMicros) {
                state.entityAbilityCooldownExpiresAtMicros[index] = state.timeMicros;
            } else {
                state.entityAbilityCooldownExpiresAtMicros[index] = expiresAt - extraMicros;
            }
        }
        index = index + 1;
    }
}

ageOfflineTemporalHourglass(state: WorldState): void {
    if (!temporalHourglassStateIsValid(state)) {
        throw "woc Temporal Hourglass state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var mode = <uint>state.entityTemporalHourglassModes[index];
        var remaining = <float>state.entityTemporalHourglassRemaining[index];
        if (mode == <uint>1 && remaining > 0.0) {
            accelerateTemporalHourglassCooldowns(
                state, index, <float>state.entityTemporalHourglassCooldownRates[index]
            );
            var timer = <float>state.entityTemporalHourglassHealTickTimers[index] - 0.05;
            if (timer <= OFFLINE_PERIODIC_TICK_EPS) {
                var aura = new temporalHourglass.TemporalHourglassState();
                aura.id = temporalHourglassContract.id(true);
                aura.kind = temporalHourglassContract.stasisKind(true);
                aura.cooldownRate = <float>state.entityTemporalHourglassCooldownRates[index];
                aura.hp = <int>state.entityHp[index];
                aura.maxHp = <int>state.entityMaxHp[index];
                aura.temporalHealRemaining = <int>state.entityTemporalHourglassHealRemaining[index];
                aura.temporalHealTicksRemaining =
                    <int>state.entityTemporalHourglassHealTicksRemaining[index];
                temporalHourglass.tickTemporalHourglassHealing(aura);
                state.entityHp[index] = aura.hp;
                state.entityTemporalHourglassHealRemaining[index] = aura.temporalHealRemaining;
                state.entityTemporalHourglassHealTicksRemaining[index] =
                    aura.temporalHealTicksRemaining;
                timer = timer + 1.0;
            }
            state.entityTemporalHourglassHealTickTimers[index] = timer;
        }
        if (remaining > 0.05) {
            state.entityTemporalHourglassRemaining[index] = remaining - 0.05;
        } else if (remaining > 0.0) {
            clearOfflineTemporalHourglass(state, index);
        }
        index = index + 1;
    }
}

// The source expires demoralizing_roar_ap independently of any target action.
// This runs beside the Sunder age sweep before hostile swings read AP.
ageOfflineDemoralizingRoar(state: WorldState): void {
    if (!demoralizingRoarStateIsValid(state)) {
        throw "woc Demoralizing Roar state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityDemoralizingRoarRemaining[index];
        if (remaining > 0.0) {
            if (remaining > 0.05) {
                state.entityDemoralizingRoarRemaining[index] = remaining - 0.05;
            } else {
                state.entityDemoralizingRoarRemaining[index] = 0.0;
                state.entityDemoralizingRoarValues[index] = 0.0;
            }
        }
        index = index + 1;
    }
}

offlineProwlIsActive(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length &&
        <float>state.entityProwlRemaining[index] > 0.0 &&
        <float>state.entityProwlValues[index] == 0.5;
}

clearOfflineProwl(state: WorldState, index: int): void {
    if (index < 0 || index >= state.entityIds.length) { return; }
    state.entityProwlRemaining[index] = 0.0;
    state.entityProwlValues[index] = 0.0;
}

// Prowl is an ordinary source self-buff, so its clock advances independently
// of movement and casting and clears both retained fields at the same tick.
ageOfflineProwl(state: WorldState): void {
    if (!prowlStateIsValid(state)) {
        throw "woc Prowl state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityProwlRemaining[index];
        if (remaining > 0.0) {
            if (remaining > 0.05) {
                state.entityProwlRemaining[index] = remaining - 0.05;
            } else {
                clearOfflineProwl(state, index);
            }
        }
        index = index + 1;
    }
}

// This call preserves casting-before-GCD-timer ordering inside CastState while
// retaining one WOS-owned candidate row per entity. Commands still own arming.
stepRetainedCasting(state: WorldState, index: int, stunned: bool): void {
    var cast = loadCastingState(state, index);
    cast.stunned = stunned;
    if (cast.castingAbility != <uint>0 &&
        offlineSchoolLockoutIsActive(
            state, index, offlineAbilitySchoolCode(cast.castingAbility)
        )) {
        casting.cancelCast(cast);
        storeCastingState(state, index, cast);
        state.entityCastTargetIds[index] = <uint>0;
        return;
    }
    var completedAbility = cast.castingAbility;
    var successfulStops = cast.successfulStops;
    var channelTicks = cast.channelTicks;
    // The source resolves a target channel's validity when a pulse fires, not
    // when the cast starts. CastState owns only clocks, so keep that target
    // gate here before it consumes the corresponding Drain Life tick.
    var drainTickDue = (completedAbility == drainLifeAbilityCode() ||
        completedAbility == mindFlayAbilityCode() ||
        completedAbility == arcaneMissilesAbilityCode()) && cast.channeling &&
        (cast.channelTickTimer <= 0.05 || cast.castRemaining <= 0.05);
    if (drainTickDue) {
        var channelTargetIndex = -1;
        if (completedAbility == drainLifeAbilityCode()) {
            channelTargetIndex = drainLifeTargetIndex(
                state, index, <uint>state.entityCastTargetIds[index]
            );
        } else if (completedAbility == mindFlayAbilityCode()) {
            channelTargetIndex = mindFlayTargetIndex(
                state, index, <uint>state.entityCastTargetIds[index]
            );
        } else {
            channelTargetIndex = aetherDartsTargetIndex(
                state, index, <uint>state.entityCastTargetIds[index]
            );
        }
        if (channelTargetIndex < 0) {
            casting.cancelCast(cast);
            storeCastingState(state, index, cast);
            state.entityCastTargetIds[index] = <uint>0;
            return;
        }
    }
    casting.advanceFixedTick(cast);
    storeCastingState(state, index, cast);
    if (completedAbility == frostboltAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineFrostboltCast(state, index);
    } else if (completedAbility == smiteAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineSmiteCast(state, index);
    } else if (completedAbility == aimedShotAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineAimedShotCast(state, index);
    } else if (completedAbility == mindBlastAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineMindBlastCast(state, index);
    } else if (completedAbility == shadowBoltAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineShadowBoltCast(state, index);
    } else if (completedAbility == wrathAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineWrathCast(state, index);
    } else if (completedAbility == starfireAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineStarfireCast(state, index);
    } else if (completedAbility == entanglingRootsAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineEntanglingRootsCast(state, index);
    } else if (completedAbility == searingPainAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineSearingPainCast(state, index);
    } else if (completedAbility == immolateAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineImmolateCast(state, index);
    } else if (completedAbility == corruptionAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineCorruptionCast(state, index);
    } else if (completedAbility == lightningBoltAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineLightningBoltCast(state, index);
    } else if (completedAbility == summonImpAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineSummonImpCast(state, index);
    } else if (completedAbility == ghostWolfAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineGhostWolfCast(state, index);
    } else if (completedAbility == drainLifeAbilityCode() &&
        cast.channelTicks > channelTicks) {
        var emittedTicks = cast.channelTicks - channelTicks;
        while (emittedTicks > 0) {
            if (!launchOfflineDrainLifeChannelTick(state, index)) {
                break;
            }
            emittedTicks = emittedTicks - 1;
        }
        if (cast.castingAbility == <uint>0) {
            state.entityCastTargetIds[index] = <uint>0;
        }
    } else if (completedAbility == mindFlayAbilityCode() &&
        cast.channelTicks > channelTicks) {
        var mindFlayTicks = cast.channelTicks - channelTicks;
        while (mindFlayTicks > 0) {
            if (!launchOfflineMindFlayChannelTick(state, index)) {
                break;
            }
            mindFlayTicks = mindFlayTicks - 1;
        }
        if (cast.castingAbility == <uint>0) {
            state.entityCastTargetIds[index] = <uint>0;
        }
    } else if (completedAbility == arcaneMissilesAbilityCode() &&
        cast.channelTicks > channelTicks) {
        var aetherDartsTicks = cast.channelTicks - channelTicks;
        while (aetherDartsTicks > 0) {
            if (!launchOfflineAetherDartsChannelTick(state, index)) { break; }
            aetherDartsTicks = aetherDartsTicks - 1;
        }
        if (cast.castingAbility == <uint>0) {
            state.entityCastTargetIds[index] = <uint>0;
        }
    } else if (completedAbility == rainOfFireAbilityCode() &&
        cast.channelTicks > channelTicks) {
        var rainTicks = cast.channelTicks - channelTicks;
        while (rainTicks > 0) {
            if (!launchOfflineRainOfFireChannelTick(state, index)) {
                break;
            }
            rainTicks = rainTicks - 1;
        }
        if (cast.castingAbility == <uint>0) {
            clearRainOfFireCastAim(state, index);
        }
    } else if (completedAbility == rainOfFireAbilityCode() &&
        cast.castingAbility == <uint>0) {
        clearRainOfFireCastAim(state, index);
    } else if (completedAbility == hurricaneAbilityCode() &&
        cast.channelTicks > channelTicks) {
        var hurricaneTicks = cast.channelTicks - channelTicks;
        while (hurricaneTicks > 0) {
            if (!launchOfflineHurricaneChannelTick(state, index)) { break; }
            hurricaneTicks = hurricaneTicks - 1;
        }
        if (cast.castingAbility == <uint>0) { clearHurricaneCastAim(state, index); }
    } else if (completedAbility == hurricaneAbilityCode() &&
        cast.castingAbility == <uint>0) {
        clearHurricaneCastAim(state, index);
    } else if (completedAbility == fearAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineFearCast(state, index);
    } else if (completedAbility == hibernateAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineHibernateCast(state, index);
    } else if (completedAbility == fireballAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineFireballCast(state, index);
    } else if (completedAbility == pyroblastAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflinePyroblastCast(state, index);
    } else if (completedAbility == flamestrikeAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineFlamestrikeCast(state, index);
    } else if (completedAbility == flamestrikeAbilityCode() &&
        cast.castingAbility == <uint>0) {
        clearFlamestrikeCastAim(state, index);
    } else if (completedAbility == lesserHealAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineLesserHealCast(state, index);
    } else if (completedAbility == healAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineHealCast(state, index);
    } else if (completedAbility == temporalMendAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineTemporalMendCast(state, index);
    } else if (completedAbility == temporalCascadeAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineTemporalCascadeCast(state, index);
    } else if (completedAbility == arcaneSurgeAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineAetherSurgeCast(state, index);
    } else if (completedAbility == healingTouchAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineHealingTouchCast(state, index);
    } else if (completedAbility == regrowthAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineRegrowthCast(state, index);
    } else if (completedAbility == flashHealAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineFlashHealCast(state, index);
    } else if (completedAbility == healingWaveAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineHealingWaveCast(state, index);
    } else if (completedAbility == chainHealAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineChainHealCast(state, index);
    } else if (completedAbility == temporalReversalAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeTemporalReversalCast(state, index);
    } else if (completedAbility == glacialFrontAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineGlacialFrontCast(
            state, index, cast.lastResolvedEmpowerLevel
        );
    } else if (completedAbility == dragonsBreathAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineDragonsBreathCast(
            state, index, cast.lastResolvedEmpowerLevel
        );
    } else if (forms.isFormAbilityCode(completedAbility) &&
        cast.successfulStops > successfulStops) {
        completeFormCast(state, index, completedAbility);
    } else if (cast.castingAbility == <uint>0) {
        state.entityCastTargetIds[index] = <uint>0;
    }
}

// This mirrors the source's post-action per-player combo expiry. The source
// keeps comboUntil after expiry; only the active point pool is cleared.
expireOfflineComboPoints(state: WorldState, index: int): void {
    if (<int>state.entityComboPoints[index] > 0 &&
        <float>state.timeMicros / 1000000.0 >= <float>state.entityComboUntil[index]) {
        state.entityComboPoints[index] = 0;
    }
}

// Source `updateRegen` grants Energy every two seconds before the aura clock
// advances. Feral Instinct is the only currently retained energy modifier, so
// the persisted self timer is sufficient to reconstruct the source multiplier.
stepOfflineFeralInstinctEnergyRegen(state: WorldState, index: int): void {
    if (state.tick % feralChargeState.resourceTickModulo() != <uint>0 ||
        <uint>state.entityResourceKinds[index] != formTransitions.energyResourceKind()) {
        return;
    }
    state.entityResources[index] = feralChargeState.addCappedResource(
        <float>state.entityResources[index],
        <float>state.entityMaxResources[index],
        feralChargeState.energyRegenAmount(
            <float>state.entityFeralInstinctEnergyRemaining[index] > 0.0
        )
    );
}

ageOfflineFeralInstinct(state: WorldState, index: int): void {
    state.entityFeralInstinctEnergyRemaining[index] =
        feralChargeState.remainingAfterFixedTick(
            <float>state.entityFeralInstinctEnergyRemaining[index]
        );
}

// This is the retained source order for each eligible player: movement side
// effects and transition, cast lifecycle, then the active motion-aura clock.
stepRetainedPlayerTicks(state: WorldState): void {
    if (!feralInstinctStateIsValid(state)) {
        throw "woc Feral Instinct state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>1 &&
            (!<bool>state.entityDead[index] || <bool>state.entityGhost[index])) {
            var start = <int><uint>state.entityMotionAuraOffsets[index];
            var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
            var stunned = motionAuras.isStunned(
                state.entityMotionAuraAbilityCodes,
                state.entityMotionAuraSourceIds,
                state.entityMotionAuraKindCodes,
                state.entityMotionAuraRemaining,
                start,
                end,
                true
            ) || temporalHourglassActionSuppressed(state, index);
            var rooted = motionAuras.isRooted(
                state.entityMotionAuraAbilityCodes,
                state.entityMotionAuraSourceIds,
                state.entityMotionAuraKindCodes,
                state.entityMotionAuraRemaining,
                start,
                end,
                true
            );
            if (motionEffects.standUpRequested(
                <bool>state.entityMovementForward[index],
                <bool>state.entityMovementBack[index],
                <bool>state.entityMovementStrafeLeft[index],
                <bool>state.entityMovementStrafeRight[index],
                <bool>state.entityMovementJump[index],
                <bool>state.entitySitting[index],
                true
            )) {
                state.entitySitting[index] = false;
                clearOfflineConsumables(state, index);
            }
            if (!<bool>state.entityDead[index]) {
                var cast = loadCastingState(state, index);
                cast.stunned = stunned;
                var swimming = motionWorld.isSwimmingInBuiltinWorld(
                    <float>state.entityX[index],
                    <float>state.entityZ[index],
                    <float>state.entityY[index],
                    state.worldSeed,
                    true
                );
                var steepGround = motionWorld.isSteepGround(
                    <float>state.entityX[index],
                    <float>state.entityZ[index],
                    <bool>state.entityOnGround[index],
                    swimming,
                    state.worldSeed,
                    true
                );
                var mobileCast = motionAuras.canCastWhileMoving(
                    talentCastMobility(state, index, cast.castingAbility),
                    state.entityMotionAuraAbilityCodes,
                    state.entityMotionAuraSourceIds,
                    state.entityMotionAuraKindCodes,
                    state.entityMotionAuraRemaining,
                    start,
                    end,
                    true
                );
                if (motionEffects.cancelCastRequested(
                    <bool>state.entityMovementForward[index],
                    <bool>state.entityMovementBack[index],
                    <bool>state.entityMovementStrafeLeft[index],
                    <bool>state.entityMovementStrafeRight[index],
                    rooted,
                    steepGround,
                    steepGround,
                    cast.castingAbility != <uint>0,
                    mobileCast,
                    true
                )) {
                    var cancelledAbility = cast.castingAbility;
                    casting.cancelCast(cast);
                    if (cancelledAbility == rainOfFireAbilityCode()) {
                        clearRainOfFireCastAim(state, index);
                    }
                }
                storeCastingState(state, index, cast);
            }
            stepRetainedPlayerMovement(state, index, stunned, rooted);
            if (!<bool>state.entityDead[index]) {
                stepRetainedCasting(state, index, stunned);
            }
            if (!<bool>state.entityDead[index]) {
                stepOfflineFeralInstinctEnergyRegen(state, index);
            }
            ageOfflineFeralInstinct(state, index);
            stepOfflineConsumables(state, index);
            expireOfflineComboPoints(state, index);
            ageMotionAurasForEntity(state, index);
        }
        index = index + 1;
    }
}

prepareOfflineAutoActor(
    state: WorldState,
    playerIndex: int,
    targetIndex: int,
    actor: autoAttackState.AutoActor
): void {
    actor.id = <uint>state.entityIds[playerIndex];
    actor.classId = knownAbilityCatalog.classId(<int>state.offlinePlayerClass);
    actor.level = <int>state.entityLevels[playerIndex];
    actor.hp = <int>state.entityHp[playerIndex];
    actor.dead = <bool>state.entityDead[playerIndex];
    actor.inCombat = <bool>state.entityInCombat[playerIndex];
    actor.combatTimer = <float>state.entityCombatTimers[playerIndex];
    actor.autoAttack = <bool>state.entityAutoAttack[playerIndex];
    actor.casting = <uint>state.entityCastingAbility[playerIndex] != <uint>0;
    actor.stunned = false;
    actor.disarmed = false;
    actor.sitting = <bool>state.entitySitting[playerIndex];
    actor.weaponStowed = <bool>state.entityWeaponStowed[playerIndex];
    actor.ghostWolf = false;
    actor.swingTimer = <float>state.entitySwingTimer[playerIndex];
    var deltaX = <float>state.entityX[targetIndex] - <float>state.entityX[playerIndex];
    var deltaZ = <float>state.entityZ[targetIndex] - <float>state.entityZ[playerIndex];
    actor.targetDistance = math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
    actor.targetFacingDifference = absoluteAngleDifference(
        math.atan2(deltaX, deltaZ), <float>state.entityFacing[playerIndex]
    );
    actor.lineOfSight = true;
    actor.arenaPosition = false;
    actor.resource = <float>state.entityResources[playerIndex];
    actor.maxResource = <float>state.entityMaxResources[playerIndex];
    var queuedAbilityCode = <uint>state.entityQueuedOnSwingAbilityCodes[playerIndex];
    actor.hasQueuedAbility = queuedAbilityCode != <uint>0;
    actor.queuedAbility = actor.hasQueuedAbility ?
        knownAbilityCatalog.abilityId(<int>queuedAbilityCode) : "";
    actor.queuedFree = <bool>state.entityQueuedOnSwingFree[playerIndex];
    actor.queuedCostMultiplier =
        <float>state.entityQueuedOnSwingCostMultipliers[playerIndex];
    var queuedAbilityIndex = queuedOnSwingM4AbilityIndex(queuedAbilityCode);
    var queuedRank = queuedAbilityIndex < 0 ? 0 :
        m4AbilityCatalog.rankAtLevel(queuedAbilityIndex, <int>state.entityLevels[playerIndex]);
    var queuedEffectIndex = offlineTalentPhysicalEffectIndex(
        queuedAbilityIndex, <uint>queuedRank, "weaponDamage"
    );
    actor.queuedTalentBonusResolved = actor.hasQueuedAbility && queuedEffectIndex >= 0;
    actor.queuedTalentBonus = 0.0;
    if (actor.queuedTalentBonusResolved) {
        var effects = %import("generated/m4_ability_effects");
        actor.queuedTalentBonus = <float>resolveOfflineTalentWeaponDamageBonus(
            state,
            <uint>state.entityIds[playerIndex],
            queuedAbilityCode,
            <uint>queuedRank,
            effects.metric(queuedAbilityIndex, queuedRank, queuedEffectIndex, "bonus")
        );
    }
    actor.weaponMinimum = <float>state.entityWeaponMinimum[playerIndex];
    actor.weaponMaximum = <float>state.entityWeaponMaximum[playerIndex];
    actor.weaponSpeed = <float>state.entityWeaponSpeed[playerIndex];
    actor.offhandWeaponMinimum = <float>state.entityOffhandWeaponMinimum[playerIndex];
    actor.offhandWeaponMaximum = <float>state.entityOffhandWeaponMaximum[playerIndex];
    actor.offhandWeaponSpeed = <float>state.entityOffhandWeaponSpeed[playerIndex];
    actor.hasOffhandWeapon = <bool>state.entityHasOffhandWeapon[playerIndex];
    actor.dualWielding = <bool>state.entityDualWielding[playerIndex];
    actor.attackPower = effectiveOfflineAttackPower(state, playerIndex);
    actor.rangedPower = <float>state.entityRangedPower[playerIndex];
    actor.critChance = <float>state.entityCritChance[playerIndex];
    actor.critDamagePhysicalBonus = <float>state.entityCritDamagePhysicalBonus[playerIndex];
    actor.nextAttackCrit = offlineNextAttackCritIsActive(state, playerIndex);
    actor.hitBonus = <float>state.entityHitBonus[playerIndex];
    actor.meleeHaste = <float>state.entityMeleeHaste[playerIndex] +
        groupHasteAttackBonus(state, playerIndex);
    actor.rangedHaste = <float>state.entityRangedHaste[playerIndex] +
        groupHasteAttackBonus(state, playerIndex);
    actor.swingIntervalMultiplier = bladeFlurrySwingIntervalMultiplier(state, playerIndex);
    actor.offhandSwingTimer = <float>state.entityOffhandSwingTimer[playerIndex];
    actor.activeFormAbilityCode = <uint>state.entityActiveFormAbilityCodes[playerIndex];
    actor.imbueBonus = offlineImbueBonus(state, playerIndex);
}

// Source effectiveArmor takes the greater of the active Sunder and Faerie Fire
// percentages. Sunder's generated armor value remains presentation data; the
// retained hostile Eastbrook path uses its fixed two-percent-per-stack rule.
sunderArmorReduction(state: WorldState, targetIndex: int): float {
    var stacks = <int>state.entitySunderArmorStacks[targetIndex];
    return stacks > 0 && <float>state.entitySunderArmorRemaining[targetIndex] > 0.0 ?
        0.02 * <float>stacks : 0.0;
}

faerieFireArmorReduction(state: WorldState, targetIndex: int): float {
    var kind = ccContract.motionAuraKindCode("faerie_fire");
    var abilityCode = faerieFireAbilityCode();
    var aura = <int><uint>state.entityMotionAuraOffsets[targetIndex];
    var end = <int><uint>state.entityMotionAuraOffsets[targetIndex + 1];
    while (aura < end) {
        if (<uint>state.entityMotionAuraKindCodes[aura] == kind &&
            <uint>state.entityMotionAuraAbilityCodes[aura] == abilityCode &&
            <float>state.entityMotionAuraRemaining[aura] > 0.0) {
            return ccContract.faerieFireArmorReduction();
        }
        aura = aura + 1;
    }
    return 0.0;
}

effectiveOfflineArmor(state: WorldState, targetIndex: int): float {
    if (targetIndex < 0 || targetIndex >= state.entityIds.length ||
        !sunderArmorStateIsValid(state) || !faerieFireMotionStateIsValid(state)) {
        throw "woc effective armor target is invalid";
    }
    var armor = <float>state.entityArmor[targetIndex];
    armor = armor + retainedArmorAuraBonus(state, targetIndex);
    var reduction = sunderArmorReduction(state, targetIndex);
    var faerieFireReduction = faerieFireArmorReduction(state, targetIndex);
    if (faerieFireReduction > reduction) { reduction = faerieFireReduction; }
    armor = armor * (1.0 - reduction);
    return armor > 0.0 ? armor : 0.0;
}

effectiveOfflineDodgeChance(state: WorldState, targetIndex: int): float {
    if (targetIndex < 0 || targetIndex >= state.entityIds.length) {
        throw "woc effective dodge target is invalid";
    }
    var dodge = <float>state.entityDodgeChance[targetIndex];
    dodge = dodge + retainedDodgeAuraBonus(state, targetIndex);
    return dodge > 0.0 ? dodge : 0.0;
}

// The source's selfBuff path stores Tiger's Fury as a self-owned `buff_ap`
// aura and folds it into the player's recalculated attack power. WOC keeps
// derived base stats immutable, so the same contribution is projected while
// the source-identical aura row remains active.
retainedAttackPowerAuraBonus(state: WorldState, index: int): float {
    if (index < 0 || index >= state.entityIds.length ||
        !tigersFuryTalentStateIsValid(state)) {
        throw "woc Tiger's Fury talent state is invalid";
    }
    var kind = ccContract.motionAuraKindCode("buff_ap");
    var start = <int><uint>state.entityMotionAuraOffsets[index];
    var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
    var bonus = 0.0;
    while (start < end) {
        if (<uint>state.entityMotionAuraKindCodes[start] == kind &&
            <uint>state.entityMotionAuraSourceIds[start] == <uint>state.entityIds[index] &&
            <float>state.entityMotionAuraRemaining[start] > 0.0) {
            var value = <float>state.entityMotionAuraValues[start];
            if (!retainedAttackPowerAuraProfileIsValid(
                    <uint>state.entityMotionAuraAbilityCodes[start],
                    <float>state.entityMotionAuraRemaining[start], value
                )) {
                throw "woc retained attack-power aura profile is invalid";
            }
            bonus = bonus + value;
        }
        start = start + 1;
    }
    return bonus;
}

// Mirrors Sim.effectiveAttackPower for retained player and hostile rows:
// self-owned `buff_ap` adds before Demoralizing Roar subtracts, then the
// source floor prevents a negative attack-power contribution.
effectiveOfflineAttackPower(state: WorldState, targetIndex: int): float {
    if (targetIndex < 0 || targetIndex >= state.entityIds.length ||
        !demoralizingRoarStateIsValid(state)) {
        throw "woc effective attack power target is invalid";
    }
    var attackPower = <float>state.entityAttackPower[targetIndex] +
        retainedAttackPowerAuraBonus(state, targetIndex);
    if (<float>state.entityDemoralizingRoarRemaining[targetIndex] > 0.0) {
        attackPower = attackPower -
            <float>state.entityDemoralizingRoarValues[targetIndex];
    }
    return attackPower > 0.0 ? attackPower : 0.0;
}

prepareOfflineEastbrookAutoTarget(
    state: WorldState,
    targetIndex: int,
    target: autoAttackState.AutoTarget
): void {
    target.id = <uint>state.entityIds[targetIndex];
    target.kind = "mob";
    target.level = <int>state.entityLevels[targetIndex];
    target.dead = <bool>state.entityDead[targetIndex];
    target.hostileToActor = <bool>state.entityHostile[targetIndex];
    target.hostileMob = <bool>state.entityHostile[targetIndex];
    target.owned = <uint>state.entityOwnerIds[targetIndex] != <uint>0;
    target.evading = false;
    target.idle = <uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState();
    target.hasAggroTarget = <uint>state.entityAggroTargetIds[targetIndex] != <uint>0;
    target.aggroTargetId = <uint>state.entityAggroTargetIds[targetIndex];
    target.inCombat = <bool>state.entityInCombat[targetIndex];
    target.hp = <int>state.entityHp[targetIndex];
    target.armor = effectiveOfflineArmor(state, targetIndex);
    target.dodgeChance = 0.05;
    target.thornsDamage = 0;
    target.spikedHideDamage = 0;
}

commitOfflineAutoActor(
    state: WorldState,
    playerIndex: int,
    actor: autoAttackState.AutoActor
): void {
    state.entitySwingTimer[playerIndex] = actor.swingTimer;
    state.entityOffhandSwingTimer[playerIndex] = actor.offhandSwingTimer;
    state.entityAutoAttack[playerIndex] = actor.autoAttack;
    state.entitySitting[playerIndex] = actor.sitting;
    state.entityWeaponStowed[playerIndex] = actor.weaponStowed;
    state.entityInCombat[playerIndex] = actor.inCombat;
    state.entityCombatTimers[playerIndex] = actor.combatTimer;
    state.entityResources[playerIndex] = <float>actor.resource;
    state.entityHp[playerIndex] = actor.hp > 0 ? actor.hp : 0;
    state.entityQueuedOnSwingAbilityCodes[playerIndex] = actor.hasQueuedAbility ?
        <uint>knownAbilityCatalog.abilityCode(actor.queuedAbility) : <uint>0;
    state.entityQueuedOnSwingFree[playerIndex] = actor.hasQueuedAbility && actor.queuedFree;
    state.entityQueuedOnSwingCostMultipliers[playerIndex] = actor.hasQueuedAbility ?
        actor.queuedCostMultiplier : 1.0;
    if (actor.resolvedQueuedAbility != "") {
        var resolvedCode = <uint>knownAbilityCatalog.abilityCode(actor.resolvedQueuedAbility);
        var resolvedIndex = queuedOnSwingM4AbilityIndex(resolvedCode);
        if (resolvedIndex >= 0 && <float>actor.cooldowns[resolvedIndex] > 0.0) {
            setAbilityCooldownExpiration(
                state,
                playerIndex,
                resolvedCode,
                state.timeMicros + <uint>(<float>actor.cooldowns[resolvedIndex] * 1000000.0)
            );
        }
    }
}

commitOfflineAutoAttackRng(state: WorldState, events: autoAttackState.AutoEvents): void {
    state.rngState = autoAttackState.authoritativeRngState(events, true);
    state.rngDraws = autoAttackState.authoritativeRngDraws(events, true);
    state.rngDigest = autoAttackState.authoritativeRngDigest(events, true);
}

settleOfflineEastbrookLethal(
    state: WorldState,
    targetIndex: int,
    playerIndex: int
): void {
    grantOfflineMobKillExperience(state, targetIndex, playerIndex);
    if (offlineMobTemplateId(state, targetIndex) == "forest_wolf") {
        creditOfflineQuestWolfKill(state, playerIndex);
    }
    rollOfflineEastbrookCorpseLoot(state, targetIndex, playerIndex);
}

// The source has no ranged white-hit profile for these classes. They can share
// the direct melee bridge without turning a wand or Auto Shot into a false melee
// transaction. Hunter's close-range fallback shares its normal melee profile; its
// deferred Auto Shot path owns the 8-35 yard window. Druid is allowed only
// while Bear/Cat owns its ranged form gate. Caster wands and Moonkin stay in
// separate state transactions because this bridge does not retain their tails.
offlineDirectMeleeAutoProfileEnabled(state: WorldState, playerIndex: int): bool {
    if (playerIndex < 0 || playerIndex >= state.entityIds.length) {
        return false;
    }
    var classId = knownAbilityCatalog.classId(<int>state.offlinePlayerClass);
    if (classId == "warrior" || classId == "rogue" || classId == "paladin" ||
        classId == "shaman") {
        return true;
    }
    if (classId == "hunter") {
        var targetIndex = partyEntityIndexById(state, <uint>state.entityTargetIds[playerIndex]);
        if (targetIndex < 0) { return false; }
        var deltaX = <float>state.entityX[targetIndex] - <float>state.entityX[playerIndex];
        var deltaZ = <float>state.entityZ[targetIndex] - <float>state.entityZ[playerIndex];
        return deltaX * deltaX + deltaZ * deltaZ <= 25.0;
    }
    if (classId == "druid" && (
            <uint>state.entityActiveFormAbilityCodes[playerIndex] ==
                forms.formAbilityCode("form_bear") ||
            <uint>state.entityActiveFormAbilityCodes[playerIndex] ==
                forms.formAbilityCode("form_cat"))) {
        return true;
    }
    return false;
}

// The source decrements both weapon timers before Travel Form (and the
// action-locking Fireball travel form) suppresses auto-attack entirely.
stepOfflineTravelFormAutoAttack(state: WorldState): void {
    if (!state.offlineSessionActive) { return; }
    var playerIndex = offlineQuestPrimaryPlayerIndex(state);
    if (playerIndex < 0 || <bool>state.entityDead[playerIndex] ||
        !forms.isTravelFormAbilityCode(
            <uint>state.entityActiveFormAbilityCodes[playerIndex]
        )) {
        return;
    }
    state.entitySwingTimer[playerIndex] =
        <float>state.entitySwingTimer[playerIndex] - projectileTravel.projectileTickSeconds();
    if (<float>state.entitySwingTimer[playerIndex] < 0.0) {
        state.entitySwingTimer[playerIndex] = 0.0;
    }
    state.entityOffhandSwingTimer[playerIndex] =
        <float>state.entityOffhandSwingTimer[playerIndex] - projectileTravel.projectileTickSeconds();
    if (<float>state.entityOffhandSwingTimer[playerIndex] < 0.0) {
        state.entityOffhandSwingTimer[playerIndex] = 0.0;
    }
    state.entityAutoAttack[playerIndex] = false;
}

// This consumes the already-armed source mainhand white-melee path for direct
// offline profiles against retained Eastbrook wolves/boars. The same bridge
// carries the source mainhand/offhand white-swing ordering, but ranged profiles,
// queued swings, set/talent procs and reflect remain separate transactions until
// their state tails are committed end-to-end.
stepOfflineDirectMeleeAutoAttack(state: WorldState): void {
    if (!state.offlineSessionActive) {
        return;
    }
    var playerIndex = offlineQuestPrimaryPlayerIndex(state);
    if (playerIndex < 0 || <bool>state.entityDead[playerIndex] ||
        !<bool>state.entityAutoAttack[playerIndex]) {
        return;
    }
    if (!offlineDirectMeleeAutoProfileEnabled(state, playerIndex)) {
        return;
    }
    var targetIndex = partyEntityIndexById(
        state, <uint>state.entityTargetIds[playerIndex]
    );
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex]) {
        state.entityAutoAttack[playerIndex] = false;
        return;
    }
    var actor = new autoAttackState.AutoActor();
    var playerHpBefore = <int>state.entityHp[playerIndex];
    prepareOfflineAutoActor(state, playerIndex, targetIndex, actor);

    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    // The source applies an innate mob thorns reaction after landed mainhand
    // damage. It still reflects when that blow killed the boar, provided the
    // attacker remains alive, which `spikedHideDamage` preserves in order.
    target.thornsDamage = 0;
    target.spikedHideDamage = 0;
    if (offlineMobTemplateId(state, targetIndex) == "wild_boar") {
        target.spikedHideDamage = 2;
    }

    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(
        events, state.rngState, state.rngDraws, state.rngDigest, true
    );
    autoAttackState.fixedTick(actor, target, events);
    consumeOfflineNextAttackCritAfterAutoHit(state, playerIndex, events);
    // AutoAttack owns the white-swing draws in its local event accumulator.
    // Commit that cursor before death processing so rollLoot consumes the next
    // source value rather than replaying the swing's hit/range/crit sequence.
    state.rngState = autoAttackState.authoritativeRngState(events, true);
    state.rngDraws = autoAttackState.authoritativeRngDraws(events, true);
    state.rngDigest = autoAttackState.authoritativeRngDigest(events, true);
    commitOfflineAutoActor(state, playerIndex, actor);
    var playerReactionDamage = playerHpBefore - actor.hp;
    if (playerReactionDamage < 0) { playerReactionDamage = 0; }
    state.entityHp[playerIndex] = actor.hp > 0 ? actor.hp : 0;
    applyOfflineDeathlessWillDamageTaken(state, playerIndex, playerReactionDamage);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage);
    }
    state.entityInCombat[targetIndex] = target.inCombat;
    // The source settles kill XP, quest credit and loot synchronously before a
    // post-hit reaction can kill the attacker. The retained wolf quest ledger
    // already enforces active-state and eight-kill bounds.
    if (target.hp <= 0) {
        grantOfflineMobKillExperience(state, targetIndex, playerIndex);
        if (offlineMobTemplateId(state, targetIndex) == "forest_wolf") {
            creditOfflineQuestWolfKill(state, playerIndex);
        }
        // handleDeath rolls corpse loot after quest credit and before the
        // attacker's post-hit Bristled Hide reaction can kill the player.
        rollOfflineEastbrookCorpseLoot(state, targetIndex, playerIndex);
    }
    if (actor.dead || actor.hp <= 0) {
        applyOfflineMobMeleePlayerDeath(state, playerIndex);
    } else {
        state.entityHp[playerIndex] = actor.hp;
    }
}

// Source aura expiry runs after that player's auto attack. This keeps a Seal
// active for a swing on its final tick, then clears it before the next command
// boundary just as the source's updateAuras tail does.
ageOfflineImbues(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityImbueAbilityCodes[index] != <uint>0) {
            var remaining = <float>state.entityImbueRemaining[index] -
                projectileTravel.projectileTickSeconds();
            if (remaining <= OFFLINE_PERIODIC_TICK_EPS) {
                clearOfflineImbue(state, index);
            } else {
                state.entityImbueRemaining[index] = remaining;
            }
        }
        index = index + 1;
    }
}

offlineHunterAutoShotProfileEnabled(state: WorldState, playerIndex: int): bool {
    return playerIndex >= 0 && playerIndex < state.entityIds.length &&
        knownAbilityCatalog.classId(<int>state.offlinePlayerClass) == "hunter";
}

configureOfflineHunterAutoShot(actor: autoAttackState.AutoActor): void {
    actor.hasRangedProfile = true;
    actor.rangedWand = false;
    actor.rangedUsesWeapon = false;
    actor.rangedMinimumRange = 8.0;
    actor.rangedMaximumRange = 35.0;
    actor.rangedMinimum = 5.0;
    actor.rangedMaximum = 9.0;
    actor.rangedSpeed = 2.3;
    actor.rangedSchool = "physical";
}

offlineWandSchoolForPlayer(state: WorldState, playerIndex: int): string {
    if (playerIndex < 0 || playerIndex >= state.entityIds.length) {
        return "";
    }
    var classId = knownAbilityCatalog.classId(<int>state.offlinePlayerClass);
    if (classId == "mage") { return "arcane"; }
    if (classId == "priest") { return "holy"; }
    if (classId == "warlock") { return "shadow"; }
    if (classId != "druid") { return ""; }
    var form = <uint>state.entityActiveFormAbilityCodes[playerIndex];
    if (form == forms.formAbilityCode("form_bear") ||
        form == forms.formAbilityCode("form_cat") ||
        form == forms.formAbilityCode("form_travel")) {
        return "";
    }
    return "nature";
}

offlineCasterWandProfileEnabled(state: WorldState, playerIndex: int): bool {
    return offlineWandSchoolForPlayer(state, playerIndex) != "";
}

configureOfflineCasterWand(actor: autoAttackState.AutoActor, school: string): void {
    actor.hasRangedProfile = true;
    actor.rangedWand = true;
    actor.rangedUsesWeapon = false;
    actor.rangedMinimumRange = 0.0;
    actor.rangedMaximumRange = 30.0;
    actor.rangedMinimum = 3.0;
    actor.rangedMaximum = 6.0;
    actor.rangedSpeed = 1.8;
    actor.rangedSchool = school;
}

offlineProjectileSchoolCode(school: string): uint {
    if (school == "arcane") { return OFFLINE_PROJECTILE_SCHOOL_ARCANE; }
    if (school == "holy") { return OFFLINE_PROJECTILE_SCHOOL_HOLY; }
    if (school == "shadow") { return OFFLINE_PROJECTILE_SCHOOL_SHADOW; }
    if (school == "nature") { return OFFLINE_PROJECTILE_SCHOOL_NATURE; }
    return OFFLINE_PROJECTILE_SCHOOL_PHYSICAL;
}

offlineProjectileSchoolName(code: uint): string {
    if (code == OFFLINE_PROJECTILE_SCHOOL_ARCANE) { return "arcane"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_HOLY) { return "holy"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_SHADOW) { return "shadow"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_NATURE) { return "nature"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_FROST) { return "frost"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_FIRE) { return "fire"; }
    return "physical";
}

appendOfflineProjectile(
    state: WorldState,
    sourceId: uint,
    targetId: uint,
    sourceX: float,
    sourceZ: float,
    minimum: float,
    maximum: float,
    speed: float,
    wand: bool,
    school: uint
): void {
    appendOfflineAbilityProjectile(
        state, sourceId, targetId, sourceX, sourceZ, minimum, maximum, speed,
        wand, school, <uint>0, <uint>0, 0.0
    );
}

offlineProjectileBaseDotTotal(abilityCode: uint, rank: uint): float {
    var effects = %import("generated/m4_ability_effects");
    if (abilityCode == fireballAbilityCode()) {
        var fireballIndex = m4AbilityCatalog.indexOf("fireball");
        return fireballIndex >= 0 && rank > <uint>0 &&
            effects.typeAt(fireballIndex, <int>rank, 1) == "dot" ?
            effects.metric(fireballIndex, <int>rank, 1, "total") : 0.0;
    }
    if (abilityCode == pyroblastAbilityCode()) {
        var pyroblastIndex = m4AbilityCatalog.indexOf("pyroblast");
        return pyroblastIndex >= 0 && rank == <uint>1 &&
            effects.typeAt(pyroblastIndex, 1, 1) == "dot" ?
            effects.metric(pyroblastIndex, 1, 1, "total") : 0.0;
    }
    return 0.0;
}

// Source applies a resolved direct range when the ability is built. The
// projectile retains that result even if its caster later changes talents.
offlineTalentDirectDamageEffectIndex(abilityIndex: int, rank: uint): int {
    var effects = %import("generated/m4_ability_effects");
    if (abilityIndex < 0 || rank == <uint>0 ||
        rank > <uint>m4AbilityCatalog.rankCount(abilityIndex)) {
        return -1;
    }
    var effectType = effects.typeAt(abilityIndex, <int>rank, 0);
    if (effectType == "directDamage") { return 0; }
    return (effectType == "consumeAura" &&
        m4AbilityCatalog.text(abilityIndex, "targetType") != "friendly") ? 0 : -1;
}

offlineTalentDotEffectIndex(abilityIndex: int, rank: uint): int {
    var effects = %import("generated/m4_ability_effects");
    if (abilityIndex < 0 || rank == <uint>0 ||
        rank > <uint>m4AbilityCatalog.rankCount(abilityIndex)) {
        return -1;
    }
    var effectIndex = 0;
    while (effectIndex < effects.count(abilityIndex, <int>rank)) {
        if (effects.typeAt(abilityIndex, <int>rank, effectIndex) == "dot") {
            return effectIndex;
        }
        effectIndex = effectIndex + 1;
    }
    return -1;
}

offlineTalentDrainTickEffectIndex(abilityIndex: int, rank: uint): int {
    var effects = %import("generated/m4_ability_effects");
    if (abilityIndex < 0 || rank == <uint>0 ||
        rank > <uint>m4AbilityCatalog.rankCount(abilityIndex)) {
        return -1;
    }
    var effectIndex = 0;
    while (effectIndex < effects.count(abilityIndex, <int>rank)) {
        if (effects.typeAt(abilityIndex, <int>rank, effectIndex) == "drainTick") {
            return effectIndex;
        }
        effectIndex = effectIndex + 1;
    }
    return -1;
}

offlineTalentPhysicalEffectIndex(
    abilityIndex: int, rank: uint, effectType: string
): int {
    var effects = %import("generated/m4_ability_effects");
    if (abilityIndex < 0 || rank == <uint>0 ||
        rank > <uint>m4AbilityCatalog.rankCount(abilityIndex)) {
        return -1;
    }
    var effectIndex = 0;
    while (effectIndex < effects.count(abilityIndex, <int>rank)) {
        if (effects.typeAt(abilityIndex, <int>rank, effectIndex) == effectType) {
            return effectIndex;
        }
        effectIndex = effectIndex + 1;
    }
    return -1;
}

offlineTalentProjectileSnapshotIsEligible(abilityIndex: int, rank: uint): bool {
    return offlineTalentDirectDamageEffectIndex(abilityIndex, rank) >= 0 ||
        offlineTalentDotEffectIndex(abilityIndex, rank) >= 0 ||
        offlineTalentDrainTickEffectIndex(abilityIndex, rank) >= 0;
}

resolveOfflineTalentDirectDamageRange(
    state: WorldState,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    minimum: float,
    maximum: float
): directDamageTalentScaling.DirectDamageRange {
    var range = new directDamageTalentScaling.DirectDamageRange();
    range.minimum = <int>(minimum + 0.5);
    range.maximum = <int>(maximum + 0.5);
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return range;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    if (offlineTalentDirectDamageEffectIndex(abilityIndex, rank) < 0) { return range; }
    var sourceIndex = partyEntityIndexById(state, sourceId);
    if (sourceIndex < 0) { return range; }
    return directDamageTalentScaling.resolveDirectDamageRange(
        range.minimum,
        range.maximum,
        m4AbilityCatalog.text(abilityIndex, "school"),
        offlineTalentModifiersForEntity(state, sourceIndex),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

resolveOfflineTalentAoEDamageRange(
    state: WorldState,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    effectIndex: int,
    minimum: float,
    maximum: float
): aoeTalentScaling.AoERange {
    var range = new aoeTalentScaling.AoERange();
    range.minimum = <int>(minimum + 0.5);
    range.maximum = <int>(maximum + 0.5);
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return range;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var effects = %import("generated/m4_ability_effects");
    if (abilityIndex < 0 || rank == <uint>0 ||
        rank > <uint>m4AbilityCatalog.rankCount(abilityIndex) || effectIndex < 0 ||
        effectIndex >= effects.count(abilityIndex, <int>rank) ||
        effects.typeAt(abilityIndex, <int>rank, effectIndex) != "aoeDamage") {
        return range;
    }
    var sourceIndex = partyEntityIndexById(state, sourceId);
    if (sourceIndex < 0) { return range; }
    return aoeTalentScaling.resolveAoEDamageRange(
        range.minimum,
        range.maximum,
        m4AbilityCatalog.text(abilityIndex, "school"),
        offlineTalentModifiersForEntity(state, sourceIndex),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

resolveOfflineTalentDrainTickRange(
    state: WorldState,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    minimum: float,
    maximum: float
): drainTickTalentScaling.DrainTickRange {
    var range = new drainTickTalentScaling.DrainTickRange();
    range.minimum = <int>(minimum + 0.5);
    range.maximum = <int>(maximum + 0.5);
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return range;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    if (offlineTalentDrainTickEffectIndex(abilityIndex, rank) < 0) { return range; }
    var sourceIndex = partyEntityIndexById(state, sourceId);
    if (sourceIndex < 0) { return range; }
    return drainTickTalentScaling.resolveDrainTickRange(
        range.minimum,
        range.maximum,
        m4AbilityCatalog.text(abilityIndex, "school"),
        offlineTalentModifiersForEntity(state, sourceIndex),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

resolveOfflineTalentWeaponDamageBonus(
    state: WorldState,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    baseBonus: float
): int {
    var bonus = <int>(baseBonus + 0.5);
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return bonus;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    if (offlineTalentPhysicalEffectIndex(abilityIndex, rank, "weaponDamage") < 0) {
        return bonus;
    }
    var sourceIndex = partyEntityIndexById(state, sourceId);
    return sourceIndex < 0 ? bonus : physicalTalentScaling.resolveWeaponDamageBonus(
        bonus,
        offlineTalentModifiersForEntity(state, sourceIndex),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

resolveOfflineTalentWeaponStrike(
    state: WorldState,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    baseBonus: float,
    authoredWeaponMultiplier: float
): physicalTalentScaling.WeaponStrikeValues {
    var resolved = new physicalTalentScaling.WeaponStrikeValues();
    resolved.bonus = <int>(baseBonus + 0.5);
    resolved.weaponMultiplier = authoredWeaponMultiplier;
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return resolved;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    if (offlineTalentPhysicalEffectIndex(abilityIndex, rank, "weaponStrike") < 0) {
        return resolved;
    }
    var sourceIndex = partyEntityIndexById(state, sourceId);
    return sourceIndex < 0 ? resolved : physicalTalentScaling.resolveWeaponStrike(
        resolved.bonus,
        authoredWeaponMultiplier,
        offlineTalentModifiersForEntity(state, sourceIndex),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

resolveOfflineTalentFinisher(
    state: WorldState,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    base: float,
    perCombo: float
): physicalTalentScaling.FinisherValues {
    var resolved = new physicalTalentScaling.FinisherValues();
    resolved.base = <int>(base + 0.5);
    resolved.perCombo = <int>(perCombo + 0.5);
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return resolved;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    if (offlineTalentPhysicalEffectIndex(abilityIndex, rank, "finisherDamage") < 0) {
        return resolved;
    }
    var sourceIndex = partyEntityIndexById(state, sourceId);
    return sourceIndex < 0 ? resolved : physicalTalentScaling.resolveFinisher(
        resolved.base,
        resolved.perCombo,
        offlineTalentModifiersForEntity(state, sourceIndex),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

offlineTalentImbueEffectIndex(abilityIndex: int, rank: uint): int {
    var effects = %import("generated/m4_ability_effects");
    if (abilityIndex < 0 || rank == <uint>0 ||
        rank > <uint>m4AbilityCatalog.rankCount(abilityIndex)) {
        return -1;
    }
    return effects.typeAt(abilityIndex, <int>rank, 0) == "imbue" ? 0 : -1;
}

offlineRawImbueValues(abilityCode: uint, rank: uint): imbueTalentScaling.ImbueValues {
    var values = new imbueTalentScaling.ImbueValues();
    var abilityIndex = -1;
    var hasJudgement = false;
    if (abilityCode == sealOfRighteousnessAbilityCode() &&
        sealOfRighteousnessProfileIsValid(rank)) {
        abilityIndex = m4AbilityCatalog.indexOf("seal_of_righteousness");
        hasJudgement = true;
    } else if (abilityCode == flametongueWeaponAbilityCode() &&
        flametongueWeaponProfileIsValid(rank)) {
        abilityIndex = m4AbilityCatalog.indexOf("flametongue_weapon");
    } else if (abilityCode == frostbrandWeaponAbilityCode() &&
        frostbrandWeaponProfileIsValid(rank)) {
        abilityIndex = m4AbilityCatalog.indexOf("frostbrand_weapon");
    }
    var effectIndex = offlineTalentImbueEffectIndex(abilityIndex, rank);
    if (effectIndex < 0) { return values; }
    var effects = %import("generated/m4_ability_effects");
    values.bonus = <int>(effects.metric(abilityIndex, <int>rank, effectIndex, "bonus") + 0.5);
    if (hasJudgement) {
        values.judgementMinimum = <int>(
            effects.metric(abilityIndex, <int>rank, effectIndex, "judgeMin") + 0.5
        );
        values.judgementMaximum = <int>(
            effects.metric(abilityIndex, <int>rank, effectIndex, "judgeMax") + 0.5
        );
    }
    return values;
}

offlineImbueTalentSnapshotRowCodeAt(
    state: WorldState, entityIndex: int, rowIndex: int
): uint {
    return <uint>state.entityImbueTalentRowOptionCodes[entityIndex * 6 + rowIndex];
}

offlineImbueTalentSnapshotIsEmpty(state: WorldState, entityIndex: int): bool {
    if (<uint>state.entityImbueTalentSpecCodes[entityIndex] != <uint>0) { return false; }
    var row = 0;
    while (row < 6) {
        if (offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, row) != <uint>0) {
            return false;
        }
        row = row + 1;
    }
    return true;
}

offlineImbueTalentSnapshotIsValid(state: WorldState, entityIndex: int): bool {
    if (offlineImbueTalentSnapshotIsEmpty(state, entityIndex)) { return true; }
    return offlineTalentAllocationValuesAreValid(
        state,
        entityIndex,
        <uint>state.entityImbueTalentSpecCodes[entityIndex],
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 0),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 1),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 2),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 3),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 4),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 5)
    );
}

offlineTalentImbueSnapshotModifiers(
    state: WorldState, entityIndex: int
): talentModifiers.TalentModifierState {
    var snapshot = new talentModifiers.TalentModifierState();
    snapshot.playerLevel = <int>state.entityLevels[entityIndex];
    talentModifiers.recompute(
        snapshot,
        <uint>state.entityImbueTalentSpecCodes[entityIndex],
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 0),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 1),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 2),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 3),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 4),
        offlineImbueTalentSnapshotRowCodeAt(state, entityIndex, 5)
    );
    return snapshot;
}

resolveOfflineTalentImbueValues(
    state: WorldState,
    entityIndex: int,
    talentState: talentModifiers.TalentModifierState
): imbueTalentScaling.ImbueValues {
    var abilityCode = <uint>state.entityImbueAbilityCodes[entityIndex];
    var rank = <uint>state.entityImbueRanks[entityIndex];
    var raw = offlineRawImbueValues(abilityCode, rank);
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return raw;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    if (offlineTalentImbueEffectIndex(abilityIndex, rank) < 0) { return raw; }
    return imbueTalentScaling.resolveImbue(
        raw.bonus,
        raw.judgementMinimum,
        raw.judgementMaximum,
        abilityCode == sealOfRighteousnessAbilityCode(),
        m4AbilityCatalog.text(abilityIndex, "school"),
        talentState,
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

offlineTalentImbueResolvedValues(
    state: WorldState, entityIndex: int
): imbueTalentScaling.ImbueValues {
    var raw = offlineRawImbueValues(
        <uint>state.entityImbueAbilityCodes[entityIndex],
        <uint>state.entityImbueRanks[entityIndex]
    );
    if (offlineImbueTalentSnapshotIsEmpty(state, entityIndex)) { return raw; }
    return offlineImbueTalentSnapshotIsValid(state, entityIndex) ?
        resolveOfflineTalentImbueValues(
            state, entityIndex, offlineTalentImbueSnapshotModifiers(state, entityIndex)
        ) : raw;
}

captureOfflineTalentImbueState(state: WorldState, entityIndex: int): void {
    var resolved = resolveOfflineTalentImbueValues(
        state, entityIndex, offlineTalentModifiersForEntity(state, entityIndex)
    );
    state.entityImbueResolvedBonuses[entityIndex] = resolved.bonus;
    state.entityImbueResolvedJudgementMinimums[entityIndex] = resolved.judgementMinimum;
    state.entityImbueResolvedJudgementMaximums[entityIndex] = resolved.judgementMaximum;
    var capture = offlineTalentAllocationIsValid(state, entityIndex);
    state.entityImbueTalentSpecCodes[entityIndex] =
        capture ? <uint>state.entityTalentSpecCodes[entityIndex] : <uint>0;
    var row = 0;
    while (row < 6) {
        state.entityImbueTalentRowOptionCodes[entityIndex * 6 + row] =
            capture ? talentRowCodeAt(state, entityIndex, row) : <uint>0;
        row = row + 1;
    }
}

normalizeOfflineLegacyImbueTalentRows(state: WorldState): void {
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var raw = offlineRawImbueValues(
            <uint>state.entityImbueAbilityCodes[entityIndex],
            <uint>state.entityImbueRanks[entityIndex]
        );
        state.entityImbueResolvedBonuses[entityIndex] = raw.bonus;
        state.entityImbueResolvedJudgementMinimums[entityIndex] = raw.judgementMinimum;
        state.entityImbueResolvedJudgementMaximums[entityIndex] = raw.judgementMaximum;
        state.entityImbueTalentSpecCodes[entityIndex] = <uint>0;
        var row = 0;
        while (row < 6) {
            state.entityImbueTalentRowOptionCodes[entityIndex * 6 + row] = <uint>0;
            row = row + 1;
        }
        entityIndex = entityIndex + 1;
    }
}

imbueStateIsSchema108Compatible(state: WorldState): bool {
    if (!imbueStateIsValid(state)) { return false; }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        if (!offlineImbueTalentSnapshotIsEmpty(state, entityIndex)) { return false; }
        entityIndex = entityIndex + 1;
    }
    return true;
}

offlineTigersFuryTalentSnapshotRowCodeAt(
    state: WorldState, entityIndex: int, rowIndex: int
): uint {
    return <uint>state.entityTigersFuryTalentRowOptionCodes[entityIndex * 6 + rowIndex];
}

offlineTigersFuryTalentSnapshotIsEmpty(state: WorldState, entityIndex: int): bool {
    if (<uint>state.entityTigersFuryTalentSpecCodes[entityIndex] != <uint>0) {
        return false;
    }
    var row = 0;
    while (row < 6) {
        if (offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, row) != <uint>0) {
            return false;
        }
        row = row + 1;
    }
    return true;
}

offlineTigersFuryTalentSnapshotIsValid(state: WorldState, entityIndex: int): bool {
    if (offlineTigersFuryTalentSnapshotIsEmpty(state, entityIndex)) { return true; }
    return offlineTalentAllocationValuesAreValid(
        state,
        entityIndex,
        <uint>state.entityTigersFuryTalentSpecCodes[entityIndex],
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 0),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 1),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 2),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 3),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 4),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 5)
    );
}

offlineTigersFuryTalentSnapshotModifiers(
    state: WorldState, entityIndex: int
): talentModifiers.TalentModifierState {
    var snapshot = new talentModifiers.TalentModifierState();
    snapshot.playerLevel = <int>state.entityLevels[entityIndex];
    talentModifiers.recompute(
        snapshot,
        <uint>state.entityTigersFuryTalentSpecCodes[entityIndex],
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 0),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 1),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 2),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 3),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 4),
        offlineTigersFuryTalentSnapshotRowCodeAt(state, entityIndex, 5)
    );
    return snapshot;
}

tigersFuryRawAttackPower(): int {
    var abilityIndex = m4AbilityCatalog.indexOf("tigers_fury");
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 ? <int>effects.metric(abilityIndex, 1, 0, "value") : 0;
}

resolveOfflineTigersFuryAttackPower(
    talentState: talentModifiers.TalentModifierState
): int {
    var abilityIndex = m4AbilityCatalog.indexOf("tigers_fury");
    var raw = tigersFuryRawAttackPower();
    if (abilityIndex < 0 || raw <= 0) { return raw; }
    return flatBuffTalentScaling.resolveFlatBuffValue(
        raw,
        talentState,
        m4AbilityCatalog.text(abilityIndex, "school"),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
}

captureOfflineTigersFuryTalentState(state: WorldState, entityIndex: int): int {
    var talentState = new talentModifiers.TalentModifierState();
    var capture = offlineTalentAllocationIsValid(state, entityIndex);
    if (capture) {
        talentState = offlineTalentModifiersForEntity(state, entityIndex);
    }
    var resolved = resolveOfflineTigersFuryAttackPower(talentState);
    state.entityTigersFuryResolvedAttackPower[entityIndex] = resolved;
    state.entityTigersFuryTalentSpecCodes[entityIndex] =
        capture ? <uint>state.entityTalentSpecCodes[entityIndex] : <uint>0;
    var row = 0;
    while (row < 6) {
        state.entityTigersFuryTalentRowOptionCodes[entityIndex * 6 + row] =
            capture ? talentRowCodeAt(state, entityIndex, row) : <uint>0;
        row = row + 1;
    }
    return resolved;
}

clearOfflineTigersFuryTalentState(state: WorldState, entityIndex: int): void {
    state.entityTigersFuryResolvedAttackPower[entityIndex] = 0;
    state.entityTigersFuryTalentSpecCodes[entityIndex] = <uint>0;
    var row = 0;
    while (row < 6) {
        state.entityTigersFuryTalentRowOptionCodes[entityIndex * 6 + row] = <uint>0;
        row = row + 1;
    }
}

normalizeOfflineLegacyTigersFuryTalentRows(state: WorldState): void {
    var kind = ccContract.motionAuraKindCode("buff_ap");
    var abilityCode = tigersFuryAbilityCode();
    var raw = tigersFuryRawAttackPower();
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var auraIndex = <int><uint>state.entityMotionAuraOffsets[entityIndex];
        var auraEnd = <int><uint>state.entityMotionAuraOffsets[entityIndex + 1];
        var active = false;
        while (auraIndex < auraEnd) {
            if (<uint>state.entityMotionAuraKindCodes[auraIndex] == kind &&
                <uint>state.entityMotionAuraAbilityCodes[auraIndex] == abilityCode) {
                state.entityMotionAuraValues[auraIndex] = <float>raw;
                active = true;
            }
            auraIndex = auraIndex + 1;
        }
        state.entityTigersFuryResolvedAttackPower[entityIndex] = active ? raw : 0;
        state.entityTigersFuryTalentSpecCodes[entityIndex] = <uint>0;
        var row = 0;
        while (row < 6) {
            state.entityTigersFuryTalentRowOptionCodes[entityIndex * 6 + row] = <uint>0;
            row = row + 1;
        }
        entityIndex = entityIndex + 1;
    }
}

tigersFuryTalentStateIsValid(state: WorldState): bool {
    if (state.entityTigersFuryResolvedAttackPower.length != state.entityIds.length ||
        state.entityTigersFuryTalentSpecCodes.length != state.entityIds.length ||
        state.entityTigersFuryTalentRowOptionCodes.length != state.entityIds.length * 6 ||
        !retainedAttackPowerMotionStateIsValid(state)) {
        return false;
    }
    var kind = ccContract.motionAuraKindCode("buff_ap");
    var abilityCode = tigersFuryAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("tigers_fury");
    var raw = tigersFuryRawAttackPower();
    if (kind == <uint>0 || abilityCode == <uint>0 || abilityIndex < 0 || raw <= 0) {
        return false;
    }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var auraIndex = <int><uint>state.entityMotionAuraOffsets[entityIndex];
        var auraEnd = <int><uint>state.entityMotionAuraOffsets[entityIndex + 1];
        var active = false;
        while (auraIndex < auraEnd) {
            if (<uint>state.entityMotionAuraKindCodes[auraIndex] == kind &&
                <uint>state.entityMotionAuraAbilityCodes[auraIndex] == abilityCode) {
                if (active || entityIndex != offlineQuestPrimaryPlayerIndex(state) ||
                    <uint>state.entityKinds[entityIndex] != <uint>1 ||
                    <uint>state.entityIds[entityIndex] !=
                        <uint>state.entityMotionAuraSourceIds[auraIndex] ||
                    !tigersFuryProfileIsValid(abilityIndex, <int>state.entityLevels[entityIndex])) {
                    return false;
                }
                active = true;
                var snapshotIsEmpty = offlineTigersFuryTalentSnapshotIsEmpty(state, entityIndex);
                if (!offlineTigersFuryTalentSnapshotIsValid(state, entityIndex)) { return false; }
                var expected = snapshotIsEmpty ? raw : resolveOfflineTigersFuryAttackPower(
                    offlineTigersFuryTalentSnapshotModifiers(state, entityIndex)
                );
                if (<int>state.entityTigersFuryResolvedAttackPower[entityIndex] != expected ||
                    <float>state.entityMotionAuraValues[auraIndex] != <float>expected) {
                    return false;
                }
            }
            auraIndex = auraIndex + 1;
        }
        if (!active &&
            (<int>state.entityTigersFuryResolvedAttackPower[entityIndex] != 0 ||
                !offlineTigersFuryTalentSnapshotIsEmpty(state, entityIndex))) {
            return false;
        }
        entityIndex = entityIndex + 1;
    }
    return true;
}

tigersFuryTalentStateIsSchema110Compatible(state: WorldState): bool {
    if (!tigersFuryTalentStateIsValid(state)) { return false; }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        if (!offlineTigersFuryTalentSnapshotIsEmpty(state, entityIndex)) { return false; }
        entityIndex = entityIndex + 1;
    }
    return true;
}

feralInstinctStateIsValid(state: WorldState): bool {
    if (state.entityFeralInstinctEnergyRemaining.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityFeralInstinctEnergyRemaining[index];
        if (remaining < 0.0 || remaining > feralChargeState.feralInstinctDuration()) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

feralInstinctStateIsSchema111Compatible(state: WorldState): bool {
    if (!feralInstinctStateIsValid(state)) { return false; }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<float>state.entityFeralInstinctEnergyRemaining[index] != 0.0) { return false; }
        index = index + 1;
    }
    return true;
}

resourcePrecisionStateIsValid(state: WorldState): bool {
    if (state.entityResources.length != state.entityIds.length ||
        state.entityMaxResources.length != state.entityIds.length ||
        state.entitySavedMana.length != state.entityIds.length ||
        state.entitySavedManaMaximums.length != state.entityIds.length) {
        return false;
    }
    var precision = %import("combat/resource_precision_state");
    var index = 0;
    while (index < state.entityIds.length) {
        if (!precision.isValid(
                <float>state.entityResources[index],
                <float>state.entityMaxResources[index]
            ) || !precision.isValid(
                <float>state.entitySavedMana[index],
                <float>state.entitySavedManaMaximums[index]
            )) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

resourcePrecisionStateIsSchema112Compatible(state: WorldState): bool {
    if (!resourcePrecisionStateIsValid(state)) { return false; }
    var precision = %import("combat/resource_precision_state");
    var index = 0;
    while (index < state.entityIds.length) {
        if (!precision.isIntegral(<float>state.entityResources[index]) ||
            !precision.isIntegral(<float>state.entityMaxResources[index]) ||
            !precision.isIntegral(<float>state.entitySavedMana[index]) ||
            !precision.isIntegral(<float>state.entitySavedManaMaximums[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

resourcePrecisionStateCanEncodeVersion(state: WorldState, schemaVersion: uint): bool {
    return schemaVersion >= <uint>113 || resourcePrecisionStateIsSchema112Compatible(state);
}

offlineProjectileTalentSnapshotIsEmpty(state: WorldState, index: int): bool {
    if (<uint>state.offlineProjectileTalentSpecCodes[index] != <uint>0) { return false; }
    var row = 0;
    while (row < 6) {
        if (<uint>state.offlineProjectileTalentRowOptionCodes[index * 6 + row] != <uint>0) {
            return false;
        }
        row = row + 1;
    }
    return true;
}

offlineProjectileTalentSnapshotsAreLegacyCompatible(state: WorldState): bool {
    var index = 0;
    while (index < state.offlineProjectileSourceIds.length) {
        if (!offlineProjectileTalentSnapshotIsEmpty(state, index)) { return false; }
        index = index + 1;
    }
    return true;
}

offlineProjectileTalentSnapshotRowCodeAt(
    state: WorldState, projectileIndex: int, rowIndex: int
): uint {
    return <uint>state.offlineProjectileTalentRowOptionCodes[projectileIndex * 6 + rowIndex];
}

offlineProjectileTalentSnapshotIsValid(state: WorldState, index: int): bool {
    if (offlineProjectileTalentSnapshotIsEmpty(state, index)) { return true; }
    var sourceIndex = partyEntityIndexById(
        state, <uint>state.offlineProjectileSourceIds[index]
    );
    return sourceIndex >= 0 && offlineTalentAllocationValuesAreValid(
        state,
        sourceIndex,
        <uint>state.offlineProjectileTalentSpecCodes[index],
        offlineProjectileTalentSnapshotRowCodeAt(state, index, 0),
        offlineProjectileTalentSnapshotRowCodeAt(state, index, 1),
        offlineProjectileTalentSnapshotRowCodeAt(state, index, 2),
        offlineProjectileTalentSnapshotRowCodeAt(state, index, 3),
        offlineProjectileTalentSnapshotRowCodeAt(state, index, 4),
        offlineProjectileTalentSnapshotRowCodeAt(state, index, 5)
    );
}

appendOfflineProjectileTalentSnapshot(
    state: WorldState, sourceId: uint, abilityCode: uint, rank: uint
): void {
    var abilityIndex = (abilityCode == <uint>0 ||
        !knownAbilityCatalog.abilityExists(<int>abilityCode)) ? -1 :
        m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var sourceIndex = partyEntityIndexById(state, sourceId);
    var capture = offlineTalentProjectileSnapshotIsEligible(abilityIndex, rank) &&
        sourceIndex >= 0 && offlineTalentAllocationIsValid(state, sourceIndex);
    state.offlineProjectileTalentSpecCodes.add(
        capture ? <uint>state.entityTalentSpecCodes[sourceIndex] : <uint>0
    );
    var row = 0;
    while (row < 6) {
        state.offlineProjectileTalentRowOptionCodes.add(
            capture ? talentRowCodeAt(state, sourceIndex, row) : <uint>0
        );
        row = row + 1;
    }
}

offlineTalentDirectDamageSnapshotModifiers(
    state: WorldState, projectileIndex: int, sourceIndex: int
): talentModifiers.TalentModifierState {
    var snapshot = new talentModifiers.TalentModifierState();
    snapshot.playerLevel = <int>state.entityLevels[sourceIndex];
    talentModifiers.recompute(
        snapshot,
        <uint>state.offlineProjectileTalentSpecCodes[projectileIndex],
        offlineProjectileTalentSnapshotRowCodeAt(state, projectileIndex, 0),
        offlineProjectileTalentSnapshotRowCodeAt(state, projectileIndex, 1),
        offlineProjectileTalentSnapshotRowCodeAt(state, projectileIndex, 2),
        offlineProjectileTalentSnapshotRowCodeAt(state, projectileIndex, 3),
        offlineProjectileTalentSnapshotRowCodeAt(state, projectileIndex, 4),
        offlineProjectileTalentSnapshotRowCodeAt(state, projectileIndex, 5)
    );
    return snapshot;
}

offlineDotTalentSnapshotIsEmpty(state: WorldState, index: int): bool {
    if (<uint>state.offlineDotTalentSpecCodes[index] != <uint>0) { return false; }
    var row = 0;
    while (row < 6) {
        if (<uint>state.offlineDotTalentRowOptionCodes[index * 6 + row] != <uint>0) {
            return false;
        }
        row = row + 1;
    }
    return true;
}

offlineDotTalentSnapshotsAreLegacyCompatible(state: WorldState): bool {
    var count = state.offlineDotTargetIds.length;
    if (state.offlineDotResolvedTotals.length != count ||
        state.offlineDotTalentSpecCodes.length != count ||
        state.offlineDotTalentRowOptionCodes.length != count * 6) {
        return false;
    }
    var index = 0;
    while (index < count) {
        if (!offlineDotTalentSnapshotIsEmpty(state, index)) { return false; }
        index = index + 1;
    }
    return true;
}

// WOS107 has rank and power facts but cannot retain a resolved total or a
// talent selection. Empty selections are therefore insufficient: a transformed
// Fireball/Pyroblast total must not silently normalize into a different row.
offlineDotStateIsSchema107Compatible(state: WorldState): bool {
    if (!offlineDotTalentSnapshotsAreLegacyCompatible(state)) { return false; }
    var index = 0;
    while (index < state.offlineDotTargetIds.length) {
        var abilityCode = <uint>state.offlineDotAbilityCodes[index];
        var rank = <uint>state.offlineDotRanks[index];
        var total = <int>state.offlineDotResolvedTotals[index];
        var duration = <float>state.offlineDotDurations[index];
        var interval = <float>state.offlineDotTickIntervals[index];
        if (abilityCode == ignitionAbilityCode() || rank == <uint>0) {
            if (total != <int>state.offlineDotDamages[index] *
                <int>(duration / interval + 0.5)) {
                return false;
            }
        } else if (offlineLegacyDotCanRecoverGeneratedTotal(abilityCode)) {
            var abilityIndex = (abilityCode == <uint>0 ||
                !knownAbilityCatalog.abilityExists(<int>abilityCode)) ? -1 :
                m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
            var effectIndex = offlineTalentDotEffectIndex(abilityIndex, rank);
            if (effectIndex < 0) { return false; }
            var effects = %import("generated/m4_ability_effects");
            if (total != <int>(effects.metric(
                    abilityIndex, <int>rank, effectIndex, "total"
                ) + 0.5)) {
                return false;
            }
        } else if (!offlineLegacyDotProfileIsValid(state, index, duration, interval)) {
            // Schema 107 did not retain a total or talent selection. Hybrid
            // rows, including Overload Fireball/Pyroblast, must survive from
            // the already-resolved ticks instead of being reverse-engineered.
            // Their total is not reconstructible: source rounding first
            // produces an integer total, then rounds each individual tick.
            return false;
        }
        index = index + 1;
    }
    return true;
}

offlineLegacyDotCanRecoverGeneratedTotal(abilityCode: uint): bool {
    return pureDotAbilityIndex(abilityCode) >= 0 ||
        abilityCode == entanglingRootsAbilityCode();
}

offlineTalentDotResolvedTotalMatchesAura(
    abilityCode: uint, expectedTotal: int, resolvedTotal: int
): bool {
    if (resolvedTotal == expectedTotal) { return true; }
    return (abilityCode == fireballAbilityCode() || abilityCode == pyroblastAbilityCode()) &&
        resolvedTotal == <int>offlineOverloadScaledPositiveMetric(
            <float>expectedTotal, 1.4
        );
}

offlineDotTalentSnapshotRowCodeAt(state: WorldState, dotIndex: int, rowIndex: int): uint {
    return <uint>state.offlineDotTalentRowOptionCodes[dotIndex * 6 + rowIndex];
}

offlineDotTalentSnapshotIsValid(state: WorldState, index: int): bool {
    if (offlineDotTalentSnapshotIsEmpty(state, index)) { return true; }
    var sourceIndex = partyEntityIndexById(state, <uint>state.offlineDotSourceIds[index]);
    return sourceIndex >= 0 && offlineTalentAllocationValuesAreValid(
        state,
        sourceIndex,
        <uint>state.offlineDotTalentSpecCodes[index],
        offlineDotTalentSnapshotRowCodeAt(state, index, 0),
        offlineDotTalentSnapshotRowCodeAt(state, index, 1),
        offlineDotTalentSnapshotRowCodeAt(state, index, 2),
        offlineDotTalentSnapshotRowCodeAt(state, index, 3),
        offlineDotTalentSnapshotRowCodeAt(state, index, 4),
        offlineDotTalentSnapshotRowCodeAt(state, index, 5)
    );
}

offlineTalentDotSnapshotModifiers(
    state: WorldState, dotIndex: int, sourceIndex: int
): talentModifiers.TalentModifierState {
    var snapshot = new talentModifiers.TalentModifierState();
    snapshot.playerLevel = <int>state.entityLevels[sourceIndex];
    talentModifiers.recompute(
        snapshot,
        <uint>state.offlineDotTalentSpecCodes[dotIndex],
        offlineDotTalentSnapshotRowCodeAt(state, dotIndex, 0),
        offlineDotTalentSnapshotRowCodeAt(state, dotIndex, 1),
        offlineDotTalentSnapshotRowCodeAt(state, dotIndex, 2),
        offlineDotTalentSnapshotRowCodeAt(state, dotIndex, 3),
        offlineDotTalentSnapshotRowCodeAt(state, dotIndex, 4),
        offlineDotTalentSnapshotRowCodeAt(state, dotIndex, 5)
    );
    return snapshot;
}

// Projectile dots inherit their launch selection. Instant and melee dots have
// no launch row, so capture the same validated allocation at application.
appendOfflineDotTalentSnapshot(
    state: WorldState,
    sourceId: uint,
    abilityCode: uint,
    rank: uint,
    projectileIndex: int
): void {
    if (projectileIndex >= 0) {
        state.offlineDotTalentSpecCodes.add(
            <uint>state.offlineProjectileTalentSpecCodes[projectileIndex]
        );
        var projectileRow = 0;
        while (projectileRow < 6) {
            state.offlineDotTalentRowOptionCodes.add(
                offlineProjectileTalentSnapshotRowCodeAt(state, projectileIndex, projectileRow)
            );
            projectileRow = projectileRow + 1;
        }
        return;
    }
    var abilityIndex = (abilityCode == <uint>0 ||
        !knownAbilityCatalog.abilityExists(<int>abilityCode)) ? -1 :
        m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var sourceIndex = partyEntityIndexById(state, sourceId);
    var capture = offlineTalentDotEffectIndex(abilityIndex, rank) >= 0 &&
        sourceIndex >= 0 && offlineTalentAllocationIsValid(state, sourceIndex);
    state.offlineDotTalentSpecCodes.add(
        capture ? <uint>state.entityTalentSpecCodes[sourceIndex] : <uint>0
    );
    var row = 0;
    while (row < 6) {
        state.offlineDotTalentRowOptionCodes.add(
            capture ? talentRowCodeAt(state, sourceIndex, row) : <uint>0
        );
        row = row + 1;
    }
}

offlineTalentDotResolvedTotalForDot(state: WorldState, dotIndex: int): int {
    var abilityCode = <uint>state.offlineDotAbilityCodes[dotIndex];
    var rank = <uint>state.offlineDotRanks[dotIndex];
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var effectIndex = offlineTalentDotEffectIndex(abilityIndex, rank);
    if (effectIndex < 0) { return -1; }
    var effects = %import("generated/m4_ability_effects");
    if (offlineDotTalentSnapshotIsEmpty(state, dotIndex)) {
        return <int>(effects.metric(abilityIndex, <int>rank, effectIndex, "total") + 0.5);
    }
    var sourceIndex = partyEntityIndexById(state, <uint>state.offlineDotSourceIds[dotIndex]);
    if (sourceIndex < 0 || !offlineDotTalentSnapshotIsValid(state, dotIndex)) {
        return -1;
    }
    return offlineTalentDotResolvedTotalFromModifiers(
        abilityIndex, rank, offlineTalentDotSnapshotModifiers(state, dotIndex, sourceIndex)
    );
}

// Earlier payloads have rank/power facts but no periodic total or selection.
// Preserve their already-resolved hybrid ticks as rank-zero rows, while pure
// and root dots can still recover their generated base total exactly.
normalizeOfflineLegacyDotTalentRows(state: WorldState): void {
    if (state.offlineDotResolvedTotals.length != 0 ||
        state.offlineDotTalentSpecCodes.length != 0 ||
        state.offlineDotTalentRowOptionCodes.length != 0) {
        throw "woc legacy dot talent rows were initialized twice";
    }
    var index = 0;
    while (index < state.offlineDotTargetIds.length) {
        var abilityCode = <uint>state.offlineDotAbilityCodes[index];
        var rank = <uint>state.offlineDotRanks[index];
        var resolvedTotal = 0;
        var abilityIndex = (abilityCode == <uint>0 ||
            !knownAbilityCatalog.abilityExists(<int>abilityCode)) ? -1 :
            m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
        var effectIndex = offlineTalentDotEffectIndex(abilityIndex, rank);
        if (offlineLegacyDotCanRecoverGeneratedTotal(abilityCode) && effectIndex >= 0) {
            var effects = %import("generated/m4_ability_effects");
            resolvedTotal = <int>(effects.metric(
                abilityIndex, <int>rank, effectIndex, "total"
            ) + 0.5);
        } else {
            // Earlier schemas have no way to distinguish a hybrid base total
            // from an Overload-transformed one, so retain the observed tick.
            state.offlineDotRanks[index] = <uint>0;
            var ticks = <int>(<float>state.offlineDotDurations[index] /
                <float>state.offlineDotTickIntervals[index] + 0.5);
            resolvedTotal = <int>state.offlineDotDamages[index] * ticks;
        }
        state.offlineDotResolvedTotals.add(resolvedTotal);
        state.offlineDotTalentSpecCodes.add(<uint>0);
        var row = 0;
        while (row < 6) {
            state.offlineDotTalentRowOptionCodes.add(<uint>0);
            row = row + 1;
        }
        index = index + 1;
    }
}

offlineTalentDotResolvedTotalFromModifiers(
    abilityIndex: int,
    rank: uint,
    talentState: talentModifiers.TalentModifierState
): int {
    var effects = %import("generated/m4_ability_effects");
    var effectIndex = offlineTalentDotEffectIndex(abilityIndex, rank);
    if (effectIndex < 0) { return 0; }
    return dotTalentScaling.resolveDotTotal(
        <int>(effects.metric(abilityIndex, <int>rank, effectIndex, "total") + 0.5),
        m4AbilityCatalog.text(abilityIndex, "school"),
        talentState,
        m4AbilityCatalog.text(abilityIndex, "id"),
        false
    );
}

offlineTalentDotResolvedTotal(
    state: WorldState,
    sourceId: uint,
    abilityCode: uint,
    rank: uint
): int {
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return 0;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var effectIndex = offlineTalentDotEffectIndex(abilityIndex, rank);
    if (effectIndex < 0) { return 0; }
    var sourceIndex = partyEntityIndexById(state, sourceId);
    if (sourceIndex < 0) {
        var effects = %import("generated/m4_ability_effects");
        return <int>(effects.metric(abilityIndex, <int>rank, effectIndex, "total") + 0.5);
    }
    return offlineTalentDotResolvedTotalFromModifiers(
        abilityIndex, rank, offlineTalentModifiersForEntity(state, sourceIndex)
    );
}

offlineTalentDotProjectileResolvedTotal(state: WorldState, projectileIndex: int): int {
    var abilityCode = <uint>state.offlineProjectileAbilityCodes[projectileIndex];
    var rank = <uint>state.offlineProjectileRanks[projectileIndex];
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return 0;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var effectIndex = offlineTalentDotEffectIndex(abilityIndex, rank);
    if (effectIndex < 0) { return 0; }
    if (offlineProjectileTalentSnapshotIsEmpty(state, projectileIndex)) {
        var effects = %import("generated/m4_ability_effects");
        return <int>(effects.metric(abilityIndex, <int>rank, effectIndex, "total") + 0.5);
    }
    var sourceIndex = partyEntityIndexById(
        state, <uint>state.offlineProjectileSourceIds[projectileIndex]
    );
    if (sourceIndex < 0 || !offlineProjectileTalentSnapshotIsValid(state, projectileIndex)) {
        return -1;
    }
    return offlineTalentDotResolvedTotalFromModifiers(
        abilityIndex,
        rank,
        offlineTalentDirectDamageSnapshotModifiers(state, projectileIndex, sourceIndex)
    );
}

// A launched channel tick is a deferred projectile in WOC. Its numeric range
// comes from the allocation at that tick's launch, not a later respec.
offlineTalentDrainTickProjectileRangeIsValid(state: WorldState, index: int): bool {
    var abilityCode = <uint>state.offlineProjectileAbilityCodes[index];
    var rank = <uint>state.offlineProjectileRanks[index];
    var snapshotEmpty = offlineProjectileTalentSnapshotIsEmpty(state, index);
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return false;
    }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var effectIndex = offlineTalentDrainTickEffectIndex(abilityIndex, rank);
    if (effectIndex < 0) { return snapshotEmpty; }
    var effects = %import("generated/m4_ability_effects");
    var expected = new drainTickTalentScaling.DrainTickRange();
    expected.minimum = <int>(effects.metric(abilityIndex, <int>rank, effectIndex, "min") + 0.5);
    expected.maximum = <int>(effects.metric(abilityIndex, <int>rank, effectIndex, "max") + 0.5);
    if (!snapshotEmpty) {
        var sourceIndex = partyEntityIndexById(
            state, <uint>state.offlineProjectileSourceIds[index]
        );
        if (sourceIndex < 0 || !offlineProjectileTalentSnapshotIsValid(state, index)) {
            return false;
        }
        expected = drainTickTalentScaling.resolveDrainTickRange(
            expected.minimum,
            expected.maximum,
            m4AbilityCatalog.text(abilityIndex, "school"),
            offlineTalentDirectDamageSnapshotModifiers(state, index, sourceIndex),
            m4AbilityCatalog.text(abilityIndex, "id")
        );
    }
    return drainTickTalentScaling.drainTickRangeSnapshotMatches(
        expected.minimum,
        expected.maximum,
        <float>state.offlineProjectileMinimums[index],
        <float>state.offlineProjectileMaximums[index]
    );
}

offlineOverloadTalentDirectDamageRange(
    range: directDamageTalentScaling.DirectDamageRange, multiplier: float
): directDamageTalentScaling.DirectDamageRange {
    var scaled = new directDamageTalentScaling.DirectDamageRange();
    scaled.minimum = <int>offlineOverloadScaledPositiveMetric(
        <float>range.minimum, multiplier
    );
    scaled.maximum = <int>offlineOverloadScaledPositiveMetric(
        <float>range.maximum, multiplier
    );
    return scaled;
}

// The projectile snapshot carries the launch allocation because a later respec
// cannot recreate its resolved endpoints. Decode recomputes from that recorded
// allocation, never from the caster's current selection.
offlineTalentDirectDamageProjectileRangeIsValid(state: WorldState, index: int): bool {
    var abilityCode = <uint>state.offlineProjectileAbilityCodes[index];
    var rank = <uint>state.offlineProjectileRanks[index];
    var snapshotEmpty = offlineProjectileTalentSnapshotIsEmpty(state, index);
    if (abilityCode == <uint>0) { return snapshotEmpty; }
    if (!knownAbilityCatalog.abilityExists(<int>abilityCode)) { return false; }
    var abilityIndex = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var directEffectIndex = offlineTalentDirectDamageEffectIndex(abilityIndex, rank);
    if (directEffectIndex < 0) {
        if (offlineTalentDrainTickEffectIndex(abilityIndex, rank) >= 0) {
            return offlineTalentDrainTickProjectileRangeIsValid(state, index);
        }
        return snapshotEmpty || (offlineTalentDotEffectIndex(abilityIndex, rank) >= 0 &&
            offlineProjectileTalentSnapshotIsValid(state, index));
    }
    var effects = %import("generated/m4_ability_effects");
    var baseMinimum = <int>(effects.metric(abilityIndex, <int>rank, 0, "min") + 0.5);
    var baseMaximum = <int>(effects.metric(abilityIndex, <int>rank, 0, "max") + 0.5);
    var expected = new directDamageTalentScaling.DirectDamageRange();
    expected.minimum = baseMinimum;
    expected.maximum = baseMaximum;
    if (!snapshotEmpty) {
        var sourceIndex = partyEntityIndexById(
            state, <uint>state.offlineProjectileSourceIds[index]
        );
        if (sourceIndex < 0 || !offlineProjectileTalentSnapshotIsValid(state, index)) {
            return false;
        }
        expected = directDamageTalentScaling.resolveDirectDamageRange(
            baseMinimum,
            baseMaximum,
            m4AbilityCatalog.text(abilityIndex, "school"),
            offlineTalentDirectDamageSnapshotModifiers(state, index, sourceIndex),
            m4AbilityCatalog.text(abilityIndex, "id")
        );
    }
    var dotTotal = <float>state.offlineProjectileDotTotals[index];
    if (abilityCode == fireballAbilityCode() || abilityCode == pyroblastAbilityCode()) {
        var baseDotTotal = effects.metric(abilityIndex, <int>rank, 1, "total");
        if (dotTotal == offlineOverloadScaledPositiveMetric(baseDotTotal, 1.4)) {
            expected = offlineOverloadTalentDirectDamageRange(expected, 1.4);
        } else if (dotTotal != baseDotTotal) {
            return false;
        }
    }
    var minimum = <float>state.offlineProjectileMinimums[index];
    var maximum = <float>state.offlineProjectileMaximums[index];
    return directDamageTalentScaling.directDamageRangeSnapshotMatches(
        expected.minimum,
        expected.maximum,
        minimum,
        maximum
    );
}

// Aimed Shot's direct endpoints are source-immutable, while its `castPct`
// talent modifier is captured in the projectile allocation. Landing reads live
// ranged power, but the coefficient must retain the cast's resolved duration.
aimedShotProjectileProfileIsValid(state: WorldState, index: int): bool {
    var abilityCode = aimedShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("aimed_shot");
    var sourceIndex = partyEntityIndexById(
        state, <uint>state.offlineProjectileSourceIds[index]
    );
    if (sourceIndex < 0 || !aimedShotProfileIsValid(
            abilityIndex, <int>state.entityLevels[sourceIndex]
        ) || <uint>state.offlineProjectileAbilityCodes[index] != abilityCode ||
        <uint>state.offlineProjectileRanks[index] != <uint>1 ||
        !floatMatches(<float>state.offlineProjectileMinimums[index], 50.0) ||
        !floatMatches(<float>state.offlineProjectileMaximums[index], 62.0)) {
        return false;
    }
    var castPct = 0.0;
    if (!offlineProjectileTalentSnapshotIsEmpty(state, index)) {
        if (!offlineProjectileTalentSnapshotIsValid(state, index)) { return false; }
        var modifiers = offlineTalentDirectDamageSnapshotModifiers(state, index, sourceIndex);
        castPct = talentModifiers.abilityField(modifiers, "aimed_shot", "castPct");
    }
    return floatMatches(
        <float>state.offlineProjectileCastTimes[index],
        m4AbilityCatalog.metric(abilityIndex, <int>state.entityLevels[sourceIndex], "castTime") *
            (1.0 + castPct)
    );
}

concussiveShotProjectileProfileIsValid(state: WorldState, index: int): bool {
    var abilityCode = concussiveShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("concussive_shot");
    var sourceIndex = partyEntityIndexById(
        state, <uint>state.offlineProjectileSourceIds[index]
    );
    if (sourceIndex < 0 || !concussiveShotProfileIsValid(
            abilityIndex, <int>state.entityLevels[sourceIndex]
        ) || <uint>state.offlineProjectileAbilityCodes[index] != abilityCode ||
        <uint>state.offlineProjectileRanks[index] != <uint>1 ||
        !floatMatches(<float>state.offlineProjectileMinimums[index], 4.0) ||
        !floatMatches(<float>state.offlineProjectileMaximums[index], 6.0)) {
        return false;
    }
    return floatMatches(<float>state.offlineProjectileCastTimes[index], 0.0);
}

offlineTalentDirectDamageProfileMinimum(state: WorldState, index: int): float {
    var abilityCode = <uint>state.offlineProjectileAbilityCodes[index];
    var abilityIndex = (abilityCode == <uint>0 ||
        !knownAbilityCatalog.abilityExists(<int>abilityCode)) ? -1 :
        m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var rank = <uint>state.offlineProjectileRanks[index];
    if (offlineTalentDirectDamageEffectIndex(abilityIndex, rank) < 0) {
        return <float>state.offlineProjectileMinimums[index];
    }
    var effects = %import("generated/m4_ability_effects");
    return effects.metric(abilityIndex, <int>rank, 0, "min");
}

offlineTalentDirectDamageProfileMaximum(state: WorldState, index: int): float {
    var abilityCode = <uint>state.offlineProjectileAbilityCodes[index];
    var abilityIndex = (abilityCode == <uint>0 ||
        !knownAbilityCatalog.abilityExists(<int>abilityCode)) ? -1 :
        m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    var rank = <uint>state.offlineProjectileRanks[index];
    if (offlineTalentDirectDamageEffectIndex(abilityIndex, rank) < 0) {
        return <float>state.offlineProjectileMaximums[index];
    }
    var effects = %import("generated/m4_ability_effects");
    return effects.metric(abilityIndex, <int>rank, 0, "max");
}

appendOfflineAbilityProjectile(
    state: WorldState,
    sourceId: uint,
    targetId: uint,
    sourceX: float,
    sourceZ: float,
    minimum: float,
    maximum: float,
    speed: float,
    wand: bool,
    school: uint,
    abilityCode: uint,
    rank: uint,
    castTime: float
): void {
    var resolvedRange = resolveOfflineTalentDirectDamageRange(
        state, sourceId, abilityCode, rank, minimum, maximum
    );
    appendOfflineAbilityProjectileWithDotTotal(
        state, sourceId, targetId, sourceX, sourceZ,
        <float>resolvedRange.minimum, <float>resolvedRange.maximum, speed,
        wand, school, abilityCode, rank, castTime,
        offlineProjectileBaseDotTotal(abilityCode, rank)
    );
}

appendOfflineAbilityProjectileWithDotTotal(
    state: WorldState,
    sourceId: uint,
    targetId: uint,
    sourceX: float,
    sourceZ: float,
    minimum: float,
    maximum: float,
    speed: float,
    wand: bool,
    school: uint,
    abilityCode: uint,
    rank: uint,
    castTime: float,
    dotTotal: float
): void {
    if (state.offlineProjectileSourceIds.length >= <int>OFFLINE_PROJECTILE_PENDING_MAX) {
        throw "woc offline projectile queue exceeds WOS cap";
    }
    state.offlineProjectileSourceIds.add(sourceId);
    state.offlineProjectileTargetIds.add(targetId);
    state.offlineProjectileX.add(sourceX);
    state.offlineProjectileZ.add(sourceZ);
    state.offlineProjectileTtls.add(projectileTravel.projectileMaxFlight());
    state.offlineProjectileWands.add(wand);
    state.offlineProjectileSchoolCodes.add(school);
    state.offlineProjectileMinimums.add(minimum);
    state.offlineProjectileMaximums.add(maximum);
    state.offlineProjectileSpeeds.add(speed);
    state.offlineProjectileAbilityCodes.add(abilityCode);
    state.offlineProjectileRanks.add(rank);
    state.offlineProjectileCastTimes.add(castTime);
    appendOfflineProjectileTalentSnapshot(state, sourceId, abilityCode, rank);
    state.offlineProjectileDotTotals.add(dotTotal);
    state.offlineProjectileFixedDamages.add(0);
    state.offlineProjectileCriticals.add(false);
    var casterIndex = partyEntityIndexById(state, sourceId);
    if (casterIndex >= 0) {
        // This call is the retained cast-complete boundary for instant ranged
        // shots and for cast-time Aimed Shot once its cast reaches release.
        applyOfflineLeanQuiverCastCompleted(state, casterIndex, abilityCode, false);
        applyOfflineRedlineDrawCastCompleted(state, casterIndex, abilityCode, false);
    }
}

// Power Echo schedules a new travel row after the primary spell has already
// resolved. It carries only the copied amount, never a fresh damage interval.
appendOfflineFixedSpellProjectile(
    state: WorldState,
    sourceId: uint,
    targetId: uint,
    sourceX: float,
    sourceZ: float,
    school: uint,
    abilityCode: uint,
    rank: uint,
    fixedDamage: int,
    critical: bool
): void {
    if (state.offlineProjectileSourceIds.length >= <int>OFFLINE_PROJECTILE_PENDING_MAX ||
        sourceId == <uint>0 || targetId == <uint>0 || sourceId == targetId ||
        abilityCode == <uint>0 || rank == <uint>0 || !(fixedDamage > 0) ||
        fixedDamage > 65535 || !knownAbilityCatalog.abilityExists(<int>abilityCode) ||
        school != offlineAbilitySchoolCode(abilityCode)) {
        throw "woc fixed spell projectile is invalid";
    }
    state.offlineProjectileSourceIds.add(sourceId);
    state.offlineProjectileTargetIds.add(targetId);
    state.offlineProjectileX.add(sourceX);
    state.offlineProjectileZ.add(sourceZ);
    state.offlineProjectileTtls.add(projectileTravel.projectileMaxFlight());
    state.offlineProjectileWands.add(false);
    state.offlineProjectileSchoolCodes.add(school);
    state.offlineProjectileMinimums.add(0.0);
    state.offlineProjectileMaximums.add(0.0);
    state.offlineProjectileSpeeds.add(projectileTravel.projectileSpeed());
    state.offlineProjectileAbilityCodes.add(abilityCode);
    state.offlineProjectileRanks.add(rank);
    state.offlineProjectileCastTimes.add(0.0);
    state.offlineProjectileTalentSpecCodes.add(<uint>0);
    var fixedTalentRow = 0;
    while (fixedTalentRow < 6) {
        state.offlineProjectileTalentRowOptionCodes.add(<uint>0);
        fixedTalentRow = fixedTalentRow + 1;
    }
    state.offlineProjectileDotTotals.add(0.0);
    state.offlineProjectileFixedDamages.add(fixedDamage);
    state.offlineProjectileCriticals.add(critical);
}

removeOfflineProjectileAt(state: WorldState, index: int): void {
    state.offlineProjectileSourceIds.removeAt(index);
    state.offlineProjectileTargetIds.removeAt(index);
    state.offlineProjectileX.removeAt(index);
    state.offlineProjectileZ.removeAt(index);
    state.offlineProjectileTtls.removeAt(index);
    state.offlineProjectileWands.removeAt(index);
    state.offlineProjectileSchoolCodes.removeAt(index);
    state.offlineProjectileMinimums.removeAt(index);
    state.offlineProjectileMaximums.removeAt(index);
    state.offlineProjectileSpeeds.removeAt(index);
    state.offlineProjectileAbilityCodes.removeAt(index);
    state.offlineProjectileRanks.removeAt(index);
    state.offlineProjectileCastTimes.removeAt(index);
    state.offlineProjectileTalentSpecCodes.removeAt(index);
    var projectileTalentRow = 0;
    while (projectileTalentRow < 6) {
        state.offlineProjectileTalentRowOptionCodes.removeAt(index * 6);
        projectileTalentRow = projectileTalentRow + 1;
    }
    state.offlineProjectileDotTotals.removeAt(index);
    state.offlineProjectileFixedDamages.removeAt(index);
    state.offlineProjectileCriticals.removeAt(index);
}

// This is the retained subset of Sim.enterCombat for hostile spell impact. It is
// deliberately invoked on a full resist too: a released hostile spell starts
// combat and idle social aggro, but a resist adds neither damage threat nor a
// movement aura.
enterOfflineSpellProjectileCombat(state: WorldState, casterIndex: int, targetIndex: int): void {
    var casterId = <uint>state.entityIds[casterIndex];
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
        enterIdleMobAggro(state, targetIndex, casterId);
    } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
        state.entityAggroTargetIds[targetIndex] = casterId;
    }
}

// A source Power Echo reuses the primary final damage and crit outcome. The
// reduced world represents that as a deterministic fixed row; it deliberately
// bypasses the original ability's proc, control, and periodic side effects.
scheduleOfflinePowerEchoDamage(
    state: WorldState,
    casterIndex: int,
    targetIndex: int,
    abilityCode: uint,
    rank: uint,
    resolvedDamage: int,
    targetHpAfterPrimary: int,
    critical: bool
): void {
    if (resolvedDamage <= 0) { return; }
    var echoValue = consumeOfflinePowerEcho(state, casterIndex);
    if (echoValue <= 0.0 || targetHpAfterPrimary <= 0) { return; }
    var copiedDamage = <int>(<float>resolvedDamage * echoValue + 0.5);
    if (copiedDamage < 1) { copiedDamage = 1; }
    appendOfflineFixedSpellProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        <uint>state.entityIds[targetIndex],
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        offlineAbilitySchoolCode(abilityCode),
        abilityCode,
        rank,
        copiedDamage,
        critical
    );
}

landOfflineFixedSpellProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var abilityCode = <uint>state.offlineProjectileAbilityCodes[projectileIndex];
    var impact = fixedSpellImpact.resolve(
        <int>state.offlineProjectileFixedDamages[projectileIndex],
        <bool>state.offlineProjectileCriticals[projectileIndex]
    );
    var damage = resolveOfflineFixedSpellImpactDamage(
        state,
        casterIndex,
        targetIndex,
        abilityCode,
        <uint>state.offlineProjectileSchoolCodes[projectileIndex],
        impact.damage,
        impact.critical
    );
    var abilityIndex = m4AbilityCatalog.indexOf(
        knownAbilityCatalog.abilityId(<int>abilityCode)
    );
    if (damage <= 0 || abilityCode == <uint>0) { return; }
    var school = <uint>state.offlineProjectileSchoolCodes[projectileIndex];
    var dealt = 0;
    if (school == OFFLINE_PROJECTILE_SCHOOL_ARCANE) {
        dealt = applyOfflineArcaneEffectiveDamage(state, targetIndex, damage);
    } else {
        var hpBefore = <int>state.entityHp[targetIndex];
        dealt = damage < hpBefore ? damage : hpBefore;
        state.entityHp[targetIndex] = hpBefore - dealt;
    }
    var hp = <int>state.entityHp[targetIndex];
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage);
    if (dealt > 0 && school == OFFLINE_PROJECTILE_SCHOOL_ARCANE) {
        applyOfflineTemporalEchoDamageConversion(
            state, casterIndex, dealt, OFFLINE_PROJECTILE_SCHOOL_ARCANE, false
        );
    }
    if (hp > 0) {
        if (abilityIndex >= 0) {
            var level = <int>state.entityLevels[casterIndex];
            state.setThreat(
                <uint>state.entityIds[targetIndex],
                <uint>state.entityIds[casterIndex],
                stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                    <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                    m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
                1
            );
        }
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

removeOfflineCritVulnAt(state: WorldState, index: int): void {
    state.offlineCritVulnTargetIds.removeAt(index);
    state.offlineCritVulnSourceIds.removeAt(index);
    state.offlineCritVulnValues.removeAt(index);
    state.offlineCritVulnRemaining.removeAt(index);
}

applyOfflineCritVuln(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    value: float,
    duration: float
): void {
    if (targetId == <uint>0 || sourceId == <uint>0 || targetId == sourceId ||
        value <= 0.0 || duration <= 0.0) {
        throw "woc crit vulnerability row is invalid";
    }
    var index = 0;
    while (index < state.offlineCritVulnTargetIds.length) {
        if (<uint>state.offlineCritVulnTargetIds[index] == targetId &&
            <uint>state.offlineCritVulnSourceIds[index] == sourceId) {
            removeOfflineCritVulnAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineCritVulnTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc crit vulnerability queue exceeds WOS cap";
    }
    state.offlineCritVulnTargetIds.add(targetId);
    state.offlineCritVulnSourceIds.add(sourceId);
    state.offlineCritVulnValues.add(value);
    state.offlineCritVulnRemaining.add(duration);
}

removeOfflineTemporalEchoAt(state: WorldState, index: int): void {
    state.offlineTemporalEchoTargetIds.removeAt(index);
    state.offlineTemporalEchoSourceIds.removeAt(index);
    state.offlineTemporalEchoRemaining.removeAt(index);
    state.offlineTemporalEchoGroups.removeAt(index);
    state.offlineTemporalEchoConvertRates.removeAt(index);
}

// A source's personal marks leave with Chronomancy. WOS193 only stores the
// individual form, so this intentionally clears every row owned by that
// source without reserving the later Cascade group-mark distinction.
stripOfflineTemporalEchoesBySource(state: WorldState, sourceId: uint): void {
    if (sourceId == <uint>0) { return; }
    var index = 0;
    while (index < state.offlineTemporalEchoSourceIds.length) {
        if (<uint>state.offlineTemporalEchoSourceIds[index] == sourceId) {
            removeOfflineTemporalEchoAt(state, index);
        } else {
            index = index + 1;
        }
    }
}

stripOfflineIndividualTemporalEchoesBySource(state: WorldState, sourceId: uint): void {
    if (sourceId == <uint>0) { return; }
    var index = 0;
    while (index < state.offlineTemporalEchoSourceIds.length) {
        if (<uint>state.offlineTemporalEchoSourceIds[index] == sourceId &&
            !<bool>state.offlineTemporalEchoGroups[index]) {
            removeOfflineTemporalEchoAt(state, index);
        } else {
            index = index + 1;
        }
    }
}

// The source keeps one individual Echo per caster. Recasting moves only that
// individual mark, leaving separately-owned Cascade group marks intact.
applyOfflineTemporalEchoMark(
    state: WorldState,
    casterIndex: int,
    targetId: uint,
    targetIndex: int,
    duration: float
): void {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length ||
        targetIndex < 0 || targetIndex >= state.entityIds.length || targetId == <uint>0 ||
        <uint>state.entityIds[targetIndex] != targetId || duration <= 0.0 ||
        <bool>state.entityDead[casterIndex] || <bool>state.entityDead[targetIndex] ||
        lesserHealFriendlyTargetIndex(state, casterIndex, targetId) != targetIndex) {
        return;
    }
    var contract = %import("generated/temporal_echo_contract");
    var sourceId = <uint>state.entityIds[casterIndex];
    stripOfflineIndividualTemporalEchoesBySource(state, sourceId);
    var index = 0;
    while (index < state.offlineTemporalEchoSourceIds.length) {
        if (<uint>state.offlineTemporalEchoSourceIds[index] == sourceId &&
            <uint>state.offlineTemporalEchoTargetIds[index] == targetId) {
            removeOfflineTemporalEchoAt(state, index);
        } else {
            index = index + 1;
        }
    }
    if (state.offlineTemporalEchoTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc Temporal Echo queue exceeds WOS cap";
    }
    state.offlineTemporalEchoTargetIds.add(targetId);
    state.offlineTemporalEchoSourceIds.add(sourceId);
    state.offlineTemporalEchoRemaining.add(duration);
    state.offlineTemporalEchoGroups.add(false);
    state.offlineTemporalEchoConvertRates.add(contract.singleRate());
}

ageOfflineTemporalEcho(state: WorldState): void {
    if (!offlineTemporalEchoStateIsValid(state)) {
        throw "woc Temporal Echo state is invalid";
    }
    var index = 0;
    while (index < state.offlineTemporalEchoTargetIds.length) {
        var targetIndex = partyEntityIndexById(
            state, <uint>state.offlineTemporalEchoTargetIds[index]
        );
        var sourceIndex = partyEntityIndexById(
            state, <uint>state.offlineTemporalEchoSourceIds[index]
        );
        var remaining = <float>state.offlineTemporalEchoRemaining[index] -
            projectileTravel.projectileTickSeconds();
        if (targetIndex < 0 || sourceIndex < 0 || <bool>state.entityDead[targetIndex] ||
            <bool>state.entityDead[sourceIndex] || remaining <= OFFLINE_PERIODIC_TICK_EPS) {
            removeOfflineTemporalEchoAt(state, index);
        } else {
            state.offlineTemporalEchoRemaining[index] = remaining;
            index = index + 1;
        }
    }
}

// The source conversion reads actual HP loss only after shields and the health
// floor. This helper is deliberately narrow: existing non-Arcane paths keep
// their established damage settlement until their own source slices converge.
applyOfflineArcaneEffectiveDamage(state: WorldState, targetIndex: int, damage: int): int {
    if (damage <= 0 || targetIndex < 0 || targetIndex >= state.entityIds.length ||
        <bool>state.entityDead[targetIndex]) {
        return 0;
    }
    var remainingDamage = applyOfflineAbsorbDamage(state, targetIndex, damage);
    var hpBefore = <int>state.entityHp[targetIndex];
    var dealt = remainingDamage < hpBefore ? remainingDamage : hpBefore;
    if (dealt < 0) { dealt = 0; }
    state.entityHp[targetIndex] = hpBefore - dealt;
    recordOfflineRewindDamage(state, targetIndex, dealt);
    applyOfflineDeathlessWillDamageTaken(state, targetIndex, remainingDamage);
    return dealt;
}

// Temporal Echo turns a Mage's own landed Arcane damage into a non-crit
// resolved heal. Applying the heal never enters a damage path, so conversion
// cannot recurse and the authoritative RNG stream is untouched.
applyOfflineTemporalEchoDamageConversion(
    state: WorldState,
    casterIndex: int,
    dealt: int,
    schoolCode: uint,
    area: bool
): void {
    if (dealt <= 0 || schoolCode != OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
        casterIndex < 0 || casterIndex >= state.entityIds.length ||
        <uint>state.entityKinds[casterIndex] != <uint>1 ||
        <bool>state.entityDead[casterIndex] || !offlineTemporalEchoStateIsValid(state)) {
        return;
    }
    var contract = %import("generated/temporal_echo_contract");
    var sourceId = <uint>state.entityIds[casterIndex];
    var index = 0;
    while (index < state.offlineTemporalEchoSourceIds.length) {
        if (<uint>state.offlineTemporalEchoSourceIds[index] == sourceId) {
            var targetId = <uint>state.offlineTemporalEchoTargetIds[index];
            var targetIndex = partyEntityIndexById(state, targetId);
            if (targetIndex >= 0 && !<bool>state.entityDead[targetIndex]) {
                var rate = area ?
                    (<bool>state.offlineTemporalEchoGroups[index] ?
                        contract.groupAreaRate() : contract.areaRate()) :
                    <float>state.offlineTemporalEchoConvertRates[index];
                applyOfflineResolvedDirectHeal(
                    state, casterIndex, targetId, targetIndex, <float>dealt * rate
                );
            }
        }
        index = index + 1;
    }
}

// Source selects the largest active value across target auras. This query is
// shared by normal and fixed projectile landings so copied hits use the same
// source ordering without a new critical roll.
offlineCritVulnBonus(state: WorldState, targetIndex: int): float {
    if (targetIndex < 0 || targetIndex >= state.entityIds.length) { return 0.0; }
    var targetId = <uint>state.entityIds[targetIndex];
    var bonus = 0.0;
    var index = 0;
    while (index < state.offlineCritVulnTargetIds.length) {
        if (<uint>state.offlineCritVulnTargetIds[index] == targetId &&
            <float>state.offlineCritVulnRemaining[index] > 0.0 &&
            <float>state.offlineCritVulnValues[index] > bonus) {
            bonus = <float>state.offlineCritVulnValues[index];
        }
        index = index + 1;
    }
    return bonus;
}

applyOfflineIgniteOnCriticalSpellImpact(
    state: WorldState,
    casterIndex: int,
    targetIndex: int,
    abilityCode: uint,
    schoolCode: uint,
    damage: int,
    critical: bool
): void {
    if (casterIndex < 0 || targetIndex < 0 || casterIndex >= state.entityIds.length ||
        targetIndex >= state.entityIds.length || damage <= 0) {
        return;
    }
    var sourcePresent = <uint>state.entityKinds[casterIndex] == <uint>1 &&
        !<bool>state.entityDead[casterIndex];
    var specCode = <uint>state.entityTalentSpecCodes[casterIndex];
    var specId = specCode == <uint>0 ? "" : talentSelectionCatalog.specId(specCode);
    var modifiers = offlineTalentModifiersForEntity(state, casterIndex);
    var ignitionPct = talentModifiers.globalField(modifiers, "ignitionPct");
    var plan = fireMage.igniteOnCritPlan(
        critical,
        damage,
        abilityCode != <uint>0 && knownAbilityCatalog.abilityExists(<int>abilityCode),
        offlineProjectileSchoolName(schoolCode),
        sourcePresent,
        <uint>state.entityIds[casterIndex] == <uint>state.entityIds[targetIndex],
        specId == "fire",
        ignitionPct
    );
    if (!plan.applies) { return; }
    var burn = <int>(<float>damage * plan.ignitionPct + 0.5);
    var targetId = <uint>state.entityIds[targetIndex];
    var sourceId = <uint>state.entityIds[casterIndex];
    var existing = 0;
    var index = 0;
    while (index < state.offlineDotTargetIds.length) {
        if (<uint>state.offlineDotTargetIds[index] == targetId &&
            <uint>state.offlineDotSourceIds[index] == sourceId &&
            <uint>state.offlineDotAbilityCodes[index] == ignitionAbilityCode()) {
            existing = <int>state.offlineDotDamages[index];
            break;
        }
        index = index + 1;
    }
    var ignite = fireMage.ignitePlan(
        <bool>state.entityDead[targetIndex], burn, index < state.offlineDotTargetIds.length,
        existing
    );
    if (ignite.applies) {
        applyOfflineIgniteDot(state, targetId, sourceId, ignite.resultingValue);
    }
}

// Fixed Power Echo rows are already post-roll. This boundary preserves the
// source critical outcome for critical-only impact rules without replaying the
// original spell's post-hit processing (such as Fire Mage Hot Streak).
resolveOfflineFixedSpellImpactDamage(
    state: WorldState,
    casterIndex: int,
    targetIndex: int,
    abilityCode: uint,
    schoolCode: uint,
    damage: int,
    critical: bool
): int {
    var impact = fixedSpellImpact.resolve(damage, critical);
    if (!fixedSpellImpact.isValid(impact)) { return 0; }
    var resolvedDamage = impact.damage;
    if (impact.critical) {
        var critVuln = offlineCritVulnBonus(state, targetIndex);
        if (critVuln > 0.0) {
            resolvedDamage = <int>(<float>resolvedDamage * (1.0 + critVuln) + 0.5);
        }
    }
    applyOfflineIgniteOnCriticalSpellImpact(
        state, casterIndex, targetIndex, abilityCode, schoolCode, resolvedDamage,
        impact.critical
    );
    return resolvedDamage;
}

landOfflineFrostboltProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = frostboltAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] !=
        abilityCode || rank <= 0) {
        return;
    }

    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    // The world retains hitBonus as its source fraction; SpellResistState
    // models the isolated rating conversion surface, so supply its inverse.
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }

    var resolution = new timedSpell.TimedSpellResult();
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    spell.spellPower = <float>state.entitySpellPower[casterIndex];
    spell.school = "frost";
    spell.castTime = <float>state.offlineProjectileCastTimes[projectileIndex];
    spell.critChance = offlineDamageCritChance(state, casterIndex);
    configureOfflineSpellDamageModifiers(state, casterIndex, spell);
    timedSpell.resolveTimedSpellHit(resolution, spell);

    var rawDamage = resolution.damage;
    var damage = resolveOfflineFixedSpellImpactDamage(
        state, casterIndex, targetIndex, abilityCode,
        <uint>state.offlineProjectileSchoolCodes[projectileIndex], rawDamage,
        resolution.critical
    );
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage); }
    scheduleOfflinePowerEchoDamage(
        state, casterIndex, targetIndex, abilityCode, <uint>rank, rawDamage, hp,
        resolution.critical
    );
    if (hp > 0) {
        applyOfflineMotionAura(
            state,
            targetIndex,
            abilityCode,
            <uint>state.entityIds[casterIndex],
            ccContract.motionAuraKindCode("slow"),
            m4AbilityEffects.metric(abilityIndex, rank, 1, "duration")
        );
        var level = <int>state.entityLevels[casterIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

// Smite has the source nonphysical-spell path: projectile impact first spends
// one resist draw, then the generated direct-damage range and spell-crit draws.
landOfflineSmiteProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var abilityCode = smiteAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("smite");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] !=
        abilityCode || <uint>state.offlineProjectileSchoolCodes[projectileIndex] !=
        OFFLINE_PROJECTILE_SCHOOL_HOLY || rank <= 0) {
        return;
    }
    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }
    var resolution = new timedSpell.TimedSpellResult();
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    spell.spellPower = <float>state.entitySpellPower[casterIndex];
    spell.school = "holy";
    spell.castTime = <float>state.offlineProjectileCastTimes[projectileIndex];
    spell.critChance = offlineDamageCritChance(state, casterIndex);
    configureOfflineSpellDamageModifiers(state, casterIndex, spell);
    timedSpell.resolveTimedSpellHit(resolution, spell);
    var rawDamage = resolution.damage;
    var damage = resolveOfflineFixedSpellImpactDamage(
        state, casterIndex, targetIndex, abilityCode,
        <uint>state.offlineProjectileSchoolCodes[projectileIndex], rawDamage,
        resolution.critical
    );
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage); }
    if (hp > 0) {
        var level = <int>state.entityLevels[casterIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

