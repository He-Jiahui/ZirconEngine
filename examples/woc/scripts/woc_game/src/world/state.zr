// WOS82 retains the player-death owned-demon handoff. The row remains inert
// until Plugins08 can provide the source physical Map/row deletion transaction.
pub emberkinOwnerDeathStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var petId = spawnOfflineEmberkin(state, 0);
    var petIndex = 1;
    if (playerId == <uint>0 || petId == <uint>0) {
        return -1;
    }
    state.entityInCombat[petIndex] = true;
    state.entityAggroTargetIds[petIndex] = <uint>999;
    state.entityPetManualTauntPending[petIndex] = true;
    applyOfflineMobMeleePlayerDeath(state, 0);
    return <bool>state.entityDead[0] && <int>state.entityHp[0] == 0 &&
        <bool>state.entityDead[petIndex] && <int>state.entityHp[petIndex] == 0 &&
        <uint>state.entityCorpseMicros[petIndex] == OFFLINE_EMBERKIN_DEMON_CORPSE_MICROS &&
        !<bool>state.entityInCombat[petIndex] &&
        <uint>state.entityAggroTargetIds[petIndex] == <uint>0 &&
        <uint>state.entityOwnerIds[petIndex] == playerId ? 1 : -2;
}

// WOS83 retains a dead demon's three-second source revive window without
// claiming the unavailable physical entity removal after that interval.
pub emberkinDemonCorpseStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var petId = spawnOfflineEmberkin(state, 0);
    if (playerId == <uint>0 || petId == <uint>0) {
        return -1;
    }
    beginOfflineEmberkinDemonDeath(state, 1);
    if (<uint>state.entityCorpseMicros[1] != OFFLINE_EMBERKIN_DEMON_CORPSE_MICROS) {
        return -2;
    }
    reviveOfflineEmberkinPet(state, 0, 1);
    if (<bool>state.entityDead[1] || <uint>state.entityCorpseMicros[1] != <uint>0) {
        return -3;
    }
    beginOfflineEmberkinDemonDeath(state, 1);
    state.entityCorpseMicros[1] = <uint>50000;
    ageOfflineEmberkinDemonCorpses(state);
    reviveOfflineEmberkinPet(state, 0, 1);
    if (!<bool>state.entityDead[1] || <uint>state.entityCorpseMicros[1] != <uint>0) {
        return -4;
    }

    var replacement = new WorldState();
    replacement.offlineSessionActive = true;
    replacement.offlinePlayerClass = <uint>7;
    replacement.spawnPlayer(<uint>8, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var oldPetId = spawnOfflineEmberkin(replacement, 0);
    retireOfflineOwnedPet(replacement, 1);
    var livePetId = spawnOfflineEmberkin(replacement, 0);
    var selectedIndex = offlineOwnedEmberkinPetIndex(replacement, playerId, true);
    return oldPetId != <uint>0 && livePetId != <uint>0 && selectedIndex == 2 ? 1 : -5;
}

// Seal uses the action-bar path, while Judgement exercises the typed targeted
// path. The test also pins the application-time rank across snapshot restore,
// the auto-attack flat bonus, and the source two-draw Judgement resolution.
pub sealJudgementCommandStateTest(): int {
    var seal = sealOfRighteousnessAbilityCode();
    var judgement = judgementAbilityCode();
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (seal == <uint>0 || judgement == <uint>0 || forestWolf == <uint>0 ||
        m4AbilityCatalog.indexOf("seal_of_righteousness") != 14 ||
        m4AbilityCatalog.indexOf("judgement") != 15 ||
        !sealOfRighteousnessProfileIsValid(<uint>1)) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>3;
    var playerId = state.spawnPlayer(<uint>4, 4, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 200, 8.0);
    state.entityResources[0] = 100;
    state.entityMaxResources[0] = 100;
    state.entitySpellPower[0] = 70;
    state.entityCritChance[0] = 0.0;
    state.entityWeaponMinimum[0] = 10;
    state.entityWeaponMaximum[0] = 10;
    state.entityWeaponSpeed[0] = 2.0;
    state.entityArmor[1] = 0;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(seal);
    state.entityKnownAbilityCodes.add(judgement);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>2;
        knownOffset = knownOffset + 1;
    }
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (<int>state.entityResources[0] != 75 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        <uint>state.entityImbueAbilityCodes[0] != seal ||
        <uint>state.entityImbueRanks[0] != <uint>1 ||
