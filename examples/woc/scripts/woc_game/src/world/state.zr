        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -5;
}

pub partyMarkerCommandStateTest(): int {
    var state = new WorldState();
    var leader = state.spawnPlayer(<uint>1, 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var member = state.spawnPlayer(<uint>1, 10, 1.0, 1.5, 0.0, 100, 7.0, 1);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var mob = state.spawnMob(forestWolf, 1, 2.0, 1.5, 0.0, 20, 8.0);
    if (leader == <uint>0 || member == <uint>0 || mob == <uint>0) { return -1; }
    var payloads = %import("protocol/command_payloads");
    var formation = new CommandBatch();
    appendPartyTargetCommand(
        formation, payloads.partyInviteCommandId(true), leader, <uint>1, <uint>1, member
    );
    appendEmptyCommand(
        formation, payloads.partyAcceptCommandId(true), member, <uint>1, <uint>1
    );
    state.applyCommands(formation, 1);

    var setMarker = new CommandBatch();
    appendPartyMarkerCommandForTest(
        setMarker, true, leader, <uint>1, <uint>2, mob, <uint>0
    );
    state.applyCommands(setMarker, 1);
    var markerState = restorePartyMarkerState(state);
    if (state.partyMarkerPartyIds.length != 1 ||
        <uint>state.partyMarkerPartyIds[0] != <uint>1 ||
        <uint>state.partyMarkerEntityIds[0] != mob ||
        <uint>state.partyMarkerSymbols[0] != <uint>0 ||
        targetingMarkers.markerFor(markerState, 2, <int>mob) != 0) {
        return -2;
    }
    var restored = decodeState(encodeState(state));
    markerState = restorePartyMarkerState(restored);
    if (targetingMarkers.markerFor(markerState, 1, <int>mob) != 0 ||
        targetingMarkers.markerFor(markerState, 2, <int>mob) != 0) {
        return -3;
    }

    var toggle = new CommandBatch();
    appendPartyMarkerCommandForTest(
        toggle, true, leader, <uint>1, <uint>3, mob, <uint>0
    );
    restored.applyCommands(toggle, 1);
    if (restored.partyMarkerPartyIds.length != 0) { return -4; }
    var setByMember = new CommandBatch();
    appendPartyMarkerCommandForTest(
        setByMember, true, member, <uint>1, <uint>2, mob, <uint>1
    );
    restored.applyCommands(setByMember, 1);
    var clearMarker = new CommandBatch();
    appendPartyMarkerCommandForTest(
        clearMarker, false, leader, <uint>1, <uint>4, mob, <uint>0
    );
    restored.applyCommands(clearMarker, 1);
    if (restored.partyMarkerPartyIds.length != 0) { return -5; }

    var markForDeath = new CommandBatch();
    appendPartyMarkerCommandForTest(
        markForDeath, true, leader, <uint>1, <uint>5, mob, <uint>2
    );
    restored.applyCommands(markForDeath, 1);
    restored.entityDead[2] = true;
    clearDeadCasting(restored);
    if (restored.partyMarkerPartyIds.length != 0) { return -6; }

    var secondMob = restored.spawnMob(forestWolf, 1, 3.0, 1.5, 0.0, 20, 8.0);
    var markBeforeDisband = new CommandBatch();
    appendPartyMarkerCommandForTest(
        markBeforeDisband, true, leader, <uint>1, <uint>6, secondMob, <uint>3
    );
    restored.applyCommands(markBeforeDisband, 1);
    var leave = new CommandBatch();
    appendEmptyCommand(
        leave, payloads.partyLeaveCommandId(true), member, <uint>1, <uint>3
    );
    restored.applyCommands(leave, 1);
    return restored.partyMarkerPartyIds.length == 0 &&
        <uint>restored.entityPartyIds[0] == <uint>0 &&
        <uint>restored.entityPartyIds[1] == <uint>0 &&
        <uint>restored.entityLastCommandSequence[0] == <uint>6 &&
        <uint>restored.entityLastCommandSequence[1] == <uint>3 ? 1 : -7;
}

