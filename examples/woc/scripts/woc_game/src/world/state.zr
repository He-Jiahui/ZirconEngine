applySupportedCastAtCommand(
    state: WorldState,
    casterIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>20 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc castAt payload is truncated";
    }
    var abilityLength = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (abilityLength > <uint>256 || payloadLength != abilityLength + <uint>20) {
        throw "woc castAt ability payload is invalid";
    }
    var abilityOffset = payloadOffset + <uint>4;
    var isRainOfFire = rainOfFirePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength);
    var isHurricane = hurricanePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength);
    if (!isRainOfFire && !isHurricane) {
        throw "woc castAt ability reducer is not implemented";
    }
    var castAtAbilityCode = isRainOfFire ? rainOfFireAbilityCode() : hurricaneAbilityCode();
    if (!offlineCastSchoolLockoutAllows(state, casterIndex, castAtAbilityCode)) { return; }
    var aimOffset = abilityOffset + abilityLength;
    var aimX = binary.readF64LeAt(payloadBytes, aimOffset, <uint>8);
    var aimZ = binary.readF64LeAt(payloadBytes, aimOffset + <uint>8, <uint>8);
    if (isRainOfFire) { startOfflineRainOfFireCast(state, casterIndex, aimX, aimZ); }
    else { startOfflineHurricaneCast(state, casterIndex, aimX, aimZ); }
}

applySupportedCastCommand(
    state: WorldState,
    casterIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>5 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc cast payload is truncated";
    }
    var abilityLength = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (abilityLength > <uint>256 || payloadLength < <uint>5 + abilityLength) {
        throw "woc cast ability identifier is invalid";
    }
    var abilityOffset = payloadOffset + <uint>4;
    var targetPresenceOffset = abilityOffset + abilityLength;
    var targetPresence = <uint>payloadBytes[<int>targetPresenceOffset];
    if (targetPresence > <uint>1 ||
        payloadLength != abilityLength + (targetPresence == <uint>1 ? <uint>13 : <uint>5)) {
        throw "woc cast target payload is invalid";
    }
    var typedAbilityCode = m4AbilityCodeFromPayload(
        payloadBytes, abilityOffset, abilityLength
    );
    if (typedAbilityCode != <uint>0 &&
        !offlineCastSchoolLockoutAllows(state, casterIndex, typedAbilityCode)) {
        return;
    }
    if (rainOfFirePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineRainOfFireCast(
            state,
            casterIndex,
            <float>state.entityX[casterIndex],
            <float>state.entityZ[casterIndex]
        );
        return;
    }
    if (hurricanePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineHurricaneCast(state, casterIndex,
            <float>state.entityX[casterIndex], <float>state.entityZ[casterIndex]);
        return;
    }
    if (temporalReversalPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var targetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startTemporalReversalCast(state, casterIndex, targetId);
        return;
    }
    var queuedAbilityCode = queuedOnSwingPayloadAbilityCode(
        payloadBytes, abilityOffset, abilityLength
    );
    if (queuedAbilityCode != <uint>0) {
        startQueuedOnSwingCast(state, casterIndex, queuedAbilityCode);
        return;
    }
    if (sealOfRighteousnessPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineSealOfRighteousnessCast(state, casterIndex);
        return;
    }
    if (flametongueWeaponPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineFlametongueWeaponCast(state, casterIndex);
        return;
    }
    if (frostbrandWeaponPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineFrostbrandWeaponCast(state, casterIndex);
        return;
    }
    if (ghostWolfPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineGhostWolfCast(state, casterIndex);
        return;
    }
    if (stormstrikePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var stormstrikeTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineStormstrikeCast(state, casterIndex, stormstrikeTargetId);
        return;
    }
    if (judgementPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var judgementTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineJudgementCast(state, casterIndex, judgementTargetId);
        return;
    }
    if (summonImpPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineSummonImpCast(state, casterIndex);
        return;
    }
    if (consecrationPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineConsecrationCast(state, casterIndex);
        return;
    }
    if (arcaneExplosionPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineArcaneExplosionCast(state, casterIndex);
        return;
    }
    if (frostboltPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var frostboltTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineFrostboltCast(state, casterIndex, frostboltTargetId);
        return;
    }
    if (smitePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var smiteTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineSmiteCast(state, casterIndex, smiteTargetId);
        return;
    }
    if (mindBlastPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var mindBlastTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineMindBlastCast(state, casterIndex, mindBlastTargetId);
        return;
    }
    if (shadowBoltPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var shadowBoltTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineShadowBoltCast(state, casterIndex, shadowBoltTargetId);
        return;
    }
    if (wrathPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var wrathTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineWrathCast(state, casterIndex, wrathTargetId);
        return;
    }
    if (starfirePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var starfireTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineStarfireCast(state, casterIndex, starfireTargetId);
        return;
    }
    if (entanglingRootsPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var entanglingRootsTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineEntanglingRootsCast(state, casterIndex, entanglingRootsTargetId);
        return;
    }
    if (searingPainPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        var searingPainTargetId = targetPresence == <uint>1 ?
            readPayloadU64(payloadBytes, targetPresenceOffset + <uint>1) :
            <uint>state.entityTargetIds[casterIndex];
        startOfflineSearingPainCast(state, casterIndex, searingPainTargetId);
