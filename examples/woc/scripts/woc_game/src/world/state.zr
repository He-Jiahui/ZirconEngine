// WOS v17 keeps the opaque Card Duel service state bounded so an untrusted
// authoritative-state payload cannot allocate without limit during restore.
var CARD_DUEL_SNAPSHOT_MAX_BYTES: uint = <uint>16777216;
// The offline MVP has source-pinned Hunter and caster-wand profiles. Bound this
// untrusted snapshot tail while still preserving every realistic projectile in
// its three-second source flight window.
var OFFLINE_PROJECTILE_PENDING_MAX: uint = <uint>64;
var OFFLINE_DOT_PENDING_MAX: uint = <uint>64;
// Charge records are an independently serialized pending-state collection.
// Keep its corruption bound aligned with the existing projectile queue cap.
var OFFLINE_ABILITY_CHARGE_PENDING_MAX: uint = <uint>64;
// Rewind aggregates real player HP loss by (player, tick). A source raid has
// at most forty players and the source ring spans one hundred fixed ticks.
var OFFLINE_REWIND_DAMAGE_PENDING_MAX: uint = <uint>4096;
// A forty-player raid can have every player contribute Nature's Fury to every
// party member. The source aura key is (target, source), so retain 40 * 40
// rows rather than silently dropping a valid stacked source aura.
var OFFLINE_NATURES_FURY_PENDING_MAX: uint = <uint>1600;
var OFFLINE_PERIODIC_TICK_EPS: float = 0.000001;
var OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS: float = 1.5;
var OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS: float = 0.75;
var OFFLINE_SOURCE_TARGET_FACING_HALF_ARC: float = 2.2;
var OFFLINE_OVERFLOWING_POWER_CAP_SECONDS: float = 10.0;
var OFFLINE_OVERFLOWING_POWER_CAP_WINDOW_SECONDS: float = 30.0;
var OFFLINE_OVERLOAD_COST_MULTIPLIER: float = 1.5;
var OFFLINE_PROJECTILE_SCHOOL_PHYSICAL: uint = <uint>0;
var OFFLINE_PROJECTILE_SCHOOL_ARCANE: uint = <uint>1;
var OFFLINE_PROJECTILE_SCHOOL_HOLY: uint = <uint>2;
var OFFLINE_PROJECTILE_SCHOOL_SHADOW: uint = <uint>3;
var OFFLINE_PROJECTILE_SCHOOL_NATURE: uint = <uint>4;
var OFFLINE_PROJECTILE_SCHOOL_FROST: uint = <uint>5;
var OFFLINE_PROJECTILE_SCHOOL_FIRE: uint = <uint>6;
// This code is outside the camp table by design: summoned demons are not
// overworld camp templates, but their ordinary entity rows remain WOS-owned.
var OFFLINE_EMBERKIN_TEMPLATE_CODE: uint = <uint>48;
var OFFLINE_EMBERKIN_HP_BASE: int = 30;
var OFFLINE_EMBERKIN_HP_PER_LEVEL: int = 12;
var OFFLINE_EMBERKIN_MOVE_SPEED: float = 5.2;
var OFFLINE_EMBERKIN_DEMON_CORPSE_MICROS: uint = <uint>3000000;
var OFFLINE_EMBERKIN_PRESENTATION_SCALE: float = 0.55;
var OFFLINE_EMBERKIN_PRESENTATION_COLOR: uint = <uint>16742954;

// State-owned projection of the decoded batch. The WOS codec, retained movement
// columns and candidate mutation stay together because the experimental ZrVM
// cross-module Array ABI cannot yet safely carry these parallel mutable columns.
class CommandBatch {
    pub var commandCount: int;
    pub var commandIds: container.Array<uint>;
    pub var commandActorIds: container.Array<uint>;
    pub var commandActorGenerations: container.Array<uint>;
    pub var commandSequences: container.Array<uint>;
    pub var commandPayloadOffsets: container.Array<uint>;
    pub var commandPayloadLengths: container.Array<uint>;
    pub var commandPayloadBytes: container.Array<uint>;

    pub @constructor() {
        this.commandCount = 0;
        this.commandIds = new container.Array<uint>();
        this.commandActorIds = new container.Array<uint>();
        this.commandActorGenerations = new container.Array<uint>();
        this.commandSequences = new container.Array<uint>();
        this.commandPayloadOffsets = new container.Array<uint>();
        this.commandPayloadLengths = new container.Array<uint>();
        this.commandPayloadBytes = new container.Array<uint>();
    }
}

class OfflineBootstrap {
    pub var launchVersion: uint;
    pub var worldSeed: uint;
    pub var playerClass: uint;
    pub var playerName: container.Array<uint>;
    pub var skinVariant: uint;
    pub var weaponSkinOwned: container.Array<bool>;
    pub var weaponSkinLoadoutCodes: container.Array<uint>;

    pub @constructor() {
        this.launchVersion = <uint>0;
        this.worldSeed = <uint>0;
        this.playerClass = <uint>0;
        this.playerName = new container.Array<uint>();
        this.skinVariant = <uint>0;
        this.weaponSkinOwned = new container.Array<bool>();
        var ownedIndex = 0;
        while (ownedIndex < weaponSkinContract.weaponSkinCount()) {
            this.weaponSkinOwned.add(false);
            ownedIndex = ownedIndex + 1;
        }
        this.weaponSkinLoadoutCodes = new container.Array<uint>();
        var typeIndex = 0;
        while (typeIndex < weaponSkinContract.weaponSkinTypeCount()) {
            this.weaponSkinLoadoutCodes.add(<uint>0);
            typeIndex = typeIndex + 1;
        }
    }
}

class WorldState {
    pub var tick: uint;
    pub var timeMicros: uint;
    pub var nextEntityId: uint;
    pub var generation: uint;
    pub var rngState: uint;
    pub var rngDraws: uint;
    pub var rngDigest: uint;
    // Offline WOC worlds begin from the pinned target seed. Realm creation may
    // supply another seed later, but the committed state—not host wall time—is
    // the authority once a transaction exists.
    pub var worldSeed: uint;
    pub var offlineSessionActive: bool;
    pub var offlinePlayerClass: uint;
    pub var offlinePlayerName: container.Array<uint>;
    pub var offlinePlayerSkinVariant: uint;
    // Session-only offline characters have one authoritative player. Keep its
    // quest ledger beside the WOS codec until the VM can carry a mutable,
    // per-player inventory/quest aggregate across module boundaries.
    pub var offlineQuestBoarsState: uint;
    pub var offlineQuestWolvesState: uint;
    pub var offlineQuestBoarsObjectiveCount: uint;
    pub var offlineQuestWolvesObjectiveCount: uint;
    pub var offlineQuestBoarHideCount: uint;
    pub var offlineQuestCopper: uint;
    pub var offlineQuestExperience: uint;
    pub var offlineQuestLifetimeExperience: uint;
    // WOS74 retains the single offline player's source gathering ledger.
    // Codes follow the generated profession/node/item/rarity orders.
    pub var offlineGatheringProficiencies: container.Array<uint>;
    pub var offlinePendingGatheringGains: container.Array<uint>;
    pub var offlineGatherNodeReadyAtMicros: container.Array<uint>;
    pub var offlineGatherVisitedMask: uint;
    pub var offlineGatherResultSequence: uint;
    pub var offlineGatherResultNodeCode: uint;
    pub var offlineGatherResultProfessionCode: uint;
    pub var offlineGatherResultItemCode: uint;
    pub var offlineGatherResultRarityCode: uint;
    // WOS75 retains PlayerMeta.deedsEarned and activeTitle. Deed codes are
    // one-based generated catalog indexes; zero is the nullable active title.
    pub var offlineDeedsEarned: container.Array<bool>;
    pub var offlineActiveTitleDeedCode: uint;
    // WOS81 closes the source addItem discovery side effect for the single
    // offline profile. Entries follow the generated M5 item catalog order.
    pub var offlineM5ItemsDiscovered: container.Array<bool>;
    // WOS82 retains the source account-wide mech chroma set in generated
    // MECH_CHROMAS order. Every live player row shares this ownership set.
    pub var offlineMechChromaOwned: container.Array<bool>;
    // WOS83 retains account-wide weapon-skin ownership plus one nullable
    // selected skin code for each generated weapon type.
    pub var offlineWeaponSkinOwned: container.Array<bool>;
    pub var offlineWeaponSkinLoadoutCodes: container.Array<uint>;
    // WOS76 preserves PlayerMeta.townFocus as ordered UTF-8 key spans and
    // positive point values. The byte form is lossless while the VM lacks a
    // dynamic UTF-8-to-string decoder.
    pub var offlineTownFocusComponentBytes: container.Array<uint>;
    pub var offlineTownFocusComponentOffsets: container.Array<uint>;
    pub var offlineTownFocusPoints: container.Array<int>;
    // WOS77 closes the bounded minor-healing-potion craft transaction. The
    // recipe bytes preserve unknown source ids losslessly without requiring a
    // VM string decoder; rolled item instances remain a notified Plugins08 gap.
    pub var offlineCraftAlchemySkill: uint;
    pub var offlineCraftThrottleWindowStartMicros: uint;
    pub var offlineCraftThrottleCount: uint;
    pub var offlineCraftsPerformed: uint;
    pub var offlineCraftResultSequence: uint;
    pub var offlineCraftResultRecipeBytes: container.Array<uint>;
    pub var offlineCraftResultReasonCode: uint;
    pub var offlineCraftResultItemCode: uint;
    pub var offlineCraftResultCount: uint;
    pub var offlineCraftResultQualityCode: uint;
    pub var offlineCraftResultMasterwork: bool;
    // WOS56 owns the launch-order pending projectile queue. The primitive
    // payload mirrors the source closure capture; actor/target combat stats
    // stay live and are read only at landing.
    pub var offlineProjectileSourceIds: container.Array<uint>;
    pub var offlineProjectileTargetIds: container.Array<uint>;
    pub var offlineProjectileX: container.Array<float>;
    pub var offlineProjectileZ: container.Array<float>;
    pub var offlineProjectileTtls: container.Array<float>;
    pub var offlineProjectileWands: container.Array<bool>;
    pub var offlineProjectileSchoolCodes: container.Array<uint>;
    pub var offlineProjectileMinimums: container.Array<float>;
    pub var offlineProjectileMaximums: container.Array<float>;
    pub var offlineProjectileSpeeds: container.Array<float>;
    pub var offlineProjectileAbilityCodes: container.Array<uint>;
    pub var offlineProjectileRanks: container.Array<uint>;
    pub var offlineProjectileCastTimes: container.Array<float>;
    // Direct-damage projectiles retain the source talent selection that
    // produced their resolved endpoints. Current player selections can change
    // during flight, so decode must never re-evaluate the live allocation.
    pub var offlineProjectileTalentSpecCodes: container.Array<uint>;
    pub var offlineProjectileTalentRowOptionCodes: container.Array<uint>;
    // WOS190 captures a fire spell's source-transformed periodic total at
    // launch. Landing cannot consult Overload because the one-shot aura has
    // already been consumed by then.
    pub var offlineProjectileDotTotals: container.Array<float>;
    // A Power Echo copy has an already-resolved damage amount. Keeping it out
    // of the min/max range prevents its landing from consuming another RNG draw.
    pub var offlineProjectileFixedDamages: container.Array<int>;
    // Preserve the primary spell's critical result for a fixed copied impact.
    pub var offlineProjectileCriticals: container.Array<bool>;
    // Source critvuln auras are target/source keyed, and only their largest
    // active value affects a hostile critical spell impact.
    pub var offlineCritVulnTargetIds: container.Array<uint>;
    pub var offlineCritVulnSourceIds: container.Array<uint>;
    pub var offlineCritVulnValues: container.Array<float>;
    pub var offlineCritVulnRemaining: container.Array<float>;
    // Temporal Echo keeps one movable friendly mark per source caster.
    pub var offlineTemporalEchoTargetIds: container.Array<uint>;
    pub var offlineTemporalEchoSourceIds: container.Array<uint>;
    pub var offlineTemporalEchoRemaining: container.Array<float>;
    pub var offlineTemporalEchoGroups: container.Array<bool>;
    pub var offlineTemporalEchoConvertRates: container.Array<float>;
    // Rewind retains real player HP loss across VM snapshot boundaries. Rows
    // are aggregated by target and source simulation tick, preserving the
    // source damage-history sum while bounding the snapshot tail.
    pub var offlineRewindDamageTargetIds: container.Array<uint>;
    pub var offlineRewindDamageTicks: container.Array<uint>;
    pub var offlineRewindDamageAmounts: container.Array<int>;
    // Nature's Fury is a source-keyed spell-crit aura. It deliberately stays
    // separate from derived crit so ordinary stat recalculation cannot erase
    // its short refreshed window.
    pub var offlineNaturesFuryTargetIds: container.Array<uint>;
    pub var offlineNaturesFurySourceIds: container.Array<uint>;
    pub var offlineNaturesFuryValues: container.Array<float>;
    pub var offlineNaturesFuryRemaining: container.Array<float>;
    // WOS57 stores only source Aura fields required by retained hostile-spell
    // DoT closures. WOS63 adds application-time rank and selected-power rows
    // for pure projectile DoTs; WOS108 retains the source-resolved total and
    // launch talent selection required to verify talent-scaled profiles.
    pub var offlineDotTargetIds: container.Array<uint>;
    pub var offlineDotSourceIds: container.Array<uint>;
    pub var offlineDotAbilityCodes: container.Array<uint>;
    pub var offlineDotDamages: container.Array<int>;
    pub var offlineDotRanks: container.Array<uint>;
    pub var offlineDotSnapshotPowers: container.Array<int>;
    pub var offlineDotResolvedTotals: container.Array<int>;
    pub var offlineDotTalentSpecCodes: container.Array<uint>;
    pub var offlineDotTalentRowOptionCodes: container.Array<uint>;
    pub var offlineDotRemaining: container.Array<float>;
    pub var offlineDotDurations: container.Array<float>;
    pub var offlineDotTickIntervals: container.Array<float>;
    pub var offlineDotTickTimers: container.Array<float>;
    // WOS60 is the retained friendly periodic-heal closure. WOS64 appends
    // source rank and selected spell power so new pure HoTs survive reload
    // without reconstructing from later gear.
    pub var offlineHotTargetIds: container.Array<uint>;
    pub var offlineHotSourceIds: container.Array<uint>;
    pub var offlineHotAbilityCodes: container.Array<uint>;
    pub var offlineHotHeals: container.Array<int>;
    pub var offlineHotRanks: container.Array<uint>;
    pub var offlineHotSnapshotPowers: container.Array<int>;
    pub var offlineHotRemaining: container.Array<float>;
    pub var offlineHotDurations: container.Array<float>;
    pub var offlineHotTickIntervals: container.Array<float>;
    pub var offlineHotTickTimers: container.Array<float>;
    // WOS65 is the bounded source-order absorb queue used by the retained
    // Power Word Shield closure. The array order is aura application order.
    pub var offlineAbsorbTargetIds: container.Array<uint>;
    pub var offlineAbsorbSourceIds: container.Array<uint>;
    pub var offlineAbsorbAbilityCodes: container.Array<uint>;
    pub var offlineAbsorbRanks: container.Array<uint>;
    pub var offlineAbsorbAmounts: container.Array<int>;
    pub var offlineAbsorbRemaining: container.Array<float>;
    pub var offlineAbsorbResolvedInitialAmounts: container.Array<int>;
    pub var offlineAbsorbTalentSpecCodes: container.Array<uint>;
    pub var offlineAbsorbTalentRowOptionCodes: container.Array<uint>;
    // WOS61 owns retained Consecration ground-effect closures. The spell-power
    // bonus is captured when the zone is created, as in the source GroundAoE.
    pub var offlineGroundEffectSourceIds: container.Array<uint>;
    pub var offlineGroundEffectAbilityCodes: container.Array<uint>;
    pub var offlineGroundEffectX: container.Array<float>;
    pub var offlineGroundEffectZ: container.Array<float>;
    pub var offlineGroundEffectRadii: container.Array<float>;
    pub var offlineGroundEffectMinimums: container.Array<float>;
    pub var offlineGroundEffectMaximums: container.Array<float>;
    pub var offlineGroundEffectSpellPowerBonuses: container.Array<float>;
    pub var offlineGroundEffectRemaining: container.Array<float>;
    pub var offlineGroundEffectIntervals: container.Array<float>;
    pub var offlineGroundEffectTickTimers: container.Array<float>;
    // WOS242 keeps Hunter traps separate from Consecration's damage-only
    // closure while preserving the source GroundAoE rider's bounded facts.
    pub var offlineHunterTrapSourceIds: container.Array<uint>;
    pub var offlineHunterTrapAbilityCodes: container.Array<uint>;
    pub var offlineHunterTrapX: container.Array<float>;
    pub var offlineHunterTrapZ: container.Array<float>;
    pub var offlineHunterTrapRadii: container.Array<float>;
    pub var offlineHunterTrapRemaining: container.Array<float>;
    pub var offlineHunterTrapArmRemaining: container.Array<float>;
    pub var offlineHunterTrapFreezeDurations: container.Array<float>;
    // WOS244 retains the source procState counter for Lean Quiver even while
    // its selection is temporarily inactive, matching source proc-state life.
    pub var offlineLeanQuiverEntityIds: container.Array<uint>;
    pub var offlineLeanQuiverCounters: container.Array<int>;
    // WOS245 retains Redline Draw's independent castNth counter and ICD even
    // while its selection is temporarily inactive, as source procState does.
    pub var offlineRedlineDrawEntityIds: container.Array<uint>;
    pub var offlineRedlineDrawCounters: container.Array<int>;
    pub var offlineRedlineDrawIcdRemaining: container.Array<float>;
    // WOS246 retains Deathless Will's source ICD while its selection is
    // temporarily inactive; bigHitTaken has no counter state.
    pub var offlineDeathlessWillEntityIds: container.Array<uint>;
    pub var offlineDeathlessWillIcdRemaining: container.Array<float>;
    // Hourglass zones are non-damaging first-contact selectors. Unlike the
    // generic Consecration rows, their captured profile decides ally rescue
    // versus hostile suspension at contact time.
    pub var offlineTemporalHourglassSourceIds: container.Array<uint>;
    pub var offlineTemporalHourglassX: container.Array<float>;
    pub var offlineTemporalHourglassZ: container.Array<float>;
    pub var offlineTemporalHourglassRadii: container.Array<float>;
    pub var offlineTemporalHourglassRemaining: container.Array<float>;
    pub var offlineTemporalHourglassProtectiveDurations: container.Array<float>;
    pub var offlineTemporalHourglassHostilePveDurations: container.Array<float>;
    pub var offlineTemporalHourglassHostilePvpDurations: container.Array<float>;
    pub var offlineTemporalHourglassHealFractions: container.Array<float>;
    pub var offlineTemporalHourglassSelfCooldownRates: container.Array<float>;
    pub var offlineTemporalHourglassAllyCooldownRates: container.Array<float>;
    pub var offlineTemporalHourglassCreatedTicks: container.Array<uint>;
    // WOS11 keeps the source SavedLoadout projection for the single offline
    // player. Names stay raw bounded bytes; code catalogs avoid strings
    // in authoritative allocation and action-bar partitions.
    pub var offlineTalentLoadoutNameOffsets: container.Array<uint>;
    pub var offlineTalentLoadoutNameBytes: container.Array<uint>;
    pub var offlineTalentLoadoutSpecCodes: container.Array<uint>;
    pub var offlineTalentLoadoutRowOptionCodes: container.Array<uint>;
    pub var offlineTalentLoadoutActionBarAbilityCodes: container.Array<uint>;
    pub var offlineTalentActiveLoadoutIndex: int;
    pub var entityIds: container.Array<uint>;
    pub var entityGenerations: container.Array<uint>;
    pub var entityKinds: container.Array<uint>;
    pub var entityTemplates: container.Array<uint>;
    pub var entityLevels: container.Array<int>;
    pub var entityX: container.Array<float>;
    pub var entityY: container.Array<float>;
    pub var entityZ: container.Array<float>;
    pub var entityPreviousX: container.Array<float>;
    pub var entityPreviousY: container.Array<float>;
    pub var entityPreviousZ: container.Array<float>;
    pub var entityFacing: container.Array<float>;
    pub var entityPreviousFacing: container.Array<float>;
    pub var entityVelocityX: container.Array<float>;
    pub var entityVelocityY: container.Array<float>;
    pub var entityVelocityZ: container.Array<float>;
    pub var entityOnGround: container.Array<bool>;
    pub var entityJumping: container.Array<bool>;
    pub var entityFallStartY: container.Array<float>;
    pub var entitySpawnX: container.Array<float>;
    pub var entitySpawnY: container.Array<float>;
    pub var entitySpawnZ: container.Array<float>;
    pub var entityMoveSpeed: container.Array<float>;
    pub var entityHp: container.Array<int>;
    pub var entityMaxHp: container.Array<int>;
    pub var entityHostile: container.Array<bool>;
