// The source's shared GCD starts from 1.5 seconds, uses the common spell-haste
// multiplier even for this physical strike, and floors at 0.75 seconds.
stormstrikeGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    return lightningBoltGlobalCooldownSeconds(state, casterIndex);
}

startOfflineStormstrikeCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = stormstrikeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("stormstrike");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var targetIndex = stormstrikeTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "weaponStrike") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<int>state.entityResources[casterIndex] < cost) { return; }

    // Source instant casts arm the shared GCD before applyAbility bills and
    // invokes the deterministic weapon-strike reducer.
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = stormstrikeGlobalCooldownSeconds(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );

    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, casterIndex, targetIndex, actor);
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    if (offlineMobTemplateId(state, targetIndex) == "wild_boar") {
        target.spikedHideDamage = 2;
    }
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(
        events, state.rngState, state.rngDraws, state.rngDigest, true
    );
    autoAttackState.meleeSwing(
        actor,
        target,
        m4AbilityEffects.metric(abilityIndex, rank, 0, "bonus"),
        m4AbilityCatalog.text(abilityIndex, "name"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatMult"),
        false,
        1.0,
        events
    );
    commitOfflineAutoAttackRng(state, events);
    commitOfflineAutoActor(state, casterIndex, actor);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage);
    }
    state.entityInCombat[targetIndex] = target.inCombat;
    // meleeSwing enters combat even on a miss or dodge. The source's
    // enterCombat owns idle social aggro and only backfills a missing target
    // for an already active mob, so retain that distinction here.
    if (target.hp > 0) {
        var casterId = <uint>state.entityIds[casterIndex];
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        if (events.lastDamage > 0) {
            state.setThreat(
                <uint>state.entityIds[targetIndex],
                casterId,
                stateThreatValue(state, targetIndex, casterId) +
                    <float>events.lastDamage * events.lastThreatMultiplier +
                    events.lastThreatFlat,
                1
            );
        }
    }
    if (target.hp <= 0) {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
    if (actor.dead || actor.hp <= 0) {
        applyOfflineMobMeleePlayerDeath(state, casterIndex);
    } else {
        state.entityHp[casterIndex] = actor.hp;
    }
}

eviscerateAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("eviscerate");
    var abilityIndex = m4AbilityCatalog.indexOf("eviscerate");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "eviscerate") {
        throw "Eviscerate is absent from the current ability catalog";
    }
    return code;
}

evisceratePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>10 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>118 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>101;
}

eviscerateTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("eviscerate");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    if (range <= 0.0) { range = 5.0; }
    // The retained Eastbrook rows have no static occluder state; its source
    // outdoor encounter subset therefore has a trivially clear line of sight.
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

eviscerateGlobalCooldownSeconds(): float { return 1.0; }

startOfflineEviscerateCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = eviscerateAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("eviscerate");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        <int>state.entityComboPoints[casterIndex] <= 0) {
        return;
    }
    var targetIndex = eviscerateTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "finisherDamage") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<int>state.entityResources[casterIndex] < cost) { return; }

    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = eviscerateGlobalCooldownSeconds();
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;

    var spentCombo = <int>state.entityComboPoints[casterIndex];
    var damage = m4AbilityEffects.metric(abilityIndex, rank, 0, "base") +
        m4AbilityEffects.metric(abilityIndex, rank, 0, "perCombo") * <float>spentCombo +
        nextAuthoritativeRandomUnit(state) *
            m4AbilityEffects.metric(abilityIndex, rank, 0, "variance") +
        effectiveOfflineAttackPower(state, casterIndex) / 14.0;
    var crit = nextAuthoritativeRandomUnit(state) < <float>state.entityCritChance[casterIndex];
    if (crit) {
        damage = damage * (2.0 + <float>state.entityCritDamagePhysicalBonus[casterIndex]);
    }
    damage = damage * (1.0 - mobSwing.armorReductionFromArmor(
        effectiveOfflineArmor(state, targetIndex), level, true
    ));
    var roundedDamage = terrainGradient.javascriptRound(damage, true);
    if (roundedDamage < 0) { roundedDamage = 0; }
    var hp = <int>state.entityHp[targetIndex] - roundedDamage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    if (roundedDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, roundedDamage);
    }
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    var casterId = <uint>state.entityIds[casterIndex];
    if (hp > 0) {
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            casterId,
            stateThreatValue(state, targetIndex, casterId) +
                <float>roundedDamage *
                    m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    }
    if (hp <= 0) {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
    // runEffects clears spentCombo after every effect (and after a lethal
    // dealDamage branch), but retains comboUntil's historical timestamp.
    state.entityComboPoints[casterIndex] = 0;
}

kidneyShotAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("kidney_shot");
    var abilityIndex = m4AbilityCatalog.indexOf("kidney_shot");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "kidney_shot") {
        throw "Kidney Shot is absent from the current ability catalog";
    }
    return code;
}

kidneyShotPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>11 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>107 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>100 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>121 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>116;
}

kidneyShotTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("kidney_shot");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    if (range <= 0.0) { range = 5.0; }
    // The retained Eastbrook rows have no static occluder state; its source
    // outdoor encounter subset therefore has a trivially clear line of sight.
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

kidneyShotGlobalCooldownSeconds(): float { return 1.0; }

startOfflineKidneyShotCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = kidneyShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("kidney_shot");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        <int>state.entityComboPoints[casterIndex] <= 0) {
        return;
    }
    var targetIndex = kidneyShotTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "finisherStun") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<int>state.entityResources[casterIndex] < cost) { return; }

    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = kidneyShotGlobalCooldownSeconds();
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;

    var spentCombo = <int>state.entityComboPoints[casterIndex];
    var duration = m4AbilityEffects.metric(abilityIndex, rank, 0, "base") +
        m4AbilityEffects.metric(abilityIndex, rank, 0, "perCombo") * <float>spentCombo;
    var casterId = <uint>state.entityIds[casterIndex];
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
        enterIdleMobAggro(state, targetIndex, casterId);
    } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
        state.entityAggroTargetIds[targetIndex] = casterId;
    }
    // The retained Eastbrook subset has no prior stun-DR history. Its first
    // source category application therefore keeps the full generated duration.
    applyOfflineKidneyShotStun(state, targetIndex, casterId, duration);
    // runEffects clears the spent points after all effects but leaves comboUntil
    // untouched, matching the source character-bound combo timestamp.
    clearOfflineComboPoints(state, casterIndex);
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
}

gougeAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("gouge");
    var abilityIndex = m4AbilityCatalog.indexOf("gouge");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "gouge") {
        throw "Gouge is absent from the current ability catalog";
    }
    return code;
}

gougePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>5 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>103 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>103 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>101;
}

gougeTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("gouge");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    if (range <= 0.0) { range = 5.0; }
    // The retained Eastbrook rows have no static occluder state; its source
    // outdoor encounter subset therefore has a trivially clear line of sight.
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

gougeGlobalCooldownSeconds(): float { return 1.0; }

startOfflineGougeCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = gougeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("gouge");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var targetIndex = gougeTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 1) != "incapacitate") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<int>state.entityResources[casterIndex] < cost) { return; }

    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = gougeGlobalCooldownSeconds();
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;

    var damage = m4AbilityEffects.metric(abilityIndex, rank, 0, "min") +
        nextAuthoritativeRandomUnit(state) * (
            m4AbilityEffects.metric(abilityIndex, rank, 0, "max") -
            m4AbilityEffects.metric(abilityIndex, rank, 0, "min")
        );
    var crit = nextAuthoritativeRandomUnit(state) < <float>state.entityCritChance[casterIndex];
    if (crit) {
        damage = damage * (2.0 + <float>state.entityCritDamagePhysicalBonus[casterIndex]);
    }
    damage = damage * (1.0 - mobSwing.armorReductionFromArmor(
        effectiveOfflineArmor(state, targetIndex), level, true
    ));
    var roundedDamage = terrainGradient.javascriptRound(damage, true);
    if (roundedDamage < 0) { roundedDamage = 0; }
    var hp = <int>state.entityHp[targetIndex] - roundedDamage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    if (roundedDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, roundedDamage);
    }
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    var casterId = <uint>state.entityIds[casterIndex];
    if (hp > 0) {
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            casterId,
            stateThreatValue(state, targetIndex, casterId) +
                <float>roundedDamage *
                    m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
        applyOfflineGougeIncapacitate(
            state,
            targetIndex,
            casterId,
            m4AbilityEffects.metric(abilityIndex, rank, 1, "duration")
        );
        var awarded = <int>m4AbilityCatalog.metric(abilityIndex, level, "awardsCombo");
        var comboPoints = <int>state.entityComboPoints[casterIndex] + awarded;
        state.entityComboPoints[casterIndex] = comboPoints > 5 ? 5 : comboPoints;
        state.entityComboUntil[casterIndex] = <float>state.timeMicros / 1000000.0 + 30.0;
    }
    if (hp <= 0) {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
}

backstabAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("backstab");
    var abilityIndex = m4AbilityCatalog.indexOf("backstab");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "backstab") {
        throw "Backstab is absent from the current ability catalog";
    }
    return code;
}

backstabPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>8 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>98 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>107 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>98;
}

offlineMainhandIsDagger(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length ||
        <uint>state.entityKinds[index] != <uint>1 ||
        <uint>state.entityTemplates[index] == <uint>0) {
        return false;
    }
    return m5Equipment.mainhandIsDagger(
        <int><uint>state.entityTemplates[index] - 1,
        <int>state.entityLevels[index],
        m5EquipmentStateForRow(state, index)
    );
}

backstabTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("backstab");
    if (abilityIndex < 0) { return -1; }
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, <int>state.entityLevels[casterIndex]);
    if (rank <= 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    if (range <= 0.0) { range = 5.0; }
    var casterFacing = absoluteAngleDifference(
        math.atan2(dx, dz), <float>state.entityFacing[casterIndex]
    );
    var behindFacing = absoluteAngleDifference(
        math.atan2(-dx, -dz), <float>state.entityFacing[targetIndex]
    );
    // The retained Eastbrook rows have no static occluder state; its source
    // outdoor encounter subset therefore has a trivially clear line of sight.
    var requiresBehind = m4AbilityEffects.flag(abilityIndex, rank, 0, "requiresBehind");
    return dx * dx + dz * dz <= range * range && casterFacing <= 2.2 &&
        dx * dx + dz * dz >= 0.01 && (!requiresBehind || behindFacing >= 1.5707963267948966) ?
        targetIndex : -1;
}

backstabGlobalCooldownSeconds(): float { return 1.0; }

startOfflineBackstabCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = backstabAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("backstab");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        !offlineMainhandIsDagger(state, casterIndex)) {
        return;
    }
    var targetIndex = backstabTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "weaponStrike") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<int>state.entityResources[casterIndex] < cost) { return; }

    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = backstabGlobalCooldownSeconds();
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;

    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, casterIndex, targetIndex, actor);
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    if (offlineMobTemplateId(state, targetIndex) == "wild_boar") {
        target.spikedHideDamage = 2;
    }
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(
        events, state.rngState, state.rngDraws, state.rngDigest, true
    );
    var weaponMultiplier = m4AbilityEffects.metric(
        abilityIndex, rank, 0, "weaponMult"
    );
    var landed = autoAttackState.meleeSwing(
        actor,
        target,
        m4AbilityEffects.metric(abilityIndex, rank, 0, "bonus"),
        m4AbilityCatalog.text(abilityIndex, "name"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatMult"),
        false,
        weaponMultiplier,
        events
    );
    commitOfflineAutoAttackRng(state, events);
    commitOfflineAutoActor(state, casterIndex, actor);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage);
    }
    state.entityInCombat[targetIndex] = target.inCombat;
    if (target.hp > 0) {
        var casterId = <uint>state.entityIds[casterIndex];
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        if (events.lastDamage > 0) {
            state.setThreat(
                <uint>state.entityIds[targetIndex],
                casterId,
                stateThreatValue(state, targetIndex, casterId) +
                    <float>events.lastDamage * events.lastThreatMultiplier +
                    events.lastThreatFlat,
                1
            );
        }
    }
    if (target.hp <= 0) {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
    if (landed) {
        var awarded = <int>m4AbilityCatalog.metric(abilityIndex, level, "awardsCombo");
        var comboPoints = <int>state.entityComboPoints[casterIndex] + awarded;
        state.entityComboPoints[casterIndex] = comboPoints > 5 ? 5 : comboPoints;
        state.entityComboUntil[casterIndex] = <float>state.timeMicros / 1000000.0 + 30.0;
    }
    if (actor.dead || actor.hp <= 0) {
        applyOfflineMobMeleePlayerDeath(state, casterIndex);
    } else {
        state.entityHp[casterIndex] = actor.hp;
    }
}

// The source computes a haste-adjusted player GCD with a 1.5-second floor.
// WOS40 has no dynamic haste contribution yet, so the retained base is that
// source floor instead of coupling form transitions to another ability's data.
formGlobalCooldownSeconds(): float { return 1.5; }

completeFormCast(state: WorldState, casterIndex: int, abilityCode: uint): void {
    var form = loadFormTransitionState(state, casterIndex);
    var transition = formTransitions.applyFormCast(form, abilityCode);
    if (transition < 0) { return; }
    storeFormTransitionState(state, casterIndex, form);
    if (transition != 2 && forms.formCooldown(abilityCode) > 0.0) {
        setAbilityCooldownExpiration(
            state,
            casterIndex,
            abilityCode,
            state.timeMicros + <uint>(forms.formCooldown(abilityCode) * 1000000.0)
        );
    }
    if (forms.isTravelFormAbilityCode(abilityCode)) {
        state.entityAutoAttack[casterIndex] = false;
    }
}

// The source lets a player cancel a helpful aura on themselves, independent of
// its caster. WOC retains only these beneficial generic rows; every other
// motion-aura kind is source-classified as harmful and must remain immutable.
offlineCancelableMotionAuraKind(kind: uint, value: float): bool {
    return kind == ccContract.motionAuraKindCode("stasis") ||
        kind == ccContract.motionAuraKindCode("ice_floes") ||
        ((kind == ccContract.motionAuraKindCode("buff_speed") ||
            kind == ccContract.motionAuraKindCode("buff_armor") ||
            kind == ccContract.motionAuraKindCode("buff_dodge") ||
            kind == ccContract.motionAuraKindCode("buff_ap")) && value >= 0.0);
}

// `cancel_aura` is a `u32 utf8Length + utf8Bytes` command. Form identity has a
// catalog separate from M4, so resolve it before inspecting M4-owned aura rows.
applyOfflineCancelAuraCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>4 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc cancel_aura payload is truncated";
    }
    var auraLength = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (auraLength > <uint>256 || payloadLength != auraLength + <uint>4) {
        throw "woc cancel_aura identifier payload is invalid";
    }
    var auraOffset = payloadOffset + <uint>4;
    var formAbilityCode = forms.formAbilityCodeForExactPayload(
        payloadBytes, auraOffset, auraLength
    );
    if (formAbilityCode != <uint>0) {
        var form = loadFormTransitionState(state, actorIndex);
        if (form.activeFormAbilityCode == formAbilityCode) {
            formTransitions.clearActiveForm(form);
            storeFormTransitionState(state, actorIndex, form);
            clearOfflineProwl(state, actorIndex);
        }
        return;
    }
    var auraAbilityCode = m4AbilityCodeFromPayload(
        payloadBytes, auraOffset, auraLength
    );
    if (auraAbilityCode == <uint>0 ||
        !motionAuraStateIsValid(state, actorIndex) ||
        !motionAuraDetailsStateIsValid(state)) {
        return;
    }
    var auraIndex = <int><uint>state.entityMotionAuraOffsets[actorIndex];
    var auraEnd = <int><uint>state.entityMotionAuraOffsets[actorIndex + 1];
    while (auraIndex < auraEnd) {
        if (<uint>state.entityMotionAuraAbilityCodes[auraIndex] == auraAbilityCode &&
            <float>state.entityMotionAuraRemaining[auraIndex] > 0.0 &&
            offlineCancelableMotionAuraKind(
                <uint>state.entityMotionAuraKindCodes[auraIndex],
                <float>state.entityMotionAuraValues[auraIndex]
            )) {
            removeMotionAuraAt(state, actorIndex, auraIndex);
            return;
        }
        auraIndex = auraIndex + 1;
    }
    if (auraAbilityCode == prowlAbilityCode()) {
        clearOfflineProwl(state, actorIndex);
    }
}

startFormCast(state: WorldState, casterIndex: int, abilityCode: uint): void {
    var form = loadFormTransitionState(state, casterIndex);
    var togglingOff = form.activeFormAbilityCode == abilityCode;
    if (!formCatalogAdmission(state, casterIndex, abilityCode) ||
        <bool>state.entityDead[casterIndex] ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        (!togglingOff && abilityCooldownExpiresAt(state, casterIndex, abilityCode) >
            state.timeMicros) ||
        !formTransitions.canBeginFormCast(form, abilityCode)) {
        return;
    }
    state.entityCastTargetIds[casterIndex] = <uint>0;
    clearOfflineProwl(state, casterIndex);
    var castTime = forms.formCastTime(abilityCode);
    if (castTime > 0.0 && !togglingOff) {
        var cast = loadCastingState(state, casterIndex);
        cast.armTimed(abilityCode, castTime, formGlobalCooldownSeconds(), false);
        storeCastingState(state, casterIndex, cast);
        return;
    }
    var instantCast = loadCastingState(state, casterIndex);
    if (formGlobalCooldownSeconds() > instantCast.gcdRemaining) {
        instantCast.gcdRemaining = formGlobalCooldownSeconds();
    }
    storeCastingState(state, casterIndex, instantCast);
    completeFormCast(state, casterIndex, abilityCode);
}

startTemporalReversalCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = temporalReversalAbilityCode();
    if (!temporalReversalCatalogAdmission(state, casterIndex, abilityCode) ||
        <bool>state.entityDead[casterIndex] ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <int>state.entityResources[casterIndex] < temporalReversal.resourceCost(true) ||
        temporalReversalTargetIndex(state, casterIndex, targetId, true) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        temporalReversal.castTimeSeconds(true),
        temporalReversal.globalCooldownSeconds(true),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
}

