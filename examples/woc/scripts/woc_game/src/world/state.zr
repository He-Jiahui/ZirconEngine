completeTemporalReversalCast(state: WorldState, casterIndex: int): void {
    var abilityCode = temporalReversalAbilityCode();
    var targetIndex = temporalReversalTargetIndex(
        state, casterIndex, <uint>state.entityCastTargetIds[casterIndex], false
    );
    state.entityCastTargetIds[casterIndex] = <uint>0;
    if (targetIndex < 0) {
        return;
    }
    // Target resolution precedes billing exactly as the current source's
    // applyAbility branch: a moved, revived, or de-grouped target fizzles.
    if (!offerOfflineTemporalReversal(state, casterIndex, targetIndex)) {
        return;
    }
    spendOfflineAbilityResource(
        state, casterIndex, temporalReversal.resourceCost(true)
    );
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(temporalReversal.cooldownSeconds(true) * 1000000.0)
    );
}

// `offerResurrection` keeps one source-owned proposal per dead player. The
// effect dispatcher is not connected yet, but this public state primitive lets
// that future producer share the exact durable response/expiry path.
pub offerOfflineResurrection(
    state: WorldState,
    casterIndex: int,
    targetIndex: int,
    hpFraction: float
): bool {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || targetIndex < 0 ||
        targetIndex >= state.entityIds.length ||
        <uint>state.entityKinds[targetIndex] != <uint>1 ||
        !<bool>state.entityDead[targetIndex] || hpFraction <= 0.0 || hpFraction > 1.0) {
        return false;
    }
    state.entityResurrectionOfferPresent[targetIndex] = true;
    state.entityResurrectionOfferCasterIds[targetIndex] = <uint>state.entityIds[casterIndex];
    state.entityResurrectionOfferHpFractions[targetIndex] = hpFraction;
    state.entityResurrectionOfferFallbackX[targetIndex] = <float>state.entityX[casterIndex];
    state.entityResurrectionOfferFallbackY[targetIndex] = <float>state.entityY[casterIndex];
    state.entityResurrectionOfferFallbackZ[targetIndex] = <float>state.entityZ[casterIndex];
    state.entityResurrectionOfferExpiresAtMicros[targetIndex] =
        state.timeMicros + <uint>30000000;
    return true;
}

// The current source's `resurrectAlly` effect has already resolved a dead
// group/raid target before it reaches offerResurrection. WOS owns the mutable
// proposal, so this scalar adapter pins Temporal Reversal's generated 0.35
// fraction without crossing the unreliable mutable cross-module ABI.
pub offerOfflineTemporalReversal(
    state: WorldState,
    casterIndex: int,
    targetIndex: int
): bool {
    return offerOfflineResurrection(
        state, casterIndex, targetIndex, temporalReversal.hpFraction(true)
    );
}

reviveOfflinePlayerAt(
    state: WorldState,
    playerIndex: int,
    destinationX: float,
    destinationZ: float,
    hpFraction: float
): void {
    var groundY = terrainGround.builtinGroundHeight(destinationX, destinationZ, state.worldSeed, true);
    var restoredHp = terrainGradient.javascriptRound(
        <float>state.entityMaxHp[playerIndex] * hpFraction, true
    );
    state.entityDead[playerIndex] = false;
    clearOfflineGhostAndCorpse(state, playerIndex);
    state.entityX[playerIndex] = destinationX;
    state.entityY[playerIndex] = groundY;
    state.entityZ[playerIndex] = destinationZ;
    state.entityPreviousX[playerIndex] = destinationX;
    state.entityPreviousY[playerIndex] = groundY;
    state.entityPreviousZ[playerIndex] = destinationZ;
    state.entityFacing[playerIndex] = 0.0;
    state.entityPreviousFacing[playerIndex] = 0.0;
    state.entityVelocityX[playerIndex] = 0.0;
    state.entityVelocityY[playerIndex] = 0.0;
    state.entityVelocityZ[playerIndex] = 0.0;
    state.entityOnGround[playerIndex] = true;
    state.entityJumping[playerIndex] = false;
    state.entityFallStartY[playerIndex] = groundY;
    state.entityHp[playerIndex] = restoredHp > 0 ? restoredHp : 1;
    clearOfflineCombatPosture(state, playerIndex);
}

// This mirrors respondToResurrection: resolving the actor provides the target;
// an existing offer is always consumed before accept, expiry and death gates.
applyOfflineResurrectRespondCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>1 || payloadOffset >= <uint>payloadBytes.length) {
        return;
    }
    var acceptWire = <uint>payloadBytes[<int>payloadOffset];
    if (acceptWire > <uint>1 || !<bool>state.entityResurrectionOfferPresent[actorIndex]) {
        return;
    }
    var expiresAt = <uint>state.entityResurrectionOfferExpiresAtMicros[actorIndex];
    var hpFraction = <float>state.entityResurrectionOfferHpFractions[actorIndex];
    var destinationX = <float>state.entityResurrectionOfferFallbackX[actorIndex];
    var destinationZ = <float>state.entityResurrectionOfferFallbackZ[actorIndex];
    var casterId = <uint>state.entityResurrectionOfferCasterIds[actorIndex];
    clearOfflineResurrectionOffer(state, actorIndex);
    if (acceptWire == <uint>0 || state.timeMicros >= expiresAt ||
        !<bool>state.entityDead[actorIndex]) {
        return;
    }
    var casterIndex = 0;
    while (casterIndex < state.entityIds.length &&
        <uint>state.entityIds[casterIndex] != casterId) {
        casterIndex = casterIndex + 1;
    }
    if (casterIndex < state.entityIds.length &&
        <uint>state.entityKinds[casterIndex] == <uint>1 &&
        !<bool>state.entityDead[casterIndex]) {
        destinationX = <float>state.entityX[casterIndex];
        destinationZ = <float>state.entityZ[casterIndex];
    }
    reviveOfflinePlayerAt(state, actorIndex, destinationX, destinationZ, hpFraction);
}

// The transport replaces source option ids with stable, generated catalog
// codes. Zero represents optionId:null. The validation order preserves the
// source entry point: row/level and option membership, then the shared combat
// lock, then the full allocation transaction.
applyOfflineTalentRowCommand(
    state: WorldState,
    playerIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>3 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset ||
        !state.offlineSessionActive || playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <uint>state.entityKinds[playerIndex] != <uint>1) {
        return;
    }
    var level = <int><uint>payloadBytes[<int>payloadOffset];
    var optionCode = <uint>payloadBytes[<int>(payloadOffset + <uint>1)] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>256;
    var rowIndex = talentRowIndexForLevel(level);
    var classId = knownAbilityCatalog.classId(<int>state.offlinePlayerClass);
    if (rowIndex < 0 || classId == "" || <int>state.entityLevels[playerIndex] < level ||
        (optionCode != <uint>0 &&
            !talentSelectionCatalog.optionMatchesClassRow(classId, level, optionCode))) {
        return;
    }
    if (offlineTalentAllocationLocked(state, playerIndex)) {
        return;
    }
    var row5Code = talentRowCodeAt(state, playerIndex, 0);
    var row8Code = talentRowCodeAt(state, playerIndex, 1);
    var row11Code = talentRowCodeAt(state, playerIndex, 2);
    var row14Code = talentRowCodeAt(state, playerIndex, 3);
    var row17Code = talentRowCodeAt(state, playerIndex, 4);
    var row20Code = talentRowCodeAt(state, playerIndex, 5);
    if (rowIndex == 0) row5Code = optionCode;
    else if (rowIndex == 1) row8Code = optionCode;
    else if (rowIndex == 2) row11Code = optionCode;
    else if (rowIndex == 3) row14Code = optionCode;
    else if (rowIndex == 4) row17Code = optionCode;
    else row20Code = optionCode;
    replaceOfflineTalentAllocation(
        state, playerIndex, <uint>state.entityTalentSpecCodes[playerIndex], row5Code,
        row8Code, row11Code, row14Code, row17Code, row20Code
    );
}

// Zero represents spec:null. Membership is checked before the shared combat
// lock and allocation transaction, matching the source setTalentSpec path.
applyOfflineSetSpecCommand(
    state: WorldState,
    playerIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>2 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset ||
        !state.offlineSessionActive || playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <uint>state.entityKinds[playerIndex] != <uint>1) {
        return;
    }
    var specCode = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256;
    var classId = knownAbilityCatalog.classId(<int>state.offlinePlayerClass);
    if (classId == "" || (specCode != <uint>0 &&
            !talentSelectionCatalog.specMatchesClass(classId, specCode))) {
        return;
    }
    if (offlineTalentAllocationLocked(state, playerIndex)) {
        return;
    }
    replaceOfflineTalentAllocation(
        state, playerIndex, specCode, talentRowCodeAt(state, playerIndex, 0),
        talentRowCodeAt(state, playerIndex, 1), talentRowCodeAt(state, playerIndex, 2),
        talentRowCodeAt(state, playerIndex, 3), talentRowCodeAt(state, playerIndex, 4),
        talentRowCodeAt(state, playerIndex, 5)
    );
}

// Source respec retains specialization and clears all six choice rows through
// the same combat lock and allocation transaction as every other talent edit.
applyOfflineRespecCommand(state: WorldState, playerIndex: int): void {
    if (!state.offlineSessionActive || playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <uint>state.entityKinds[playerIndex] != <uint>1 ||
        offlineTalentAllocationLocked(state, playerIndex)) {
        return;
    }
    replaceOfflineTalentAllocation(
        state, playerIndex, <uint>state.entityTalentSpecCodes[playerIndex], <uint>0,
        <uint>0, <uint>0, <uint>0, <uint>0, <uint>0
    );
}

// The fixed transport projection keeps the strict source allocation shape:
// specialization plus all six canonical rows. Zero represents null or an
// absent row, and the shared transaction owns all class/level validation.
applyOfflineTalentAllocationCommand(
    state: WorldState,
    playerIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>14 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset ||
        !state.offlineSessionActive || playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <uint>state.entityKinds[playerIndex] != <uint>1 ||
        offlineTalentAllocationLocked(state, playerIndex)) {
        return;
    }
    var specCode = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256;
    var row5Code = <uint>payloadBytes[<int>(payloadOffset + <uint>2)] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>256;
    var row8Code = <uint>payloadBytes[<int>(payloadOffset + <uint>4)] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>5)] * <uint>256;
    var row11Code = <uint>payloadBytes[<int>(payloadOffset + <uint>6)] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>7)] * <uint>256;
    var row14Code = <uint>payloadBytes[<int>(payloadOffset + <uint>8)] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>9)] * <uint>256;
    var row17Code = <uint>payloadBytes[<int>(payloadOffset + <uint>10)] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>11)] * <uint>256;
    var row20Code = <uint>payloadBytes[<int>(payloadOffset + <uint>12)] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>13)] * <uint>256;
    replaceOfflineTalentAllocation(
        state, playerIndex, specCode, row5Code, row8Code, row11Code,
        row14Code, row17Code, row20Code
    );
}

knownAbilityPartitionContains(state: WorldState, entityIndex: int, abilityCode: uint): bool {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length ||
        state.entityKnownAbilityOffsets.length != state.entityIds.length + 1) {
        return false;
    }
    var index = <int><uint>state.entityKnownAbilityOffsets[entityIndex];
    var end = <int><uint>state.entityKnownAbilityOffsets[entityIndex + 1];
    while (index < end) {
        if (<uint>state.entityKnownAbilityCodes[index] == abilityCode) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

applyOfflineBootstrap(state: WorldState, bootstrap: OfflineBootstrap): void {
    if (state.offlineSessionActive || state.entityCount(true) != 0) {
        throw "woc offline bootstrap may only initialize an empty world";
    }
    // The live wire decoder admits only v2. Existing direct in-module fixtures
    // retain v1 construction with the constructor's empty cosmetic account.
    if ((bootstrap.launchVersion != <uint>1 && bootstrap.launchVersion != <uint>2) ||
        bootstrap.worldSeed != <uint>20061 ||
        !offlineSkinVariantIsValid(bootstrap.playerClass, bootstrap.skinVariant) ||
        !offlinePlayerNameIsValid(bootstrap.playerName) ||
        !weaponSkinState.loadoutStateIsValid(
            bootstrap.weaponSkinOwned, bootstrap.weaponSkinLoadoutCodes
        )) {
        throw "woc offline bootstrap is invalid";
    }
    var content = %import("generated/m8_offline_bootstrap_content");
    var freshStats = %import("generated/m8_fresh_player_stats");
    var classIndex = <int>bootstrap.playerClass;
    var classId = content.classId(classIndex);
    if (content.classIndex(classId) != classIndex || freshStats.classIndex(classId) != classIndex) {
        throw "woc offline bootstrap class catalog drifted";
    }
    state.worldSeed = bootstrap.worldSeed;
    state.offlineSessionActive = true;
    state.offlinePlayerClass = bootstrap.playerClass;
    state.offlinePlayerSkinVariant = bootstrap.skinVariant;
    var ownedSkinIndex = 0;
    while (ownedSkinIndex < state.offlineWeaponSkinOwned.length) {
        state.offlineWeaponSkinOwned[ownedSkinIndex] =
            <bool>bootstrap.weaponSkinOwned[ownedSkinIndex];
        ownedSkinIndex = ownedSkinIndex + 1;
    }
    var loadoutSkinTypeIndex = 0;
    while (loadoutSkinTypeIndex < state.offlineWeaponSkinLoadoutCodes.length) {
        state.offlineWeaponSkinLoadoutCodes[loadoutSkinTypeIndex] =
            <uint>bootstrap.weaponSkinLoadoutCodes[loadoutSkinTypeIndex];
        loadoutSkinTypeIndex = loadoutSkinTypeIndex + 1;
    }
    for (var byte in bootstrap.playerName) {
        state.offlinePlayerName.add(<uint>byte);
    }
    state.spawnPlayer(
        bootstrap.playerClass + <uint>1,
        freshStats.classInteger(classIndex, "level"),
        content.playerStartX(),
        1.5,
        content.playerStartZ(),
        freshStats.classInteger(classIndex, "maxHp"),
        freshStats.classDecimal(classIndex, "moveSpeed"),
        1
    );
    var playerIndex = state.entityIds.length - 1;
    state.entityResources[playerIndex] = freshStats.classInteger(classIndex, "resource");
    state.entityMaxResources[playerIndex] = freshStats.classInteger(classIndex, "maxResource");
    applyFreshPlayerCombatLoadout(state, playerIndex, classIndex);
    applyFreshPlayerCombatState(state, playerIndex, classIndex);
    applyFreshPlayerLocomotionRecovery(state, playerIndex, classIndex);
    applyFreshPlayerForcedTarget(state, playerIndex, classIndex);
    applyFreshPlayerResourceCooldown(state, playerIndex, classIndex);
    applyFreshPlayerCastChargeTarget(state, playerIndex, classIndex);
    applyFreshPlayerResourceKind(state, playerIndex, classIndex);
    applyFreshPlayerPresentationIdentity(state, playerIndex, classIndex);
    applyFreshPlayerActivityState(state, playerIndex, classIndex);
    applyFreshPlayerTapOwnership(state, playerIndex, classIndex);
    applyFreshPlayerCorpseInstance(state, playerIndex, classIndex);
    applyFreshPlayerHarvestClaim(state, playerIndex, classIndex);
    applyFreshPlayerLootFfa(state, playerIndex, classIndex);
    applyFreshPlayerPetRuntime(state, playerIndex, classIndex);
    applyFreshPlayerBossCadence(state, playerIndex, classIndex);
    applyFreshPlayerBossSpecial(state, playerIndex, classIndex);
    populateOfflineKnownAbilities(state, state.entityIds.length - 1, classIndex);
    ensureOfflineQuestNpcs(state);
    ensureOfflineEastbrookEncounters(state);
    // The source Sim constructor has already consumed five Mulberry32 draws
    // for every non-dummy world camp before the retained Eastbrook rows are
    // selected. WOS begins observing here, so construction draws advance the
    // cursor but do not contribute to its persisted post-bootstrap observer.
    state.rngState = eastbrookRngCursor.constructorCursorAfterCampSpawns(
        state.worldSeed,
        terrainContent.campNonDummyMobCount(true),
        true
    );
    state.rngDraws = <uint>0;
    state.rngDigest = <uint>2166136261;
}

applyFreshPlayerCombatLoadout(state: WorldState, entityIndex: int, classIndex: int): void {
    var freshStats = %import("generated/m8_fresh_player_stats");
    state.entityWeaponMinimum[entityIndex] = freshStats.combatInteger(classIndex, "weaponMin");
    state.entityWeaponMaximum[entityIndex] = freshStats.combatInteger(classIndex, "weaponMax");
    state.entityWeaponSpeed[entityIndex] = freshStats.combatDecimal(classIndex, "weaponSpeed");
    state.entityOffhandWeaponMinimum[entityIndex] =
        freshStats.combatInteger(classIndex, "offhandWeaponMin");
    state.entityOffhandWeaponMaximum[entityIndex] =
        freshStats.combatInteger(classIndex, "offhandWeaponMax");
    state.entityOffhandWeaponSpeed[entityIndex] =
        freshStats.combatDecimal(classIndex, "offhandWeaponSpeed");
    state.entityHasOffhandWeapon[entityIndex] =
        freshStats.combatFlag(classIndex, "hasOffhandWeapon");
    state.entityDualWielding[entityIndex] = freshStats.combatFlag(classIndex, "dualWielding");
    state.entityAttackPower[entityIndex] = freshStats.combatInteger(classIndex, "attackPower");
    state.entityRangedPower[entityIndex] = freshStats.combatInteger(classIndex, "rangedPower");
    state.entitySpellPower[entityIndex] = freshStats.combatInteger(classIndex, "spellPower");
    state.entityArmor[entityIndex] = freshStats.combatInteger(classIndex, "armor");
    state.entityCritChance[entityIndex] = freshStats.combatDecimal(classIndex, "critChance");
    state.entityDodgeChance[entityIndex] = freshStats.combatDecimal(classIndex, "dodgeChance");
    state.entityHitBonus[entityIndex] = freshStats.combatDecimal(classIndex, "hitBonus");
    state.entityCritDamagePhysicalBonus[entityIndex] =
        freshStats.combatDecimal(classIndex, "critDamagePhysicalBonus");
    state.entityCritDamageSpellBonus[entityIndex] = 0.0;
    state.entitySpellDamageMultipliers[entityIndex] = 1.0;
    state.entityMeleeHaste[entityIndex] = freshStats.combatDecimal(classIndex, "meleeHaste");
    state.entityRangedHaste[entityIndex] = freshStats.combatDecimal(classIndex, "rangedHaste");
    state.entitySwingTimer[entityIndex] = freshStats.combatDecimal(classIndex, "swingTimer");
    state.entityOffhandSwingTimer[entityIndex] =
        freshStats.combatDecimal(classIndex, "offhandSwingTimer");
    state.entityBlockChance[entityIndex] = freshStats.combatDecimal(classIndex, "blockChance");
    state.entityBlockValue[entityIndex] = freshStats.combatInteger(classIndex, "blockValue");
    setM5BaselineStatProfile(state, entityIndex, classIndex);
    recomputeBaselineFormDerivedStats(state, entityIndex);
    if (!combatLoadoutStateIsValid(state, entityIndex)) {
        throw "woc fresh player combat loadout is invalid";
    }
}

