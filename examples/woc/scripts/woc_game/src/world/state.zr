// The source's shared GCD starts from 1.5 seconds, uses the common spell-haste
// multiplier even for this physical strike, and floors at 0.75 seconds.
stormstrikeGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    return lightningBoltGlobalCooldownSeconds(state, casterIndex);
}

startOfflineStormstrikeCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = stormstrikeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("stormstrike");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var targetIndex = stormstrikeTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "weaponStrike") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<float>state.entityResources[casterIndex] < cost) { return; }

    // Source instant casts arm the shared GCD before applyAbility bills and
    // invokes the deterministic weapon-strike reducer.
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = stormstrikeGlobalCooldownSeconds(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );

    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, casterIndex, targetIndex, actor);
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    if (offlineMobTemplateId(state, targetIndex) == "wild_boar") {
        target.spikedHideDamage = 2;
    }
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(
        events, state.rngState, state.rngDraws, state.rngDigest, true
    );
    var physical = resolveOfflineTalentWeaponStrike(
        state, <uint>state.entityIds[casterIndex], abilityCode, <uint>rank,
        m4AbilityEffects.metric(abilityIndex, rank, 0, "bonus"), 1.0
    );
    autoAttackState.meleeSwing(
        actor,
        target,
        <float>physical.bonus,
        m4AbilityCatalog.text(abilityIndex, "name"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
        m4AbilityCatalog.metric(abilityIndex, level, "threatMult"),
        false,
        physical.weaponMultiplier,
        events
    );
    consumeOfflineNextAttackCritAfterAutoHit(state, casterIndex, events);
    commitOfflineAutoAttackRng(state, events);
    commitOfflineAutoActor(state, casterIndex, actor);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage);
    }
    state.entityInCombat[targetIndex] = target.inCombat;
    // meleeSwing enters combat even on a miss or dodge. The source's
    // enterCombat owns idle social aggro and only backfills a missing target
    // for an already active mob, so retain that distinction here.
    if (target.hp > 0) {
        var casterId = <uint>state.entityIds[casterIndex];
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        if (events.lastDamage > 0) {
            state.setThreat(
                <uint>state.entityIds[targetIndex],
                casterId,
                stateThreatValue(state, targetIndex, casterId) +
                    <float>events.lastDamage * events.lastThreatMultiplier +
                    events.lastThreatFlat,
                1
            );
        }
    }
    if (target.hp <= 0) {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
    if (actor.dead || actor.hp <= 0) {
        applyOfflineMobMeleePlayerDeath(state, casterIndex);
    } else {
        state.entityHp[casterIndex] = actor.hp;
    }
}

eviscerateAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("eviscerate");
    var abilityIndex = m4AbilityCatalog.indexOf("eviscerate");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "eviscerate") {
        throw "Eviscerate is absent from the current ability catalog";
    }
    return code;
}

evisceratePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>10 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>118 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>101;
}

eviscerateTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("eviscerate");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    if (range <= 0.0) { range = 5.0; }
    // The retained Eastbrook rows have no static occluder state; its source
    // outdoor encounter subset therefore has a trivially clear line of sight.
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

eviscerateGlobalCooldownSeconds(): float { return 1.0; }

startOfflineEviscerateCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = eviscerateAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("eviscerate");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        <int>state.entityComboPoints[casterIndex] <= 0) {
        return;
    }
    var targetIndex = eviscerateTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "finisherDamage") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<float>state.entityResources[casterIndex] < cost) { return; }

    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = eviscerateGlobalCooldownSeconds();
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);

    var spentCombo = <int>state.entityComboPoints[casterIndex];
    var physical = resolveOfflineTalentFinisher(
        state,
        <uint>state.entityIds[casterIndex],
        abilityCode,
        <uint>rank,
        m4AbilityEffects.metric(abilityIndex, rank, 0, "base"),
        m4AbilityEffects.metric(abilityIndex, rank, 0, "perCombo")
    );
    var damage = <float>physical.base + <float>physical.perCombo * <float>spentCombo +
        nextAuthoritativeRandomUnit(state) *
            m4AbilityEffects.metric(abilityIndex, rank, 0, "variance") +
        effectiveOfflineAttackPower(state, casterIndex) / 14.0;
    var crit = offlinePhysicalCritical(state, casterIndex);
    if (crit) {
        damage = damage * (2.0 + <float>state.entityCritDamagePhysicalBonus[casterIndex]);
    }
    damage = damage * (1.0 - mobSwing.armorReductionFromArmor(
        effectiveOfflineArmor(state, targetIndex), level, true
    ));
    var roundedDamage = terrainGradient.javascriptRound(damage, true);
    if (roundedDamage < 0) { roundedDamage = 0; }
    var hp = <int>state.entityHp[targetIndex] - roundedDamage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    if (roundedDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, roundedDamage);
    }
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    var casterId = <uint>state.entityIds[casterIndex];
    if (hp > 0) {
        if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
            enterIdleMobAggro(state, targetIndex, casterId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = casterId;
        }
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            casterId,
            stateThreatValue(state, targetIndex, casterId) +
                <float>roundedDamage *
                    m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    }
    if (hp <= 0) {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
    // runEffects clears spentCombo after every effect (and after a lethal
    // dealDamage branch), but retains comboUntil's historical timestamp.
    state.entityComboPoints[casterIndex] = 0;
}

kidneyShotAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("kidney_shot");
