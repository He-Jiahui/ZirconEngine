        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -8;
}

// This ZrVM fixture makes the Arcane-only friendly barrier observable through
// both command payload forms and its durable source-keyed absorb row.
pub temporalBarrierRuntimeStateTest(): int {
    if (absorbProfiles.contractTest() != 1) { return -1; }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var casterId = state.spawnPlayer(<uint>2, 5, 0.0, 1.5, 0.0, 300, 7.0, 1);
    var allyId = state.spawnPlayer(<uint>1, 5, 0.0, 1.5, 8.0, 300, 7.0, 1);
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    var barrier = temporalBarrierAbilityCode();
    var barrierIndex = m4AbilityCatalog.indexOf("temporal_barrier");
    if (casterId == <uint>0 || allyId == <uint>0 || arcaneSpec == <uint>0 ||
        barrier == <uint>0 || barrierIndex < 0 ||
        m4AbilityCatalog.rankAtLevel(barrierIndex, 5) != 1 ||
        m4AbilityCatalog.rankAtLevel(barrierIndex, 12) != 2 ||
        m4AbilityCatalog.rankAtLevel(barrierIndex, 18) != 3 ||
        m4AbilityCatalog.metric(barrierIndex, 5, "cost") != 50.0 ||
        m4AbilityCatalog.metric(barrierIndex, 12, "cost") != 75.0 ||
        m4AbilityCatalog.metric(barrierIndex, 18, "cost") != 105.0 ||
        m4AbilityCatalog.metric(barrierIndex, 5, "cooldown") != 12.0 ||
        m4AbilityCatalog.metric(barrierIndex, 5, "range") != 30.0) {
        return -2;
    }
    state.nextPartyId = <uint>2;
    state.entityPartyIds[0] = <uint>1;
    state.entityPartyLeaderIds[0] = casterId;
    state.entityPartyMemberOrders[0] = <uint>1;
    state.entityPartyIds[1] = <uint>1;
    state.entityPartyLeaderIds[1] = casterId;
    state.entityPartyMemberOrders[1] = <uint>2;
    state.entityResources[0] = 300;
    state.entityMaxResources[0] = 300;
    state.entityTargetIds[0] = allyId;
    var barrierBytes = new container.Array<uint>();
    barrierBytes.add(<uint>116); barrierBytes.add(<uint>101); barrierBytes.add(<uint>109);
    barrierBytes.add(<uint>112); barrierBytes.add(<uint>111); barrierBytes.add(<uint>114);
    barrierBytes.add(<uint>97); barrierBytes.add(<uint>108); barrierBytes.add(<uint>95);
    barrierBytes.add(<uint>98); barrierBytes.add(<uint>97); barrierBytes.add(<uint>114);
    barrierBytes.add(<uint>114); barrierBytes.add(<uint>105); barrierBytes.add(<uint>101);
    barrierBytes.add(<uint>114);

    // The source spec gate rejects the typed surface before it can reserve
    // resource, cooldown, GCD, or an absorb row.
    var denied = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        denied, casterId, <uint>1, <uint>1, barrierBytes, allyId
    );
    state.applyCommands(denied, 1);
    if (<float>state.entityResources[0] != 300 ||
        <float>state.entityCastGcdRemaining[0] != 0.0 ||
        abilityCooldownExpiresAt(state, 0, barrier) != <uint>0 ||
        state.offlineAbsorbTargetIds.length != 0) {
        return -3;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, barrier)) {
        return -4;
    }
    state.entityResources[0] = 300;
    state.entityMaxResources[0] = 300;
    state.entityTargetIds[0] = allyId;
    var barrierSlot = -1;
    var slotCursor = <int><uint>state.entityKnownAbilityOffsets[0];
    var slotEnd = <int><uint>state.entityKnownAbilityOffsets[1];
    while (slotCursor < slotEnd) {
        if (<uint>state.entityKnownAbilityCodes[slotCursor] == barrier) {
            barrierSlot = slotCursor;
        }
        slotCursor = slotCursor + 1;
    }
    if (barrierSlot < 0) { return -5; }

    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, casterId, <uint>1, <uint>2, barrierBytes, allyId
    );
    state.applyCommands(typed, 1);
    if (<float>state.entityResources[0] != 250 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, barrier) != <uint>12000000 ||
        state.offlineAbsorbTargetIds.length != 1 ||
        <uint>state.offlineAbsorbTargetIds[0] != allyId ||
        <uint>state.offlineAbsorbSourceIds[0] != casterId ||
        <uint>state.offlineAbsorbAbilityCodes[0] != barrier ||
        <int><uint>state.offlineAbsorbRanks[0] != 1 ||
        <int>state.offlineAbsorbAmounts[0] != 55 ||
        !floatMatches(<float>state.offlineAbsorbRemaining[0], 10.0) ||
        state.rngDraws != <uint>0) {
        return -6;
    }
    var restored = decodeState(encodeState(state));
    if (!offlineAbsorbStateIsValid(restored) ||
        restored.offlineAbsorbTargetIds.length != 1 ||
        <int>restored.offlineAbsorbAmounts[0] != 55 ||
        !floatMatches(<float>restored.offlineAbsorbRemaining[0], 10.0)) {
        return -7;
    }

    // The slot route refreshes, rather than stacks, the same source aura and
    // selects rank two solely from the retained M4 level profile.
    restored.timeMicros = <uint>12000000;
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityLevels[0] = 12;
    restored.entityResources[0] = 300;
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, casterId, <uint>1, <uint>3, <uint>barrierSlot);
    restored.applyCommands(slot, 1);
    if (<int>restored.entityResources[0] != 225 ||
        abilityCooldownExpiresAt(restored, 0, barrier) != <uint>24000000 ||
        restored.offlineAbsorbTargetIds.length != 1 ||
        <int><uint>restored.offlineAbsorbRanks[0] != 2 ||
        <int>restored.offlineAbsorbAmounts[0] != 100 ||
        !floatMatches(<float>restored.offlineAbsorbRemaining[0], 10.0)) {
        return -8;
    }

    restored.timeMicros = <uint>24000000;
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityLevels[0] = 18;
    restored.entityResources[0] = 300;
    startOfflineTemporalBarrierCast(restored, 0, allyId);
    if (<int>restored.entityResources[0] != 195 ||
        abilityCooldownExpiresAt(restored, 0, barrier) != <uint>36000000 ||
        restored.offlineAbsorbTargetIds.length != 1 ||
        <int><uint>restored.offlineAbsorbRanks[0] != 3 ||
        <int>restored.offlineAbsorbAmounts[0] != 160 ||
        !offlineAbsorbStateIsValid(restored)) {
        return -9;
    }
    return applyOfflineAbsorbDamage(restored, 1, 170) == 10 &&
        restored.offlineAbsorbTargetIds.length == 0 ? 1 : -10;
}

// This fixture retains the direct, non-projectile charge transaction. It keeps
// random outcomes unconstrained except for their source-owned draw count.
pub aetherSurgeChargeRuntimeStateTest(): int {
    if (aetherSurge.contractTest() != 1 || timedSpell.contractTest() != 1) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>1, 5, 0.0, 1.5, 0.0, 400, 7.0, 1);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 300, 8.0);
    var surge = arcaneSurgeAbilityCode();
    var surgeIndex = m4AbilityCatalog.indexOf("arcane_surge");
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    if (playerId == <uint>0 || targetId == <uint>0 || forestWolf == <uint>0 ||
        surge == <uint>0 || surgeIndex < 0 || arcaneSpec == <uint>0 ||
        m4AbilityCatalog.rankAtLevel(surgeIndex, 5) != 1 ||
        m4AbilityCatalog.metric(surgeIndex, 5, "cost") != 16.0 ||
        m4AbilityCatalog.metric(surgeIndex, 5, "castTime") != 2.0 ||
        m4AbilityCatalog.metric(surgeIndex, 5, "range") != 30.0 ||
        m4AbilityCatalog.text(surgeIndex, "school") != "arcane") {
        return -2;
    }
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 400;
    state.entityMaxResources[0] = 400;
    state.entityCritChance[0] = 0.0;
    state.entityTargetIds[0] = targetId;
    var surgeBytes = new container.Array<uint>();
    surgeBytes.add(<uint>97); surgeBytes.add(<uint>114); surgeBytes.add(<uint>99);
    surgeBytes.add(<uint>97); surgeBytes.add(<uint>110); surgeBytes.add(<uint>101);
    surgeBytes.add(<uint>95); surgeBytes.add(<uint>115); surgeBytes.add(<uint>117);
    surgeBytes.add(<uint>114); surgeBytes.add(<uint>103); surgeBytes.add(<uint>101);

    // A non-Arcane mage cannot reserve cast, GCD, resource, or charge state.
    var denied = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        denied, playerId, <uint>1, <uint>1, surgeBytes, targetId
    );
    state.applyCommands(denied, 1);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <float>state.entityResources[0] != 400 ||
        <int>state.entityAetherSurgeCharges[0] != 0 ||
        <uint>state.rngDraws != <uint>0) {
        return -3;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, surge)) {
        return -4;
    }
    var surgeSlot = -1;
    var slotCursor = <int><uint>state.entityKnownAbilityOffsets[0];
    var slotEnd = <int><uint>state.entityKnownAbilityOffsets[1];
    while (slotCursor < slotEnd) {
        if (<uint>state.entityKnownAbilityCodes[slotCursor] == surge) {
            surgeSlot = slotCursor;
        }
        slotCursor = slotCursor + 1;
    }
    if (surgeSlot < 0) { return -5; }

    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, surgeBytes, targetId
    );
    state.applyCommands(typed, 1);
    if (<uint>state.entityCastingAbility[0] != surge ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 2.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        <float>state.entityResources[0] != 400 || <uint>state.rngDraws != <uint>0) {
        return -6;
    }
    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <uint>state.entityCastTargetIds[0] != <uint>0 ||
        <float>state.entityResources[0] != 384 ||
        <int>state.entityAetherSurgeCharges[0] != 1 ||
        !floatMatches(<float>state.entityAetherSurgeChargeRemaining[0], 10.0) ||
        state.offlineProjectileSourceIds.length != 0 || <uint>state.rngDraws != <uint>3) {
        return -7;
    }

    // A spellbook press sees one held charge: 2x cost and 5% shorter cast.
    state.entityCastGcdRemaining[0] = 0.0;
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>3, <uint>surgeSlot);
    state.applyCommands(slot, 1);
    if (<uint>state.entityCastingAbility[0] != surge ||
        !floatMatches(<float>state.entityCastRemaining[0], 1.9) ||
        <float>state.entityResources[0] != 384) {
        return -8;
    }
    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<float>state.entityResources[0] != 352 ||
        <int>state.entityAetherSurgeCharges[0] != 2 ||
        !floatMatches(<float>state.entityAetherSurgeChargeRemaining[0], 10.0) ||
        <uint>state.rngDraws != <uint>6) {
        return -9;
    }

    // An armed Aether Rush bypasses the 3-charge cost but still applies the
    // 0.85 x 0.5 cast multiplier and banks the fourth charge.
    state.entityCastGcdRemaining[0] = 0.0;
    state.entityAetherSurgeCharges[0] = 3;
    state.entityAetherSurgeChargeRemaining[0] = 10.0;
    state.entityAetherSurgeFreeRemaining[0] = 15.0;
    state.entityResources[0] = 0;
    startOfflineAetherSurgeCast(state, 0, targetId);
    if (<uint>state.entityCastingAbility[0] != surge ||
        !floatMatches(<float>state.entityCastRemaining[0], 0.85)) {
        return -10;
    }
    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<float>state.entityResources[0] != 0 ||
        <int>state.entityAetherSurgeCharges[0] != 4 ||
        !floatMatches(<float>state.entityAetherSurgeChargeRemaining[0], 10.0) ||
        (<float>state.entityAetherSurgeFreeRemaining[0] != 0.0 &&
            !floatMatches(<float>state.entityAetherSurgeFreeRemaining[0], 15.0)) ||
        <uint>state.rngDraws != <uint>9) {
        return -11;
    }
    var restored = decodeState(encodeState(state));
    if (!aetherSurgeStateIsValid(restored) ||
        <int>restored.entityAetherSurgeCharges[0] != 4 ||
        !floatMatches(<float>restored.entityAetherSurgeChargeRemaining[0], 10.0)) {
        return -12;
    }
    restored.entityAetherSurgeChargeRemaining[0] = 0.05;
    restored.entityAetherSurgeFreeRemaining[0] = 0.05;
    ageOfflineAetherSurge(restored);
    return <int>restored.entityAetherSurgeCharges[0] == 0 &&
        <float>restored.entityAetherSurgeChargeRemaining[0] == 0.0 &&
        <float>restored.entityAetherSurgeFreeRemaining[0] == 0.0 ? 1 : -13;
}

// The channel pays up front, but its Surge charge is removed only after the
// first projectile reaches a living target. The snapshot point deliberately
// sits between those two source lifecycle stages.
pub aetherDartsRuntimeStateTest(): int {
    if (aetherSurge.contractTest() != 1) { return -1; }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>1, 5, 0.0, 1.5, 0.0, 300, 7.0, 1);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 300, 8.0);
    var darts = arcaneMissilesAbilityCode();
    var dartsIndex = m4AbilityCatalog.indexOf("arcane_missiles");
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    if (playerId == <uint>0 || targetId == <uint>0 || forestWolf == <uint>0 ||
        darts == <uint>0 || dartsIndex < 0 || arcaneSpec == <uint>0 ||
        m4AbilityCatalog.rankAtLevel(dartsIndex, 5) != 1 ||
        m4AbilityCatalog.metric(dartsIndex, 5, "cost") != 50.0 ||
        m4AbilityCatalog.metric(dartsIndex, 5, "channelDuration") != 3.0 ||
        m4AbilityCatalog.metric(dartsIndex, 5, "channelTicks") != 3.0 ||
        m4AbilityCatalog.metric(dartsIndex, 5, "range") != 30.0) {
        return -2;
    }
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 100;
    state.entityMaxResources[0] = 100;
    state.entityCritChance[0] = 0.0;
    state.entityTargetIds[0] = targetId;
    var dartsBytes = new container.Array<uint>();
    dartsBytes.add(<uint>97); dartsBytes.add(<uint>114); dartsBytes.add(<uint>99);
    dartsBytes.add(<uint>97); dartsBytes.add(<uint>110); dartsBytes.add(<uint>101);
    dartsBytes.add(<uint>95); dartsBytes.add(<uint>109); dartsBytes.add(<uint>105);
    dartsBytes.add(<uint>115); dartsBytes.add(<uint>115); dartsBytes.add(<uint>105);
    dartsBytes.add(<uint>108); dartsBytes.add(<uint>101); dartsBytes.add(<uint>115);

    // A non-Arcane mage cannot reserve channel state or spend the up-front
    // resource through the public typed command route.
    var denied = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        denied, playerId, <uint>1, <uint>1, dartsBytes, targetId
    );
    state.applyCommands(denied, 1);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <float>state.entityResources[0] != 100 ||
        <bool>state.entityAetherDartsConsumePending[0] ||
        <uint>state.rngDraws != <uint>0) {
        return -3;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, darts)) {
        return -4;
    }

    var dartsSlot = -1;
    var slotCursor = <int><uint>state.entityKnownAbilityOffsets[0];
    var slotEnd = <int><uint>state.entityKnownAbilityOffsets[1];
    while (slotCursor < slotEnd) {
        if (<uint>state.entityKnownAbilityCodes[slotCursor] == darts) {
            dartsSlot = slotCursor;
        }
        slotCursor = slotCursor + 1;
    }
    if (dartsSlot < 0) { return -5; }

    // The max-charge channel uses five missiles, pays once immediately, and
    // keeps its charge until the first landed missile reducer executes.
    state.entityAetherSurgeCharges[0] = 4;
    state.entityAetherSurgeChargeRemaining[0] = 10.0;
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, dartsBytes, targetId
    );
    state.applyCommands(typed, 1);
    if (<uint>state.entityCastingAbility[0] != darts ||
        <float>state.entityResources[0] != 50 ||
        !<bool>state.entityAetherDartsConsumePending[0] ||
        <int>state.entityAetherDartsBonusPerBolt[0] != 0 ||
        <int>state.entityAetherDartsTicks[0] != 5 ||
        !floatMatches(<float>state.entityChannelTickEvery[0], 0.6) ||
        <uint>state.rngDraws != <uint>0) {
        return -6;
    }
    var restored = decodeState(encodeState(state));
    if (!aetherDartsStateIsValid(restored) ||
        !<bool>restored.entityAetherDartsConsumePending[0] ||
        <int>restored.entityAetherDartsTicks[0] != 5 ||
        <int>restored.entityAetherSurgeCharges[0] != 4) {
        return -7;
    }
    if (!launchOfflineAetherDartsChannelTick(restored, 0) ||
        restored.offlineProjectileSourceIds.length != 1) {
        return -8;
    }
    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>2 ||
        <int>restored.entityHp[1] != 285 ||
        <int>restored.entityAetherSurgeCharges[0] != 0 ||
        <float>restored.entityAetherSurgeChargeRemaining[0] != 0.0 ||
        <bool>restored.entityAetherDartsConsumePending[0] ||
        <int>restored.entityAetherDartsBonusPerBolt[0] != 7 ||
        <int>restored.entityAetherDartsTicks[0] != 5 ||
        stateThreatValue(restored, 1, playerId) <= 0.0) {
        return -9;
    }

    // Later missiles retain the first-hit division and do not reconsume a
    // charge. They still spend exactly their own crit/range pair.
    if (!launchOfflineAetherDartsChannelTick(restored, 0)) { return -10; }
    flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>4 || <int>restored.entityHp[1] != 270 ||
        <int>restored.entityAetherDartsBonusPerBolt[0] != 7) {
        return -11;
    }

    // The slot route still builds the ordinary three-tick channel once the
    // previous channel has been cancelled and its GCD released.
    var cast = loadCastingState(restored, 0);
    casting.cancelCast(cast);
    storeCastingState(restored, 0, cast);
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 100;
    restored.entityTargetIds[0] = targetId;
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>3, <uint>dartsSlot);
    restored.applyCommands(slot, 1);
    return <uint>restored.entityCastingAbility[0] == darts &&
        <int>restored.entityResources[0] == 50 &&
        <bool>restored.entityAetherDartsConsumePending[0] &&
        <int>restored.entityAetherDartsTicks[0] == 0 ? 1 : -12;
}

// Perfect Moment is a zero-cost, off-GCD self cast. It atomically refreshes
// both source auras, while its cancel path intentionally leaves Charge alone.
pub perfectMomentRuntimeStateTest(): int {
    if (aetherSurge.contractTest() != 1) { return -1; }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>1, 10, 0.0, 1.5, 0.0, 300, 7.0, 1);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 300, 8.0);
    var perfectMoment = perfectMomentAbilityCode();
    var perfectMomentIndex = m4AbilityCatalog.indexOf("perfect_moment");
    var darts = arcaneMissilesAbilityCode();
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    if (playerId == <uint>0 || targetId == <uint>0 || forestWolf == <uint>0 ||
        perfectMoment == <uint>0 || perfectMomentIndex < 0 || darts == <uint>0 ||
        arcaneSpec == <uint>0 || !perfectMomentProfileIsValid(perfectMoment, 10) ||
        m4AbilityCatalog.rankAtLevel(perfectMomentIndex, 10) != 1 ||
        m4AbilityCatalog.metric(perfectMomentIndex, 10, "cooldown") != 120.0 ||
        !m4AbilityCatalog.flag(perfectMomentIndex, "offGcd")) {
        return -2;
    }
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 100;
    state.entityMaxResources[0] = 100;
    state.entityCritChance[0] = 0.0;
    state.entityTargetIds[0] = targetId;
    state.entityCastGcdRemaining[0] = 1.0;
    var perfectMomentBytes = new container.Array<uint>();
    perfectMomentBytes.add(<uint>112); perfectMomentBytes.add(<uint>101);
    perfectMomentBytes.add(<uint>114); perfectMomentBytes.add(<uint>102);
    perfectMomentBytes.add(<uint>101); perfectMomentBytes.add(<uint>99);
    perfectMomentBytes.add(<uint>116); perfectMomentBytes.add(<uint>95);
    perfectMomentBytes.add(<uint>109); perfectMomentBytes.add(<uint>111);
    perfectMomentBytes.add(<uint>109); perfectMomentBytes.add(<uint>101);
    perfectMomentBytes.add(<uint>110); perfectMomentBytes.add(<uint>116);
    var dartsBytes = new container.Array<uint>();
    dartsBytes.add(<uint>97); dartsBytes.add(<uint>114); dartsBytes.add(<uint>99);
    dartsBytes.add(<uint>97); dartsBytes.add(<uint>110); dartsBytes.add(<uint>101);
    dartsBytes.add(<uint>95); dartsBytes.add(<uint>109); dartsBytes.add(<uint>105);
    dartsBytes.add(<uint>115); dartsBytes.add(<uint>115); dartsBytes.add(<uint>105);
    dartsBytes.add(<uint>108); dartsBytes.add(<uint>101); dartsBytes.add(<uint>115);

    // The typed route cannot bypass the source's Arcane-specialization gate.
    var denied = new CommandBatch();
    appendTypedCastCommandForTest(
        denied, playerId, <uint>1, <uint>1, perfectMomentBytes
    );
    state.applyCommands(denied, 1);
    if (<int>state.entityAetherSurgeCharges[0] != 0 ||
        <float>state.entityAetherSurgePerfectMomentRemaining[0] != 0.0 ||
        <float>state.entityResources[0] != 100 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.0) ||
        <uint>state.rngDraws != <uint>0) {
        return -3;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, perfectMoment) ||
        !knownAbilityPartitionContains(state, 0, darts)) {
        return -4;
    }

    var perfectMomentSlot = -1;
    var slotCursor = <int><uint>state.entityKnownAbilityOffsets[0];
    var slotEnd = <int><uint>state.entityKnownAbilityOffsets[1];
    while (slotCursor < slotEnd) {
        if (<uint>state.entityKnownAbilityCodes[slotCursor] == perfectMoment) {
            perfectMomentSlot = slotCursor;
        }
        slotCursor = slotCursor + 1;
    }
    if (perfectMomentSlot < 0) { return -5; }

    // The source off-GCD action succeeds during a normal GCD, does not write
    // it, pays no resource, and consumes no RNG.
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(
        typed, playerId, <uint>1, <uint>2, perfectMomentBytes
    );
    state.applyCommands(typed, 1);
    if (<int>state.entityAetherSurgeCharges[0] != 4 ||
        !floatMatches(<float>state.entityAetherSurgeChargeRemaining[0], 10.0) ||
        !floatMatches(<float>state.entityAetherSurgePerfectMomentRemaining[0], 10.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.0) ||
        <float>state.entityResources[0] != 100 || <uint>state.rngDraws != <uint>0 ||
        abilityCooldownExpiresAt(state, 0, perfectMoment) != <uint>120000000) {
        return -6;
    }
    var restored = decodeState(encodeState(state));
    if (!aetherSurgeStateIsValid(restored) ||
        <int>restored.entityAetherSurgeCharges[0] != 4 ||
        !floatMatches(<float>restored.entityAetherSurgeChargeRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entityAetherSurgePerfectMomentRemaining[0], 10.0)) {
        return -7;
    }

    // Cancelling only Perfect Moment preserves the separately owned Charge.
    var cancel = new CommandBatch();
    appendCancelAuraCommandForTest(
        cancel, playerId, <uint>1, <uint>3, perfectMomentBytes
    );
    restored.applyCommands(cancel, 1);
    if (<float>restored.entityAetherSurgePerfectMomentRemaining[0] != 0.0 ||
        <int>restored.entityAetherSurgeCharges[0] != 4 ||
        !floatMatches(<float>restored.entityAetherSurgeChargeRemaining[0], 10.0)) {
        return -8;
    }

    // The slot route is equivalent after cooldown expiry and also keeps GCD.
    restored.timeMicros = <uint>120000000;
    restored.entityCastGcdRemaining[0] = 1.0;
    var slot = new CommandBatch();
    appendCastSlotCommand(
        slot, playerId, <uint>1, <uint>4, <uint>perfectMomentSlot
    );
    restored.applyCommands(slot, 1);
    if (<int>restored.entityAetherSurgeCharges[0] != 4 ||
        !floatMatches(<float>restored.entityAetherSurgePerfectMomentRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entityCastGcdRemaining[0], 1.0) ||
        <int>restored.entityResources[0] != 100 || <uint>restored.rngDraws != <uint>0) {
        return -9;
    }

    // Perfect Moment is projected to Aether Darts, so the first landed bolt
    // keeps its four charges while still freezing the usual per-bolt bonus.
    restored.entityCastGcdRemaining[0] = 0.0;
    var dartsCast = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        dartsCast, playerId, <uint>1, <uint>5, dartsBytes, targetId
    );
    restored.applyCommands(dartsCast, 1);
    if (<int>restored.entityResources[0] != 50 ||
        !<bool>restored.entityAetherDartsConsumePending[0] ||
        <int>restored.entityAetherDartsTicks[0] != 5 ||
        !launchOfflineAetherDartsChannelTick(restored, 0)) {
        return -10;
    }
    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    return restored.offlineProjectileSourceIds.length == 0 && flightTicks <= 8 &&
        <uint>restored.rngDraws == <uint>2 && <int>restored.entityHp[1] == 285 &&
        <int>restored.entityAetherSurgeCharges[0] == 4 &&
        !floatMatches(<float>restored.entityAetherSurgePerfectMomentRemaining[0], 0.0) &&
        !<bool>restored.entityAetherDartsConsumePending[0] &&
        <int>restored.entityAetherDartsBonusPerBolt[0] == 7 ? 1 : -11;
}

pub temporalAccelerationRuntimeStateTest(): int {
    var groupHaste = %import("combat/group_haste_state");
    if (groupHaste.contractTest() != 1) { return -1; }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var casterId = state.spawnPlayer(<uint>1, 20, 0.0, 1.5, 0.0, 300, 7.0, 1);
    var allyId = state.spawnPlayer(<uint>1, 20, 0.0, 1.5, 5.0, 300, 7.0, 1);
    var abilityCode = temporalAccelerationAbilityCode();
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    if (casterId == <uint>0 || allyId == <uint>0 || abilityCode == <uint>0 ||
        arcaneSpec == <uint>0 || !temporalAccelerationProfileIsValid(abilityCode, 20)) {
        return -2;
    }
    state.nextPartyId = <uint>2;
    state.entityPartyIds[0] = <uint>1;
    state.entityPartyIds[1] = <uint>1;
    state.entityPartyLeaderIds[0] = casterId;
    state.entityPartyLeaderIds[1] = casterId;
    state.entityPartyMemberOrders[0] = <uint>1;
    state.entityPartyMemberOrders[1] = <uint>2;
    state.entityResources[0] = 120;
    state.entityMaxResources[0] = 120;
    var bytes = new container.Array<uint>();
    bytes.add(<uint>116); bytes.add(<uint>101); bytes.add(<uint>109);
    bytes.add(<uint>112); bytes.add(<uint>111); bytes.add(<uint>114);
    bytes.add(<uint>97); bytes.add(<uint>108); bytes.add(<uint>95);
    bytes.add(<uint>97); bytes.add(<uint>99); bytes.add(<uint>99);
    bytes.add(<uint>101); bytes.add(<uint>108); bytes.add(<uint>101);
    bytes.add(<uint>114); bytes.add(<uint>97); bytes.add(<uint>116);
    bytes.add(<uint>105); bytes.add(<uint>111); bytes.add(<uint>110);
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, abilityCode)) {
        return -3;
    }
    var slot = -1;
    var cursor = <int><uint>state.entityKnownAbilityOffsets[0];
    var end = <int><uint>state.entityKnownAbilityOffsets[1];
    while (cursor < end) {
        if (<uint>state.entityKnownAbilityCodes[cursor] == abilityCode) { slot = cursor; }
        cursor = cursor + 1;
    }
    if (slot < 0) { return -4; }
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(typed, casterId, <uint>1, <uint>1, bytes);
    state.applyCommands(typed, 1);
    if (<float>state.entityResources[0] != 0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>300000000 ||
        !floatMatches(<float>state.entityGroupHasteRemaining[0], 15.0) ||
        !floatMatches(<float>state.entityGroupHasteRemaining[1], 15.0) ||
        !floatMatches(<float>state.entityGroupHasteAttackBonuses[1], 0.3) ||
        !floatMatches(<float>state.entityGroupHasteSpellBonuses[1], 0.3) ||
        !floatMatches(<float>state.entitySatedRemaining[0], 600.0) ||
        !floatMatches(<float>state.entitySatedRemaining[1], 600.0) ||
        !floatMatches(mageSpellHasteMultiplier(state, 0), 1.3) ||
        <uint>state.rngDraws != <uint>0) {
        return -5;
    }
    var restored = decodeState(encodeState(state));
    if (!groupHasteStateIsValid(restored) ||
        !floatMatches(<float>restored.entityGroupHasteRemaining[1], 15.0) ||
        !floatMatches(<float>restored.entitySatedRemaining[1], 600.0)) {
        return -6;
    }
    // Sated candidates stay excluded, but a slot cast remains a normal source
    // cast transaction: resource and cooldown are spent even if no target gains haste.
    restored.timeMicros = <uint>300000000;
    restored.entityResources[0] = 120;
    restored.entityCastGcdRemaining[0] = 0.0;
    var slotCast = new CommandBatch();
    appendCastSlotCommand(slotCast, casterId, <uint>1, <uint>2, <uint>slot);
    restored.applyCommands(slotCast, 1);
    if (<int>restored.entityResources[0] != 0 ||
        !floatMatches(<float>restored.entityGroupHasteRemaining[1], 15.0) ||
        <uint>restored.rngDraws != <uint>0) {
        return -7;
    }
    restored.entityGroupHasteRemaining[0] = 0.05;
    restored.entityGroupHasteRemaining[1] = 0.05;
    restored.entitySatedRemaining[0] = 0.05;
    restored.entitySatedRemaining[1] = 0.05;
    ageOfflineGroupHaste(restored);
    return <float>restored.entityGroupHasteRemaining[0] == 0.0 &&
        <float>restored.entityGroupHasteAttackBonuses[0] == 0.0 &&
        <float>restored.entityGroupHasteSpellBonuses[1] == 0.0 &&
        <float>restored.entitySatedRemaining[0] == 0.0 ? 1 : -8;
}

// Hourglass uses the position-command ABI but resolves immediately whenever
// the selected point contains self, a friendly group member, or a hostile.
// This fixture keeps self protection, snapshot restoration, cooldown rate and
// empty-ground first contact observable without a renderer or live network.
pub temporalHourglassRuntimeStateTest(): int {
    if (temporalHourglass.contractTest() != 1) { return -1; }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var casterId = state.spawnPlayer(<uint>1, 14, 0.0, 1.5, 0.0, 300, 7.0, 1);
    var allyId = state.spawnPlayer(<uint>1, 14, 0.0, 1.5, 5.0, 300, 7.0, 1);
    var abilityCode = temporalHourglassAbilityCode();
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    if (casterId == <uint>0 || allyId == <uint>0 || abilityCode == <uint>0 ||
        arcaneSpec == <uint>0 || !temporalHourglassProfileIsValid(abilityCode, 14)) {
        return -2;
    }
    state.nextPartyId = <uint>2;
    state.entityPartyIds[0] = <uint>1;
    state.entityPartyIds[1] = <uint>1;
    state.entityPartyLeaderIds[0] = casterId;
    state.entityPartyLeaderIds[1] = casterId;
    state.entityPartyMemberOrders[0] = <uint>1;
    state.entityPartyMemberOrders[1] = <uint>2;
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, abilityCode)) {
        return -3;
    }
    state.entityResources[0] = 110;
    state.entityMaxResources[0] = 110;
    state.entityHp[0] = 210;
    var hourglassBytes = new container.Array<uint>();
    hourglassBytes.add(<uint>116); hourglassBytes.add(<uint>101); hourglassBytes.add(<uint>109);
    hourglassBytes.add(<uint>112); hourglassBytes.add(<uint>111); hourglassBytes.add(<uint>114);
    hourglassBytes.add(<uint>97); hourglassBytes.add(<uint>108); hourglassBytes.add(<uint>95);
    hourglassBytes.add(<uint>104); hourglassBytes.add(<uint>111); hourglassBytes.add(<uint>117);
    hourglassBytes.add(<uint>114); hourglassBytes.add(<uint>103); hourglassBytes.add(<uint>108);
    hourglassBytes.add(<uint>97); hourglassBytes.add(<uint>115); hourglassBytes.add(<uint>115);
    var zero = new container.Array<uint>();
    var zeroIndex = 0;
    while (zeroIndex < 8) { zero.add(<uint>0); zeroIndex = zeroIndex + 1; }
    var selfCast = new CommandBatch();
    appendTypedCastAtCommandForTest(
        selfCast, casterId, <uint>1, <uint>1, hourglassBytes, zero, zero
    );
    state.applyCommands(selfCast, 1);
    if (<float>state.entityResources[0] != 0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>50000000 ||
        !floatMatches(<float>state.entityTemporalHourglassRemaining[0], 5.0) ||
        <uint>state.entityTemporalHourglassModes[0] != <uint>1 ||
        !floatMatches(<float>state.entityTemporalHourglassCooldownRates[0], 2.0) ||
        <int>state.entityTemporalHourglassHealRemaining[0] != 90 ||
        <int>state.entityTemporalHourglassHealTicksRemaining[0] != 5 ||
        state.offlineTemporalHourglassSourceIds.length != 0 || <uint>state.rngDraws != <uint>0) {
        return -4;
    }
    var restored = decodeState(encodeState(state));
    if (!temporalHourglassStateIsValid(restored) ||
        !floatMatches(<float>restored.entityTemporalHourglassRemaining[0], 5.0) ||
        <int>restored.entityTemporalHourglassHealRemaining[0] != 90) {
        return -5;
    }
    setAbilityCooldownExpiration(
        restored, 0, temporalAccelerationAbilityCode(), <uint>10000000
    );
    restored.entityTemporalHourglassHealTickTimers[0] = 0.05;
    ageOfflineTemporalHourglass(restored);
    if (<int>restored.entityHp[0] != 228 ||
        <int>restored.entityTemporalHourglassHealRemaining[0] != 72 ||
        <int>restored.entityTemporalHourglassHealTicksRemaining[0] != 4 ||
        !floatMatches(<float>restored.entityTemporalHourglassRemaining[0], 4.95) ||
        abilityCooldownExpiresAt(restored, 0, temporalAccelerationAbilityCode()) !=
            <uint>9950000) {
        return -6;
    }
    clearOfflineTemporalHourglass(restored, 0);
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.timeMicros = <uint>50000000;
    restored.entityResources[0] = 110;
    var aimX = new container.Array<uint>();
    var aimXIndex = 0;
    while (aimXIndex < 6) { aimX.add(<uint>0); aimXIndex = aimXIndex + 1; }
    aimX.add(<uint>36); aimX.add(<uint>64);
    var emptyGround = new CommandBatch();
    appendTypedCastAtCommandForTest(
        emptyGround, casterId, <uint>1, <uint>2, hourglassBytes, aimX, zero
    );
    restored.applyCommands(emptyGround, 1);
    if (restored.offlineTemporalHourglassSourceIds.length != 1 ||
        !floatMatches(<float>restored.offlineTemporalHourglassX[0], 10.0) ||
        !floatMatches(<float>restored.offlineTemporalHourglassRemaining[0], 30.0)) {
        return -7;
    }
    var restoredGround = decodeState(encodeState(restored));
    if (!temporalHourglassStateIsValid(restoredGround) ||
        !floatMatches(<float>restoredGround.offlineTemporalHourglassProtectiveDurations[0], 5.0) ||
        !floatMatches(<float>restoredGround.offlineTemporalHourglassHostilePveDurations[0], 60.0) ||
        !floatMatches(<float>restoredGround.offlineTemporalHourglassHostilePvpDurations[0], 10.0) ||
        !floatMatches(<float>restoredGround.offlineTemporalHourglassHealFractions[0], 0.3) ||
        !floatMatches(<float>restoredGround.offlineTemporalHourglassSelfCooldownRates[0], 2.0) ||
        !floatMatches(<float>restoredGround.offlineTemporalHourglassAllyCooldownRates[0], 1.75)) {
        return -8;
    }
    restored.entityPreviousX[1] = 9.0;
    restored.entityPreviousZ[1] = 0.0;
    restored.entityX[1] = 10.0;
    restored.entityZ[1] = 0.0;
    stepOfflineTemporalHourglassGround(restored);
    if (restored.offlineTemporalHourglassSourceIds.length != 0 ||
        <uint>restored.entityTemporalHourglassModes[1] != <uint>1 ||
        !floatMatches(<float>restored.entityTemporalHourglassCooldownRates[1], 1.75)) {
        return -9;
    }
    var wolfTemplate = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var wolfId = restored.spawnMob(wolfTemplate, 1, 15.0, 1.5, 0.0, 100, 8.0);
    restored.timeMicros = <uint>100000000;
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 110;
    var aimFifteen = new container.Array<uint>();
    var aimFifteenIndex = 0;
    while (aimFifteenIndex < 6) { aimFifteen.add(<uint>0); aimFifteenIndex = aimFifteenIndex + 1; }
    aimFifteen.add(<uint>46); aimFifteen.add(<uint>64);
    var hostileCast = new CommandBatch();
    appendTypedCastAtCommandForTest(
        hostileCast, casterId, <uint>1, <uint>3, hourglassBytes, aimFifteen, zero
    );
    restored.applyCommands(hostileCast, 1);
    if (wolfId == <uint>0 || <uint>restored.entityTemporalHourglassModes[2] != <uint>2 ||
        !floatMatches(<float>restored.entityTemporalHourglassRemaining[2], 60.0) ||
        !<bool>restored.entityInCombat[0] || !<bool>restored.entityInCombat[2] ||
        <uint>restored.entityTargetIds[2] != casterId ||
        <uint>restored.entityAggroTargetIds[2] != casterId) {
        return -10;
    }
    return 1;
}

// Cascade locks one valid living group target, then selects that primary plus
// its nearest living group members. The fixture also preserves the individual
// Echo upgrade rule across snapshot restore and conversion healing.
pub temporalCascadeRuntimeStateTest(): int {
    if (temporalEcho.contractTest() != 1) { return -1; }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var casterId = state.spawnPlayer(<uint>1, 12, 0.0, 1.5, 0.0, 200, 7.0, 1);
    var primaryId = state.spawnPlayer(<uint>1, 12, 10.0, 1.5, 0.0, 200, 7.0, 1);
    var firstId = state.spawnPlayer(<uint>1, 12, 11.0, 1.5, 0.0, 200, 7.0, 1);
    var secondId = state.spawnPlayer(<uint>1, 12, 12.0, 1.5, 0.0, 200, 7.0, 1);
    var thirdId = state.spawnPlayer(<uint>1, 12, 13.0, 1.5, 0.0, 200, 7.0, 1);
    var fourthId = state.spawnPlayer(<uint>1, 12, 14.0, 1.5, 0.0, 200, 7.0, 1);
    var abilityCode = temporalCascadeAbilityCode();
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    if (casterId == <uint>0 || primaryId == <uint>0 || firstId == <uint>0 ||
        secondId == <uint>0 || thirdId == <uint>0 || fourthId == <uint>0 ||
        abilityCode == <uint>0 || arcaneSpec == <uint>0) { return -2; }
    state.nextPartyId = <uint>2;
    var memberIndex = 0;
    while (memberIndex < 6) {
        state.entityPartyIds[memberIndex] = <uint>1;
        state.entityPartyLeaderIds[memberIndex] = casterId;
        state.entityPartyMemberOrders[memberIndex] = <uint>(memberIndex + 1);
        state.entityHp[memberIndex] = 10;
        memberIndex = memberIndex + 1;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, abilityCode)) {
        return -3;
    }
    applyOfflineTemporalEchoMark(state, 0, firstId, 2, 5.0);
    state.entityResources[0] = 90;
    state.entityMaxResources[0] = 90;
    // Cascade's massTemporalEcho effect is not a direct `heal` effect, so it
    // must leave an armed Power Echo untouched for the next eligible spell.
    state.entityPowerEchoRemaining[0] = 10.0;
    state.entityPowerEchoValues[0] = 0.5;
    var cascadeBytes = new container.Array<uint>();
    cascadeBytes.add(<uint>116); cascadeBytes.add(<uint>101); cascadeBytes.add(<uint>109);
    cascadeBytes.add(<uint>112); cascadeBytes.add(<uint>111); cascadeBytes.add(<uint>114);
    cascadeBytes.add(<uint>97); cascadeBytes.add(<uint>108); cascadeBytes.add(<uint>95);
    cascadeBytes.add(<uint>99); cascadeBytes.add(<uint>97); cascadeBytes.add(<uint>115);
    cascadeBytes.add(<uint>99); cascadeBytes.add(<uint>97); cascadeBytes.add(<uint>100);
    cascadeBytes.add(<uint>101);
    var cast = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        cast, casterId, <uint>1, <uint>1, cascadeBytes, primaryId
    );
    state.applyCommands(cast, 1);
    if (<uint>state.entityCastingAbility[0] != abilityCode ||
        <uint>state.entityCastTargetIds[0] != primaryId ||
        <float>state.entityResources[0] != 90 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5)) {
        return -4;
    }
    completeOfflineTemporalCascadeCast(state, 0);
    if (<float>state.entityResources[0] != 0 ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>17000000 ||
        state.offlineTemporalEchoTargetIds.length != 5 ||
        <uint>state.offlineTemporalEchoTargetIds[0] != firstId ||
        <bool>state.offlineTemporalEchoGroups[0] ||
        !floatMatches(<float>state.offlineTemporalEchoConvertRates[0], 0.35) ||
        !floatMatches(<float>state.offlineTemporalEchoRemaining[0], 10.0) ||
        <uint>state.offlineTemporalEchoTargetIds[1] != primaryId ||
        !<bool>state.offlineTemporalEchoGroups[1] ||
        <uint>state.offlineTemporalEchoTargetIds[4] != fourthId ||
        !offlineTemporalEchoStateIsValid(state)) {
        return -5;
    }
    if (!floatMatches(<float>state.entityPowerEchoRemaining[0], 10.0) ||
        !floatMatches(<float>state.entityPowerEchoValues[0], 0.5)) {
        return -8;
    }
    var restored = decodeState(encodeState(state));
    if (!offlineTemporalEchoStateIsValid(restored) ||
        restored.offlineTemporalEchoTargetIds.length != 5 ||
        !<bool>restored.offlineTemporalEchoGroups[1] ||
        !floatMatches(<float>restored.offlineTemporalEchoConvertRates[1], 0.13)) {
        return -6;
    }
    memberIndex = 1;
    while (memberIndex < 6) {
        restored.entityHp[memberIndex] = 0;
        memberIndex = memberIndex + 1;
    }
    applyOfflineTemporalEchoDamageConversion(
        restored, 0, 100, OFFLINE_PROJECTILE_SCHOOL_ARCANE, false
    );
    if (<int>restored.entityHp[2] != 35 || <int>restored.entityHp[1] != 13 ||
        <int>restored.entityHp[5] != 13) {
        return -7;
    }
    var duplicate = decodeState(encodeState(restored));
    duplicate.offlineTemporalEchoTargetIds.add(
        <uint>duplicate.offlineTemporalEchoTargetIds[0]
    );
    duplicate.offlineTemporalEchoSourceIds.add(
        <uint>duplicate.offlineTemporalEchoSourceIds[0]
    );
    duplicate.offlineTemporalEchoRemaining.add(
        <float>duplicate.offlineTemporalEchoRemaining[0]
    );
    duplicate.offlineTemporalEchoGroups.add(
        <bool>duplicate.offlineTemporalEchoGroups[0]
    );
    duplicate.offlineTemporalEchoConvertRates.add(
        <float>duplicate.offlineTemporalEchoConvertRates[0]
    );
    if (offlineTemporalEchoStateIsValid(duplicate)) { return -9; }

    // A copied Arcane impact converts only the actual post-absorb, post-floor
    // HP loss. This fixture has both a 48-point shield and 30 available HP:
    // converting raw 100 would heal 35, while converting 30 twice would heal
    // 22. The sole correct single-Echo result is 11.
    var echoState = new WorldState();
    echoState.offlineSessionActive = true;
    echoState.offlinePlayerClass = <uint>1;
    var echoCasterId = echoState.spawnPlayer(<uint>2, 12, 0.0, 1.5, 0.0, 200, 7.0, 1);
    var echoAllyId = echoState.spawnPlayer(<uint>1, 12, 0.0, 1.5, 4.0, 100, 7.0, 1);
    var echoTargetId = echoState.spawnMob(
        <uint>(campMobCore.indexOf("forest_wolf", true) + 1),
        1, 0.0, 1.5, 8.0, 30, 7.0
    );
    if (echoCasterId == <uint>0 || echoAllyId == <uint>0 || echoTargetId == <uint>0) {
        return -10;
    }
    echoState.nextPartyId = <uint>2;
    echoState.entityPartyIds[0] = <uint>1;
    echoState.entityPartyLeaderIds[0] = echoCasterId;
    echoState.entityPartyMemberOrders[0] = <uint>1;
    echoState.entityPartyIds[1] = <uint>1;
    echoState.entityPartyLeaderIds[1] = echoCasterId;
    echoState.entityPartyMemberOrders[1] = <uint>2;
    echoState.entityHp[1] = 0;
    applyOfflineTemporalEchoMark(echoState, 0, echoAllyId, 1, 10.0);
    applyOfflinePowerWordShield(
        echoState, echoTargetId, echoCasterId, powerWordShieldAbilityCode(), 1
    );
    appendOfflineFixedSpellProjectile(
        echoState, echoCasterId, echoTargetId, 0.0, 0.0,
        OFFLINE_PROJECTILE_SCHOOL_ARCANE, aetherSurgeAbilityCode(), <uint>1, 100, false
    );
    landOfflineFixedSpellProjectile(echoState, 0, 0, 2);
    if (<int>echoState.entityHp[2] != 0 || <int>echoState.entityHp[1] != 11 ||
        echoState.offlineAbsorbTargetIds.length != 0 || echoState.rngDraws != <uint>0) {
        return -11;
    }
    return 1;
}

// Rewind is an instant, non-random group recovery. This fixture covers the
// source window boundary, actual-damage-only history, snapshot persistence,
// 40-yard group selection, caps, normal healing threat, and the normal cast
// transaction without relying on a presentation event queue.
pub temporalRewindRuntimeStateTest(): int {
    var history = %import("combat/damage_history_state");
    var rewind = %import("combat/rewind_state");
    if (history.contractTest() != 1 || rewind.contractTest() != 1) { return -1; }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var casterId = state.spawnPlayer(<uint>2, 14, 0.0, 1.5, 0.0, 1000, 7.0, 1);
    var allyId = state.spawnPlayer(<uint>1, 14, 10.0, 1.5, 0.0, 1000, 7.0, 1);
    var farAllyId = state.spawnPlayer(<uint>1, 14, 41.0, 1.5, 0.0, 1000, 7.0, 1);
    var otherPartyId = state.spawnPlayer(<uint>1, 14, 10.0, 1.5, 2.0, 1000, 7.0, 1);
    var deadAllyId = state.spawnPlayer(<uint>1, 14, 10.0, 1.5, -2.0, 1000, 7.0, 1);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var mobId = state.spawnMob(forestWolf, 14, 10.0, 1.5, 6.0, 1000, 7.0);
    var arcaneSpec = talentSelectionCatalog.specCode("mage", "arcane");
    var abilityCode = temporalRewindAbilityCode();
    if (casterId == <uint>0 || allyId == <uint>0 || farAllyId == <uint>0 ||
        otherPartyId == <uint>0 || deadAllyId == <uint>0 || forestWolf == <uint>0 ||
        mobId == <uint>0 || arcaneSpec == <uint>0 || abilityCode == <uint>0) {
        return -2;
    }
    state.nextPartyId = <uint>3;
    var memberIndex = 0;
    while (memberIndex < 5) {
        state.entityPartyIds[memberIndex] = <uint>1;
        state.entityPartyLeaderIds[memberIndex] = casterId;
        state.entityPartyMemberOrders[memberIndex] = <uint>(memberIndex + 1);
        memberIndex = memberIndex + 1;
    }
    state.entityPartyIds[3] = <uint>2;
    state.entityPartyLeaderIds[3] = otherPartyId;
    state.entityPartyMemberOrders[3] = <uint>1;
    state.entityMaxHp[0] = 1000;
    state.entityMaxHp[1] = 1000;
    state.entityMaxHp[2] = 1000;
    state.entityMaxHp[3] = 1000;
    state.entityMaxHp[4] = 1000;
    state.entityHp[0] = 1000;
    state.entityHp[1] = 1000;
    state.entityHp[2] = 1000;
    state.entityHp[3] = 1000;
    state.entityHp[4] = 0;
    state.entityDead[4] = true;
    if (!replaceOfflineTalentAllocation(
            state, 0, arcaneSpec, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, abilityCode)) {
        return -3;
    }
    state.tick = <uint>100;
    var oldDamage = applyOfflineArcaneEffectiveDamage(state, 0, 100);
    state.entityHp[0] = 1000;
    state.tick = <uint>200;
    applyOfflinePowerWordShield(
        state, casterId, casterId, powerWordShieldAbilityCode(), 1
    );
    var casterDamage = applyOfflineArcaneEffectiveDamage(state, 0, 2000);
    var allyDamage = applyOfflineArcaneEffectiveDamage(state, 1, 2000);
    var farDamage = applyOfflineArcaneEffectiveDamage(state, 2, 2000);
    applyOfflinePowerWordShield(
        state, otherPartyId, casterId, powerWordShieldAbilityCode(), 1
    );
    var absorbIndex = state.offlineAbsorbAmounts.length - 1;
    var fullyAbsorbed = applyOfflineArcaneEffectiveDamage(
        state, 3, <int>state.offlineAbsorbAmounts[absorbIndex]
    );
    if (oldDamage != 100 || casterDamage != 1000 || allyDamage != 1000 ||
        farDamage != 1000 || fullyAbsorbed != 0) {
        return -4;
    }
    state.entityInCombat[5] = true;
    state.setThreat(mobId, allyId, 1.0, 1);
    state.entityResources[0] = 150;
    state.entityMaxResources[0] = 150;
    state.entityPowerEchoRemaining[0] = 10.0;
    state.entityPowerEchoValues[0] = 0.5;
    var restored = decodeState(encodeState(state));
    if (!offlineRewindDamageStateIsValid(restored) ||
        restored.offlineRewindDamageTargetIds.length != 3 ||
        offlineRewindDamageTaken(restored, casterId) != 1000 ||
        offlineRewindDamageTaken(restored, allyId) != 1000 ||
        offlineRewindDamageTaken(restored, otherPartyId) != 0) {
        return -5;
    }
    var rewindBytes = new container.Array<uint>();
    rewindBytes.add(<uint>116); rewindBytes.add(<uint>101); rewindBytes.add(<uint>109);
    rewindBytes.add(<uint>112); rewindBytes.add(<uint>111); rewindBytes.add(<uint>114);
    rewindBytes.add(<uint>97); rewindBytes.add(<uint>108); rewindBytes.add(<uint>95);
    rewindBytes.add(<uint>114); rewindBytes.add(<uint>101); rewindBytes.add(<uint>119);
    rewindBytes.add(<uint>105); rewindBytes.add(<uint>110); rewindBytes.add(<uint>100);
    var rngDraws = restored.rngDraws;
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(
        typed, casterId, <uint>1, <uint>1, rewindBytes
    );
    restored.applyCommands(typed, 1);
    if (<int>restored.entityResources[0] != 0 ||
        !floatMatches(<float>restored.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(restored, 0, abilityCode) != <uint>120000000 ||
        <int>restored.entityHp[0] != 300 || <int>restored.entityHp[1] != 300 ||
        <int>restored.entityHp[2] != 0 || <int>restored.entityHp[3] != 1000 ||
        <int>restored.entityHp[4] != 0 || restored.rngDraws != rngDraws ||
        !floatMatches(<float>restored.entityPowerEchoRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entityPowerEchoValues[0], 0.5) ||
        stateThreatValue(restored, 5, casterId) <= 0.0) {
        return -6;
    }
    var rewindSlot = -1;
    var slotCursor = <int><uint>state.entityKnownAbilityOffsets[0];
    var slotEnd = <int><uint>state.entityKnownAbilityOffsets[1];
    while (slotCursor < slotEnd) {
        if (<uint>state.entityKnownAbilityCodes[slotCursor] == abilityCode) {
            rewindSlot = slotCursor;
        }
        slotCursor = slotCursor + 1;
    }
    if (rewindSlot < 0) { return -7; }
    var slotState = decodeState(encodeState(state));
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, casterId, <uint>1, <uint>1, <uint>rewindSlot);
    slotState.applyCommands(slot, 1);
    if (<int>slotState.entityResources[0] != 0 ||
        !floatMatches(<float>slotState.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(slotState, 0, abilityCode) != <uint>120000000 ||
        <int>slotState.entityHp[0] != 300 || <int>slotState.entityHp[1] != 300 ||
        slotState.rngDraws != rngDraws ||
        !floatMatches(<float>slotState.entityPowerEchoRemaining[0], 10.0)) {
        return -7;
    }
    var blocked = decodeState(encodeState(state));
    applyOfflineMotionAuraWithDetailsAndSchool(
        blocked, 0, abilityCode, mobId, ccContract.motionAuraKindCode("lockout"),
        4.0, 0.0, 0.0, OFFLINE_PROJECTILE_SCHOOL_ARCANE
    );
    var rejected = new CommandBatch();
    appendTypedCastCommandForTest(
        rejected, casterId, <uint>1, <uint>1, rewindBytes
    );
    blocked.applyCommands(rejected, 1);
    if (!offlineSchoolLockoutIsActive(blocked, 0, OFFLINE_PROJECTILE_SCHOOL_ARCANE) ||
        <int>blocked.entityResources[0] != 150 ||
        <float>blocked.entityCastGcdRemaining[0] != 0.0 ||
        abilityCooldownExpiresAt(blocked, 0, abilityCode) != <uint>0 ||
        blocked.rngDraws != rngDraws ||
        !floatMatches(<float>blocked.entityPowerEchoRemaining[0], 10.0)) {
        return -8;
    }
    return 1;
}

// Direct-heal talent modifiers resolve range endpoints before the existing
// range draw. They do not add RNG or affect the later critical-heal kernel.
pub directHealTalentRuntimeStateTest(): int {
    if (directHealTalentScaling.contractTest() != 1) return -1;
    var holy = talentSelectionCatalog.specCode("priest", "holy");
    var healIndex = m4AbilityCatalog.indexOf("heal");
    if (holy == <uint>0 || healIndex < 0 ||
        m4AbilityCatalog.rankAtLevel(healIndex, 20) != 2) {
        return -2;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>5;
    var priestId = state.spawnPlayer(<uint>5, 20, 0.0, 1.5, 0.0, 1000, 7.0, 1);
    state.entityHp[0] = 0;
    // Exercise the existing spell-power bonus and critical-heal kernel while
    // the talent path replaces only the source range contribution.
    state.entitySpellPower[0] = 120;
    state.entityCritChance[0] = 1.0;
    if (priestId == <uint>0 || !replaceOfflineTalentAllocation(
            state, 0, holy, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
    )) {
        return -3;
    }
    var modifiers = offlineTalentModifiersForEntity(state, 0);
    var range = directHealTalentScaling.resolveDirectHealRange(230, 270, modifiers, "heal");
    if (range.minimum != 276 || range.maximum != 324) return -4;
    var probe = decodeState(encodeState(state));
    var rangeUnit = nextAuthoritativeRandomUnit(probe);
    var critUnit = nextAuthoritativeRandomUnit(probe);
    var amount = <float>range.minimum + rangeUnit *
        <float>(range.maximum - range.minimum) +
        <float>spellScaling.directHealBonus(
            <float>state.entitySpellPower[0],
            m4AbilityCatalog.metric(healIndex, 20, "castTime")
        );
    if (critUnit < offlineSpellCritChance(state, 0)) { amount = amount * 1.5; }
    var expected = <int>(amount + 0.5);
    var healed = applyOfflineDirectHeal(state, 0, priestId, 0, healIndex, 2);
    if (healed != expected || <int>state.entityHp[0] != expected ||
        state.rngDraws != <uint>2) {
        return -5;
    }

    var swiftmendState = new WorldState();
    swiftmendState.offlineSessionActive = true;
    swiftmendState.offlinePlayerClass = <uint>5;
    var swiftmendPriest = swiftmendState.spawnPlayer(
        <uint>5, 20, 0.0, 1.5, 0.0, 1000, 7.0, 1
    );
    swiftmendState.entityHp[0] = 0;
    swiftmendState.entitySpellPower[0] = 120;
    swiftmendState.entityCritChance[0] = 1.0;
    var swiftmendIndex = m4AbilityCatalog.indexOf("swiftmend");
    if (swiftmendPriest == <uint>0 || swiftmendIndex < 0 ||
        !replaceOfflineTalentAllocation(
            swiftmendState, 0, holy, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -6;
    }
    var swiftmendModifiers = offlineTalentModifiersForEntity(swiftmendState, 0);
    var swiftmendRange = directHealTalentScaling.resolveDirectHealRange(
        105, 125, swiftmendModifiers, "swiftmend"
    );
    if (swiftmendRange.minimum != 126 || swiftmendRange.maximum != 150) return -7;
    var swiftmendProbe = decodeState(encodeState(swiftmendState));
    var swiftmendRangeUnit = nextAuthoritativeRandomUnit(swiftmendProbe);
    var swiftmendCritUnit = nextAuthoritativeRandomUnit(swiftmendProbe);
    var swiftmendAmount = <float>swiftmendRange.minimum + swiftmendRangeUnit *
        <float>(swiftmendRange.maximum - swiftmendRange.minimum) +
        <float>spellScaling.directHealBonus(
            <float>swiftmendState.entitySpellPower[0],
            m4AbilityCatalog.metric(swiftmendIndex, 20, "castTime")
        );
    if (swiftmendCritUnit < offlineSpellCritChance(swiftmendState, 0)) {
        swiftmendAmount = swiftmendAmount * 1.5;
    }
    var swiftmendExpected = <int>(swiftmendAmount + 0.5);
    var swiftmendHealed = applyOfflineDirectHeal(
        swiftmendState, 0, swiftmendPriest, 0, swiftmendIndex, 1
    );
    if (swiftmendHealed != swiftmendExpected ||
        <int>swiftmendState.entityHp[0] != swiftmendExpected ||
        swiftmendState.rngDraws != <uint>2) {
        return -8;
    }
    return 1;
}

// Direct-damage talent endpoints are fixed when the projectile launches. The
// subsequent flight, restore and respec do not re-evaluate the source range.
pub directDamageTalentRuntimeStateTest(): int {
    if (directDamageTalentScaling.contractTest() != 1) return -1;
    var frost = talentSelectionCatalog.specCode("mage", "frost");
    var frostbolt = frostboltAbilityCode();
    var frostboltIndex = m4AbilityCatalog.indexOf("frostbolt");
    if (frost == <uint>0 || frostbolt == <uint>0 || frostboltIndex < 0) return -2;

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var casterId = state.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnPlayer(<uint>2, 20, 0.0, 1.5, 8.0, 100, 7.0, 1);
    state.entityTalentSpecCodes[0] = frost;
    var rank = m4AbilityCatalog.rankAtLevel(frostboltIndex, 20);
    var effects = %import("generated/m4_ability_effects");
    if (casterId == <uint>0 || targetId == <uint>0 || rank != 4 ||
        effects.typeAt(frostboltIndex, rank, 0) != "directDamage" ||
        talentModifiers.abilityField(
            offlineTalentModifiersForEntity(state, 0), "frostbolt", "dmgPct"
        ) != 0.25) {
        return -3;
    }

    var rawMinimum = effects.metric(frostboltIndex, rank, 0, "min");
    var rawMaximum = effects.metric(frostboltIndex, rank, 0, "max");
    var expected = resolveOfflineTalentDirectDamageRange(
        state, casterId, frostbolt, <uint>rank, rawMinimum, rawMaximum
    );
    if (expected.minimum != <int>(rawMinimum * 1.25 + 0.5) ||
        expected.maximum != <int>(rawMaximum * 1.25 + 0.5)) {
        return -4;
    }
    appendOfflineAbilityProjectile(
        state, casterId, targetId, 0.0, 0.0, rawMinimum, rawMaximum,
        projectileTravel.projectileSpeed(), false, OFFLINE_PROJECTILE_SCHOOL_FROST,
        frostbolt, <uint>rank, m4AbilityCatalog.metric(frostboltIndex, 20, "castTime")
    );
    if (state.offlineProjectileMinimums.length != 1 ||
        <int>state.offlineProjectileMinimums[0] != expected.minimum ||
        <int>state.offlineProjectileMaximums[0] != expected.maximum ||
        <uint>state.offlineProjectileTalentSpecCodes[0] != frost ||
        offlineProjectileTalentSnapshotsAreLegacyCompatible(state) ||
        state.rngDraws != <uint>0 || !offlineProjectileStateIsValid(state)) {
        return -5;
    }

    var restored = decodeState(encodeState(state));
    state.entityTalentSpecCodes[0] = <uint>0;
    if (<int>restored.offlineProjectileMinimums[0] != expected.minimum ||
        <int>restored.offlineProjectileMaximums[0] != expected.maximum ||
        !offlineProjectileStateIsValid(restored) || !offlineProjectileStateIsValid(state) ||
        state.rngDraws != <uint>0) {
        return -6;
    }

    var tampered = decodeState(encodeState(restored));
    tampered.offlineProjectileMinimums[0] = 1.0;
    tampered.offlineProjectileMaximums[0] = 65535.0;
    if (offlineProjectileStateIsValid(tampered)) { return -7; }

    var orderingModifiers = new talentModifiers.TalentModifierState();
    var globalField = 0;
    while (globalField < orderingModifiers.globals.length &&
        talentModifierCatalog.globalFieldName(globalField) != "spellDmgPct") {
        globalField = globalField + 1;
    }
    if (globalField == orderingModifiers.globals.length) { return -8; }
    orderingModifiers.globals[globalField] = 0.15;
    var fireballIndex = m4AbilityCatalog.indexOf("fireball");
    var pyroblastIndex = m4AbilityCatalog.indexOf("pyroblast");
    var fireballRank = fireballIndex >= 0 ? m4AbilityCatalog.rankAtLevel(fireballIndex, 20) : 0;
    var pyroblastRank = pyroblastIndex >= 0 ? m4AbilityCatalog.rankAtLevel(pyroblastIndex, 20) : 0;
    if (fireballRank <= 0 || pyroblastRank != 1) { return -9; }

    var fireballTalentRange = directDamageTalentScaling.resolveDirectDamageRange(
        <int>(effects.metric(fireballIndex, fireballRank, 0, "min") + 0.5),
        <int>(effects.metric(fireballIndex, fireballRank, 0, "max") + 0.5),
        "fire", orderingModifiers, "fireball"
    );
    var fireballLaunchRange = offlineOverloadTalentDirectDamageRange(fireballTalentRange, 1.4);
    var fireballReverseRange = directDamageTalentScaling.resolveDirectDamageRange(
        <int>offlineOverloadScaledPositiveMetric(
            effects.metric(fireballIndex, fireballRank, 0, "min"), 1.4
        ),
        <int>offlineOverloadScaledPositiveMetric(
            effects.metric(fireballIndex, fireballRank, 0, "max"), 1.4
        ),
        "fire", orderingModifiers, "fireball"
    );
    if (fireballLaunchRange.minimum == fireballReverseRange.minimum &&
        fireballLaunchRange.maximum == fireballReverseRange.maximum) {
        return -10;
    }

    var pyroblastTalentRange = directDamageTalentScaling.resolveDirectDamageRange(
        <int>(effects.metric(pyroblastIndex, pyroblastRank, 0, "min") + 0.5),
        <int>(effects.metric(pyroblastIndex, pyroblastRank, 0, "max") + 0.5),
        "fire", orderingModifiers, "pyroblast"
    );
    var pyroblastLaunchRange = offlineOverloadTalentDirectDamageRange(
        pyroblastTalentRange, 1.4
    );
    var pyroblastReverseRange = directDamageTalentScaling.resolveDirectDamageRange(
        <int>offlineOverloadScaledPositiveMetric(
            effects.metric(pyroblastIndex, pyroblastRank, 0, "min"), 1.4
        ),
        <int>offlineOverloadScaledPositiveMetric(
            effects.metric(pyroblastIndex, pyroblastRank, 0, "max"), 1.4
        ),
        "fire", orderingModifiers, "pyroblast"
    );
    if (pyroblastLaunchRange.minimum == pyroblastReverseRange.minimum &&
        pyroblastLaunchRange.maximum == pyroblastReverseRange.maximum) {
        return -11;
    }
    // A WOS106 payload remains valid only while no launch selection needs
    // persistence. The encoder rejects the incompatible Frost snapshot above
    // before it can be silently discarded by that historical schema.
    var legacy = new WorldState();
    legacy.offlineSessionActive = true;
    legacy.offlinePlayerClass = <uint>1;
    var legacyCasterId = legacy.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var legacyTargetId = legacy.spawnPlayer(<uint>2, 20, 0.0, 1.5, 8.0, 100, 7.0, 1);
    appendOfflineAbilityProjectile(
        legacy, legacyCasterId, legacyTargetId, 0.0, 0.0, rawMinimum, rawMaximum,
        projectileTravel.projectileSpeed(), false, OFFLINE_PROJECTILE_SCHOOL_FROST,
        frostbolt, <uint>rank, m4AbilityCatalog.metric(frostboltIndex, 20, "castTime")
    );
    var legacyRestored = decodeState(encodeStateVersion(legacy, <uint>106));
    if (legacyCasterId == <uint>0 || legacyTargetId == <uint>0 ||
        !offlineProjectileTalentSnapshotsAreLegacyCompatible(legacy) ||
        legacyRestored.offlineProjectileSourceIds.length != 1 ||
        !offlineProjectileTalentSnapshotsAreLegacyCompatible(legacyRestored) ||
        !offlineProjectileStateIsValid(legacyRestored)) {
        return -12;
    }
    return 1;
}

// Periodic totals use the launch/application selection rather than a later
// respec. The fixture also exercises the schema-107 forward normalization
// path, which has no selection or resolved-total tail to read.
pub dotTalentScalingRuntimeStateTest(): int {
    if (dotTalentScaling.contractTest() != 1) { return -1; }
    var frost = talentSelectionCatalog.specCode("mage", "frost");
    var fireball = fireballAbilityCode();
    var fireballIndex = m4AbilityCatalog.indexOf("fireball");
    var pyroblast = pyroblastAbilityCode();
    var pyroblastIndex = m4AbilityCatalog.indexOf("pyroblast");
    if (frost == <uint>0 || fireball == <uint>0 || fireballIndex < 0 ||
        pyroblast == <uint>0 || pyroblastIndex < 0) { return -2; }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var casterId = state.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(<uint>1, 20, 0.0, 1.5, 8.0, 1000, 7.0);
    var rank = m4AbilityCatalog.rankAtLevel(fireballIndex, 20);
    if (casterId == <uint>0 || targetId == <uint>0 || rank <= 0) { return -3; }
    state.entityTalentSpecCodes[0] = frost;
    var resolvedTotal = offlineTalentDotResolvedTotal(state, casterId, fireball, <uint>rank);
    var profile = numericEffects.dotProfileFromResolvedTotal(
        fireballIndex, rank, 1, 0, resolvedTotal
    );
    if (!profile.valid || resolvedTotal <= 0) { return -4; }
    applyOfflineFireballDot(
        state, targetId, casterId, fireball, <uint>rank, 0, resolvedTotal, -1,
        profile.damage, profile.duration, profile.interval
    );
    if (state.offlineDotTargetIds.length != 1 ||
        <int>state.offlineDotResolvedTotals[0] != resolvedTotal ||
        <uint>state.offlineDotTalentSpecCodes[0] != frost ||
        offlineDotTalentSnapshotsAreLegacyCompatible(state) ||
        !offlineDotStateIsValid(state)) {
        return -5;
    }
    var restored = decodeState(encodeState(state));
    state.entityTalentSpecCodes[0] = <uint>0;
    if (restored.offlineDotTargetIds.length != 1 ||
        <int>restored.offlineDotResolvedTotals[0] != resolvedTotal ||
        <uint>restored.offlineDotTalentSpecCodes[0] != frost ||
        !offlineDotStateIsValid(restored) || !offlineDotStateIsValid(state)) {
        return -6;
    }
    var tampered = decodeState(encodeState(restored));
    tampered.offlineDotResolvedTotals[0] = resolvedTotal + 1;
    if (offlineDotStateIsValid(tampered)) { return -7; }

    // An empty snapshot may still use WOS107. Its restored row is normalized
    // to the generated total and remains valid under the WOS108 validator.
    var legacy = new WorldState();
    legacy.offlineSessionActive = true;
    legacy.offlinePlayerClass = <uint>1;
    var legacyCasterId = legacy.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var legacyTargetId = legacy.spawnMob(<uint>1, 20, 0.0, 1.5, 8.0, 1000, 7.0);
    var legacyTotal = offlineTalentDotResolvedTotal(
        legacy, legacyCasterId, fireball, <uint>rank
    );
    var legacyProfile = numericEffects.dotProfileFromResolvedTotal(
        fireballIndex, rank, 1, 0, legacyTotal
    );
    if (legacyCasterId == <uint>0 || legacyTargetId == <uint>0 ||
        !legacyProfile.valid) { return -8; }
    applyOfflineFireballDot(
        legacy, legacyTargetId, legacyCasterId, fireball, <uint>rank, 0,
        legacyTotal, -1, legacyProfile.damage, legacyProfile.duration, legacyProfile.interval
    );
    if (!offlineDotStateIsSchema107Compatible(legacy)) { return -9; }
    var downgraded = decodeState(encodeState(legacy));
    downgraded.offlineDotResolvedTotals[0] = legacyTotal + 1;
    if (offlineDotStateIsSchema107Compatible(downgraded)) { return -10; }
    var legacyRestored = decodeState(encodeStateVersion(legacy, <uint>107));
    if (!offlineDotTalentSnapshotsAreLegacyCompatible(legacy) ||
        legacyRestored.offlineDotTargetIds.length != 1 ||
        <int>legacyRestored.offlineDotResolvedTotals[0] != legacyTotal ||
        !offlineDotStateIsValid(legacyRestored)) {
        return -11;
    }

    // WOS107 stores only the completed hybrid tick. Its decode must preserve
    // both Overload auras as historical rows rather than rejecting them for
    // lacking the WOS108 selection/total tail.
    var overload = new WorldState();
    overload.offlineSessionActive = true;
    overload.offlinePlayerClass = <uint>1;
    var overloadCasterId = overload.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var overloadTargetId = overload.spawnMob(<uint>1, 20, 0.0, 1.5, 8.0, 1000, 7.0);
    var pyroblastRank = m4AbilityCatalog.rankAtLevel(pyroblastIndex, 20);
    var overloadFireTotal = <int>offlineOverloadScaledPositiveMetric(
        <float>legacyTotal, 1.4
    );
    var overloadFireProfile = numericEffects.dotProfileFromResolvedTotal(
        fireballIndex, rank, 1, 0, overloadFireTotal
    );
    var pyroblastBaseTotal = offlineTalentDotResolvedTotal(
        overload, overloadCasterId, pyroblast, <uint>pyroblastRank
    );
    var overloadPyroTotal = <int>offlineOverloadScaledPositiveMetric(
        <float>pyroblastBaseTotal, 1.4
    );
    var overloadPyroProfile = numericEffects.dotProfileFromResolvedTotal(
        pyroblastIndex, pyroblastRank, 1, 0, overloadPyroTotal
    );
    if (overloadCasterId == <uint>0 || overloadTargetId == <uint>0 ||
        pyroblastRank != 1 || !overloadFireProfile.valid ||
        !overloadPyroProfile.valid) { return -12; }
    applyOfflineFireballDot(
        overload, overloadTargetId, overloadCasterId, fireball, <uint>rank, 0,
        overloadFireTotal, -1, overloadFireProfile.damage,
        overloadFireProfile.duration, overloadFireProfile.interval
    );
    applyOfflinePyroblastDot(
        overload, overloadTargetId, overloadCasterId, pyroblast, <uint>pyroblastRank, 0,
        overloadPyroTotal, -1, overloadPyroProfile.damage,
        overloadPyroProfile.duration, overloadPyroProfile.interval
    );
    if (!offlineDotStateIsValid(overload) ||
        !offlineDotStateIsSchema107Compatible(overload)) { return -13; }
    var overloadRestored = decodeState(encodeStateVersion(overload, <uint>107));
    if (overloadRestored.offlineDotTargetIds.length != 2 ||
        <uint>overloadRestored.offlineDotRanks[0] != <uint>0 ||
        <uint>overloadRestored.offlineDotRanks[1] != <uint>0 ||
        <int>overloadRestored.offlineDotResolvedTotals[0] !=
            <int>overloadRestored.offlineDotDamages[0] *
                <int>(<float>overloadRestored.offlineDotDurations[0] /
                    <float>overloadRestored.offlineDotTickIntervals[0] + 0.5) ||
        <int>overloadRestored.offlineDotResolvedTotals[1] !=
            <int>overloadRestored.offlineDotDamages[1] *
                <int>(<float>overloadRestored.offlineDotDurations[1] /
                    <float>overloadRestored.offlineDotTickIntervals[1] + 0.5)) {
        return -14;
    }
    return offlineDotStateIsValid(overloadRestored) ? 1 : -15;
}

// Source channels resolve their ability again for every tick. This fixture
// checks the endpoint helper at consecutive resolution points without drawing
// combat RNG or creating a persisted ground effect.
pub aoeTalentScalingRuntimeStateTest(): int {
    if (aoeTalentScaling.contractTest() != 1) { return -1; }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>8;
    var casterId = state.spawnPlayer(<uint>8, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var hurricane = hurricaneAbilityCode();
    var hurricaneIndex = m4AbilityCatalog.indexOf("hurricane");
    var balance = talentSelectionCatalog.specCode("druid", "balance");
    if (casterId == <uint>0 || hurricane == <uint>0 || hurricaneIndex < 0 ||
        balance == <uint>0 || m4AbilityCatalog.rankAtLevel(hurricaneIndex, 20) != 1) {
        return -2;
    }
    var before = resolveOfflineTalentAoEDamageRange(
        state, casterId, hurricane, <uint>1, 0, 12.0, 16.0
    );
    if (before.minimum != 12 || before.maximum != 16 ||
        !replaceOfflineTalentAllocation(
            state, 0, balance, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -3;
    }
    var during = resolveOfflineTalentAoEDamageRange(
        state, casterId, hurricane, <uint>1, 0, 12.0, 16.0
    );
    if (during.minimum != 14 || during.maximum != 18 ||
        !replaceOfflineTalentAllocation(
            state, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        )) {
        return -4;
    }
    var after = resolveOfflineTalentAoEDamageRange(
        state, casterId, hurricane, <uint>1, 0, 12.0, 16.0
    );
    return after.minimum == 12 && after.maximum == 16 ? 1 : -5;
}

// Channel resolution is live at launch, while WOC's deferred projectile keeps
// that particular tick's resolved interval through a later respec and reload.
pub drainTickTalentScalingRuntimeStateTest(): int {
    if (drainTickTalentScaling.contractTest() != 1) { return -1; }
    var shadow = talentSelectionCatalog.specCode("priest", "shadow");
    var mindFlay = mindFlayAbilityCode();
    var mindFlayIndex = m4AbilityCatalog.indexOf("mind_flay");
    if (shadow == <uint>0 || mindFlay == <uint>0 || mindFlayIndex < 0) {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>5;
    var casterId = state.spawnPlayer(<uint>5, 14, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnPlayer(<uint>5, 14, 0.0, 1.5, 8.0, 100, 7.0, 1);
    if (casterId == <uint>0 || targetId == <uint>0 ||
        !replaceOfflineTalentAllocation(
            state, 0, shadow, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        )) {
        return -3;
    }
    var resolved = resolveOfflineTalentDrainTickRange(
        state, casterId, mindFlay, <uint>1, 12.0, 12.0
    );
    if (resolved.minimum != 13 || resolved.maximum != 13) { return -4; }
    appendOfflineAbilityProjectile(
        state, casterId, targetId, 0.0, 0.0,
        <float>resolved.minimum, <float>resolved.maximum,
        projectileTravel.projectileSpeed(), false, OFFLINE_PROJECTILE_SCHOOL_SHADOW,
        mindFlay, <uint>1, 0.0
    );
    if (state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileTalentSpecCodes[0] != shadow ||
        !offlineTalentDrainTickProjectileRangeIsValid(state, 0) ||
        !offlineProjectileStateIsValid(state)) {
        return -5;
    }
    var restored = decodeState(encodeStateVersion(state, <uint>107));
    if (!replaceOfflineTalentAllocation(
            state, 0, <uint>0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        )) {
        return -6;
    }
    var laterTick = resolveOfflineTalentDrainTickRange(
        state, casterId, mindFlay, <uint>1, 12.0, 12.0
    );
    if (laterTick.minimum != 12 || laterTick.maximum != 12 ||
        <uint>restored.offlineProjectileTalentSpecCodes[0] != shadow ||
        !offlineTalentDrainTickProjectileRangeIsValid(restored, 0) ||
        !offlineProjectileStateIsValid(restored) ||
        offlineProjectileTalentSnapshotsAreLegacyCompatible(restored)) {
        return -7;
    }
    var tampered = decodeState(encodeState(restored));
    tampered.offlineProjectileMinimums[0] = 12.0;
    if (offlineTalentDrainTickProjectileRangeIsValid(tampered) ||
        offlineProjectileStateIsValid(tampered)) {
        return -8;
    }
    return 1;
}

// Physical effects resolve at their existing source dispatch points. A queued
// Maul remains intent until the swing bridge prepares its live actor values.
pub physicalTalentScalingRuntimeStateTest(): int {
    if (physicalTalentScaling.contractTest() != 1) { return -1; }
    var feral = talentSelectionCatalog.specCode("druid", "feral");
    var maul = <uint>knownAbilityCatalog.abilityCode("maul");
    var claw = clawAbilityCode();
    var bite = ferociousBiteAbilityCode();
    var maulIndex = m4AbilityCatalog.indexOf("maul");
    var clawIndex = m4AbilityCatalog.indexOf("claw");
    var biteIndex = m4AbilityCatalog.indexOf("ferocious_bite");
    if (feral == <uint>0 || maul == <uint>0 || claw == <uint>0 || bite == <uint>0 ||
        maulIndex < 0 || clawIndex < 0 || biteIndex < 0) {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>8;
    var casterId = state.spawnPlayer(<uint>8, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnPlayer(<uint>8, 20, 0.0, 1.5, 8.0, 100, 7.0, 1);
    var maulRank = m4AbilityCatalog.rankAtLevel(maulIndex, 20);
    var clawRank = m4AbilityCatalog.rankAtLevel(clawIndex, 20);
    var biteRank = m4AbilityCatalog.rankAtLevel(biteIndex, 20);
    if (casterId == <uint>0 || targetId == <uint>0 || maulRank != 2 ||
        clawRank != 2 || biteRank != 1 || !replaceOfflineTalentAllocation(
            state, 0, feral, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        )) {
        return -3;
    }
    state.entityQueuedOnSwingAbilityCodes[0] = maul;
    var queued = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, 0, 1, queued);
    var strike = resolveOfflineTalentWeaponStrike(
        state, casterId, claw, <uint>clawRank, 20.0, 1.0
    );
    var finisher = resolveOfflineTalentFinisher(
        state, casterId, bite, <uint>biteRank, 10.0, 14.0
    );
    if (!queued.queuedTalentBonusResolved || queued.queuedTalentBonus != 31.0 ||
        strike.bonus != 23 || strike.weaponMultiplier < 1.149 ||
        strike.weaponMultiplier > 1.151 || finisher.base != 12 ||
        finisher.perCombo != 16) {
        return -4;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, <uint>0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        )) {
        return -5;
    }
    var laterQueued = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, 0, 1, laterQueued);
    var laterStrike = resolveOfflineTalentWeaponStrike(
        state, casterId, claw, <uint>clawRank, 20.0, 1.0
    );
    var laterFinisher = resolveOfflineTalentFinisher(
        state, casterId, bite, <uint>biteRank, 10.0, 14.0
    );
    return laterQueued.queuedTalentBonusResolved && laterQueued.queuedTalentBonus == 27.0 &&
        laterStrike.bonus == 20 && laterStrike.weaponMultiplier == 1.0 &&
        laterFinisher.base == 10 && laterFinisher.perCombo == 14 ? 1 : -6;
}

// Imbue values and Judgement endpoints are resolved with the allocation that
// existed at application. Later loadout changes only affect the next imbue.
pub imbueTalentScalingRuntimeStateTest(): int {
    if (imbueTalentScaling.contractTest() != 1) { return -1; }
    var holy = talentSelectionCatalog.specCode("paladin", "holy");
    var enhancement = talentSelectionCatalog.specCode("shaman", "enhancement");
    var imbueMastery = talentSelectionCatalog.optionCode(
        "shaman", 5, "sha_r5_imbue_mastery"
    );
    if (holy == <uint>0 || enhancement == <uint>0 || imbueMastery == <uint>0) {
        return -2;
    }

    var sealState = new WorldState();
    sealState.offlineSessionActive = true;
    sealState.offlinePlayerClass = <uint>3;
    var sealCasterId = sealState.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    if (sealCasterId == <uint>0 || !replaceOfflineTalentAllocation(
            sealState, 0, holy, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        )) {
        return -3;
    }
    applyOfflineSealOfRighteousness(sealState, 0, <uint>2);
    var sealBonus = <int>sealState.entityImbueResolvedBonuses[0];
    var sealMinimum = <int>sealState.entityImbueResolvedJudgementMinimums[0];
    var sealMaximum = <int>sealState.entityImbueResolvedJudgementMaximums[0];
    if (<uint>sealState.entityImbueTalentSpecCodes[0] != holy || sealBonus <= 0 ||
        sealMinimum <= 0 || sealMaximum < sealMinimum ||
        imbueStateIsSchema108Compatible(sealState) || !replaceOfflineTalentAllocation(
            sealState, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        ) || !imbueStateIsValid(sealState) ||
        <int>offlineImbueBonus(sealState, 0) != sealBonus) {
        return -4;
    }
    var restoredSeal = decodeState(encodeState(sealState));
    if (<int>restoredSeal.entityImbueResolvedBonuses[0] != sealBonus ||
        <int>restoredSeal.entityImbueResolvedJudgementMinimums[0] != sealMinimum ||
        <int>restoredSeal.entityImbueResolvedJudgementMaximums[0] != sealMaximum ||
        <uint>restoredSeal.entityImbueTalentSpecCodes[0] != holy ||
        !imbueStateIsValid(restoredSeal)) {
        return -5;
    }
    var tamperedSeal = decodeState(encodeState(restoredSeal));
    tamperedSeal.entityImbueResolvedJudgementMaximums[0] = sealMaximum + 1;
    if (imbueStateIsValid(tamperedSeal)) { return -6; }
    applyOfflineSealOfRighteousness(sealState, 0, <uint>2);
    var rawSeal = offlineRawImbueValues(sealOfRighteousnessAbilityCode(), <uint>2);
    if (<uint>sealState.entityImbueTalentSpecCodes[0] != <uint>0 ||
        <int>sealState.entityImbueResolvedBonuses[0] != rawSeal.bonus ||
        <int>sealState.entityImbueResolvedJudgementMinimums[0] != rawSeal.judgementMinimum ||
        <int>sealState.entityImbueResolvedJudgementMaximums[0] != rawSeal.judgementMaximum ||
        !imbueStateIsSchema108Compatible(sealState)) {
        return -7;
    }
    var legacySeal = decodeState(encodeStateVersion(sealState, <uint>108));
    if (<uint>legacySeal.entityImbueTalentSpecCodes[0] != <uint>0 ||
        <int>legacySeal.entityImbueResolvedBonuses[0] != rawSeal.bonus ||
        <int>legacySeal.entityImbueResolvedJudgementMinimums[0] != rawSeal.judgementMinimum ||
        <int>legacySeal.entityImbueResolvedJudgementMaximums[0] != rawSeal.judgementMaximum ||
        !imbueStateIsValid(legacySeal)) {
        return -8;
    }

    var weaponState = new WorldState();
    weaponState.offlineSessionActive = true;
    weaponState.offlinePlayerClass = <uint>6;
    var weaponCasterId = weaponState.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    if (weaponCasterId == <uint>0 || !replaceOfflineTalentAllocation(
            weaponState, 0, enhancement, imbueMastery, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -9;
    }
    applyOfflineFlametongueWeapon(weaponState, 0, <uint>2);
    var flametongueBonus = <int>weaponState.entityImbueResolvedBonuses[0];
    if (flametongueBonus <= 0 ||
        <int>weaponState.entityImbueResolvedJudgementMinimums[0] != 0 ||
        <int>weaponState.entityImbueResolvedJudgementMaximums[0] != 0 ||
        !replaceOfflineTalentAllocation(
            weaponState, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        ) || <int>offlineImbueBonus(weaponState, 0) != flametongueBonus) {
        return -10;
    }
    var restoredFlametongue = decodeState(encodeState(weaponState));
    if (<int>restoredFlametongue.entityImbueResolvedBonuses[0] != flametongueBonus ||
        !imbueStateIsValid(restoredFlametongue)) {
        return -11;
    }
    if (!replaceOfflineTalentAllocation(
            weaponState, 0, enhancement, imbueMastery, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -12;
    }
    applyOfflineFrostbrandWeapon(weaponState, 0, <uint>2);
    var frostbrandBonus = <int>weaponState.entityImbueResolvedBonuses[0];
    if (frostbrandBonus <= 0 ||
        <int>weaponState.entityImbueResolvedJudgementMinimums[0] != 0 ||
        <int>weaponState.entityImbueResolvedJudgementMaximums[0] != 0 ||
        !replaceOfflineTalentAllocation(
            weaponState, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        ) || <int>offlineImbueBonus(weaponState, 0) != frostbrandBonus) {
        return -13;
    }
    var restoredFrostbrand = decodeState(encodeState(weaponState));
    return <int>restoredFrostbrand.entityImbueResolvedBonuses[0] == frostbrandBonus &&
        <int>restoredFrostbrand.entityImbueResolvedJudgementMinimums[0] == 0 &&
        <int>restoredFrostbrand.entityImbueResolvedJudgementMaximums[0] == 0 &&
        !imbueStateIsSchema108Compatible(restoredFrostbrand) &&
        imbueStateIsValid(restoredFrostbrand) ? 1 : -14;
}

// Absorb endpoints are fixed at application. A later respec cannot make an
// existing shield smaller, bypass damage consumption, or change its snapshot.
pub absorbTalentScalingRuntimeStateTest(): int {
    if (absorbTalentScaling.contractTest() != 1) { return -1; }
    var discipline = talentSelectionCatalog.specCode("priest", "discipline");
    var shield = powerWordShieldAbilityCode();
    var shieldIndex = m4AbilityCatalog.indexOf("power_word_shield");
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>5;
    var casterId = state.spawnPlayer(<uint>5, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var rank = m4AbilityCatalog.rankAtLevel(shieldIndex, 20);
    var raw = absorbProfiles.resolveAbsorbProfile(shieldIndex, rank);
    if (discipline == <uint>0 || shield == <uint>0 || shieldIndex < 0 || !raw.valid ||
        casterId == <uint>0 || !replaceOfflineTalentAllocation(
            state, 0, discipline, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) {
        return -2;
    }
    var expected = absorbTalentScaling.resolveAbsorbAmount(
        raw.amount, offlineTalentModifiersForEntity(state, 0), "power_word_shield"
    );
    applyOfflinePowerWordShield(state, casterId, casterId, shield, rank);
    var initial = <int>state.offlineAbsorbResolvedInitialAmounts[0];
    if (state.offlineAbsorbTargetIds.length != 1 || expected <= raw.amount ||
        initial != expected || <int>state.offlineAbsorbAmounts[0] != expected ||
        <uint>state.offlineAbsorbTalentSpecCodes[0] != discipline ||
        offlineAbsorbStateIsSchema109Compatible(state) || !offlineAbsorbStateIsValid(state)) {
        return -3;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0
        ) || !offlineAbsorbStateIsValid(state)) {
        return -4;
    }
    var restored = decodeState(encodeState(state));
    if (<int>restored.offlineAbsorbResolvedInitialAmounts[0] != initial ||
        <uint>restored.offlineAbsorbTalentSpecCodes[0] != discipline ||
        applyOfflineAbsorbDamage(restored, 0, 1) != 0 ||
        <int>restored.offlineAbsorbAmounts[0] != initial - 1 ||
        !offlineAbsorbStateIsValid(restored)) {
        return -5;
    }
    var tampered = decodeState(encodeState(restored));
    tampered.offlineAbsorbResolvedInitialAmounts[0] = initial + 1;
    if (offlineAbsorbStateIsValid(tampered)) { return -6; }

    var legacy = new WorldState();
    legacy.offlineSessionActive = true;
    legacy.offlinePlayerClass = <uint>5;
    var legacyCasterId = legacy.spawnPlayer(<uint>5, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    if (legacyCasterId == <uint>0) { return -7; }
    applyOfflinePowerWordShield(legacy, legacyCasterId, legacyCasterId, shield, rank);
    var legacyRestored = decodeState(encodeStateVersion(legacy, <uint>109));
    return offlineAbsorbStateIsSchema109Compatible(legacy) &&
        <int>legacyRestored.offlineAbsorbResolvedInitialAmounts[0] == raw.amount &&
        offlineAbsorbTalentSnapshotIsEmpty(legacyRestored, 0) &&
        offlineAbsorbStateIsValid(legacyRestored) ? 1 : -8;
}

// Judgement resolves current talent selection, while the consumed Seal keeps
// the application-time endpoints captured by WOS212.
pub judgementTalentScalingRuntimeStateTest(): int {
    if (judgementTalentScaling.contractTest() != 1 || numericEffects.contractTest() != 1) {
        return -1;
    }
    var retribution = talentSelectionCatalog.specCode("paladin", "retribution");
    var seal = sealOfRighteousnessAbilityCode();
    var judgement = judgementAbilityCode();
    var sealIndex = m4AbilityCatalog.indexOf("seal_of_righteousness");
    var judgementIndex = m4AbilityCatalog.indexOf("judgement");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (retribution == <uint>0 || seal == <uint>0 || judgement == <uint>0 ||
        sealIndex < 0 || judgementIndex < 0 || forestWolf == <uint>0) {
        return -2;
    }

    var baseline = new WorldState();
    baseline.offlineSessionActive = true;
    baseline.offlinePlayerClass = <uint>3;
    var casterId = baseline.spawnPlayer(<uint>2, 20, 0.0, 1.5, 0.0, 500, 7.0, 1);
    var targetId = baseline.spawnMob(forestWolf, 20, 0.0, 1.5, 8.0, 10000, 7.0);
    var sealRank = m4AbilityCatalog.rankAtLevel(sealIndex, 20);
    if (casterId == <uint>0 || targetId == <uint>0 || sealRank <= 0) { return -3; }
    baseline.entityResources[0] = 500;
    baseline.entityMaxResources[0] = 500;
    baseline.entitySpellPower[0] = 0;
    baseline.entityCritChance[0] = 0.0;
    baseline.entityTargetIds[0] = targetId;
    baseline.entityKnownAbilityCodes.add(seal);
    baseline.entityKnownAbilityCodes.add(judgement);
    var knownOffset = 1;
    while (knownOffset < baseline.entityKnownAbilityOffsets.length) {
        baseline.entityKnownAbilityOffsets[knownOffset] = <uint>2;
        knownOffset = knownOffset + 1;
    }
    applyOfflineSealOfRighteousness(baseline, 0, <uint>sealRank);
    var retainedMinimum = <int>baseline.entityImbueResolvedJudgementMinimums[0];
    var retainedMaximum = <int>baseline.entityImbueResolvedJudgementMaximums[0];
    var scaled = decodeState(encodeState(baseline));
    if (!replaceOfflineTalentAllocation(
            scaled, 0, retribution, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || <int>scaled.entityImbueResolvedJudgementMinimums[0] != retainedMinimum ||
        <int>scaled.entityImbueResolvedJudgementMaximums[0] != retainedMaximum) {
        return -4;
    }
    var resolved = judgementTalentScaling.resolveJudgement(
        offlineTalentModifiersForEntity(scaled, 0), "holy", "judgement"
    );
    if (resolved.damageMultiplier <= 1.0 || resolved.flatDamage != 0.0) { return -5; }

    startOfflineJudgementCast(baseline, 0, targetId);
    startOfflineJudgementCast(scaled, 0, targetId);
    var baselineDamage = 10000 - <int>baseline.entityHp[1];
    var scaledDamage = 10000 - <int>scaled.entityHp[1];
    return <uint>baseline.entityImbueAbilityCodes[0] == <uint>0 &&
        <uint>scaled.entityImbueAbilityCodes[0] == <uint>0 &&
        baseline.rngDraws == <uint>2 && scaled.rngDraws == <uint>2 &&
        baselineDamage > 0 && scaledDamage > baselineDamage ? 1 : -6;
}

