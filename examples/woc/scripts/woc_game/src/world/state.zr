// Drain Life bills at channel start, releases a live-target-checked Shadow bolt
// on each fixed pulse, then heals the caster for the landed damage without a
// heal crit or spell-resist draw. Its last fixed-count pulse is flushed before
// the target lock is cleared.
pub drainLifeCommandStateTest(): int {
    if (spellScaling.contractTest() != 1 || healState.contractTest() != 1) { return -1; }
    var drainLife = drainLifeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("drain_life");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (drainLife == <uint>0 || abilityIndex != 7 || forestWolf == <uint>0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "drain_life" ||
        m4AbilityCatalog.text(abilityIndex, "class") != "warlock" ||
        !drainLifeProjectileProfileIsValid(<uint>1, 7.0, 7.0, 0.0)) {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>8, 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 100, 8.0);
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityHp[0] = 50;
    state.entityResources[0] = 35;
    state.entityMaxResources[0] = 35;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(drainLife);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <int>state.entityResources[0] != 0 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != drainLife ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 5.0) ||
        !floatMatches(<float>state.entityCastTotal[0], 5.0) ||
        (<uint>state.entityCastingFlags[0] & <uint>1) == <uint>0 ||
        !floatMatches(<float>state.entityChannelTickEvery[0], 1.0) ||
        !floatMatches(<float>state.entityChannelTickTimer[0], 1.0) ||
        <int>state.entityChannelTicksLeft[0] != 5 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5)) {
        return -3;
    }

    // A retained incoming hit applies the source channel fraction (25%) and
    // leaves castTotal fixed. Reset the test clock afterward to observe its
    // ordinary first one-second pulse independently.
    applyOfflineDamageCastPushback(state, 0, 1);
    if (!floatMatches(<float>state.entityCastRemaining[0], 3.75) ||
        !floatMatches(<float>state.entityCastTotal[0], 5.0)) {
        return -4;
    }
    state.entityCastRemaining[0] = 5.0;

    var launched = decodeState(encodeState(state));
    var castTicks = 0;
    while (castTicks < 20) {
        stepRetainedCasting(launched, 0, false);
        castTicks = castTicks + 1;
    }
    if (<uint>launched.rngDraws != <uint>0 ||
        <uint>launched.entityCastingAbility[0] != drainLife ||
        <int>launched.entityCastChannelTicks[0] != 1 ||
        <int>launched.entityChannelTicksLeft[0] != 4 ||
        launched.offlineProjectileSourceIds.length != 1 ||
        <uint>launched.offlineProjectileSourceIds[0] != playerId ||
        <uint>launched.offlineProjectileTargetIds[0] != targetId ||
        <uint>launched.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
        <float>launched.offlineProjectileMinimums[0] != 7.0 ||
        <float>launched.offlineProjectileMaximums[0] != 7.0 ||
        <uint>launched.offlineProjectileAbilityCodes[0] != drainLife ||
        <uint>launched.offlineProjectileRanks[0] != <uint>1 ||
        <float>launched.offlineProjectileCastTimes[0] != 0.0) {
        return -5;
    }

    var flightTicks = 0;
    while (launched.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(launched);
        flightTicks = flightTicks + 1;
    }
    if (launched.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>launched.rngDraws != <uint>1 || <int>launched.entityHp[1] != 93 ||
        <int>launched.entityHp[0] != 57 ||
        stateThreatValue(launched, 1, playerId) <= 7.0 ||
        !<bool>launched.entityInCombat[0] || !<bool>launched.entityInCombat[1]) {
        return -6;
    }

    // A completion with four ticks left flushes each remaining bolt before it
    // clears the retained target lock, matching updateCasting's fixed-count loop.
    launched.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(launched, 0, false);
    if (<uint>launched.entityCastingAbility[0] != <uint>0 ||
        <uint>launched.entityCastTargetIds[0] != <uint>0 ||
        <int>launched.entityCastChannelTicks[0] != 5 ||
        launched.offlineProjectileSourceIds.length != 4) {
        return -7;
    }

    launched.entityCastGcdRemaining[0] = 0.0;
    launched.entityResources[0] = 35;
    var drainLifeBytes = new container.Array<uint>();
    drainLifeBytes.add(<uint>100);
    drainLifeBytes.add(<uint>114);
    drainLifeBytes.add(<uint>97);
    drainLifeBytes.add(<uint>105);
    drainLifeBytes.add(<uint>110);
    drainLifeBytes.add(<uint>95);
    drainLifeBytes.add(<uint>108);
    drainLifeBytes.add(<uint>105);
    drainLifeBytes.add(<uint>102);
    drainLifeBytes.add(<uint>101);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, drainLifeBytes, targetId
    );
    launched.applyCommands(typed, 1);
    return <int>launched.entityResources[0] == 0 &&
        <uint>launched.entityCastingAbility[0] == drainLife &&
        <uint>launched.entityCastTargetIds[0] == targetId &&
        <uint>launched.entityLastCommandSequence[0] == <uint>2 ? 1 : -8;
}

