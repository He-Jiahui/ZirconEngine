arcaneShotTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_shot");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var level = <int>state.entityLevels[casterIndex];
    var minimum = m4AbilityCatalog.metric(abilityIndex, level, "minRange");
    var maximum = m4AbilityCatalog.metric(abilityIndex, level, "range");
    var distanceSquared = dx * dx + dz * dz;
    return distanceSquared >= minimum * minimum && distanceSquared <= maximum * maximum &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <=
            OFFLINE_SOURCE_TARGET_FACING_HALF_ARC ? targetIndex : -1;
}

aimedShotCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    var base = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    );
    var modifiers = offlineTalentModifiersForEntity(state, casterIndex);
    return base * (1.0 + talentModifiers.abilityField(modifiers, "aimed_shot", "castPct"));
}

aimedShotTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("aimed_shot");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var distanceSquared = dx * dx + dz * dz;
    var level = <int>state.entityLevels[casterIndex];
    var minimum = m4AbilityCatalog.metric(abilityIndex, level, "minRange");
    var maximum = m4AbilityCatalog.metric(abilityIndex, level, "range");
    return distanceSquared >= minimum * minimum && distanceSquared <= maximum * maximum &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <=
            OFFLINE_SOURCE_TARGET_FACING_HALF_ARC ? targetIndex : -1;
}

// The source stores the target for the hard cast then rechecks only the normal
// completion range slack before it launches the arrow. The dead-zone and facing
// gates are launch-time admission checks, not projectile cancellation rules.
aimedShotCompletionTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("aimed_shot");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var maximum = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    maximum = maximum + 2.0;
    return dx * dx + dz * dz <= maximum * maximum ? targetIndex : -1;
}

startOfflineAimedShotCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = aimedShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("aimed_shot");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!aimedShotProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost ||
        aimedShotTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        aimedShotCastSeconds(state, casterIndex, abilityIndex),
        OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS,
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineAimedShotCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = aimedShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("aimed_shot");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = aimedShotCompletionTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!aimedShotProfileIsValid(abilityIndex, level) || rank != 1 ||
        <float>state.entityResources[casterIndex] < cost ||
        effects.typeAt(abilityIndex, rank, 0) != "directDamage") {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        effects.metric(abilityIndex, rank, 0, "min"),
        effects.metric(abilityIndex, rank, 0, "max"),
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_PHYSICAL,
        abilityCode,
        <uint>rank,
        aimedShotCastSeconds(state, casterIndex, abilityIndex)
    );
}

