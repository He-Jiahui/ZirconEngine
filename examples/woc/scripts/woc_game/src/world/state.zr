    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 1000, 8.0);
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 35;
    state.entityMaxResources[0] = 35;
    state.entitySpellPower[0] = 100;
    state.entityCritChance[0] = 0.0;
    state.entityHitBonus[0] = 1.0;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(searingPain);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <float>state.entityResources[0] != 35 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != searingPain ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 1.5) ||
        !floatMatches(<float>state.entityCastTotal[0], 1.5) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        state.offlineProjectileSourceIds.length != 0) {
        return -3;
    }

    var restored = decodeState(encodeState(state));
    restored.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(restored, 0, false);
    if (<int>restored.entityResources[0] != 0 || <uint>restored.rngDraws != <uint>0 ||
        <uint>restored.entityCastingAbility[0] != <uint>0 ||
        <uint>restored.entityCastTargetIds[0] != <uint>0 ||
        restored.offlineProjectileSourceIds.length != 1 ||
        <uint>restored.offlineProjectileSourceIds[0] != playerId ||
        <uint>restored.offlineProjectileTargetIds[0] != targetId ||
