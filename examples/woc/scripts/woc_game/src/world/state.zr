    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] != abilityCode || rank <= 0) { return; }
    var resist = new spellResist.SpellResistState(); resist.casterLevel = <int>state.entityLevels[casterIndex]; resist.targetLevel = <int>state.entityLevels[targetIndex]; resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0; resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) { enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex); return; }
    var result = new timedSpell.TimedSpellResult(); result.randomUnits.add(nextAuthoritativeRandomUnit(state)); result.randomUnits.add(nextAuthoritativeRandomUnit(state)); var spell = new timedSpell.TimedSpellSpec(); spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex]; spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex]; spell.spellPower = <float>state.entitySpellPower[casterIndex]; spell.school = "fire"; spell.castTime = 0.0; spell.critChance = offlineDamageCritChance(state, casterIndex); timedSpell.resolveTimedSpellHit(result, spell);
