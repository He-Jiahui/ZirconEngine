    batch.commandPayloadBytes.add((itemLength >> 16) & <uint>255);
    batch.commandPayloadBytes.add((itemLength >> 24) & <uint>255);
    var byteIndex = 0;
    while (byteIndex < <int>itemLength) {
        batch.commandPayloadBytes.add(catalog.itemIdUtf8Byte(itemIndex, byteIndex));
        byteIndex = byteIndex + 1;
    }
    batch.commandPayloadBytes.add(slotCode);
}

