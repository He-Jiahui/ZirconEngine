    bytes.add(<uint>118); bytes.add(<uint>101); bytes.add(<uint>95); bytes.add(<uint>115);
    bytes.add(<uint>104); bytes.add(<uint>111); bytes.add(<uint>116);
    var typedCommand = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typedCommand, typedPlayer, <uint>1, <uint>1, bytes, typedTarget
