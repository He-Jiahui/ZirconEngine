        return -6;
    }
    var normalizeDeparted = new CommandBatch();
    appendPartyMasterLootCommandForTest(
        normalizeDeparted, leader, <uint>1, <uint>5, true, third, <uint>0
    );
    restored.applyCommands(normalizeDeparted, 1);
