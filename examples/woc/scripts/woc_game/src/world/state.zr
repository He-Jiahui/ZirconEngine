    return code;
}

hurricanePayloadAbilityIsExact(bytes: container.Array<uint>, offset: uint, length: uint): bool {
    return length == <uint>9 && <uint>bytes[<int>offset] == <uint>104 &&
        <uint>bytes[<int>(offset + <uint>1)] == <uint>117 &&
        <uint>bytes[<int>(offset + <uint>2)] == <uint>114 &&
        <uint>bytes[<int>(offset + <uint>3)] == <uint>114 &&
        <uint>bytes[<int>(offset + <uint>4)] == <uint>105 &&
        <uint>bytes[<int>(offset + <uint>5)] == <uint>99 &&
        <uint>bytes[<int>(offset + <uint>6)] == <uint>97 &&
        <uint>bytes[<int>(offset + <uint>7)] == <uint>110 &&
        <uint>bytes[<int>(offset + <uint>8)] == <uint>101;
}

hurricaneProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 && level >= 18 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "druid" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "nature" &&
        m4AbilityCatalog.text(abilityIndex, "targetMode") == "position" &&
        !m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 90.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 12.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 30.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "channelDuration") == 6.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "channelTicks") == 6.0 &&
        effects.typeAt(abilityIndex, 1, 0) == "aoeDamage" &&
        effects.metric(abilityIndex, 1, 0, "min") == 12.0 &&
        effects.metric(abilityIndex, 1, 0, "max") == 16.0 &&
        effects.metric(abilityIndex, 1, 0, "radius") == 8.0;
}

