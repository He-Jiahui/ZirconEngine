        targetIndex : -1;
}

hibernateCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

hibernateGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineHibernateCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = hibernateAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("hibernate");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = <uint>m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var castTime = m4AbilityCatalog.metric(abilityIndex, level, "castTime");
    if (!hibernateProjectileProfileIsValid(rank, castTime) ||
        <float>state.entityResources[casterIndex] < cost ||
        hibernateTargetIndex(state, casterIndex, targetId) < 0) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        hibernateCastSeconds(state, casterIndex, abilityIndex),
        hibernateGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineHibernateCast(state: WorldState, casterIndex: int): void {
    var abilityCode = hibernateAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("hibernate");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = hibernateCompletionTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = <uint>m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var castTime = m4AbilityCatalog.metric(abilityIndex, level, "castTime");
    if (!hibernateProjectileProfileIsValid(rank, castTime) ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    spendOfflineAbilityResource(state, casterIndex, cost);
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        0.0,
        0.0,
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_NATURE,
        abilityCode,
        rank,
        castTime
    );
}

// Tiger's Fury is a normal-GCD Cat-form self buff. The source applies one
// `buff_ap` aura then recalculates player stats; WOC preserves the base row
// and projects that short-lived contribution through effective attack power.
startOfflineTigersFuryCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = tigersFuryAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("tigers_fury");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state,
            casterIndex,
            abilityCode,
            forms.formKindForAbilityCode(
                <uint>state.entityActiveFormAbilityCodes[casterIndex]
            ),
            false
        )) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!tigersFuryProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rakeGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
    applyOfflineMotionAuraWithDetails(
        state,
        casterIndex,
        abilityCode,
        <uint>state.entityIds[casterIndex],
        ccContract.motionAuraKindCode("buff_ap"),
        effects.metric(abilityIndex, 1, 0, "duration"),
        <float>captureOfflineTigersFuryTalentState(state, casterIndex),
        0.0
    );
}

ripTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("rip");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    if (range <= 0.0) { range = 5.0; }
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <=
            2.2 ? targetIndex : -1;
}

// Rip is an immediate Cat finisher: the source applies its physical DoT and
// enters combat before consuming the previously admitted combo points. Unlike
// pure spells, its zero range is a melee contact gate and creates no projectile
// or spell-resist/RNG event.
startOfflineRipCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = ripAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("rip");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <int>state.entityComboPoints[casterIndex] <= 0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode,
            forms.formKindForAbilityCode(<uint>state.entityActiveFormAbilityCodes[casterIndex]), false)) {
        return;
    }
    var targetIndex = ripTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = <uint>m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (targetIndex < 0 || rank == <uint>0 || !ripProfileIsValid(abilityIndex, level) ||
        effects.count(abilityIndex, <int>rank) != 1 ||
        effects.typeAt(abilityIndex, <int>rank, 0) != "dot" ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    var resolvedTotal = offlineTalentDotResolvedTotal(
        state, <uint>state.entityIds[casterIndex], abilityCode, rank
    );
    var profile = numericEffects.resolvePureDotProfile(
        abilityIndex,
        <int>rank,
        0,
        0,
        <int>effectiveOfflineAttackPower(state, casterIndex)
    );
    if (!profile.valid || resolvedTotal <= 0) { return; }
    profile = numericEffects.dotProfileFromResolvedTotal(
        abilityIndex, <int>rank, 0, profile.snapshotPower, resolvedTotal
    );
    if (!profile.valid) { return; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rakeGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    clearOfflineProwl(state, casterIndex);
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    appendOfflinePureDot(
        state,
        <uint>state.entityIds[targetIndex],
        <uint>state.entityIds[casterIndex],
        abilityCode,
        rank,
        profile.snapshotPower,
        resolvedTotal,
        -1,
        profile.damage,
        profile.duration,
        profile.interval
    );
    // runEffects consumes a successfully spent finisher only after every
    // effect has observed the original combo amount.
    state.entityComboPoints[casterIndex] = 0;
}

startOfflineDashCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
