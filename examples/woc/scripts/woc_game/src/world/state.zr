completeOfflineGhostWolfCast(state: WorldState, casterIndex: int): void {
    var abilityCode = ghostWolfAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("ghost_wolf");
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || abilityIndex < 0) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!ghostWolfProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode)) {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    toggleOfflineGhostWolf(state, casterIndex);
}

judgementAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("judgement");
    var abilityIndex = m4AbilityCatalog.indexOf("judgement");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "judgement") {
        throw "Judgement is absent from the current ability catalog";
    }
    return code;
}

judgementPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>9 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>106 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>100 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>103 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116;
}

judgementTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("judgement");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

judgementGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    return sealOfRighteousnessGlobalCooldownSeconds(state, casterIndex);
}

startOfflineJudgementCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var abilityCode = judgementAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("judgement");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        <uint>state.entityImbueAbilityCodes[casterIndex] !=
            sealOfRighteousnessAbilityCode()) {
        return;
    }
    var targetIndex = judgementTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var sealRank = <uint>state.entityImbueRanks[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (targetIndex < 0 || rank <= 0 ||
        !sealOfRighteousnessProfileIsValid(sealRank) ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = judgementGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );

    // Preserve the source dispatch ordering: remove the Seal before consuming
    // the Judgement range and spell-crit draws.
    var numeric = new numericEffects.NumericDispatchState();
    numeric.source.id = <uint>state.entityIds[casterIndex];
    numeric.source.level = level;
    numeric.source.spellPower = <float>state.entitySpellPower[casterIndex];
    numeric.source.spellCritChance = offlineDamageCritChance(state, casterIndex);
    numeric.source.auraIds.add("seal_of_righteousness");
    numeric.source.auraKinds.add("imbue");
    numeric.source.auraValues.add(offlineImbueBonus(state, casterIndex));
    numeric.source.auraValues2.add(
        <float>state.entityImbueResolvedJudgementMinimums[casterIndex]
    );
    numeric.source.auraValues3.add(
        <float>state.entityImbueResolvedJudgementMaximums[casterIndex]
    );
    numeric.source.auraHasJudgement.add(true);
    var judgementTalent = judgementTalentScaling.resolveJudgement(
        offlineTalentModifiersForEntity(state, casterIndex),
        "holy",
        m4AbilityCatalog.text(abilityIndex, "id")
    );
    numeric.judgementDamageMultiplier = judgementTalent.damageMultiplier;
    numeric.judgementFlatDamage = judgementTalent.flatDamage;
    numeric.target.id = <uint>state.entityIds[targetIndex];
    numeric.target.kind = "mob";
    numeric.target.dead = <bool>state.entityDead[targetIndex];
    numeric.randomUnits.add(nextAuthoritativeRandomUnit(state));
    numeric.randomUnits.add(nextAuthoritativeRandomUnit(state));
    clearOfflineImbue(state, casterIndex);
    if (numericEffects.dispatchNumericAbility(numeric, abilityIndex, rank, 0) != 1 ||
        numeric.source.auraIds.length != 0 || numeric.damageAmounts.length != 1 ||
        <string>numeric.damageSchools[0] != "holy") {
        throw "woc Judgement numeric effect is invalid";
    }
    var damage = <int>numeric.damageAmounts[0];
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage); }
    if (hp > 0) {
        state.setThreat(
            <uint>state.entityIds[targetIndex], <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

sunderArmorAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("sunder_armor");
    var abilityIndex = m4AbilityCatalog.indexOf("sunder_armor");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "sunder_armor") {
        throw "Sunder Armor is absent from the current ability catalog";
    }
    return code;
}

sunderArmorPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>12 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>100 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>114;
}

sunderArmorTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("sunder_armor");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    if (range <= 0.0) { range = 5.0; }
    // The retained Eastbrook rows have no static occluder state; its source
    // outdoor encounter subset therefore has a trivially clear line of sight.
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

sunderArmorGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

enterOfflineSunderArmorCombat(
    state: WorldState, casterIndex: int, targetIndex: int
): void {
    var casterId = <uint>state.entityIds[casterIndex];
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
        enterIdleMobAggro(state, targetIndex, casterId);
    } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
        state.entityAggroTargetIds[targetIndex] = casterId;
    }
}

startOfflineSunderArmorCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = sunderArmorAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("sunder_armor");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var targetIndex = sunderArmorTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (targetIndex < 0 || rank <= 0 ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "sunder") {
        return;
    }
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (<float>state.entityResources[casterIndex] < cost) { return; }

    var cast = loadCastingState(state, casterIndex);
    var gcd = sunderArmorGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);

    // effect_dispatch uses swingMissChance and consumes exactly one draw. The
    // authoritative WOC formula receives the player hit bonus here; its hostile
    // mob cap is deliberately disabled for a player attacking an Eastbrook mob.
    var missed = nextAuthoritativeRandomUnit(state) < mobSwing.sourceSwingMissChance(
        level,
        <int>state.entityLevels[targetIndex],
        false,
        false,
        <float>state.entityHitBonus[casterIndex],
        true
    );
    enterOfflineSunderArmorCombat(state, casterIndex, targetIndex);
    if (missed) { return; }

    var maximum = <int>m4AbilityEffects.metric(abilityIndex, rank, 0, "maxStacks");
    if (maximum < 1 || maximum > 5) {
        throw "woc Sunder Armor stack cap is invalid";
    }
    var stacks = <int>state.entitySunderArmorStacks[targetIndex] + 1;
    state.entitySunderArmorStacks[targetIndex] = stacks > maximum ? maximum : stacks;
    state.entitySunderArmorRemaining[targetIndex] = 30.0;
    state.entitySunderArmorValues[targetIndex] =
        m4AbilityEffects.metric(abilityIndex, rank, 0, "armor");
    // The source applies the physical stance threat modifier. The WOC M4
    // projection has no Warrior stance aura yet, so its representable baseline
    // is the source's neutral multiplier of one.
    var casterId = <uint>state.entityIds[casterIndex];
    state.setThreat(
        <uint>state.entityIds[targetIndex],
        casterId,
        stateThreatValue(state, targetIndex, casterId) +
            m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
        1
    );
}

