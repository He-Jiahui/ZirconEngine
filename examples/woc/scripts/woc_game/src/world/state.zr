    state.entityLevels[0] = 5;
    var optionCode = talentSelectionCatalog.optionCode(
        "warrior", 5, "war_row_double_charge"
    );
    var mageOptionCode = talentSelectionCatalog.optionCode(
        "mage", 5, "mag_r5_ice_floes"
    );
    if (optionCode == <uint>0 || mageOptionCode == <uint>0) {
        return -1;
    }
    var playerId = <uint>state.entityIds[0];
    var payloads = %import("protocol/command_payloads");
    var select = new CommandBatch();
    appendTalentRowCommand(
        select, payloads.selectTalentRowCommandId(true), playerId, <uint>1,
        <uint>1, <uint>5, optionCode
    );
    state.applyCommands(select, 1);
    if (talentRowCodeAt(state, 0, 0) != optionCode ||
        <uint>state.entityLastCommandSequence[0] != <uint>1 ||
        talentRowCodeAt(decodeState(encodeState(state)), 0, 0) != optionCode) {
        return -2;
    }
    var clear = new CommandBatch();
    appendTalentRowCommand(
        clear, payloads.selectTalentRowCommandId(true), playerId, <uint>1,
        <uint>2, <uint>5, <uint>0
    );
    state.applyCommands(clear, 1);
    if (talentRowCodeAt(state, 0, 0) != <uint>0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -3;
    }
    var foreignOption = new CommandBatch();
    appendTalentRowCommand(
        foreignOption, payloads.selectTalentRowCommandId(true), playerId, <uint>1,
        <uint>3, <uint>5, mageOptionCode
    );
    state.applyCommands(foreignOption, 1);
    if (talentRowCodeAt(state, 0, 0) != <uint>0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>3) {
        return -4;
    }
    state.spawnMob(<uint>1, 5, 0.0, 1.5, 0.0, 30, 5.0);
    var mobIndex = state.entityIds.length - 1;
    state.entityAiStates[mobIndex] = <uint>2;
    state.entityTargetIds[mobIndex] = playerId;
    var locked = new CommandBatch();
    appendTalentRowCommand(
        locked, payloads.selectTalentRowCommandId(true), playerId, <uint>1,
        <uint>4, <uint>5, optionCode
    );
    state.applyCommands(locked, 1);
    if (talentRowCodeAt(state, 0, 0) != <uint>0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>4) {
        return -5;
    }
    return 1;
}

