// Corruption is a pure DoT with a source hard cast. The test covers deferred
// billing, one spell-resist draw at impact, snapshot scaling, and both command
// payload paths through an encode/decode boundary.
pub corruptionCommandStateTest(): int {
    if (numericEffects.contractTest() != 1 || spellResist.contractTest() != 1) {
        return -1;
    }
    var corruption = corruptionAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("corruption");
