    state.entityLevels[0] = 5;
    var armsCode = talentSelectionCatalog.specCode("warrior", "arms");
    var row5Code = talentSelectionCatalog.optionCode(
        "warrior", 5, "war_row_double_charge"
    );
    if (armsCode == <uint>0 || row5Code == <uint>0) {
        return -1;
    }
    appendTestOfflineTalentLoadout(
        state, <uint>66, <uint>0, <uint>0, <uint>0, <uint>0, <uint>0,
        <uint>0, <uint>0
    );
    appendTestOfflineTalentLoadout(
        state, <uint>65, armsCode, row5Code, <uint>0, <uint>0, <uint>0,
        <uint>0, <uint>0
    );
    state.offlineTalentActiveLoadoutIndex = 0;
    var encoded = encodeState(state);
    var restored = decodeState(encoded);
    if (restored.offlineTalentLoadoutSpecCodes.length != 2 ||
        restored.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>restored.offlineTalentLoadoutSpecCodes[1] != armsCode ||
        offlineTalentLoadoutRowCodeAt(restored, 1, 0) != row5Code ||
        restored.offlineTalentLoadoutActionBarAbilityCodes.length !=
            2 * talentLoadoutContract.barSlots(true)) {
        return -2;
    }
    var playerId = <uint>state.entityIds[0];
    var payloads = %import("protocol/command_payloads");
    var switchLoadout = new CommandBatch();
    appendLoadoutIndexCommand(
        switchLoadout, payloads.switchLoadoutCommandId(true), playerId, <uint>1,
        <uint>1, <uint>1
    );
    state.applyCommands(switchLoadout, 1);
    if (<uint>state.entityTalentSpecCodes[0] != armsCode ||
        talentRowCodeAt(state, 0, 0) != row5Code ||
        state.offlineTalentActiveLoadoutIndex != 1 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -3;
    }
    var deleteActive = new CommandBatch();
    appendLoadoutIndexCommand(
        deleteActive, payloads.deleteLoadoutCommandId(true), playerId, <uint>1,
        <uint>2, <uint>1
    );
    state.applyCommands(deleteActive, 1);
    var afterDelete = decodeState(encodeState(state));
    if (<uint>state.entityTalentSpecCodes[0] != <uint>0 ||
        state.offlineTalentLoadoutSpecCodes.length != 1 ||
        state.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>state.offlineTalentLoadoutNameBytes[0] != <uint>66 ||
        afterDelete.offlineTalentLoadoutSpecCodes.length != 1 ||
        afterDelete.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -4;
    }
    var missing = new CommandBatch();
    appendLoadoutIndexCommand(
        missing, payloads.switchLoadoutCommandId(true), playerId, <uint>1,
        <uint>3, <uint>5
    );
    state.applyCommands(missing, 1);
    if (state.offlineTalentLoadoutSpecCodes.length != 1 ||
        state.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>3) {
        return -5;
    }
    state.spawnMob(<uint>1, 5, 0.0, 1.5, 0.0, 30, 5.0);
    var mobIndex = state.entityIds.length - 1;
    state.entityAiStates[mobIndex] = <uint>2;
    state.entityTargetIds[mobIndex] = playerId;
    var locked = new CommandBatch();
    appendLoadoutIndexCommand(
        locked, payloads.deleteLoadoutCommandId(true), playerId, <uint>1,
        <uint>4, <uint>0
    );
    state.applyCommands(locked, 1);
    if (state.offlineTalentLoadoutSpecCodes.length != 1 ||
        state.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>4) {
        return -6;
    }
    return 1;
}

