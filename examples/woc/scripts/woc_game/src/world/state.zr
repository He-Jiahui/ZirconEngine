        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        <float>state.entityResources[casterIndex] < 90 ||
        !iceBarrierProfileIsValid(abilityCode)) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = arcanePowerGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    var overloadMultiplier = consumeOfflineOverloadSpell(state, casterIndex, 90);
    spendOfflineAbilityResource(
        state, casterIndex, offlineOverloadBillableCost(90, overloadMultiplier)
    );
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode, state.timeMicros + <uint>30000000
    );
    var playerId = <uint>state.entityIds[casterIndex];
    applyOfflineFixedAbsorb(
        state, playerId, playerId, abilityCode, 1,
        <int>offlineOverloadScaledPositiveMetric(130.0, overloadMultiplier), 60.0
    );
}

