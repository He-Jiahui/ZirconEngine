applyOfflineEntanglingRootsRoot(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    rank: uint
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = entanglingRootsAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("entangling_roots");
    var level = entanglingRootsRankLevel(rank);
    if (abilityIndex < 0 || level <= 0 ||
        !entanglingRootsProjectileProfileIsValid(
            rank, 0.0, 0.0, m4AbilityCatalog.metric(abilityIndex, level, "castTime")
        )) {
        throw "woc Entangling Roots root profile is invalid";
    }
    applyOfflineMotionAura(
        state,
        targetIndex,
        abilityCode,
        sourceId,
        ccContract.motionAuraKindCode("root"),
        effects.metric(abilityIndex, <int>rank, 0, "duration")
    );
}

landOfflineEntanglingRootsProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = entanglingRootsAbilityCode();
    var rank = <uint>state.offlineProjectileRanks[projectileIndex];
    if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] != abilityCode ||
        <uint>state.offlineProjectileSchoolCodes[projectileIndex] !=
            OFFLINE_PROJECTILE_SCHOOL_NATURE ||
        !entanglingRootsProjectileProfileIsValid(
            rank,
            <float>state.offlineProjectileMinimums[projectileIndex],
            <float>state.offlineProjectileMaximums[projectileIndex],
            <float>state.offlineProjectileCastTimes[projectileIndex]
        )) {
        return;
    }

    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }

    applyOfflineEntanglingRootsRoot(
        state,
        targetIndex,
        <uint>state.entityIds[casterIndex],
        rank
    );
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (rank == <uint>2) {
        var abilityIndex = m4AbilityCatalog.indexOf("entangling_roots");
        var duration = effects.metric(abilityIndex, 2, 1, "duration");
        var interval = effects.metric(abilityIndex, 2, 1, "interval");
        var snapshotPower = <int>state.entitySpellPower[casterIndex];
        var resolvedTotal = offlineTalentDotProjectileResolvedTotal(state, projectileIndex);
        var profile = numericEffects.dotProfileFromResolvedTotal(
            abilityIndex, 2, 1, snapshotPower, resolvedTotal
        );
        if (!profile.valid) { return; }
        appendOfflineEntanglingRootsDot(
            state,
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            rank,
            snapshotPower,
            resolvedTotal,
            projectileIndex,
            profile.damage,
            profile.duration,
            profile.interval
        );
    }
}

