arcanePowerProfileIsValid(abilityCode: uint): bool {
    return abilityCode == arcanePowerAbilityCode();
}

overloadProfileIsValid(abilityCode: uint): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("overload");
    return abilityCode == overloadAbilityCode() && abilityIndex >= 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, 14) == 1 &&
        m4AbilityCatalog.metric(abilityIndex, 14, "learnLevel") == 14.0 &&
        m4AbilityCatalog.metric(abilityIndex, 14, "cost") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, 14, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, 14, "cooldown") == 30.0 &&
        m4AbilityCatalog.text(abilityIndex, "school") == "arcane" &&
        m4AbilityCatalog.flag(abilityIndex, "offGcd") &&
        effects.typeAt(abilityIndex, 1, 0) == "selfBuff" &&
        effects.text(abilityIndex, 1, 0, "kind") == "overload" &&
        effects.metric(abilityIndex, 1, 0, "value") == 0.4 &&
        effects.metric(abilityIndex, 1, 0, "duration") == 10.0;
}

powerEchoAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("power_echo");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) ||
        knownAbilityCatalog.abilityClassId(<int>code) != "mage") {
        throw "Power Echo is absent from the current ability catalog";
    }
    return code;
}

powerEchoPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>10 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>119 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>111;
}

powerEchoProfileIsValid(abilityCode: uint): bool {
    var optionCode = talentSelectionCatalog.optionCode(
        "mage", 14, "mag_r14_power_echo"
    );
    return abilityCode == powerEchoAbilityCode() && optionCode != <uint>0 &&
        talentSelectionCatalog.optionMatchesClassRow("mage", 14, optionCode);
}

arcanePowerSpellHasteBonus(state: WorldState, casterIndex: int): float {
    return casterIndex >= 0 && casterIndex < state.entityIds.length &&
        <float>state.entityArcanePowerSpellHasteRemaining[casterIndex] > 0.0 ?
            0.1 : 0.0;
}

arcanePowerGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS ?
        OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS : gcd;
}

startOfflineArcanePowerCast(state: WorldState, casterIndex: int): void {
    var abilityCode = arcanePowerAbilityCode();
    if (!state.offlineSessionActive ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false) ||
        !arcanePowerProfileIsValid(abilityCode)) {
        return;
    }
    // Source calculates the normal GCD before the two self auras take effect.
    var preBuffGcd = arcanePowerGlobalCooldownSeconds(state, casterIndex);
    var cast = loadCastingState(state, casterIndex);
    if (preBuffGcd > cast.gcdRemaining) { cast.gcdRemaining = preBuffGcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    state.entityArcanePowerRemaining[casterIndex] = 10.0;
    state.entityArcanePowerSpellHasteRemaining[casterIndex] = 10.0;
    state.entitySpellDamageMultipliers[casterIndex] = 1.2;
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode, state.timeMicros + <uint>90000000
    );
}

startOfflineOverloadCast(state: WorldState, casterIndex: int): void {
    var abilityCode = overloadAbilityCode();
    if (!state.offlineSessionActive ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
