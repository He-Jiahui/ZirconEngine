        while (pendingLootRollIndex < <int>pendingLootRollCount) {
            state.pendingLootRollIds.add(reader.u64(1, 1, 2, 4));
            state.pendingLootRollMobIds.add(reader.u64(1, 1, 2, 4));
            state.pendingLootRollItemCodes.add(reader.u16(1, 1));
            state.pendingLootRollQualityCodes.add(reader.byte(1));
            state.pendingLootRollExpiresAtMicros.add(reader.u64(1, 1, 2, 4));
            state.pendingLootRollMasterLooterIds.add(reader.u64(1, 1, 2, 4));
            pendingLootRollIndex = pendingLootRollIndex + 1;
        }
        var candidateRowCount = reader.u16(1, 1);
        if (candidateRowCount > <uint>10240) {
            throw "woc loot roll candidate count exceeds WOS cap";
        }
        var lootRollCandidateIndex = 0;
        while (lootRollCandidateIndex < <int>candidateRowCount) {
            state.lootRollCandidateRollIds.add(reader.u64(1, 1, 2, 4));
            state.lootRollCandidatePlayerIds.add(reader.u64(1, 1, 2, 4));
            state.lootRollCandidateChoiceCodes.add(reader.byte(1));
            state.lootRollCandidateValues.add(reader.byte(1));
            lootRollCandidateIndex = lootRollCandidateIndex + 1;
        }
    }
    if (schemaVersion >= <uint>71) {
        var partyLootTurnCount = reader.u16(1, 1);
        if (partyLootTurnCount > <uint>1024) {
            throw "woc party loot turn count exceeds WOS cap";
        }
        var partyLootTurnIndex = 0;
        while (partyLootTurnIndex < <int>partyLootTurnCount) {
            state.partyLootTurnPartyIds.add(reader.u64(1, 1, 2, 4));
            state.partyLootTurnValues.add(reader.u64(1, 1, 2, 4));
            partyLootTurnIndex = partyLootTurnIndex + 1;
        }
        var corpseLootRecipientCount = reader.u16(1, 1);
        if (corpseLootRecipientCount > <uint>10240) {
            throw "woc corpse loot recipient count exceeds WOS cap";
        }
        var corpseLootRecipientIndex = 0;
        while (corpseLootRecipientIndex < <int>corpseLootRecipientCount) {
            state.corpseLootRecipientMobIds.add(reader.u64(1, 1, 2, 4));
            state.corpseLootRecipientPlayerIds.add(reader.u64(1, 1, 2, 4));
            state.corpseLootRecipientOrders.add(reader.byte(1));
            corpseLootRecipientIndex = corpseLootRecipientIndex + 1;
        }
    }
    if (!partyMarkerStateIsValid(state)) {
        throw "woc party marker state is invalid";
    }
    if (!partyMasterLootStateIsValid(state)) {
        throw "woc party master loot state is invalid";
    }
    if (!lootRollStateIsValid(state)) {
        throw "woc loot roll state is invalid";
    }
    if (!partyLootDistributionStateIsValid(state)) {
        throw "woc party loot distribution state is invalid";
    }
    reader.finish(true);
    if (schemaVersion < <uint>48) {
        migrateWos47QuestBoarHidesToInventory(state);
    } else if (!offlineQuestInventoryStateIsValid(state)) {
        throw "woc WOS48 inventory-derived quest state is invalid";
    }
    ensureOfflineQuestNpcs(state);
    return state;
}

advanceState(state: WorldState, tick: uint, generation: uint, marker: int): void {
    if (marker != 1) {
        throw "woc world state advance marker is invalid";
    }
    if (tick != state.tick + <uint>1) {
        throw "woc fixed tick is not the next authoritative tick";
    }
    if (generation != state.generation && generation != state.generation + <uint>1) {
        throw "woc fixed tick generation is neither current nor the next reload generation";
    }
    state.tick = tick;
    state.timeMicros = state.timeMicros + <uint>50000;
    state.generation = generation;
}

movementColumnsMatch(input: binary.TickInput): bool {
    var count = input.movementFrameCount;
    return count >= 0 && input.movementActorIds.length == count &&
        input.movementActorGenerations.length == count &&
        input.movementSequences.length == count && input.movementForward.length == count &&
        input.movementBack.length == count && input.movementTurnLeft.length == count &&
        input.movementTurnRight.length == count && input.movementStrafeLeft.length == count &&
        input.movementStrafeRight.length == count && input.movementJump.length == count &&
        input.movementFacingPresent.length == count && input.movementFacing.length == count;
}

clearHeldMovement(state: WorldState, entityIndex: int): void {
    state.entityMovementForward[entityIndex] = false;
    state.entityMovementBack[entityIndex] = false;
    state.entityMovementTurnLeft[entityIndex] = false;
    state.entityMovementTurnRight[entityIndex] = false;
    state.entityMovementStrafeLeft[entityIndex] = false;
    state.entityMovementStrafeRight[entityIndex] = false;
    state.entityMovementJump[entityIndex] = false;
}

applyMovementFrames(state: WorldState, input: binary.TickInput, acceptedTick: uint): void {
    if (!movementColumnsMatch(input)) {
        throw "woc movement frame columns have different lengths";
    }
    var previousActorId: uint = <uint>0;
    var previousActorGeneration: uint = <uint>0;
    var frameIndex = 0;
    while (frameIndex < input.movementFrameCount) {
        var actorId = <uint>input.movementActorIds[frameIndex];
        var actorGeneration = <uint>input.movementActorGenerations[frameIndex];
        var sequence = <uint>input.movementSequences[frameIndex];
        if (actorId == <uint>0 || sequence == <uint>0 ||
            (frameIndex > 0 && (actorId < previousActorId ||
                (actorId == previousActorId && actorGeneration <= previousActorGeneration)))) {
            throw "woc movement frame identity or order is invalid";
        }
        previousActorId = actorId;
        previousActorGeneration = actorGeneration;
        var entityIndex = 0;
        while (entityIndex < state.entityIds.length &&
            <uint>state.entityIds[entityIndex] != actorId) {
            entityIndex = entityIndex + 1;
        }
        if (entityIndex >= state.entityIds.length ||
            <uint>state.entityGenerations[entityIndex] != actorGeneration ||
            <uint>state.entityKinds[entityIndex] != <uint>1) {
            throw "woc movement actor reference is invalid";
        }
        if (sequence > <uint>state.entityMovementAcknowledgements[entityIndex]) {
            state.entityMovementAcknowledgements[entityIndex] = sequence;
        }
        state.entityMovementAcceptedTicks[entityIndex] = acceptedTick;
        state.entityMovementForward[entityIndex] = <bool>input.movementForward[frameIndex];
        state.entityMovementBack[entityIndex] = <bool>input.movementBack[frameIndex];
        state.entityMovementTurnLeft[entityIndex] = <bool>input.movementTurnLeft[frameIndex];
        state.entityMovementTurnRight[entityIndex] = <bool>input.movementTurnRight[frameIndex];
        state.entityMovementStrafeLeft[entityIndex] = <bool>input.movementStrafeLeft[frameIndex];
        state.entityMovementStrafeRight[entityIndex] = <bool>input.movementStrafeRight[frameIndex];
        state.entityMovementJump[entityIndex] = <bool>input.movementJump[frameIndex];
        if (<bool>input.movementFacingPresent[frameIndex]) {
            state.entityFacing[entityIndex] = playerMotion.normalizeFacing(
                <float>input.movementFacing[frameIndex], true
            );
        }
        frameIndex = frameIndex + 1;
    }
}

clearStaleMovement(state: WorldState, currentTick: uint): void {
    var index = 0;
    while (index < state.entityIds.length) {
        var acknowledgement = <uint>state.entityMovementAcknowledgements[index];
        var acceptedTick = <uint>state.entityMovementAcceptedTicks[index];
        if (acknowledgement != <uint>0 && currentTick >= acceptedTick &&
            currentTick - acceptedTick > <uint>15) {
            clearHeldMovement(state, index);
        }
        index = index + 1;
    }
}

// Source updateResurrectionOffers runs once per simulation update. It removes
// proposals whose target is no longer dead as well as proposals expiring at the
// current authoritative time; later effect dispatch can create proposals before
// this shared sweep without retaining another timing path.
clearExpiredResurrectionOffers(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<bool>state.entityResurrectionOfferPresent[index] &&
            (!<bool>state.entityDead[index] ||
                state.timeMicros >= <uint>state.entityResurrectionOfferExpiresAtMicros[index])) {
            clearOfflineResurrectionOffer(state, index);
        }
        index = index + 1;
    }
}

tickResurrectionSickness(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <uint>state.entityResurrectionSicknessMicros[index];
        if (remaining != <uint>0) {
            state.entityResurrectionSicknessMicros[index] = remaining <= <uint>50000 ?
                <uint>0 : remaining - <uint>50000;
        }
        index = index + 1;
    }
}

retainedPlayerMovementSpeedMultiplier(state: WorldState, index: int): float {
    var speedMultiplier = <float>state.entityMoveSpeed[index] / playerMotion.runSpeed(true);
    // The source returns from its ghost branch before scanning any aura, so an
    // active form cannot alter dead-player movement.
    if (<bool>state.entityGhost[index]) {
        return speedMultiplier * 1.25;
    }
    return speedMultiplier * motionAuras.movementMultiplierWithStealth(
        frostboltSlowMultiplier(),
        offlineProwlIsActive(state, index) ? <float>state.entityProwlValues[index] : 1.0,
        formDerivedStats.formMovementSpeedMultiplier(
            <uint>state.entityActiveFormAbilityCodes[index]
        ),
        state.entityMotionAuraAbilityCodes,
        state.entityMotionAuraSourceIds,
        state.entityMotionAuraKindCodes,
        state.entityMotionAuraRemaining,
        state.entityMotionAuraValues,
        <int><uint>state.entityMotionAuraOffsets[index],
        <int><uint>state.entityMotionAuraOffsets[index + 1],
        true
    );
}

stepRetainedPlayerMovement(
    state: WorldState,
    index: int,
    stunned: bool,
    rooted: bool
): void {
    var transition = new motionTransition.PlayerMotionState();
    motionTransition.initialize(
        transition,
        <float>state.entityX[index],
        <float>state.entityY[index],
        <float>state.entityZ[index],
        <float>state.entityFacing[index],
        <float>state.entityVelocityX[index],
        <float>state.entityVelocityY[index],
        <float>state.entityVelocityZ[index],
        <bool>state.entityOnGround[index],
        <bool>state.entityJumping[index],
        <float>state.entityFallStartY[index],
        true
    );
    var speedMultiplier = retainedPlayerMovementSpeedMultiplier(state, index);
    motionTransition.step(
        transition,
        <bool>state.entityMovementTurnLeft[index],
        <bool>state.entityMovementTurnRight[index],
        <bool>state.entityMovementForward[index],
        <bool>state.entityMovementBack[index],
        <bool>state.entityMovementStrafeLeft[index],
        <bool>state.entityMovementStrafeRight[index],
        <bool>state.entityMovementJump[index],
        stunned,
        rooted,
        speedMultiplier,
        1.0,
        <int>state.entityMaxHp[index],
        state.worldSeed,
        true
    );
    state.entityX[index] = transition.x;
    state.entityY[index] = transition.y;
    state.entityZ[index] = transition.z;
    state.entityPreviousX[index] = transition.previousX;
    state.entityPreviousY[index] = transition.previousY;
    state.entityPreviousZ[index] = transition.previousZ;
    state.entityFacing[index] = transition.facing;
    state.entityPreviousFacing[index] = transition.previousFacing;
    state.entityVelocityX[index] = transition.velocityX;
    state.entityVelocityY[index] = transition.velocityY;
    state.entityVelocityZ[index] = transition.velocityZ;
    state.entityFallStartY[index] = transition.fallStartY;
    state.entityOnGround[index] = transition.onGround;
    state.entityJumping[index] = transition.jumping;
    if (!<bool>state.entityGhost[index] && transition.landingDamage > 0) {
        var hp = <int>state.entityHp[index] - transition.landingDamage;
        state.entityHp[index] = hp > 0 ? hp : 0;
        if (hp <= 0) {
            state.entityDead[index] = true;
            clearQueuedOnSwing(state, index);
            clearOfflineComboPoints(state, index);
            clearHeldMovement(state, index);
        }
    }
}

loadCastingState(state: WorldState, index: int): casting.CastState {
    var cast = new casting.CastState();
    var flags = <uint>state.entityCastingFlags[index];
    cast.castingAbility = <uint>state.entityCastingAbility[index];
    cast.castRemaining = <float>state.entityCastRemaining[index];
    cast.castTotal = <float>state.entityCastTotal[index];
    cast.channeling = (flags & <uint>1) != <uint>0;
    cast.castAimLocked = (flags & <uint>2) != <uint>0;
    cast.castTargetLocked = (flags & <uint>4) != <uint>0;
    cast.castSchoolPhysical = (flags & <uint>8) != <uint>0;
    cast.fishing = (flags & <uint>16) != <uint>0;
    cast.stunned = (flags & <uint>32) != <uint>0;
    cast.silenced = (flags & <uint>64) != <uint>0;
    cast.schoolLockedOut = (flags & <uint>128) != <uint>0;
    cast.castShield = (flags & <uint>256) != <uint>0;
    cast.queuedChanneling = (flags & <uint>512) != <uint>0;
    cast.queuedPhysical = (flags & <uint>1024) != <uint>0;
    cast.queuedFishing = (flags & <uint>2048) != <uint>0;
    cast.queuedAimLocked = (flags & <uint>4096) != <uint>0;
    cast.massResurrection = (flags & <uint>8192) != <uint>0;
    cast.inCombat = (flags & <uint>16384) != <uint>0;
    cast.hasDeadGroupMember = (flags & <uint>32768) != <uint>0;
    cast.channelTickEvery = <float>state.entityChannelTickEvery[index];
    cast.channelTickTimer = <float>state.entityChannelTickTimer[index];
    cast.channelTicksLeft = <int>state.entityChannelTicksLeft[index];
    cast.castPushbackReduction = <float>state.entityCastPushbackReduction[index];
    cast.gcdRemaining = <float>state.entityCastGcdRemaining[index];
    cast.queuedAbility = <uint>state.entityQueuedCastAbility[index];
    cast.queuedDuration = <float>state.entityQueuedCastDuration[index];
    cast.queuedTickEvery = <float>state.entityQueuedChannelTickEvery[index];
    cast.queuedTickCount = <int>state.entityQueuedChannelTickCount[index];
    cast.queuedGcd = <float>state.entityQueuedCastGcd[index];
    cast.empowerStages = <int>state.entityEmpowerStages[index];
    cast.iceFloesUses = <int>state.entityIceFloesUses[index];
    cast.lastResolvedEmpowerLevel = <int>state.entityLastResolvedEmpowerLevel[index];
    cast.startedCasts = <int>state.entityCastStartedCount[index];
    cast.successfulStops = <int>state.entityCastSuccessfulStops[index];
    cast.cancelledStops = <int>state.entityCastCancelledStops[index];
    cast.resolvedCasts = <int>state.entityCastResolvedCount[index];
    cast.fishingCompletions = <int>state.entityFishingCompletions[index];
    cast.channelTicks = <int>state.entityCastChannelTicks[index];
    cast.lastCancelReason = <int>state.entityCastCancelReason[index];
    return cast;
}

storeCastingState(state: WorldState, index: int, cast: casting.CastState): void {
    var flags: uint = <uint>0;
    if (cast.channeling) { flags = flags | <uint>1; }
    if (cast.castAimLocked) { flags = flags | <uint>2; }
    if (cast.castTargetLocked) { flags = flags | <uint>4; }
    if (cast.castSchoolPhysical) { flags = flags | <uint>8; }
    if (cast.fishing) { flags = flags | <uint>16; }
    if (cast.stunned) { flags = flags | <uint>32; }
    if (cast.silenced) { flags = flags | <uint>64; }
    if (cast.schoolLockedOut) { flags = flags | <uint>128; }
    if (cast.castShield) { flags = flags | <uint>256; }
    if (cast.queuedChanneling) { flags = flags | <uint>512; }
    if (cast.queuedPhysical) { flags = flags | <uint>1024; }
    if (cast.queuedFishing) { flags = flags | <uint>2048; }
    if (cast.queuedAimLocked) { flags = flags | <uint>4096; }
    if (cast.massResurrection) { flags = flags | <uint>8192; }
    if (cast.inCombat) { flags = flags | <uint>16384; }
    if (cast.hasDeadGroupMember) { flags = flags | <uint>32768; }
    state.entityCastingAbility[index] = cast.castingAbility;
    state.entityCastRemaining[index] = cast.castRemaining;
    state.entityCastTotal[index] = cast.castTotal;
    state.entityCastingFlags[index] = flags;
    state.entityChannelTickEvery[index] = cast.channelTickEvery;
    state.entityChannelTickTimer[index] = cast.channelTickTimer;
    state.entityChannelTicksLeft[index] = cast.channelTicksLeft;
    state.entityCastPushbackReduction[index] = cast.castPushbackReduction;
    state.entityCastGcdRemaining[index] = cast.gcdRemaining;
    state.entityQueuedCastAbility[index] = cast.queuedAbility;
    state.entityQueuedCastDuration[index] = cast.queuedDuration;
    state.entityQueuedChannelTickEvery[index] = cast.queuedTickEvery;
    state.entityQueuedChannelTickCount[index] = cast.queuedTickCount;
    state.entityQueuedCastGcd[index] = cast.queuedGcd;
    state.entityEmpowerStages[index] = cast.empowerStages;
    state.entityIceFloesUses[index] = cast.iceFloesUses;
    state.entityLastResolvedEmpowerLevel[index] = cast.lastResolvedEmpowerLevel;
    state.entityCastStartedCount[index] = cast.startedCasts;
    state.entityCastSuccessfulStops[index] = cast.successfulStops;
    state.entityCastCancelledStops[index] = cast.cancelledStops;
    state.entityCastResolvedCount[index] = cast.resolvedCasts;
    state.entityFishingCompletions[index] = cast.fishingCompletions;
    state.entityCastChannelTicks[index] = cast.channelTicks;
    state.entityCastCancelReason[index] = cast.lastCancelReason;
}

talentCastMobility(state: WorldState, index: int, abilityCode: uint): bool {
    if (abilityCode == <uint>0) return false;
    var modifiers = new talentModifiers.TalentModifierState();
    talentModifiers.recompute(
        modifiers,
        <uint>state.entityTalentSpecCodes[index],
        talentRowCodeAt(state, index, 0),
        talentRowCodeAt(state, index, 1),
        talentRowCodeAt(state, index, 2),
        talentRowCodeAt(state, index, 3),
        talentRowCodeAt(state, index, 4),
        talentRowCodeAt(state, index, 5)
    );
    return talentModifiers.abilityCastWhileMoving(modifiers, abilityCode);
}

motionAuraEntityIsStunned(state: WorldState, index: int): bool {
    if (!motionAuraStateIsValid(state, index)) {
        throw "woc entity motion aura state is invalid";
    }
    return motionAuras.isStunned(
        state.entityMotionAuraAbilityCodes,
        state.entityMotionAuraSourceIds,
        state.entityMotionAuraKindCodes,
        state.entityMotionAuraRemaining,
        <int><uint>state.entityMotionAuraOffsets[index],
        <int><uint>state.entityMotionAuraOffsets[index + 1],
        true
    );
}

motionAuraEntityIsRooted(state: WorldState, index: int): bool {
    if (!motionAuraStateIsValid(state, index)) {
        throw "woc entity motion aura state is invalid";
    }
    return motionAuras.isRooted(
        state.entityMotionAuraAbilityCodes,
        state.entityMotionAuraSourceIds,
        state.entityMotionAuraKindCodes,
        state.entityMotionAuraRemaining,
        <int><uint>state.entityMotionAuraOffsets[index],
        <int><uint>state.entityMotionAuraOffsets[index + 1],
        true
    );
}

removeMotionAuraAt(state: WorldState, entityIndex: int, auraIndex: int): void {
    state.entityMotionAuraAbilityCodes.removeAt(auraIndex);
    state.entityMotionAuraSourceIds.removeAt(auraIndex);
    state.entityMotionAuraSchoolCodes.removeAt(auraIndex);
    state.entityMotionAuraKindCodes.removeAt(auraIndex);
    state.entityMotionAuraRemaining.removeAt(auraIndex);
    state.entityMotionAuraValues.removeAt(auraIndex);
    state.entityMotionAuraBreakChanceScales.removeAt(auraIndex);
    var offsetIndex = entityIndex + 1;
    while (offsetIndex < state.entityMotionAuraOffsets.length) {
        state.entityMotionAuraOffsets[offsetIndex] =
            <uint>state.entityMotionAuraOffsets[offsetIndex] - <uint>1;
        offsetIndex = offsetIndex + 1;
    }
}

toggleOfflineGhostWolf(state: WorldState, casterIndex: int): void {
    var abilityCode = ghostWolfAbilityCode();
    var start = <int><uint>state.entityMotionAuraOffsets[casterIndex];
    var end = <int><uint>state.entityMotionAuraOffsets[casterIndex + 1];
    var auraIndex = start;
    while (auraIndex < end) {
        if (<uint>state.entityMotionAuraAbilityCodes[auraIndex] == abilityCode) {
            removeMotionAuraAt(state, casterIndex, auraIndex);
            return;
        }
        auraIndex = auraIndex + 1;
    }
    applyOfflineMotionAuraWithDetails(
        state,
        casterIndex,
        abilityCode,
        <uint>state.entityIds[casterIndex],
        ccContract.motionAuraKindCode("buff_speed"),
        ghostWolfDuration(),
        1.4,
        0.0
    );
}

// Aura identity follows its source ability key, so a recast refreshes one row
// rather than stacking it. Producers retain their own source-specific rules.
applyOfflineMotionAura(
    state: WorldState,
    targetIndex: int,
    abilityCode: uint,
    sourceId: uint,
    kindCode: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAuraWithDetails(
        state,
        targetIndex,
        abilityCode,
        sourceId,
        kindCode,
        durationSeconds,
        0.0,
        0.0
    );
}

applyOfflineMotionAuraWithDetails(
    state: WorldState,
    targetIndex: int,
    abilityCode: uint,
    sourceId: uint,
    kindCode: uint,
    durationSeconds: float,
    value: float,
    breakChanceScale: float
): void {
    applyOfflineMotionAuraWithDetailsAndSchool(
        state, targetIndex, abilityCode, sourceId, kindCode, durationSeconds,
        value, breakChanceScale, OFFLINE_PROJECTILE_SCHOOL_PHYSICAL
    );
}

applyOfflineMotionAuraWithDetailsAndSchool(
    state: WorldState,
    targetIndex: int,
    abilityCode: uint,
    sourceId: uint,
    kindCode: uint,
    durationSeconds: float,
    value: float,
    breakChanceScale: float,
    schoolCode: uint
): void {
    if (!motionAuraStateIsValid(state, targetIndex) || abilityCode == <uint>0 ||
        kindCode == <uint>0 || sourceId == <uint>0 || durationSeconds <= 0.0 ||
        !motionAuraDetailsStateIsValid(state) || breakChanceScale < 0.0 ||
        breakChanceScale > 1.0 || !motionAuraSchoolStateIsValid(state) ||
        schoolCode > OFFLINE_PROJECTILE_SCHOOL_FIRE ||
        (kindCode == ccContract.motionAuraKindCode("lockout") &&
            schoolCode == OFFLINE_PROJECTILE_SCHOOL_PHYSICAL) ||
        (kindCode != ccContract.motionAuraKindCode("lockout") &&
            schoolCode != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL)) {
        throw "woc motion aura state is invalid";
    }
    var start = <int><uint>state.entityMotionAuraOffsets[targetIndex];
    var end = <int><uint>state.entityMotionAuraOffsets[targetIndex + 1];
    var auraIndex = start;
    while (auraIndex < end) {
        if (<uint>state.entityMotionAuraAbilityCodes[auraIndex] == abilityCode) {
            state.entityMotionAuraSourceIds[auraIndex] = sourceId;
            state.entityMotionAuraSchoolCodes[auraIndex] = schoolCode;
            state.entityMotionAuraKindCodes[auraIndex] = kindCode;
            state.entityMotionAuraRemaining[auraIndex] = durationSeconds;
            state.entityMotionAuraValues[auraIndex] = value;
            state.entityMotionAuraBreakChanceScales[auraIndex] = breakChanceScale;
            return;
        }
        auraIndex = auraIndex + 1;
    }
    state.entityMotionAuraAbilityCodes.add(<uint>0);
    state.entityMotionAuraSourceIds.add(<uint>0);
    state.entityMotionAuraSchoolCodes.add(<uint>0);
    state.entityMotionAuraKindCodes.add(<uint>0);
    state.entityMotionAuraRemaining.add(0.0);
    state.entityMotionAuraValues.add(0.0);
    state.entityMotionAuraBreakChanceScales.add(0.0);
    var cursor = state.entityMotionAuraAbilityCodes.length - 1;
    while (cursor > end) {
        state.entityMotionAuraAbilityCodes[cursor] =
            <uint>state.entityMotionAuraAbilityCodes[cursor - 1];
        state.entityMotionAuraSourceIds[cursor] =
            <uint>state.entityMotionAuraSourceIds[cursor - 1];
        state.entityMotionAuraSchoolCodes[cursor] =
            <uint>state.entityMotionAuraSchoolCodes[cursor - 1];
        state.entityMotionAuraKindCodes[cursor] =
            <uint>state.entityMotionAuraKindCodes[cursor - 1];
        state.entityMotionAuraRemaining[cursor] =
            <float>state.entityMotionAuraRemaining[cursor - 1];
        state.entityMotionAuraValues[cursor] =
            <float>state.entityMotionAuraValues[cursor - 1];
        state.entityMotionAuraBreakChanceScales[cursor] =
            <float>state.entityMotionAuraBreakChanceScales[cursor - 1];
        cursor = cursor - 1;
    }
    state.entityMotionAuraAbilityCodes[end] = abilityCode;
    state.entityMotionAuraSourceIds[end] = sourceId;
    state.entityMotionAuraSchoolCodes[end] = schoolCode;
    state.entityMotionAuraKindCodes[end] = kindCode;
    state.entityMotionAuraRemaining[end] = durationSeconds;
    state.entityMotionAuraValues[end] = value;
    state.entityMotionAuraBreakChanceScales[end] = breakChanceScale;
    var offsetIndex = targetIndex + 1;
    while (offsetIndex < state.entityMotionAuraOffsets.length) {
        state.entityMotionAuraOffsets[offsetIndex] =
            <uint>state.entityMotionAuraOffsets[offsetIndex] + <uint>1;
        offsetIndex = offsetIndex + 1;
    }
}

// WOS60's source identity is `gouge_incap`, which this ability-keyed row
// preserves while leaving its break-on-damage rule to the dedicated reducer.
applyOfflineGougeIncapacitate(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAura(
        state,
        targetIndex,
        gougeAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("incapacitate"),
        durationSeconds
    );
}

applyOfflineKidneyShotStun(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAura(
        state,
        targetIndex,
        kidneyShotAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("stun"),
        durationSeconds
    );
}

applyOfflineBashStun(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAura(
        state,
        targetIndex,
        bashAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("stun"),
        durationSeconds
    );
}

applyOfflinePounceStun(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAura(
        state,
        targetIndex,
        pounceAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("stun"),
        durationSeconds
    );
}

applyOfflineFaerieFire(
    state: WorldState,
    targetIndex: int,
    sourceId: uint,
    durationSeconds: float
): void {
    applyOfflineMotionAuraWithDetails(
        state,
        targetIndex,
        faerieFireAbilityCode(),
        sourceId,
        ccContract.motionAuraKindCode("faerie_fire"),
        durationSeconds,
        0.0,
        0.0
    );
}

// The retained damage paths call this only after they have resolved positive
// post-mitigation damage. Gouge follows the classic immediate break path;
// Fear consumes exactly one draw for its source graded chance while it remains.
clearOfflineBreakableIncapacitateOnDamage(
    state: WorldState,
    targetIndex: int,
    amount: int
): void {
    if (amount <= 0) { return; }
    clearOfflineProwl(state, targetIndex);
    clearOfflineConsumables(state, targetIndex);
    state.entitySitting[targetIndex] = false;
    if (!motionAuraStateIsValid(state, targetIndex) ||
        !motionAuraDetailsStateIsValid(state)) { return; }
    var gougeCode = gougeAbilityCode();
    var fearCode = fearAbilityCode();
    var hibernateCode = hibernateAbilityCode();
    var incapKind = ccContract.motionAuraKindCode("incapacitate");
    var auraIndex = <int><uint>state.entityMotionAuraOffsets[targetIndex];
    var auraEnd = <int><uint>state.entityMotionAuraOffsets[targetIndex + 1];
    while (auraIndex < auraEnd) {
        var abilityCode = <uint>state.entityMotionAuraAbilityCodes[auraIndex];
        if (<uint>state.entityMotionAuraKindCodes[auraIndex] != incapKind ||
            (abilityCode != gougeCode && abilityCode != fearCode &&
                abilityCode != hibernateCode)) {
            auraIndex = auraIndex + 1;
            continue;
        }
        if (abilityCode == fearCode) {
            var scale = <float>state.entityMotionAuraBreakChanceScales[auraIndex];
            var maximum = <int>state.entityMaxHp[targetIndex];
            if (scale > 0.0 && maximum > 0) {
                var chance = <float>amount / (scale * <float>maximum);
                if (chance > 1.0) { chance = 1.0; }
                if (nextAuthoritativeRandomUnit(state) >= chance) {
                    auraIndex = auraIndex + 1;
                    continue;
                }
            }
        }
        if (abilityCode == gougeCode || abilityCode == fearCode ||
            abilityCode == hibernateCode) {
            removeMotionAuraAt(state, targetIndex, auraIndex);
            auraEnd = auraEnd - 1;
        }
    }
}

// Expiry runs after that entity's cast progression. Removing a row shifts the
// later entity partitions in lockstep, preserving source aura order.
ageMotionAurasForEntity(state: WorldState, index: int): void {
    var auraIndex = <int><uint>state.entityMotionAuraOffsets[index];
    var auraEnd = <int><uint>state.entityMotionAuraOffsets[index + 1];
    while (auraIndex < auraEnd) {
        var seconds = <float>state.entityMotionAuraRemaining[auraIndex];
        if (motionAuras.remainsActiveAfterTick(seconds, true)) {
            state.entityMotionAuraRemaining[auraIndex] =
                motionAuras.remainingAfterTick(seconds, true);
            auraIndex = auraIndex + 1;
        } else {
            removeMotionAuraAt(state, index, auraIndex);
            auraEnd = auraEnd - 1;
        }
    }
}

// Sunder's source aura ticks independently of movement and casting. Keep its
// 50ms WOS age sweep global because its target is an Eastbrook mob rather than
// the player-only motion-aura owner.
ageOfflineSunderArmor(state: WorldState): void {
    if (!sunderArmorStateIsValid(state)) {
        throw "woc Sunder Armor state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<int>state.entitySunderArmorStacks[index] > 0) {
            var remaining = <float>state.entitySunderArmorRemaining[index];
            if (remaining > 0.05) {
                state.entitySunderArmorRemaining[index] = remaining - 0.05;
            } else {
                state.entitySunderArmorStacks[index] = 0;
                state.entitySunderArmorRemaining[index] = 0.0;
                state.entitySunderArmorValues[index] = 0.0;
            }
        }
        index = index + 1;
    }
}

// The source expires demoralizing_roar_ap independently of any target action.
// This runs beside the Sunder age sweep before hostile swings read AP.
ageOfflineDemoralizingRoar(state: WorldState): void {
    if (!demoralizingRoarStateIsValid(state)) {
        throw "woc Demoralizing Roar state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityDemoralizingRoarRemaining[index];
        if (remaining > 0.0) {
            if (remaining > 0.05) {
                state.entityDemoralizingRoarRemaining[index] = remaining - 0.05;
            } else {
                state.entityDemoralizingRoarRemaining[index] = 0.0;
                state.entityDemoralizingRoarValues[index] = 0.0;
            }
        }
        index = index + 1;
    }
}

offlineProwlIsActive(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length &&
        <float>state.entityProwlRemaining[index] > 0.0 &&
        <float>state.entityProwlValues[index] == 0.5;
}

clearOfflineProwl(state: WorldState, index: int): void {
    if (index < 0 || index >= state.entityIds.length) { return; }
    state.entityProwlRemaining[index] = 0.0;
    state.entityProwlValues[index] = 0.0;
}

// Prowl is an ordinary source self-buff, so its clock advances independently
// of movement and casting and clears both retained fields at the same tick.
ageOfflineProwl(state: WorldState): void {
    if (!prowlStateIsValid(state)) {
        throw "woc Prowl state is invalid";
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var remaining = <float>state.entityProwlRemaining[index];
        if (remaining > 0.0) {
            if (remaining > 0.05) {
                state.entityProwlRemaining[index] = remaining - 0.05;
            } else {
                clearOfflineProwl(state, index);
            }
        }
        index = index + 1;
    }
}

// This call preserves casting-before-GCD-timer ordering inside CastState while
// retaining one WOS-owned candidate row per entity. Commands still own arming.
stepRetainedCasting(state: WorldState, index: int, stunned: bool): void {
    var cast = loadCastingState(state, index);
    cast.stunned = stunned;
    if (cast.castingAbility != <uint>0 &&
        offlineSchoolLockoutIsActive(
            state, index, offlineAbilitySchoolCode(cast.castingAbility)
        )) {
        casting.cancelCast(cast);
        storeCastingState(state, index, cast);
        state.entityCastTargetIds[index] = <uint>0;
        return;
    }
    var completedAbility = cast.castingAbility;
    var successfulStops = cast.successfulStops;
    var channelTicks = cast.channelTicks;
    // The source resolves a target channel's validity when a pulse fires, not
    // when the cast starts. CastState owns only clocks, so keep that target
    // gate here before it consumes the corresponding Drain Life tick.
    var drainTickDue = (completedAbility == drainLifeAbilityCode() ||
        completedAbility == mindFlayAbilityCode()) && cast.channeling &&
        (cast.channelTickTimer <= 0.05 || cast.castRemaining <= 0.05);
    if (drainTickDue) {
        var channelTargetIndex = completedAbility == drainLifeAbilityCode() ?
            drainLifeTargetIndex(state, index, <uint>state.entityCastTargetIds[index]) :
            mindFlayTargetIndex(state, index, <uint>state.entityCastTargetIds[index]);
        if (channelTargetIndex < 0) {
            casting.cancelCast(cast);
            storeCastingState(state, index, cast);
            state.entityCastTargetIds[index] = <uint>0;
            return;
        }
    }
    casting.advanceFixedTick(cast);
    storeCastingState(state, index, cast);
    if (completedAbility == frostboltAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineFrostboltCast(state, index);
    } else if (completedAbility == smiteAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineSmiteCast(state, index);
    } else if (completedAbility == mindBlastAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineMindBlastCast(state, index);
    } else if (completedAbility == shadowBoltAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineShadowBoltCast(state, index);
    } else if (completedAbility == wrathAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineWrathCast(state, index);
    } else if (completedAbility == starfireAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineStarfireCast(state, index);
    } else if (completedAbility == entanglingRootsAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineEntanglingRootsCast(state, index);
    } else if (completedAbility == searingPainAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineSearingPainCast(state, index);
    } else if (completedAbility == immolateAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineImmolateCast(state, index);
    } else if (completedAbility == corruptionAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineCorruptionCast(state, index);
    } else if (completedAbility == lightningBoltAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineLightningBoltCast(state, index);
    } else if (completedAbility == summonImpAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineSummonImpCast(state, index);
    } else if (completedAbility == ghostWolfAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineGhostWolfCast(state, index);
    } else if (completedAbility == drainLifeAbilityCode() &&
        cast.channelTicks > channelTicks) {
        var emittedTicks = cast.channelTicks - channelTicks;
        while (emittedTicks > 0) {
            if (!launchOfflineDrainLifeChannelTick(state, index)) {
                break;
            }
            emittedTicks = emittedTicks - 1;
        }
        if (cast.castingAbility == <uint>0) {
            state.entityCastTargetIds[index] = <uint>0;
        }
    } else if (completedAbility == mindFlayAbilityCode() &&
        cast.channelTicks > channelTicks) {
        var mindFlayTicks = cast.channelTicks - channelTicks;
        while (mindFlayTicks > 0) {
            if (!launchOfflineMindFlayChannelTick(state, index)) {
                break;
            }
            mindFlayTicks = mindFlayTicks - 1;
        }
        if (cast.castingAbility == <uint>0) {
            state.entityCastTargetIds[index] = <uint>0;
        }
    } else if (completedAbility == rainOfFireAbilityCode() &&
        cast.channelTicks > channelTicks) {
        var rainTicks = cast.channelTicks - channelTicks;
        while (rainTicks > 0) {
            if (!launchOfflineRainOfFireChannelTick(state, index)) {
                break;
            }
            rainTicks = rainTicks - 1;
        }
        if (cast.castingAbility == <uint>0) {
            clearRainOfFireCastAim(state, index);
        }
    } else if (completedAbility == rainOfFireAbilityCode() &&
        cast.castingAbility == <uint>0) {
        clearRainOfFireCastAim(state, index);
    } else if (completedAbility == hurricaneAbilityCode() &&
        cast.channelTicks > channelTicks) {
        var hurricaneTicks = cast.channelTicks - channelTicks;
        while (hurricaneTicks > 0) {
            if (!launchOfflineHurricaneChannelTick(state, index)) { break; }
            hurricaneTicks = hurricaneTicks - 1;
        }
        if (cast.castingAbility == <uint>0) { clearHurricaneCastAim(state, index); }
    } else if (completedAbility == hurricaneAbilityCode() &&
        cast.castingAbility == <uint>0) {
        clearHurricaneCastAim(state, index);
    } else if (completedAbility == fearAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineFearCast(state, index);
    } else if (completedAbility == hibernateAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineHibernateCast(state, index);
    } else if (completedAbility == fireballAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineFireballCast(state, index);
    } else if (completedAbility == lesserHealAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineLesserHealCast(state, index);
    } else if (completedAbility == healAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineHealCast(state, index);
    } else if (completedAbility == healingTouchAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineHealingTouchCast(state, index);
    } else if (completedAbility == regrowthAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineRegrowthCast(state, index);
    } else if (completedAbility == flashHealAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineFlashHealCast(state, index);
    } else if (completedAbility == healingWaveAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeOfflineHealingWaveCast(state, index);
    } else if (completedAbility == temporalReversalAbilityCode() &&
        cast.successfulStops > successfulStops) {
        completeTemporalReversalCast(state, index);
    } else if (forms.isFormAbilityCode(completedAbility) &&
        cast.successfulStops > successfulStops) {
        completeFormCast(state, index, completedAbility);
    } else if (cast.castingAbility == <uint>0) {
        state.entityCastTargetIds[index] = <uint>0;
    }
}

// This mirrors the source's post-action per-player combo expiry. The source
// keeps comboUntil after expiry; only the active point pool is cleared.
expireOfflineComboPoints(state: WorldState, index: int): void {
    if (<int>state.entityComboPoints[index] > 0 &&
        <float>state.timeMicros / 1000000.0 >= <float>state.entityComboUntil[index]) {
        state.entityComboPoints[index] = 0;
    }
}

// This is the retained source order for each eligible player: movement side
// effects and transition, cast lifecycle, then the active motion-aura clock.
stepRetainedPlayerTicks(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>1 &&
            (!<bool>state.entityDead[index] || <bool>state.entityGhost[index])) {
            var start = <int><uint>state.entityMotionAuraOffsets[index];
            var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
            var stunned = motionAuras.isStunned(
                state.entityMotionAuraAbilityCodes,
                state.entityMotionAuraSourceIds,
                state.entityMotionAuraKindCodes,
                state.entityMotionAuraRemaining,
                start,
                end,
                true
            );
            var rooted = motionAuras.isRooted(
                state.entityMotionAuraAbilityCodes,
                state.entityMotionAuraSourceIds,
                state.entityMotionAuraKindCodes,
                state.entityMotionAuraRemaining,
                start,
                end,
                true
            );
            if (motionEffects.standUpRequested(
                <bool>state.entityMovementForward[index],
                <bool>state.entityMovementBack[index],
                <bool>state.entityMovementStrafeLeft[index],
                <bool>state.entityMovementStrafeRight[index],
                <bool>state.entityMovementJump[index],
                <bool>state.entitySitting[index],
                true
            )) {
                state.entitySitting[index] = false;
                clearOfflineConsumables(state, index);
            }
            if (!<bool>state.entityDead[index]) {
                var cast = loadCastingState(state, index);
                cast.stunned = stunned;
                var swimming = motionWorld.isSwimmingInBuiltinWorld(
                    <float>state.entityX[index],
                    <float>state.entityZ[index],
                    <float>state.entityY[index],
                    state.worldSeed,
                    true
                );
                var steepGround = motionWorld.isSteepGround(
                    <float>state.entityX[index],
                    <float>state.entityZ[index],
                    <bool>state.entityOnGround[index],
                    swimming,
                    state.worldSeed,
                    true
                );
                var mobileCast = motionAuras.canCastWhileMoving(
                    talentCastMobility(state, index, cast.castingAbility),
                    state.entityMotionAuraAbilityCodes,
                    state.entityMotionAuraSourceIds,
                    state.entityMotionAuraKindCodes,
                    state.entityMotionAuraRemaining,
                    start,
                    end,
                    true
                );
                if (motionEffects.cancelCastRequested(
                    <bool>state.entityMovementForward[index],
                    <bool>state.entityMovementBack[index],
                    <bool>state.entityMovementStrafeLeft[index],
                    <bool>state.entityMovementStrafeRight[index],
                    rooted,
                    steepGround,
                    steepGround,
                    cast.castingAbility != <uint>0,
                    mobileCast,
                    true
                )) {
                    var cancelledAbility = cast.castingAbility;
                    casting.cancelCast(cast);
                    if (cancelledAbility == rainOfFireAbilityCode()) {
                        clearRainOfFireCastAim(state, index);
                    }
                }
                storeCastingState(state, index, cast);
            }
            stepRetainedPlayerMovement(state, index, stunned, rooted);
            if (!<bool>state.entityDead[index]) {
                stepRetainedCasting(state, index, stunned);
            }
            stepOfflineConsumables(state, index);
            expireOfflineComboPoints(state, index);
            ageMotionAurasForEntity(state, index);
        }
        index = index + 1;
    }
}

prepareOfflineAutoActor(
    state: WorldState,
    playerIndex: int,
    targetIndex: int,
    actor: autoAttackState.AutoActor
): void {
    actor.id = <uint>state.entityIds[playerIndex];
    actor.classId = knownAbilityCatalog.classId(<int>state.offlinePlayerClass);
    actor.level = <int>state.entityLevels[playerIndex];
    actor.hp = <int>state.entityHp[playerIndex];
    actor.dead = <bool>state.entityDead[playerIndex];
    actor.inCombat = <bool>state.entityInCombat[playerIndex];
    actor.combatTimer = <float>state.entityCombatTimers[playerIndex];
    actor.autoAttack = <bool>state.entityAutoAttack[playerIndex];
    actor.casting = <uint>state.entityCastingAbility[playerIndex] != <uint>0;
    actor.stunned = false;
    actor.disarmed = false;
    actor.sitting = <bool>state.entitySitting[playerIndex];
    actor.weaponStowed = <bool>state.entityWeaponStowed[playerIndex];
    actor.ghostWolf = false;
    actor.swingTimer = <float>state.entitySwingTimer[playerIndex];
    var deltaX = <float>state.entityX[targetIndex] - <float>state.entityX[playerIndex];
    var deltaZ = <float>state.entityZ[targetIndex] - <float>state.entityZ[playerIndex];
    actor.targetDistance = math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
    actor.targetFacingDifference = absoluteAngleDifference(
        math.atan2(deltaX, deltaZ), <float>state.entityFacing[playerIndex]
    );
    actor.lineOfSight = true;
    actor.arenaPosition = false;
    actor.resource = <float>state.entityResources[playerIndex];
    actor.maxResource = <float>state.entityMaxResources[playerIndex];
    var queuedAbilityCode = <uint>state.entityQueuedOnSwingAbilityCodes[playerIndex];
    actor.hasQueuedAbility = queuedAbilityCode != <uint>0;
    actor.queuedAbility = actor.hasQueuedAbility ?
        knownAbilityCatalog.abilityId(<int>queuedAbilityCode) : "";
    actor.queuedFree = <bool>state.entityQueuedOnSwingFree[playerIndex];
    actor.queuedCostMultiplier =
        <float>state.entityQueuedOnSwingCostMultipliers[playerIndex];
    actor.weaponMinimum = <float>state.entityWeaponMinimum[playerIndex];
    actor.weaponMaximum = <float>state.entityWeaponMaximum[playerIndex];
    actor.weaponSpeed = <float>state.entityWeaponSpeed[playerIndex];
    actor.offhandWeaponMinimum = <float>state.entityOffhandWeaponMinimum[playerIndex];
    actor.offhandWeaponMaximum = <float>state.entityOffhandWeaponMaximum[playerIndex];
    actor.offhandWeaponSpeed = <float>state.entityOffhandWeaponSpeed[playerIndex];
    actor.hasOffhandWeapon = <bool>state.entityHasOffhandWeapon[playerIndex];
    actor.dualWielding = <bool>state.entityDualWielding[playerIndex];
    actor.attackPower = effectiveOfflineAttackPower(state, playerIndex);
    actor.rangedPower = <float>state.entityRangedPower[playerIndex];
    actor.critChance = <float>state.entityCritChance[playerIndex];
    actor.critDamagePhysicalBonus = <float>state.entityCritDamagePhysicalBonus[playerIndex];
    actor.hitBonus = <float>state.entityHitBonus[playerIndex];
    actor.meleeHaste = <float>state.entityMeleeHaste[playerIndex];
    actor.rangedHaste = <float>state.entityRangedHaste[playerIndex];
    actor.swingIntervalMultiplier = 1.0;
    actor.offhandSwingTimer = <float>state.entityOffhandSwingTimer[playerIndex];
    actor.activeFormAbilityCode = <uint>state.entityActiveFormAbilityCodes[playerIndex];
    actor.imbueBonus = offlineImbueBonus(state, playerIndex);
}

// Source effectiveArmor takes the greater of the active Sunder and Faerie Fire
// percentages. Sunder's generated armor value remains presentation data; the
// retained hostile Eastbrook path uses its fixed two-percent-per-stack rule.
sunderArmorReduction(state: WorldState, targetIndex: int): float {
    var stacks = <int>state.entitySunderArmorStacks[targetIndex];
    return stacks > 0 && <float>state.entitySunderArmorRemaining[targetIndex] > 0.0 ?
        0.02 * <float>stacks : 0.0;
}

faerieFireArmorReduction(state: WorldState, targetIndex: int): float {
    var kind = ccContract.motionAuraKindCode("faerie_fire");
    var abilityCode = faerieFireAbilityCode();
    var aura = <int><uint>state.entityMotionAuraOffsets[targetIndex];
    var end = <int><uint>state.entityMotionAuraOffsets[targetIndex + 1];
    while (aura < end) {
        if (<uint>state.entityMotionAuraKindCodes[aura] == kind &&
            <uint>state.entityMotionAuraAbilityCodes[aura] == abilityCode &&
            <float>state.entityMotionAuraRemaining[aura] > 0.0) {
            return ccContract.faerieFireArmorReduction();
        }
        aura = aura + 1;
    }
    return 0.0;
}

effectiveOfflineArmor(state: WorldState, targetIndex: int): float {
    if (targetIndex < 0 || targetIndex >= state.entityIds.length ||
        !sunderArmorStateIsValid(state) || !faerieFireMotionStateIsValid(state)) {
        throw "woc effective armor target is invalid";
    }
    var armor = <float>state.entityArmor[targetIndex];
    armor = armor + demonSkinArmorBonus(state, targetIndex);
    armor = armor + barkskinArmorBonus(state, targetIndex);
    var reduction = sunderArmorReduction(state, targetIndex);
    var faerieFireReduction = faerieFireArmorReduction(state, targetIndex);
    if (faerieFireReduction > reduction) { reduction = faerieFireReduction; }
    armor = armor * (1.0 - reduction);
    return armor > 0.0 ? armor : 0.0;
}

effectiveOfflineDodgeChance(state: WorldState, targetIndex: int): float {
    if (targetIndex < 0 || targetIndex >= state.entityIds.length) {
        throw "woc effective dodge target is invalid";
    }
    var dodge = <float>state.entityDodgeChance[targetIndex];
    dodge = dodge + primalReflexesDodgeBonus(state, targetIndex);
    return dodge > 0.0 ? dodge : 0.0;
}

// The source's selfBuff path stores Tiger's Fury as a self-owned `buff_ap`
// aura and folds it into the player's recalculated attack power. WOC keeps
// derived base stats immutable, so the same contribution is projected while
// the source-identical aura row remains active.
tigersFuryAttackPowerBonus(state: WorldState, index: int): float {
    var kind = ccContract.motionAuraKindCode("buff_ap");
    var abilityCode = tigersFuryAbilityCode();
    var start = <int><uint>state.entityMotionAuraOffsets[index];
    var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
    var bonus = 0.0;
    while (start < end) {
        if (<uint>state.entityMotionAuraKindCodes[start] == kind &&
            <uint>state.entityMotionAuraAbilityCodes[start] == abilityCode &&
            <uint>state.entityMotionAuraSourceIds[start] == <uint>state.entityIds[index] &&
            <float>state.entityMotionAuraRemaining[start] > 0.0) {
            var value = <float>state.entityMotionAuraValues[start];
            if (value != 40.0) {
                throw "woc Tiger's Fury aura value is invalid";
            }
            bonus = bonus + value;
        }
        start = start + 1;
    }
    return bonus;
}

// Mirrors Sim.effectiveAttackPower for retained player and hostile rows:
// self-owned `buff_ap` adds before Demoralizing Roar subtracts, then the
// source floor prevents a negative attack-power contribution.
effectiveOfflineAttackPower(state: WorldState, targetIndex: int): float {
    if (targetIndex < 0 || targetIndex >= state.entityIds.length ||
        !demoralizingRoarStateIsValid(state)) {
        throw "woc effective attack power target is invalid";
    }
    var attackPower = <float>state.entityAttackPower[targetIndex] +
        tigersFuryAttackPowerBonus(state, targetIndex);
    if (<float>state.entityDemoralizingRoarRemaining[targetIndex] > 0.0) {
        attackPower = attackPower -
            <float>state.entityDemoralizingRoarValues[targetIndex];
    }
    return attackPower > 0.0 ? attackPower : 0.0;
}

prepareOfflineEastbrookAutoTarget(
    state: WorldState,
    targetIndex: int,
    target: autoAttackState.AutoTarget
): void {
    target.id = <uint>state.entityIds[targetIndex];
    target.kind = "mob";
    target.level = <int>state.entityLevels[targetIndex];
    target.dead = <bool>state.entityDead[targetIndex];
    target.hostileToActor = <bool>state.entityHostile[targetIndex];
    target.hostileMob = <bool>state.entityHostile[targetIndex];
    target.owned = <uint>state.entityOwnerIds[targetIndex] != <uint>0;
    target.evading = false;
    target.idle = <uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState();
    target.hasAggroTarget = <uint>state.entityAggroTargetIds[targetIndex] != <uint>0;
    target.aggroTargetId = <uint>state.entityAggroTargetIds[targetIndex];
    target.inCombat = <bool>state.entityInCombat[targetIndex];
    target.hp = <int>state.entityHp[targetIndex];
    target.armor = effectiveOfflineArmor(state, targetIndex);
    target.dodgeChance = 0.05;
    target.thornsDamage = 0;
    target.spikedHideDamage = 0;
}

commitOfflineAutoActor(
    state: WorldState,
    playerIndex: int,
    actor: autoAttackState.AutoActor
): void {
    state.entitySwingTimer[playerIndex] = actor.swingTimer;
    state.entityOffhandSwingTimer[playerIndex] = actor.offhandSwingTimer;
    state.entityAutoAttack[playerIndex] = actor.autoAttack;
    state.entitySitting[playerIndex] = actor.sitting;
    state.entityWeaponStowed[playerIndex] = actor.weaponStowed;
    state.entityInCombat[playerIndex] = actor.inCombat;
    state.entityCombatTimers[playerIndex] = actor.combatTimer;
    state.entityResources[playerIndex] = <int>actor.resource;
    state.entityHp[playerIndex] = actor.hp > 0 ? actor.hp : 0;
    state.entityQueuedOnSwingAbilityCodes[playerIndex] = actor.hasQueuedAbility ?
        <uint>knownAbilityCatalog.abilityCode(actor.queuedAbility) : <uint>0;
    state.entityQueuedOnSwingFree[playerIndex] = actor.hasQueuedAbility && actor.queuedFree;
    state.entityQueuedOnSwingCostMultipliers[playerIndex] = actor.hasQueuedAbility ?
        actor.queuedCostMultiplier : 1.0;
    if (actor.resolvedQueuedAbility != "") {
        var resolvedCode = <uint>knownAbilityCatalog.abilityCode(actor.resolvedQueuedAbility);
        var resolvedIndex = queuedOnSwingM4AbilityIndex(resolvedCode);
        if (resolvedIndex >= 0 && <float>actor.cooldowns[resolvedIndex] > 0.0) {
            setAbilityCooldownExpiration(
                state,
                playerIndex,
                resolvedCode,
                state.timeMicros + <uint>(<float>actor.cooldowns[resolvedIndex] * 1000000.0)
            );
        }
    }
}

commitOfflineAutoAttackRng(state: WorldState, events: autoAttackState.AutoEvents): void {
    state.rngState = autoAttackState.authoritativeRngState(events, true);
    state.rngDraws = autoAttackState.authoritativeRngDraws(events, true);
    state.rngDigest = autoAttackState.authoritativeRngDigest(events, true);
}

settleOfflineEastbrookLethal(
    state: WorldState,
    targetIndex: int,
    playerIndex: int
): void {
    grantOfflineMobKillExperience(state, targetIndex, playerIndex);
    if (offlineMobTemplateId(state, targetIndex) == "forest_wolf") {
        creditOfflineQuestWolfKill(state, playerIndex);
    }
    rollOfflineEastbrookCorpseLoot(state, targetIndex, playerIndex);
}

// The source has no ranged white-hit profile for these classes. They can share
// the direct melee bridge without turning a wand or Auto Shot into a false melee
// transaction. Hunter's close-range fallback shares its normal melee profile; its
// deferred Auto Shot path owns the 8-35 yard window. Druid is allowed only
// while Bear/Cat owns its ranged form gate. Caster wands and Moonkin stay in
// separate state transactions because this bridge does not retain their tails.
offlineDirectMeleeAutoProfileEnabled(state: WorldState, playerIndex: int): bool {
    if (playerIndex < 0 || playerIndex >= state.entityIds.length) {
        return false;
    }
    var classId = knownAbilityCatalog.classId(<int>state.offlinePlayerClass);
    if (classId == "warrior" || classId == "rogue" || classId == "paladin" ||
        classId == "shaman") {
        return true;
    }
    if (classId == "hunter") {
        var targetIndex = partyEntityIndexById(state, <uint>state.entityTargetIds[playerIndex]);
        if (targetIndex < 0) { return false; }
        var deltaX = <float>state.entityX[targetIndex] - <float>state.entityX[playerIndex];
        var deltaZ = <float>state.entityZ[targetIndex] - <float>state.entityZ[playerIndex];
        return deltaX * deltaX + deltaZ * deltaZ <= 25.0;
    }
    if (classId == "druid" && (
            <uint>state.entityActiveFormAbilityCodes[playerIndex] ==
                forms.formAbilityCode("form_bear") ||
            <uint>state.entityActiveFormAbilityCodes[playerIndex] ==
                forms.formAbilityCode("form_cat"))) {
        return true;
    }
    return false;
}

// The source decrements both weapon timers before Travel Form (and the
// action-locking Fireball travel form) suppresses auto-attack entirely.
stepOfflineTravelFormAutoAttack(state: WorldState): void {
    if (!state.offlineSessionActive) { return; }
    var playerIndex = offlineQuestPrimaryPlayerIndex(state);
    if (playerIndex < 0 || <bool>state.entityDead[playerIndex] ||
        !forms.isTravelFormAbilityCode(
            <uint>state.entityActiveFormAbilityCodes[playerIndex]
        )) {
        return;
    }
    state.entitySwingTimer[playerIndex] =
        <float>state.entitySwingTimer[playerIndex] - projectileTravel.projectileTickSeconds();
    if (<float>state.entitySwingTimer[playerIndex] < 0.0) {
        state.entitySwingTimer[playerIndex] = 0.0;
    }
    state.entityOffhandSwingTimer[playerIndex] =
        <float>state.entityOffhandSwingTimer[playerIndex] - projectileTravel.projectileTickSeconds();
    if (<float>state.entityOffhandSwingTimer[playerIndex] < 0.0) {
        state.entityOffhandSwingTimer[playerIndex] = 0.0;
    }
    state.entityAutoAttack[playerIndex] = false;
}

// This consumes the already-armed source mainhand white-melee path for direct
// offline profiles against retained Eastbrook wolves/boars. The same bridge
// carries the source mainhand/offhand white-swing ordering, but ranged profiles,
// queued swings, set/talent procs and reflect remain separate transactions until
// their state tails are committed end-to-end.
stepOfflineDirectMeleeAutoAttack(state: WorldState): void {
    if (!state.offlineSessionActive) {
        return;
    }
    var playerIndex = offlineQuestPrimaryPlayerIndex(state);
    if (playerIndex < 0 || <bool>state.entityDead[playerIndex] ||
        !<bool>state.entityAutoAttack[playerIndex]) {
        return;
    }
    if (!offlineDirectMeleeAutoProfileEnabled(state, playerIndex)) {
        return;
    }
    var targetIndex = partyEntityIndexById(
        state, <uint>state.entityTargetIds[playerIndex]
    );
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex]) {
        state.entityAutoAttack[playerIndex] = false;
        return;
    }
    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, playerIndex, targetIndex, actor);

    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    // The source applies an innate mob thorns reaction after landed mainhand
    // damage. It still reflects when that blow killed the boar, provided the
    // attacker remains alive, which `spikedHideDamage` preserves in order.
    target.thornsDamage = 0;
    target.spikedHideDamage = 0;
    if (offlineMobTemplateId(state, targetIndex) == "wild_boar") {
        target.spikedHideDamage = 2;
    }

    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(
        events, state.rngState, state.rngDraws, state.rngDigest, true
    );
    autoAttackState.fixedTick(actor, target, events);
    // AutoAttack owns the white-swing draws in its local event accumulator.
    // Commit that cursor before death processing so rollLoot consumes the next
    // source value rather than replaying the swing's hit/range/crit sequence.
    state.rngState = autoAttackState.authoritativeRngState(events, true);
    state.rngDraws = autoAttackState.authoritativeRngDraws(events, true);
    state.rngDigest = autoAttackState.authoritativeRngDigest(events, true);
    commitOfflineAutoActor(state, playerIndex, actor);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage);
    }
    state.entityInCombat[targetIndex] = target.inCombat;
    // The source settles kill XP, quest credit and loot synchronously before a
    // post-hit reaction can kill the attacker. The retained wolf quest ledger
    // already enforces active-state and eight-kill bounds.
    if (target.hp <= 0) {
        grantOfflineMobKillExperience(state, targetIndex, playerIndex);
        if (offlineMobTemplateId(state, targetIndex) == "forest_wolf") {
            creditOfflineQuestWolfKill(state, playerIndex);
        }
        // handleDeath rolls corpse loot after quest credit and before the
        // attacker's post-hit Bristled Hide reaction can kill the player.
        rollOfflineEastbrookCorpseLoot(state, targetIndex, playerIndex);
    }
    if (actor.dead || actor.hp <= 0) {
        applyOfflineMobMeleePlayerDeath(state, playerIndex);
    } else {
        state.entityHp[playerIndex] = actor.hp;
    }
}

// Source aura expiry runs after that player's auto attack. This keeps a Seal
// active for a swing on its final tick, then clears it before the next command
// boundary just as the source's updateAuras tail does.
ageOfflineImbues(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityImbueAbilityCodes[index] != <uint>0) {
            var remaining = <float>state.entityImbueRemaining[index] -
                projectileTravel.projectileTickSeconds();
            if (remaining <= OFFLINE_PERIODIC_TICK_EPS) {
                clearOfflineImbue(state, index);
            } else {
                state.entityImbueRemaining[index] = remaining;
            }
        }
        index = index + 1;
    }
}

offlineHunterAutoShotProfileEnabled(state: WorldState, playerIndex: int): bool {
    return playerIndex >= 0 && playerIndex < state.entityIds.length &&
        knownAbilityCatalog.classId(<int>state.offlinePlayerClass) == "hunter";
}

configureOfflineHunterAutoShot(actor: autoAttackState.AutoActor): void {
    actor.hasRangedProfile = true;
    actor.rangedWand = false;
    actor.rangedUsesWeapon = false;
    actor.rangedMinimumRange = 8.0;
    actor.rangedMaximumRange = 35.0;
    actor.rangedMinimum = 5.0;
    actor.rangedMaximum = 9.0;
    actor.rangedSpeed = 2.3;
    actor.rangedSchool = "physical";
}

offlineWandSchoolForPlayer(state: WorldState, playerIndex: int): string {
    if (playerIndex < 0 || playerIndex >= state.entityIds.length) {
        return "";
    }
    var classId = knownAbilityCatalog.classId(<int>state.offlinePlayerClass);
    if (classId == "mage") { return "arcane"; }
    if (classId == "priest") { return "holy"; }
    if (classId == "warlock") { return "shadow"; }
    if (classId != "druid") { return ""; }
    var form = <uint>state.entityActiveFormAbilityCodes[playerIndex];
    if (form == forms.formAbilityCode("form_bear") ||
        form == forms.formAbilityCode("form_cat") ||
        form == forms.formAbilityCode("form_travel")) {
        return "";
    }
    return "nature";
}

offlineCasterWandProfileEnabled(state: WorldState, playerIndex: int): bool {
    return offlineWandSchoolForPlayer(state, playerIndex) != "";
}

configureOfflineCasterWand(actor: autoAttackState.AutoActor, school: string): void {
    actor.hasRangedProfile = true;
    actor.rangedWand = true;
    actor.rangedUsesWeapon = false;
    actor.rangedMinimumRange = 0.0;
    actor.rangedMaximumRange = 30.0;
    actor.rangedMinimum = 3.0;
    actor.rangedMaximum = 6.0;
    actor.rangedSpeed = 1.8;
    actor.rangedSchool = school;
}

offlineProjectileSchoolCode(school: string): uint {
    if (school == "arcane") { return OFFLINE_PROJECTILE_SCHOOL_ARCANE; }
    if (school == "holy") { return OFFLINE_PROJECTILE_SCHOOL_HOLY; }
    if (school == "shadow") { return OFFLINE_PROJECTILE_SCHOOL_SHADOW; }
    if (school == "nature") { return OFFLINE_PROJECTILE_SCHOOL_NATURE; }
    return OFFLINE_PROJECTILE_SCHOOL_PHYSICAL;
}

offlineProjectileSchoolName(code: uint): string {
    if (code == OFFLINE_PROJECTILE_SCHOOL_ARCANE) { return "arcane"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_HOLY) { return "holy"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_SHADOW) { return "shadow"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_NATURE) { return "nature"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_FROST) { return "frost"; }
    if (code == OFFLINE_PROJECTILE_SCHOOL_FIRE) { return "fire"; }
    return "physical";
}

appendOfflineProjectile(
    state: WorldState,
    sourceId: uint,
    targetId: uint,
    sourceX: float,
    sourceZ: float,
    minimum: float,
    maximum: float,
    speed: float,
    wand: bool,
    school: uint
): void {
    appendOfflineAbilityProjectile(
        state, sourceId, targetId, sourceX, sourceZ, minimum, maximum, speed,
        wand, school, <uint>0, <uint>0, 0.0
    );
}

appendOfflineAbilityProjectile(
    state: WorldState,
    sourceId: uint,
    targetId: uint,
    sourceX: float,
    sourceZ: float,
    minimum: float,
    maximum: float,
    speed: float,
    wand: bool,
    school: uint,
    abilityCode: uint,
    rank: uint,
    castTime: float
): void {
    if (state.offlineProjectileSourceIds.length >= <int>OFFLINE_PROJECTILE_PENDING_MAX) {
        throw "woc offline projectile queue exceeds WOS cap";
    }
    state.offlineProjectileSourceIds.add(sourceId);
    state.offlineProjectileTargetIds.add(targetId);
    state.offlineProjectileX.add(sourceX);
    state.offlineProjectileZ.add(sourceZ);
    state.offlineProjectileTtls.add(projectileTravel.projectileMaxFlight());
    state.offlineProjectileWands.add(wand);
    state.offlineProjectileSchoolCodes.add(school);
    state.offlineProjectileMinimums.add(minimum);
    state.offlineProjectileMaximums.add(maximum);
    state.offlineProjectileSpeeds.add(speed);
    state.offlineProjectileAbilityCodes.add(abilityCode);
    state.offlineProjectileRanks.add(rank);
    state.offlineProjectileCastTimes.add(castTime);
}

removeOfflineProjectileAt(state: WorldState, index: int): void {
    state.offlineProjectileSourceIds.removeAt(index);
    state.offlineProjectileTargetIds.removeAt(index);
    state.offlineProjectileX.removeAt(index);
    state.offlineProjectileZ.removeAt(index);
    state.offlineProjectileTtls.removeAt(index);
    state.offlineProjectileWands.removeAt(index);
    state.offlineProjectileSchoolCodes.removeAt(index);
    state.offlineProjectileMinimums.removeAt(index);
    state.offlineProjectileMaximums.removeAt(index);
    state.offlineProjectileSpeeds.removeAt(index);
    state.offlineProjectileAbilityCodes.removeAt(index);
    state.offlineProjectileRanks.removeAt(index);
    state.offlineProjectileCastTimes.removeAt(index);
}

// This is the retained subset of Sim.enterCombat for hostile spell impact. It is
// deliberately invoked on a full resist too: a released hostile spell starts
// combat and idle social aggro, but a resist adds neither damage threat nor a
// movement aura.
enterOfflineSpellProjectileCombat(state: WorldState, casterIndex: int, targetIndex: int): void {
    var casterId = <uint>state.entityIds[casterIndex];
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
        enterIdleMobAggro(state, targetIndex, casterId);
    } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
        state.entityAggroTargetIds[targetIndex] = casterId;
    }
}

landOfflineFrostboltProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = frostboltAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] !=
        abilityCode || rank <= 0) {
        return;
    }

    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    // The world retains hitBonus as its source fraction; SpellResistState
    // models the isolated rating conversion surface, so supply its inverse.
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }

    var resolution = new timedSpell.TimedSpellResult();
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    spell.spellPower = <float>state.entitySpellPower[casterIndex];
    spell.school = "frost";
    spell.castTime = <float>state.offlineProjectileCastTimes[projectileIndex];
    spell.critChance = <float>state.entityCritChance[casterIndex];
    timedSpell.resolveTimedSpellHit(resolution, spell);

    var damage = resolution.damage;
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage); }
    if (hp > 0) {
        applyOfflineMotionAura(
            state,
            targetIndex,
            abilityCode,
            <uint>state.entityIds[casterIndex],
            ccContract.motionAuraKindCode("slow"),
            m4AbilityEffects.metric(abilityIndex, rank, 1, "duration")
        );
        var level = <int>state.entityLevels[casterIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

// Smite has the source nonphysical-spell path: projectile impact first spends
// one resist draw, then the generated direct-damage range and spell-crit draws.
landOfflineSmiteProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var abilityCode = smiteAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("smite");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] !=
        abilityCode || <uint>state.offlineProjectileSchoolCodes[projectileIndex] !=
        OFFLINE_PROJECTILE_SCHOOL_HOLY || rank <= 0) {
        return;
    }
    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }
    var resolution = new timedSpell.TimedSpellResult();
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    resolution.randomUnits.add(nextAuthoritativeRandomUnit(state));
    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    spell.spellPower = <float>state.entitySpellPower[casterIndex];
    spell.school = "holy";
    spell.castTime = <float>state.offlineProjectileCastTimes[projectileIndex];
    spell.critChance = <float>state.entityCritChance[casterIndex];
    timedSpell.resolveTimedSpellHit(resolution, spell);
    var damage = resolution.damage;
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage); }
    if (hp > 0) {
        var level = <int>state.entityLevels[casterIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

landOfflineShadowBoltProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int
): void {
    var abilityCode = shadowBoltAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("shadow_bolt");
    var rank = <int><uint>state.offlineProjectileRanks[projectileIndex];
    if (abilityIndex < 0 || <uint>state.offlineProjectileAbilityCodes[projectileIndex] !=
        abilityCode || <uint>state.offlineProjectileSchoolCodes[projectileIndex] !=
        OFFLINE_PROJECTILE_SCHOOL_SHADOW || rank <= 0) {
        return;
    }
    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }
