appendDefaultAbilityRuntimeColumns(state: WorldState): void {
    state.entityResources.add(0);
    state.entityMaxResources.add(0);
    state.entityCastTargetIds.add(<uint>0);
    state.entityAbilityCooldownOffsets.add(
        <uint>state.entityAbilityCooldownCodes.length
    );
}

abilityRuntimeRowStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length ||
        <int>state.entityResources[index] < 0 ||
        <int>state.entityMaxResources[index] < <int>state.entityResources[index] ||
        state.entityAbilityCooldownOffsets.length != state.entityIds.length + 1) {
        return false;
    }
    var start = <int><uint>state.entityAbilityCooldownOffsets[index];
    var end = <int><uint>state.entityAbilityCooldownOffsets[index + 1];
    if (start < 0 || end < start ||
        end > state.entityAbilityCooldownCodes.length ||
        state.entityAbilityCooldownCodes.length !=
            state.entityAbilityCooldownExpiresAtMicros.length) {
        return false;
    }
    var priorCode: uint = <uint>0;
    var cooldownIndex = start;
    while (cooldownIndex < end) {
        var code = <uint>state.entityAbilityCooldownCodes[cooldownIndex];
        if (code == <uint>0 || code <= priorCode ||
            <uint>state.entityAbilityCooldownExpiresAtMicros[cooldownIndex] <= state.timeMicros) {
            return false;
        }
        priorCode = code;
        cooldownIndex = cooldownIndex + 1;
    }
    return <uint>state.entityCastingAbility[index] != <uint>0 ||
        <uint>state.entityCastTargetIds[index] == <uint>0;
}

appendDefaultTalentAllocationColumns(state: WorldState): void {
