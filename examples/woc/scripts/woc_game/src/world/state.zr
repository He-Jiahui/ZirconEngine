ensureOfflineQuestNpcs(state: WorldState): void {
    if (!state.offlineSessionActive) {
        return;
    }
    var questCatalog = %import("generated/m5_content_catalog");
    var questCode = 1;
    while (questCode <= 2) {
        var questIndex = offlineQuestCatalogIndex(questCode);
        var npcId = questCatalog.text("quest", questIndex, "giverNpcId");
        var npcIndex = questCatalog.indexOf("npc", npcId);
        if (npcIndex < 0) {
            throw "woc offline quest giver is absent from the source catalog";
        }
        var expectedTemplate = <uint>(npcIndex + 1);
        var present = false;
        var entityIndex = 0;
        while (entityIndex < state.entityIds.length) {
            if (<uint>state.entityKinds[entityIndex] == <uint>3 &&
                <uint>state.entityTemplates[entityIndex] == expectedTemplate) {
                present = true;
            }
            entityIndex = entityIndex + 1;
        }
        if (!present) {
            state.spawnQuestNpc(
                expectedTemplate,
                questCatalog.metric("npc", npcIndex, "posX"),
                questCatalog.metric("npc", npcIndex, "posZ"),
                1
            );
        }
        questCode = questCode + 1;
    }
}

// The generated encounter preserves the source Sim constructor's selected
// Eastbrook spawn order. WOS retains the parallel entity columns locally until
// ZrVM can safely carry mutable array-backed world state across modules.
ensureOfflineEastbrookEncounters(state: WorldState): void {
    if (!state.offlineSessionActive) {
        return;
    }
    if (m8EastbrookEncounter.contractTest() != 1) {
        throw "woc offline Eastbrook encounter contract drifted";
    }
    var spawnIndex = 0;
    while (spawnIndex < m8EastbrookEncounter.spawnCount()) {
        var mobId = m8EastbrookEncounter.mobId(spawnIndex);
        var templateIndex = campMobCore.indexOf(mobId, true);
        if (templateIndex < 0 || campMobCore.text(templateIndex, "id", true) != mobId ||
            m8EastbrookEncounter.sourceCampIndex(spawnIndex) < 0 ||
            m8EastbrookEncounter.campMemberIndex(spawnIndex) < 0) {
            throw "woc offline Eastbrook encounter catalog is invalid";
        }
        state.spawnMob(
            <uint>(templateIndex + 1),
            m8EastbrookEncounter.level(spawnIndex),
            m8EastbrookEncounter.x(spawnIndex),
            m8EastbrookEncounter.y(spawnIndex),
            m8EastbrookEncounter.z(spawnIndex),
            m8EastbrookEncounter.maxHp(spawnIndex),
            m8EastbrookEncounter.moveSpeed(spawnIndex)
        );
        var entityIndex = state.entityIds.length - 1;
        state.entityFacing[entityIndex] = m8EastbrookEncounter.facing(spawnIndex);
        state.entityPreviousFacing[entityIndex] = m8EastbrookEncounter.facing(spawnIndex);
        applyEastbrookCombatLoadout(state, entityIndex, spawnIndex);
        applyEastbrookCombatState(state, entityIndex, spawnIndex);
        applyEastbrookLocomotionRecovery(state, entityIndex, spawnIndex);
        applyEastbrookForcedTarget(state, entityIndex, spawnIndex);
        applyEastbrookResourceCooldown(state, entityIndex, spawnIndex);
        applyEastbrookCastChargeTarget(state, entityIndex, spawnIndex);
        applyEastbrookResourceKind(state, entityIndex, spawnIndex);
        applyEastbrookPresentationIdentity(state, entityIndex, spawnIndex);
        applyEastbrookActivityState(state, entityIndex, spawnIndex);
        applyEastbrookTapOwnership(state, entityIndex, spawnIndex);
        applyEastbrookCorpseInstance(state, entityIndex, spawnIndex);
        applyEastbrookHarvestClaim(state, entityIndex, spawnIndex);
        applyEastbrookLootFfa(state, entityIndex, spawnIndex);
        applyEastbrookPetRuntime(state, entityIndex, spawnIndex);
        applyEastbrookBossCadence(state, entityIndex, spawnIndex);
        applyEastbrookBossSpecial(state, entityIndex, spawnIndex);
        state.entityWanderTimers[entityIndex] = m8EastbrookEncounter.wanderTimer(spawnIndex);
        if (<float>state.entityWanderTimers[entityIndex] < 0.0) {
            throw "woc offline Eastbrook wander timer is invalid";
        }
        spawnIndex = spawnIndex + 1;
    }
}

movementReceiptIsValid(
    heldMovementFlags: uint,
    acknowledgement: uint,
    acceptedTick: uint,
    stateTick: uint
): bool {
    // A retained input can only come from a positive-sequence frame. Stale
    // clearing deliberately preserves its receipt, so zero ack is the only
    // empty-receipt form and cannot carry flags or an accepted tick.
    if (acknowledgement == <uint>0) {
        return heldMovementFlags == <uint>0 && acceptedTick == <uint>0;
    }
    return acceptedTick != <uint>0 && acceptedTick <= stateTick;
}

partyEntityIndexById(state: WorldState, entityId: uint): int {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityIds[index] == entityId) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

partyMarkerStateIsValid(state: WorldState): bool {
    var count = state.partyMarkerPartyIds.length;
    if (count != state.partyMarkerEntityIds.length ||
        count != state.partyMarkerSymbols.length || count > 65535) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var partyId = <uint>state.partyMarkerPartyIds[index];
        var entityId = <uint>state.partyMarkerEntityIds[index];
        var symbol = <uint>state.partyMarkerSymbols[index];
        var targetIndex = partyEntityIndexById(state, entityId);
        if (partyId == <uint>0 || symbol > <uint>7 || targetIndex < 0 ||
            <uint>state.entityKinds[targetIndex] != <uint>2 ||
            <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex] ||
            <uint>state.entityOwnerIds[targetIndex] != <uint>0 ||
            partyFirstMemberIndex(state, partyId) < 0) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.partyMarkerPartyIds[prior] == partyId &&
                (<uint>state.partyMarkerEntityIds[prior] == entityId ||
                    <uint>state.partyMarkerSymbols[prior] == symbol)) {
                return false;
            }
            prior = prior + 1;
        }
        index = index + 1;
    }
    return true;
}

partyMasterLootStateIsValid(state: WorldState): bool {
    var count = state.entityIds.length;
    if (state.entityPartyMasterLootEnabled.length != count ||
        state.entityPartyMasterLooterIds.length != count ||
        state.entityPartyMasterLootThresholdCodes.length != count) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var partyId = <uint>state.entityPartyIds[index];
        var enabled = <bool>state.entityPartyMasterLootEnabled[index];
        var looterId = <uint>state.entityPartyMasterLooterIds[index];
        var threshold = <uint>state.entityPartyMasterLootThresholdCodes[index];
        if (partyId == <uint>0) {
            if (enabled || looterId != <uint>0 || threshold != <uint>0) {
                return false;
            }
        } else {
            var first = partyFirstMemberIndex(state, partyId);
            if (first < 0 || threshold > <uint>2 ||
                <bool>state.entityPartyMasterLootEnabled[first] != enabled ||
                <uint>state.entityPartyMasterLooterIds[first] != looterId ||
                <uint>state.entityPartyMasterLootThresholdCodes[first] != threshold) {
                return false;
            }
        }
        index = index + 1;
    }
    return true;
}

partySetMasterLoot(
    state: WorldState,
    partyId: uint,
    enabled: bool,
    looterId: uint,
    threshold: uint
): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            state.entityPartyMasterLootEnabled[index] = enabled;
            state.entityPartyMasterLooterIds[index] = looterId;
            state.entityPartyMasterLootThresholdCodes[index] = threshold;
        }
        index = index + 1;
    }
}

partyEffectiveMasterLooterId(state: WorldState, index: int): uint {
    var partyId = partyIdForIndex(state, index);
    if (partyId == <uint>0 || !<bool>state.entityPartyMasterLootEnabled[index]) {
        return <uint>0;
    }
    var configured = <uint>state.entityPartyMasterLooterIds[index];
    if (configured != <uint>0) {
        var configuredIndex = partyEntityIndexById(state, configured);
        if (configuredIndex >= 0 && partyIdForIndex(state, configuredIndex) == partyId) {
            return configured;
        }
    }
    return <uint>state.entityPartyLeaderIds[index];
}

applyPartySetLootMasterCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>10 || !partyMasterLootStateIsValid(state)) {
        throw "woc party master loot command state is invalid";
    }
    var enabledMarker = <uint>payloadBytes[<int>payloadOffset];
    var threshold = <uint>payloadBytes[<int>(payloadOffset + <uint>9)];
    if (enabledMarker > <uint>1 || threshold > <uint>2) {
        throw "woc party master loot payload is invalid";
    }
    var partyId = partyIdForIndex(state, actorIndex);
    var actorId = <uint>state.entityIds[actorIndex];
    if (partyId == <uint>0 ||
        <uint>state.entityPartyLeaderIds[actorIndex] != actorId) {
        return;
    }
    var looterValue = binary.readF64LeAt(
        payloadBytes, payloadOffset + <uint>1, <uint>8
    );
    var looterId: uint = <uint>0;
    if (looterValue != 0.0) {
        var index = 0;
        while (index < state.entityIds.length) {
            if (<uint>state.entityPartyIds[index] == partyId &&
                <float><uint>state.entityIds[index] == looterValue) {
                looterId = <uint>state.entityIds[index];
                index = state.entityIds.length;
            } else {
                index = index + 1;
            }
        }
    }
    partySetMasterLoot(
        state, partyId, enabledMarker == <uint>1, looterId, threshold
    );
    if (!partyMasterLootStateIsValid(state)) {
        throw "woc party master loot reducer produced invalid state";
    }
}

offlineLootItemQualityCode(itemCode: uint): uint {
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    if (itemIndex < 0) { return <uint>1; }
    var catalog = %import("generated/m5_content_catalog");
    var quality = catalog.text("item", itemIndex, "quality");
    if (quality == "poor") { return <uint>0; }
    if (quality == "uncommon") { return <uint>2; }
    if (quality == "rare") { return <uint>3; }
    if (quality == "epic") { return <uint>4; }
    if (quality == "legendary") { return <uint>5; }
    return <uint>1;
}

partyLootDistributionStateIsValid(state: WorldState): bool {
    var turnCount = state.partyLootTurnPartyIds.length;
    var recipientCount = state.corpseLootRecipientMobIds.length;
    if (turnCount != state.partyLootTurnValues.length || turnCount > 1024 ||
        recipientCount != state.corpseLootRecipientPlayerIds.length ||
        recipientCount != state.corpseLootRecipientOrders.length ||
        recipientCount > 10240) {
        return false;
    }
    var index = 0;
    while (index < turnCount) {
        var partyId = <uint>state.partyLootTurnPartyIds[index];
        if (partyId == <uint>0 || partyFirstMemberIndex(state, partyId) < 0) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.partyLootTurnPartyIds[prior] == partyId) { return false; }
            prior = prior + 1;
        }
        index = index + 1;
    }
    index = 0;
    while (index < recipientCount) {
        var mobId = <uint>state.corpseLootRecipientMobIds[index];
        var playerId = <uint>state.corpseLootRecipientPlayerIds[index];
        var order = <uint>state.corpseLootRecipientOrders[index];
        var mobIndex = partyEntityIndexById(state, mobId);
        var playerIndex = partyEntityIndexById(state, playerId);
        if (mobId == <uint>0 || playerId == <uint>0 || order < <uint>1 ||
            order > <uint>10 || mobIndex < 0 || playerIndex < 0 ||
            <uint>state.entityKinds[mobIndex] != <uint>2 ||
            <uint>state.entityKinds[playerIndex] != <uint>1) {
            return false;
        }
        var priorRecipient = 0;
        while (priorRecipient < index) {
            if (<uint>state.corpseLootRecipientMobIds[priorRecipient] == mobId &&
                (<uint>state.corpseLootRecipientPlayerIds[priorRecipient] == playerId ||
                    <uint>state.corpseLootRecipientOrders[priorRecipient] == order)) {
                return false;
            }
            priorRecipient = priorRecipient + 1;
        }
        index = index + 1;
    }
    return true;
}

removeOfflineCorpseLootRecipients(state: WorldState, mobId: uint): void {
    var index = state.corpseLootRecipientMobIds.length - 1;
    while (index >= 0) {
        if (<uint>state.corpseLootRecipientMobIds[index] == mobId) {
            state.corpseLootRecipientMobIds.removeAt(index);
            state.corpseLootRecipientPlayerIds.removeAt(index);
            state.corpseLootRecipientOrders.removeAt(index);
        }
        index = index - 1;
    }
}

captureOfflineCorpseLootRecipients(
    state: WorldState, mobIndex: int, creditedPlayerIndex: int
): void {
    if (mobIndex < 0 || mobIndex >= state.entityIds.length || creditedPlayerIndex < 0 ||
        creditedPlayerIndex >= state.entityIds.length ||
        <uint>state.entityKinds[mobIndex] != <uint>2 ||
        <uint>state.entityKinds[creditedPlayerIndex] != <uint>1) {
        return;
    }
    var mobId = <uint>state.entityIds[mobIndex];
    removeOfflineCorpseLootRecipients(state, mobId);
    var partyId = partyIdForIndex(state, creditedPlayerIndex);
    var memberOrder: uint = <uint>1;
    var priorStoredOrder: uint = <uint>0;
    while (partyId != <uint>0 && memberOrder <= <uint>10) {
        var selected = -1;
        var selectedOrder: uint = <uint>0;
        var index = 0;
        while (index < state.entityIds.length) {
            var storedOrder = <uint>state.entityPartyMemberOrders[index];
            if (<uint>state.entityKinds[index] == <uint>1 &&
                <uint>state.entityPartyIds[index] == partyId && storedOrder > priorStoredOrder &&
                (selected < 0 || storedOrder < selectedOrder)) {
                selected = index;
                selectedOrder = storedOrder;
            }
            index = index + 1;
        }
        if (selected < 0) { memberOrder = <uint>11; }
        else {
            var dx = <float>state.entityX[selected] - <float>state.entityX[mobIndex];
            var dz = <float>state.entityZ[selected] - <float>state.entityZ[mobIndex];
            if (dx * dx + dz * dz <= 10000.0) {
                state.corpseLootRecipientMobIds.add(mobId);
                state.corpseLootRecipientPlayerIds.add(<uint>state.entityIds[selected]);
                state.corpseLootRecipientOrders.add(memberOrder);
            }
            priorStoredOrder = selectedOrder;
            memberOrder = memberOrder + <uint>1;
        }
    }
    if (state.corpseLootRecipientMobIds.length == 0 ||
        <uint>state.corpseLootRecipientMobIds[
            state.corpseLootRecipientMobIds.length - 1
        ] != mobId) {
        state.corpseLootRecipientMobIds.add(mobId);
        state.corpseLootRecipientPlayerIds.add(
            <uint>state.entityIds[creditedPlayerIndex]
        );
        state.corpseLootRecipientOrders.add(<uint>1);
    }
    if (!partyLootDistributionStateIsValid(state)) {
        throw "woc corpse loot recipient snapshot is invalid";
    }
}

offlineCorpseLootCandidateIds(
    state: WorldState, mobIndex: int
): container.Array<uint> {
    var candidates = new container.Array<uint>();
    if (mobIndex < 0 || mobIndex >= state.entityIds.length) { return candidates; }
    var mobId = <uint>state.entityIds[mobIndex];
    var hasSnapshot = false;
    for (var recipientMobId in state.corpseLootRecipientMobIds) {
        if (<uint>recipientMobId == mobId) { hasSnapshot = true; }
    }
    var memberOrder: uint = <uint>1;
    while (hasSnapshot && memberOrder <= <uint>10) {
        var row = 0;
        while (row < state.corpseLootRecipientMobIds.length) {
            if (<uint>state.corpseLootRecipientMobIds[row] == mobId &&
                <uint>state.corpseLootRecipientOrders[row] == memberOrder) {
                var playerId = <uint>state.corpseLootRecipientPlayerIds[row];
                var playerIndex = partyEntityIndexById(state, playerId);
                if (playerIndex >= 0 && <uint>state.entityKinds[playerIndex] == <uint>1) {
                    candidates.add(playerId);
                }
            }
            row = row + 1;
        }
        memberOrder = memberOrder + <uint>1;
    }
    if (hasSnapshot) { return candidates; }

    var tappedByIndex = partyEntityIndexById(
        state, <uint>state.entityTappedByIds[mobIndex]
    );
    var partyId = partyIdForIndex(state, tappedByIndex);
    if (partyId == <uint>0 || partyMemberCount(state, partyId) <= 1) {
        return candidates;
    }
    memberOrder = <uint>1;
    var priorStoredOrder: uint = <uint>0;
    while (memberOrder <= <uint>10) {
        var selected = -1;
        var selectedOrder: uint = <uint>0;
        var index = 0;
        while (index < state.entityIds.length) {
            var storedOrder = <uint>state.entityPartyMemberOrders[index];
            if (<uint>state.entityKinds[index] == <uint>1 &&
                <uint>state.entityPartyIds[index] == partyId && storedOrder > priorStoredOrder &&
                (selected < 0 || storedOrder < selectedOrder)) {
                selected = index;
                selectedOrder = storedOrder;
            }
            index = index + 1;
        }
        if (selected < 0) { memberOrder = <uint>11; }
        else {
            var dx = <float>state.entityX[selected] - <float>state.entityX[mobIndex];
            var dz = <float>state.entityZ[selected] - <float>state.entityZ[mobIndex];
            if (dx * dx + dz * dz <= 10000.0) {
                candidates.add(<uint>state.entityIds[selected]);
            }
            priorStoredOrder = selectedOrder;
            memberOrder = memberOrder + <uint>1;
        }
    }
    return candidates;
}

partyLootTurnIndex(state: WorldState, partyId: uint): int {
    var index = 0;
    while (index < state.partyLootTurnPartyIds.length) {
        if (<uint>state.partyLootTurnPartyIds[index] == partyId) { return index; }
        index = index + 1;
    }
    return -1;
}

partyLootTurn(state: WorldState, partyId: uint): uint {
    var index = partyLootTurnIndex(state, partyId);
    return index < 0 ? <uint>0 : <uint>state.partyLootTurnValues[index];
}

advancePartyLootTurn(state: WorldState, partyId: uint): void {
    var index = partyLootTurnIndex(state, partyId);
    if (index < 0) {
        if (state.partyLootTurnPartyIds.length >= 1024) {
            throw "woc party loot turn count exceeds WOS cap";
        }
        state.partyLootTurnPartyIds.add(partyId);
        state.partyLootTurnValues.add(<uint>1);
    } else {
        state.partyLootTurnValues[index] =
            <uint>state.partyLootTurnValues[index] + <uint>1;
    }
}

dropPartyLootTurn(state: WorldState, partyId: uint): void {
    var index = partyLootTurnIndex(state, partyId);
    if (index >= 0) {
        state.partyLootTurnPartyIds.removeAt(index);
        state.partyLootTurnValues.removeAt(index);
    }
}

tryAwardOfflineCopperByFairSplit(
    state: WorldState, mobIndex: int, copper: int
): bool {
    var candidates = offlineCorpseLootCandidateIds(state, mobIndex);
    if (copper <= 0 || candidates.length <= 1) { return false; }
    var tappedByIndex = partyEntityIndexById(
        state, <uint>state.entityTappedByIds[mobIndex]
    );
    if (partyIdForIndex(state, tappedByIndex) == <uint>0) { return false; }
    var base = copper / candidates.length;
    var remainder = copper % candidates.length;
    var shares = new container.Array<int>();
    var order = new container.Array<uint>();
    for (var candidateId in candidates) {
        shares.add(base);
        order.add(<uint>candidateId);
    }
    var remainderIndex = 0;
    while (remainderIndex < remainder) {
        var selected = remainderIndex + <int>(nextAuthoritativeRandomUnit(state) *
            <float>(order.length - remainderIndex));
        var selectedId = <uint>order[selected];
        order[selected] = <uint>order[remainderIndex];
        order[remainderIndex] = selectedId;
        var shareIndex = 0;
        while (shareIndex < candidates.length) {
            if (<uint>candidates[shareIndex] == selectedId) {
                shares[shareIndex] = <int>shares[shareIndex] + 1;
                shareIndex = candidates.length;
            } else {
                shareIndex = shareIndex + 1;
            }
        }
        remainderIndex = remainderIndex + 1;
    }
    var candidateIndex = 0;
    while (candidateIndex < candidates.length) {
        var playerIndex = partyEntityIndexById(
            state, <uint>candidates[candidateIndex]
        );
        var amount = <int>shares[candidateIndex];
        if (playerIndex >= 0 && amount > 0) {
            state.entityInventoryCopper[playerIndex] =
                <int>state.entityInventoryCopper[playerIndex] + amount;
        }
        candidateIndex = candidateIndex + 1;
    }
    return true;
}

tryAwardOfflineItemByRoundRobin(
    state: WorldState, mobIndex: int, itemCode: uint
): bool {
    if (offlineLootItemQualityCode(itemCode) > <uint>1) { return false; }
    var candidates = offlineCorpseLootCandidateIds(state, mobIndex);
    if (candidates.length <= 1) { return false; }
    var tappedByIndex = partyEntityIndexById(
        state, <uint>state.entityTappedByIds[mobIndex]
    );
    var partyId = partyIdForIndex(state, tappedByIndex);
    if (partyId == <uint>0) { return false; }
    var turn = partyLootTurn(state, partyId);
    var winnerId = <uint>candidates[<int>(turn % <uint>candidates.length)];
    var winnerIndex = partyEntityIndexById(state, winnerId);
    if (winnerIndex < 0) { return false; }
    advancePartyLootTurn(state, partyId);
    grantM5InventoryItem(state, winnerIndex, itemCode, 1);
    return true;
}

pendingLootRollIndexById(state: WorldState, rollId: uint): int {
    var index = 0;
    while (index < state.pendingLootRollIds.length) {
        if (<uint>state.pendingLootRollIds[index] == rollId) { return index; }
        index = index + 1;
    }
    return -1;
}

hasPendingOfflineLootRollForMob(state: WorldState, mobId: uint): bool {
    for (var pendingMobId in state.pendingLootRollMobIds) {
        if (<uint>pendingMobId == mobId) { return true; }
    }
    return false;
}

lootRollCandidateCount(state: WorldState, rollId: uint): int {
    var count = 0;
    for (var candidateRollId in state.lootRollCandidateRollIds) {
        if (<uint>candidateRollId == rollId) { count = count + 1; }
    }
    return count;
}

lootRollChoices(state: WorldState, rollId: uint): container.Array<uint> {
    var choices = new container.Array<uint>();
    var index = 0;
    while (index < state.lootRollCandidateRollIds.length) {
        if (<uint>state.lootRollCandidateRollIds[index] == rollId) {
            choices.add(<uint>state.lootRollCandidateChoiceCodes[index]);
        }
        index = index + 1;
    }
    return choices;
}

lootRollValues(state: WorldState, rollId: uint): container.Array<uint> {
    var values = new container.Array<uint>();
    var index = 0;
    while (index < state.lootRollCandidateRollIds.length) {
        if (<uint>state.lootRollCandidateRollIds[index] == rollId) {
            values.add(<uint>state.lootRollCandidateValues[index]);
        }
        index = index + 1;
    }
    return values;
}

lootRollCandidatePlayerAt(
    state: WorldState, rollId: uint, ordinal: int
): uint {
    var current = 0;
    var index = 0;
    while (index < state.lootRollCandidateRollIds.length) {
        if (<uint>state.lootRollCandidateRollIds[index] == rollId) {
            if (current == ordinal) {
                return <uint>state.lootRollCandidatePlayerIds[index];
            }
            current = current + 1;
        }
        index = index + 1;
    }
    return <uint>0;
}

lootRollStateIsValid(state: WorldState): bool {
    var pendingCount = state.pendingLootRollIds.length;
    var candidateCount = state.lootRollCandidateRollIds.length;
    if (state.nextLootRollId == <uint>0 || pendingCount > 1024 ||
        pendingCount != state.pendingLootRollMobIds.length ||
        pendingCount != state.pendingLootRollItemCodes.length ||
        pendingCount != state.pendingLootRollQualityCodes.length ||
        pendingCount != state.pendingLootRollExpiresAtMicros.length ||
        pendingCount != state.pendingLootRollMasterLooterIds.length ||
        candidateCount > 10240 ||
        candidateCount != state.lootRollCandidatePlayerIds.length ||
        candidateCount != state.lootRollCandidateChoiceCodes.length ||
        candidateCount != state.lootRollCandidateValues.length) {
        return false;
    }
    var index = 0;
    while (index < pendingCount) {
        var rollId = <uint>state.pendingLootRollIds[index];
        var mobId = <uint>state.pendingLootRollMobIds[index];
        var itemCode = <uint>state.pendingLootRollItemCodes[index];
        var masterLooterId = <uint>state.pendingLootRollMasterLooterIds[index];
        if (rollId == <uint>0 || rollId >= state.nextLootRollId || mobId == <uint>0 ||
            !m5InventoryRules.itemCodeIsValid(itemCode) ||
            <uint>state.pendingLootRollQualityCodes[index] > <uint>5 ||
            <uint>state.pendingLootRollExpiresAtMicros[index] == <uint>0 ||
            lootRollCandidateCount(state, rollId) < 2) {
            return false;
        }
        var prior = 0;
        while (prior < index) {
            if (<uint>state.pendingLootRollIds[prior] == rollId) { return false; }
            prior = prior + 1;
        }
        if (masterLooterId != <uint>0) {
            var masterIndex = partyEntityIndexById(state, masterLooterId);
            if (masterIndex < 0 || <uint>state.entityKinds[masterIndex] != <uint>1) {
                return false;
            }
        }
        index = index + 1;
    }
    index = 0;
    while (index < candidateCount) {
        var candidateRollId = <uint>state.lootRollCandidateRollIds[index];
        var playerId = <uint>state.lootRollCandidatePlayerIds[index];
        var choice = <uint>state.lootRollCandidateChoiceCodes[index];
        var value = <uint>state.lootRollCandidateValues[index];
        var playerIndex = partyEntityIndexById(state, playerId);
        if (pendingLootRollIndexById(state, candidateRollId) < 0 ||
            playerIndex < 0 || <uint>state.entityKinds[playerIndex] != <uint>1 ||
            !lootRollRuntime.choiceIsValid(choice) ||
            (lootRollRuntime.choiceNeedsRoll(choice) ?
                (value < <uint>1 || value > <uint>100) : value != <uint>0)) {
            return false;
        }
        var priorCandidate = 0;
        while (priorCandidate < index) {
            if (<uint>state.lootRollCandidateRollIds[priorCandidate] == candidateRollId &&
                <uint>state.lootRollCandidatePlayerIds[priorCandidate] == playerId) {
                return false;
            }
            priorCandidate = priorCandidate + 1;
        }
        index = index + 1;
    }
    return true;
}

removeOfflineLootRollAt(state: WorldState, pendingIndex: int): void {
    var rollId = <uint>state.pendingLootRollIds[pendingIndex];
    var candidateIndex = state.lootRollCandidateRollIds.length - 1;
    while (candidateIndex >= 0) {
        if (<uint>state.lootRollCandidateRollIds[candidateIndex] == rollId) {
            state.lootRollCandidateRollIds.removeAt(candidateIndex);
            state.lootRollCandidatePlayerIds.removeAt(candidateIndex);
            state.lootRollCandidateChoiceCodes.removeAt(candidateIndex);
            state.lootRollCandidateValues.removeAt(candidateIndex);
        }
        candidateIndex = candidateIndex - 1;
    }
    state.pendingLootRollIds.removeAt(pendingIndex);
    state.pendingLootRollMobIds.removeAt(pendingIndex);
    state.pendingLootRollItemCodes.removeAt(pendingIndex);
    state.pendingLootRollQualityCodes.removeAt(pendingIndex);
    state.pendingLootRollExpiresAtMicros.removeAt(pendingIndex);
    state.pendingLootRollMasterLooterIds.removeAt(pendingIndex);
}

returnOfflineLootRollItemToCorpse(
    state: WorldState, mobId: uint, itemCode: uint
): void {
    var mobIndex = partyEntityIndexById(state, mobId);
    if (mobIndex < 0 || !<bool>state.entityDead[mobIndex] ||
        !corpseSharedLootStateIsValid(state, mobIndex)) {
        return;
    }
    var slot = 0;
    while (slot < corpseSharedLootSlotCount()) {
        var sharedIndex = corpseSharedLootSlotIndex(mobIndex, slot);
        if (<uint>state.entityCorpseSharedItemCodes[sharedIndex] == <uint>0) {
            state.entityCorpseSharedItemCodes[sharedIndex] = itemCode;
            state.entityCorpseSharedItemCounts[sharedIndex] = <uint>1;
            state.entityLootable[mobIndex] = true;
            if (<uint>state.entityCorpseMicros[mobIndex] < <uint>4000000) {
                state.entityCorpseMicros[mobIndex] = <uint>4000000;
            }
            return;
        }
        slot = slot + 1;
    }
    throw "woc returned loot roll item has no corpse slot";
}

resolveOfflineLootRoll(state: WorldState, pendingIndex: int): void {
    var rollId = <uint>state.pendingLootRollIds[pendingIndex];
    var mobId = <uint>state.pendingLootRollMobIds[pendingIndex];
    var itemCode = <uint>state.pendingLootRollItemCodes[pendingIndex];
    var choices = lootRollChoices(state, rollId);
    var values = lootRollValues(state, rollId);
    var tied = lootRollRuntime.tiedWinnerCount(choices, values);
    var tieIndex: uint = <uint>0;
    if (tied > 1) {
        tieIndex = <uint>(nextAuthoritativeRandomUnit(state) * <float>tied);
    }
    var winnerOrdinal = lootRollRuntime.winnerCandidateIndex(
        choices, values, tieIndex
    );
    var winnerId = winnerOrdinal < 0 ? <uint>0 :
        lootRollCandidatePlayerAt(state, rollId, winnerOrdinal);
    removeOfflineLootRollAt(state, pendingIndex);
    var winnerIndex = partyEntityIndexById(state, winnerId);
    if (winnerIndex >= 0 && <uint>state.entityKinds[winnerIndex] == <uint>1) {
        grantM5InventoryItem(state, winnerIndex, itemCode, 1);
    } else {
        returnOfflineLootRollItemToCorpse(state, mobId, itemCode);
    }
    var mobIndex = partyEntityIndexById(state, mobId);
    if (mobIndex >= 0) {
        state.entityLootable[mobIndex] = hasOfflineCorpseLoot(state, mobIndex);
        if (!<bool>state.entityLootable[mobIndex] &&
            <uint>state.entityCorpseMicros[mobIndex] > <uint>4000000) {
            state.entityCorpseMicros[mobIndex] = <uint>4000000;
        }
    }
}

startOfflineNeedGreedRoll(
    state: WorldState, mobIndex: int, itemCode: uint
): bool {
    var quality = offlineLootItemQualityCode(itemCode);
    if (quality < <uint>2 || mobIndex < 0 || mobIndex >= state.entityIds.length) {
        return false;
    }
    var tappedById = <uint>state.entityTappedByIds[mobIndex];
    var tappedByIndex = partyEntityIndexById(state, tappedById);
    if (tappedByIndex < 0) { return false; }
    var partyId = partyIdForIndex(state, tappedByIndex);
    if (partyId == <uint>0) { return false; }
    var candidates = offlineCorpseLootCandidateIds(state, mobIndex);
    if (candidates.length <= 1 || state.pendingLootRollIds.length >= 1024) {
        return false;
    }
    var masterLooterId: uint = <uint>0;
    var thresholdQuality = <uint>state.entityPartyMasterLootThresholdCodes[tappedByIndex] +
        <uint>2;
    if (<bool>state.entityPartyMasterLootEnabled[tappedByIndex] &&
        quality >= thresholdQuality) {
        masterLooterId = partyEffectiveMasterLooterId(state, tappedByIndex);
    }
    var rollId = state.nextLootRollId;
    state.nextLootRollId = state.nextLootRollId + <uint>1;
    state.pendingLootRollIds.add(rollId);
    state.pendingLootRollMobIds.add(<uint>state.entityIds[mobIndex]);
    state.pendingLootRollItemCodes.add(itemCode);
    state.pendingLootRollQualityCodes.add(quality);
    var timeout = masterLooterId == <uint>0 ? <uint>60000000 : <uint>300000000;
    state.pendingLootRollExpiresAtMicros.add(state.timeMicros + timeout);
    state.pendingLootRollMasterLooterIds.add(masterLooterId);
    for (var candidateId in candidates) {
        state.lootRollCandidateRollIds.add(rollId);
        state.lootRollCandidatePlayerIds.add(<uint>candidateId);
        state.lootRollCandidateChoiceCodes.add(lootRollRuntime.pendingChoice());
        state.lootRollCandidateValues.add(<uint>0);
    }
    var retainedCorpseMicros = timeout + <uint>2000000;
    if (<uint>state.entityCorpseMicros[mobIndex] < retainedCorpseMicros) {
        state.entityCorpseMicros[mobIndex] = retainedCorpseMicros;
    }
    if (!lootRollStateIsValid(state)) {
        throw "woc started loot roll state is invalid";
    }
    return true;
}

lootRollCandidateIds(
    state: WorldState, rollId: uint
): container.Array<uint> {
    var candidateIds = new container.Array<uint>();
    var index = 0;
    while (index < state.lootRollCandidateRollIds.length) {
        if (<uint>state.lootRollCandidateRollIds[index] == rollId) {
            candidateIds.add(<uint>state.lootRollCandidatePlayerIds[index]);
        }
        index = index + 1;
    }
    return candidateIds;
}

lootRollTargetContains(targetIds: container.Array<uint>, targetId: uint): bool {
    for (var candidateId in targetIds) {
        if (<uint>candidateId == targetId) { return true; }
    }
    return false;
}

convertOfflineMasterLootRollToNeedGreed(
    state: WorldState,
    pendingIndex: int,
    targetIds: container.Array<uint>
): void {
    var rollId = <uint>state.pendingLootRollIds[pendingIndex];
    var candidateIndex = state.lootRollCandidateRollIds.length - 1;
    while (candidateIndex >= 0) {
        if (<uint>state.lootRollCandidateRollIds[candidateIndex] == rollId) {
            var candidateId = <uint>state.lootRollCandidatePlayerIds[candidateIndex];
            if (!lootRollTargetContains(targetIds, candidateId)) {
                state.lootRollCandidateRollIds.removeAt(candidateIndex);
                state.lootRollCandidatePlayerIds.removeAt(candidateIndex);
                state.lootRollCandidateChoiceCodes.removeAt(candidateIndex);
                state.lootRollCandidateValues.removeAt(candidateIndex);
            } else {
                state.lootRollCandidateChoiceCodes[candidateIndex] =
                    lootRollRuntime.pendingChoice();
                state.lootRollCandidateValues[candidateIndex] = <uint>0;
            }
        }
        candidateIndex = candidateIndex - 1;
    }
    state.pendingLootRollMasterLooterIds[pendingIndex] = <uint>0;
    state.pendingLootRollExpiresAtMicros[pendingIndex] =
        state.timeMicros + <uint>60000000;
    var mobIndex = partyEntityIndexById(
        state, <uint>state.pendingLootRollMobIds[pendingIndex]
    );
    if (mobIndex >= 0 && <uint>state.entityCorpseMicros[mobIndex] < <uint>62000000) {
        state.entityCorpseMicros[mobIndex] = <uint>62000000;
    }
}

applyMasterLootAssignmentCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>9 || payloadLength > <uint>89 ||
        !lootRollStateIsValid(state)) {
        throw "woc master loot assignment command state is invalid";
    }
    var targetCount = <uint>payloadBytes[<int>(payloadOffset + <uint>8)];
    if (targetCount > <uint>10 ||
        payloadLength != <uint>9 + targetCount * <uint>8) {
        throw "woc master loot assignment payload is invalid";
    }
    var rollValue = binary.readF64LeAt(payloadBytes, payloadOffset, <uint>8);
    if (rollValue <= 0.0) {
        throw "woc master loot assignment roll id is invalid";
    }
    var rollId = <uint>rollValue;
    if (<float>rollId != rollValue) {
        throw "woc master loot assignment roll id is invalid";
    }
    var pendingIndex = pendingLootRollIndexById(state, rollId);
    var actorId = <uint>state.entityIds[actorIndex];
    if (pendingIndex < 0 ||
        <uint>state.pendingLootRollMasterLooterIds[pendingIndex] != actorId) {
        return;
    }
    var originalTargets = lootRollCandidateIds(state, rollId);
    var validTargets = new container.Array<uint>();
    var ordinal: uint = <uint>0;
    while (ordinal < targetCount) {
        var targetOffset = payloadOffset + <uint>9 + ordinal * <uint>8;
        var targetValue = binary.readF64LeAt(payloadBytes, targetOffset, <uint>8);
        if (targetValue > 0.0) {
            var targetId = <uint>targetValue;
            if (<float>targetId == targetValue &&
                lootRollTargetContains(originalTargets, targetId) &&
                !lootRollTargetContains(validTargets, targetId)) {
                validTargets.add(targetId);
            }
        }
        ordinal = ordinal + <uint>1;
    }
    if (validTargets.length == 0) { return; }
    if (validTargets.length == 1) {
        var targetId = <uint>validTargets[0];
        var targetIndex = partyEntityIndexById(state, targetId);
        if (targetIndex < 0 || <uint>state.entityKinds[targetIndex] != <uint>1) {
            convertOfflineMasterLootRollToNeedGreed(
                state, pendingIndex, originalTargets
            );
            if (!lootRollStateIsValid(state)) {
                throw "woc master loot assignment fallback produced invalid state";
            }
            return;
        }
        var mobId = <uint>state.pendingLootRollMobIds[pendingIndex];
        var itemCode = <uint>state.pendingLootRollItemCodes[pendingIndex];
        removeOfflineLootRollAt(state, pendingIndex);
        grantM5InventoryItem(state, targetIndex, itemCode, 1);
        var mobIndex = partyEntityIndexById(state, mobId);
        if (mobIndex >= 0) {
            state.entityLootable[mobIndex] = hasOfflineCorpseLoot(state, mobIndex);
            if (!<bool>state.entityLootable[mobIndex] &&
                <uint>state.entityCorpseMicros[mobIndex] > <uint>4000000) {
                state.entityCorpseMicros[mobIndex] = <uint>4000000;
            }
        }
    } else {
        convertOfflineMasterLootRollToNeedGreed(state, pendingIndex, validTargets);
    }
    if (!lootRollStateIsValid(state)) {
        throw "woc master loot assignment reducer produced invalid state";
    }
}

applyLootRollCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>9 || !lootRollStateIsValid(state)) {
        throw "woc loot roll command state is invalid";
    }
    var rollValue = binary.readF64LeAt(payloadBytes, payloadOffset, <uint>8);
    var wireChoice = <uint>payloadBytes[<int>(payloadOffset + <uint>8)];
    if (rollValue <= 0.0 || wireChoice > <uint>2) {
        throw "woc loot roll payload is invalid";
    }
    var rollId = <uint>rollValue;
    if (<float>rollId != rollValue) {
        throw "woc loot roll payload is invalid";
    }
    var pendingIndex = pendingLootRollIndexById(state, rollId);
    if (pendingIndex < 0 ||
        <uint>state.pendingLootRollMasterLooterIds[pendingIndex] != <uint>0) {
        return;
    }
    var actorId = <uint>state.entityIds[actorIndex];
    var candidateIndex = 0;
    while (candidateIndex < state.lootRollCandidateRollIds.length &&
        (<uint>state.lootRollCandidateRollIds[candidateIndex] != rollId ||
            <uint>state.lootRollCandidatePlayerIds[candidateIndex] != actorId)) {
        candidateIndex = candidateIndex + 1;
    }
    if (candidateIndex >= state.lootRollCandidateRollIds.length ||
        <uint>state.lootRollCandidateChoiceCodes[candidateIndex] !=
            lootRollRuntime.pendingChoice()) {
        return;
    }
    var choice = lootRollRuntime.wireChoiceToState(wireChoice);
    state.lootRollCandidateChoiceCodes[candidateIndex] = choice;
    state.lootRollCandidateValues[candidateIndex] = lootRollRuntime.choiceNeedsRoll(choice) ?
        <uint>1 + <uint>(nextAuthoritativeRandomUnit(state) * 100.0) : <uint>0;
    if (lootRollRuntime.allAnswered(lootRollChoices(state, rollId))) {
        resolveOfflineLootRoll(state, pendingIndex);
    }
    if (!lootRollStateIsValid(state)) {
        throw "woc loot roll reducer produced invalid state";
    }
}

updateOfflineLootRolls(state: WorldState): void {
    var pendingIndex = 0;
    while (pendingIndex < state.pendingLootRollIds.length) {
        if (<uint>state.pendingLootRollExpiresAtMicros[pendingIndex] > state.timeMicros) {
            pendingIndex = pendingIndex + 1;
        } else if (<uint>state.pendingLootRollMasterLooterIds[pendingIndex] != <uint>0) {
            var rollId = <uint>state.pendingLootRollIds[pendingIndex];
            state.pendingLootRollMasterLooterIds[pendingIndex] = <uint>0;
            state.pendingLootRollExpiresAtMicros[pendingIndex] =
                state.timeMicros + <uint>60000000;
            var candidateIndex = 0;
            while (candidateIndex < state.lootRollCandidateRollIds.length) {
                if (<uint>state.lootRollCandidateRollIds[candidateIndex] == rollId) {
                    state.lootRollCandidateChoiceCodes[candidateIndex] =
                        lootRollRuntime.pendingChoice();
                    state.lootRollCandidateValues[candidateIndex] = <uint>0;
                }
                candidateIndex = candidateIndex + 1;
            }
            var mobIndex = partyEntityIndexById(
                state, <uint>state.pendingLootRollMobIds[pendingIndex]
            );
            if (mobIndex >= 0 &&
                <uint>state.entityCorpseMicros[mobIndex] < <uint>62000000) {
                state.entityCorpseMicros[mobIndex] = <uint>62000000;
            }
            pendingIndex = pendingIndex + 1;
        } else {
            resolveOfflineLootRoll(state, pendingIndex);
        }
    }
    if (!lootRollStateIsValid(state)) {
        throw "woc updated loot roll state is invalid";
    }
}

restorePartyMarkerState(state: WorldState): targetingMarkers.MarkerState {
    var markerState = new targetingMarkers.MarkerState();
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>1) {
            targetingMarkers.setParty(
                markerState, index + 1, <int><uint>state.entityPartyIds[index]
            );
        }
        targetingMarkers.addEntity(
            markerState,
            <int><uint>state.entityIds[index],
            <int><uint>state.entityKinds[index],
            <bool>state.entityDead[index],
            <bool>state.entityHostile[index],
            <int><uint>state.entityOwnerIds[index]
        );
        index = index + 1;
    }
    index = 0;
    while (index < state.partyMarkerPartyIds.length) {
        markerState.markPartyIds.add(<int><uint>state.partyMarkerPartyIds[index]);
        markerState.markEntityIds.add(<int><uint>state.partyMarkerEntityIds[index]);
        markerState.markSymbols.add(<int><uint>state.partyMarkerSymbols[index]);
        index = index + 1;
    }
    return markerState;
}

commitPartyMarkerState(
    state: WorldState, markerState: targetingMarkers.MarkerState
): void {
    state.partyMarkerPartyIds = new container.Array<uint>();
    state.partyMarkerEntityIds = new container.Array<uint>();
    state.partyMarkerSymbols = new container.Array<uint>();
    var index = 0;
    while (index < markerState.markPartyIds.length) {
        state.partyMarkerPartyIds.add(<uint><int>markerState.markPartyIds[index]);
        state.partyMarkerEntityIds.add(<uint><int>markerState.markEntityIds[index]);
        state.partyMarkerSymbols.add(<uint><int>markerState.markSymbols[index]);
        index = index + 1;
    }
}

dropPartyMarkerRows(state: WorldState, partyId: uint): void {
    var index = 0;
    while (index < state.partyMarkerPartyIds.length &&
        <uint>state.partyMarkerPartyIds[index] != partyId) {
        index = index + 1;
    }
    if (index >= state.partyMarkerPartyIds.length) { return; }
    var markerState = restorePartyMarkerState(state);
    targetingMarkers.dropPartyMarkers(markerState, <int>partyId);
    commitPartyMarkerState(state, markerState);
}

clearPartyMarkerEntityRows(state: WorldState, entityId: uint): void {
    var index = 0;
    while (index < state.partyMarkerEntityIds.length &&
        <uint>state.partyMarkerEntityIds[index] != entityId) {
        index = index + 1;
    }
    if (index >= state.partyMarkerEntityIds.length) { return; }
    var markerState = restorePartyMarkerState(state);
    targetingMarkers.clearEntityMarker(markerState, <int>entityId);
    commitPartyMarkerState(state, markerState);
}

applyPartyMarkerCommand(
    state: WorldState,
    actorIndex: int,
    commandId: uint,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (!partyMarkerStateIsValid(state)) {
        throw "woc party marker state is invalid";
    }
    var payloads = %import("protocol/command_payloads");
    var setCommand = commandId == payloads.partySetMarkerCommandId(true);
    var clearCommand = commandId == payloads.partyClearMarkerCommandId(true);
    if ((!setCommand && !clearCommand) ||
        (setCommand && payloadLength != <uint>16) ||
        (clearCommand && payloadLength != <uint>8)) {
        throw "woc party marker command payload is invalid";
    }
    var entityValue = binary.readF64LeAt(payloadBytes, payloadOffset, <uint>8);
    if (entityValue <= 0.0 || entityValue > 9007199254740991.0) { return; }
    var entityId = <uint>entityValue;
    if (<float>entityId != entityValue) { return; }
    var markerState = restorePartyMarkerState(state);
    if (setCommand) {
        var markerValue = binary.readF64LeAt(
            payloadBytes, payloadOffset + <uint>8, <uint>8
        );
        var markerId = <int>markerValue;
        if (markerValue < 0.0 || markerValue > 7.0 || <float>markerId != markerValue) {
            return;
        }
        targetingMarkers.setMarker(
            markerState, actorIndex + 1, <int>entityId, markerId
        );
    } else {
        targetingMarkers.clearMarker(markerState, actorIndex + 1, <int>entityId);
    }
    commitPartyMarkerState(state, markerState);
    if (!partyMarkerStateIsValid(state)) {
        throw "woc party marker reducer produced invalid state";
    }
}

arenaQueueFormatFromWire(wireFormat: uint): uint {
    if (wireFormat > <uint>4) {
        return <uint>0;
    }
    return wireFormat + <uint>1;
}

arenaQueueFormatIsValid(storedFormat: uint): bool {
    return storedFormat >= <uint>1 && storedFormat <= <uint>5;
}

clearArenaQueueRow(state: WorldState, index: int): void {
    state.entityArenaQueueFormats[index] = <uint>0;
    state.entityArenaQueueUnitOrders[index] = <uint>0;
    state.entityArenaQueueMemberOrders[index] = <uint>0;
    state.entityArenaQueueRatings[index] = 0.0;
}

arenaQueueLadderRating(state: WorldState, index: int, storedFormat: uint): float {
    return storedFormat == <uint>1 ? <float>state.entityArenaRatings[index] :
        <float>state.entityArena2v2Ratings[index];
}

arenaQueueAdmissionRating(
    state: WorldState,
    partyId: uint,
    actorIndex: int,
    storedFormat: uint,
    memberCount: int
): float {
    if (partyId == <uint>0 || memberCount == 1) {
        return arenaQueueLadderRating(state, actorIndex, storedFormat);
    }
    var total = 0.0;
    var counted = 0;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            total = total + arenaQueueLadderRating(state, index, storedFormat);
            counted = counted + 1;
        }
        index = index + 1;
    }
    if (counted != memberCount) {
        throw "woc arena queue party rating is invalid";
    }
    return total / <float>counted;
}

arenaQueueUnitMemberCount(
    state: WorldState,
    storedFormat: uint,
    unitOrder: uint
): int {
    var count = 0;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityArenaQueueFormats[index] == storedFormat &&
            <uint>state.entityArenaQueueUnitOrders[index] == unitOrder) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// Mirrors arenaQueuePosition's team-unit walk. It is intentionally a derived
// query: repeated same-format requests can use it once Plugins08 exposes the
// source arenaQueued event without adding another authoritative column.
arenaQueuePositionForIndex(state: WorldState, actorIndex: int): int {
    if (actorIndex < 0 || actorIndex >= state.entityIds.length) {
        return 0;
    }
    var storedFormat = <uint>state.entityArenaQueueFormats[actorIndex];
    var unitOrder = <uint>state.entityArenaQueueUnitOrders[actorIndex];
    if (!arenaQueueFormatIsValid(storedFormat) || unitOrder == <uint>0) {
        return 0;
    }
    var position = 0;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityArenaQueueFormats[index] == storedFormat &&
            <uint>state.entityArenaQueueUnitOrders[index] < unitOrder &&
            <uint>state.entityArenaQueueMemberOrders[index] == <uint>1) {
            position = position + arenaQueueUnitMemberCount(
                state, storedFormat, <uint>state.entityArenaQueueUnitOrders[index]
            );
        }
        index = index + 1;
    }
    return position + 1;
}

arenaQueueMemberCanJoin(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length &&
        <uint>state.entityKinds[index] == <uint>1 &&
        !<bool>state.entityDead[index] &&
        <uint>state.entityArenaQueueFormats[index] == <uint>0 &&
        <float>state.entityX[index] <= 600.0;
}

arenaQueuePartyMembersCanJoin(
    state: WorldState,
    partyId: uint,
    memberCount: int
): bool {
    var seen = 0;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            if (!arenaQueueMemberCanJoin(state, index)) {
                return false;
            }
            seen = seen + 1;
        }
        index = index + 1;
    }
    return seen == memberCount;
}

queueArenaUnitForParty(
    state: WorldState,
    partyId: uint,
    actorIndex: int,
    storedFormat: uint,
    memberCount: int
): void {
    var unitOrder = state.nextArenaQueueUnitOrder;
    if (unitOrder == <uint>0) {
        throw "woc arena queue unit order is invalid";
    }
    state.nextArenaQueueUnitOrder = unitOrder + <uint>1;
    var queueRating = arenaQueueAdmissionRating(
        state, partyId, actorIndex, storedFormat, memberCount
    );
    if (partyId == <uint>0 || memberCount == 1) {
        state.entityArenaQueueFormats[actorIndex] = storedFormat;
        state.entityArenaQueueUnitOrders[actorIndex] = unitOrder;
        state.entityArenaQueueMemberOrders[actorIndex] = <uint>1;
        state.entityArenaQueueRatings[actorIndex] = queueRating;
        return;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            state.entityArenaQueueFormats[index] = storedFormat;
            state.entityArenaQueueUnitOrders[index] = unitOrder;
            state.entityArenaQueueMemberOrders[index] =
                <uint>state.entityPartyMemberOrders[index];
            state.entityArenaQueueRatings[index] = queueRating;
        }
        index = index + 1;
    }
}

applyArenaQueueCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadBytes: container.Array<uint>
): void {
    var storedFormat = arenaQueueFormatFromWire(
        <uint>payloadBytes[<int>payloadOffset]
    );
    if (!arenaQueueFormatIsValid(storedFormat)) {
        throw "woc arena queue format is invalid";
    }
    var currentFormat = <uint>state.entityArenaQueueFormats[actorIndex];
    // The source treats a repeated same-format request as an idempotent
    // position read, and a different-format request as an error event.
    if (currentFormat != <uint>0) {
        return;
    }
    if (!arenaQueueMemberCanJoin(state, actorIndex)) {
        return;
    }
    var partyId = partyIdForIndex(state, actorIndex);
    var memberCount = partyId == <uint>0 ? 1 : partyMemberCount(state, partyId);
    if (storedFormat == <uint>1) {
        if (memberCount > 1) {
            return;
        }
        queueArenaUnitForParty(state, <uint>0, actorIndex, storedFormat, 1);
        return;
    }

    var maximumMembers = storedFormat == <uint>4 ? 3 :
        (storedFormat == <uint>5 ? 5 : 2);
    var requiresExactPair = storedFormat == <uint>2 || storedFormat == <uint>3;
    if (memberCount > maximumMembers || (requiresExactPair && memberCount > 1 &&
        memberCount != 2)) {
        return;
    }
    if (memberCount > 1 &&
        <uint>state.entityPartyLeaderIds[actorIndex] != <uint>state.entityIds[actorIndex]) {
        return;
    }
    if (partyId != <uint>0 && !arenaQueuePartyMembersCanJoin(
        state, partyId, memberCount
    )) {
        return;
    }
    queueArenaUnitForParty(state, partyId, actorIndex, storedFormat, memberCount);
}

applyArenaLeaveCommand(state: WorldState, actorIndex: int): void {
    var storedFormat = <uint>state.entityArenaQueueFormats[actorIndex];
    var unitOrder = <uint>state.entityArenaQueueUnitOrders[actorIndex];
    if (!arenaQueueFormatIsValid(storedFormat) || unitOrder == <uint>0) {
        return;
    }
    // arenaDequeue removes an entire premade unit even if party membership has
    // since changed; unit order, not the current party rows, is authoritative.
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityArenaQueueFormats[index] == storedFormat &&
            <uint>state.entityArenaQueueUnitOrders[index] == unitOrder) {
            clearArenaQueueRow(state, index);
        }
        index = index + 1;
    }
}

arenaQueueStateIsValid(state: WorldState): bool {
    if (state.nextArenaQueueUnitOrder == <uint>0 ||
        state.entityArenaQueueFormats.length != state.entityIds.length ||
        state.entityArenaQueueUnitOrders.length != state.entityIds.length ||
        state.entityArenaQueueMemberOrders.length != state.entityIds.length ||
        state.entityArenaRatings.length != state.entityIds.length ||
        state.entityArenaWins.length != state.entityIds.length ||
        state.entityArenaLosses.length != state.entityIds.length ||
        state.entityArena2v2Ratings.length != state.entityIds.length ||
        state.entityArena2v2Wins.length != state.entityIds.length ||
        state.entityArena2v2Losses.length != state.entityIds.length ||
        state.entityArenaQueueRatings.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var storedFormat = <uint>state.entityArenaQueueFormats[index];
        var unitOrder = <uint>state.entityArenaQueueUnitOrders[index];
        var memberOrder = <uint>state.entityArenaQueueMemberOrders[index];
        var queueRating = <float>state.entityArenaQueueRatings[index];
        var playerRow = <uint>state.entityKinds[index] == <uint>1;
        if (playerRow) {
            if (<int>state.entityArenaRatings[index] < 100 ||
                <int>state.entityArenaWins[index] < 0 ||
                <int>state.entityArenaLosses[index] < 0 ||
                <int>state.entityArena2v2Ratings[index] < 100 ||
                <int>state.entityArena2v2Wins[index] < 0 ||
                <int>state.entityArena2v2Losses[index] < 0) {
                return false;
            }
        } else if (<int>state.entityArenaRatings[index] != 0 ||
            <int>state.entityArenaWins[index] != 0 ||
            <int>state.entityArenaLosses[index] != 0 ||
            <int>state.entityArena2v2Ratings[index] != 0 ||
            <int>state.entityArena2v2Wins[index] != 0 ||
            <int>state.entityArena2v2Losses[index] != 0) {
            return false;
        }
        if (storedFormat == <uint>0) {
            if (unitOrder != <uint>0 || memberOrder != <uint>0 || queueRating != 0.0) {
                return false;
            }
        } else if (!arenaQueueFormatIsValid(storedFormat) || unitOrder == <uint>0 ||
            unitOrder >= state.nextArenaQueueUnitOrder ||
            memberOrder == <uint>0 || queueRating < 100.0 ||
            <uint>state.entityKinds[index] != <uint>1) {
            return false;
        }
        var maximumMembers = storedFormat == <uint>4 ? <uint>3 :
            (storedFormat == <uint>5 ? <uint>5 : <uint>2);
        if (storedFormat == <uint>1) {
            maximumMembers = <uint>1;
        }
        if (storedFormat != <uint>0 && memberOrder > maximumMembers) {
            return false;
        }
        var unitHasFirstMember = memberOrder == <uint>1;
        var prior = 0;
        while (prior < index) {
            if (storedFormat != <uint>0 &&
                <uint>state.entityArenaQueueUnitOrders[prior] == unitOrder &&
                (<uint>state.entityArenaQueueFormats[prior] != storedFormat ||
                    <uint>state.entityArenaQueueMemberOrders[prior] == memberOrder ||
                    <float>state.entityArenaQueueRatings[prior] != queueRating)) {
                return false;
            }
            if (storedFormat != <uint>0 &&
                <uint>state.entityArenaQueueUnitOrders[prior] == unitOrder &&
                <uint>state.entityArenaQueueFormats[prior] == storedFormat &&
                <uint>state.entityArenaQueueMemberOrders[prior] == <uint>1) {
                unitHasFirstMember = true;
            }
            prior = prior + 1;
        }
        if (storedFormat != <uint>0 && !unitHasFirstMember) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

partyIdForIndex(state: WorldState, index: int): uint {
    if (index < 0 || index >= state.entityIds.length ||
        <uint>state.entityKinds[index] != <uint>1) {
        return <uint>0;
    }
    return <uint>state.entityPartyIds[index];
}

partyMemberCount(state: WorldState, partyId: uint): int {
    var count = 0;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

partyFirstMemberIndex(state: WorldState, partyId: uint): int {
    var result = -1;
    var lowestOrder: uint = <uint>0;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            var order = <uint>state.entityPartyMemberOrders[index];
            if (result < 0 || order < lowestOrder) {
                result = index;
                lowestOrder = order;
            }
        }
        index = index + 1;
    }
    return result;
}

partyNextMemberOrder(state: WorldState, partyId: uint): uint {
    var highest: uint = <uint>0;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId &&
            <uint>state.entityPartyMemberOrders[index] > highest) {
            highest = <uint>state.entityPartyMemberOrders[index];
        }
        index = index + 1;
    }
    return highest + <uint>1;
}

partySetLeader(state: WorldState, partyId: uint, leaderId: uint): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            state.entityPartyLeaderIds[index] = leaderId;
        }
        index = index + 1;
    }
}

partySetRaid(state: WorldState, partyId: uint, raid: bool): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            state.entityPartyRaids[index] = raid;
            if (!raid) {
                state.entityPartyRaidGroups[index] = <uint>0;
            }
        }
        index = index + 1;
    }
}

partySetDungeonDifficulty(state: WorldState, partyId: uint, heroic: bool): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            state.entityPartyDungeonDifficultyHeroic[index] = heroic;
        }
        index = index + 1;
    }
}

effectiveDungeonDifficultyForIndex(state: WorldState, index: int): uint {
    if (index < 0 || index >= state.entityIds.length ||
        <uint>state.entityKinds[index] != <uint>1) {
        return <uint>0;
    }
    if (<uint>state.entityPartyIds[index] != <uint>0) {
        return <bool>state.entityPartyDungeonDifficultyHeroic[index] ? <uint>1 : <uint>0;
    }
    return <bool>state.entityDungeonDifficultyPersonalHeroic[index] ? <uint>1 : <uint>0;
}

readyCheckResponseIsValid(response: uint): bool {
    return response <= <uint>2;
}

clearReadyCheckRow(state: WorldState, index: int): void {
    state.entityReadyCheckPartyIds[index] = <uint>0;
    state.entityReadyCheckInitiatorIds[index] = <uint>0;
    state.entityReadyCheckEndsAtMicros[index] = <uint>0;
    state.entityReadyCheckResponses[index] = <uint>0;
}

partyReadyCheckExists(state: WorldState, partyId: uint): bool {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityReadyCheckPartyIds[index] == partyId) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

partyReadyCheckHasPending(state: WorldState, partyId: uint): bool {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityReadyCheckPartyIds[index] == partyId &&
            <uint>state.entityReadyCheckResponses[index] == <uint>0) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

clearPartyReadyCheck(state: WorldState, partyId: uint): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityReadyCheckPartyIds[index] == partyId) {
            clearReadyCheckRow(state, index);
        }
        index = index + 1;
    }
}

// The source retains ReadyCheck on Sim rather than in PlayerMeta. WOS has no
// retained world object between ticks, so an active check is valid only when
// every current member carries one identical snapshot row.
partyReadyCheckStateIsValid(state: WorldState): bool {
    if (state.entityReadyCheckPartyIds.length != state.entityIds.length ||
        state.entityReadyCheckInitiatorIds.length != state.entityIds.length ||
        state.entityReadyCheckEndsAtMicros.length != state.entityIds.length ||
        state.entityReadyCheckResponses.length != state.entityIds.length) {
        return false;
    }
    var index = 0;
    while (index < state.entityIds.length) {
        var partyId = <uint>state.entityPartyIds[index];
        var readyPartyId = <uint>state.entityReadyCheckPartyIds[index];
        var initiator = <uint>state.entityReadyCheckInitiatorIds[index];
        var endsAt = <uint>state.entityReadyCheckEndsAtMicros[index];
        var response = <uint>state.entityReadyCheckResponses[index];
        if (readyPartyId == <uint>0) {
            if (initiator != <uint>0 || endsAt != <uint>0 || response != <uint>0) {
                return false;
            }
        } else {
            if (readyPartyId != partyId || partyId == <uint>0 || initiator == <uint>0 ||
                endsAt <= state.timeMicros || !readyCheckResponseIsValid(response)) {
                return false;
            }
            var memberIndex = 0;
            while (memberIndex < state.entityIds.length) {
                if (<uint>state.entityPartyIds[memberIndex] == readyPartyId &&
                    (<uint>state.entityReadyCheckPartyIds[memberIndex] != readyPartyId ||
                        <uint>state.entityReadyCheckInitiatorIds[memberIndex] != initiator ||
                        <uint>state.entityReadyCheckEndsAtMicros[memberIndex] != endsAt ||
                        !readyCheckResponseIsValid(
                            <uint>state.entityReadyCheckResponses[memberIndex]
                        ))) {
                    return false;
                }
                memberIndex = memberIndex + 1;
            }
        }
        index = index + 1;
    }
    return true;
}

chatTokenStateIsValid(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length &&
        chatWireState.tokenStateIsValid(
            <bool>state.entityChatTokenBucketPresent[index],
            <float>state.entityChatTokenBuckets[index],
            <uint>state.entityChatTokenAtMicros[index], state.timeMicros
        );
}

consumeChatToken(state: WorldState, actorIndex: int): bool {
    if (!chatTokenStateIsValid(state, actorIndex)) return false;
    var tokens = chatWireState.refilledTokens(
        <bool>state.entityChatTokenBucketPresent[actorIndex],
        <float>state.entityChatTokenBuckets[actorIndex],
        <uint>state.entityChatTokenAtMicros[actorIndex], state.timeMicros
    );
    state.entityChatTokenBucketPresent[actorIndex] = true;
    state.entityChatTokenAtMicros[actorIndex] = state.timeMicros;
    if (tokens < 1.0) {
        state.entityChatTokenBuckets[actorIndex] = tokens;
        return false;
    }
    state.entityChatTokenBuckets[actorIndex] = tokens - 1.0;
    return true;
}

applyChatCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    var route = chatWireState.routeFromPayload(
        payloadOffset, payloadLength, payloadBytes
    );
    if (route == chatWireState.malformedRoute() || route == chatWireState.emptyRoute()) return;
    if (!consumeChatToken(state, actorIndex)) return;
    if (route == chatWireState.readyRoute()) startPartyReadyCheck(state, actorIndex);
    // The remaining source routes require account moderation, channel/whisper
    // membership and personal event delivery. Their valid messages consume the
    // source Sim token here but remain state-neutral until those owners land.
}

// The WOS158 chat bridge reaches this retained WOS20 ready-check reducer after
// UTF-8/UTF-16 admission and the source Sim token bucket.
startPartyReadyCheck(state: WorldState, actorIndex: int): void {
    if (actorIndex < 0 || actorIndex >= state.entityIds.length) {
        return;
    }
    var partyId = partyIdForIndex(state, actorIndex);
    var actorId = <uint>state.entityIds[actorIndex];
    if (partyId == <uint>0 || <uint>state.entityPartyLeaderIds[actorIndex] != actorId ||
        partyReadyCheckExists(state, partyId)) {
        return;
    }
    var endsAt = state.timeMicros + <uint>30000000;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId) {
            state.entityReadyCheckPartyIds[index] = partyId;
            state.entityReadyCheckInitiatorIds[index] = actorId;
            state.entityReadyCheckEndsAtMicros[index] = endsAt;
            state.entityReadyCheckResponses[index] =
                <uint>state.entityIds[index] == actorId ? <uint>1 : <uint>0;
        }
        index = index + 1;
    }
}

applyPartyReadyRespondCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadBytes: container.Array<uint>
): void {
    var partyId = partyIdForIndex(state, actorIndex);
    if (partyId == <uint>0 ||
        <uint>state.entityReadyCheckPartyIds[actorIndex] != partyId) {
        return;
    }
    var ready = <uint>payloadBytes[<int>payloadOffset];
    if (ready > <uint>1) {
        throw "woc ready-check response payload is invalid";
    }
    state.entityReadyCheckResponses[actorIndex] = ready == <uint>1 ? <uint>1 : <uint>2;
    if (!partyReadyCheckHasPending(state, partyId)) {
        clearPartyReadyCheck(state, partyId);
    }
}

// This is the source end-of-tick sweep. WOS has no client event channel yet,
// so finalization commits the same removal boundary while the source's prompt
// and counts-only notices remain a presentation-host responsibility.
updatePartyReadyChecks(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        var partyId = <uint>state.entityReadyCheckPartyIds[index];
        if (partyId != <uint>0) {
            var seen = false;
            var prior = 0;
            while (prior < index) {
                if (<uint>state.entityReadyCheckPartyIds[prior] == partyId) {
                    seen = true;
                }
                prior = prior + 1;
            }
            if (!seen && (state.timeMicros >= <uint>state.entityReadyCheckEndsAtMicros[index] ||
                !partyReadyCheckHasPending(state, partyId))) {
                clearPartyReadyCheck(state, partyId);
            }
        }
        index = index + 1;
    }
}

partyRemoveReadyCheckMember(state: WorldState, index: int): void {
    // Mirrors party.ts deleting exactly the leaver's response. The shared
    // end-of-tick sweep performs an early finalization after this command batch.
    clearReadyCheckRow(state, index);
}

partyNormalizeRaidGroups(state: WorldState, partyId: uint): void {
    var memberCount = partyMemberCount(state, partyId);
    var position = 0;
    var priorOrder: uint = <uint>0;
    while (position < memberCount) {
        var selected = -1;
        var selectedOrder: uint = <uint>0;
        var index = 0;
        while (index < state.entityIds.length) {
            var order = <uint>state.entityPartyMemberOrders[index];
            if (<uint>state.entityPartyIds[index] == partyId && order > priorOrder &&
                (selected < 0 || order < selectedOrder)) {
                selected = index;
                selectedOrder = order;
            }
            index = index + 1;
        }
        if (selected < 0) {
            throw "woc party member order is invalid";
        }
        state.entityPartyRaidGroups[selected] = position < 5 ? <uint>1 : <uint>2;
        priorOrder = selectedOrder;
        position = position + 1;
    }
}

partyRaidGroupCount(state: WorldState, partyId: uint, group: uint): int {
    var count = 0;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityPartyIds[index] == partyId &&
            <uint>state.entityPartyRaidGroups[index] == group) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

partyClearMember(state: WorldState, index: int): void {
    state.entityPartyIds[index] = <uint>0;
    state.entityPartyLeaderIds[index] = <uint>0;
    state.entityPartyRaids[index] = false;
    state.entityPartyRaidGroups[index] = <uint>0;
    state.entityPartyMemberOrders[index] = <uint>0;
    state.entityPartyDungeonDifficultyHeroic[index] = false;
    state.entityPartyMasterLootEnabled[index] = false;
    state.entityPartyMasterLooterIds[index] = <uint>0;
    state.entityPartyMasterLootThresholdCodes[index] = <uint>0;
    clearReadyCheckRow(state, index);
}

partyRemoveMember(state: WorldState, index: int): void {
    var partyId = partyIdForIndex(state, index);
    if (partyId == <uint>0) {
        return;
    }
    var removedId = <uint>state.entityIds[index];
    var wasLeader = <uint>state.entityPartyLeaderIds[index] == removedId;
    partyRemoveReadyCheckMember(state, index);
    partyClearMember(state, index);
    if (partyMemberCount(state, partyId) <= 1) {
        dropPartyMarkerRows(state, partyId);
        dropPartyLootTurn(state, partyId);
        clearPartyReadyCheck(state, partyId);
        var clearIndex = 0;
        while (clearIndex < state.entityIds.length) {
            if (<uint>state.entityPartyIds[clearIndex] == partyId) {
                partyClearMember(state, clearIndex);
            }
            clearIndex = clearIndex + 1;
        }
        return;
    }
    if (wasLeader) {
        var nextLeaderIndex = partyFirstMemberIndex(state, partyId);
        if (nextLeaderIndex < 0) {
            throw "woc party leader replacement is invalid";
        }
        partySetLeader(state, partyId, <uint>state.entityIds[nextLeaderIndex]);
    }
    if (<bool>state.entityPartyRaids[partyFirstMemberIndex(state, partyId)]) {
        partyNormalizeRaidGroups(state, partyId);
    }
}

partyReadTargetId(payloadOffset: uint, payloadBytes: container.Array<uint>): uint {
    var targetId: uint = <uint>0;
    var multiplier: uint = <uint>1;
    var byteIndex: uint = <uint>0;
    while (byteIndex < <uint>8) {
        targetId = targetId +
            <uint>payloadBytes[<int>(payloadOffset + byteIndex)] * multiplier;
        multiplier = multiplier * <uint>256;
        byteIndex = byteIndex + <uint>1;
    }
    return targetId;
}

applyPartyInviteCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadBytes: container.Array<uint>
): void {
    var targetId = partyReadTargetId(payloadOffset, payloadBytes);
    var targetIndex = partyEntityIndexById(state, targetId);
    var actorId = <uint>state.entityIds[actorIndex];
    if (targetId == <uint>0 || targetId == actorId || targetIndex < 0 ||
        <uint>state.entityKinds[targetIndex] != <uint>1) {
        return;
    }
    var partyId = partyIdForIndex(state, actorIndex);
    if (partyId != <uint>0) {
        if (<uint>state.entityPartyLeaderIds[actorIndex] != actorId) {
            return;
        }
        var capacity = <bool>state.entityPartyRaids[actorIndex] ? 10 : 5;
        if (partyMemberCount(state, partyId) >= capacity) {
            return;
        }
    }
    if (partyIdForIndex(state, targetIndex) != <uint>0) {
        return;
    }
    var inviteFrom = <uint>state.entityPartyInviteFromIds[targetIndex];
    var inviteExpires = <uint>state.entityPartyInviteExpiresAtMicros[targetIndex];
    if (inviteFrom != <uint>0 && inviteExpires >= state.timeMicros) {
        return;
    }
    state.entityPartyInviteFromIds[targetIndex] = actorId;
    state.entityPartyInviteExpiresAtMicros[targetIndex] = state.timeMicros + <uint>30000000;
}

applyPartyAcceptCommand(state: WorldState, actorIndex: int): void {
    var inviteFrom = <uint>state.entityPartyInviteFromIds[actorIndex];
    var inviteExpires = <uint>state.entityPartyInviteExpiresAtMicros[actorIndex];
    if (inviteFrom == <uint>0 || inviteExpires < state.timeMicros) {
        return;
    }
    state.entityPartyInviteFromIds[actorIndex] = <uint>0;
    state.entityPartyInviteExpiresAtMicros[actorIndex] = <uint>0;
    if (partyIdForIndex(state, actorIndex) != <uint>0) {
        return;
    }
    var inviterIndex = partyEntityIndexById(state, inviteFrom);
    if (inviterIndex < 0 || <uint>state.entityKinds[inviterIndex] != <uint>1) {
        return;
    }
    var partyId = partyIdForIndex(state, inviterIndex);
    if (partyId == <uint>0) {
        partyId = state.nextPartyId;
        state.nextPartyId = state.nextPartyId + <uint>1;
        state.entityPartyIds[inviterIndex] = partyId;
        state.entityPartyLeaderIds[inviterIndex] = inviteFrom;
        state.entityPartyRaids[inviterIndex] = false;
        state.entityPartyRaidGroups[inviterIndex] = <uint>0;
        state.entityPartyMemberOrders[inviterIndex] = <uint>1;
    }
    var raid = <bool>state.entityPartyRaids[inviterIndex];
    var capacity = raid ? 10 : 5;
    if (partyMemberCount(state, partyId) >= capacity) {
        return;
    }
    var group: uint = <uint>0;
    if (raid) {
        group = partyRaidGroupCount(state, partyId, <uint>1) < 5 ? <uint>1 : <uint>2;
    }
    state.entityPartyIds[actorIndex] = partyId;
    state.entityPartyLeaderIds[actorIndex] = <uint>state.entityPartyLeaderIds[inviterIndex];
    state.entityPartyRaids[actorIndex] = raid;
    state.entityPartyRaidGroups[actorIndex] = group;
    state.entityPartyMemberOrders[actorIndex] = partyNextMemberOrder(state, partyId);
    state.entityPartyDungeonDifficultyHeroic[actorIndex] =
        <bool>state.entityPartyDungeonDifficultyHeroic[inviterIndex];
    state.entityPartyMasterLootEnabled[actorIndex] =
        <bool>state.entityPartyMasterLootEnabled[inviterIndex];
    state.entityPartyMasterLooterIds[actorIndex] =
        <uint>state.entityPartyMasterLooterIds[inviterIndex];
    state.entityPartyMasterLootThresholdCodes[actorIndex] =
        <uint>state.entityPartyMasterLootThresholdCodes[inviterIndex];
}

// This mirrors Sim.setDungeonDifficulty's mutation rules. The source emits an
// error for a non-leader; WOS has no retained error/event channel yet, so the
// reducer keeps the authoritative no-mutation result and sequence progression.
applyDungeonDifficultyCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadBytes: container.Array<uint>
): void {
    var requested = <uint>payloadBytes[<int>payloadOffset];
    if (!dungeonDifficulty.isDifficulty(requested)) {
        return;
    }
    var partyId = partyIdForIndex(state, actorIndex);
    var actorId = <uint>state.entityIds[actorIndex];
    if (partyId != <uint>0 && <uint>state.entityPartyLeaderIds[actorIndex] != actorId) {
        return;
    }
    var heroic = requested == <uint>1;
    state.entityDungeonDifficultyPersonalHeroic[actorIndex] = heroic;
    if (partyId != <uint>0) {
        partySetDungeonDifficulty(state, partyId, heroic);
    }
}

applyPartyDeclineCommand(state: WorldState, actorIndex: int): void {
    state.entityPartyInviteFromIds[actorIndex] = <uint>0;
    state.entityPartyInviteExpiresAtMicros[actorIndex] = <uint>0;
}

applyPartyLeaveCommand(state: WorldState, actorIndex: int): void {
    partyRemoveMember(state, actorIndex);
}

applyPartyKickCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadBytes: container.Array<uint>
): void {
    var partyId = partyIdForIndex(state, actorIndex);
    var actorId = <uint>state.entityIds[actorIndex];
    if (partyId == <uint>0 || <uint>state.entityPartyLeaderIds[actorIndex] != actorId) {
        return;
    }
    var targetId = partyReadTargetId(payloadOffset, payloadBytes);
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetId == actorId || targetIndex < 0 || partyIdForIndex(state, targetIndex) != partyId) {
        return;
    }
    partyRemoveMember(state, targetIndex);
}

applyPartyPromoteCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadBytes: container.Array<uint>
): void {
    var partyId = partyIdForIndex(state, actorIndex);
    var actorId = <uint>state.entityIds[actorIndex];
    if (partyId == <uint>0 || <uint>state.entityPartyLeaderIds[actorIndex] != actorId) {
        return;
    }
    var targetId = partyReadTargetId(payloadOffset, payloadBytes);
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetId == actorId || targetIndex < 0 || partyIdForIndex(state, targetIndex) != partyId) {
        return;
    }
    partySetLeader(state, partyId, targetId);
}

applyPartyRaidCommand(state: WorldState, actorIndex: int): void {
    var partyId = partyIdForIndex(state, actorIndex);
    var actorId = <uint>state.entityIds[actorIndex];
    if (partyId == <uint>0 || <uint>state.entityPartyLeaderIds[actorIndex] != actorId ||
        <bool>state.entityPartyRaids[actorIndex] || partyMemberCount(state, partyId) < 5) {
        return;
    }
    partySetRaid(state, partyId, true);
    partyNormalizeRaidGroups(state, partyId);
}

applyPartyUnraidCommand(state: WorldState, actorIndex: int): void {
    var partyId = partyIdForIndex(state, actorIndex);
    var actorId = <uint>state.entityIds[actorIndex];
    if (partyId == <uint>0 || <uint>state.entityPartyLeaderIds[actorIndex] != actorId ||
        !<bool>state.entityPartyRaids[actorIndex] || partyMemberCount(state, partyId) > 5) {
        return;
    }
    partySetRaid(state, partyId, false);
}

applyPartyMoveRaidCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadBytes: container.Array<uint>
): void {
    var partyId = partyIdForIndex(state, actorIndex);
    var actorId = <uint>state.entityIds[actorIndex];
    if (partyId == <uint>0 || !<bool>state.entityPartyRaids[actorIndex] ||
        <uint>state.entityPartyLeaderIds[actorIndex] != actorId) {
        return;
    }
    var targetId = partyReadTargetId(payloadOffset, payloadBytes);
    var targetIndex = partyEntityIndexById(state, targetId);
    var group = <uint>payloadBytes[<int>(payloadOffset + <uint>8)];
    if (targetIndex < 0 || partyIdForIndex(state, targetIndex) != partyId ||
        (group != <uint>1 && group != <uint>2) ||
        <uint>state.entityPartyRaidGroups[targetIndex] == group) {
        return;
    }
    if (partyRaidGroupCount(state, partyId, group) >= 5) {
        return;
    }
    state.entityPartyRaidGroups[targetIndex] = group;
}

encodeStateVersion(state: WorldState, schemaVersion: uint): container.Array<uint> {
    if (schemaVersion != <uint>80 && schemaVersion != <uint>81 &&
        schemaVersion != <uint>82 && schemaVersion != <uint>83 &&
        schemaVersion != <uint>84 && schemaVersion != <uint>85 &&
        schemaVersion != <uint>86 && schemaVersion != <uint>87 &&
        schemaVersion != <uint>88 && schemaVersion != <uint>89 &&
        schemaVersion != <uint>90 && schemaVersion != <uint>91 &&
        schemaVersion != <uint>92 && schemaVersion != <uint>93 &&
        schemaVersion != <uint>94 && schemaVersion != <uint>95 &&
        schemaVersion != <uint>96 && schemaVersion != <uint>97 &&
        schemaVersion != <uint>98 && schemaVersion != <uint>99 &&
        schemaVersion != <uint>100 && schemaVersion != <uint>101 &&
        schemaVersion != <uint>102 && schemaVersion != <uint>103 &&
        schemaVersion != <uint>104 && schemaVersion != <uint>105 &&
        schemaVersion != <uint>106 && schemaVersion != <uint>107 &&
        schemaVersion != <uint>108 && schemaVersion != <uint>109 &&
        schemaVersion != <uint>110 && schemaVersion != <uint>111 &&
        schemaVersion != <uint>112 && schemaVersion != <uint>113 &&
        schemaVersion != <uint>114 && schemaVersion != <uint>115 &&
        schemaVersion != <uint>116 && schemaVersion != <uint>117 &&
        schemaVersion != <uint>118) {
        throw "woc world-state test writer schema is unsupported";
    }
    if (schemaVersion < <uint>107 &&
        !offlineProjectileTalentSnapshotsAreLegacyCompatible(state)) {
        throw "woc projectile talent snapshot cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>108 && !offlineDotStateIsSchema107Compatible(state)) {
        throw "woc dot talent state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>109 && !imbueStateIsSchema108Compatible(state)) {
        throw "woc imbue talent state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>110 && !offlineAbsorbStateIsSchema109Compatible(state)) {
        throw "woc absorb talent state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>111 && !tigersFuryTalentStateIsSchema110Compatible(state)) {
        throw "woc Tiger's Fury talent state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>112 && !feralInstinctStateIsSchema111Compatible(state)) {
        throw "woc Feral Instinct state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>114 && state.offlineAbilityChargeEntityIds.length != 0) {
        throw "woc ability charge state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>115 && state.offlineHunterTrapSourceIds.length != 0) {
        throw "woc Hunter trap state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>116 && state.offlineLeanQuiverEntityIds.length != 0) {
        throw "woc Lean Quiver proc state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>117 && state.offlineRedlineDrawEntityIds.length != 0) {
        throw "woc Redline Draw proc state cannot be encoded by a historical schema";
    }
    if (schemaVersion < <uint>118 && state.offlineDeathlessWillEntityIds.length != 0) {
        throw "woc Deathless Will proc state cannot be encoded by a historical schema";
    }
    if (!resourcePrecisionStateCanEncodeVersion(state, schemaVersion)) {
        throw "woc fractional resource state cannot be encoded by a historical schema";
    }
    var writer = new StateWriter();
    writer.byte(<uint>87, 1); // W
    writer.byte(<uint>79, 1); // O
    writer.byte(<uint>83, 1); // S
    writer.byte(<uint>50, 1); // 2
    writer.u16(schemaVersion, 1, 1);
    writer.u64(state.tick, 1, 1, 2, 4);
    writer.u64(state.timeMicros, 1, 1, 2, 4);
    writer.u64(state.nextEntityId, 1, 1, 2, 4);
    writer.u64(state.generation, 1, 1, 2, 4);
    writer.u32(state.rngState, 1, 1, 2);
    writer.u32(state.rngDraws, 1, 1, 2);
    writer.u32(state.rngDigest, 1, 1, 2);
    writer.u32(state.worldSeed, 1, 1, 2);
    writer.byte(state.offlineSessionActive ? <uint>1 : <uint>0, 1);
    if (state.offlineSessionActive) {
        var offlineName = state.offlinePlayerName;
        if (state.offlinePlayerClass > <uint>8 ||
            !offlineSkinVariantIsValid(state.offlinePlayerClass, state.offlinePlayerSkinVariant) ||
            !offlinePlayerNameIsValid(offlineName)) {
            throw "woc offline player bootstrap state is invalid";
        }
        writer.byte(state.offlinePlayerClass, 1);
        writer.u16(state.offlinePlayerSkinVariant, 1, 1);
        writer.u16(<uint>offlineName.length, 1, 1);
        for (var byte in offlineName) {
            writer.byte(<uint>byte, 1);
        }
    }
    if (!offlineQuestStateIsValid(state) || !offlineQuestInventoryStateIsValid(state)) {
        throw "woc offline quest ledger is invalid";
    }
    writer.byte(state.offlineQuestBoarsState, 1);
    writer.byte(state.offlineQuestWolvesState, 1);
    writer.u16(state.offlineQuestBoarsObjectiveCount, 1, 1);
    writer.u16(state.offlineQuestWolvesObjectiveCount, 1, 1);
    writer.u16(state.offlineQuestBoarHideCount, 1, 1);
    writer.u32(state.offlineQuestCopper, 1, 1, 2);
    writer.u32(state.offlineQuestExperience, 1, 1, 2);
    writer.u64(state.offlineQuestLifetimeExperience, 1, 1, 2, 4);
    if (!offlineGatheringStateIsValid(state)) {
        throw "woc offline gathering state is invalid";
    }
    var gatheringProfessionIndex = 0;
    while (gatheringProfessionIndex < harvestNodeState.professionCount()) {
        writer.u32(
            <uint>state.offlineGatheringProficiencies[gatheringProfessionIndex], 1, 1, 2
        );
        gatheringProfessionIndex = gatheringProfessionIndex + 1;
    }
    gatheringProfessionIndex = 0;
    while (gatheringProfessionIndex < harvestNodeState.professionCount()) {
        writer.u32(
            <uint>state.offlinePendingGatheringGains[gatheringProfessionIndex], 1, 1, 2
        );
        gatheringProfessionIndex = gatheringProfessionIndex + 1;
    }
    var gatheringNodeIndex = 0;
    while (gatheringNodeIndex < harvestNodeState.nodeCount()) {
        writer.u64(
            <uint>state.offlineGatherNodeReadyAtMicros[gatheringNodeIndex], 1, 1, 2, 4
        );
        gatheringNodeIndex = gatheringNodeIndex + 1;
    }
    writer.u16(state.offlineGatherVisitedMask, 1, 1);
    writer.u64(state.offlineGatherResultSequence, 1, 1, 2, 4);
    writer.byte(state.offlineGatherResultNodeCode, 1);
    writer.byte(state.offlineGatherResultProfessionCode, 1);
    writer.byte(state.offlineGatherResultItemCode, 1);
    writer.byte(state.offlineGatherResultRarityCode, 1);
    if (!offlineDeedTitleStateIsValid(state)) {
        throw "woc offline deed title state is invalid";
    }
    var deedIndex = 0;
    while (deedIndex < deedTitleState.deedCount()) {
        writer.byte(<bool>state.offlineDeedsEarned[deedIndex] ? <uint>1 : <uint>0, 1);
        deedIndex = deedIndex + 1;
    }
    writer.u16(state.offlineActiveTitleDeedCode, 1, 1);
    if (!offlineTownFocusStateIsValid(state)) {
        throw "woc offline town-focus state is invalid";
    }
    writer.u16(<uint>state.offlineTownFocusPoints.length, 1, 1);
    var townFocusIndex = 0;
    while (townFocusIndex < state.offlineTownFocusPoints.length) {
        var componentStart = <uint>state.offlineTownFocusComponentOffsets[townFocusIndex];
        var componentEnd = <uint>state.offlineTownFocusComponentOffsets[townFocusIndex + 1];
        writer.u16(componentEnd - componentStart, 1, 1);
        var componentCursor = componentStart;
        while (componentCursor < componentEnd) {
            writer.byte(
                <uint>state.offlineTownFocusComponentBytes[<int>componentCursor], 1
            );
            componentCursor = componentCursor + <uint>1;
        }
        writer.byte(<uint><int>state.offlineTownFocusPoints[townFocusIndex], 1);
        townFocusIndex = townFocusIndex + 1;
    }
    if (!offlineCraftStateIsValid(state)) {
        throw "woc offline craft state is invalid";
    }
    writer.u32(state.offlineCraftAlchemySkill, 1, 1, 2);
    writer.u64(state.offlineCraftThrottleWindowStartMicros, 1, 1, 2, 4);
    writer.byte(state.offlineCraftThrottleCount, 1);
    writer.u64(state.offlineCraftsPerformed, 1, 1, 2, 4);
    writer.u64(state.offlineCraftResultSequence, 1, 1, 2, 4);
    writer.u16(<uint>state.offlineCraftResultRecipeBytes.length, 1, 1);
    for (var recipeByte in state.offlineCraftResultRecipeBytes) {
        writer.byte(<uint>recipeByte, 1);
    }
    writer.byte(state.offlineCraftResultReasonCode, 1);
    writer.byte(state.offlineCraftResultItemCode, 1);
    writer.u32(state.offlineCraftResultCount, 1, 1, 2);
    writer.byte(state.offlineCraftResultQualityCode, 1);
    writer.byte(state.offlineCraftResultMasterwork ? <uint>1 : <uint>0, 1);
    if (!offlineTalentLoadoutStateIsValid(state)) {
        throw "woc offline talent loadout state is invalid";
    }
    var loadoutCount = state.offlineTalentLoadoutSpecCodes.length;
    writer.u16(<uint>loadoutCount, 1, 1);
    writer.u16(
        state.offlineTalentActiveLoadoutIndex < 0 ? <uint>65535 :
            <uint>state.offlineTalentActiveLoadoutIndex,
        1, 1
    );
    var loadoutIndex = 0;
    while (loadoutIndex < loadoutCount) {
        var loadoutNameStart = <uint>state.offlineTalentLoadoutNameOffsets[loadoutIndex];
        var loadoutNameEnd = <uint>state.offlineTalentLoadoutNameOffsets[loadoutIndex + 1];
        writer.u16(loadoutNameEnd - loadoutNameStart, 1, 1);
        var loadoutNameIndex = <int>loadoutNameStart;
        while (loadoutNameIndex < <int>loadoutNameEnd) {
            writer.byte(<uint>state.offlineTalentLoadoutNameBytes[loadoutNameIndex], 1);
            loadoutNameIndex = loadoutNameIndex + 1;
        }
        writer.u16(<uint>state.offlineTalentLoadoutSpecCodes[loadoutIndex], 1, 1);
        var loadoutRowIndex = 0;
        while (loadoutRowIndex < 6) {
            writer.u16(
                offlineTalentLoadoutRowCodeAt(state, loadoutIndex, loadoutRowIndex), 1, 1
            );
            loadoutRowIndex = loadoutRowIndex + 1;
        }
        var loadoutBarIndex = 0;
        while (loadoutBarIndex < talentLoadoutContract.barSlots(true)) {
            writer.u16(<uint>state.offlineTalentLoadoutActionBarAbilityCodes[
                loadoutIndex * talentLoadoutContract.barSlots(true) + loadoutBarIndex
            ], 1, 1);
            loadoutBarIndex = loadoutBarIndex + 1;
        }
        loadoutIndex = loadoutIndex + 1;
    }
    if (state.nextPartyId == <uint>0) {
        throw "woc next party id is invalid";
    }
    writer.u64(state.nextPartyId, 1, 1, 2, 4);
    if (state.nextArenaQueueUnitOrder == <uint>0) {
        throw "woc next arena queue unit order is invalid";
    }
    writer.u64(state.nextArenaQueueUnitOrder, 1, 1, 2, 4);
