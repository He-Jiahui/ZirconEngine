// WOS172a retains a complete Glacial Front release cycle through the same
// candidate command path as a player input. Dragon's Breath is intentionally
// absent until its Hot Streak and diminishing-control state are durable.
pub glacialFrontCommandStateTest(): int {
    var abilityCode = glacialFrontAbilityCode();
    var frostSpec = talentSelectionCatalog.specCode("mage", "frost");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (abilityCode == <uint>0 || frostSpec == <uint>0 || forestWolf == <uint>0) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 200, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 5.0, 200, 8.0);
    state.entityTalentSpecCodes[0] = frostSpec;
    state.entityResources[0] = 160;
    state.entityMaxResources[0] = 160;
    state.entitySpellPower[0] = 0;
    state.entityCritChance[0] = 0.0;
    state.entityFacing[0] = 0.0;
    state.entityKnownAbilityCodes.add(abilityCode);
    state.entityKnownAbilityOffsets[1] = <uint>1;

    startOfflineGlacialFrontCast(state, 0);
    if (<uint>state.entityCastingAbility[0] != abilityCode ||
        <float>state.entityCastRemaining[0] != 2.4 ||
        <float>state.entityResources[0] != 160) {
        return -2;
    }

    state.entityCastRemaining[0] = 1.8;
    var glacialBytes = new container.Array<uint>();
    glacialBytes.add(<uint>103); glacialBytes.add(<uint>108); glacialBytes.add(<uint>97);
    glacialBytes.add(<uint>99); glacialBytes.add(<uint>105); glacialBytes.add(<uint>97);
    glacialBytes.add(<uint>108); glacialBytes.add(<uint>95); glacialBytes.add(<uint>102);
    glacialBytes.add(<uint>114); glacialBytes.add(<uint>111); glacialBytes.add(<uint>110);
    glacialBytes.add(<uint>116);
    var release = new CommandBatch();
    appendReleaseEmpoweredCommandForTest(
        release, playerId, <uint>1, <uint>1, glacialBytes
    );
    state.applyCommands(release, 1);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <int>state.entityLastResolvedEmpowerLevel[0] != 2 ||
        <float>state.entityResources[0] != 80 ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>12000000 ||
        <int>state.entityHp[1] >= 200 ||
        state.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>state.entityMotionAuraAbilityCodes[0] != abilityCode ||
        <uint>state.entityMotionAuraKindCodes[0] !=
            ccContract.motionAuraKindCode("slow") ||
        <float>state.entityMotionAuraValues[0] != 0.5 ||
        <uint>state.entityMotionAuraSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_FROST ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -3;
    }

    state.timeMicros = <uint>12000000;
    state.entityCastGcdRemaining[0] = 0.0;
    startOfflineGlacialFrontCast(state, 0);
    if (<uint>state.entityCastingAbility[0] != abilityCode) { return -4; }
    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <int>state.entityLastResolvedEmpowerLevel[0] != 4 ||
        <float>state.entityResources[0] != 0 ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>24000000 ||
        state.entityMotionAuraOffsets[2] != <uint>2 ||
        <uint>state.entityMotionAuraKindCodes[0] !=
            ccContract.motionAuraKindCode("slow") ||
        <uint>state.entityMotionAuraKindCodes[1] !=
            ccContract.motionAuraKindCode("root") ||
        <uint>state.entityMotionAuraSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_FROST ||
        <uint>state.entityMotionAuraSchoolCodes[1] != OFFLINE_PROJECTILE_SCHOOL_FROST) {
        return -5;
    }

    state.timeMicros = <uint>24000000;
    state.entityCastGcdRemaining[0] = 0.0;
    state.entityResources[0] = 80;
    startOfflineGlacialFrontCast(state, 0);
    var wrongBytes = new container.Array<uint>();
    wrongBytes.add(<uint>102); wrongBytes.add(<uint>114); wrongBytes.add(<uint>111);
    wrongBytes.add(<uint>115); wrongBytes.add(<uint>116); wrongBytes.add(<uint>98);
    wrongBytes.add(<uint>111); wrongBytes.add(<uint>108); wrongBytes.add(<uint>116);
    var wrongRelease = new CommandBatch();
    appendReleaseEmpoweredCommandForTest(
        wrongRelease, playerId, <uint>1, <uint>2, wrongBytes
    );
    state.applyCommands(wrongRelease, 1);
    if (<uint>state.entityCastingAbility[0] != abilityCode ||
        <float>state.entityResources[0] != 80 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -6;
    }

    applyOfflineMotionAura(
        state, 0, abilityCode, targetId, ccContract.motionAuraKindCode("stun"), 1.0
    );
    var interruptedRelease = new CommandBatch();
    appendReleaseEmpoweredCommandForTest(
        interruptedRelease, playerId, <uint>1, <uint>3, glacialBytes
    );
    state.applyCommands(interruptedRelease, 1);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <float>state.entityResources[0] != 80 ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>24000000 ||
        <uint>state.entityLastCommandSequence[0] != <uint>3) {
        return -7;
    }
    return targetId != <uint>0 ? 1 : -8;
}

// WOS173 stores the shared Hot Streak pair lifetime once and keeps Heating Up
// separate, so snapshot restore and the fixed aura cadence cannot strand either
// Fire proc across a candidate transaction.
pub fireMageProcPersistenceStateTest(): int {
    var state = new WorldState();
    var playerId = state.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    if (playerId == <uint>0 || !fireMageProcStateIsValid(state)) { return -1; }
    state.entityHeatingUpRemaining[0] = 10.0;
    state.entityHotStreakRemaining[0] = 12.0;
    state.entityCombustionRemaining[0] = 10.0;
    var restored = decodeState(encodeState(state));
    if (!fireMageProcStateIsValid(restored) ||
        !floatMatches(<float>restored.entityHeatingUpRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entityHotStreakRemaining[0], 12.0) ||
        !floatMatches(<float>restored.entityCombustionRemaining[0], 10.0)) {
        return -2;
    }
    restored.entityHeatingUpRemaining[0] = 0.05;
    restored.entityHotStreakRemaining[0] = 0.05;
    restored.entityCombustionRemaining[0] = 0.05;
    ageOfflineFireMageProcs(restored);
    if (<float>restored.entityHeatingUpRemaining[0] != 0.0 ||
        <float>restored.entityHotStreakRemaining[0] != 0.0 ||
        <float>restored.entityCombustionRemaining[0] != 0.0) {
        return -3;
    }
    var migrated = decodeState(encodeStateVersion(state, <uint>85));
    if (!fireMageProcStateIsValid(migrated) ||
        <float>migrated.entityCombustionRemaining[0] != 0.0) {
        return -4;
    }
    return 1;
}

// WOS174 makes all next-cast state a sorted, scope-aware partition. The
// test retains Hot Streak's paired spenders without making its producer the
// only possible source of a free, instant, or cheap next cast.
pub nextCastModifierPersistenceStateTest(): int {
    var state = new WorldState();
    var playerId = state.spawnPlayer(<uint>2, 17, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var pyroblastCode = <uint>knownAbilityCatalog.abilityCode("pyroblast");
    var flamestrikeCode = <uint>knownAbilityCatalog.abilityCode("flamestrike");
    var frostboltCode = <uint>knownAbilityCatalog.abilityCode("frostbolt");
    if (playerId == <uint>0 || pyroblastCode == <uint>0 ||
        flamestrikeCode == <uint>0 || frostboltCode == <uint>0) {
        return -1;
    }
    var spenders = new container.Array<uint>();
    if (pyroblastCode < flamestrikeCode) {
        spenders.add(pyroblastCode);
        spenders.add(flamestrikeCode);
    } else {
        spenders.add(flamestrikeCode);
        spenders.add(pyroblastCode);
    }
    var globalScope = new container.Array<uint>();
    setNextCastModifier(
        state, 0, <uint>101, nextCastModifiers.freeCostKind(), 12.0, 0.0,
        spenders
    );
    setNextCastModifier(
        state, 0, <uint>102, nextCastModifiers.instantKind(), 12.0, 0.0,
        spenders
    );
    setNextCastModifier(
        state, 0, <uint>103, nextCastModifiers.cheapCostKind(), 12.0, 0.5,
        globalScope
    );
    if (!nextCastModifierStateIsValid(state) ||
        !nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.freeCostKind(), pyroblastCode
        ) || !nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.freeCostKind(), flamestrikeCode
        ) || nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.freeCostKind(), frostboltCode
        ) || nextCastModifierValueForAbility(
            state, 0, nextCastModifiers.cheapCostKind(), frostboltCode
        ) != 0.5) {
        return -2;
    }
    if (!consumeNextCastModifierForAbility(
        state, 0, nextCastModifiers.freeCostKind(), pyroblastCode
    ) || nextCastModifierActiveForAbility(
        state, 0, nextCastModifiers.freeCostKind(), flamestrikeCode
    ) || !nextCastModifierActiveForAbility(
        state, 0, nextCastModifiers.instantKind(), flamestrikeCode
    )) {
        return -3;
    }
    var restored = decodeState(encodeState(state));
    if (!nextCastModifierStateIsValid(restored) ||
        !nextCastModifierActiveForAbility(
            restored, 0, nextCastModifiers.instantKind(), pyroblastCode
        ) || !floatMatches(nextCastModifierValueForAbility(
            restored, 0, nextCastModifiers.cheapCostKind(), frostboltCode
        ), 0.5)) {
        return -4;
    }
    var instantIndex = nextCastModifierIndexForAbility(
        restored, 0, nextCastModifiers.instantKind(), pyroblastCode
    );
    if (instantIndex < 0) return -5;
    restored.nextCastModifierRemaining[instantIndex] = 0.05;
    ageOfflineNextCastModifiers(restored);
    if (nextCastModifierActiveForAbility(
        restored, 0, nextCastModifiers.instantKind(), pyroblastCode
    ) || !floatMatches(nextCastModifierValueForAbility(
        restored, 0, nextCastModifiers.cheapCostKind(), frostboltCode
    ), 0.5)) {
        return -6;
    }
    var legacy = decodeState(encodeStateVersion(restored, <uint>84));
    return nextCastModifierStateIsValid(legacy) &&
        legacy.entityNextCastModifierOffsets.length == legacy.entityIds.length + 1 &&
        legacy.nextCastModifierIdentityCodes.length == 0 ? 1 : -7;
}

// WOS176 exercises the producer with the same source transaction boundaries:
// Combustion is off-GCD, a pair of Fire crits produces the two scoped rows,
// then an instant free Pyroblast consumes both only after admission succeeds.
pub fireMageHotStreakRuntimeStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>2, 12, 0.0, 1.5, 0.0, 500, 7.0, 1);
    var targetId = state.spawnMob(<uint>1, 1, 0.0, 1.5, 5.0, 1000, 5.0);
    var fireSpec = talentSelectionCatalog.specCode("mage", "fire");
    var fireball = fireballAbilityCode();
    var pyroblast = pyroblastAbilityCode();
    var flamestrike = <uint>knownAbilityCatalog.abilityCode("flamestrike");
    var combustion = combustionAbilityCode();
    if (playerId == <uint>0 || targetId == <uint>0 || fireSpec == <uint>0 ||
        fireball == <uint>0 || pyroblast == <uint>0 || flamestrike == <uint>0 ||
        combustion == <uint>0) {
        return -1;
    }
    state.entityTalentSpecCodes[0] = fireSpec;
    state.entityResources[0] = 225;
    state.entityMaxResources[0] = 225;
    state.entitySpellPower[0] = 0;
    state.entityCritChance[0] = 0.0;
    state.entityFacing[0] = 0.0;
    var known = new container.Array<uint>();
    known.add(fireball);
    known.add(pyroblast);
    known.add(flamestrike);
    known.add(combustion);
    var knownIndex = 0;
    while (knownIndex < known.length) {
        var insertIndex = knownIndex;
        while (insertIndex > 0 && <uint>known[insertIndex - 1] > <uint>known[insertIndex]) {
            var prior = <uint>known[insertIndex - 1];
            known[insertIndex - 1] = <uint>known[insertIndex];
            known[insertIndex] = prior;
            insertIndex = insertIndex - 1;
        }
        knownIndex = knownIndex + 1;
    }
    knownIndex = 0;
    while (knownIndex < known.length) {
        state.entityKnownAbilityCodes.add(<uint>known[knownIndex]);
        knownIndex = knownIndex + 1;
    }
    state.entityKnownAbilityOffsets[1] = <uint>known.length;

    startOfflineCombustionCast(state, 0);
    if (<float>state.entityResources[0] != 125 ||
        <float>state.entityCombustionRemaining[0] != 10.0 ||
        abilityCooldownExpiresAt(state, 0, combustion) != <uint>120000000 ||
        <float>state.entityCastGcdRemaining[0] != 0.0) {
        return -2;
    }
    applyOfflineFireMageSpellHit(state, 0, fireball, true);
    if (<float>state.entityHeatingUpRemaining[0] != 10.0 ||
        abilityCooldownExpiresAt(state, 0, combustion) != <uint>120000000) {
        return -3;
    }
    applyOfflineFireMageSpellHit(state, 0, fireball, true);
    if (<float>state.entityHeatingUpRemaining[0] != 0.0 ||
        <float>state.entityHotStreakRemaining[0] != 12.0 ||
        !nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.freeCostKind(), pyroblast
        ) || !nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.instantKind(), pyroblast
        )) {
        return -4;
    }
    startOfflinePyroblastCast(state, 0, targetId);
    if (<float>state.entityResources[0] != 125 ||
        <uint>state.entityCastingAbility[0] != <uint>0 ||
        state.offlineProjectileAbilityCodes.length != 1 ||
        <uint>state.offlineProjectileAbilityCodes[0] != pyroblast ||
        nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.freeCostKind(), pyroblast
        ) || nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.instantKind(), pyroblast
        )) {
        return -5;
    }
    state.entityCombustionRemaining[0] = 0.0;
    applyOfflineFireMageSpellHit(state, 0, fireball, true);
    if (<float>state.entityHeatingUpRemaining[0] != 10.0 ||
        abilityCooldownExpiresAt(state, 0, combustion) != <uint>119000000) {
        return -6;
    }
    var restored = decodeState(encodeState(state));
    return fireMageProcStateIsValid(restored) &&
        nextCastModifierStateIsValid(restored) &&
        <float>restored.entityCombustionRemaining[0] == 0.0 &&
        restored.offlineProjectileAbilityCodes.length == 1 ? 1 : -7;
}

pub flamestrikePositionRuntimeStateTest(): int {
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>2, 12, 0.0, 1.5, 0.0, 160, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 5.0, 1000, 5.0);
    var fireSpec = talentSelectionCatalog.specCode("mage", "fire");
    var flamestrike = flamestrikeAbilityCode();
    var pyroblast = pyroblastAbilityCode();
    if (forestWolf == <uint>0 || playerId == <uint>0 || targetId == <uint>0 || fireSpec == <uint>0 ||
        flamestrike == <uint>0 || pyroblast == <uint>0) {
        return -1;
    }
    state.entityTalentSpecCodes[0] = fireSpec;
    state.entityResources[0] = 80;
    state.entityMaxResources[0] = 160;
    state.entityCritChance[0] = 0.0;
    state.entityCritDamageSpellBonus[0] = 0.1;
    state.entitySpellDamageMultipliers[0] = 1.2;
    state.entityCombustionRemaining[0] = 10.0;
    if (pyroblast < flamestrike) {
        state.entityKnownAbilityCodes.add(pyroblast);
        state.entityKnownAbilityCodes.add(flamestrike);
    } else {
        state.entityKnownAbilityCodes.add(flamestrike);
        state.entityKnownAbilityCodes.add(pyroblast);
    }
    state.entityKnownAbilityOffsets[1] = <uint>2;
    var restored = decodeState(encodeState(state));
    if (!floatMatches(<float>restored.entityCritDamageSpellBonus[0], 0.1) ||
        !floatMatches(<float>restored.entitySpellDamageMultipliers[0], 1.2)) {
        return -2;
    }
    var spenders = fireMageHotStreakSpenderCodes();
    setNextCastModifier(
        state, 0, fireMageContract.hotStreakFreeModifierIdentityCode(),
        nextCastModifiers.freeCostKind(), 12.0, 0.0, spenders
    );
    setNextCastModifier(
        state, 0, fireMageContract.hotStreakInstantModifierIdentityCode(),
        nextCastModifiers.instantKind(), 12.0, 0.0, spenders
    );
    var drawsBefore = state.rngDraws;
    startOfflineFlamestrikeCast(state, 0, 0.0, 5.0);
    if (<float>state.entityResources[0] != 80 ||
        <uint>state.entityCastingAbility[0] != <uint>0 ||
        abilityCooldownExpiresAt(state, 0, flamestrike) != <uint>12000000 ||
        <uint>state.rngDraws != drawsBefore + <uint>2 ||
        <int>state.entityHp[1] >= 1000 ||
        !floatMatches(<float>state.entityHeatingUpRemaining[0], 10.0) ||
        nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.freeCostKind(), flamestrike
        ) || nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.instantKind(), flamestrike
        )) {
        return -2;
    }
    state.timeMicros = <uint>12000000;
    state.entityCastGcdRemaining[0] = 0.0;
    state.entityResources[0] = 0;
    setNextCastModifier(
        state, 0, <uint>3, nextCastModifiers.freeCostKind(), 12.0, 0.0, spenders
    );
    startOfflineFlamestrikeCast(state, 0, 0.0, 5.0);
    if (<uint>state.entityCastingAbility[0] != flamestrike ||
        <float>state.entityResources[0] != 0 ||
        !<bool>state.entityCastAimPresent[0]) {
        return -3;
    }
    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<uint>state.entityCastingAbility[0] != <uint>0 ||
        <float>state.entityResources[0] != 0 ||
        <bool>state.entityCastAimPresent[0] ||
        abilityCooldownExpiresAt(state, 0, flamestrike) != <uint>24000000 ||
        nextCastModifierActiveForAbility(
            state, 0, nextCastModifiers.freeCostKind(), flamestrike
        )) {
        return -4;
    }
    return nextCastModifierStateIsValid(state) && fireMageProcStateIsValid(state) ? 1 : -5;
}

pub dragonsBreathRuntimeStateTest(): int {
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var state = new WorldState();
    state.offlineSessionActive = true;
