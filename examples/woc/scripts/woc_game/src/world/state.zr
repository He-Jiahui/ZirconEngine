    var spell = new timedSpell.TimedSpellSpec();
    spell.minimum = <float>state.offlineProjectileMinimums[projectileIndex];
    spell.maximum = <float>state.offlineProjectileMaximums[projectileIndex];
    spell.spellPower = <float>state.entitySpellPower[casterIndex];
    spell.school = "arcane";
    spell.castTime = <float>state.offlineProjectileCastTimes[projectileIndex];
    spell.critChance = <float>state.entityCritChance[casterIndex];
    timedSpell.resolveTimedSpellHit(resolution, spell);

    var damage = resolution.damage;
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    if (damage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage); }
    if (hp > 0) {
        var level = <int>state.entityLevels[casterIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[casterIndex]) +
                <float>damage * m4AbilityCatalog.metric(abilityIndex, level, "threatMult") +
                m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
            1
        );
        var duration = m4AbilityEffects.metric(abilityIndex, rank, 1, "duration");
        var interval = m4AbilityEffects.metric(abilityIndex, rank, 1, "interval");
        var dotDamage = <int>(m4AbilityEffects.metric(
            abilityIndex, rank, 1, "total"
        ) / (duration / interval) + 0.5);
        if (dotDamage < 1) { dotDamage = 1; }
        applyOfflineMoonfireDot(
            state,
            <uint>state.entityIds[targetIndex],
            <uint>state.entityIds[casterIndex],
            abilityCode,
            dotDamage,
            duration,
            interval
        );
    } else {
        settleOfflineEastbrookLethal(state, targetIndex, casterIndex);
    }
}

// The source advances mob auras after mob movement. Persisted rows age first,
// apply every due periodic hit without RNG, then disappear after their final
// source tick when the remaining duration reaches zero.
stepOfflineEastbrookDots(state: WorldState): void {
    var dotIndex = 0;
    while (dotIndex < state.offlineDotTargetIds.length) {
        var targetIndex = partyEntityIndexById(
            state, <uint>state.offlineDotTargetIds[dotIndex]
        );
        if (targetIndex < 0 || <bool>state.entityDead[targetIndex] ||
            !isOfflineEastbrookLifecycleMob(state, targetIndex)) {
            removeOfflineDotAt(state, dotIndex);
            continue;
        }
        var remaining = <float>state.offlineDotRemaining[dotIndex] -
            projectileTravel.projectileTickSeconds();
        var timer = <float>state.offlineDotTickTimers[dotIndex] -
            projectileTravel.projectileTickSeconds();
        if (timer <= OFFLINE_PERIODIC_TICK_EPS) {
            timer = timer + <float>state.offlineDotTickIntervals[dotIndex];
            var damage = <int>state.offlineDotDamages[dotIndex];
            var sourceIndex = partyEntityIndexById(
                state, <uint>state.offlineDotSourceIds[dotIndex]
            );
            var abilityCode = <uint>state.offlineDotAbilityCodes[dotIndex];
            var hp = <int>state.entityHp[targetIndex] - damage;
            state.entityHp[targetIndex] = hp > 0 ? hp : 0;
            if (damage > 0) { clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage); }
            if (sourceIndex >= 0 && <uint>state.entityKinds[sourceIndex] == <uint>1) {
                enterOfflineSpellProjectileCombat(state, sourceIndex, targetIndex);
                if (hp > 0) {
                    var abilityIndex = abilityCode == fireballAbilityCode() ?
                        m4AbilityCatalog.indexOf("fireball") :
                        abilityCode == rakeAbilityCode() ?
                            m4AbilityCatalog.indexOf("rake") :
                        abilityCode == flameShockAbilityCode() ?
                            m4AbilityCatalog.indexOf("flame_shock") :
                        abilityCode == moonfireAbilityCode() ?
                            m4AbilityCatalog.indexOf("moonfire") :
                        abilityCode == entanglingRootsAbilityCode() ?
                            m4AbilityCatalog.indexOf("entangling_roots") :
                            pureDotAbilityIndex(abilityCode);
                    var level = <int>state.entityLevels[sourceIndex];
                    if (abilityIndex >= 0) {
                        state.setThreat(
                            <uint>state.entityIds[targetIndex],
                            <uint>state.entityIds[sourceIndex],
                            stateThreatValue(
                                state, targetIndex, <uint>state.entityIds[sourceIndex]
                            ) + <float>damage * m4AbilityCatalog.metric(
                                abilityIndex, level, "threatMult"
                            ) + m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
                            1
                        );
                    }
                } else {
                    settleOfflineEastbrookLethal(state, targetIndex, sourceIndex);
                }
                if (abilityCode == siphonLifeAbilityCode() &&
                    !<bool>state.entityDead[sourceIndex]) {
                    var effects = %import("generated/m4_ability_effects");
                    var siphonIndex = m4AbilityCatalog.indexOf("siphon_life");
                    var siphonRank = <int><uint>state.offlineDotRanks[dotIndex];
                    var heal = siphonIndex >= 0 ? <int>(<float>damage *
                        effects.metric(siphonIndex, siphonRank, 0, "leechPct") + 0.5) : 0;
                    var missing = <int>state.entityMaxHp[sourceIndex] -
                        <int>state.entityHp[sourceIndex];
                    if (heal > missing) { heal = missing; }
                    if (heal > 0) {
                        state.entityHp[sourceIndex] = <int>state.entityHp[sourceIndex] + heal;
                        applyOfflineDrainLifeHealingThreat(state, sourceIndex, heal);
                    }
                }
            }
        }
        if (remaining <= OFFLINE_PERIODIC_TICK_EPS || <bool>state.entityDead[targetIndex]) {
            removeOfflineDotAt(state, dotIndex);
        } else {
            state.offlineDotRemaining[dotIndex] = remaining;
            state.offlineDotTickTimers[dotIndex] = timer;
            dotIndex = dotIndex + 1;
        }
    }
}

landOfflineRangedProjectile(
    state: WorldState,
    projectileIndex: int,
    sourceIndex: int,
    targetIndex: int
): void {
    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, sourceIndex, targetIndex, actor);
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    actor.pendingWand.add(<bool>state.offlineProjectileWands[projectileIndex]);
    actor.pendingTargetIds.add(<uint>state.offlineProjectileTargetIds[projectileIndex]);
    actor.pendingMinimum.add(<float>state.offlineProjectileMinimums[projectileIndex]);
    actor.pendingMaximum.add(<float>state.offlineProjectileMaximums[projectileIndex]);
    actor.pendingSpeed.add(<float>state.offlineProjectileSpeeds[projectileIndex]);
    actor.pendingSchool.add(offlineProjectileSchoolName(
        <uint>state.offlineProjectileSchoolCodes[projectileIndex]
    ));
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(
        events, state.rngState, state.rngDraws, state.rngDigest, true
    );
    autoAttackState.landNextProjectile(actor, target, events);
    commitOfflineAutoAttackRng(state, events);
    commitOfflineAutoActor(state, sourceIndex, actor);
    state.entityHp[targetIndex] = target.hp > 0 ? target.hp : 0;
    if (events.lastDamage > 0) {
        clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, events.lastDamage);
    }
    state.entityInCombat[targetIndex] = target.inCombat;
    if (target.hp <= 0) {
        settleOfflineEastbrookLethal(state, targetIndex, sourceIndex);
    }
}

// This is the retained direct-damage subset of the source dealDamage call
// made by petRangedAttack: Firebolt bypasses armor, consumes only its explicit
// crit/damage draws, enters combat at impact, and writes its damage as pet threat.
landOfflineEmberkinFireboltProjectile(
    state: WorldState,
    projectileIndex: int,
    sourceIndex: int,
    targetIndex: int
): void {
    var crit = nextAuthoritativeRandomUnit(state) < emberkinRanged.fireboltCritChance();
    var damage = emberkinRanged.resolveFireboltDamage(
        crit,
        <float>state.entityWeaponMinimum[sourceIndex],
        <float>state.entityWeaponMaximum[sourceIndex],
        nextAuthoritativeRandomUnit(state),
        <float>state.entityAttackPower[sourceIndex],
        <float>state.entityWeaponSpeed[sourceIndex]
    );
    var hp = <int>state.entityHp[targetIndex] - damage;
    state.entityHp[targetIndex] = hp > 0 ? hp : 0;
    enterOfflineSpellProjectileCombat(state, sourceIndex, targetIndex);
    clearOfflineBreakableIncapacitateOnDamage(state, targetIndex, damage);
    if (hp > 0) {
        var petId = <uint>state.entityIds[sourceIndex];
        state.setThreat(
            <uint>state.entityIds[targetIndex],
            petId,
            stateThreatValue(state, targetIndex, petId) + <float>damage,
            1
        );
    } else {
        var ownerIndex = partyEntityIndexById(
            state, <uint>state.entityOwnerIds[sourceIndex]
        );
        if (ownerIndex >= 0) {
            settleOfflineEastbrookLethal(state, targetIndex, ownerIndex);
        }
    }
}

isOfflineLiveEmberkin(state: WorldState, index: int): bool {
    return state.offlineSessionActive && index >= 0 && index < state.entityIds.length &&
        <uint>state.entityKinds[index] == <uint>2 &&
        <uint>state.entityTemplates[index] == OFFLINE_EMBERKIN_TEMPLATE_CODE &&
        <uint>state.entityOwnerIds[index] != <uint>0 &&
        !<bool>state.entityDead[index];
}

clearOfflineEmberkinTarget(state: WorldState, petIndex: int): void {
    state.entityAggroTargetIds[petIndex] = <uint>0;
    state.entityInCombat[petIndex] = false;
    state.entityPetManualTauntPending[petIndex] = false;
    state.entitySwingTimer[petIndex] = emberkinRanged.cooldownAfterNoTarget(
        <float>state.entitySwingTimer[petIndex],
        projectileTravel.projectileTickSeconds()
    );
}

// The source moveToward open-ground branch shares this fixed-tick geometry for
// both the ranged-demon chase and heel arms. WOS has neither the collider nor
// path transaction state, so callers choose only source-approved direct aims.
stepOfflineEmberkinOpenGroundMoveToward(
    state: WorldState, petIndex: int, aimX: float, aimZ: float, speed: float
): void {
    var deltaX = aimX - <float>state.entityX[petIndex];
    var deltaZ = aimZ - <float>state.entityZ[petIndex];
    var distance = math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
    if (distance < 0.3) {
        return;
    }
    var direction = math.atan2(deltaX, deltaZ);
    var step = speed * projectileTravel.projectileTickSeconds();
    if (step > distance) {
        step = distance;
    }
    state.entityPreviousX[petIndex] = <float>state.entityX[petIndex];
    state.entityPreviousY[petIndex] = <float>state.entityY[petIndex];
    state.entityPreviousZ[petIndex] = <float>state.entityZ[petIndex];
    state.entityPreviousFacing[petIndex] = <float>state.entityFacing[petIndex];
    var nextX = <float>state.entityX[petIndex] + math.sin(direction) * step;
    var nextZ = <float>state.entityZ[petIndex] + math.cos(direction) * step;
    state.entityX[petIndex] = nextX;
    state.entityZ[petIndex] = nextZ;
    state.entityY[petIndex] = terrainGround.builtinGroundHeight(
        nextX, nextZ, state.worldSeed, true
    );
    state.entityFacing[petIndex] = direction;
}

// The source heel branch delegates to moveToward after its cached-path choice.
// Retain only that deterministic open-ground leg: the source minimum follow
// speed and the 3.5-yard clear-path threshold stay source-pinned.
stepOfflineEmberkinStraightFollow(
    state: WorldState, petIndex: int, ownerIndex: int
): void {
    var deltaX = <float>state.entityX[ownerIndex] - <float>state.entityX[petIndex];
    var deltaZ = <float>state.entityZ[ownerIndex] - <float>state.entityZ[petIndex];
    var distance = math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
    if (petFollow.shouldClearPath(distance)) {
        return;
    }
    stepOfflineEmberkinOpenGroundMoveToward(
        state,
        petIndex,
        <float>state.entityX[ownerIndex],
        <float>state.entityZ[ownerIndex],
        petFollow.followSpeed(<float>state.entityMoveSpeed[petIndex], 1.0)
    );
}

// The source ranged-pet arm closes only while the target lies beyond the spell
// reach. Root/aura/collider handling remains unavailable; this is its direct
// open-ground movement leg before the existing swing-timer decrement.
stepOfflineEmberkinStraightChase(
    state: WorldState, petIndex: int, targetIndex: int
): void {
    stepOfflineEmberkinOpenGroundMoveToward(
        state,
        petIndex,
        <float>state.entityX[targetIndex],
        <float>state.entityZ[targetIndex],
        <float>state.entityMoveSpeed[petIndex]
    );
}

// This is the scalar-only head of source updatePet. Emberkin has no retained
// channel or aspect branch, but its shared pet cooldown and out-of-combat
// 40-tick regeneration require no path/grid or effect-pipeline ownership.
stepOfflineEmberkinMaintenance(state: WorldState, petIndex: int): void {
    var tauntTimer = <float>state.entityPetTauntTimers[petIndex] -
        projectileTravel.projectileTickSeconds();
    state.entityPetTauntTimers[petIndex] = tauntTimer > 0.0 ? tauntTimer : 0.0;
    if (!<bool>state.entityInCombat[petIndex] && state.tick % <uint>40 == <uint>0 &&
        <int>state.entityHp[petIndex] < <int>state.entityMaxHp[petIndex]) {
        var restore = <int>math.round(<float>state.entityMaxHp[petIndex] * 0.02);
        if (restore < 1) {
            restore = 1;
        }
        var restoredHp = <int>state.entityHp[petIndex] + restore;
        var maxHp = <int>state.entityMaxHp[petIndex];
        state.entityHp[petIndex] = restoredHp < maxHp ? restoredHp : maxHp;
    }
}

// The retained world has no source PlayerMeta.lastActiveTick column yet. Keeping
// ownerIdle true preserves the anti-AFK guard while still allowing defensive
// assist candidates (being attacked or the owner's existing offense) to select.
offlineEmberkinAssistTargetIndex(
    state: WorldState, petIndex: int, ownerIndex: int
): int {
    var passive = <uint>state.entityPetModes[petIndex] == <uint>1;
    if (!petTarget.canSelectTarget(passive)) {
        return -1;
    }
    var aggressive = <uint>state.entityPetModes[petIndex] == <uint>3;
    var bestDistance = petTarget.initialBestDistance(aggressive);
    var bestIndex = -1;
    var candidateIndex = 0;
    while (candidateIndex < state.entityIds.length) {
        var candidateIsMob = isOfflineEastbrookLifecycleMob(state, candidateIndex);
        var deltaX = <float>state.entityX[candidateIndex] - <float>state.entityX[petIndex];
        var deltaZ = <float>state.entityZ[candidateIndex] - <float>state.entityZ[petIndex];
        var distance = math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
        var ownerHasCandidateThreat = candidateIsMob &&
            stateThreatValue(
                state, candidateIndex, <uint>state.entityIds[ownerIndex]
            ) > 0.0;
        if (petTarget.candidateEligible(
                candidateIndex == petIndex,
                <bool>state.entityDead[candidateIndex],
                <bool>state.entityHostile[candidateIndex],
                candidateIsMob,
                <uint>state.entityAggroTargetIds[candidateIndex] ==
                    <uint>state.entityIds[ownerIndex],
                <uint>state.entityAggroTargetIds[candidateIndex] ==
                    <uint>state.entityIds[petIndex],
                <uint>state.entityTargetIds[ownerIndex] ==
                    <uint>state.entityIds[candidateIndex],
                <bool>state.entityAutoAttack[ownerIndex],
                ownerHasCandidateThreat,
                aggressive,
                true,
                distance
            ) && petTarget.shouldReplaceCandidate(distance, bestDistance)) {
            bestIndex = candidateIndex;
            bestDistance = distance;
        }
        candidateIndex = candidateIndex + 1;
    }
    return bestIndex;
}

// The source runs updatePet in its mob pass after player updates. This retained
// closure handles target selection, Firebolt, and the direct open-ground heel
// leg. Cached A*, obstacle routing, pull scans and forced recovery stay deferred
// until their mutable path/grid state can be carried transactionally.
stepOfflineEmberkinRangedAttack(state: WorldState): void {
    if (!state.offlineSessionActive) {
        return;
    }
    ageOfflineEmberkinDemonCorpses(state);
    var petIndex = 0;
    while (petIndex < state.entityIds.length) {
        if (!isOfflineLiveEmberkin(state, petIndex)) {
            petIndex = petIndex + 1;
            continue;
        }
        var ownerIndex = partyEntityIndexById(
            state, <uint>state.entityOwnerIds[petIndex]
        );
        if (ownerIndex < 0 || <uint>state.entityKinds[ownerIndex] != <uint>1) {
            retireOfflineOwnedPet(state, petIndex);
            petIndex = petIndex + 1;
            continue;
        }
        stepOfflineEmberkinMaintenance(state, petIndex);
        var targetIndex = partyEntityIndexById(
            state, <uint>state.entityAggroTargetIds[petIndex]
        );
        if (targetIndex < 0 || <bool>state.entityDead[targetIndex] ||
            !<bool>state.entityHostile[targetIndex] ||
            !isOfflineEastbrookLifecycleMob(state, targetIndex)) {
            targetIndex = -1;
        }
        var ownerDeltaX = <float>state.entityX[petIndex] - <float>state.entityX[ownerIndex];
        var ownerDeltaZ = <float>state.entityZ[petIndex] - <float>state.entityZ[ownerIndex];
        if (emberkinRanged.targetExceedsLeash(
                ownerDeltaX * ownerDeltaX + ownerDeltaZ * ownerDeltaZ)) {
            targetIndex = -1;
        }
        if (targetIndex < 0 && !<bool>state.entityDead[ownerIndex]) {
            targetIndex = offlineEmberkinAssistTargetIndex(state, petIndex, ownerIndex);
        }
        if (targetIndex < 0) {
            clearOfflineEmberkinTarget(state, petIndex);
            stepOfflineEmberkinStraightFollow(state, petIndex, ownerIndex);
            petIndex = petIndex + 1;
            continue;
        }
        state.entityAggroTargetIds[petIndex] = <uint>state.entityIds[targetIndex];
        state.entityInCombat[petIndex] = true;
        var deltaX = <float>state.entityX[targetIndex] - <float>state.entityX[petIndex];
        var deltaZ = <float>state.entityZ[targetIndex] - <float>state.entityZ[petIndex];
        if (!emberkinRanged.targetWithinRange(deltaX * deltaX + deltaZ * deltaZ)) {
            stepOfflineEmberkinStraightChase(state, petIndex, targetIndex);
            state.entitySwingTimer[petIndex] = emberkinRanged.cooldownAfterNoTarget(
                <float>state.entitySwingTimer[petIndex],
                projectileTravel.projectileTickSeconds()
            );
            petIndex = petIndex + 1;
            continue;
        }
        var targetDistanceSquared = deltaX * deltaX + deltaZ * deltaZ;
        if (!emberkinRanged.shouldKeepFacing(targetDistanceSquared)) {
            state.entityFacing[petIndex] = math.atan2(deltaX, deltaZ);
        }
        state.entitySwingTimer[petIndex] = <float>state.entitySwingTimer[petIndex] -
            projectileTravel.projectileTickSeconds();
        if (<float>state.entitySwingTimer[petIndex] <= 0.0) {
            appendOfflineProjectile(
                state,
                <uint>state.entityIds[petIndex],
                <uint>state.entityIds[targetIndex],
                <float>state.entityX[petIndex],
                <float>state.entityZ[petIndex],
                <float>state.entityWeaponMinimum[petIndex],
                <float>state.entityWeaponMaximum[petIndex],
                <float>state.entityWeaponSpeed[petIndex],
                false,
                OFFLINE_PROJECTILE_SCHOOL_FIRE
            );
            state.entitySwingTimer[petIndex] = emberkinRanged.swingTimerAfterFire(
                <float>state.entityWeaponSpeed[petIndex]
            );
        }
        petIndex = petIndex + 1;
    }
}

// The source advances this launch-order queue before player swings. A pending
// projectile follows the target's current position, spends no RNG while flying
// or fizzling, and reads live attacker combat values only at its landing tick.
stepOfflineEastbrookProjectiles(state: WorldState): void {
    var projectileIndex = 0;
    while (projectileIndex < state.offlineProjectileSourceIds.length) {
        var sourceIndex = partyEntityIndexById(
            state, <uint>state.offlineProjectileSourceIds[projectileIndex]
        );
        var targetIndex = partyEntityIndexById(
            state, <uint>state.offlineProjectileTargetIds[projectileIndex]
        );
        var sourceLive = sourceIndex >= 0 && !<bool>state.entityDead[sourceIndex] &&
            (<uint>state.entityKinds[sourceIndex] == <uint>1 ||
                isOfflineLiveEmberkin(state, sourceIndex));
        var targetLive = targetIndex >= 0 && !<bool>state.entityDead[targetIndex] &&
            isOfflineEastbrookLifecycleMob(state, targetIndex);
        var projectile = new projectileTravel.ProjectileTravelState(
            <uint>state.offlineProjectileSourceIds[projectileIndex],
            <uint>state.offlineProjectileTargetIds[projectileIndex],
            <float>state.offlineProjectileX[projectileIndex],
            <float>state.offlineProjectileZ[projectileIndex]
        );
        projectile.ttl = <float>state.offlineProjectileTtls[projectileIndex];
        var result = new projectileTravel.ProjectileAdvanceResult();
        var targetX = 0.0;
        var targetZ = 0.0;
        if (targetLive) {
            targetX = <float>state.entityX[targetIndex];
            targetZ = <float>state.entityZ[targetIndex];
        }
        projectileTravel.advanceProjectile(
            projectile,
            sourceLive,
            targetLive,
            targetX,
            targetZ,
            result
        );
        if (result.disposition == projectileTravel.continueDisposition()) {
            state.offlineProjectileX[projectileIndex] = projectile.x;
            state.offlineProjectileZ[projectileIndex] = projectile.z;
            state.offlineProjectileTtls[projectileIndex] = projectile.ttl;
            projectileIndex = projectileIndex + 1;
        } else {
            if (result.disposition == projectileTravel.impactDisposition()) {
                if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    frostboltAbilityCode()) {
                    landOfflineFrostboltProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    smiteAbilityCode()) {
                    landOfflineSmiteProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    mindBlastAbilityCode()) {
                    landOfflineMindBlastProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    shadowBoltAbilityCode()) {
                    landOfflineShadowBoltProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    wrathAbilityCode()) {
                    landOfflineWrathProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    starfireAbilityCode()) {
                    landOfflineStarfireProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    entanglingRootsAbilityCode()) {
                    landOfflineEntanglingRootsProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    searingPainAbilityCode()) {
                    landOfflineSearingPainProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    shadowburnAbilityCode()) {
                    landOfflineShadowburnProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    conflagrateAbilityCode()) {
                    landOfflineConflagrateProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    immolateAbilityCode()) {
                    landOfflineImmolateProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    lightningBoltAbilityCode()) {
                    landOfflineLightningBoltProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    earthShockAbilityCode()) {
                    landOfflineEarthShockProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    frostShockAbilityCode()) {
                    landOfflineFrostShockProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    flameShockAbilityCode()) {
                    landOfflineFlameShockProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    fireballAbilityCode()) {
                    landOfflineFireballProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    moonfireAbilityCode()) {
                    landOfflineMoonfireProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    serpentStingAbilityCode()) {
                    landOfflineSerpentStingProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    insectSwarmAbilityCode()) {
                    landOfflineInsectSwarmProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    shadowWordPainAbilityCode()) {
                    landOfflineShadowWordPainProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    corruptionAbilityCode()) {
                    landOfflineCorruptionProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    curseOfAgonyAbilityCode()) {
                    landOfflineCurseOfAgonyProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    siphonLifeAbilityCode()) {
                    landOfflineSiphonLifeProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    drainLifeAbilityCode()) {
                    landOfflineDrainLifeProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    mindFlayAbilityCode()) {
                    landOfflineMindFlayProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    fearAbilityCode()) {
                    landOfflineFearProjectile(state, projectileIndex, sourceIndex, targetIndex);
                } else if (<uint>state.offlineProjectileAbilityCodes[projectileIndex] ==
                    hibernateAbilityCode()) {
                    landOfflineHibernateProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else if (offlineEmberkinFireboltProjectileProfileIsValid(
                        state, projectileIndex)) {
                    landOfflineEmberkinFireboltProjectile(
                        state, projectileIndex, sourceIndex, targetIndex
                    );
                } else {
                    landOfflineRangedProjectile(state, projectileIndex, sourceIndex, targetIndex);
                }
            }
            removeOfflineProjectileAt(state, projectileIndex);
        }
    }
}

// Hunter Auto Shot launches only in its source 8-35 yard window. The existing
// mainhand bridge owns the five-yard fallback; the 5-8 dead zone and out-of-
// range state still advance the source swing timer without inventing a hit.
stepOfflineHunterAutoShot(state: WorldState): void {
    if (!state.offlineSessionActive) { return; }
    var playerIndex = offlineQuestPrimaryPlayerIndex(state);
    if (playerIndex < 0 || <bool>state.entityDead[playerIndex] ||
        !<bool>state.entityAutoAttack[playerIndex] ||
        !offlineHunterAutoShotProfileEnabled(state, playerIndex)) {
        return;
    }
    var targetIndex = partyEntityIndexById(state, <uint>state.entityTargetIds[playerIndex]);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex]) {
        state.entityAutoAttack[playerIndex] = false;
        return;
    }
    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, playerIndex, targetIndex, actor);
    if (actor.targetDistance <= 5.0) { return; }
    if (actor.targetDistance < 8.0 || actor.targetDistance > 35.0) {
        actor.swingTimer = actor.swingTimer - projectileTravel.projectileTickSeconds();
        if (actor.swingTimer < 0.0) { actor.swingTimer = 0.0; }
        commitOfflineAutoActor(state, playerIndex, actor);
        return;
    }
    configureOfflineHunterAutoShot(actor);
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(
        events, state.rngState, state.rngDraws, state.rngDigest, true
    );
    autoAttackState.fixedTick(actor, target, events);
    if (actor.pendingWand.length == 1) {
        appendOfflineProjectile(
            state,
            actor.id,
            target.id,
            <float>state.entityX[playerIndex],
            <float>state.entityZ[playerIndex],
            <float>actor.pendingMinimum[0],
            <float>actor.pendingMaximum[0],
            <float>actor.pendingSpeed[0],
            false,
            OFFLINE_PROJECTILE_SCHOOL_PHYSICAL
        );
    }
    commitOfflineAutoAttackRng(state, events);
    commitOfflineAutoActor(state, playerIndex, actor);
}

// Casters have no ranged dead zone. Bear, Cat and Travel form deliberately
// leave this branch and use the source melee fallback when in five-yard range.
stepOfflineCasterWandAutoAttack(state: WorldState): void {
    if (!state.offlineSessionActive) { return; }
    var playerIndex = offlineQuestPrimaryPlayerIndex(state);
    if (playerIndex < 0 || <bool>state.entityDead[playerIndex] ||
        !<bool>state.entityAutoAttack[playerIndex] ||
        !offlineCasterWandProfileEnabled(state, playerIndex)) {
        return;
    }
    var targetIndex = partyEntityIndexById(state, <uint>state.entityTargetIds[playerIndex]);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex]) {
        state.entityAutoAttack[playerIndex] = false;
        return;
    }
    var actor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, playerIndex, targetIndex, actor);
    configureOfflineCasterWand(actor, offlineWandSchoolForPlayer(state, playerIndex));
    var target = new autoAttackState.AutoTarget();
    prepareOfflineEastbrookAutoTarget(state, targetIndex, target);
    var events = new autoAttackState.AutoEvents();
    autoAttackState.initializeAuthoritativeRng(
        events, state.rngState, state.rngDraws, state.rngDigest, true
    );
    autoAttackState.fixedTick(actor, target, events);
    if (actor.pendingWand.length == 1) {
        appendOfflineProjectile(
            state,
            actor.id,
            target.id,
            <float>state.entityX[playerIndex],
            <float>state.entityZ[playerIndex],
            <float>actor.pendingMinimum[0],
            <float>actor.pendingMaximum[0],
            <float>actor.pendingSpeed[0],
            <bool>actor.pendingWand[0],
            offlineProjectileSchoolCode(<string>actor.pendingSchool[0])
        );
    }
    commitOfflineAutoAttackRng(state, events);
    commitOfflineAutoActor(state, playerIndex, actor);
}

offlineMobCatalogIndex(state: WorldState, index: int): int {
    if (index < 0 || index >= state.entityIds.length ||
        <uint>state.entityKinds[index] != <uint>2) {
        return -1;
    }
    var template = <uint>state.entityTemplates[index];
    if (template == <uint>0) {
        return -1;
    }
    var catalogIndex = <int>(template - <uint>1);
    if (catalogIndex < 0 || catalogIndex >= campMobCore.mobCount(true)) {
        return -1;
    }
    return catalogIndex;
}

offlineMobTemplateId(state: WorldState, index: int): string {
    var catalogIndex = offlineMobCatalogIndex(state, index);
    if (catalogIndex < 0) {
        return "";
    }
    return campMobCore.text(catalogIndex, "id", true);
}

offlineMobFamily(state: WorldState, index: int): string {
    var catalogIndex = offlineMobCatalogIndex(state, index);
    if (catalogIndex < 0) {
        return "";
    }
    return campMobCore.text(catalogIndex, "family", true);
}

stateThreatValue(state: WorldState, entityIndex: int, targetId: uint): float {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length || targetId == <uint>0) {
        return 0.0;
    }
    var start = <int><uint>state.entityThreatOffsets[entityIndex];
    var end = <int><uint>state.entityThreatOffsets[entityIndex + 1];
    var index = start;
    while (index < end) {
        if (<uint>state.entityThreatTargetIds[index] == targetId) {
            return <float>state.entityThreatValues[index];
        }
        index = index + 1;
    }
    return 0.0;
}

stateTopThreatValue(state: WorldState, entityIndex: int): float {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length) {
        return 0.0;
    }
    var start = <int><uint>state.entityThreatOffsets[entityIndex];
    var end = <int><uint>state.entityThreatOffsets[entityIndex + 1];
    var top = 0.0;
    var index = start;
    while (index < end) {
        if (<float>state.entityThreatValues[index] > top) {
            top = <float>state.entityThreatValues[index];
        }
        index = index + 1;
    }
    return top;
}

// The flattened WOS threat partition is the source hate-table owner. Death and
// respawn clear it in-place, including the forced-target lock that clearThreat
// clears with the source Map.
clearStateThreat(state: WorldState, entityIndex: int): void {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length) {
        return;
    }
    var start = <int><uint>state.entityThreatOffsets[entityIndex];
    var end = <int><uint>state.entityThreatOffsets[entityIndex + 1];
    while (end > start) {
        state.entityThreatTargetIds.removeAt(start);
        state.entityThreatValues.removeAt(start);
        var offsetIndex = entityIndex + 1;
        while (offsetIndex < state.entityThreatOffsets.length) {
            state.entityThreatOffsets[offsetIndex] =
                <uint>state.entityThreatOffsets[offsetIndex] - <uint>1;
            offsetIndex = offsetIndex + 1;
        }
        end = end - 1;
    }
    state.entityForcedTargetIds[entityIndex] = <uint>0;
    state.entityForcedTargetTimers[entityIndex] = 0.0;
}

// Source aggroMob's primary mutation. Taunt uses social=false; ordinary player
// initiation and proximity scans retain the existing same-template social tail.
enterIdleMobAggroWithSocial(
    state: WorldState, primaryIndex: int, targetId: uint, social: bool
): bool {
    if (primaryIndex < 0 || primaryIndex >= state.entityIds.length || targetId == <uint>0 ||
        <uint>state.entityKinds[primaryIndex] != <uint>2 ||
        <bool>state.entityDead[primaryIndex] ||
        <uint>state.entityOwnerIds[primaryIndex] != <uint>0 ||
        <uint>state.entityAiStates[primaryIndex] != <uint>1) {
        return false;
    }
    state.entityAiStates[primaryIndex] = <uint>2;
    state.entityTargetIds[primaryIndex] = targetId;
    state.entityAggroTargetIds[primaryIndex] = targetId;
    state.entityInCombat[primaryIndex] = true;
    state.entityLeashAnchorPresent[primaryIndex] = true;
    state.entityLeashAnchorX[primaryIndex] = <float>state.entityX[primaryIndex];
    state.entityLeashAnchorY[primaryIndex] = <float>state.entityY[primaryIndex];
    state.entityLeashAnchorZ[primaryIndex] = <float>state.entityZ[primaryIndex];
    state.setThreat(
        <uint>state.entityIds[primaryIndex],
        targetId,
        stateThreatValue(state, primaryIndex, targetId) + 1.0,
        1
    );
    if (social) {
        applyOfflineIdleSocialPull(state, primaryIndex, targetId);
    }
    return true;
}

enterIdleMobAggro(state: WorldState, primaryIndex: int, targetId: uint): bool {
    return enterIdleMobAggroWithSocial(state, primaryIndex, targetId, true);
}

enterIdleMobAggroWithoutSocial(state: WorldState, primaryIndex: int, targetId: uint): bool {
    return enterIdleMobAggroWithSocial(state, primaryIndex, targetId, false);
}

// Source aggroMob transitions the primary before scanning same-template allies.
// This bridge maps only the social tail; the caller owns the primary transition
// and writes the primary's second startAutoAttack threat after this returns.
applyOfflineIdleSocialPull(state: WorldState, primaryIndex: int, targetId: uint): void {
    if (primaryIndex < 0 || primaryIndex >= state.entityIds.length || targetId == <uint>0) {
        return;
    }
    var candidates = new container.Array<socialAggro.FleeSocialAggroMob>();
    var candidateStateIndices = new container.Array<int>();
    var candidateWasIdle = new container.Array<bool>();
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>2) {
            var candidate = new socialAggro.FleeSocialAggroMob();
            candidate.id = <int><uint>state.entityIds[index];
            candidate.templateId = offlineMobTemplateId(state, index);
            candidate.family = offlineMobFamily(state, index);
            candidate.x = <float>state.entityX[index];
            candidate.y = <float>state.entityY[index];
            candidate.z = <float>state.entityZ[index];
            candidate.dead = <bool>state.entityDead[index];
            candidate.hostile = <bool>state.entityHostile[index];
            candidate.aiState = <uint>state.entityAiStates[index] == <uint>1 ? "idle" : "active";
            candidate.hasOwner = <uint>state.entityOwnerIds[index] != <uint>0;
            candidates.add(candidate);
            candidateStateIndices.add(index);
            candidateWasIdle.add(<uint>state.entityAiStates[index] == <uint>1);
        }
        index = index + 1;
    }
    socialAggro.normalSocialPull(
        candidates, <int><uint>state.entityIds[primaryIndex], <int>targetId
    );
    index = 0;
    while (index < candidates.length) {
        var candidate = <socialAggro.FleeSocialAggroMob>candidates[index];
        if (<bool>candidateWasIdle[index] && candidate.aiState == "chase") {
            var stateIndex = <int>candidateStateIndices[index];
            state.entityAiStates[stateIndex] = <uint>2;
            state.entityTargetIds[stateIndex] = targetId;
            state.entityAggroTargetIds[stateIndex] = targetId;
            state.entityInCombat[stateIndex] = true;
            state.entityLeashAnchorPresent[stateIndex] = true;
            state.entityLeashAnchorX[stateIndex] = candidate.x;
            state.entityLeashAnchorY[stateIndex] = candidate.y;
            state.entityLeashAnchorZ[stateIndex] = candidate.z;
            state.setThreat(
                <uint>state.entityIds[stateIndex],
                targetId,
                stateThreatValue(state, stateIndex, targetId) + 1.0,
                1
            );
        }
        index = index + 1;
    }
}

nextAuthoritativeRandomUnit(state: WorldState): float {
    return <float>state.nextRandomU32(true) / 4294967296.0;
}

// The retained M8 offline world contains exactly the two source zone-one
// templates whose idle branch is now executable. Other WOS mob rows continue
// to preserve their stored state until their full source AI slices arrive.
isOfflineEastbrookWanderMob(state: WorldState, index: int): bool {
    if (!state.offlineSessionActive || <uint>state.entityKinds[index] != <uint>2 ||
        <bool>state.entityDead[index] || <bool>state.entityInCombat[index] ||
        <uint>state.entityAiStates[index] != <uint>1) {
        return false;
    }
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var wildBoar = <uint>(campMobCore.indexOf("wild_boar", true) + 1);
    var template = <uint>state.entityTemplates[index];
    return template == forestWolf || template == wildBoar;
}

// The retained offline subset contains only ordinary, ownerless Eastbrook
// wolves and boars. The broader source lifecycle has dedicated owners for
// pets, instances, world bosses, auras, loot and encounter callbacks.
isOfflineEastbrookLifecycleMob(state: WorldState, index: int): bool {
    if (!state.offlineSessionActive || index < 0 || index >= state.entityIds.length ||
        <uint>state.entityKinds[index] != <uint>2 ||
        <uint>state.entityOwnerIds[index] != <uint>0) {
        return false;
    }
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var wildBoar = <uint>(campMobCore.indexOf("wild_boar", true) + 1);
    var template = <uint>state.entityTemplates[index];
    return template == forestWolf || template == wildBoar;
}

beginOfflineEastbrookMobDeath(state: WorldState, index: int): void {
    state.entityDead[index] = true;
    state.entityHp[index] = 0;
    clearQueuedOnSwing(state, index);
    state.entityAiStates[index] = mobLifecycle.deadAiState();
    state.entityCorpseMicros[index] = mobLifecycle.defaultCorpseMicros();
    state.entityRespawnMicros[index] = mobLifecycle.defaultRespawnMicros();
    state.entityAggroTargetIds[index] = <uint>0;
    clearStateThreat(state, index);
}

respawnOfflineEastbrookMob(state: WorldState, index: int): void {
    removeOfflineCorpseLootRecipients(state, <uint>state.entityIds[index]);
    state.entityDead[index] = false;
    state.entityLootable[index] = false;
    state.entityCorpseQuestItemCodes[index] = <uint>0;
    state.entityCorpseQuestItemCounts[index] = <uint>0;
    clearCorpseSharedLoot(state, index);
    state.entityHostile[index] = true;
    state.entityX[index] = <float>state.entitySpawnX[index];
    state.entityY[index] = <float>state.entitySpawnY[index];
    state.entityZ[index] = <float>state.entitySpawnZ[index];
    state.entityPreviousX[index] = <float>state.entityX[index];
    state.entityPreviousY[index] = <float>state.entityY[index];
    state.entityPreviousZ[index] = <float>state.entityZ[index];
    state.entityHp[index] = <int>state.entityMaxHp[index];
    state.entityAiStates[index] = mobLifecycle.idleAiState();
    state.entityTargetIds[index] = <uint>0;
    state.entityAggroTargetIds[index] = <uint>0;
    state.entityInCombat[index] = false;
    state.entityLeashAnchorPresent[index] = false;
    state.entityEvadeStalls[index] = 0.0;
    state.entityFleeTimers[index] = 0.0;
    state.entityFleeReturnTimers[index] = 0.0;
    state.entityHasFled[index] = false;
    state.entityWanderTargetPresent[index] = false;
    state.entityWanderTargetX[index] = 0.0;
    state.entityWanderTargetZ[index] = 0.0;
    state.entityWanderTimers[index] = mobLifecycle.respawnWanderTimer(
        nextAuthoritativeRandomUnit(state)
    );
    clearStateThreat(state, index);
}

// This runs after the retained idle/wander passes. A source corpse's updateMob
// branch returns immediately after respawn, so the revived row cannot receive
// another idle aggro scan until the following fixed tick.
stepOfflineEastbrookMobLifecycle(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (isOfflineEastbrookLifecycleMob(state, index)) {
            if (mobLifecycle.shouldStartDeath(
                    <bool>state.entityDead[index], <int>state.entityHp[index])) {
                beginOfflineEastbrookMobDeath(state, index);
            }
            if (<bool>state.entityDead[index]) {
                state.entityCorpseMicros[index] = mobLifecycle.timerAfterFixedTick(
                    <uint>state.entityCorpseMicros[index]
                );
                state.entityRespawnMicros[index] = mobLifecycle.timerAfterFixedTick(
                    <uint>state.entityRespawnMicros[index]
                );
                if (mobLifecycle.shouldRespawnWildMob(
                        <bool>state.entityDead[index],
                        <uint>state.entityRespawnMicros[index],
                        <uint>state.entityCorpseMicros[index],
                        <bool>state.entityLootable[index])) {
                    respawnOfflineEastbrookMob(state, index);
                }
            }
        }
        index = index + 1;
    }
}

// Target ownership, pull-over and leash/flee remain outside this narrow bridge.
// It advances the source pursuit profile for the retained offline player target,
// consumes only its base melee swing requests and writes existing state columns.
isOfflineEastbrookMeleePursuitMob(state: WorldState, index: int): bool {
    if (!isOfflineEastbrookLifecycleMob(state, index) ||
        <bool>state.entityDead[index]) {
        return false;
    }
    var aiState = <uint>state.entityAiStates[index];
    return aiState == mobLifecycle.chaseAiState() ||
        aiState == mobLifecycle.attackAiState();
}

offlineFearMotionAuraIndex(state: WorldState, entityIndex: int): int {
    if (!motionAuraStateIsValid(state, entityIndex) ||
        !motionAuraDetailsStateIsValid(state)) {
        return -1;
    }
    var fearCode = fearAbilityCode();
    var incapKind = ccContract.motionAuraKindCode("incapacitate");
    var auraIndex = <int><uint>state.entityMotionAuraOffsets[entityIndex];
    var auraEnd = <int><uint>state.entityMotionAuraOffsets[entityIndex + 1];
    while (auraIndex < auraEnd) {
        if (<uint>state.entityMotionAuraAbilityCodes[auraIndex] == fearCode &&
            <uint>state.entityMotionAuraKindCodes[auraIndex] == incapKind) {
            return auraIndex;
        }
        auraIndex = auraIndex + 1;
    }
    return -1;
}

// Source `updateFearMovement` runs before ordinary mob locomotion. The
// retained Eastbrook outdoor subset has no collider projection, so the same
// source direction and capped flee speed advance on its terrain sample.
stepOfflineEastbrookFearMovement(state: WorldState, index: int): bool {
    var auraIndex = offlineFearMotionAuraIndex(state, index);
    if (auraIndex < 0) { return false; }
    var direction = <float>state.entityMotionAuraValues[auraIndex];
    if (direction < -3.141592653589793 || direction > 3.141592653589793) {
        throw "woc Fear direction is invalid";
    }
    var step = fleeSpeed.fleeSpeed(<float>state.entityMoveSpeed[index], 1.0) *
        projectileTravel.projectileTickSeconds();
    state.entityPreviousX[index] = <float>state.entityX[index];
    state.entityPreviousY[index] = <float>state.entityY[index];
    state.entityPreviousZ[index] = <float>state.entityZ[index];
    state.entityPreviousFacing[index] = <float>state.entityFacing[index];
    var nextX = <float>state.entityX[index] + math.sin(direction) * step;
    var nextZ = <float>state.entityZ[index] + math.cos(direction) * step;
    state.entityX[index] = nextX;
    state.entityZ[index] = nextZ;
    state.entityY[index] = terrainGround.builtinGroundHeight(nextX, nextZ, state.worldSeed, true);
    state.entityFacing[index] = direction;
    return true;
}

stepOfflineEastbrookForcedTarget(state: WorldState, index: int): void {
    if (!isOfflineEastbrookLifecycleMob(state, index) ||
        <bool>state.entityDead[index] ||
        <float>state.entityForcedTargetTimers[index] <= 0.0) {
        return;
    }
    state.entityForcedTargetTimers[index] = <float>state.entityForcedTargetTimers[index] -
        <float>mobLifecycle.fixedTickMicros() / 1000000.0;
    var forcedId = <uint>state.entityForcedTargetIds[index];
    var forcedIndex = partyEntityIndexById(state, forcedId);
    if (<float>state.entityForcedTargetTimers[index] > 0.0 && forcedIndex >= 0 &&
        <uint>state.entityKinds[forcedIndex] == <uint>1 &&
        !<bool>state.entityDead[forcedIndex]) {
        state.entityAggroTargetIds[index] = forcedId;
        return;
    }
    if (<float>state.entityForcedTargetTimers[index] <= 0.0) {
        state.entityForcedTargetTimers[index] = 0.0;
        state.entityForcedTargetIds[index] = <uint>0;
    }
}

absoluteAngleDifference(first: float, second: float): float {
    var difference = first - second;
    while (difference > 3.141592653589793) {
        difference = difference - 6.283185307179586;
    }
    while (difference < -3.141592653589793) {
        difference = difference + 6.283185307179586;
    }
    return difference < 0.0 ? -difference : difference;
}

// Warrior-only parry/block uses the source front-arc gate. The offline WOS
// row has no separate mutable Strength column; current warrior AP is 2*Strength
// in the retained starter/equipment projection, so AP/2 supplies that value.
// Auras that independently alter AP remain outside this M8 combat slice.
applyOfflineMobSwingWarriorDefense(
    state: WorldState,
    mobIndex: int,
    playerIndex: int,
    swing: mobSwing.MobSwingState
): void {
    swing.targetParryChance = 0.0;
    swing.targetBlockChance = 0.0;
    swing.targetBlockValue = 0;
    if (!state.offlineSessionActive || playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        state.offlinePlayerClass != <uint>0) {
        return;
    }
    var angleToMob = math.atan2(
        <float>state.entityX[mobIndex] - <float>state.entityX[playerIndex],
        <float>state.entityZ[mobIndex] - <float>state.entityZ[playerIndex]
    );
    if (absoluteAngleDifference(
            angleToMob, <float>state.entityFacing[playerIndex]
        ) >= 1.5707963267948966) {
        return;
    }
    swing.targetParryChance = 0.05 +
        (effectiveOfflineAttackPower(state, playerIndex) / 2.0) * 0.0005;
    if (<int>state.entityBlockValue[playerIndex] > 0 &&
        <float>state.entityBlockChance[playerIndex] > 0.0) {
        swing.targetBlockChance = <float>state.entityBlockChance[playerIndex];
        swing.targetBlockValue = <int>state.entityBlockValue[playerIndex];
    }
}

// This is the single-player subset of the source handleDeath player branch.
// It retains the state that the WOS owner can represent today: HP/dead, active
// cast and combat posture, plus the idle handoff for Eastbrook pursuers. Full
// aura teardown, pets, revenge and multi-player retargeting remain owned by a
// future shared death transaction.
applyOfflineMobMeleePlayerDeath(state: WorldState, playerIndex: int): void {
    state.entityDead[playerIndex] = true;
    state.entityHp[playerIndex] = 0;
    state.entityCastingAbility[playerIndex] = <uint>0;
    state.entityCastTargetIds[playerIndex] = <uint>0;
    state.entityCastingFlags[playerIndex] =
        <uint>state.entityCastingFlags[playerIndex] & <uint>65531;
    state.entityTargetIds[playerIndex] = <uint>0;
    state.entityAutoAttack[playerIndex] = false;
    clearQueuedOnSwing(state, playerIndex);
    clearOfflineComboPoints(state, playerIndex);
    state.entitySitting[playerIndex] = false;
    clearHeldMovement(state, playerIndex);
    var deadPlayerId = <uint>state.entityIds[playerIndex];
    var index = 0;
    while (index < state.entityIds.length) {
        if (isOfflineEastbrookLifecycleMob(state, index) &&
            <uint>state.entityAggroTargetIds[index] == deadPlayerId) {
            state.entityTargetIds[index] = <uint>0;
            state.entityAggroTargetIds[index] = <uint>0;
            state.entityAiStates[index] = mobLifecycle.idleAiState();
            state.entityInCombat[index] = false;
            state.entitySwingTimer[index] = 0.0;
            clearStateThreat(state, index);
        }
        index = index + 1;
    }
    var petIndex = offlineOwnedEmberkinPetIndex(state, deadPlayerId, false);
    if (petIndex >= 0) {
        beginOfflineEmberkinDemonDeath(state, petIndex);
    }
}

// The current retained Eastbrook set contains only forest wolves and wild
// boars. Neither has a mobSwing on-hit affix; boar thorns run when the player
// hits the boar, and wolf pack frenzy runs after a packmate dies. This bridge
// therefore resolves only the source base hit-table transaction.
applyOfflineDamageCastPushback(state: WorldState, playerIndex: int, damage: int): void {
    if (damage <= 0 || playerIndex < 0 || playerIndex >= state.entityIds.length ||
        <uint>state.entityKinds[playerIndex] != <uint>1 ||
        <uint>state.entityCastingAbility[playerIndex] == <uint>0) {
        return;
    }
    var cast = loadCastingState(state, playerIndex);
    casting.pushbackCast(cast);
    storeCastingState(state, playerIndex, cast);
}

resolveOfflineEastbrookMobSwingRequests(
    state: WorldState,
    mobIndex: int,
    playerIndex: int,
    swingRequests: int
): void {
    if (swingRequests <= 0 || <bool>state.entityDead[playerIndex]) {
        return;
    }
    var swing = new mobSwing.MobSwingState();
    swing.sourceLevel = <int>state.entityLevels[mobIndex];
    swing.weaponMinimum = <float>state.entityWeaponMinimum[mobIndex];
    swing.weaponMaximum = <float>state.entityWeaponMaximum[mobIndex];
    swing.weaponSpeed = <float>state.entityWeaponSpeed[mobIndex];
    swing.effectiveAttackPower = effectiveOfflineAttackPower(state, mobIndex);
    swing.sourceEnraged = false;
    swing.enrageDamageMultiplier = 1.0;
    swing.petDamageMultiplier = 1.0;
    swing.targetKind = "player";
    swing.targetDodgeChance = effectiveOfflineDodgeChance(state, playerIndex);
    swing.targetArmorReduction = mobSwing.armorReductionFromArmor(
        effectiveOfflineArmor(state, playerIndex), swing.sourceLevel, true
    );
    swing.targetDead = false;
    swing.missChance = mobSwing.sourceSwingMissChance(
        swing.sourceLevel,
        <int>state.entityLevels[playerIndex],
        true,
        true,
        0.0,
        true
    );
    applyOfflineMobSwingWarriorDefense(state, mobIndex, playerIndex, swing);
    mobSwing.initializeAuthoritativeRng(
        swing, state.rngState, state.rngDraws, state.rngDigest, true
    );
    var requestIndex = 0;
    while (requestIndex < swingRequests && !<bool>state.entityDead[playerIndex]) {
        if (mobSwing.swing(swing) == "hit") {
            var damageIndex = swing.damageAmounts.length - 1;
            var dealt = <int>swing.damageAmounts[damageIndex];
            dealt = applyOfflineAbsorbDamage(state, playerIndex, dealt);
            var hp = <int>state.entityHp[playerIndex] - dealt;
            state.entityHp[playerIndex] = hp > 0 ? hp : 0;
            if (dealt > 0) {
                clearOfflineBreakableIncapacitateOnDamage(state, playerIndex, dealt);
                applyOfflineDamageCastPushback(state, playerIndex, dealt);
            }
            if (hp <= 0) {
                applyOfflineMobMeleePlayerDeath(state, playerIndex);
            }
        }
        requestIndex = requestIndex + 1;
    }
    state.rngState = mobSwing.authoritativeRngState(swing, true);
    state.rngDraws = mobSwing.authoritativeRngDraws(swing, true);
    state.rngDigest = mobSwing.authoritativeRngDigest(swing, true);
}

stepOfflineEastbrookMobMeleePursuit(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (isOfflineEastbrookMeleePursuitMob(state, index)) {
            stepOfflineEastbrookForcedTarget(state, index);
            if (!stepOfflineEastbrookFearMovement(state, index) &&
                !motionAuraEntityIsStunned(state, index)) {
                var rooted = motionAuraEntityIsRooted(state, index);
                var targetIndex = partyEntityIndexById(
                    state, <uint>state.entityAggroTargetIds[index]
                );
                if (targetIndex >= 0 && <uint>state.entityKinds[targetIndex] == <uint>1 &&
                    !<bool>state.entityDead[targetIndex]) {
                    state.entityPreviousX[index] = <float>state.entityX[index];
                    state.entityPreviousY[index] = <float>state.entityY[index];
                    state.entityPreviousZ[index] = <float>state.entityZ[index];
                    state.entityPreviousFacing[index] = <float>state.entityFacing[index];
                    var movementMultiplier = motionAuras.movementMultiplier(
                        frostboltSlowMultiplier(),
                        1.0,
                        state.entityMotionAuraAbilityCodes,
                        state.entityMotionAuraSourceIds,
                        state.entityMotionAuraKindCodes,
                        state.entityMotionAuraRemaining,
                        state.entityMotionAuraValues,
                        <int><uint>state.entityMotionAuraOffsets[index],
                        <int><uint>state.entityMotionAuraOffsets[index + 1],
                        true
                    );
                    var pursuit = new mobMeleePursuit.MobMeleePursuitState();
                    mobMeleePursuit.initializeMobMeleePursuit(
                        pursuit,
                        offlineMobTemplateId(state, index),
                        <float>state.entityPresentationScales[index],
                        <float>state.entityX[index],
                        <float>state.entityY[index],
                        <float>state.entityZ[index],
                        <float>state.entityFacing[index],
                        <float>state.entityMoveSpeed[index] * movementMultiplier,
                        <float>state.entityWeaponSpeed[index],
                        true
                    );
                    pursuit.rooted = rooted;
                    pursuit.swingTimer = <float>state.entitySwingTimer[index];
                    var target = new mobMeleePursuit.MobMeleePursuitTarget();
                    mobMeleePursuit.setMobMeleePursuitTarget(
                        target,
                        <float>state.entityX[targetIndex],
                        <float>state.entityZ[targetIndex],
                        true
                    );
                    var pursuing = mobMeleePursuit.stepMobMeleePursuit(
                        pursuit, target, state.worldSeed, true
                    );
                    state.entityX[index] = pursuit.x;
                    state.entityY[index] = pursuit.y;
                    state.entityZ[index] = pursuit.z;
                    state.entityFacing[index] = pursuit.facing;
                    state.entitySwingTimer[index] = pursuit.swingTimer;
                    state.entityAiStates[index] = pursuing ?
                        mobLifecycle.attackAiState() : mobLifecycle.chaseAiState();
                    resolveOfflineEastbrookMobSwingRequests(
                        state, index, targetIndex, pursuit.swingRequests
                    );
                }
            }
            // Source updates mob AI first, then advances its auras. During
            // incapacitate, forced-target time remains eligible but pursuit and
            // melee are suppressed for this tick.
            ageMotionAurasForEntity(state, index);
        }
        index = index + 1;
    }
}

// The retained offline Eastbrook subset has no delve detection modifier or
// stealth-capable player state. It still preserves source nearest selection,
// strict radius and trivial-con rules before routing through aggroMob's owner.
stepOfflineEastbrookMobIdleAggro(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (isOfflineEastbrookWanderMob(state, index)) {
            var templateIndex = offlineMobCatalogIndex(state, index);
            if (templateIndex >= 0) {
                var candidates = new container.Array<idleAggro.IdleAggroCandidate>();
                var playerIndex = 0;
                while (playerIndex < state.entityIds.length) {
                    if (<uint>state.entityKinds[playerIndex] == <uint>1) {
                        var candidate = new idleAggro.IdleAggroCandidate();
                        candidate.id = <uint>state.entityIds[playerIndex];
                        candidate.level = <int>state.entityLevels[playerIndex];
                        candidate.dead = <bool>state.entityDead[playerIndex];
                        candidate.stealthed = offlineProwlIsActive(state, playerIndex);
                        candidate.detectionMultiplier = 1.0;
                        var dx = <float>state.entityX[playerIndex] - <float>state.entityX[index];
                        var dz = <float>state.entityZ[playerIndex] - <float>state.entityZ[index];
                        candidate.distanceSquared = dx * dx + dz * dz;
                        candidates.add(candidate);
                    }
                    playerIndex = playerIndex + 1;
                }
                var selection = new idleAggro.IdleAggroSelection();
                idleAggro.selectIdleAggroTarget(
                    selection,
                    <int>state.entityLevels[index],
                    campMobCore.metric(templateIndex, "aggro_radius", true),
                    campMobCore.flag(templateIndex, "elite", true),
                    campMobCore.flag(templateIndex, "rare", true),
                    campMobCore.flag(templateIndex, "boss", true),
                    candidates,
                    true
                );
                if (selection.targetId != <uint>0) {
                    enterIdleMobAggro(state, index, selection.targetId);
                }
            }
        }
        index = index + 1;
    }
}

// Source tick order is player updates followed by entity mob updates. This is
// deliberately a narrow M8 idle arm: aggro, combat, flee, pet and respawn
// transitions remain with their own authoritative source slices.
stepOfflineEastbrookMobWander(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (isOfflineEastbrookWanderMob(state, index)) {
            state.entityPreviousX[index] = <float>state.entityX[index];
            state.entityPreviousY[index] = <float>state.entityY[index];
            state.entityPreviousZ[index] = <float>state.entityZ[index];
            state.entityPreviousFacing[index] = <float>state.entityFacing[index];

            var wander = new eastbrookIdleWander.EastbrookIdleWanderState();
            wander.x = <float>state.entityX[index];
            wander.y = <float>state.entityY[index];
            wander.z = <float>state.entityZ[index];
            wander.facing = <float>state.entityFacing[index];
            wander.spawnX = <float>state.entitySpawnX[index];
            wander.spawnZ = <float>state.entitySpawnZ[index];
            wander.moveSpeed = <float>state.entityMoveSpeed[index];
            wander.templateKnown = true;
            // The retained Eastbrook wolf/boar source templates do not phase.
            wander.phasesThroughObstacles = false;
            wander.wanderTimer = <float>state.entityWanderTimers[index];
            wander.hasWanderTarget = <bool>state.entityWanderTargetPresent[index];
            wander.wanderTargetX = <float>state.entityWanderTargetX[index];
            wander.wanderTargetZ = <float>state.entityWanderTargetZ[index];

            var firstUnit = 0.0;
            var secondUnit = 0.0;
            if (wander.wanderTimer - 0.05 <= 0.0) {
                firstUnit = nextAuthoritativeRandomUnit(state);
                if (!wander.hasWanderTarget) {
                    secondUnit = nextAuthoritativeRandomUnit(state);
                }
            }
            eastbrookIdleWander.selectEastbrookIdleWanderTarget(
                wander,
                firstUnit,
                secondUnit
            );
            if (wander.hasWanderTarget) {
                var arrived = eastbrookIdleWander.moveEastbrookIdleWanderTargetWithWorldMotion(
                    wander,
                    state.worldSeed
                );
                if (arrived) {
                    eastbrookIdleWander.finishEastbrookIdleWanderArrival(
                        wander,
                        true,
                        nextAuthoritativeRandomUnit(state)
                    );
                }
            }

            state.entityX[index] = wander.x;
            state.entityY[index] = wander.y;
            state.entityZ[index] = wander.z;
            state.entityFacing[index] = wander.facing;
            state.entityWanderTimers[index] = wander.wanderTimer;
            if (wander.hasWanderTarget) {
                state.entityWanderTargetPresent[index] = true;
                state.entityWanderTargetX[index] = wander.wanderTargetX;
                state.entityWanderTargetZ[index] = wander.wanderTargetZ;
            } else {
                state.entityWanderTargetPresent[index] = false;
                state.entityWanderTargetX[index] = 0.0;
                state.entityWanderTargetZ[index] = 0.0;
            }
            if (!wanderStateIsValid(state, index)) {
                throw "woc offline Eastbrook wander state is invalid";
            }
        }
        index = index + 1;
    }
}

// handleDeath clears the active cast and target directly. It deliberately does
// not use cancelCast: death does not emit an ordinary failed cast-stop, and the
// source leaves the remaining lifecycle fields to its death/respawn owners.
// Player target references to the dead entity are also cleared, matching the
// source roster/death cleanup rather than retaining a targetable corpse.
clearDeadCasting(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<bool>state.entityDead[index]) {
            clearPartyMarkerEntityRows(state, <uint>state.entityIds[index]);
            state.entityCastingAbility[index] = <uint>0;
            state.entityCastTargetIds[index] = <uint>0;
            state.entityCastingFlags[index] =
                <uint>state.entityCastingFlags[index] & <uint>65531;
            clearQueuedOnSwing(state, index);
            clearOfflineComboPoints(state, index);
            clearOfflineConsumables(state, index);
            state.entitySitting[index] = false;
        }
        index = index + 1;
    }
    index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>1) {
            var targetIndex = partyEntityIndexById(
                state, <uint>state.entityTargetIds[index]
            );
            if (targetIndex >= 0 && <bool>state.entityDead[targetIndex]) {
                state.entityTargetIds[index] = <uint>0;
                state.entityAutoAttack[index] = false;
            }
        }
        index = index + 1;
    }
}

pub fixedTick(inputBytes: container.Array<uint>): container.Array<uint> {
    var input = binary.decodeFixedTickInput(inputBytes);
    if (stateDigest(input.committedState, 1) != input.committedStateDigest) {
        throw "woc committed state digest does not match bytes";
    }
    var state: WorldState;
    if (input.committedState.length == 0) {
        state = new WorldState();
        if (input.offlineBootstrap.length != 0) {
            applyOfflineBootstrap(state, decodeOfflineBootstrap(input.offlineBootstrap));
        }
    } else {
        if (input.offlineBootstrap.length != 0) {
            throw "woc offline bootstrap may only appear on the first authoritative tick";
        }
        state = decodeState(input.committedState);
    }
    var batch = new CommandBatch();
    batch.commandCount = input.commandCount;
    var commandIndex = 0;
    while (commandIndex < input.commandCount) {
        batch.commandIds.add(<uint>input.commandIds[commandIndex]);
        batch.commandActorIds.add(<uint>input.commandActorIds[commandIndex]);
        batch.commandActorGenerations.add(<uint>input.commandActorGenerations[commandIndex]);
        batch.commandSequences.add(<uint>input.commandSequences[commandIndex]);
        batch.commandPayloadOffsets.add(<uint>input.commandPayloadOffsets[commandIndex]);
        batch.commandPayloadLengths.add(<uint>input.commandPayloadLengths[commandIndex]);
        commandIndex = commandIndex + 1;
    }
    for (var byte in input.commandPayloadBytes) {
        batch.commandPayloadBytes.add(<uint>byte);
    }
    state.applyCommands(batch, 1);
    applyMovementFrames(state, input, input.tick);
    advanceState(state, input.tick, input.generation, 1);
    clearExpiredAbilityCooldowns(state);
    updateOfflinePotionCooldowns(state);
    updateOfflineLootRolls(state);
    clearStaleMovement(state, state.tick);
    stepOfflineConsecrationGroundEffects(state);
    stepOfflineEastbrookProjectiles(state);
    ageOfflineSunderArmor(state);
    ageOfflineDemoralizingRoar(state);
    ageOfflineProwl(state);
    stepRetainedPlayerTicks(state);
    stepOfflineRejuvenationHots(state);
    ageOfflineAbsorbs(state);
    stepOfflineTravelFormAutoAttack(state);
    stepOfflineDirectMeleeAutoAttack(state);
    stepOfflineHunterAutoShot(state);
    stepOfflineCasterWandAutoAttack(state);
    ageOfflineImbues(state);
    stepOfflineEmberkinRangedAttack(state);
    stepOfflineEastbrookMobIdleAggro(state);
    stepOfflineEastbrookMobWander(state);
    stepOfflineEastbrookMobLifecycle(state);
    stepOfflineEastbrookMobMeleePursuit(state);
    stepOfflineEastbrookDots(state);
    clearDeadCasting(state);
    updatePartyReadyChecks(state);
    updateCardDuelService(state);
    clearExpiredResurrectionOffers(state);
    tickResurrectionSickness(state);
    var candidate = encodeState(state);
    return binary.encodeWorldSnapshot(input, candidate, stateDigest(candidate, 1));
}

pub selfTest(): int {
    var initial = new WorldState();
    var initialBytes = encodeState(initial);
    if (initialBytes.length != 123) {
        return -1;
    }
    var decoded = decodeState(initialBytes);
    if (decoded.tick != <uint>0 || decoded.timeMicros != <uint>0 ||
        decoded.nextEntityId != <uint>408 || decoded.generation != <uint>0 ||
        decoded.rngState != <uint>1 || decoded.rngDraws != <uint>0 ||
        decoded.rngDigest != <uint>2166136261 || decoded.worldSeed != <uint>20061 ||
        decoded.offlineSessionActive || decoded.offlinePlayerName.length != 0 ||
        decoded.entityCount(true) != 0) {
        return -2;
    }
    decoded.tick = <uint>1;
    decoded.timeMicros = <uint>50000;
    var first = encodeState(decoded);
    if (first.length != 107 || stateDigest(first, 1) != stateDigest(encodeState(decodeState(first)), 1)) {
        return -3;
    }
    var restored = decodeState(first);
    if (restored.tick != <uint>1 || restored.timeMicros != <uint>50000 ||
        restored.nextEntityId != <uint>408 || restored.generation != <uint>0) {
        return -4;
    }
    decoded.tick = <uint>2;
    if (decodeState(first).tick != <uint>1) {
        return -5;
    }
    var offlineBootstrap = new OfflineBootstrap();
    offlineBootstrap.launchVersion = <uint>1;
    offlineBootstrap.worldSeed = <uint>20061;
    offlineBootstrap.playerClass = <uint>1;
    offlineBootstrap.playerName.add(<uint>86);
    offlineBootstrap.playerName.add(<uint>97);
    offlineBootstrap.playerName.add(<uint>108);
    offlineBootstrap.playerName.add(<uint>101);
    offlineBootstrap.skinVariant = <uint>2;
    var offlineState = new WorldState();
    applyOfflineBootstrap(offlineState, offlineBootstrap);
    var restoredOfflineState = decodeState(encodeState(offlineState));
    if (m8EastbrookEncounter.contractTest() != 1 || !restoredOfflineState.offlineSessionActive ||
        restoredOfflineState.offlinePlayerClass != <uint>1 ||
        restoredOfflineState.offlinePlayerSkinVariant != <uint>2 ||
        restoredOfflineState.offlinePlayerName.length != 4 ||
        <uint>restoredOfflineState.offlinePlayerName[0] != <uint>86 ||
        restoredOfflineState.entityCount(true) != 27 ||
        restoredOfflineState.entityKnownAbilityOffsets.length != 28 ||
        <uint>restoredOfflineState.entityKnownAbilityOffsets[0] != <uint>0 ||
        <uint>restoredOfflineState.entityKnownAbilityOffsets[1] == <uint>0 ||
        <uint>restoredOfflineState.entityKnownAbilityOffsets[2] !=
            <uint>restoredOfflineState.entityKnownAbilityOffsets[1] ||
        <uint>restoredOfflineState.entityKnownAbilityOffsets[3] !=
            <uint>restoredOfflineState.entityKnownAbilityOffsets[1] ||
        <uint>restoredOfflineState.entityKnownAbilityOffsets[27] !=
            <uint>restoredOfflineState.entityKnownAbilityOffsets[1] ||
        <uint>restoredOfflineState.entityKnownAbilityCodes[0] !=
            knownAbilityCatalog.classAbilityCode(1, 0) ||
        <uint>restoredOfflineState.entityTemplates[0] != <uint>2 ||
        <int>restoredOfflineState.entityLevels[0] != 1 ||
        <int>restoredOfflineState.entityHp[0] != 54 ||
        <int>restoredOfflineState.entityMaxHp[0] != 54 ||
        <int>restoredOfflineState.entityResources[0] != 195 ||
        <int>restoredOfflineState.entityMaxResources[0] != 195 ||
        restoredOfflineState.entityX[0] != 2.0 ||
        restoredOfflineState.entityY[0] != 1.5 ||
        restoredOfflineState.entityZ[0] != -2.0 ||
        restoredOfflineState.entityWeaponMinimum.length != 27 ||
        <int>restoredOfflineState.entityWeaponMinimum[0] != 3 ||
        <int>restoredOfflineState.entityWeaponMaximum[0] != 6 ||
        <float>restoredOfflineState.entityWeaponSpeed[0] != 2.9 ||
        <int>restoredOfflineState.entityAttackPower[0] != 10 ||
        <int>restoredOfflineState.entitySpellPower[0] != 13 ||
        <int>restoredOfflineState.entityArmor[0] != 57 ||
        <float>restoredOfflineState.entityCritChance[0] != 0.056 ||
        <float>restoredOfflineState.entityDodgeChance[0] != 0.056 ||
        <bool>restoredOfflineState.entityHasOffhandWeapon[0] ||
        <bool>restoredOfflineState.entityDualWielding[0] ||
        <bool>restoredOfflineState.entityInCombat[0] ||
        <float>restoredOfflineState.entityCombatTimers[0] != 99.0 ||
        <uint>restoredOfflineState.entityAggroTargetIds[0] != <uint>0 ||
        <bool>restoredOfflineState.entityLeashAnchorPresent[0] ||
        <float>restoredOfflineState.entityFleeTimers[0] != 0.0 ||
        <bool>restoredOfflineState.entityHasFled[0] ||
        <uint>restoredOfflineState.entityForcedTargetIds[0] != <uint>0 ||
        <float>restoredOfflineState.entityForcedTargetTimers[0] != 0.0 ||
        <uint>restoredOfflineState.entityKinds[1] != <uint>3 ||
        <uint>restoredOfflineState.entityTemplates[1] != <uint>4 ||
        <uint>restoredOfflineState.entityKinds[2] != <uint>3 ||
        <uint>restoredOfflineState.entityTemplates[2] != <uint>6 ||
        <bool>restoredOfflineState.entityHostile[1] ||
        <bool>restoredOfflineState.entityHostile[2] ||
        <uint>restoredOfflineState.entityKinds[3] != <uint>2 ||
        <uint>restoredOfflineState.entityTemplates[3] != <uint>1 ||
        <int>restoredOfflineState.entityLevels[3] != 1 ||
        <int>restoredOfflineState.entityHp[3] != 40 ||
        <int>restoredOfflineState.entityMaxHp[3] != 40 ||
        restoredOfflineState.entityX[3] != -11.218006452547318 ||
        restoredOfflineState.entityY[3] != -0.6134338027064364 ||
        restoredOfflineState.entityZ[3] != 64.69484230798517 ||
        restoredOfflineState.entityFacing[3] != -2.241543395702632 ||
        <int>restoredOfflineState.entityWeaponMinimum[3] != 2 ||
        <int>restoredOfflineState.entityWeaponMaximum[3] != 4 ||
        <float>restoredOfflineState.entityWeaponSpeed[3] != 2.0 ||
        <int>restoredOfflineState.entityArmor[3] != 0 ||
        <float>restoredOfflineState.entityCritChance[3] != 0.05 ||
        <float>restoredOfflineState.entityDodgeChance[3] != 0.05 ||
        <float>restoredOfflineState.entityWanderTimers[3] != 7.203461 ||
        <bool>restoredOfflineState.entityInCombat[3] ||
        <float>restoredOfflineState.entityCombatTimers[3] != 99.0 ||
        <uint>restoredOfflineState.entityAggroTargetIds[3] != <uint>0 ||
        <bool>restoredOfflineState.entityLeashAnchorPresent[3] ||
        <float>restoredOfflineState.entityFleeTimers[3] != 0.0 ||
        <bool>restoredOfflineState.entityHasFled[3] ||
        <uint>restoredOfflineState.entityForcedTargetIds[3] != <uint>0 ||
        <float>restoredOfflineState.entityForcedTargetTimers[3] != 0.0 ||
        <uint>restoredOfflineState.entityKinds[16] != <uint>2 ||
        <uint>restoredOfflineState.entityTemplates[16] != <uint>3 ||
        <int>restoredOfflineState.entityLevels[16] != 2 ||
        <int>restoredOfflineState.entityHp[16] != 54 ||
        <int>restoredOfflineState.entityMaxHp[16] != 54 ||
        restoredOfflineState.entityX[16] != 61.83887433513103 ||
        restoredOfflineState.entityY[16] != -1.9167866182571491 ||
        restoredOfflineState.entityZ[16] != 32.112278269344884 ||
        restoredOfflineState.entityFacing[16] != 3.0177380927673374 ||
        !<bool>restoredOfflineState.entityHostile[3] ||
        !<bool>restoredOfflineState.entityHostile[16]) {
        return -16;
