applySupportedCastAtCommand(
    state: WorldState,
    casterIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>20 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc castAt payload is truncated";
    }
    var abilityLength = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (abilityLength > <uint>256 || payloadLength != abilityLength + <uint>20) {
        throw "woc castAt ability payload is invalid";
    }
    var abilityOffset = payloadOffset + <uint>4;
    var isRainOfFire = rainOfFirePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength);
    var isHurricane = hurricanePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength);
    var isFlamestrike = flamestrikePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength);
    var isTemporalHourglass = temporalHourglassPayloadAbilityIsExact(
        payloadBytes, abilityOffset, abilityLength
    );
    if (!isRainOfFire && !isHurricane && !isFlamestrike && !isTemporalHourglass) {
        throw "woc castAt ability reducer is not implemented";
    }
    var castAtAbilityCode = isRainOfFire ? rainOfFireAbilityCode() :
        isHurricane ? hurricaneAbilityCode() :
        isFlamestrike ? flamestrikeAbilityCode() : temporalHourglassAbilityCode();
    if (!offlineCastSchoolLockoutAllows(state, casterIndex, castAtAbilityCode)) { return; }
    var aimOffset = abilityOffset + abilityLength;
    var aimX = binary.readF64LeAt(payloadBytes, aimOffset, <uint>8);
    var aimZ = binary.readF64LeAt(payloadBytes, aimOffset + <uint>8, <uint>8);
    if (isRainOfFire) { startOfflineRainOfFireCast(state, casterIndex, aimX, aimZ); }
    else if (isHurricane) { startOfflineHurricaneCast(state, casterIndex, aimX, aimZ); }
    else if (isFlamestrike) { startOfflineFlamestrikeCast(state, casterIndex, aimX, aimZ); }
    else { startOfflineTemporalHourglassCast(state, casterIndex, aimX, aimZ); }
}

applySupportedCastCommand(
    state: WorldState,
    casterIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>5 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc cast payload is truncated";
    }
    var abilityLength = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (abilityLength > <uint>256 || payloadLength < <uint>5 + abilityLength) {
        throw "woc cast ability identifier is invalid";
    }
    var abilityOffset = payloadOffset + <uint>4;
    var targetPresenceOffset = abilityOffset + abilityLength;
    var targetPresence = <uint>payloadBytes[<int>targetPresenceOffset];
    if (targetPresence > <uint>1 ||
        payloadLength != abilityLength + (targetPresence == <uint>1 ? <uint>13 : <uint>5)) {
        throw "woc cast target payload is invalid";
    }
    var typedAbilityCode = m4AbilityCodeFromPayload(
        payloadBytes, abilityOffset, abilityLength
    );
    if (typedAbilityCode != <uint>0 &&
        !offlineCastSchoolLockoutAllows(state, casterIndex, typedAbilityCode)) {
        return;
    }
    if (typedAbilityCode == glacialFrontAbilityCode()) {
        startOfflineGlacialFrontCast(state, casterIndex);
        return;
    }
    if (arcanePowerPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(
                state, casterIndex, arcanePowerAbilityCode()
            )) {
            startOfflineArcanePowerCast(state, casterIndex);
        }
        return;
    }
    if (perfectMomentPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(state, casterIndex, perfectMomentAbilityCode())) {
            startOfflinePerfectMomentCast(state, casterIndex);
        }
        return;
    }
    if (temporalAccelerationPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(
                state, casterIndex, temporalAccelerationAbilityCode()
            )) {
            startOfflineTemporalAccelerationCast(state, casterIndex);
        }
        return;
    }
    if (typedAbilityCode == temporalRewindAbilityCode()) {
        startOfflineTemporalRewindCast(state, casterIndex);
        return;
    }
    if (overloadPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(state, casterIndex, overloadAbilityCode())) {
            startOfflineOverloadCast(state, casterIndex);
        }
        return;
    }
    if (powerEchoPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(state, casterIndex, powerEchoAbilityCode())) {
            startOfflinePowerEchoCast(state, casterIndex);
        }
        return;
    }
    if (icyVeinsPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(state, casterIndex, icyVeinsAbilityCode())) {
            startOfflineIcyVeinsCast(state, casterIndex);
        }
        return;
    }
    if (coneOfColdPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(state, casterIndex, coneOfColdAbilityCode())) {
            startOfflineConeOfColdCast(state, casterIndex);
        }
        return;
    }
    if (coldSnapPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(state, casterIndex, coldSnapAbilityCode())) {
            startOfflineColdSnapCast(state, casterIndex);
        }
        return;
    }
    if (iceBarrierPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(state, casterIndex, iceBarrierAbilityCode())) {
            startOfflineIceBarrierCast(state, casterIndex);
        }
        return;
    }
    if (blazingBarrierPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(state, casterIndex, blazingBarrierAbilityCode())) {
            startOfflineBlazingBarrierCast(state, casterIndex);
        }
        return;
    }
    if (massBarrierPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(state, casterIndex, massBarrierAbilityCode())) {
            startOfflineMassBarrierCast(state, casterIndex);
        }
        return;
    }
    if (dragonsBreathPayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        if (offlineCastSchoolLockoutAllows(
                state, casterIndex, dragonsBreathAbilityCode()
            )) {
            startOfflineDragonsBreathCast(state, casterIndex);
        }
        return;
    }
    if (rainOfFirePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
        startOfflineRainOfFireCast(
            state,
            casterIndex,
            <float>state.entityX[casterIndex],
            <float>state.entityZ[casterIndex]
        );
        return;
    }
    if (hurricanePayloadAbilityIsExact(payloadBytes, abilityOffset, abilityLength)) {
