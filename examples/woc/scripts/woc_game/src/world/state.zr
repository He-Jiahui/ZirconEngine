        <uint>state.offlineTalentLoadoutNameBytes[4] != <uint>66 ||
        <uint>state.offlineTalentLoadoutNameBytes[8] != <uint>100 ||
        <uint>state.entityLastCommandSequence[0] != <uint>3) {
        return -4;
    }

    var filler = <uint>65;
