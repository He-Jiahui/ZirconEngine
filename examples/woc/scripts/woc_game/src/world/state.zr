        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>103 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>119 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>104;
}

regrowthTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = lesserHealFriendlyTargetIndex(state, casterIndex, targetId);
    var abilityIndex = m4AbilityCatalog.indexOf("regrowth");
    if (targetIndex < 0 || abilityIndex < 0) { return -1; }
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var rangeWithMinimum = range > 5.0 ? range : 5.0;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
