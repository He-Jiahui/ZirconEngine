// Growl shares Taunt's forced-target settlement, but the source catalog alone
// admits it in Bear form and retains its no-resource, off-GCD cast semantics.
pub growlCommandStateTest(): int {
    var growl = growlAbilityCode();
    var bear = forms.formAbilityCode("form_bear");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (growl == <uint>0 || bear == <uint>0 || forestWolf == <uint>0) { return -1; }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>8;
    var playerId = state.spawnPlayer(<uint>5, 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var rivalId = state.spawnPlayer(<uint>1, 10, 0.0, 1.5, 12.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 8.0, 100, 8.0);
    state.entityActiveFormAbilityCodes[0] = bear;
    state.entityResourceKinds[0] = formTransitions.rageResourceKind();
    state.entityResources[0] = 0;
    state.entityMaxResources[0] = 100;
    state.entityFacing[0] = 0.0;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(growl);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }
    state.setThreat(targetId, rivalId, 9.0, 1);

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (stateThreatValue(state, 2, playerId) != 9.0 ||
        <uint>state.entityForcedTargetIds[2] != playerId ||
        <float>state.entityForcedTargetTimers[2] != 3.0 ||
        <uint>state.entityAggroTargetIds[2] != playerId ||
        <float>state.entityCastGcdRemaining[0] != 0.0 ||
        abilityCooldownExpiresAt(state, 0, growl) != <uint>10000000) {
        return -2;
    }
    var restored = decodeState(encodeState(state));
    if (<uint>restored.entityActiveFormAbilityCodes[0] != bear ||
        <uint>restored.entityForcedTargetIds[2] != playerId ||
        abilityCooldownExpiresAt(restored, 0, growl) != <uint>10000000) {
        return -3;
    }
    restored.timeMicros = <uint>10000000;
    clearExpiredAbilityCooldowns(restored);
    restored.entityForcedTargetIds[2] = <uint>0;
    restored.entityForcedTargetTimers[2] = 0.0;
    restored.entityAggroTargetIds[2] = rivalId;
    restored.setThreat(targetId, rivalId, 12.0, 1);
    var growlBytes = new container.Array<uint>();
    growlBytes.add(<uint>103);
    growlBytes.add(<uint>114);
    growlBytes.add(<uint>111);
    growlBytes.add(<uint>119);
    growlBytes.add(<uint>108);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, growlBytes, targetId
    );
    restored.applyCommands(typed, 1);
    if (stateThreatValue(restored, 2, playerId) != 12.0 ||
        <uint>restored.entityForcedTargetIds[2] != playerId ||
        <float>restored.entityForcedTargetTimers[2] != 3.0 ||
        <uint>restored.entityAggroTargetIds[2] != playerId ||
        <float>restored.entityCastGcdRemaining[0] != 0.0 ||
        abilityCooldownExpiresAt(restored, 0, growl) != <uint>20000000 ||
        <uint>restored.entityLastCommandSequence[0] != <uint>2) {
        return -4;
    }
    return 1;
}

// Demoralizing Roar has no selected target: both the action slot and the typed
// command enumerate the retained hostile radius, refresh one AP-drain row per
// mob, and preserve that row through the WOS66 state envelope.
pub demoralizingRoarCommandStateTest(): int {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var roar = demoralizingRoarAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("demoralizing_roar");
    var bear = forms.formAbilityCode("form_bear");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (roar == <uint>0 || abilityIndex != 59 || bear == <uint>0 ||
        forestWolf == <uint>0 || m4AbilityCatalog.rankAtLevel(abilityIndex, 16) != 2 ||
        m4AbilityCatalog.metric(abilityIndex, 16, "cost") != 10.0 ||
        m4AbilityEffects.typeAt(abilityIndex, 2, 0) != "aoeAttackPower" ||
        !floatMatches(m4AbilityEffects.metric(abilityIndex, 2, 0, "amount"), 35.0) ||
        !floatMatches(m4AbilityEffects.metric(abilityIndex, 2, 0, "duration"), 20.0) ||
        !floatMatches(m4AbilityEffects.metric(abilityIndex, 2, 0, "radius"), 8.0)) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>8;
    var playerId = state.spawnPlayer(<uint>5, 16, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var nearId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 4.0, 100, 8.0);
    var edgeId = state.spawnMob(forestWolf, 1, 8.0, 1.5, 0.0, 100, 8.0);
    var outsideId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 8.1, 100, 8.0);
    state.entityActiveFormAbilityCodes[0] = bear;
    state.entityResourceKinds[0] = formTransitions.rageResourceKind();
    state.entityResources[0] = 10;
    state.entityMaxResources[0] = 100;
    state.entityAttackPower[1] = 100;
    state.entityAttackPower[2] = 100;
    state.entityAttackPower[3] = 100;
    state.entityKnownAbilityCodes.add(roar);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (nearId == <uint>0 || edgeId == <uint>0 || outsideId == <uint>0 ||
        <int>state.entityResources[0] != 0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        !floatMatches(<float>state.entityDemoralizingRoarRemaining[1], 20.0) ||
        !floatMatches(<float>state.entityDemoralizingRoarValues[1], 35.0) ||
        !floatMatches(<float>state.entityDemoralizingRoarRemaining[2], 20.0) ||
        !floatMatches(<float>state.entityDemoralizingRoarValues[2], 35.0) ||
        <float>state.entityDemoralizingRoarRemaining[3] != 0.0 ||
        <float>state.entityDemoralizingRoarValues[3] != 0.0 ||
        !floatMatches(effectiveOfflineAttackPower(state, 1), 65.0) ||
        !floatMatches(effectiveOfflineAttackPower(state, 2), 65.0) ||
        !floatMatches(effectiveOfflineAttackPower(state, 3), 100.0) ||
        !floatMatches(stateThreatValue(state, 1, playerId), 10.0) ||
        !floatMatches(stateThreatValue(state, 2, playerId), 10.0) ||
        !<bool>state.entityInCombat[0] || !<bool>state.entityInCombat[1] ||
        !<bool>state.entityInCombat[2]) {
        return -2;
    }

    var restored = decodeState(encodeState(state));
    if (!floatMatches(<float>restored.entityDemoralizingRoarRemaining[1], 20.0) ||
        !floatMatches(<float>restored.entityDemoralizingRoarValues[1], 35.0) ||
        !floatMatches(<float>restored.entityDemoralizingRoarRemaining[2], 20.0) ||
        !floatMatches(<float>restored.entityDemoralizingRoarValues[2], 35.0) ||
        <float>restored.entityDemoralizingRoarRemaining[3] != 0.0) {
        return -3;
    }
    restored.entityDemoralizingRoarRemaining[1] = 0.05;
    restored.entityDemoralizingRoarRemaining[2] = 0.05;
    ageOfflineDemoralizingRoar(restored);
    if (<float>restored.entityDemoralizingRoarRemaining[1] != 0.0 ||
        <float>restored.entityDemoralizingRoarValues[1] != 0.0 ||
        <float>restored.entityDemoralizingRoarRemaining[2] != 0.0 ||
        <float>restored.entityDemoralizingRoarValues[2] != 0.0 ||
        !floatMatches(effectiveOfflineAttackPower(restored, 1), 100.0)) {
        return -4;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 10;
    restored.entitySpellHaste[0] = 2.0;
    var roarBytes = new container.Array<uint>();
    roarBytes.add(<uint>100);
    roarBytes.add(<uint>101);
    roarBytes.add(<uint>109);
    roarBytes.add(<uint>111);
    roarBytes.add(<uint>114);
    roarBytes.add(<uint>97);
    roarBytes.add(<uint>108);
    roarBytes.add(<uint>105);
    roarBytes.add(<uint>122);
    roarBytes.add(<uint>105);
    roarBytes.add(<uint>110);
    roarBytes.add(<uint>103);
    roarBytes.add(<uint>95);
    roarBytes.add(<uint>114);
    roarBytes.add(<uint>111);
    roarBytes.add(<uint>97);
    roarBytes.add(<uint>114);
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(typed, playerId, <uint>1, <uint>2, roarBytes);
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 0 &&
        floatMatches(<float>restored.entityCastGcdRemaining[0], 0.75) &&
        floatMatches(<float>restored.entityDemoralizingRoarRemaining[1], 20.0) &&
        floatMatches(<float>restored.entityDemoralizingRoarValues[1], 35.0) &&
        floatMatches(effectiveOfflineAttackPower(restored, 1), 65.0) &&
        floatMatches(stateThreatValue(restored, 1, playerId), 20.0) &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -5;
}

// Prowl's source effect is a Cat-only, out-of-combat self-buff toggle. Keep
// command, movement and WOS67 round-trip coverage together because idle
// detection consumes the same persisted state before any combat starts.
pub prowlCommandStateTest(): int {
    var effects = %import("generated/m4_ability_effects");
    var prowl = prowlAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("prowl");
    var cat = forms.formAbilityCode("form_cat");
    if (prowl == <uint>0 || abilityIndex != 60 || cat == <uint>0 ||
        !prowlProfileIsValid(abilityIndex, 5) ||
        effects.text(abilityIndex, 1, 0, "kind") != "stealth") {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>8;
    var playerId = state.spawnPlayer(<uint>5, 5, 0.0, 1.5, 0.0, 100, 7.0, 1);
    state.entityActiveFormAbilityCodes[0] = cat;
    state.entityResourceKinds[0] = formTransitions.energyResourceKind();
    state.entityResources[0] = 100;
    state.entityMaxResources[0] = 100;
    state.entityKnownAbilityCodes.add(prowl);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (!offlineProwlIsActive(state, 0) ||
        !floatMatches(<float>state.entityProwlRemaining[0], 3600.0) ||
        !floatMatches(<float>state.entityProwlValues[0], 0.5) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        !floatMatches(retainedPlayerMovementSpeedMultiplier(state, 0), 0.5)) {
        return -2;
    }

    var restored = decodeState(encodeState(state));
    if (!offlineProwlIsActive(restored, 0) ||
        !floatMatches(<float>restored.entityProwlRemaining[0], 3600.0) ||
        !floatMatches(<float>restored.entityProwlValues[0], 0.5) ||
        !floatMatches(retainedPlayerMovementSpeedMultiplier(restored, 0), 0.5)) {
        return -3;
    }

    restored.entityInCombat[0] = true;
    restored.entityCastGcdRemaining[0] = 0.0;
    var prowlBytes = new container.Array<uint>();
    prowlBytes.add(<uint>112);
    prowlBytes.add(<uint>114);
    prowlBytes.add(<uint>111);
    prowlBytes.add(<uint>119);
    prowlBytes.add(<uint>108);
    var blocked = new CommandBatch();
    appendTypedCastCommandForTest(blocked, playerId, <uint>1, <uint>2, prowlBytes);
    restored.applyCommands(blocked, 1);
    if (!offlineProwlIsActive(restored, 0) ||
        <float>restored.entityCastGcdRemaining[0] != 0.0 ||
        <uint>restored.entityLastCommandSequence[0] != <uint>2) {
        return -4;
    }

    restored.entityInCombat[0] = false;
    var toggle = new CommandBatch();
    appendTypedCastCommandForTest(toggle, playerId, <uint>1, <uint>3, prowlBytes);
    restored.applyCommands(toggle, 1);
    if (offlineProwlIsActive(restored, 0) ||
        <float>restored.entityProwlRemaining[0] != 0.0 ||
        <float>restored.entityProwlValues[0] != 0.0 ||
        !floatMatches(<float>restored.entityCastGcdRemaining[0], 1.5) ||
        <uint>restored.entityLastCommandSequence[0] != <uint>3) {
        return -5;
    }

    restored.entityProwlRemaining[0] = 0.05;
    restored.entityProwlValues[0] = 0.5;
    ageOfflineProwl(restored);
    return <float>restored.entityProwlRemaining[0] == 0.0 &&
        <float>restored.entityProwlValues[0] == 0.0 ? 1 : -6;
}

