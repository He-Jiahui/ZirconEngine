    pub var entityPartyMasterLootThresholdCodes: container.Array<uint>;
    // WOS70 retains the source's server-authoritative pending Need/Greed and
    // Master Loot records. Candidate choice zero is pending; 1/2/3 are
    // Need/Greed/Pass so the native zero-based wire code remains unambiguous.
    pub var nextLootRollId: uint;
    pub var pendingLootRollIds: container.Array<uint>;
    pub var pendingLootRollMobIds: container.Array<uint>;
    pub var pendingLootRollItemCodes: container.Array<uint>;
    pub var pendingLootRollQualityCodes: container.Array<uint>;
