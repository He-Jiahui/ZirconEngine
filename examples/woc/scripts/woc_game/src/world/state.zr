appendDefaultDeedTitleColumns(state: WorldState): void {
    state.entityActiveTitleDeedCodes.add(<uint>0);
}

offlineDeedTitleStateIsValid(state: WorldState): bool {
    if (state.offlineDeedsEarned.length != deedTitleState.deedCount() ||
        state.entityActiveTitleDeedCodes.length != state.entityIds.length) {
        return false;
    }
    var primaryIndex = offlineQuestPrimaryPlayerIndex(state);
    var activeCode = state.offlineActiveTitleDeedCode;
    if (activeCode != <uint>0 &&
        (!state.offlineSessionActive || primaryIndex < 0 ||
            activeCode > <uint>deedTitleState.deedCount() ||
            !<bool>state.offlineDeedsEarned[<int>activeCode - 1] ||
            !deedTitleState.deedCodeIsTitle(activeCode))) {
        return false;
    }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var expected = entityIndex == primaryIndex ? activeCode : <uint>0;
        if (<uint>state.entityActiveTitleDeedCodes[entityIndex] != expected) {
            return false;
        }
        entityIndex = entityIndex + 1;
    }
    return true;
}

normalizeOfflineDeedTitleState(state: WorldState): void {
    var primaryIndex = offlineQuestPrimaryPlayerIndex(state);
    var activeCode = state.offlineActiveTitleDeedCode;
    if (!state.offlineSessionActive || primaryIndex < 0 ||
        activeCode == <uint>0 || activeCode > <uint>deedTitleState.deedCount() ||
        !<bool>state.offlineDeedsEarned[<int>activeCode - 1] ||
        !deedTitleState.deedCodeIsTitle(activeCode)) {
        activeCode = <uint>0;
    }
    state.offlineActiveTitleDeedCode = activeCode;
    var entityIndex = 0;
    while (entityIndex < state.entityActiveTitleDeedCodes.length) {
        state.entityActiveTitleDeedCodes[entityIndex] =
            entityIndex == primaryIndex ? activeCode : <uint>0;
        entityIndex = entityIndex + 1;
    }
}

earnOfflineDeedById(state: WorldState, deedId: string): void {
    var deedCode = deedTitleState.deedCodeForId(deedId);
    if (deedCode == <uint>0 || deedCode > <uint>state.offlineDeedsEarned.length) {
        throw "woc earned deed identity is invalid";
    }
    state.offlineDeedsEarned[<int>deedCode - 1] = true;
}

offlineM5ItemDiscoveryStateIsValid(state: WorldState): bool {
    var catalog = %import("generated/m5_content_catalog");
    return state.offlineM5ItemsDiscovered.length == catalog.count("item");
}

offlineItemDiscoveryDeedMet(state: WorldState, deedIndex: int): bool {
    var triggerKind = deedTitleContract.itemDiscoveryTriggerKind(deedIndex);
    if (triggerKind == 0) { return false; }
    var catalog = %import("generated/m5_content_catalog");
    if (triggerKind == 1 || triggerKind == 2) {
        var discoveredCount = 0;
        var itemIndex = 0;
        while (itemIndex < catalog.count("item")) {
            if (<bool>state.offlineM5ItemsDiscovered[itemIndex] &&
                (triggerKind == 1 ||
                    catalog.text("item", itemIndex, "quality") == "poor")) {
                discoveredCount = discoveredCount + 1;
            }
            itemIndex = itemIndex + 1;
        }
        return discoveredCount >= deedTitleContract.itemDiscoveryTriggerAmount(deedIndex);
    }
    if (triggerKind == 3) {
        var requiredQuality = deedTitleContract.itemDiscoveryTriggerValue(deedIndex, 0);
        var qualityItemIndex = 0;
        while (qualityItemIndex < catalog.count("item")) {
            if (<bool>state.offlineM5ItemsDiscovered[qualityItemIndex] &&
                catalog.text("item", qualityItemIndex, "quality") == requiredQuality) {
                return true;
            }
            qualityItemIndex = qualityItemIndex + 1;
        }
        return false;
    }
    if (triggerKind == 4) {
        var valueIndex = 0;
        while (valueIndex < deedTitleContract.itemDiscoveryTriggerValueCount(deedIndex)) {
            var requiredItemIndex = catalog.indexOf(
                "item", deedTitleContract.itemDiscoveryTriggerValue(deedIndex, valueIndex)
            );
            if (requiredItemIndex < 0 ||
                !<bool>state.offlineM5ItemsDiscovered[requiredItemIndex]) {
                return false;
            }
            valueIndex = valueIndex + 1;
        }
        return true;
    }
    throw "woc item-discovery deed trigger is unknown";
}

evaluateOfflineItemDiscoveryDeeds(state: WorldState): void {
    if (!offlineM5ItemDiscoveryStateIsValid(state) ||
        state.offlineDeedsEarned.length != deedTitleContract.deedCount()) {
        throw "woc item-discovery deed state is invalid";
    }
    var deedIndex = 0;
    while (deedIndex < deedTitleContract.deedCount()) {
        if (!<bool>state.offlineDeedsEarned[deedIndex] &&
            offlineItemDiscoveryDeedMet(state, deedIndex)) {
            state.offlineDeedsEarned[deedIndex] = true;
        }
        deedIndex = deedIndex + 1;
    }
}

markOfflineM5ItemDiscovered(
    state: WorldState, entityIndex: int, itemCode: uint
): void {
    if (entityIndex != offlineQuestPrimaryPlayerIndex(state)) { return; }
    if (!offlineM5ItemDiscoveryStateIsValid(state) ||
        !m5InventoryRules.itemCodeIsValid(itemCode)) {
        throw "woc M5 item discovery mutation is invalid";
    }
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    if (<bool>state.offlineM5ItemsDiscovered[itemIndex]) { return; }
    state.offlineM5ItemsDiscovered[itemIndex] = true;
    evaluateOfflineItemDiscoveryDeeds(state);
}

seedOfflineM5ItemDiscoveryFromHoldings(state: WorldState): void {
    if (!offlineM5ItemDiscoveryStateIsValid(state)) {
        throw "woc M5 item discovery state is invalid";
    }
    var entityIndex = offlineQuestPrimaryPlayerIndex(state);
    if (entityIndex < 0) { return; }
    var helmetCode = <uint>state.entityM5HelmetItemCodes[entityIndex];
    var feetCode = <uint>state.entityM5FeetItemCodes[entityIndex];
    var mainhandCode = <uint>state.entityM5MainhandItemCodes[entityIndex];
    if (helmetCode != <uint>0) {
        markOfflineM5ItemDiscovered(state, entityIndex, helmetCode);
    }
    if (feetCode != <uint>0) {
        markOfflineM5ItemDiscovered(state, entityIndex, feetCode);
    }
    if (mainhandCode != <uint>0) {
        markOfflineM5ItemDiscovered(state, entityIndex, mainhandCode);
    }
    var socket = 0;
    while (socket < m5InventoryRules.bagSockets()) {
        var bagCode = <uint>state.entityInventoryBagCodes[
            m5InventoryBagCodeIndex(entityIndex, socket)
        ];
        if (bagCode != <uint>0) {
            markOfflineM5ItemDiscovered(state, entityIndex, bagCode);
        }
        socket = socket + 1;
    }
    var inventoryIndex = <int><uint>state.entityInventoryStackOffsets[entityIndex];
    var inventoryEnd = <int><uint>state.entityInventoryStackOffsets[entityIndex + 1];
    while (inventoryIndex < inventoryEnd) {
        markOfflineM5ItemDiscovered(
            state, entityIndex, <uint>state.entityInventoryStackItemCodes[inventoryIndex]
        );
        inventoryIndex = inventoryIndex + 1;
    }
    var buybackIndex = <int><uint>state.entityVendorBuybackOffsets[entityIndex];
    var buybackEnd = <int><uint>state.entityVendorBuybackOffsets[entityIndex + 1];
    while (buybackIndex < buybackEnd) {
        markOfflineM5ItemDiscovered(
            state, entityIndex, <uint>state.entityVendorBuybackItemCodes[buybackIndex]
        );
        buybackIndex = buybackIndex + 1;
    }
}

offlineTownFocusStateIsValid(state: WorldState): bool {
    return townFocusWireState.storedAllocationValid(offlineTownFocusAllocation(state));
}

