moonfireAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("moonfire");
    var abilityIndex = m4AbilityCatalog.indexOf("moonfire");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "moonfire") {
        throw "Moonfire is absent from the current ability catalog";
    }
    return code;
}

moonfirePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>8 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>101;
}

moonfireRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 4; }
    if (rank == <uint>2) { return 10; }
    if (rank == <uint>3) { return 16; }
    return 0;
}

moonfireProjectileProfileIsValid(
    rankCode: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("moonfire");
    var level = moonfireRankLevel(rankCode);
    if (abilityIndex < 0 || level <= 0 ||
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) != <int>rankCode ||
        m4AbilityEffects.typeAt(abilityIndex, <int>rankCode, 0) != "directDamage" ||
        m4AbilityEffects.typeAt(abilityIndex, <int>rankCode, 1) != "dot") {
        return false;
    }
    return minimum == m4AbilityEffects.metric(abilityIndex, <int>rankCode, 0, "min") &&
        maximum == m4AbilityEffects.metric(abilityIndex, <int>rankCode, 0, "max") &&
        castTime == 0.0;
}

moonfireDotProfileIsValid(damage: int, duration: float, interval: float): bool {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("moonfire");
    var rank = 1;
    while (rank <= 3) {
        var level = moonfireRankLevel(<uint>rank);
        if (abilityIndex >= 0 && level > 0 &&
            m4AbilityCatalog.rankAtLevel(abilityIndex, level) == rank &&
            m4AbilityEffects.typeAt(abilityIndex, rank, 1) == "dot") {
            var expectedDuration = m4AbilityEffects.metric(abilityIndex, rank, 1, "duration");
            var expectedInterval = m4AbilityEffects.metric(abilityIndex, rank, 1, "interval");
            var expectedDamage = <int>(m4AbilityEffects.metric(
                abilityIndex, rank, 1, "total"
            ) / (expectedDuration / expectedInterval) + 0.5);
            if (expectedDamage < 1) { expectedDamage = 1; }
            if (damage == expectedDamage && duration == expectedDuration &&
                interval == expectedInterval) {
                return true;
            }
        }
        rank = rank + 1;
    }
    return false;
}

moonfireTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("moonfire");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

moonfireGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 1.0 ? 1.0 : gcd;
}

startOfflineMoonfireCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = moonfireAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("moonfire");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 1) != "dot" ||
        <float>state.entityResources[casterIndex] < cost ||
        moonfireTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = moonfireGlobalCooldownSeconds(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        m4AbilityEffects.metric(abilityIndex, rank, 0, "min"),
        m4AbilityEffects.metric(abilityIndex, rank, 0, "max"),
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_ARCANE,
        abilityCode,
        <uint>rank,
        0.0
    );
}

