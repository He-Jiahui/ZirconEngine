        <uint>restored.offlineDotSourceIds[0] != playerId ||
        <uint>restored.offlineDotAbilityCodes[0] != fireball ||
        <int>restored.offlineDotDamages[0] != 1 ||
        !floatMatches(<float>restored.offlineDotRemaining[0], 4.0) ||
        !floatMatches(<float>restored.offlineDotDurations[0], 4.0) ||
        !floatMatches(<float>restored.offlineDotTickIntervals[0], 2.0) ||
        !floatMatches(<float>restored.offlineDotTickTimers[0], 2.0) ||
        stateThreatValue(restored, 1, playerId) <= 0.0) {
        return -6;
    }

    var hpAfterImpact = <int>restored.entityHp[1];
    var dotTicks = 0;
    while (restored.offlineDotTargetIds.length > 0 && dotTicks < 80) {
        stepOfflineEastbrookDots(restored);
        dotTicks = dotTicks + 1;
    }
    if (restored.offlineDotTargetIds.length != 0 || dotTicks != 80 ||
        <int>restored.entityHp[1] != hpAfterImpact - 2 ||
        <uint>restored.rngDraws != <uint>3) {
        return -7;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 30;
    var fireballBytes = new container.Array<uint>();
    fireballBytes.add(<uint>102);
    fireballBytes.add(<uint>105);
    fireballBytes.add(<uint>114);
    fireballBytes.add(<uint>101);
    fireballBytes.add(<uint>98);
    fireballBytes.add(<uint>97);
    fireballBytes.add(<uint>108);
    fireballBytes.add(<uint>108);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, fireballBytes, targetId
    );
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 30 &&
        <uint>restored.entityCastingAbility[0] == fireball &&
        <uint>restored.entityCastTargetIds[0] == targetId &&
        floatMatches(<float>restored.entityCastRemaining[0], 1.5) &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -8;
}

