    if (playerId == <uint>0 || targetId == <uint>0 ||
        <float>state.entityResources[0] != 0 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != <uint>0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileSourceIds[0] != playerId ||
        <uint>state.offlineProjectileTargetIds[0] != targetId ||
        <bool>state.offlineProjectileWands[0] ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
        <float>state.offlineProjectileMinimums[0] != 9.0 ||
        <float>state.offlineProjectileMaximums[0] != 12.0 ||
        <float>state.offlineProjectileSpeeds[0] != projectileTravel.projectileSpeed() ||
        <uint>state.offlineProjectileAbilityCodes[0] != moonfire ||
        <uint>state.offlineProjectileRanks[0] != <uint>1 ||
        <float>state.offlineProjectileCastTimes[0] != 0.0 ||
        state.offlineDotTargetIds.length != 0) {
        return -3;
    }

    var restored = decodeState(encodeState(state));
    if (<uint>restored.rngDraws != <uint>0 ||
        restored.offlineProjectileSourceIds.length != 1 ||
        <uint>restored.offlineProjectileAbilityCodes[0] != moonfire ||
        <uint>restored.offlineProjectileRanks[0] != <uint>1 ||
        <float>restored.offlineProjectileCastTimes[0] != 0.0 ||
        restored.offlineDotTargetIds.length != 0) {
        return -4;
    }

    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>3 || <int>restored.entityHp[1] >= 100 ||
        restored.offlineDotTargetIds.length != 1 ||
        <uint>restored.offlineDotTargetIds[0] != targetId ||
        <uint>restored.offlineDotSourceIds[0] != playerId ||
        <uint>restored.offlineDotAbilityCodes[0] != moonfire ||
        <int>restored.offlineDotDamages[0] != 4 ||
        !floatMatches(<float>restored.offlineDotRemaining[0], 9.0) ||
        !floatMatches(<float>restored.offlineDotDurations[0], 9.0) ||
        !floatMatches(<float>restored.offlineDotTickIntervals[0], 3.0) ||
        !floatMatches(<float>restored.offlineDotTickTimers[0], 3.0) ||
        stateThreatValue(restored, 1, playerId) <= 0.0) {
        return -5;
    }

    var hpAfterImpact = <int>restored.entityHp[1];
    var dotTicks = 0;
    while (restored.offlineDotTargetIds.length > 0 && dotTicks < 180) {
        stepOfflineEastbrookDots(restored);
        dotTicks = dotTicks + 1;
    }
    if (restored.offlineDotTargetIds.length != 0 || dotTicks != 180 ||
        <int>restored.entityHp[1] != hpAfterImpact - 12 ||
        <uint>restored.rngDraws != <uint>3) {
        return -6;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 25;
    var moonfireBytes = new container.Array<uint>();
    moonfireBytes.add(<uint>109);
    moonfireBytes.add(<uint>111);
    moonfireBytes.add(<uint>111);
    moonfireBytes.add(<uint>110);
    moonfireBytes.add(<uint>102);
    moonfireBytes.add(<uint>105);
    moonfireBytes.add(<uint>114);
    moonfireBytes.add(<uint>101);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, moonfireBytes, targetId
    );
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 0 &&
        <uint>restored.entityCastingAbility[0] == <uint>0 &&
        !floatMatches(<float>restored.entityCastGcdRemaining[0], 0.0) &&
        restored.offlineProjectileSourceIds.length == 1 &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -7;
}

// WOS84 keeps source instant DoTs in the projectile lifecycle: admission pays
// cost/GCD, impact rolls resistance once, then a pure periodic row owns damage.
pub instantDotCommandStateTest(): int {
    if (numericEffects.contractTest() != 1) { return -1; }
    var serpent = serpentStingAbilityCode();
    var shadowPain = shadowWordPainAbilityCode();
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (serpent == <uint>0 || shadowPain == <uint>0 || forestWolf == <uint>0 ||
        m4AbilityCatalog.indexOf("serpent_sting") != 23 ||
        m4AbilityCatalog.indexOf("shadow_word_pain") != 24) {
        return -2;
    }

    var serpentState = new WorldState();
    serpentState.offlineSessionActive = true;
    serpentState.offlinePlayerClass = <uint>4;
    var hunterId = serpentState.spawnPlayer(<uint>4, 4, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var serpentTargetId = serpentState.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 1000, 8.0);
    serpentState.entityPresentationScales[1] = 0.9;
    serpentState.entityWeaponSpeed[1] = 2.0;
    serpentState.entityResources[0] = 15;
    serpentState.entityMaxResources[0] = 15;
    serpentState.entityRangedPower[0] = 300;
    serpentState.entityHitBonus[0] = 1.0;
    serpentState.entityTargetIds[0] = serpentTargetId;
    serpentState.entityKnownAbilityCodes.add(serpent);
    var knownOffset = 1;
    while (knownOffset < serpentState.entityKnownAbilityOffsets.length) {
        serpentState.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }
    var serpentSlot = new CommandBatch();
    appendCastSlotCommand(serpentSlot, hunterId, <uint>1, <uint>1, <uint>0);
    serpentState.applyCommands(serpentSlot, 1);
    if (<int>serpentState.entityResources[0] != 0 ||
        !floatMatches(<float>serpentState.entityCastGcdRemaining[0], 1.5) ||
        serpentState.offlineProjectileSourceIds.length != 1 ||
        <uint>serpentState.offlineProjectileAbilityCodes[0] != serpent ||
        <uint>serpentState.offlineProjectileRanks[0] != <uint>1 ||
        <uint>serpentState.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
        <float>serpentState.offlineProjectileMinimums[0] != 0.0 ||
        <float>serpentState.offlineProjectileMaximums[0] != 0.0 ||
        serpentState.offlineDotTargetIds.length != 0 || <uint>serpentState.rngDraws != <uint>0) {
        return -3;
    }

    var restoredSerpent = decodeState(encodeState(serpentState));
    if (restoredSerpent.offlineProjectileSourceIds.length != 1 ||
        <uint>restoredSerpent.offlineProjectileAbilityCodes[0] != serpent ||
        restoredSerpent.offlineDotRanks.length != 0) {
        return -4;
    }
    var serpentFlightTicks = 0;
    while (restoredSerpent.offlineProjectileSourceIds.length > 0 && serpentFlightTicks < 8) {
        stepOfflineEastbrookProjectiles(restoredSerpent);
        serpentFlightTicks = serpentFlightTicks + 1;
    }
    if (restoredSerpent.offlineProjectileSourceIds.length != 0 || serpentFlightTicks > 8 ||
        <uint>restoredSerpent.rngDraws != <uint>1 || <int>restoredSerpent.entityHp[1] != 1000 ||
        restoredSerpent.offlineDotTargetIds.length != 1 ||
        <uint>restoredSerpent.offlineDotAbilityCodes[0] != serpent ||
        <uint>restoredSerpent.offlineDotRanks[0] != <uint>1 ||
        <int>restoredSerpent.offlineDotSnapshotPowers[0] != 300 ||
        <int>restoredSerpent.offlineDotDamages[0] != 13 ||
        !floatMatches(<float>restoredSerpent.offlineDotDurations[0], 15.0) ||
        !floatMatches(<float>restoredSerpent.offlineDotTickIntervals[0], 3.0)) {
        return -5;
    }
    var serpentTicks = 0;
    while (restoredSerpent.offlineDotTargetIds.length > 0 && serpentTicks < 300) {
        stepOfflineEastbrookDots(restoredSerpent);
        serpentTicks = serpentTicks + 1;
    }
    if (restoredSerpent.offlineDotTargetIds.length != 0 || serpentTicks != 300 ||
        <int>restoredSerpent.entityHp[1] != 935 || <uint>restoredSerpent.rngDraws != <uint>1) {
        return -6;
    }

    restoredSerpent.entityCastGcdRemaining[0] = 0.0;
    restoredSerpent.entityResources[0] = 15;
    var serpentBytes = new container.Array<uint>();
    serpentBytes.add(<uint>115); serpentBytes.add(<uint>101); serpentBytes.add(<uint>114);
    serpentBytes.add(<uint>112); serpentBytes.add(<uint>101); serpentBytes.add(<uint>110);
    serpentBytes.add(<uint>116); serpentBytes.add(<uint>95); serpentBytes.add(<uint>115);
    serpentBytes.add(<uint>116); serpentBytes.add(<uint>105); serpentBytes.add(<uint>110);
    serpentBytes.add(<uint>103);
    var serpentTyped = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        serpentTyped, hunterId, <uint>1, <uint>2, serpentBytes, serpentTargetId
    );
    restoredSerpent.applyCommands(serpentTyped, 1);
    if (<int>restoredSerpent.entityResources[0] != 0 ||
        restoredSerpent.offlineProjectileSourceIds.length != 1 ||
        <uint>restoredSerpent.entityLastCommandSequence[0] != <uint>2) {
        return -7;
    }
    restoredSerpent.entityCastGcdRemaining[0] = 0.0;
    restoredSerpent.entityResources[0] = 15;
    restoredSerpent.entityZ[1] = 4.0;
    startOfflineSerpentStingCast(restoredSerpent, 0, serpentTargetId);
    if (<int>restoredSerpent.entityResources[0] != 15 ||
        restoredSerpent.offlineProjectileSourceIds.length != 1) {
        return -8;
    }
    restoredSerpent.entitySpellHaste[0] = 2.0;
    if (!floatMatches(pureDotGlobalCooldownSeconds(restoredSerpent, 0), 0.75)) { return -9; }

    var shadowState = new WorldState();
    shadowState.offlineSessionActive = true;
    shadowState.offlinePlayerClass = <uint>5;
    var priestId = shadowState.spawnPlayer(<uint>5, 4, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var shadowTargetId = shadowState.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 1000, 8.0);
    shadowState.entityPresentationScales[1] = 0.9;
    shadowState.entityWeaponSpeed[1] = 2.0;
    shadowState.entityResources[0] = 25;
    shadowState.entityMaxResources[0] = 25;
    shadowState.entitySpellPower[0] = 150;
    shadowState.entityHitBonus[0] = 1.0;
    shadowState.entityTargetIds[0] = shadowTargetId;
    shadowState.entityKnownAbilityCodes.add(shadowPain);
    knownOffset = 1;
    while (knownOffset < shadowState.entityKnownAbilityOffsets.length) {
        shadowState.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }
    var shadowSlot = new CommandBatch();
    appendCastSlotCommand(shadowSlot, priestId, <uint>1, <uint>1, <uint>0);
    shadowState.applyCommands(shadowSlot, 1);
    if (<int>shadowState.entityResources[0] != 0 ||
        !floatMatches(<float>shadowState.entityCastGcdRemaining[0], 1.5) ||
        shadowState.offlineProjectileSourceIds.length != 1 ||
        <uint>shadowState.offlineProjectileAbilityCodes[0] != shadowPain ||
        <uint>shadowState.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_SHADOW) {
        return -10;
    }
    var shadowFlightTicks = 0;
    while (shadowState.offlineProjectileSourceIds.length > 0 && shadowFlightTicks < 8) {
        stepOfflineEastbrookProjectiles(shadowState);
        shadowFlightTicks = shadowFlightTicks + 1;
    }
    if (shadowState.offlineProjectileSourceIds.length != 0 || shadowFlightTicks > 8 ||
        <uint>shadowState.rngDraws != <uint>1 || <int>shadowState.entityHp[1] != 1000 ||
        shadowState.offlineDotTargetIds.length != 1 ||
        <uint>shadowState.offlineDotAbilityCodes[0] != shadowPain ||
        <uint>shadowState.offlineDotRanks[0] != <uint>1 ||
        <int>shadowState.offlineDotSnapshotPowers[0] != 150 ||
        <int>shadowState.offlineDotDamages[0] != 35 ||
        !floatMatches(<float>shadowState.offlineDotDurations[0], 18.0) ||
        !floatMatches(<float>shadowState.offlineDotTickIntervals[0], 3.0)) {
        return -11;
    }
    var shadowTicks = 0;
    while (shadowState.offlineDotTargetIds.length > 0 && shadowTicks < 360) {
        stepOfflineEastbrookDots(shadowState);
        shadowTicks = shadowTicks + 1;
    }
    return shadowState.offlineDotTargetIds.length == 0 && shadowTicks == 360 &&
        <int>shadowState.entityHp[1] == 790 && <uint>shadowState.rngDraws == <uint>1 ? 1 : -12;
}

pub lesserHealCommandStateTest(): int {
    if (numericEffects.contractTest() != 1 || healState.contractTest() != 1) { return -1; }
    var lesserHeal = lesserHealAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("lesser_heal");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (lesserHeal == <uint>0 || abilityIndex != 6 || forestWolf == <uint>0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "lesser_heal") {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>6;
    var casterId = state.spawnPlayer(<uint>6, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnPlayer(<uint>6, 1, 0.0, 1.5, 10.0, 100, 7.0, 1);
    var mobId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 12.0, 100, 8.0);
    state.entityHp[1] = 40;
    state.entityResources[0] = 30;
    state.entityMaxResources[0] = 30;
    state.entityCritChance[0] = 0.0;
    state.entityTargetIds[0] = targetId;
    state.entityInCombat[2] = true;
    state.setThreat(mobId, targetId, 10.0, 1);
    state.entityKnownAbilityCodes.add(lesserHeal);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, casterId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (casterId == <uint>0 || targetId == <uint>0 || mobId == <uint>0 ||
        <float>state.entityResources[0] != 30 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != lesserHeal ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 2.0) ||
        !floatMatches(<float>state.entityCastTotal[0], 2.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5)) {
        return -3;
    }

    var restored = decodeState(encodeState(state));
    restored.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(restored, 0, false);
    if (<int>restored.entityResources[0] != 0 || <uint>restored.rngDraws != <uint>2 ||
        <uint>restored.entityCastingAbility[0] != <uint>0 ||
        <uint>restored.entityCastTargetIds[0] != <uint>0 ||
        <int>restored.entityHp[1] <= 40 || <int>restored.entityHp[1] >= 100 ||
        stateThreatValue(restored, 2, casterId) <= 0.0 ||
        stateThreatValue(restored, 2, targetId) != 10.0) {
        return -4;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 30;
    var lesserHealBytes = new container.Array<uint>();
    lesserHealBytes.add(<uint>108);
    lesserHealBytes.add(<uint>101);
    lesserHealBytes.add(<uint>115);
    lesserHealBytes.add(<uint>115);
    lesserHealBytes.add(<uint>101);
    lesserHealBytes.add(<uint>114);
    lesserHealBytes.add(<uint>95);
    lesserHealBytes.add(<uint>104);
    lesserHealBytes.add(<uint>101);
    lesserHealBytes.add(<uint>97);
    lesserHealBytes.add(<uint>108);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, casterId, <uint>1, <uint>2, lesserHealBytes, targetId
    );
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 30 &&
        <uint>restored.entityCastingAbility[0] == lesserHeal &&
        <uint>restored.entityCastTargetIds[0] == targetId &&
        floatMatches(<float>restored.entityCastRemaining[0], 2.0) &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -5;
}

pub queuedOnSwingTerminalStateTest(): int {
    var heroic = <uint>knownAbilityCatalog.abilityCode("heroic_strike");
    if (heroic == <uint>0) { return -1; }
    var state = new WorldState();
    state.spawnPlayer(<uint>1, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);

    state.entityAutoAttack[0] = true;
    state.entityQueuedOnSwingAbilityCodes[0] = heroic;
    state.entityQueuedOnSwingFree[0] = true;
    state.entityQueuedOnSwingCostMultipliers[0] = 0.5;
    applyOfflineMobMeleePlayerDeath(state, 0);
    if (!<bool>state.entityDead[0] || <bool>state.entityAutoAttack[0] ||
        <uint>state.entityQueuedOnSwingAbilityCodes[0] != <uint>0 ||
        <bool>state.entityQueuedOnSwingFree[0] ||
        <float>state.entityQueuedOnSwingCostMultipliers[0] != 1.0) {
        return -2;
    }

    // Revive enters the same source terminal posture, so stale queue columns
    // cannot survive a response or corpse resurrection transition.
    state.entityQueuedOnSwingAbilityCodes[0] = heroic;
    state.entityQueuedOnSwingFree[0] = true;
    state.entityQueuedOnSwingCostMultipliers[0] = 0.5;
    reviveOfflinePlayerAt(state, 0, 2.0, 3.0, 0.5);
    if (<bool>state.entityDead[0] || <uint>state.entityQueuedOnSwingAbilityCodes[0] !=
        <uint>0 || <bool>state.entityQueuedOnSwingFree[0] ||
        <float>state.entityQueuedOnSwingCostMultipliers[0] != 1.0) {
        return -3;
    }

    // The global death sweep repairs a terminal row regardless of which retained
    // damage path produced it.
    state.entityQueuedOnSwingAbilityCodes[0] = heroic;
    state.entityQueuedOnSwingFree[0] = true;
    state.entityQueuedOnSwingCostMultipliers[0] = 0.5;
    state.entityDead[0] = true;
    clearDeadCasting(state);
    if (<uint>state.entityQueuedOnSwingAbilityCodes[0] != <uint>0 ||
        <bool>state.entityQueuedOnSwingFree[0] ||
        <float>state.entityQueuedOnSwingCostMultipliers[0] != 1.0) {
        return -4;
    }
    return 1;
}

appendBooleanCommand(
    batch: CommandBatch,
    commandId: uint,
    actorId: uint,
    generation: uint,
    sequence: uint,
    value: bool
): void {
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(commandId);
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>1);
    batch.commandPayloadBytes.add(value ? <uint>1 : <uint>0);
}

appendDungeonDifficultyCommand(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    difficulty: uint
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.setDungeonDifficultyCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>1);
    batch.commandPayloadBytes.add(difficulty);
}

appendTestOfflineTalentLoadout(
    state: WorldState,
    nameByte: uint,
    specCode: uint,
    row5Code: uint,
    row8Code: uint,
    row11Code: uint,
    row14Code: uint,
    row17Code: uint,
    row20Code: uint
): void {
    state.offlineTalentLoadoutNameBytes.add(nameByte);
    state.offlineTalentLoadoutNameOffsets.add(
        <uint>state.offlineTalentLoadoutNameBytes.length
    );
    state.offlineTalentLoadoutSpecCodes.add(specCode);
    state.offlineTalentLoadoutRowOptionCodes.add(row5Code);
    state.offlineTalentLoadoutRowOptionCodes.add(row8Code);
    state.offlineTalentLoadoutRowOptionCodes.add(row11Code);
    state.offlineTalentLoadoutRowOptionCodes.add(row14Code);
    state.offlineTalentLoadoutRowOptionCodes.add(row17Code);
    state.offlineTalentLoadoutRowOptionCodes.add(row20Code);
    var barIndex = 0;
    while (barIndex < talentLoadoutContract.barSlots(true)) {
        state.offlineTalentLoadoutActionBarAbilityCodes.add(<uint>0);
        barIndex = barIndex + 1;
    }
}

appendEmptyCommand(
    batch: CommandBatch,
    commandId: uint,
    actorId: uint,
    generation: uint,
    sequence: uint
): void {
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(commandId);
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>0);
}

appendPartyTargetCommand(
    batch: CommandBatch,
    commandId: uint,
    actorId: uint,
    generation: uint,
    sequence: uint,
    targetId: uint
): void {
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(commandId);
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>8);
    batch.commandPayloadBytes.add(targetId & <uint>255);
    batch.commandPayloadBytes.add((targetId >> 8) & <uint>255);
    batch.commandPayloadBytes.add((targetId >> 16) & <uint>255);
    batch.commandPayloadBytes.add((targetId >> 24) & <uint>255);
    batch.commandPayloadBytes.add((targetId >> 32) & <uint>255);
    batch.commandPayloadBytes.add((targetId >> 40) & <uint>255);
    batch.commandPayloadBytes.add((targetId >> 48) & <uint>255);
    batch.commandPayloadBytes.add((targetId >> 56) & <uint>255);
}

appendExactSmallIntegerF64ForTest(
    bytes: container.Array<uint>, value: uint
): void {
    if (value > <uint>4) { throw "woc party marker f64 test value is unsupported"; }
    bytes.add(<uint>0); bytes.add(<uint>0); bytes.add(<uint>0); bytes.add(<uint>0);
    bytes.add(<uint>0); bytes.add(<uint>0);
    if (value == <uint>0) {
        bytes.add(<uint>0); bytes.add(<uint>0);
    } else if (value == <uint>1) {
        bytes.add(<uint>240); bytes.add(<uint>63);
    } else if (value == <uint>2) {
        bytes.add(<uint>0); bytes.add(<uint>64);
    } else if (value == <uint>3) {
        bytes.add(<uint>8); bytes.add(<uint>64);
    } else {
        bytes.add(<uint>16); bytes.add(<uint>64);
    }
}

appendPartyMarkerCommandForTest(
    batch: CommandBatch,
    setMarker: bool,
    actorId: uint,
    generation: uint,
    sequence: uint,
    entityId: uint,
    markerId: uint
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(setMarker ? payloads.partySetMarkerCommandId(true) :
        payloads.partyClearMarkerCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(setMarker ? <uint>16 : <uint>8);
    appendExactSmallIntegerF64ForTest(batch.commandPayloadBytes, entityId);
    if (setMarker) {
        appendExactSmallIntegerF64ForTest(batch.commandPayloadBytes, markerId);
    }
}

appendPartyMasterLootCommandForTest(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    enabled: bool,
    looterId: uint,
    threshold: uint
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.partySetLootMasterCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>10);
    batch.commandPayloadBytes.add(enabled ? <uint>1 : <uint>0);
    appendExactSmallIntegerF64ForTest(batch.commandPayloadBytes, looterId);
    batch.commandPayloadBytes.add(threshold);
}

appendLootRollCommandForTest(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    rollId: uint,
    wireChoice: uint
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.lootRollCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>9);
    appendExactSmallIntegerF64ForTest(batch.commandPayloadBytes, rollId);
    batch.commandPayloadBytes.add(wireChoice);
}

appendMasterLootAssignmentCommandForTest(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    rollId: uint,
    targetIds: container.Array<uint>
): void {
    if (targetIds.length > 10) {
        throw "woc test master loot assignment has too many targets";
    }
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.masterAssignCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>9 + <uint>targetIds.length * <uint>8);
    appendExactSmallIntegerF64ForTest(batch.commandPayloadBytes, rollId);
    batch.commandPayloadBytes.add(<uint>targetIds.length);
    for (var targetId in targetIds) {
        appendExactSmallIntegerF64ForTest(batch.commandPayloadBytes, <uint>targetId);
    }
}

appendPartyMoveRaidCommand(
    batch: CommandBatch,
    commandId: uint,
    actorId: uint,
    generation: uint,
    sequence: uint,
    targetId: uint,
    group: uint
): void {
    appendPartyTargetCommand(batch, commandId, actorId, generation, sequence, targetId);
    batch.commandPayloadLengths[batch.commandPayloadLengths.length - 1] = <uint>9;
    batch.commandPayloadBytes.add(group);
}

appendTalentAllocationCommand(
    batch: CommandBatch,
    commandId: uint,
    actorId: uint,
    generation: uint,
    sequence: uint,
    specCode: uint,
    row5Code: uint,
    row8Code: uint,
    row11Code: uint,
    row14Code: uint,
    row17Code: uint,
    row20Code: uint
): void {
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(commandId);
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(<uint>14);
    batch.commandPayloadBytes.add(specCode & <uint>255);
    batch.commandPayloadBytes.add((specCode >> 8) & <uint>255);
    batch.commandPayloadBytes.add(row5Code & <uint>255);
    batch.commandPayloadBytes.add((row5Code >> 8) & <uint>255);
    batch.commandPayloadBytes.add(row8Code & <uint>255);
    batch.commandPayloadBytes.add((row8Code >> 8) & <uint>255);
    batch.commandPayloadBytes.add(row11Code & <uint>255);
    batch.commandPayloadBytes.add((row11Code >> 8) & <uint>255);
    batch.commandPayloadBytes.add(row14Code & <uint>255);
    batch.commandPayloadBytes.add((row14Code >> 8) & <uint>255);
    batch.commandPayloadBytes.add(row17Code & <uint>255);
    batch.commandPayloadBytes.add((row17Code >> 8) & <uint>255);
    batch.commandPayloadBytes.add(row20Code & <uint>255);
    batch.commandPayloadBytes.add((row20Code >> 8) & <uint>255);
}

offlineQuestInventoryStateTest(): int {
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    if (knownAbilityPartitionContains(state, 0, <uint>191)) { // overpower is level 2
        return -10;
    }
    // A later owner may attach a non-player catalog code. Level refresh must
    // rebuild only the offline player partition and retain this sentinel row.
    state.entityKnownAbilityCodes.add(<uint>143);
    state.entityKnownAbilityOffsets[2] = <uint>state.entityKnownAbilityCodes.length;
    state.entityKnownAbilityOffsets[3] = <uint>state.entityKnownAbilityCodes.length;
    state.entityX[0] = 4.0;
    state.entityZ[0] = 6.0;
    var playerId = <uint>state.entityIds[0];
    var payloads = %import("protocol/command_payloads");
    var accept = new CommandBatch();
    appendQuestCommand(
        accept, payloads.acceptQuestCommandId(true), playerId, <uint>1, <uint>1, 1
    );
    state.applyCommands(accept, 1);
    if (state.offlineQuestWolvesState != <uint>1 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -1;
    }
    var kill = 0;
    while (kill < 8) {
        if (!creditOfflineQuestWolfKill(state, 0)) {
            return -2;
        }
        kill = kill + 1;
    }
    if (state.offlineQuestWolvesState != <uint>2 ||
        state.offlineQuestWolvesObjectiveCount != <uint>8) {
        return -3;
    }
    var turnIn = new CommandBatch();
    appendQuestCommand(
        turnIn, payloads.turnInQuestCommandId(true), playerId, <uint>1, <uint>2, 1
    );
    state.applyCommands(turnIn, 1);
    if (state.offlineQuestWolvesState != <uint>3 ||
        state.offlineQuestCopper != <uint>75 ||
        state.offlineQuestExperience != <uint>250 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -4;
    }
    state.entityX[0] = -7.0;
    state.entityZ[0] = 3.0;
    var acceptBoars = new CommandBatch();
    appendQuestCommand(
        acceptBoars, payloads.acceptQuestCommandId(true), playerId, <uint>1, <uint>3, 2
    );
    state.applyCommands(acceptBoars, 1);
    if (state.offlineQuestBoarsState != <uint>1) {
        return -5;
    }
    var boarHideCode = m5InventoryItemCodeForId("boar_hide");
    var hide = 0;
    while (hide < 5) {
        if (!m5InventoryCanAddItem(state, 0, boarHideCode, 1)) {
            return -6;
        }
        grantM5InventoryItem(state, 0, boarHideCode, 1);
        hide = hide + 1;
    }
    if (state.offlineQuestBoarsState != <uint>2 ||
        state.offlineQuestBoarsObjectiveCount != <uint>5 ||
        state.offlineQuestBoarHideCount != <uint>5 ||
        m5InventoryItemCount(state, 0, boarHideCode) != 5) {
        return -7;
    }
    if (removeM5InventoryItem(state, 0, boarHideCode, 1) != 1 ||
        state.offlineQuestBoarsState != <uint>1 ||
        state.offlineQuestBoarsObjectiveCount != <uint>4 ||
        !m5InventoryCanAddItem(state, 0, boarHideCode, 1)) {
        return -8;
    }
    grantM5InventoryItem(state, 0, boarHideCode, 1);
    if (state.offlineQuestBoarsState != <uint>2 ||
        state.offlineQuestBoarHideCount != <uint>5) {
        return -9;
    }
    var turnInBoars = new CommandBatch();
    appendQuestCommand(
        turnInBoars, payloads.turnInQuestCommandId(true), playerId, <uint>1, <uint>4, 2
    );
    state.applyCommands(turnInBoars, 1);
    if (state.offlineQuestBoarsState != <uint>3 ||
        state.offlineQuestBoarHideCount != <uint>0 ||
        m5InventoryItemCount(state, 0, boarHideCode) != 0 ||
        state.offlineQuestCopper != <uint>195 ||
        state.offlineQuestExperience != <uint>200 ||
        <int>state.entityLevels[0] != 2 ||
        !knownAbilityPartitionContains(state, 0, <uint>191) ||
        !knownAbilityPartitionContains(state, 1, <uint>143) ||
        <uint>state.entityLastCommandSequence[0] != <uint>4) {
        return -10;
    }
    var restored = decodeState(encodeState(state));
    if (restored.offlineQuestWolvesState != <uint>3 ||
        restored.offlineQuestBoarsState != <uint>3 ||
        restored.offlineQuestCopper != <uint>195 ||
        restored.offlineQuestExperience != <uint>200 ||
        restored.offlineQuestLifetimeExperience != <uint>600) {
        return -11;
    }
    return 1;
}

offlineQuestNpcMigrationTest(): int {
    var legacy = new WorldState();
    legacy.worldSeed = <uint>20061;
    legacy.offlineSessionActive = true;
    legacy.offlinePlayerClass = <uint>0;
    legacy.offlinePlayerSkinVariant = <uint>0;
    legacy.offlinePlayerName.add(<uint>86);
    legacy.offlinePlayerName.add(<uint>97);
    legacy.offlinePlayerName.add(<uint>108);
    legacy.offlinePlayerName.add(<uint>101);
    legacy.spawnPlayer(<uint>1, 1, 2.0, 1.5, -2.0, 90, 7.0, 1);
    var current = encodeState(legacy);
    // This fixture starts with one entity, zero threats, default WOS8 cast
    // state, empty WOS9/WOS10 partitions, default WOS12/WOS13/WOS14 tails and
    // an empty WOS15 resource/target/cooldown row. Remove every later entity
    // tail to construct a real WOS6 payload instead of relabeling newer bytes.
    var wos8CastRowBytes = 117;
    var wos9KnownCountBytes = 2;
    var wos10TalentAllocationBytes = 14;
    var wos12OfferRowBytes = 53;
    var wos13SpiritRowBytes = 37;
    var wos14PartyRowBytes = 36;
    var wos15AbilityRuntimeRowBytes = 28;
    var postWos6EntityTailBytes = wos8CastRowBytes + wos15AbilityRuntimeRowBytes +
        wos9KnownCountBytes + wos10TalentAllocationBytes + wos12OfferRowBytes +
        wos13SpiritRowBytes + wos14PartyRowBytes;
    if (current.length <= 100 + postWos6EntityTailBytes) {
        return -1;
    }
    var wos6 = new container.Array<uint>();
    var index = 0;
    while (index < 64) {
        if (index == 4) {
            wos6.add(<uint>6);
        } else if (index == 5) {
            wos6.add(<uint>0);
        } else {
            wos6.add(<uint>current[index]);
        }
        index = index + 1;
    }
    index = 100;
    while (index < current.length - postWos6EntityTailBytes) {
        wos6.add(<uint>current[index]);
        index = index + 1;
    }
    var migrated = decodeState(wos6);
    if (migrated.entityCount(true) != 3 || migrated.nextEntityId != <uint>411 ||
        <uint>migrated.entityKinds[0] != <uint>1 ||
        <uint>migrated.entityTemplates[0] != <uint>1 ||
        <uint>migrated.entityKinds[1] != <uint>3 ||
        <uint>migrated.entityTemplates[1] != <uint>4 ||
        <uint>migrated.entityKinds[2] != <uint>3 ||
        <uint>migrated.entityTemplates[2] != <uint>6) {
        return -2;
    }
    var reencoded = encodeState(migrated);
    if (<uint>reencoded[4] != <uint>17 || <uint>reencoded[5] != <uint>0 ||
        decodeState(reencoded).entityCount(true) != 3) {
        return -3;
    }
    return 1;
}

offlineTalentAllocationStateTest(): int {
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    state.entityLevels[0] = 8;
    var armsCode = talentSelectionCatalog.specCode("warrior", "arms");
    var dieByTheSwordCode = talentSelectionCatalog.optionCode(
        "warrior", 8, "war_row_die_by_the_sword"
    );
    if (armsCode == <uint>0 || dieByTheSwordCode == <uint>0 ||
        !replaceOfflineTalentAllocation(
            state, 0, armsCode, <uint>0, dieByTheSwordCode, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || <uint>state.entityTalentSpecCodes[0] != armsCode ||
        talentRowCodeAt(state, 0, 1) != dieByTheSwordCode ||
        !knownAbilityPartitionContains(state, 0, <uint>188) ||
        !knownAbilityPartitionContains(state, 0, <uint>82)) {
        return -1;
    }
    if (replaceOfflineTalentAllocation(
            state, 0, armsCode, <uint>19, dieByTheSwordCode, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || <uint>state.entityTalentSpecCodes[0] != armsCode ||
        talentRowCodeAt(state, 0, 0) != <uint>0 ||
        talentRowCodeAt(state, 0, 1) != dieByTheSwordCode) {
        return -2;
    }
    var restored = decodeState(encodeState(state));
    if (<uint>restored.entityTalentSpecCodes[0] != armsCode ||
        talentRowCodeAt(restored, 0, 1) != dieByTheSwordCode ||
        !knownAbilityPartitionContains(restored, 0, <uint>188) ||
        !knownAbilityPartitionContains(restored, 0, <uint>82)) {
        return -3;
    }
    return 1;
}

pub offlineTalentRowCommandStateTest(): int {
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
