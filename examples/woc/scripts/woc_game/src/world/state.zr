// Source Feral Charge is off-GCD and form-usable. It still completes ordinary
// admission and cooldown bookkeeping before the Cat/Bear-specific branch.
startOfflineFeralChargeCast(state: WorldState, casterIndex: int): void {
    var abilityCode = feralChargeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("feral_charge");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state,
            casterIndex,
            abilityCode,
            forms.formKindForAbilityCode(
                <uint>state.entityActiveFormAbilityCodes[casterIndex]
            ),
            false
        )) { return; }
    var level = <int>state.entityLevels[casterIndex];
    if (!feralChargeProfileIsValid(abilityIndex, level)) { return; }
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
    var activeForm = forms.formKindForAbilityCode(
        <uint>state.entityActiveFormAbilityCodes[casterIndex]
    );
    if (activeForm == "form_cat") {
        state.entityFeralInstinctEnergyRemaining[casterIndex] =
            feralChargeState.feralInstinctDuration();
    } else if (activeForm == "form_bear" &&
        <uint>state.entityResourceKinds[casterIndex] == formTransitions.rageResourceKind()) {
        state.entityResources[casterIndex] = feralChargeState.addCappedResource(
            <float>state.entityResources[casterIndex],
            <float>state.entityMaxResources[casterIndex],
            feralChargeState.bearRageGrant()
        );
    }
}

ripAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("rip");
    var abilityIndex = m4AbilityCatalog.indexOf("rip");
    if (code == <uint>0 || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "rip") {
        throw "Rip is absent from the current ability catalog";
    }
    return code;
}

ripPayloadAbilityIsExact(bytes: container.Array<uint>, offset: uint, length: uint): bool {
    return length == <uint>3 && <uint>bytes[<int>offset] == <uint>114 &&
        <uint>bytes[<int>(offset + <uint>1)] == <uint>105 &&
        <uint>bytes[<int>(offset + <uint>2)] == <uint>112;
}

ripProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 && level >= 14 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == 1 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 30.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 0.0 &&
        m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        m4AbilityCatalog.flag(abilityIndex, "spendsCombo") &&
        m4AbilityCatalog.text(abilityIndex, "requiresForm") == "cat" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "physical" &&
        effects.typeAt(abilityIndex, 1, 0) == "dot" &&
        effects.metric(abilityIndex, 1, 0, "total") == 60.0 &&
        effects.metric(abilityIndex, 1, 0, "duration") == 12.0 &&
        effects.metric(abilityIndex, 1, 0, "interval") == 2.0;
}

demonSkinRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 1; }
    if (rank == <uint>2) { return 12; }
    if (rank == <uint>3) { return 20; }
    return 0;
}

demonSkinProfileIsValid(rank: uint): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("demon_skin");
    var level = demonSkinRankLevel(rank);
    return abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rank &&
        effects.typeAt(abilityIndex, <int>rank, 0) == "selfBuff" &&
        effects.text(abilityIndex, <int>rank, 0, "kind") == "buff_armor" &&
        effects.metric(abilityIndex, <int>rank, 0, "duration") == 1800.0;
}

retainedArmorAuraProfileIsValid(abilityCode: uint, remaining: float, value: float): bool {
    if (abilityCode == demonSkinAbilityCode()) {
        return remaining > 0.0 && remaining <= 1800.0 &&
            (value == 30.0 || value == 55.0 || value == 80.0);
    }
    if (abilityCode == barkskinAbilityCode()) {
        return remaining > 0.0 && remaining <= 15.0 && value == 150.0;
    }
    return abilityCode == frostArmorAbilityCode() && remaining > 0.0 &&
        remaining <= 1800.0 && (value == 30.0 || value == 50.0 || value == 70.0);
}

retainedArmorAuraBonus(state: WorldState, index: int): float {
    var kind = ccContract.motionAuraKindCode("buff_armor");
    var start = <int><uint>state.entityMotionAuraOffsets[index];
    var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
    var bonus = 0.0;
    while (start < end) {
        if (<uint>state.entityMotionAuraKindCodes[start] == kind &&
            <uint>state.entityMotionAuraSourceIds[start] == <uint>state.entityIds[index] &&
            <float>state.entityMotionAuraRemaining[start] > 0.0) {
            var value = <float>state.entityMotionAuraValues[start];
            if (!retainedArmorAuraProfileIsValid(
                    <uint>state.entityMotionAuraAbilityCodes[start],
                    <float>state.entityMotionAuraRemaining[start], value
                )) {
                throw "woc retained armor aura profile is invalid";
            }
            bonus = bonus + value;
        }
        start = start + 1;
    }
    return bonus;
}

retainedDodgeAuraProfileIsValid(abilityCode: uint, remaining: float, value: float): bool {
    if (abilityCode == primalReflexesAbilityCode()) {
        return remaining > 0.0 && remaining <= 6.0 && value == 0.5;
    }
    if (abilityCode == evasionAbilityCode()) {
        return remaining > 0.0 && remaining <= 15.0 && value == 0.5;
    }
    if (abilityCode == deterrenceAbilityCode()) {
        return remaining > 0.0 && remaining <= 10.0 && value == 0.25;
    }
    return abilityCode == aspectOfTheMonkeyAbilityCode() && remaining > 0.0 &&
        remaining <= 1800.0 && value == 0.08;
}

retainedDodgeAuraBonus(state: WorldState, index: int): float {
    var kind = ccContract.motionAuraKindCode("buff_dodge");
    var start = <int><uint>state.entityMotionAuraOffsets[index];
    var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
    var bonus = 0.0;
    while (start < end) {
        if (<uint>state.entityMotionAuraKindCodes[start] == kind &&
            <uint>state.entityMotionAuraSourceIds[start] == <uint>state.entityIds[index] &&
            <float>state.entityMotionAuraRemaining[start] > 0.0) {
            var value = <float>state.entityMotionAuraValues[start];
            var abilityCode = <uint>state.entityMotionAuraAbilityCodes[start];
            if (!retainedDodgeAuraProfileIsValid(
                    abilityCode, <float>state.entityMotionAuraRemaining[start], value
                )) {
                throw "woc retained dodge aura profile is invalid";
            }
            bonus = bonus + value;
        }
        start = start + 1;
    }
    return bonus;
}

retainedDamageReductionAuraProfileIsValid(
    abilityCode: uint,
    remaining: float,
    value: float
): bool {
    return abilityCode == deterrenceAbilityCode() && remaining > 0.0 &&
        remaining <= 10.0 && value == 0.3;
}

retainedDamageReductionAuraBonus(state: WorldState, index: int): float {
    var kind = ccContract.motionAuraKindCode("buff_dr");
    var start = <int><uint>state.entityMotionAuraOffsets[index];
    var end = <int><uint>state.entityMotionAuraOffsets[index + 1];
    var reduction = 0.0;
    while (start < end) {
        if (<uint>state.entityMotionAuraKindCodes[start] == kind &&
            <uint>state.entityMotionAuraSourceIds[start] == <uint>state.entityIds[index] &&
            <float>state.entityMotionAuraRemaining[start] > 0.0) {
            var value = <float>state.entityMotionAuraValues[start];
            if (!retainedDamageReductionAuraProfileIsValid(
                    <uint>state.entityMotionAuraAbilityCodes[start],
                    <float>state.entityMotionAuraRemaining[start],
                    value
                )) {
                throw "woc retained damage-reduction aura profile is invalid";
            }
            reduction = reduction + value;
        }
        start = start + 1;
    }
    return reduction;
}

// Mirrors the source target-side `buff_dr` sum and Math.round application.
// The caller selects external damage paths; self-originated effects do not
// enter this helper in the retained one-player combat projection.
applyOfflineRetainedDamageReduction(
    state: WorldState,
    targetIndex: int,
    damage: int
): int {
    if (damage <= 0 || targetIndex < 0 || targetIndex >= state.entityIds.length) {
        return damage;
    }
    var multiplier = 1.0 - retainedDamageReductionAuraBonus(state, targetIndex);
    if (multiplier < 0.0) { multiplier = 0.0; }
    return terrainGradient.javascriptRound(<float>damage * multiplier, true);
}

startOfflineDemonSkinCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = demonSkinAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("demon_skin");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) || <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = <uint>m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!demonSkinProfileIsValid(rank) || <float>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = ghostWolfGlobalCooldownSeconds(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    applyOfflineMotionAuraWithDetails(state, casterIndex, abilityCode,
        <uint>state.entityIds[casterIndex], ccContract.motionAuraKindCode("buff_armor"),
        effects.metric(abilityIndex, <int>rank, 0, "duration"),
        effects.metric(abilityIndex, <int>rank, 0, "value"), 0.0);
}

// Barkskin follows the source's off-GCD path: it remains form-usable but still
// rejects a caster with an active cast, then applies a short self armor aura.
startOfflineBarkskinCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = barkskinAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("barkskin");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state,
            casterIndex,
            abilityCode,
            forms.formKindForAbilityCode(
                <uint>state.entityActiveFormAbilityCodes[casterIndex]
            ),
            false
        )) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!barkskinProfileIsValid(abilityIndex, level) ||
        !m4AbilityCatalog.flag(abilityIndex, "offGcd") ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
    applyOfflineMotionAuraWithDetails(
        state,
        casterIndex,
        abilityCode,
        <uint>state.entityIds[casterIndex],
        ccContract.motionAuraKindCode("buff_armor"),
        effects.metric(abilityIndex, 1, 0, "duration"),
        effects.metric(abilityIndex, 1, 0, "value"),
        0.0
    );
}

startOfflinePrimalReflexesCast(state: WorldState, casterIndex: int): void {
