startOfflineBerserkerRageCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = berserkerRageAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("berserker_rage");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <uint>state.entityResourceKinds[casterIndex] != formTransitions.rageResourceKind() ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    if (!berserkerRageProfileIsValid(abilityIndex, level)) { return; }
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    var amount = gainResourceTalentScaling.resolveGainResourceAmount(
        <int>effects.metric(abilityIndex, 1, 0, "amount"),
        offlineTalentModifiersForEntity(state, casterIndex),
        m4AbilityCatalog.text(abilityIndex, "school"),
        m4AbilityCatalog.text(abilityIndex, "id")
    );
    offlineCappedResourceGain(state, casterIndex, <float>amount);
    setAbilityCooldownExpiration(
        state,
        casterIndex,
        abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
}

