// Feral Charge is a source off-GCD form ability. Its Cat timer is durable and
// contributes to resource recovery before the same fixed tick ages it.
pub feralChargeResourceRegenRuntimeStateTest(): int {
    if (feralChargeState.contractTest() != 1) { return -1; }
    var feralCharge = feralChargeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("feral_charge");
    var cat = forms.formAbilityCode("form_cat");
    var bear = forms.formAbilityCode("form_bear");
    if (feralCharge == <uint>0 || abilityIndex != 94 || cat == <uint>0 ||
        bear == <uint>0 || !feralChargeProfileIsValid(abilityIndex, 10)) {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>8;
    var playerId = state.spawnPlayer(<uint>5, 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    state.entityActiveFormAbilityCodes[0] = cat;
    state.entityResourceKinds[0] = formTransitions.energyResourceKind();
    state.entityResources[0] = 0;
    state.entityMaxResources[0] = 100;
    state.entityKnownAbilityCodes.add(feralCharge);
    var offset = 1;
    while (offset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    if (playerId == <uint>0 || !knownAbilityPartitionContains(state, 0, feralCharge)) {
        return -3;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (!floatMatches(<float>state.entityFeralInstinctEnergyRemaining[0], 10.0) ||
        <float>state.entityResources[0] != 0 || <uint>state.rngDraws != <uint>0 ||
        <float>state.entityCastGcdRemaining[0] != 0.0 ||
        abilityCooldownExpiresAt(state, 0, feralCharge) != <uint>90000000 ||
        !feralInstinctStateIsValid(state) || feralInstinctStateIsSchema111Compatible(state)) {
        return -4;
    }

    state.tick = <uint>40;
    stepRetainedPlayerTicks(state);
    if (<float>state.entityResources[0] != 40 ||
        !floatMatches(<float>state.entityFeralInstinctEnergyRemaining[0], 9.95)) {
        return -5;
    }
    var restored = decodeState(encodeState(state));
    if (!floatMatches(<float>restored.entityFeralInstinctEnergyRemaining[0], 9.95) ||
        !feralInstinctStateIsValid(restored)) {
        return -6;
    }

    // A positive final-tick timer still doubles that resource tick, then ages
    // to zero. The first later eligible tick sees the ordinary 20 Energy rate.
    restored.entityResources[0] = 0;
    restored.entityFeralInstinctEnergyRemaining[0] = 0.05;
    restored.tick = <uint>80;
    stepRetainedPlayerTicks(restored);
    if (<int>restored.entityResources[0] != 40 ||
        <float>restored.entityFeralInstinctEnergyRemaining[0] != 0.0) {
        return -7;
    }
    restored.entityResources[0] = 0;
    restored.tick = <uint>120;
    stepRetainedPlayerTicks(restored);
    if (<int>restored.entityResources[0] != 20 || <uint>restored.rngDraws != <uint>0) {
        return -8;
    }

    restored.timeMicros = abilityCooldownExpiresAt(restored, 0, feralCharge);
    restored.entityCastGcdRemaining[0] = 0.75;
    var feralChargeBytes = new container.Array<uint>();
    feralChargeBytes.add(<uint>102); feralChargeBytes.add(<uint>101);
    feralChargeBytes.add(<uint>114); feralChargeBytes.add(<uint>97);
    feralChargeBytes.add(<uint>108); feralChargeBytes.add(<uint>95);
    feralChargeBytes.add(<uint>99); feralChargeBytes.add(<uint>104);
    feralChargeBytes.add(<uint>97); feralChargeBytes.add(<uint>114);
    feralChargeBytes.add(<uint>103); feralChargeBytes.add(<uint>101);
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(typed, playerId, <uint>1, <uint>2, feralChargeBytes);
    restored.applyCommands(typed, 1);
    if (!floatMatches(<float>restored.entityFeralInstinctEnergyRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entityCastGcdRemaining[0], 0.75) ||
        <uint>restored.entityLastCommandSequence[0] != <uint>2) {
        return -9;
    }

    restored.timeMicros = abilityCooldownExpiresAt(restored, 0, feralCharge);
    restored.entityActiveFormAbilityCodes[0] = bear;
    restored.entityResourceKinds[0] = formTransitions.rageResourceKind();
    restored.entityResources[0] = 60;
    restored.entityMaxResources[0] = 100;
    restored.entityFeralInstinctEnergyRemaining[0] = 0.0;
    startOfflineFeralChargeCast(restored, 0);
    if (<int>restored.entityResources[0] != 100 ||
        <float>restored.entityFeralInstinctEnergyRemaining[0] != 0.0) {
        return -10;
    }

    var legacy = decodeState(encodeStateVersion(restored, <uint>111));
    if (<float>legacy.entityFeralInstinctEnergyRemaining[0] != 0.0 ||
        !feralInstinctStateIsSchema111Compatible(legacy)) {
        return -11;
    }
    legacy.timeMicros = abilityCooldownExpiresAt(legacy, 0, feralCharge);
    legacy.entityActiveFormAbilityCodes[0] = <uint>0;
    legacy.entityResourceKinds[0] = formTransitions.manaResourceKind();
    legacy.entityResources[0] = 25;
    legacy.entityMaxResources[0] = 100;
    startOfflineFeralChargeCast(legacy, 0);
    return <int>legacy.entityResources[0] == 25 &&
        <float>legacy.entityFeralInstinctEnergyRemaining[0] == 0.0 &&
        <uint>legacy.rngDraws == <uint>0 ? 1 : -12;
}

