appendM5DiscardCommand(
    batch: CommandBatch, commandId: uint, actorId: uint, generation: uint, sequence: uint,
    itemIndex: int, count: int
): void {
    var catalog = %import("generated/m5_content_catalog");
    var itemLength = catalog.itemIdUtf8Length(itemIndex);
    if (itemLength < 1 || itemLength > 256) {
        throw "woc M5 discard test item is invalid";
    }
    appendM5CommandHeader(
        batch, commandId, actorId, generation, sequence,
        <uint>(itemLength + (count < 0 ? 5 : 9))
    );
    appendM5VendorItemId(batch, itemIndex);
    if (count < 0) {
        batch.commandPayloadBytes.add(<uint>0);
        return;
    }
    batch.commandPayloadBytes.add(<uint>1);
    var requested = <uint>count;
    batch.commandPayloadBytes.add(requested & <uint>255);
    batch.commandPayloadBytes.add((requested >> 8) & <uint>255);
    batch.commandPayloadBytes.add((requested >> 16) & <uint>255);
    batch.commandPayloadBytes.add((requested >> 24) & <uint>255);
}

appendQuestCommand(
    batch: CommandBatch,
    commandId: uint,
    actorId: uint,
    generation: uint,
    sequence: uint,
    questCode: int
): void {
    var questLength: uint = questCode == 1 ? <uint>8 : <uint>7;
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(commandId);
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(questLength + <uint>4);
    batch.commandPayloadBytes.add(questLength & <uint>255);
    batch.commandPayloadBytes.add((questLength >> 8) & <uint>255);
    batch.commandPayloadBytes.add((questLength >> 16) & <uint>255);
    batch.commandPayloadBytes.add((questLength >> 24) & <uint>255);
    if (questCode == 1) {
        batch.commandPayloadBytes.add(<uint>113); // q
        batch.commandPayloadBytes.add(<uint>95);  // _
        batch.commandPayloadBytes.add(<uint>119); // w
        batch.commandPayloadBytes.add(<uint>111); // o
        batch.commandPayloadBytes.add(<uint>108); // l
        batch.commandPayloadBytes.add(<uint>118); // v
        batch.commandPayloadBytes.add(<uint>101); // e
        batch.commandPayloadBytes.add(<uint>115); // s
    } else {
        batch.commandPayloadBytes.add(<uint>113); // q
        batch.commandPayloadBytes.add(<uint>95);  // _
        batch.commandPayloadBytes.add(<uint>98);  // b
        batch.commandPayloadBytes.add(<uint>111); // o
        batch.commandPayloadBytes.add(<uint>97);  // a
        batch.commandPayloadBytes.add(<uint>114); // r
        batch.commandPayloadBytes.add(<uint>115); // s
    }
}

