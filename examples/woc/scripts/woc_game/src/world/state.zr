appendRawDelveBuyCommandForTest(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    shopBytes: container.Array<uint>,
    itemBytes: container.Array<uint>,
    trailingPayload: bool
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.delveBuyCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    batch.commandPayloadLengths.add(
        <uint>(shopBytes.length + itemBytes.length + 8 + (trailingPayload ? 1 : 0))
    );
    var shopLength = <uint>shopBytes.length;
    batch.commandPayloadBytes.add(shopLength & <uint>255);
    batch.commandPayloadBytes.add((shopLength >> 8) & <uint>255);
    batch.commandPayloadBytes.add((shopLength >> 16) & <uint>255);
    batch.commandPayloadBytes.add((shopLength >> 24) & <uint>255);
    for (var shopByte in shopBytes) {
        batch.commandPayloadBytes.add(<uint>shopByte);
    }
    var itemLength = <uint>itemBytes.length;
    batch.commandPayloadBytes.add(itemLength & <uint>255);
    batch.commandPayloadBytes.add((itemLength >> 8) & <uint>255);
    batch.commandPayloadBytes.add((itemLength >> 16) & <uint>255);
    batch.commandPayloadBytes.add((itemLength >> 24) & <uint>255);
    for (var itemByte in itemBytes) {
        batch.commandPayloadBytes.add(<uint>itemByte);
    }
    if (trailingPayload) batch.commandPayloadBytes.add(<uint>0);
}

