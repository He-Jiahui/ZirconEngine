pub stormstrikeCommandStateTest(): int {
    var stormstrike = stormstrikeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("stormstrike");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (stormstrike == <uint>0 || abilityIndex != 40 || forestWolf == <uint>0) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>6;
    var playerId = state.spawnPlayer(<uint>6, 20, 0.0, 1.5, 4.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 0.0, 200, 8.0);
    state.entityResources[0] = 40;
    state.entityMaxResources[0] = 40;
    state.entityWeaponMinimum[0] = 10;
    state.entityWeaponMaximum[0] = 10;
    state.entityWeaponSpeed[0] = 2.0;
    state.entityAttackPower[0] = 0;
    state.entityCritChance[0] = 0.0;
    state.entityHitBonus[0] = 1.0;
    state.entityArmor[1] = 0;
    state.entityFacing[0] = 3.141592653589793;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(stormstrike);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    startOfflineStormstrikeCast(state, 0, targetId);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <float>state.entityResources[0] != 0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, stormstrike) != <uint>12000000 ||
        <int>state.entityHp[1] >= 200 || <uint>state.rngDraws == <uint>0 ||
        <uint>state.entityAiStates[1] != mobLifecycle.chaseAiState() ||
        <uint>state.entityAggroTargetIds[1] != playerId ||
        stateThreatValue(state, 1, playerId) <= 0.0) {
        return -2;
    }
    var hpAfterDirect = <int>state.entityHp[1];
    var restored = decodeState(encodeState(state));
    if (abilityCooldownExpiresAt(restored, 0, stormstrike) != <uint>12000000 ||
        <int>restored.entityHp[1] != hpAfterDirect ||
        <int>restored.entityResources[0] != 0) {
        return -3;
    }
    restored.timeMicros = <uint>12000000;
    clearExpiredAbilityCooldowns(restored);
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 40;
    var bytes = new container.Array<uint>();
    bytes.add(<uint>115);
    bytes.add(<uint>116);
    bytes.add(<uint>111);
    bytes.add(<uint>114);
    bytes.add(<uint>109);
    bytes.add(<uint>115);
    bytes.add(<uint>116);
    bytes.add(<uint>114);
    bytes.add(<uint>105);
    bytes.add(<uint>107);
    bytes.add(<uint>101);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>1, bytes, targetId
    );
    restored.applyCommands(typed, 1);
    if (<int>restored.entityResources[0] != 0 ||
        !floatMatches(<float>restored.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(restored, 0, stormstrike) != <uint>24000000 ||
        <int>restored.entityHp[1] >= hpAfterDirect ||
        <uint>restored.entityLastCommandSequence[0] != <uint>1) {
        return -4;
    }
    var blocked = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        blocked, playerId, <uint>1, <uint>2, bytes, targetId
    );
    restored.applyCommands(blocked, 1);
    return <int>restored.entityResources[0] == 0 &&
        abilityCooldownExpiresAt(restored, 0, stormstrike) == <uint>24000000 &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -5;
}

pub frostboltCommandStateTest(): int {
    if (timedSpell.contractTest() != 1 || spellResist.contractTest() != 1) { return -1; }
    var frostbolt = frostboltAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (frostbolt == <uint>0 || abilityIndex != 2 || forestWolf == <uint>0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "frostbolt") {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>1;
    var playerId = state.spawnPlayer(<uint>1, 4, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 100, 8.0);
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 25;
    state.entityMaxResources[0] = 25;
    state.entitySpellHaste[0] = 0.5;
    state.entityCritChance[0] = 0.0;
    state.entityHitBonus[0] = 1.0;
    state.entityKnownAbilityCodes.add(frostbolt);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <float>state.entityResources[0] != 25 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != frostbolt ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 1.0) ||
        !floatMatches(<float>state.entityCastTotal[0], 1.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.0)) {
        return -3;
    }

    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<float>state.entityResources[0] != 0 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != <uint>0 ||
        <uint>state.entityCastTargetIds[0] != <uint>0 ||
        <int>state.entityHp[1] != 100 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileSourceIds[0] != playerId ||
        <uint>state.offlineProjectileTargetIds[0] != targetId ||
        <bool>state.offlineProjectileWands[0] ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_FROST ||
        <float>state.offlineProjectileMinimums[0] != 18.0 ||
        <float>state.offlineProjectileMaximums[0] != 20.0 ||
        <float>state.offlineProjectileSpeeds[0] != projectileTravel.projectileSpeed() ||
        <uint>state.offlineProjectileAbilityCodes[0] != frostbolt ||
        <uint>state.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>state.offlineProjectileCastTimes[0], 1.5) ||
        <uint>state.entityMotionAuraOffsets[2] != <uint>0) {
        return -4;
    }

    var restored = decodeState(encodeState(state));
    if (<int>restored.entityHp[1] != 100 || <uint>restored.rngDraws != <uint>0 ||
        restored.offlineProjectileSourceIds.length != 1 ||
        <uint>restored.offlineProjectileAbilityCodes[0] != frostbolt ||
        <uint>restored.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>restored.offlineProjectileCastTimes[0], 1.5)) {
        return -5;
    }

    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>3 || <int>restored.entityHp[1] >= 100 ||
        <uint>restored.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>restored.entityMotionAuraAbilityCodes[0] != frostbolt ||
        <uint>restored.entityMotionAuraSourceIds[0] != playerId ||
        <uint>restored.entityMotionAuraKindCodes[0] !=
            ccContract.motionAuraKindCode("slow") ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 5.0) ||
        stateThreatValue(restored, 1, playerId) <= 0.0) {
        return -6;
    }

    restored.entityAiStates[1] = mobLifecycle.chaseAiState();
    restored.entityAggroTargetIds[1] = playerId;
    restored.entityInCombat[1] = true;
    var zBeforeSlowPursuit = <float>restored.entityZ[1];
    stepOfflineEastbrookMobMeleePursuit(restored);
    if (!floatMatches(<float>restored.entityZ[1], zBeforeSlowPursuit - 0.24) ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 4.95)) {
        return -7;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 25;
    var frostboltBytes = new container.Array<uint>();
    frostboltBytes.add(<uint>102);
    frostboltBytes.add(<uint>114);
    frostboltBytes.add(<uint>111);
    frostboltBytes.add(<uint>115);
    frostboltBytes.add(<uint>116);
    frostboltBytes.add(<uint>98);
    frostboltBytes.add(<uint>111);
    frostboltBytes.add(<uint>108);
    frostboltBytes.add(<uint>116);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, frostboltBytes, targetId
    );
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 25 &&
        <uint>restored.entityCastingAbility[0] == frostbolt &&
        <uint>restored.entityCastTargetIds[0] == targetId &&
        floatMatches(<float>restored.entityCastRemaining[0], 1.0) &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -8;
}

// Smite has no persistent aura row: its pending WOS56 projectile must survive
// a WOS65 round trip and then spend resist, range and critical draws on impact.
pub smiteCommandStateTest(): int {
    if (timedSpell.contractTest() != 1 || spellResist.contractTest() != 1) { return -1; }
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var smite = smiteAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("smite");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (smite == <uint>0 || abilityIndex != 27 || forestWolf == <uint>0 ||
        m4AbilityCatalog.text(abilityIndex, "class") != "priest" ||
        m4AbilityEffects.typeAt(abilityIndex, 1, 0) != "directDamage") {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>5;
    var playerId = state.spawnPlayer(<uint>5, 8, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 1000, 8.0);
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 32;
    state.entityMaxResources[0] = 32;
    state.entitySpellPower[0] = 100;
    state.entityCritChance[0] = 0.0;
    state.entityHitBonus[0] = 1.0;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(smite);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <float>state.entityResources[0] != 32 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != smite ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 2.0) ||
        !floatMatches(<float>state.entityCastTotal[0], 2.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5)) {
        return -3;
    }

    var restored = decodeState(encodeState(state));
    restored.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(restored, 0, false);
