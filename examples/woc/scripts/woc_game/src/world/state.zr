    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <int>state.entityResources[0] != 75 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != corruption ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 2.0) ||
        !floatMatches(<float>state.entityCastTotal[0], 2.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        state.offlineProjectileSourceIds.length != 0 || state.offlineDotTargetIds.length != 0) {
        return -3;
    }

    var restored = decodeState(encodeState(state));
    restored.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(restored, 0, false);
    if (<int>restored.entityResources[0] != 0 || <uint>restored.rngDraws != <uint>0 ||
        <uint>restored.entityCastingAbility[0] != <uint>0 ||
        <uint>restored.entityCastTargetIds[0] != <uint>0 ||
        restored.offlineProjectileSourceIds.length != 1 ||
        <uint>restored.offlineProjectileSourceIds[0] != playerId ||
        <uint>restored.offlineProjectileTargetIds[0] != targetId ||
        <uint>restored.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
        <float>restored.offlineProjectileMinimums[0] != 0.0 ||
        <float>restored.offlineProjectileMaximums[0] != 0.0 ||
        <uint>restored.offlineProjectileAbilityCodes[0] != corruption ||
        <uint>restored.offlineProjectileRanks[0] != <uint>3 ||
        !floatMatches(<float>restored.offlineProjectileCastTimes[0], 2.0)) {
        return -4;
    }

    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    var profile = numericEffects.resolvePureDotProfile(abilityIndex, 3, 100, 0, 0);
    if (!profile.valid || restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>1 || <int>restored.entityHp[1] != 1000 ||
        restored.offlineDotTargetIds.length != 1 ||
        <uint>restored.offlineDotTargetIds[0] != targetId ||
        <uint>restored.offlineDotSourceIds[0] != playerId ||
        <uint>restored.offlineDotAbilityCodes[0] != corruption ||
        <uint>restored.offlineDotRanks[0] != <uint>3 ||
        <int>restored.offlineDotSnapshotPowers[0] != profile.snapshotPower ||
        <int>restored.offlineDotDamages[0] != profile.damage ||
        !floatMatches(<float>restored.offlineDotDurations[0], profile.duration) ||
        !floatMatches(<float>restored.offlineDotTickIntervals[0], profile.interval)) {
