startOfflineCorruptionCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = corruptionAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("corruption");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (rank <= 0 || effects.count(abilityIndex, rank) != 1 ||
        effects.typeAt(abilityIndex, rank, 0) != "dot" ||
        <int>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        corruptionTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        corruptionCastSeconds(state, casterIndex, abilityIndex),
        corruptionGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineCorruptionCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = corruptionAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("corruption");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    if (abilityIndex < 0 || corruptionCompletionTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || effects.count(abilityIndex, rank) != 1 ||
        effects.typeAt(abilityIndex, rank, 0) != "dot" ||
        <int>state.entityResources[casterIndex] < cost) {
        return;
    }
    state.entityResources[casterIndex] = <int>state.entityResources[casterIndex] - cost;
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        0.0,
        0.0,
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_SHADOW,
        abilityCode,
        <uint>rank,
        m4AbilityCatalog.metric(abilityIndex, level, "castTime")
    );
}

// Life Tap resolves in the source instant-effect phase: it first owns the
// spell GCD, then rejects only the health-to-mana conversion when health is
// not strictly above the generated price. It has no target or RNG path.
lifeTapAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("life_tap");
    var abilityIndex = m4AbilityCatalog.indexOf("life_tap");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "life_tap") {
        throw "Life Tap is absent from the current ability catalog";
    }
    return code;
}

lifeTapPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>8 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>112;
}

lifeTapRankLevel(rankCode: uint): int {
    if (rankCode == <uint>1) { return 6; }
    if (rankCode == <uint>2) { return 14; }
    if (rankCode == <uint>3) { return 20; }
    return 0;
}

lifeTapProfileIsValid(rankCode: uint): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("life_tap");
    var level = lifeTapRankLevel(rankCode);
    return abilityIndex >= 0 && level > 0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == <int>rankCode &&
        effects.count(abilityIndex, <int>rankCode) == 1 &&
        effects.typeAt(abilityIndex, <int>rankCode, 0) == "lifeTap" &&
        effects.metric(abilityIndex, <int>rankCode, 0, "hp") > 0.0 &&
        effects.metric(abilityIndex, <int>rankCode, 0, "mana") > 0.0;
}

lifeTapGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS ?
        OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS : gcd;
}

startOfflineLifeTapCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = lifeTapAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("life_tap");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var rank = m4AbilityCatalog.rankAtLevel(
        abilityIndex, <int>state.entityLevels[casterIndex]
    );
    if (rank <= 0 || !lifeTapProfileIsValid(<uint>rank)) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    var gcd = lifeTapGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;

    var healthCost = <int>effects.metric(abilityIndex, rank, 0, "hp");
    var manaGain = <int>effects.metric(abilityIndex, rank, 0, "mana");
    if (<int>state.entityHp[casterIndex] <= healthCost) {
        return;
    }
    state.entityHp[casterIndex] = <int>state.entityHp[casterIndex] - healthCost;
    var restoredResource = <int>state.entityResources[casterIndex] + manaGain;
    var maximumResource = <int>state.entityMaxResources[casterIndex];
    state.entityResources[casterIndex] = restoredResource < maximumResource ?
        restoredResource : maximumResource;
}

mindBlastAbilityCode(): uint {
