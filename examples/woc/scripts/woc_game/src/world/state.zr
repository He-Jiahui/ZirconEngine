exorcismProjectileProfileIsValid(rank: uint, minimum: float, maximum: float, castTime: float): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("exorcism");
    return abilityIndex >= 0 && rank == <uint>1 &&
