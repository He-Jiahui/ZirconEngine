    if (!<bool>state.entityQueuedCastAimPresent[index] &&
        (<float>state.entityQueuedCastAimX[index] != 0.0 ||
            <float>state.entityQueuedCastAimY[index] != 0.0 ||
            <float>state.entityQueuedCastAimZ[index] != 0.0)) {
