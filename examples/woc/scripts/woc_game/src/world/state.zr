    pub spawnQuestNpc(template: uint, x: float, z: float, marker: int): uint {
        if (marker != 1 || template == <uint>0) {
            throw "woc quest NPC spawn parameters are invalid";
        }
        var id = this.spawnMob(template, 1, x, 1.5, z, 1, 1.0);
        var index = this.entityIds.length - 1;
        this.entityKinds[index] = <uint>3;
        this.entityHostile[index] = false;
        return id;
    }

