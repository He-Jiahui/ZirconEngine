pub offlineTalentLoadoutCommandStateTest(): int {
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    state.entityLevels[0] = 5;
    var armsCode = talentSelectionCatalog.specCode("warrior", "arms");
    var row5Code = talentSelectionCatalog.optionCode(
        "warrior", 5, "war_row_double_charge"
    );
    if (armsCode == <uint>0 || row5Code == <uint>0) {
        return -1;
    }
    appendTestOfflineTalentLoadout(
        state, <uint>66, <uint>0, <uint>0, <uint>0, <uint>0, <uint>0,
        <uint>0, <uint>0
    );
    appendTestOfflineTalentLoadout(
        state, <uint>65, armsCode, row5Code, <uint>0, <uint>0, <uint>0,
        <uint>0, <uint>0
    );
    state.offlineTalentActiveLoadoutIndex = 0;
    var encoded = encodeState(state);
    var restored = decodeState(encoded);
    if (restored.offlineTalentLoadoutSpecCodes.length != 2 ||
        restored.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>restored.offlineTalentLoadoutSpecCodes[1] != armsCode ||
        offlineTalentLoadoutRowCodeAt(restored, 1, 0) != row5Code ||
        restored.offlineTalentLoadoutActionBarAbilityCodes.length !=
            2 * talentLoadoutContract.barSlots(true)) {
        return -2;
    }
    var playerId = <uint>state.entityIds[0];
    var payloads = %import("protocol/command_payloads");
    var switchLoadout = new CommandBatch();
    appendLoadoutIndexCommand(
        switchLoadout, payloads.switchLoadoutCommandId(true), playerId, <uint>1,
        <uint>1, <uint>1
    );
    state.applyCommands(switchLoadout, 1);
    if (<uint>state.entityTalentSpecCodes[0] != armsCode ||
        talentRowCodeAt(state, 0, 0) != row5Code ||
        state.offlineTalentActiveLoadoutIndex != 1 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -3;
    }
    var deleteActive = new CommandBatch();
    appendLoadoutIndexCommand(
        deleteActive, payloads.deleteLoadoutCommandId(true), playerId, <uint>1,
        <uint>2, <uint>1
    );
    state.applyCommands(deleteActive, 1);
    var afterDelete = decodeState(encodeState(state));
    if (<uint>state.entityTalentSpecCodes[0] != <uint>0 ||
        state.offlineTalentLoadoutSpecCodes.length != 1 ||
        state.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>state.offlineTalentLoadoutNameBytes[0] != <uint>66 ||
        afterDelete.offlineTalentLoadoutSpecCodes.length != 1 ||
        afterDelete.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -4;
    }
    var missing = new CommandBatch();
    appendLoadoutIndexCommand(
        missing, payloads.switchLoadoutCommandId(true), playerId, <uint>1,
        <uint>3, <uint>5
    );
    state.applyCommands(missing, 1);
    if (state.offlineTalentLoadoutSpecCodes.length != 1 ||
        state.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>3) {
        return -5;
    }
    state.spawnMob(<uint>1, 5, 0.0, 1.5, 0.0, 30, 5.0);
    var mobIndex = state.entityIds.length - 1;
    state.entityAiStates[mobIndex] = <uint>2;
    state.entityTargetIds[mobIndex] = playerId;
    var locked = new CommandBatch();
    appendLoadoutIndexCommand(
        locked, payloads.deleteLoadoutCommandId(true), playerId, <uint>1,
        <uint>4, <uint>0
    );
    state.applyCommands(locked, 1);
    if (state.offlineTalentLoadoutSpecCodes.length != 1 ||
        state.offlineTalentActiveLoadoutIndex != 0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>4) {
        return -6;
    }
    return 1;
}

pub offlineResurrectRespondCommandStateTest(): int {
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
    bootstrap.playerName.add(<uint>101);
    bootstrap.skinVariant = <uint>0;
    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    var playerId = <uint>state.entityIds[0];
    var payloads = %import("protocol/command_payloads");
    var accept = new CommandBatch();
    appendBooleanCommand(
        accept, payloads.resurrectRespondCommandId(true), playerId, <uint>1,
        <uint>1, true
    );
    state.applyCommands(accept, 1);
    if (<bool>state.entityDead[0] || <int>state.entityHp[0] <= 0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -1;
    }
    state.entityDead[0] = true;
    state.entityHp[0] = 0;
    var casterId = state.spawnPlayer(<uint>1, 1, 600.1, 7.0, 0.0, 54, 8.0, 1);
    var casterIndex = state.entityIds.length - 1;
    if (!offerOfflineTemporalReversal(state, casterIndex, 0) ||
        !<bool>state.entityResurrectionOfferPresent[0] ||
        <uint>state.entityResurrectionOfferCasterIds[0] != casterId) {
        return -2;
    }
    var offeredRoundTrip = decodeState(encodeState(state));
    if (!<bool>offeredRoundTrip.entityResurrectionOfferPresent[0] ||
        <uint>offeredRoundTrip.entityResurrectionOfferCasterIds[0] != casterId ||
        <float>offeredRoundTrip.entityResurrectionOfferHpFractions[0] != 0.35 ||
        <float>offeredRoundTrip.entityResurrectionOfferFallbackX[0] != 600.1 ||
        <uint>offeredRoundTrip.entityResurrectionOfferExpiresAtMicros[0] != <uint>30000000) {
        return -3;
    }
    var decline = new CommandBatch();
    appendBooleanCommand(
        decline, payloads.resurrectRespondCommandId(true), playerId, <uint>1,
        <uint>2, false
    );
    state.applyCommands(decline, 1);
    if (!<bool>state.entityDead[0] || <bool>state.entityResurrectionOfferPresent[0] ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -4;
    }
    if (!offerOfflineResurrection(state, casterIndex, 0, 0.35)) {
        return -5;
    }
    // The source chooses the offer-time fallback when the caster has died.
    state.entityDead[casterIndex] = true;
    state.entityX[casterIndex] = 700.0;
    var revive = new CommandBatch();
    appendBooleanCommand(
        revive, payloads.resurrectRespondCommandId(true), playerId, <uint>1,
        <uint>3, true
    );
    state.applyCommands(revive, 1);
    if (<bool>state.entityDead[0] || <bool>state.entityResurrectionOfferPresent[0] ||
        <int>state.entityHp[0] != 19 || <float>state.entityX[0] != 600.1 ||
        <float>state.entityY[0] != 0.0 || <float>state.entityZ[0] != 0.0 ||
        <float>state.entityPreviousX[0] != 600.1 ||
        <float>state.entityPreviousY[0] != 0.0 || <float>state.entityPreviousZ[0] != 0.0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>3) {
        return -6;
    }
    state.entityDead[0] = true;
    state.entityHp[0] = 0;
    state.entityDead[casterIndex] = false;
    if (!offerOfflineResurrection(state, casterIndex, 0, 0.35)) {
        return -7;
    }
    state.entityResurrectionOfferExpiresAtMicros[0] = state.timeMicros;
    clearExpiredResurrectionOffers(state);
    var restored = decodeState(encodeState(state));
    if (<bool>state.entityResurrectionOfferPresent[0] ||
        <bool>restored.entityResurrectionOfferPresent[0] ||
        <uint>restored.entityLastCommandSequence[0] != <uint>3) {
        return -8;
    }
    return 1;
}

pub offlineSpiritLoopCommandStateTest(): int {
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = <uint>1;
    bootstrap.worldSeed = <uint>20061;
    bootstrap.playerClass = <uint>0;
    bootstrap.playerName.add(<uint>86);
    bootstrap.playerName.add(<uint>97);
    bootstrap.playerName.add(<uint>108);
