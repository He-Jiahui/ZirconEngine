    pub entityCount(required: bool): int {
        if (!required) {
            throw "woc entity count must be observed";
        }
        return this.entityIds.length;
    }

    pub setThreat(entityId: uint, targetId: uint, value: float, marker: int): void {
        if (marker != 1 || entityId == <uint>0 || targetId == <uint>0 || value < 0.0) {
            throw "woc threat update is invalid";
        }
        var entityIndex = 0;
        while (entityIndex < this.entityIds.length &&
            <uint>this.entityIds[entityIndex] != entityId) {
            entityIndex = entityIndex + 1;
        }
        if (entityIndex >= this.entityIds.length) {
            throw "woc threat owner does not exist";
        }
        var offsets = this.entityThreatOffsets;
        var targets = this.entityThreatTargetIds;
        var values = this.entityThreatValues;
        var start = <int><uint>offsets[entityIndex];
        var end = <int><uint>offsets[entityIndex + 1];
        var index = start;
        while (index < end && <uint>targets[index] < targetId) {
            index = index + 1;
        }
        if (index < end && <uint>targets[index] == targetId) {
            values[index] = value;
            return;
        }
        targets.add(<uint>0);
        values.add(0.0);
        var cursor = targets.length - 1;
        while (cursor > index) {
            targets[cursor] = <uint>targets[cursor - 1];
            values[cursor] = <float>values[cursor - 1];
            cursor = cursor - 1;
        }
        targets[index] = targetId;
        values[index] = value;
        var offsetIndex = entityIndex + 1;
        while (offsetIndex < offsets.length) {
            offsets[offsetIndex] = <uint>offsets[offsetIndex] + <uint>1;
            offsetIndex = offsetIndex + 1;
        }
    }

    // Commands mutate only the decoded candidate. Any throw discards the whole
    // candidate at the host boundary, including sequence and threat changes.
    pub applyCommands(input: CommandBatch, marker: int): void {
        if (marker != 1) {
            throw "woc command batch marker is invalid";
        }
        var entityHostile = this.entityHostile;
        var count = <int>input.commandCount;
        var ids = input.commandIds;
        var actorIds = input.commandActorIds;
        var actorGenerations = input.commandActorGenerations;
        var sequences = input.commandSequences;
        var payloadOffsets = input.commandPayloadOffsets;
        var payloadLengths = input.commandPayloadLengths;
        var payloadBytes = input.commandPayloadBytes;
        if (count < 0 || ids.length != count || actorIds.length != count ||
            actorGenerations.length != count || sequences.length != count ||
            payloadOffsets.length != count || payloadLengths.length != count) {
            throw "woc command batch columns have different lengths";
        }

        var payloads = %import("protocol/command_payloads");
        var castSlotCommand = payloads.castSlotCommandId(true);
        var castAtCommand = payloads.castAtCommandId(true);
        var castCommand = payloads.castCommandId(true);
        var cancelAuraCommand = payloads.cancelAuraCommandId(true);
        var targetCommand = payloads.targetCommandId(true);
        var tabCommand = payloads.tabCommandId(true);
        var targetNearestCommand = payloads.targetNearestCommandId(true);
        var tabFriendlyCommand = payloads.tabFriendlyCommandId(true);
        var targetNearestFriendlyCommand = payloads.targetNearestFriendlyCommandId(true);
        var attackCommand = payloads.attackCommandId(true);
        var stopAttackCommand = payloads.stopAttackCommandId(true);
        var weaponStowCommand = payloads.weaponStowCommandId(true);
        var lootCommand = payloads.lootCommandId(true);
        var autoLootCommand = payloads.autoLootCommandId(true);
        var lootRollCommand = payloads.lootRollCommandId(true);
        var masterAssignCommand = payloads.masterAssignCommandId(true);
        var useItemCommand = payloads.useItemCommandId(true);
        var harvestNodeCommand = payloads.harvestNodeCommandId(true);
        var craftItemCommand = payloads.craftItemCommandId(true);
        var heroicBuyCommand = payloads.heroicBuyCommandId(true);
        var delveBuyCommand = payloads.delveBuyCommandId(true);
        var companionUpgradeCommand = payloads.companionUpgradeCommandId(true);
        var deedSetTitleCommand = payloads.deedSetTitleCommandId(true);
        var setTownFocusCommand = payloads.setTownFocusCommandId(true);
        var equipItemCommand = payloads.equipItemCommandId(true);
        var inventoryMoveCommand = payloads.inventoryMoveCommandId(true);
        var unequipItemCommand = payloads.unequipItemCommandId(true);
        var emoteCommand = payloads.emoteCommandId(true);
        var chatCommand = payloads.chatCommandId(true);
        var telemetryCommand = payloads.telemetryCommandId(true);
        var acceptQuestCommand = payloads.acceptQuestCommandId(true);
        var linkedQuestAcceptCommand = payloads.linkedQuestAcceptCommandId(true);
        var turnInQuestCommand = payloads.turnInQuestCommandId(true);
        var abandonCommand = payloads.abandonCommandId(true);
        var applyTalentsCommand = payloads.applyTalentsCommandId(true);
        var respecCommand = payloads.respecCommandId(true);
        var setSpecCommand = payloads.setSpecCommandId(true);
        var saveLoadoutCommand = payloads.saveLoadoutCommandId(true);
        var selectTalentRowCommand = payloads.selectTalentRowCommandId(true);
        var changeSkinCommand = payloads.changeSkinCommandId(true);
        var unequipMechChromaCommand = payloads.unequipMechChromaCommandId(true);
        var changeWeaponSkinCommand = payloads.changeWeaponSkinCommandId(true);
        var switchLoadoutCommand = payloads.switchLoadoutCommandId(true);
        var deleteLoadoutCommand = payloads.deleteLoadoutCommandId(true);
        var releaseCommand = payloads.releaseCommandId(true);
        var releaseEmpoweredCommand = payloads.releaseEmpoweredCommandId(true);
        var resurrectCorpseCommand = payloads.resurrectCorpseCommandId(true);
        var resurrectHealerCommand = payloads.resurrectHealerCommandId(true);
        var resurrectRespondCommand = payloads.resurrectRespondCommandId(true);
        var partyInviteCommand = payloads.partyInviteCommandId(true);
        var partyAcceptCommand = payloads.partyAcceptCommandId(true);
        var partyDeclineCommand = payloads.partyDeclineCommandId(true);
        var partyLeaveCommand = payloads.partyLeaveCommandId(true);
        var partyKickCommand = payloads.partyKickCommandId(true);
        var partyPromoteCommand = payloads.partyPromoteCommandId(true);
        var partyRaidCommand = payloads.partyRaidCommandId(true);
        var partyUnraidCommand = payloads.partyUnraidCommandId(true);
        var partyMoveRaidCommand = payloads.partyMoveRaidCommandId(true);
        var partySetLootMasterCommand = payloads.partySetLootMasterCommandId(true);
        var partySetMarkerCommand = payloads.partySetMarkerCommandId(true);
        var partyClearMarkerCommand = payloads.partyClearMarkerCommandId(true);
        var partyReadyRespondCommand = payloads.partyReadyRespondCommandId(true);
        var arenaQueueCommand = payloads.arenaQueueCommandId(true);
        var arenaLeaveCommand = payloads.arenaLeaveCommandId(true);
        var cardQueueJoinCommand = payloads.cardQueueJoinCommandId(true);
        var cardQueueLeaveCommand = payloads.cardQueueLeaveCommandId(true);
        var cardPlayCommand = payloads.cardPlayCommandId(true);
        var cardForfeitCommand = payloads.cardForfeitCommandId(true);
        var discardCommand = payloads.discardItemCommandId(true);
        var buyCommand = payloads.buyCommandId(true);
        var sellCommand = payloads.sellCommandId(true);
        var buybackCommand = payloads.buybackCommandId(true);
        var sellAllJunkCommand = payloads.sellAllJunkCommandId(true);
        var equipBagCommand = payloads.equipBagCommandId(true);
        var unequipBagCommand = payloads.unequipBagCommandId(true);
        var setDungeonDifficultyCommand = payloads.setDungeonDifficultyCommandId(true);
        var petReviveCommand = payloads.petReviveCommandId(true);
        var petAttackCommand = payloads.petAttackCommandId(true);
        var petTauntCommand = payloads.petTauntCommandId(true);
        var petAutoTauntCommand = payloads.petAutoTauntCommandId(true);
        var petWaterJetCommand = payloads.petWaterJetCommandId(true);
        var petAutoWaterJetCommand = payloads.petAutoWaterJetCommandId(true);
        var petModeCommand = payloads.petModeCommandId(true);
        var cardDuel = restoreCardDuelService(this);
        var expectedPayloadOffset: uint = <uint>0;
        var commandIndex = 0;
        while (commandIndex < count) {
            var commandId = <uint>ids[commandIndex];
            var payloadOffset = <uint>payloadOffsets[commandIndex];
            var payloadLength = <uint>payloadLengths[commandIndex];
            var payloadKind = payloads.payloadKind(commandId, 1);
            var expectedLength = payloads.payloadLength(commandId, true);
            var minimumLength = payloads.payloadMinLength(commandId, true);
            var maximumLength = payloads.payloadMaxLength(commandId, true);
            var questCommand = commandId == acceptQuestCommand ||
                commandId == turnInQuestCommand || commandId == abandonCommand;
            var cardDuelCommand = commandId == cardQueueJoinCommand ||
                commandId == cardQueueLeaveCommand || commandId == cardPlayCommand ||
                commandId == cardForfeitCommand;
            var petCommand = commandId == petReviveCommand ||
                commandId == petAttackCommand || commandId == petTauntCommand ||
                commandId == petAutoTauntCommand || commandId == petWaterJetCommand ||
                commandId == petAutoWaterJetCommand || commandId == petModeCommand;
            if (payloadKind == 0 || minimumLength < 0 || maximumLength < minimumLength) {
                throw "woc authoritative command payload is not implemented";
            }
            if (payloadOffset != expectedPayloadOffset ||
                payloadOffset > <uint>payloadBytes.length ||
                payloadLength > <uint>payloadBytes.length - payloadOffset ||
                payloadLength < <uint>minimumLength ||
                payloadLength > <uint>maximumLength ||
                (expectedLength >= 0 && payloadLength != <uint>expectedLength)) {
                throw "woc command payload partition is invalid";
            }

            var actorId = <uint>actorIds[commandIndex];
            var actorGeneration = <uint>actorGenerations[commandIndex];
            var actorIndex = 0;
            while (actorIndex < this.entityIds.length &&
                <uint>this.entityIds[actorIndex] != actorId) {
                actorIndex = actorIndex + 1;
            }
            if (actorIndex >= this.entityIds.length ||
                <uint>this.entityGenerations[actorIndex] != actorGeneration ||
                <uint>this.entityKinds[actorIndex] != <uint>1) {
                throw "woc command actor reference is invalid";
            }
            var sequence = <uint>sequences[commandIndex];
            if (<bool>this.entityCommandSequenceInitialized[actorIndex] &&
                sequence <= <uint>this.entityLastCommandSequence[actorIndex]) {
                throw "woc command sequence is not strictly increasing";
            }

            if (temporalHourglassActionSuppressed(this, actorIndex) &&
                commandId != cancelAuraCommand) {
                this.entityAutoAttack[actorIndex] = false;
            } else if (commandId == castSlotCommand) {
                applySupportedCastSlotCommand(
                    this, actorIndex, payloadOffset, payloadBytes
                );
            } else if (commandId == castAtCommand) {
                applySupportedCastAtCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == castCommand) {
                applySupportedCastCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == cancelAuraCommand) {
                applyOfflineCancelAuraCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == targetCommand) {
                var targetId: uint = <uint>0;
                var payloadIndex: uint = <uint>0;
                var multiplier: uint = <uint>1;
                while (payloadIndex < <uint>8) {
                    targetId = targetId +
                        <uint>payloadBytes[<int>(payloadOffset + payloadIndex)] * multiplier;
                    multiplier = multiplier * <uint>256;
                    payloadIndex = payloadIndex + <uint>1;
                }
                if (targetId == <uint>0) {
                    this.entityTargetIds[actorIndex] = <uint>0;
                    this.entityAutoAttack[actorIndex] = false;
                } else {
                    var targetIndex = 0;
                    while (targetIndex < this.entityIds.length &&
                        <uint>this.entityIds[targetIndex] != targetId) {
                        targetIndex = targetIndex + 1;
                    }
                    // The source targetEntity path ignores missing and unselectable
                    // dead ids rather than clearing a valid existing target.
                    if (targetIndex < this.entityIds.length &&
                        (!<bool>this.entityDead[targetIndex] ||
                            deadTargetSelection.deadTargetSelectable(
                                <bool>this.entityLootable[targetIndex],
                                <uint>this.entityKinds[targetIndex],
                                <uint>this.entityOwnerIds[targetIndex],
                                actorId
                            ))) {
                        this.entityTargetIds[actorIndex] = targetId;
                        if (!<bool>entityHostile[targetIndex] ||
                            <bool>this.entityDead[targetIndex]) {
                            this.entityAutoAttack[actorIndex] = false;
                        }
                    }
                }
            } else if (commandId == tabCommand) {
                applyTabTargetCommand(this, actorIndex);
            } else if (commandId == targetNearestCommand) {
                applyNearestEnemyTargetCommand(this, actorIndex);
            } else if (commandId == tabFriendlyCommand) {
                applyFriendlyTabTargetCommand(this, actorIndex);
            } else if (commandId == targetNearestFriendlyCommand) {
                applyNearestFriendlyTargetCommand(this, actorIndex);
            } else if (commandId == attackCommand) {
                startOfflineAutoAttack(this, actorIndex);
            } else if (commandId == stopAttackCommand) {
                this.entityAutoAttack[actorIndex] = false;
            } else if (commandId == weaponStowCommand) {
                if (!<bool>this.entityDead[actorIndex]) {
                    this.entityWeaponStowed[actorIndex] =
                        !<bool>this.entityWeaponStowed[actorIndex];
                }
            } else if (commandId == lootCommand) {
                applyOfflineCorpseLootCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == autoLootCommand) {
                applyOfflineAutoLootCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == lootRollCommand) {
                applyLootRollCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == masterAssignCommand) {
                applyMasterLootAssignmentCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == useItemCommand) {
                applyOfflineUseItemCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == harvestNodeCommand) {
                applyOfflineHarvestNodeCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == craftItemCommand) {
                applyOfflineCraftItemCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == heroicBuyCommand) {
                applyHeroicVendorBuyCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == delveBuyCommand) {
                applyDelveShopBuyCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == companionUpgradeCommand) {
                applyDelveCompanionUpgradeCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == chatCommand) {
                applyChatCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == deedSetTitleCommand) {
                applyOfflineDeedSetTitleCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == setTownFocusCommand) {
                applyOfflineSetTownFocusCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == equipItemCommand) {
                applyM5EquipItemCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == inventoryMoveCommand) {
                applyInventoryMoveCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == emoteCommand) {
                applyEmoteCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == unequipItemCommand) {
                applyM5UnequipItemCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == telemetryCommand) {
                applyTelemetryNoopCommand(payloadOffset, payloadLength, payloadBytes);
            } else if (commandId == linkedQuestAcceptCommand) {
                applyOfflineLinkedQuestAcceptCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (questCommand) {
                applyOfflineQuestCommand(
                    this, actorIndex, commandId, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == applyTalentsCommand) {
                applyOfflineTalentAllocationCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == respecCommand) {
                applyOfflineRespecCommand(this, actorIndex);
            } else if (commandId == setSpecCommand) {
                applyOfflineSetSpecCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == selectTalentRowCommand) {
                applyOfflineTalentRowCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == changeSkinCommand) {
                applyOfflineSkinCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == unequipMechChromaCommand) {
                applyOfflineUnequipMechChromaCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == changeWeaponSkinCommand) {
                applyOfflineWeaponSkinCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == saveLoadoutCommand) {
                applyOfflineSaveTalentLoadoutCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == switchLoadoutCommand) {
                applyOfflineSwitchTalentLoadoutCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == deleteLoadoutCommand) {
                applyOfflineDeleteTalentLoadoutCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == releaseCommand) {
                applyOfflineReleaseSpiritCommand(this, actorIndex);
            } else if (commandId == releaseEmpoweredCommand) {
                applyOfflineReleaseEmpoweredCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == resurrectCorpseCommand) {
                applyOfflineResurrectAtCorpseCommand(this, actorIndex);
            } else if (commandId == resurrectHealerCommand) {
                applyOfflineResurrectAtSpiritHealerCommand(this, actorIndex);
            } else if (commandId == resurrectRespondCommand) {
                applyOfflineResurrectRespondCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (petCommand) {
                applyOfflineEmberkinPetCommand(
                    this, actorIndex, commandId, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == partyInviteCommand) {
                applyPartyInviteCommand(this, actorIndex, payloadOffset, payloadBytes);
            } else if (commandId == partyAcceptCommand) {
                applyPartyAcceptCommand(this, actorIndex);
            } else if (commandId == partyDeclineCommand) {
                applyPartyDeclineCommand(this, actorIndex);
            } else if (commandId == partyLeaveCommand) {
                applyPartyLeaveCommand(this, actorIndex);
            } else if (commandId == partyKickCommand) {
                applyPartyKickCommand(this, actorIndex, payloadOffset, payloadBytes);
            } else if (commandId == partyPromoteCommand) {
                applyPartyPromoteCommand(this, actorIndex, payloadOffset, payloadBytes);
            } else if (commandId == partyRaidCommand) {
                applyPartyRaidCommand(this, actorIndex);
            } else if (commandId == partyUnraidCommand) {
                applyPartyUnraidCommand(this, actorIndex);
            } else if (commandId == partyMoveRaidCommand) {
                applyPartyMoveRaidCommand(this, actorIndex, payloadOffset, payloadBytes);
            } else if (commandId == partySetLootMasterCommand) {
                applyPartySetLootMasterCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == partySetMarkerCommand ||
                commandId == partyClearMarkerCommand) {
                applyPartyMarkerCommand(
                    this, actorIndex, commandId, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == partyReadyRespondCommand) {
                applyPartyReadyRespondCommand(this, actorIndex, payloadOffset, payloadBytes);
            } else if (commandId == setDungeonDifficultyCommand) {
                applyDungeonDifficultyCommand(this, actorIndex, payloadOffset, payloadBytes);
            } else if (commandId == arenaQueueCommand) {
                applyArenaQueueCommand(this, actorIndex, payloadOffset, payloadBytes);
            } else if (commandId == arenaLeaveCommand) {
                applyArenaLeaveCommand(this, actorIndex);
            } else if (commandId == equipBagCommand) {
                applyM5EquipBagCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == unequipBagCommand) {
                applyM5UnequipBagCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == discardCommand) {
                applyM5DiscardCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == buyCommand) {
                applyM5VendorBuyCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == sellCommand) {
                applyM5VendorSellCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == buybackCommand) {
                applyM5VendorBuybackCommand(
                    this, actorIndex, payloadOffset, payloadLength, payloadBytes
                );
            } else if (commandId == sellAllJunkCommand) {
                applyM5VendorSellAllJunkCommand(this, actorIndex);
            } else if (cardDuelCommand) {
                cardDuelRouter.apply(
                    cardDuel,
                    actorId,
                    commandId,
                    cardDuelPayload(payloadOffset, payloadLength, payloadBytes),
                    cardDuelNowSeconds(this)
                );
            } else {
                throw "woc authoritative command reducer is not implemented";
            }

            this.entityCommandSequenceInitialized[actorIndex] = true;
            this.entityLastCommandSequence[actorIndex] = sequence;
            expectedPayloadOffset = expectedPayloadOffset + payloadLength;
            commandIndex = commandIndex + 1;
        }
        if (expectedPayloadOffset != <uint>payloadBytes.length) {
            throw "woc command payload contains trailing bytes";
        }
        commitCardDuelService(this, cardDuel);
    }
}

// The native EquipBag payload is `u32 utf8Bytes`, the identifier bytes, then
// a presence byte and an optional little-endian u32 socket. The M5 scalar
// catalog currently projects one source bag identity, so unknown well-formed
// ids remain source-style no-ops instead of acquiring a parallel string store.
applyM5EquipBagCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>5 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc M5 equip bag payload is truncated";
    }
    var itemLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (itemLength > <uint>256) {
        throw "woc M5 equip bag item id is invalid";
    }
    var itemOffset = payloadOffset + <uint>4;
    var suffixOffset = itemOffset + itemLength;
    if (suffixOffset >= payloadOffset + payloadLength) {
        throw "woc M5 equip bag payload is truncated";
    }
    var socketPresence = <uint>payloadBytes[<int>suffixOffset];
    var requestedSocket = -1;
    if (socketPresence == <uint>0) {
        if (payloadLength != itemLength + <uint>5) {
            throw "woc M5 equip bag payload has trailing bytes";
        }
    } else if (socketPresence == <uint>1) {
        if (payloadLength != itemLength + <uint>9) {
            throw "woc M5 equip bag socket length is invalid";
        }
        var socketOffset = suffixOffset + <uint>1;
        var socket: uint = <uint>payloadBytes[<int>socketOffset] +
            <uint>payloadBytes[<int>(socketOffset + <uint>1)] * <uint>256 +
            <uint>payloadBytes[<int>(socketOffset + <uint>2)] * <uint>65536 +
            <uint>payloadBytes[<int>(socketOffset + <uint>3)] * <uint>16777216;
        if (socket > <uint>3) { return; }
        requestedSocket = <int>socket;
    } else {
        throw "woc M5 equip bag socket presence is invalid";
    }
    if (itemLength != <uint>16 ||
        <uint>payloadBytes[<int>itemOffset] != <uint>119 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>1)] != <uint>111 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>2)] != <uint>108 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>3)] != <uint>102 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>4)] != <uint>104 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>5)] != <uint>105 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>6)] != <uint>100 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>7)] != <uint>101 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>8)] != <uint>95 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>9)] != <uint>115 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>10)] != <uint>97 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>11)] != <uint>116 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>12)] != <uint>99 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>13)] != <uint>104 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>14)] != <uint>101 ||
        <uint>payloadBytes[<int>(itemOffset + <uint>15)] != <uint>108) {
        return;
    }
    equipM5InventoryBag(
        state, actorIndex, m5InventoryItemCodeForId("wolfhide_satchel"), requestedSocket
    );
}

applyM5UnequipBagCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadOffset > <uint>payloadBytes.length ||
        payloadLength != <uint>4 ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc M5 unequip bag payload is invalid";
    }
    var socket: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (socket > <uint>3) { return; }
    unequipM5InventoryBag(state, actorIndex, <int>socket);
}

// Source item policy stays generated so a future protected scalar item cannot
// bypass the same `noDiscard` gate as the reference command.
applyM5DiscardCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>5 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc M5 discard payload is truncated";
    }
    var itemLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (itemLength > <uint>256 || itemLength > payloadLength - <uint>5) {
        throw "woc M5 discard item payload is invalid";
    }
    var itemOffset = payloadOffset + <uint>4;
    var presenceOffset = itemOffset + itemLength;
    var trailing = payloadLength - <uint>4 - itemLength;
    var presence = <uint>payloadBytes[<int>presenceOffset];
    if (presence > <uint>1 || (presence == <uint>0 && trailing != <uint>1) ||
        (presence == <uint>1 && trailing != <uint>5)) {
        throw "woc M5 discard count payload is invalid";
    }
    var requested = 1;
    if (presence == <uint>1) {
        requested = <int><uint>payloadBytes[<int>(presenceOffset + <uint>1)] +
            <int><uint>payloadBytes[<int>(presenceOffset + <uint>2)] * 256 +
            <int><uint>payloadBytes[<int>(presenceOffset + <uint>3)] * 65536 +
            <int><uint>payloadBytes[<int>(presenceOffset + <uint>4)] * 16777216;
    }
    var itemCode = m5InventoryItemCodeFromPayload(itemOffset, itemLength, payloadBytes);
    if (itemCode == <uint>0) { return; }
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    var catalog = %import("generated/m5_content_catalog");
    if (itemIndex < 0 || catalog.flag("item", itemIndex, "noDiscard")) { return; }
    var available = m5InventoryItemCount(state, actorIndex, itemCode);
    if (requested > available) { requested = available; }
    if (requested <= 0) { return; }
    // The reference's removePreferFungible reaches its normal newest-first
    // removal after checking for instances. This bounded catalog has only
    // plain stacks, so the shared scalar remover is the exact remaining path.
    removeM5InventoryItem(state, actorIndex, itemCode, requested);
}

// This is the WOS relationship projection consumed by target_selection.zr.
// PVP/arena/Vale Cup and friendly-pet rows are not represented in WOS yet, so
// they cannot enter this authoritative candidate set before their state exists.
targetCandidates(state: WorldState, actorIndex: int): targetSelection.CandidateSet {
    var candidates = new targetSelection.CandidateSet();
    var actorId = <uint>state.entityIds[actorIndex];
    var index = 0;
    while (index < state.entityIds.length) {
        if (index != actorIndex && !<bool>state.entityDead[index]) {
            var id = <uint>state.entityIds[index];
            var dx = <float>state.entityX[index] - <float>state.entityX[actorIndex];
            var dz = <float>state.entityZ[index] - <float>state.entityZ[actorIndex];
            if (<bool>state.entityHostile[index]) {
                candidates.addEnemy(
                    id, dx, dz, <uint>state.entityTargetIds[index] == actorId
                );
            } else if (<uint>state.entityKinds[index] == <uint>1) {
                candidates.addFriendly(id, dx, dz);
            }
        }
        index = index + 1;
    }
    return candidates;
}

applyTabTargetCommand(state: WorldState, actorIndex: int): void {
    if (<bool>state.entityDead[actorIndex]) return;
    var candidates = targetCandidates(state, actorIndex);
    state.entityTargetIds[actorIndex] = targetSelection.tabEnemy(
        candidates,
        <uint>state.entityTargetIds[actorIndex],
        <float>state.entityFacing[actorIndex]
    );
}

applyNearestEnemyTargetCommand(state: WorldState, actorIndex: int): void {
    if (<bool>state.entityDead[actorIndex]) return;
    state.entityTargetIds[actorIndex] = targetSelection.nearestEnemy(
        targetCandidates(state, actorIndex), <uint>state.entityTargetIds[actorIndex]
    );
}

applyFriendlyTabTargetCommand(state: WorldState, actorIndex: int): void {
    state.entityTargetIds[actorIndex] = targetSelection.friendlyCycle(
        targetCandidates(state, actorIndex), <uint>state.entityTargetIds[actorIndex]
    );
}

applyNearestFriendlyTargetCommand(state: WorldState, actorIndex: int): void {
    state.entityTargetIds[actorIndex] = targetSelection.nearestFriendly(
        targetCandidates(state, actorIndex), <uint>state.entityTargetIds[actorIndex]
    );
}

// The source uses the live static Card Master entity. WOS has not yet
// materialized the full static roster, so this bridge uses its generated,
// safe-positioned source location. It is intentionally local to the WOS
// coordinator and disappears once the roster is materialized atomically.
cardMasterInRange(state: WorldState, playerIndex: int): bool {
    var cardMasterIndex = cardMasterStaticNpcIndex();
    var x = npcPlacement.finalStaticNpcCoordinate(state.worldSeed, cardMasterIndex, 1, true);
    var z = npcPlacement.finalStaticNpcCoordinate(state.worldSeed, cardMasterIndex, 2, true);
    var dx = <float>state.entityX[playerIndex] - x;
    var dz = <float>state.entityZ[playerIndex] - z;
    // Source INTERACT_RANGE (5) plus its NPC allowance (2), inclusive.
    return dx * dx + dz * dz <= 49.0;
}

cardMasterStaticNpcIndex(): int {
    var index = 0;
    var count = npcPlacement.staticNpcCount(true);
    while (index < count) {
        if (npcPlacement.staticNpcId(index, true) == "card_master") {
            return index;
        }
        index = index + 1;
    }
    throw "woc Card Master static NPC is absent from the source roster";
}

cardDuelNowSeconds(state: WorldState): float {
    return <float>state.timeMicros / 1000000.0;
}

cardDuelPayload(
    offset: uint, length: uint, bytes: container.Array<uint>
): container.Array<uint> {
    if (offset > <uint>bytes.length || length > <uint>bytes.length - offset) {
        throw "woc Card Duel command payload is truncated";
    }
    var result = new container.Array<uint>();
    var index: uint = <uint>0;
    while (index < length) {
        result.add(<uint>bytes[<int>(offset + index)]);
        index = index + <uint>1;
    }
    return result;
}

syncCardDuelPlayers(state: WorldState, service: cardDuelService.CardDuelService): void {
    var priorIndex = service.players.length - 1;
    while (priorIndex >= 0) {
        var pid = <uint>service.players[priorIndex].pid;
        var present = false;
        var worldIndex = 0;
        while (worldIndex < state.entityIds.length) {
            if (<uint>state.entityKinds[worldIndex] == <uint>1 &&
                <uint>state.entityIds[worldIndex] == pid) {
                present = true;
            }
            worldIndex = worldIndex + 1;
        }
        if (!present) {
            // The source disconnect path removes a pending queue entry and
            // forfeits its live match before the player record disappears.
            cardDuelService.upsertPlayer(service, pid, false, false);
            cardDuelService.leaveEntirely(service, pid);
            service.players.removeAt(priorIndex);
        }
        priorIndex = priorIndex - 1;
    }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        if (<uint>state.entityKinds[entityIndex] == <uint>1) {
            var alive = !<bool>state.entityDead[entityIndex];
            cardDuelService.upsertPlayer(
                service,
                <uint>state.entityIds[entityIndex],
                alive,
                alive && cardMasterInRange(state, entityIndex)
            );
        }
        entityIndex = entityIndex + 1;
    }
}

restoreCardDuelService(state: WorldState): cardDuelService.CardDuelService {
    var service = cardDuelSnapshot.decode(state.cardDuelStateBytes, state.worldSeed);
    // The target Sim gives Card Duel its shared RNG, not a minigame-private
    // stream. WOS owns that cursor and rolls it back atomically with the rest
    // of the candidate, so repair legacy CDS1-local stream state on restore.
    service.rng.restore(state.rngState, state.rngDraws, state.rngDigest);
    syncCardDuelPlayers(state, service);
    return service;
}

commitCardDuelService(state: WorldState, service: cardDuelService.CardDuelService): void {
    // Persist the cursor before CDS1 so its embedded stream and the enclosing
    // WOS fields stay identical after every accepted Card Duel transition.
    state.rngState = service.rng.state;
    state.rngDraws = service.rng.draws;
    state.rngDigest = service.rng.drawDigest;
    state.cardDuelStateBytes = cardDuelSnapshot.encode(service);
}

updateCardDuelService(state: WorldState): void {
    var service = restoreCardDuelService(state);
    cardDuelService.update(service, cardDuelNowSeconds(state));
    commitCardDuelService(state, service);
}

class StateReader {
    pri var bytes: container.Array<uint>;
    pri var offset: int;

    pub @constructor(source: container.Array<uint>) {
        this.bytes = source;
        this.offset = 0;
    }

    // Distinct arities avoid the experimental backend's same-signature binding defect.
    pub byte(width: int): uint {
        if (width != 1 || this.offset >= this.bytes.length) {
            throw "woc world state is truncated";
        }
        var value = <uint>this.bytes[this.offset];
        if (value > <uint>255) {
            throw "woc world state byte exceeds 255";
        }
        this.offset = this.offset + 1;
        return value;
    }

    pub u16(lowBytes: int, highBytes: int): uint {
        if (lowBytes != 1 || highBytes != 1) {
            throw "woc world state u16 layout is invalid";
        }
        return this.byte(1) + this.byte(1) * <uint>256;
    }

    pub u32(a: int, b: int, c: int): uint {
        if (a != 1 || b != 1 || c != 2) {
            throw "woc world state u32 layout is invalid";
        }
        return this.u16(1, 1) + this.u16(1, 1) * <uint>65536;
    }

    pub u64(a: int, b: int, c: int, d: int): uint {
        if (a != 1 || b != 1 || c != 2 || d != 4) {
            throw "woc world state u64 layout is invalid";
        }
        return this.u32(1, 1, 2) + this.u32(1, 1, 2) * <uint>4294967296;
    }

    pub signed(a: int, b: int, c: int, d: int, e: int): int {
        if (a != 1 || b != 1 || c != 2 || d != 4 || e != 8) {
            throw "woc world state signed layout is invalid";
        }
        var negative = this.byte(1);
        if (negative > <uint>1) {
            throw "woc world state signed flag is invalid";
        }
        var magnitude = this.u64(1, 1, 2, 4);
        if (magnitude > <uint>2147483647) {
            throw "woc world state signed value exceeds int range";
        }
        return negative == <uint>1 ? -<int>magnitude : <int>magnitude;
    }

    pub fixed6(a: int, b: int, c: int, d: int, e: int, f: int): float {
        if (a != 1 || b != 1 || c != 2 || d != 3 || e != 5 || f != 8) {
            throw "woc world state fixed6 layout is invalid";
        }
        var negative = this.byte(1);
        if (negative > <uint>1) {
            throw "woc world state fixed6 sign is invalid";
        }
        var magnitude = this.u64(1, 1, 2, 4);
        var value = <float>magnitude / 1000000.0;
        return negative == <uint>1 && magnitude != <uint>0 ? -value : value;
    }

    pub finish(required: bool): void {
        if (!required || this.offset != this.bytes.length) {
            throw "woc world state contains trailing bytes";
        }
    }
}

class StateWriter {
    pri var bytes: container.Array<uint>;

    pub @constructor() {
        this.bytes = new container.Array<uint>();
    }

    pub byte(value: uint, width: int): void {
        if (width != 1 || value > <uint>255) {
            throw "woc world state byte exceeds 255";
        }
        var target = this.bytes;
        target.add(value);
    }

    pub u16(value: uint, lowBytes: int, highBytes: int): void {
        if (lowBytes != 1 || highBytes != 1) {
            throw "woc world state u16 layout is invalid";
        }
        this.byte(value & <uint>255, 1);
        this.byte((value >> 8) & <uint>255, 1);
    }

    pub u32(value: uint, a: int, b: int, c: int): void {
        if (a != 1 || b != 1 || c != 2) {
            throw "woc world state u32 layout is invalid";
        }
        this.u16(value & <uint>65535, 1, 1);
        this.u16((value >> 16) & <uint>65535, 1, 1);
    }

    pub u64(value: uint, a: int, b: int, c: int, d: int): void {
        if (a != 1 || b != 1 || c != 2 || d != 4) {
            throw "woc world state u64 layout is invalid";
        }
        this.u32(value & <uint>4294967295, 1, 1, 2);
        this.u32(value >> 32, 1, 1, 2);
    }

    pub signed(value: int, a: int, b: int, c: int, d: int, e: int): void {
        if (a != 1 || b != 1 || c != 2 || d != 4 || e != 8) {
            throw "woc world state signed layout is invalid";
        }
        var negative = value < 0;
        this.byte(negative ? <uint>1 : <uint>0, 1);
        this.u64(<uint>(negative ? -value : value), 1, 1, 2, 4);
    }

    pub fixed6(value: float, a: int, b: int, c: int, d: int, e: int, f: int): void {
        if (a != 1 || b != 1 || c != 2 || d != 3 || e != 5 || f != 8) {
            throw "woc world state fixed6 layout is invalid";
        }
        var negative = value < 0.0;
        var magnitude = negative ? -value : value;
        this.byte(negative ? <uint>1 : <uint>0, 1);
        this.u64(<uint>(magnitude * 1000000.0 + 0.5), 1, 1, 2, 4);
    }

    pub finish(required: bool): container.Array<uint> {
        if (!required) {
            throw "woc world state writer was not finalized";
        }
        var copy = new container.Array<uint>();
        var source = this.bytes;
        for (var value in source) {
            copy.add(<uint>value);
        }
        return copy;
    }
}

stateDigest(bytes: container.Array<uint>, marker: int): uint {
    if (marker != 1) {
        throw "woc world state digest marker is invalid";
    }
    var hash: uint = <uint>2166136261;
    for (var byte in bytes) {
        hash = ((hash ^ <uint>byte) * <uint>16777619) & <uint>4294967295;
    }
    return hash;
}

offlineNameLetter(value: uint): bool {
    return (value >= <uint>65 && value <= <uint>90) ||
        (value >= <uint>97 && value <= <uint>122);
}

offlinePlayerNameIsValid(bytes: container.Array<uint>): bool {
    if (bytes.length < 2 || bytes.length > 16 || !offlineNameLetter(<uint>bytes[0])) {
        return false;
    }
    var index = 1;
    while (index < bytes.length) {
        var value = <uint>bytes[index];
        if (!offlineNameLetter(value) && value != <uint>39 && value != <uint>32 && value != <uint>45) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

offlineSkinVariantIsValid(playerClass: uint, skinVariant: uint): bool {
    if (playerClass > <uint>8) {
        return false;
    }
    // The source `changeSkin` path normalizes every class catalog index to
    // 0..7. The WOS offline bootstrap has no asset-materialization restriction.
    return skinVariant < <uint>8;
}

// The codes mirror the generated M5 catalog's two source-pinned quest rows.
// `0` is deliberately an unknown well-formed id: source command dispatch then
// reports an availability error without rejecting its enclosing simulation tick.
offlineQuestCodeFromPayload(
    payloadBytes: container.Array<uint>, payloadOffset: uint, payloadLength: uint,
    acceptsSelection: bool
): int {
    if (payloadLength < <uint>4 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc quest command payload is truncated";
    }
    var declaredLength: uint = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (declaredLength > <uint>256) {
        throw "woc quest command payload length is invalid";
    }
    var identifierBytes = <uint>4 + declaredLength;
    if (!acceptsSelection && identifierBytes != payloadLength) {
        throw "woc quest command payload length is invalid";
    }
    if (acceptsSelection) {
        if (payloadLength < identifierBytes + <uint>1) {
            throw "woc accept quest selection payload is truncated";
        }
        var selectionPresence = <uint>payloadBytes[<int>(payloadOffset + identifierBytes)];
        if (selectionPresence == <uint>0) {
            if (payloadLength != identifierBytes + <uint>1) {
                throw "woc accept quest selection payload has trailing bytes";
            }
        } else if (selectionPresence == <uint>1) {
            if (payloadLength < identifierBytes + <uint>5) {
                throw "woc accept quest selection length is truncated";
            }
            var selectionOffset = payloadOffset + identifierBytes + <uint>1;
            var selectionLength = <uint>payloadBytes[<int>selectionOffset] +
                <uint>payloadBytes[<int>(selectionOffset + <uint>1)] * <uint>256 +
                <uint>payloadBytes[<int>(selectionOffset + <uint>2)] * <uint>65536 +
                <uint>payloadBytes[<int>(selectionOffset + <uint>3)] * <uint>16777216;
            if (selectionLength > <uint>256 ||
                payloadLength != identifierBytes + <uint>5 + selectionLength) {
                throw "woc accept quest selection payload length is invalid";
            }
        } else {
            throw "woc accept quest selection presence is invalid";
        }
    }
    var start = payloadOffset + <uint>4;
    if (declaredLength == <uint>8 &&
        <uint>payloadBytes[<int>start] == <uint>113 &&
        <uint>payloadBytes[<int>(start + <uint>1)] == <uint>95 &&
        <uint>payloadBytes[<int>(start + <uint>2)] == <uint>119 &&
        <uint>payloadBytes[<int>(start + <uint>3)] == <uint>111 &&
        <uint>payloadBytes[<int>(start + <uint>4)] == <uint>108 &&
        <uint>payloadBytes[<int>(start + <uint>5)] == <uint>118 &&
        <uint>payloadBytes[<int>(start + <uint>6)] == <uint>101 &&
        <uint>payloadBytes[<int>(start + <uint>7)] == <uint>115) {
        return 1; // q_wolves
    }
    if (declaredLength == <uint>7 &&
        <uint>payloadBytes[<int>start] == <uint>113 &&
        <uint>payloadBytes[<int>(start + <uint>1)] == <uint>95 &&
        <uint>payloadBytes[<int>(start + <uint>2)] == <uint>98 &&
        <uint>payloadBytes[<int>(start + <uint>3)] == <uint>111 &&
        <uint>payloadBytes[<int>(start + <uint>4)] == <uint>97 &&
        <uint>payloadBytes[<int>(start + <uint>5)] == <uint>114 &&
        <uint>payloadBytes[<int>(start + <uint>6)] == <uint>115) {
        return 2; // q_boars
    }
    return 0;
}

offlineQuestCatalogIndex(code: int): int {
    if (code == 1) { return 1; }
    if (code == 2) { return 0; }
    return -1;
}

offlineQuestStateFor(state: WorldState, code: int): uint {
    if (code == 1) { return state.offlineQuestWolvesState; }
    if (code == 2) { return state.offlineQuestBoarsState; }
    return <uint>0;
}

setOfflineQuestState(state: WorldState, code: int, value: uint): void {
    if (code == 1) { state.offlineQuestWolvesState = value; }
    if (code == 2) { state.offlineQuestBoarsState = value; }
}

offlineQuestObjectiveCount(state: WorldState, code: int): uint {
    if (code == 1) { return state.offlineQuestWolvesObjectiveCount; }
    if (code == 2) { return state.offlineQuestBoarsObjectiveCount; }
    return <uint>0;
}

setOfflineQuestObjectiveCount(state: WorldState, code: int, value: uint): void {
    if (code == 1) { state.offlineQuestWolvesObjectiveCount = value; }
    if (code == 2) { state.offlineQuestBoarsObjectiveCount = value; }
}

offlineQuestPrimaryPlayerIndex(state: WorldState): int {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>1) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

offlineQuestNpcIsNear(state: WorldState, actorIndex: int, code: int): bool {
    var questIndex = offlineQuestCatalogIndex(code);
    if (questIndex < 0 || actorIndex < 0 || actorIndex >= state.entityIds.length) {
        return false;
    }
    var catalog = %import("generated/m5_content_catalog");
    var npcId = catalog.text("quest", questIndex, "giverNpcId");
    var npcIndex = catalog.indexOf("npc", npcId);
    if (npcIndex < 0) {
        throw "woc offline quest giver is absent from the source catalog";
    }
    var expectedTemplate = <uint>(npcIndex + 1);
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>3 &&
            <uint>state.entityTemplates[index] == expectedTemplate) {
            var dx = <float>state.entityX[actorIndex] - <float>state.entityX[index];
            var dz = <float>state.entityZ[actorIndex] - <float>state.entityZ[index];
            // Target quest commands accept the base five-yard interaction radius
            // plus their two-yard NPC tolerance, using horizontal distance only.
            if (dx * dx + dz * dz <= 49.0) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

offlineQuestStateIsValid(state: WorldState): bool {
    if (!state.offlineSessionActive) {
        return state.offlineQuestBoarsState == <uint>0 &&
            state.offlineQuestWolvesState == <uint>0 &&
            state.offlineQuestBoarsObjectiveCount == <uint>0 &&
            state.offlineQuestWolvesObjectiveCount == <uint>0 &&
            state.offlineQuestBoarHideCount == <uint>0 &&
            state.offlineQuestCopper == <uint>0 &&
            state.offlineQuestExperience == <uint>0 &&
            state.offlineQuestLifetimeExperience == <uint>0;
    }
    if (state.offlineQuestBoarsState > <uint>3 || state.offlineQuestWolvesState > <uint>3 ||
        state.offlineQuestBoarsObjectiveCount > <uint>5 ||
        state.offlineQuestWolvesObjectiveCount > <uint>8 ||
        state.offlineQuestLifetimeExperience < state.offlineQuestExperience) {
        return false;
    }
    if ((state.offlineQuestBoarsState == <uint>0 || state.offlineQuestBoarsState == <uint>3) &&
        state.offlineQuestBoarsObjectiveCount != <uint>0) {
        return false;
    }
    if ((state.offlineQuestWolvesState == <uint>0 || state.offlineQuestWolvesState == <uint>3) &&
        state.offlineQuestWolvesObjectiveCount != <uint>0) {
        return false;
    }
    if ((state.offlineQuestBoarsState == <uint>1 && state.offlineQuestBoarsObjectiveCount >= <uint>5) ||
        (state.offlineQuestBoarsState == <uint>2 && state.offlineQuestBoarsObjectiveCount != <uint>5) ||
        (state.offlineQuestWolvesState == <uint>1 && state.offlineQuestWolvesObjectiveCount >= <uint>8) ||
        (state.offlineQuestWolvesState == <uint>2 && state.offlineQuestWolvesObjectiveCount != <uint>8)) {
        return false;
    }
    if ((state.offlineQuestBoarsState == <uint>1 || state.offlineQuestBoarsState == <uint>2) &&
        state.offlineQuestBoarsObjectiveCount !=
            (state.offlineQuestBoarHideCount < <uint>5 ? state.offlineQuestBoarHideCount : <uint>5)) {
        return false;
    }
    return true;
}

// The target re-evaluates collect objectives from the authoritative inventory
// after every inventory mutation. Keep the compact WOS7 field only as the
// persisted derived quest-progress value; it is not a second hide ledger.
syncOfflineQuestBoarHidesFromInventory(state: WorldState): void {
    if (!state.offlineSessionActive) { return; }
    var questState = state.offlineQuestBoarsState;
    if (questState != <uint>1 && questState != <uint>2) {
        return;
    }
    var actorIndex = offlineQuestPrimaryPlayerIndex(state);
    if (actorIndex < 0 || !m5InventoryStateIsValid(state, actorIndex)) {
        return;
    }
    var count = <uint>m5InventoryItemCount(
        state, actorIndex, m5InventoryRules.itemCodeForId("boar_hide")
    );
    if (count > <uint>5) { count = <uint>5; }
    state.offlineQuestBoarHideCount = count;
    state.offlineQuestBoarsObjectiveCount = count;
    state.offlineQuestBoarsState = count == <uint>5 ? <uint>2 : <uint>1;
}

offlineQuestInventoryStateIsValid(state: WorldState): bool {
    if (!state.offlineSessionActive) { return true; }
    var questState = state.offlineQuestBoarsState;
    if (questState != <uint>1 && questState != <uint>2) {
        return state.offlineQuestBoarHideCount == <uint>0;
    }
    var actorIndex = offlineQuestPrimaryPlayerIndex(state);
    if (actorIndex < 0 || !m5InventoryStateIsValid(state, actorIndex)) {
        return false;
    }
    var count = <uint>m5InventoryItemCount(
        state, actorIndex, m5InventoryRules.itemCodeForId("boar_hide")
    );
    if (count > <uint>5) { count = <uint>5; }
    return state.offlineQuestBoarHideCount == count &&
        state.offlineQuestBoarsObjectiveCount == count &&
        state.offlineQuestBoarsState == (count == <uint>5 ? <uint>2 : <uint>1);
}

// WOS47 held collect progress in an isolated counter. Its snapshots cannot
// reveal surplus hides, so retain at most the source objective requirement as
// forced scalar stacks before future updates use the actual inventory.
migrateWos47QuestBoarHidesToInventory(state: WorldState): void {
    if (!state.offlineSessionActive ||
        (state.offlineQuestBoarsState != <uint>1 &&
            state.offlineQuestBoarsState != <uint>2)) {
        return;
    }
    var actorIndex = offlineQuestPrimaryPlayerIndex(state);
    if (actorIndex < 0 || !m5InventoryStateIsValid(state, actorIndex)) {
        throw "woc WOS47 quest inventory migration has no primary player";
    }
    var legacyCount = state.offlineQuestBoarHideCount;
    if (legacyCount > <uint>5) { legacyCount = <uint>5; }
    var boarHideCode = m5InventoryRules.itemCodeForId("boar_hide");
    var currentCount = m5InventoryItemCount(state, actorIndex, boarHideCode);
    if (currentCount < <int>legacyCount) {
        grantM5InventoryItem(
            state, actorIndex, boarHideCode, <int>legacyCount - currentCount
        );
    }
    syncOfflineQuestBoarHidesFromInventory(state);
}

grantOfflineQuestExperience(state: WorldState, actorIndex: int, amount: uint): void {
    var catalog = %import("generated/m5_content_catalog");
    var cap: uint = <uint>9007199254740991;
    if (state.offlineQuestLifetimeExperience < cap - amount) {
        state.offlineQuestLifetimeExperience = state.offlineQuestLifetimeExperience + amount;
    } else {
        state.offlineQuestLifetimeExperience = cap;
    }
    var previousLevel = <int>state.entityLevels[actorIndex];
    var level = previousLevel;
    var experience = state.offlineQuestExperience + amount;
    while (level < catalog.maxLevel() && experience >= <uint>catalog.xpForLevel(level)) {
        experience = experience - <uint>catalog.xpForLevel(level);
        level = level + 1;
    }
    if (level >= catalog.maxLevel()) {
        experience = <uint>0;
    }
    state.entityLevels[actorIndex] = level;
    state.offlineQuestExperience = experience;
    if (level != previousLevel) {
        refreshOfflineKnownAbilities(state, actorIndex);
    }
}

// Source mobXpValue uses Math.round for positive rational values.  Keeping the
// calculation integral preserves that half-up rule across ZrVM targets without
// asking the host for a floating-point rounding primitive.
offlineMobXpRoundPositive(numerator: int, denominator: int): uint {
    return <uint>((numerator * 2 + denominator) / (denominator * 2));
}

offlineMobXpZeroDiff(playerLevel: int): int {
    if (playerLevel <= 7) {
        return 5;
    }
    if (playerLevel <= 9) {
        return 6;
    }
    if (playerLevel <= 15) {
        return 7;
    }
    return 8;
}

// Mirrors src/sim/types.ts::mobXpValue for the retained single-player M8
// combat path. Group bonus, elite multipliers, rested XP and source-only
// progression side effects stay outside this MVP projection.
offlineMobXpValue(mobLevel: int, playerLevel: int): uint {
    var base = 45 + 5 * mobLevel;
    var difference = mobLevel - playerLevel;
    if (difference >= 0) {
        var aboveBonus = difference;
        if (aboveBonus > 4) {
            aboveBonus = 4;
        }
        return offlineMobXpRoundPositive(base * (20 + aboveBonus), 20);
    }
    var zeroDifference = offlineMobXpZeroDiff(playerLevel);
    var belowDifference = -difference;
    if (belowDifference >= zeroDifference) {
        return <uint>0;
    }
    return offlineMobXpRoundPositive(
        base * (zeroDifference - belowDifference), zeroDifference
    );
}

grantOfflineMobKillExperience(state: WorldState, mobIndex: int, actorIndex: int): void {
    if (mobIndex < 0 || actorIndex < 0 || mobIndex >= state.entityLevels.length ||
        actorIndex >= state.entityLevels.length) {
        return;
    }
    var experience = offlineMobXpValue(
        <int>state.entityLevels[mobIndex], <int>state.entityLevels[actorIndex]
    );
    if (experience > <uint>0) {
        grantOfflineQuestExperience(state, actorIndex, experience);
    }
}

// The future combat integration must call this at the authoritative death
// boundary that emits source mob credit. The current M8 command slice exercises
// it directly while the existing M4 combat aggregate remains outside WorldState.
creditOfflineQuestWolfKill(state: WorldState, actorIndex: int): bool {
    if (!state.offlineSessionActive || actorIndex != offlineQuestPrimaryPlayerIndex(state) ||
        state.offlineQuestWolvesState != <uint>1) {
        return false;
    }
    if (state.offlineQuestWolvesObjectiveCount >= <uint>8) {
        return false;
    }
    state.offlineQuestWolvesObjectiveCount = state.offlineQuestWolvesObjectiveCount + <uint>1;
    if (state.offlineQuestWolvesObjectiveCount == <uint>8) {
        state.offlineQuestWolvesState = <uint>2;
    }
    return true;
}

// Compatibility hook for a future loot grant. The caller must first commit an
// authoritative `boar_hide` inventory change; source quest credit itself never
// manufactures a second item ledger.
creditOfflineQuestBoarHide(state: WorldState, actorIndex: int): bool {
    if (!state.offlineSessionActive || actorIndex != offlineQuestPrimaryPlayerIndex(state)) {
        return false;
    }
    var priorCount = state.offlineQuestBoarHideCount;
    var priorState = state.offlineQuestBoarsState;
    syncOfflineQuestBoarHidesFromInventory(state);
    return priorCount != state.offlineQuestBoarHideCount ||
        priorState != state.offlineQuestBoarsState;
}

// The source rolls every ordinary entry in declaration order, but a quest entry
// only consumes its chance draw when an active collector still needs that item.
// The retained Eastbrook rows have no roll groups; six slots cover every M5 row
// while keeping the personal q_boars grant separate from common corpse items.
rollOfflineCorpseCopper(state: WorldState, copper: int): int {
    var minimum = <int>((copper * 3 + 4) / 5);
    var maximum = <int>((copper * 7 + 4) / 5);
    return minimum + <int>(nextAuthoritativeRandomUnit(state) *
        <float>(maximum - minimum + 1));
}

rollOfflineEastbrookCorpseLoot(state: WorldState, mobIndex: int, playerIndex: int): void {
    if (!isOfflineEastbrookLifecycleMob(state, mobIndex) ||
        playerIndex != offlineQuestPrimaryPlayerIndex(state)) {
        return;
    }
    captureOfflineCorpseLootRecipients(state, mobIndex, playerIndex);
    state.entityCorpseQuestItemCodes[mobIndex] = <uint>0;
    state.entityCorpseQuestItemCounts[mobIndex] = <uint>0;
    clearCorpseSharedLoot(state, mobIndex);
    var lootMobIndex = m5CampMobLoot.mobIndexOf(offlineMobTemplateId(state, mobIndex), true);
    var entryIndex = 0;
    var sharedSlot = 0;
    while (entryIndex < m5CampMobLoot.lootEntryCount(lootMobIndex, true)) {
        var itemId = m5CampMobLoot.entryText(lootMobIndex, entryIndex, "item_id", true);
        var questId = m5CampMobLoot.entryText(lootMobIndex, entryIndex, "quest_id", true);
        var shouldRoll = true;
        if (m5CampMobLoot.entryFlag(lootMobIndex, entryIndex, "has_quest_id", true)) {
            var boarHideCode = m5InventoryRules.itemCodeForId("boar_hide");
            shouldRoll = questId == "q_boars" && itemId == "boar_hide" &&
                state.offlineQuestBoarsState == <uint>1 &&
                m5InventoryItemCount(state, playerIndex, boarHideCode) < 5;
        }
        if (shouldRoll && nextAuthoritativeRandomUnit(state) <
                m5CampMobLoot.entryMetric(lootMobIndex, entryIndex, "chance", true)) {
            if (m5CampMobLoot.entryFlag(lootMobIndex, entryIndex, "has_copper", true)) {
                state.entityCorpseCopper[mobIndex] = <int>state.entityCorpseCopper[mobIndex] +
                    rollOfflineCorpseCopper(
                        state,
                        <int>m5CampMobLoot.entryMetric(
                            lootMobIndex, entryIndex, "copper", true
                        )
                    );
            }
            if (questId == "q_boars" && itemId == "boar_hide") {
                state.entityCorpseQuestItemCodes[mobIndex] =
                    m5InventoryRules.itemCodeForId("boar_hide");
                state.entityCorpseQuestItemCounts[mobIndex] = <uint>1;
            } else if (itemId != "" && sharedSlot < corpseSharedLootSlotCount()) {
                var sharedIndex = corpseSharedLootSlotIndex(mobIndex, sharedSlot);
                state.entityCorpseSharedItemCodes[sharedIndex] =
                    m5InventoryRules.itemCodeForId(itemId);
                state.entityCorpseSharedItemCounts[sharedIndex] = <uint>1;
                sharedSlot = sharedSlot + 1;
            }
        }
        entryIndex = entryIndex + 1;
    }
    state.entityLootable[mobIndex] = hasOfflineCorpseLoot(state, mobIndex);
}

// Native Loot payloads are one little-endian u64 target id. The reduced single
// player runtime has no party/FFA alternative. Copper is collected first, then
// the source-order personal quest slot and shared slots; full bags leave the
// corresponding item on the corpse while currency always transfers.
applyOfflineCorpseLootCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>8 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset ||
        <bool>state.entityDead[actorIndex]) {
        return;
    }
    var targetId: uint = <uint>0;
    var payloadIndex: uint = <uint>0;
    var multiplier: uint = <uint>1;
    while (payloadIndex < <uint>8) {
        targetId = targetId +
            <uint>payloadBytes[<int>(payloadOffset + payloadIndex)] * multiplier;
        multiplier = multiplier * <uint>256;
        payloadIndex = payloadIndex + <uint>1;
    }
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        !<bool>state.entityDead[targetIndex] || !<bool>state.entityLootable[targetIndex]) {
        return;
    }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[actorIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[actorIndex];
    if (dx * dx + dz * dz > 25.0) {
        return;
    }
    if (!corpseQuestLootStateIsValid(state, targetIndex) ||
        !corpseSharedLootStateIsValid(state, targetIndex)) {
        throw "woc corpse loot row is invalid";
    }
    if (<int>state.entityCorpseCopper[targetIndex] > 0) {
        var corpseCopper = <int>state.entityCorpseCopper[targetIndex];
        if (!tryAwardOfflineCopperByFairSplit(state, targetIndex, corpseCopper)) {
            state.entityInventoryCopper[actorIndex] =
                <int>state.entityInventoryCopper[actorIndex] + corpseCopper;
        }
        state.entityCorpseCopper[targetIndex] = 0;
    }
    var itemCode = <uint>state.entityCorpseQuestItemCodes[targetIndex];
    if (itemCode != <uint>0 && m5InventoryCanAddItem(state, actorIndex, itemCode, 1)) {
        grantM5InventoryItem(state, actorIndex, itemCode, 1);
        state.entityCorpseQuestItemCodes[targetIndex] = <uint>0;
        state.entityCorpseQuestItemCounts[targetIndex] = <uint>0;
    }
    var sharedSlot = 0;
    while (sharedSlot < corpseSharedLootSlotCount()) {
        var sharedIndex = corpseSharedLootSlotIndex(targetIndex, sharedSlot);
        var sharedItemCode = <uint>state.entityCorpseSharedItemCodes[sharedIndex];
        var startedRoll = sharedItemCode != <uint>0 &&
            startOfflineNeedGreedRoll(state, targetIndex, sharedItemCode);
        var awardedByRoundRobin = sharedItemCode != <uint>0 && !startedRoll &&
            tryAwardOfflineItemByRoundRobin(state, targetIndex, sharedItemCode);
        if (sharedItemCode != <uint>0 &&
            (startedRoll || awardedByRoundRobin ||
                m5InventoryCanAddItem(state, actorIndex, sharedItemCode, 1))) {
            if (!startedRoll && !awardedByRoundRobin) {
                grantM5InventoryItem(state, actorIndex, sharedItemCode, 1);
            }
            state.entityCorpseSharedItemCodes[sharedIndex] = <uint>0;
            state.entityCorpseSharedItemCounts[sharedIndex] = <uint>0;
        }
        sharedSlot = sharedSlot + 1;
    }
    state.entityLootable[targetIndex] = hasOfflineCorpseLoot(state, targetIndex);
    if (<uint>state.entityTargetIds[actorIndex] == targetId) {
        state.entityTargetIds[actorIndex] = <uint>0;
    }
}

// Source autoloot delegates to its same corpse-distribution core after silent
// eligibility checks. The retained offline world has no raid or FFA branches,
// and this reducer already performs every representable dead/range/loot gate
// without producing an error side channel, so delegation is exact in scope.
applyOfflineAutoLootCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    applyOfflineCorpseLootCommand(
        state, actorIndex, payloadOffset, payloadLength, payloadBytes
    );
}

m5EquipmentSlotFromWireCode(code: uint): string {
    if (code == <uint>1) { return "mainhand"; }
    if (code == <uint>2) { return "offhand"; }
    if (code == <uint>3) { return "helmet"; }
    if (code == <uint>4) { return "neck"; }
    if (code == <uint>5) { return "shoulder"; }
    if (code == <uint>6) { return "chest"; }
    if (code == <uint>7) { return "waist"; }
    if (code == <uint>8) { return "legs"; }
    if (code == <uint>9) { return "gloves"; }
    if (code == <uint>10) { return "feet"; }
    if (code == <uint>11) { return "ring1"; }
    if (code == <uint>12) { return "ring2"; }
    return "";
}

applyM5EquipItemCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>5 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc equip item payload is truncated";
    }
    var itemLength = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (itemLength > <uint>256 || payloadLength != itemLength + <uint>5) {
        throw "woc equip item identifier payload is invalid";
    }
    var slotCode = <uint>payloadBytes[<int>(payloadOffset + <uint>4 + itemLength)];
    if (slotCode > <uint>12) { throw "woc equip item slot payload is invalid"; }
    var itemCode = m5InventoryItemCodeFromPayload(
        payloadOffset + <uint>4, itemLength, payloadBytes
    );
    if (itemCode == <uint>0) { return; }
    var requestedSlot = m5EquipmentSlotFromWireCode(slotCode);
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    var actualSlot = m5Equipment.slotForItemIndex(itemIndex);
    if (actualSlot == "" || (slotCode != <uint>0 && requestedSlot != actualSlot)) {
        return;
    }
    equipM5InventoryItem(state, actorIndex, itemCode);
}

applyInventoryMoveCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>8 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc inventory move payload is invalid";
    }
    var protocolBinary = %import("protocol/binary");
    var from = protocolBinary.readI32LeAt(payloadBytes, payloadOffset, <uint>4);
    var to = protocolBinary.readI32LeAt(
        payloadBytes, payloadOffset + <uint>4, <uint>4
    );
    moveM5InventoryStackToCell(state, actorIndex, from, to);
}

applyEmoteCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>1 || payloadOffset >= <uint>payloadBytes.length) {
        return;
    }
    var emoteCode = <uint>payloadBytes[<int>payloadOffset];
    if (emoteCode < <uint>1 || emoteCode > <uint>13) { return; }
    state.entityOverheadEmoteCodes[actorIndex] = emoteCode;
    // Source OVERHEAD_EMOTE_DURATION is exactly 3.2 seconds.
    state.entityOverheadEmoteUntil[actorIndex] = state.timeMicros + <uint>3200000;
    state.entityOverheadEmoteSequences[actorIndex] =
        <uint>state.entityOverheadEmoteSequences[actorIndex] + <uint>1;
}

offlineGatheringStateIsValid(state: WorldState): bool {
    if (state.offlineGatheringProficiencies.length != harvestNodeState.professionCount() ||
        state.offlinePendingGatheringGains.length != harvestNodeState.professionCount() ||
        state.offlineGatherNodeReadyAtMicros.length != harvestNodeState.nodeCount() ||
        state.offlineGatherVisitedMask > <uint>511) {
        return false;
    }
    var professionIndex = 0;
    while (professionIndex < harvestNodeState.professionCount()) {
        if (<uint>state.offlineGatheringProficiencies[professionIndex] > <uint>4294967295 ||
            <uint>state.offlinePendingGatheringGains[professionIndex] > <uint>4294967295) {
            return false;
        }
        professionIndex = professionIndex + 1;
    }
    if (state.offlineGatherResultSequence == <uint>0) {
        return state.offlineGatherResultNodeCode == <uint>0 &&
            state.offlineGatherResultProfessionCode == <uint>0 &&
            state.offlineGatherResultItemCode == <uint>0 &&
            state.offlineGatherResultRarityCode == <uint>0;
    }
    if (state.offlineGatherResultNodeCode < <uint>1 ||
        state.offlineGatherResultNodeCode > <uint>harvestNodeState.nodeCount() ||
        state.offlineGatherResultRarityCode < <uint>1 ||
        state.offlineGatherResultRarityCode > <uint>5) {
        return false;
    }
    var resultNodeIndex = <int>state.offlineGatherResultNodeCode - 1;
    return state.offlineGatherResultProfessionCode ==
            harvestNodeState.professionCode(resultNodeIndex) &&
        state.offlineGatherResultItemCode == harvestNodeState.itemCode(resultNodeIndex);
}

offlineHarvestNodeIndexFromPayload(
    payloadOffset: uint, payloadLength: uint, payloadBytes: container.Array<uint>
): int {
    if (payloadLength < <uint>4 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        return -1;
    }
    var declaredLength = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (declaredLength != payloadLength - <uint>4) return -1;
    var nodeIndex = 0;
    while (nodeIndex < harvestNodeState.nodeCount()) {
        if (declaredLength == <uint>harvestNodeState.nodeIdUtf8Length(nodeIndex)) {
            var byteIndex: uint = <uint>0;
            var matches = true;
            while (byteIndex < declaredLength) {
                if (<uint>payloadBytes[<int>(payloadOffset + <uint>4 + byteIndex)] !=
                    harvestNodeState.nodeIdUtf8Byte(nodeIndex, <int>byteIndex)) {
                    matches = false;
                    break;
                }
                byteIndex = byteIndex + <uint>1;
            }
            if (matches) return nodeIndex;
        }
        nodeIndex = nodeIndex + 1;
    }
    return -1;
}

offlineDeedTitleCodeFromPayload(
    payloadOffset: uint, payloadLength: uint, payloadBytes: container.Array<uint>
): int {
    if (payloadLength < <uint>1 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        return -1;
    }
    var presence = <uint>payloadBytes[<int>payloadOffset];
    if (presence == <uint>0) return payloadLength == <uint>1 ? 0 : -1;
    if (presence != <uint>1 || payloadLength < <uint>5) return -1;
    var declaredLength = <uint>payloadBytes[<int>(payloadOffset + <uint>1)] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>4)] * <uint>16777216;
    if (declaredLength > <uint>256 || declaredLength != payloadLength - <uint>5) {
        return -1;
    }
    var deedIndex = 0;
    while (deedIndex < deedTitleState.deedCount()) {
        if (declaredLength == <uint>deedTitleState.deedIdUtf8Length(deedIndex)) {
            var byteIndex: uint = <uint>0;
            var matches = true;
            while (byteIndex < declaredLength) {
                if (<uint>payloadBytes[<int>(payloadOffset + <uint>5 + byteIndex)] !=
                    deedTitleState.deedIdUtf8Byte(deedIndex, <int>byteIndex)) {
                    matches = false;
                    break;
                }
                byteIndex = byteIndex + <uint>1;
            }
            if (matches) return deedIndex + 1;
        }
        deedIndex = deedIndex + 1;
    }
    return -1;
}

applyOfflineDeedSetTitleCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (!offlineDeedTitleStateIsValid(state) || !state.offlineSessionActive ||
        actorIndex != offlineQuestPrimaryPlayerIndex(state)) {
        return;
    }
    var requested = offlineDeedTitleCodeFromPayload(
        payloadOffset, payloadLength, payloadBytes
    );
    if (requested < 0) return;
    var requestedCode = <uint>requested;
    var earned = requestedCode != <uint>0 &&
        <bool>state.offlineDeedsEarned[requested - 1];
    var selected = deedTitleState.titleSelectionResult(
        state.offlineActiveTitleDeedCode, requestedCode, earned
    );
    state.offlineActiveTitleDeedCode = selected;
    state.entityActiveTitleDeedCodes[actorIndex] = selected;
}

offlineTownFocusAllocation(state: WorldState): townFocusWireState.WireFocusAllocation {
    var allocation = new townFocusWireState.WireFocusAllocation();
    allocation.componentBytes = state.offlineTownFocusComponentBytes;
    allocation.componentOffsets = state.offlineTownFocusComponentOffsets;
    allocation.points = state.offlineTownFocusPoints;
    return allocation;
}

commitOfflineTownFocusAllocation(
    state: WorldState, allocation: townFocusWireState.WireFocusAllocation
): void {
    state.offlineTownFocusComponentBytes = allocation.componentBytes;
    state.offlineTownFocusComponentOffsets = allocation.componentOffsets;
    state.offlineTownFocusPoints = allocation.points;
}

townFocusPayloadU16(
    bytes: container.Array<uint>, cursor: uint, payloadEnd: uint
): uint {
    if (cursor > payloadEnd || payloadEnd - cursor < <uint>2) {
        throw "woc town-focus u16 payload is truncated";
    }
    return <uint>bytes[<int>cursor] +
        <uint>bytes[<int>(cursor + <uint>1)] * <uint>256;
}

townFocusPayloadU32(
    bytes: container.Array<uint>, cursor: uint, payloadEnd: uint
): uint {
    if (cursor > payloadEnd || payloadEnd - cursor < <uint>4) {
        throw "woc town-focus u32 payload is truncated";
    }
    return <uint>bytes[<int>cursor] +
        <uint>bytes[<int>(cursor + <uint>1)] * <uint>256 +
        <uint>bytes[<int>(cursor + <uint>2)] * <uint>65536 +
        <uint>bytes[<int>(cursor + <uint>3)] * <uint>16777216;
}

townFocusAllocationFromPayload(
    payloadOffset: uint, payloadLength: uint, payloadBytes: container.Array<uint>
): townFocusWireState.WireFocusAllocation {
    if (payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset ||
        payloadLength < <uint>2) {
        throw "woc town-focus payload bounds are invalid";
    }
    var payloadEnd = payloadOffset + payloadLength;
    var allocation = new townFocusWireState.WireFocusAllocation();
    var entryCount = townFocusPayloadU16(payloadBytes, payloadOffset, payloadEnd);
    if (entryCount > <uint>256) {
        throw "woc town-focus entry count exceeds transport limit";
    }
    var cursor = payloadOffset + <uint>2;
    var entryIndex: uint = <uint>0;
    while (entryIndex < entryCount) {
        var componentLength = townFocusPayloadU32(payloadBytes, cursor, payloadEnd);
        cursor = cursor + <uint>4;
        if (componentLength > <uint>256 || cursor > payloadEnd ||
            componentLength > payloadEnd - cursor ||
            payloadEnd - cursor - componentLength < <uint>4) {
            throw "woc town-focus component payload is invalid";
        }
        var componentEnd = cursor + componentLength;
        while (cursor < componentEnd) {
            allocation.componentBytes.add(<uint>payloadBytes[<int>cursor]);
            cursor = cursor + <uint>1;
        }
        allocation.componentOffsets.add(<uint>allocation.componentBytes.length);
        var pointBits = townFocusPayloadU32(payloadBytes, cursor, payloadEnd);
        allocation.points.add(
            pointBits > <uint>2147483647 ? -1 : <int>pointBits
        );
        cursor = cursor + <uint>4;
        entryIndex = entryIndex + <uint>1;
    }
    if (cursor != payloadEnd) {
        throw "woc town-focus payload has trailing bytes";
    }
    return allocation;
}

applyOfflineSetTownFocusCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (!state.offlineSessionActive || actorIndex != offlineQuestPrimaryPlayerIndex(state)) {
        return;
    }
    var previous = offlineTownFocusAllocation(state);
    if (!townFocusWireState.storedAllocationValid(previous)) {
        throw "woc stored town-focus allocation is invalid";
    }
    var requested = townFocusAllocationFromPayload(
        payloadOffset, payloadLength, payloadBytes
    );
    var zoneIndex = terrainContent.zoneIndexAt(<float>state.entityZ[actorIndex], true);
    var inTown = townFocusState.isInTownHub(
        <float>state.entityX[actorIndex], <float>state.entityZ[actorIndex],
        terrainContent.zoneHubX(zoneIndex, true),
        terrainContent.zoneHubZ(zoneIndex, true),
        terrainContent.zoneHubRadius(zoneIndex, true)
    );
    var result = townFocusWireState.setTownFocus(previous, requested, inTown);
    if (result.ok) {
        commitOfflineTownFocusAllocation(state, result.allocation);
    }
}

offlineCraftStateIsValid(state: WorldState): bool {
    if (state.offlineCraftThrottleWindowStartMicros > state.timeMicros ||
        state.offlineCraftThrottleCount > craftItemState.throttleMaximum() ||
        state.offlineCraftResultRecipeBytes.length > 256 ||
        !craftItemState.utf8RangeValid(
            state.offlineCraftResultRecipeBytes, <uint>0,
            <uint>state.offlineCraftResultRecipeBytes.length
        ) || state.offlineCraftsPerformed > state.offlineCraftResultSequence) {
        return false;
    }
    if (state.offlineCraftResultSequence == <uint>0) {
        return state.offlineCraftResultRecipeBytes.length == 0 &&
            state.offlineCraftResultReasonCode == <uint>0 &&
            state.offlineCraftResultItemCode == <uint>0 &&
            state.offlineCraftResultCount == <uint>0 &&
            state.offlineCraftResultQualityCode == <uint>0 &&
            !state.offlineCraftResultMasterwork;
    }
    var recipeCode = craftItemState.recipeCodeFromBytes(
        state.offlineCraftResultRecipeBytes
    );
    if (recipeCode < 0) return false;
    if (state.offlineCraftResultReasonCode == craftItemState.reasonSuccess()) {
        return recipeCode == craftItemState.minorHealingPotionRecipeCode() &&
            state.offlineCraftResultItemCode == craftItemState.resultItemCode(recipeCode) &&
            state.offlineCraftResultCount == craftItemState.resultCount(recipeCode) &&
            state.offlineCraftResultQualityCode == craftItemState.resultQualityCode(recipeCode) &&
            !state.offlineCraftResultMasterwork;
    }
    if (state.offlineCraftResultItemCode != <uint>0 ||
        state.offlineCraftResultCount != <uint>0 ||
        state.offlineCraftResultQualityCode != <uint>0 ||
        state.offlineCraftResultMasterwork) return false;
    if (state.offlineCraftResultReasonCode == craftItemState.reasonUnknownRecipe()) {
        return recipeCode == craftItemState.unknownRecipeCode();
    }
    if (state.offlineCraftResultReasonCode == craftItemState.reasonInsufficientMaterials() ||
        state.offlineCraftResultReasonCode == craftItemState.reasonThrottled()) {
        return recipeCode == craftItemState.minorHealingPotionRecipeCode();
    }
    return state.offlineCraftResultReasonCode ==
            craftItemState.reasonUnsupportedInstanceOutput() &&
        recipeCode == craftItemState.ritualVestmentsRecipeCode();
}

beginOfflineCraftResult(
    state: WorldState, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    state.offlineCraftResultRecipeBytes = new container.Array<uint>();
    var cursor = payloadOffset + <uint>4;
    var end = payloadOffset + payloadLength;
    while (cursor < end) {
        state.offlineCraftResultRecipeBytes.add(<uint>payloadBytes[<int>cursor]);
        cursor = cursor + <uint>1;
    }
    state.offlineCraftResultSequence = state.offlineCraftResultSequence + <uint>1;
    state.offlineCraftResultReasonCode = craftItemState.reasonSuccess();
    state.offlineCraftResultItemCode = <uint>0;
    state.offlineCraftResultCount = <uint>0;
    state.offlineCraftResultQualityCode = <uint>0;
    state.offlineCraftResultMasterwork = false;
}

offlineCraftHasMaterials(state: WorldState, actorIndex: int, recipeCode: int): bool {
    var reagentIndex = 0;
    while (reagentIndex < craftItemState.reagentCount(recipeCode)) {
        if (m5InventoryItemCount(
                state, actorIndex, craftItemState.reagentItemCode(recipeCode, reagentIndex)
            ) < craftItemState.reagentAmount(recipeCode, reagentIndex)) return false;
        reagentIndex = reagentIndex + 1;
    }
    return true;
}

consumeOfflineCraftMaterials(state: WorldState, actorIndex: int, recipeCode: int): void {
    var reagentIndex = 0;
    while (reagentIndex < craftItemState.reagentCount(recipeCode)) {
        var amount = craftItemState.reagentAmount(recipeCode, reagentIndex);
        if (removeM5InventoryItem(
                state, actorIndex, craftItemState.reagentItemCode(recipeCode, reagentIndex), amount
            ) != amount) throw "woc craft-item atomic reagent debit failed";
        reagentIndex = reagentIndex + 1;
    }
}

applyOfflineCraftItemCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (!offlineCraftStateIsValid(state) || !state.offlineSessionActive ||
        actorIndex != offlineQuestPrimaryPlayerIndex(state)) return;
    var recipeCode = craftItemState.recipeCodeFromPayload(
        payloadOffset, payloadLength, payloadBytes
    );
    if (recipeCode == craftItemState.malformedPayloadCode()) return;
    beginOfflineCraftResult(state, payloadOffset, payloadLength, payloadBytes);
    if (recipeCode == craftItemState.unknownRecipeCode()) {
        state.offlineCraftResultReasonCode = craftItemState.reasonUnknownRecipe();
        return;
    }
    if (recipeCode == craftItemState.ritualVestmentsRecipeCode()) {
        state.offlineCraftResultReasonCode = craftItemState.reasonUnsupportedInstanceOutput();
        return;
    }
    if (!offlineCraftHasMaterials(state, actorIndex, recipeCode)) {
        state.offlineCraftResultReasonCode = craftItemState.reasonInsufficientMaterials();
        return;
    }
    if (state.timeMicros - state.offlineCraftThrottleWindowStartMicros >=
            craftItemState.throttleWindowMicros()) {
        state.offlineCraftThrottleWindowStartMicros = state.timeMicros;
        state.offlineCraftThrottleCount = <uint>0;
    }
    if (state.offlineCraftThrottleCount >= craftItemState.throttleMaximum()) {
        state.offlineCraftResultReasonCode = craftItemState.reasonThrottled();
        return;
    }

    var fee = craftItemState.goldFeeCopper(recipeCode);
    var copper = <int>state.entityInventoryCopper[actorIndex];
    state.entityInventoryCopper[actorIndex] = copper > fee ? copper - fee : 0;
    consumeOfflineCraftMaterials(state, actorIndex, recipeCode);
    nextAuthoritativeRandomUnit(state);
    var resultItemCode = craftItemState.resultItemCode(recipeCode);
    var resultCount = craftItemState.resultCount(recipeCode);
    grantM5InventoryItem(state, actorIndex, resultItemCode, <int>resultCount);
    var skillGain = craftItemState.craftSkillGain(recipeCode);
    state.offlineCraftAlchemySkill = skillGain > <uint>4294967295 -
            state.offlineCraftAlchemySkill ? <uint>4294967295 :
        state.offlineCraftAlchemySkill + skillGain;
    state.offlineCraftThrottleCount = state.offlineCraftThrottleCount + <uint>1;
    state.offlineCraftsPerformed = state.offlineCraftsPerformed + <uint>1;
    var gainedExperience = craftItemState.craftExperience(
        recipeCode, <int>state.entityLevels[actorIndex]
    );
    if (gainedExperience > 0) {
        grantOfflineQuestExperience(state, actorIndex, <uint>gainedExperience);
    }
    // The retained quest pair has no recipe objective, so the source quest
    // hook is an exact no-op in this offline projection.
    state.offlineCraftResultItemCode = resultItemCode;
    state.offlineCraftResultCount = resultCount;
    state.offlineCraftResultQualityCode = craftItemState.resultQualityCode(recipeCode);
}

applyOfflineHarvestNodeCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (!offlineGatheringStateIsValid(state) || !state.offlineSessionActive ||
        actorIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[actorIndex]) {
        return;
    }
    var nodeIndex = offlineHarvestNodeIndexFromPayload(
        payloadOffset, payloadLength, payloadBytes
    );
    if (nodeIndex < 0) return;
    var deltaX = <float>state.entityX[actorIndex] - harvestNodeState.nodeX(nodeIndex);
    var deltaZ = <float>state.entityZ[actorIndex] - harvestNodeState.nodeZ(nodeIndex);
    if (deltaX * deltaX + deltaZ * deltaZ > harvestNodeState.interactRangeSquared() ||
        state.timeMicros < <uint>state.offlineGatherNodeReadyAtMicros[nodeIndex]) {
        return;
    }
    var itemCode = harvestNodeState.itemCode(nodeIndex);
    if (!m5InventoryCanAddItem(state, actorIndex, itemCode, 1)) return;

    var professionIndex = harvestNodeState.professionIndex(nodeIndex);
    var professionCode = harvestNodeState.professionCode(nodeIndex);
    state.offlineGatherNodeReadyAtMicros[nodeIndex] =
        state.timeMicros + harvestNodeState.respawnMicros(nodeIndex);
    var rarityCode = harvestNodeState.rarityCode(
        <uint>state.offlineGatheringProficiencies[professionIndex],
        nextAuthoritativeRandomUnit(state)
    );
    if (<uint>state.offlinePendingGatheringGains[professionIndex] < <uint>4294967295) {
        state.offlinePendingGatheringGains[professionIndex] =
            <uint>state.offlinePendingGatheringGains[professionIndex] + <uint>1;
    }
    grantM5InventoryItem(state, actorIndex, itemCode, 1);
    // The retained q_boars/q_wolves ledger has no gather objective, so the
    // source quest-credit hook is an exact no-op for this offline projection.
    state.offlineGatherVisitedMask = state.offlineGatherVisitedMask |
        harvestNodeState.visitedBit(nodeIndex);
    var gainedExperience = harvestNodeState.gatherExperience(
        nodeIndex, <int>state.entityLevels[actorIndex]
    );
    if (gainedExperience > 0) {
        grantOfflineQuestExperience(state, actorIndex, <uint>gainedExperience);
    }
    state.offlineGatherResultSequence = state.offlineGatherResultSequence + <uint>1;
    state.offlineGatherResultNodeCode = <uint>(nodeIndex + 1);
    state.offlineGatherResultProfessionCode = professionCode;
    state.offlineGatherResultItemCode = itemCode;
    state.offlineGatherResultRarityCode = rarityCode;
}

drainOfflineGatheringGains(state: WorldState): void {
    var professionIndex = 0;
    while (professionIndex < harvestNodeState.professionCount()) {
        var current = <uint>state.offlineGatheringProficiencies[professionIndex];
        var pending = <uint>state.offlinePendingGatheringGains[professionIndex];
        state.offlineGatheringProficiencies[professionIndex] =
            pending > <uint>4294967295 - current ? <uint>4294967295 : current + pending;
        state.offlinePendingGatheringGains[professionIndex] = <uint>0;
        professionIndex = professionIndex + 1;
    }
}

expireOverheadEmotes(state: WorldState): void {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityOverheadEmoteCodes[index] != <uint>0 &&
            state.timeMicros >= <uint>state.entityOverheadEmoteUntil[index]) {
            state.entityOverheadEmoteCodes[index] = <uint>0;
            state.entityOverheadEmoteUntil[index] = <uint>0;
        }
        index = index + 1;
    }
}

applyM5UnequipItemCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>1 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc unequip item payload is invalid";
    }
    var slotCode = <uint>payloadBytes[<int>payloadOffset];
    if (slotCode < <uint>1 || slotCode > <uint>12) {
        throw "woc unequip item slot payload is invalid";
    }
    var slot = m5EquipmentSlotFromWireCode(slotCode);
    // WOS71 persists this exact retained paperdoll subset. Other live source
    // slots are valid transport values but cannot mutate an absent state row.
    if (slot != "mainhand" && slot != "helmet" && slot != "feet") { return; }
    unequipM5InventoryItem(state, actorIndex, slot);
}

applyTelemetryNoopCommand(
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>6 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc telemetry payload is truncated";
    }
    var payloadEnd = payloadOffset + payloadLength;
    var cursor = payloadOffset;
    var kindLength = <uint>payloadBytes[<int>cursor] +
        <uint>payloadBytes[<int>(cursor + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(cursor + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(cursor + <uint>3)] * <uint>16777216;
    cursor = cursor + <uint>4;
    if (kindLength > <uint>256 || cursor > payloadEnd ||
        kindLength > payloadEnd - cursor) {
        throw "woc telemetry kind payload is invalid";
    }
    cursor = cursor + kindLength;
    if (cursor > payloadEnd || payloadEnd - cursor < <uint>2) {
        throw "woc telemetry field count is truncated";
    }
    var fieldCount = <uint>payloadBytes[<int>cursor] +
        <uint>payloadBytes[<int>(cursor + <uint>1)] * <uint>256;
    cursor = cursor + <uint>2;
    if (fieldCount > <uint>256) {
        throw "woc telemetry has too many fields";
    }

    var keyOffsets = new container.Array<uint>();
    var keyLengths = new container.Array<uint>();
    var binary = %import("protocol/binary");
    var fieldIndex: uint = <uint>0;
    while (fieldIndex < fieldCount) {
        if (cursor > payloadEnd || payloadEnd - cursor < <uint>4) {
            throw "woc telemetry field key length is truncated";
        }
        var keyLength = <uint>payloadBytes[<int>cursor] +
            <uint>payloadBytes[<int>(cursor + <uint>1)] * <uint>256 +
            <uint>payloadBytes[<int>(cursor + <uint>2)] * <uint>65536 +
            <uint>payloadBytes[<int>(cursor + <uint>3)] * <uint>16777216;
        cursor = cursor + <uint>4;
        if (keyLength > <uint>256 || cursor > payloadEnd ||
            keyLength > payloadEnd - cursor ||
            payloadEnd - cursor - keyLength < <uint>8) {
            throw "woc telemetry field payload is invalid";
        }

        var priorIndex = 0;
        while (priorIndex < keyOffsets.length) {
            if (<uint>keyLengths[priorIndex] == keyLength) {
                var equal = true;
                var keyByte: uint = <uint>0;
                while (keyByte < keyLength && equal) {
                    if (<uint>payloadBytes[<int>(cursor + keyByte)] !=
                        <uint>payloadBytes[<int>(<uint>keyOffsets[priorIndex] + keyByte)]) {
                        equal = false;
                    }
                    keyByte = keyByte + <uint>1;
                }
                if (equal) { throw "woc telemetry repeats a field key"; }
            }
            priorIndex = priorIndex + 1;
        }
        keyOffsets.add(cursor);
        keyLengths.add(keyLength);
        cursor = cursor + keyLength;
        var fieldValue = binary.readF64LeAt(payloadBytes, cursor, <uint>8);
        if (fieldValue != fieldValue || fieldValue - fieldValue != 0.0) {
            throw "woc telemetry field value must be finite";
        }
        cursor = cursor + <uint>8;
        fieldIndex = fieldIndex + <uint>1;
    }
    if (cursor - payloadOffset != payloadLength) {
        throw "woc telemetry payload has trailing bytes";
    }
}

// The M5 catalog owns item identity and scalar effects. Elixir use remains
// outside this reducer until generic-aura state is persisted; every other
// current M5 `useItem` branch has a retained inventory/equipment/consumer owner.
applyOfflineUseItemCommand(
    state: WorldState, actorIndex: int, payloadOffset: uint, payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>4 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc use item payload is truncated";
    }
    var itemLength = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (itemLength > <uint>256 || payloadLength != itemLength + <uint>4) {
        throw "woc use item identifier payload is invalid";
    }
    var itemCode = m5InventoryItemCodeFromPayload(
        payloadOffset + <uint>4, itemLength, payloadBytes
    );
    if (itemCode == <uint>0 || <bool>state.entityDead[actorIndex] ||
        m5InventoryItemCount(state, actorIndex, itemCode) <= 0) {
        return;
    }
    var itemIndex = m5InventoryRules.itemIndexFromCode(itemCode);
    var catalog = %import("generated/m5_content_catalog");
    var mechChromaIndex = offlineMechChromaIndexForItemIndex(itemIndex);
    if (mechChromaIndex >= 0) {
        if (!offlineMechChromaOwnershipStateIsValid(state) ||
            removeM5InventoryItem(state, actorIndex, itemCode, 1) != 1) {
            return;
        }
        state.offlineMechChromaOwned[mechChromaIndex] = true;
        state.entitySkinCatalogs[actorIndex] = <uint>2;
        state.entitySkinIndices[actorIndex] =
            <uint>catalog.mechChromaSkinIndex(mechChromaIndex);
        if (!presentationIdentityIsValid(state, actorIndex)) {
            throw "woc mech chroma item produced invalid presentation identity";
        }
        return;
    }
    var kind = catalog.text("item", itemIndex, "kind");
    if (kind == "weapon" || kind == "armor" || kind == "held_offhand") {
        equipM5InventoryItem(state, actorIndex, itemCode);
        return;
    }
    if (kind == "bag") {
        equipM5InventoryBag(state, actorIndex, itemCode, -1);
        return;
    }
    if (kind == "food" || kind == "drink") {
        var swimming = motionWorld.isSwimmingInBuiltinWorld(
            <float>state.entityX[actorIndex],
            <float>state.entityZ[actorIndex],
            <float>state.entityY[actorIndex],
            state.worldSeed,
            true
        );
        if (<bool>state.entityInCombat[actorIndex] || swimming ||
            removeM5InventoryItem(state, actorIndex, itemCode, 1) != 1) {
            return;
        }
        state.entitySitting[actorIndex] = true;
        if (kind == "food") {
            state.entityEatingItemCodes[actorIndex] = itemCode;
            state.entityEatingHpPerTwoSeconds[actorIndex] =
                <int>(catalog.metric("item", itemIndex, "foodHp") / 9.0 + 0.5);
            state.entityEatingRemaining[actorIndex] = 18.0;
        } else {
            state.entityDrinkingItemCodes[actorIndex] = itemCode;
            state.entityDrinkingManaPerTwoSeconds[actorIndex] =
                <int>(catalog.metric("item", itemIndex, "drinkMana") / 9.0 + 0.5);
            state.entityDrinkingRemaining[actorIndex] = 18.0;
        }
        if (!consumableStateIsValid(state, actorIndex)) {
            throw "woc item use produced invalid consumable state";
        }
        return;
    }
    if (kind != "potion") { return; }
    var nowSeconds = <float>state.timeMicros / 1000000.0;
    if (nowSeconds < <float>state.entityPotionCooldownUntil[actorIndex]) {
        return;
    }
    var restoreHp = <int>catalog.metric("item", itemIndex, "potionHp");
    var restoreMana = <int>catalog.metric("item", itemIndex, "potionMana");
    var restoresHp = restoreHp > 0 &&
        <int>state.entityHp[actorIndex] < <int>state.entityMaxHp[actorIndex];
    var restoresMana = restoreMana > 0 &&
        <uint>state.entityResourceKinds[actorIndex] == formTransitions.manaResourceKind() &&
        <float>state.entityResources[actorIndex] < <float>state.entityMaxResources[actorIndex];
    if ((!restoresHp && !restoresMana) ||
        removeM5InventoryItem(state, actorIndex, itemCode, 1) != 1) {
        return;
    }
    state.entityPotionCooldownUntil[actorIndex] = nowSeconds + 120.0;
    state.entityPotionCooldownRemaining[actorIndex] = 120.0;
    if (restoresHp) {
        var healed = <int>state.entityHp[actorIndex] + restoreHp;
        state.entityHp[actorIndex] = healed > <int>state.entityMaxHp[actorIndex] ?
            <int>state.entityMaxHp[actorIndex] : healed;
    }
    if (restoresMana) {
        offlineCappedResourceGain(state, actorIndex, <float>restoreMana);
    }
}

// `potionCdRemaining` is source-visible action-bar state, so calculate it from
// the durable absolute expiry after every authoritative fixed tick.
updateOfflinePotionCooldowns(state: WorldState): void {
    var nowSeconds = <float>state.timeMicros / 1000000.0;
    var index = 0;
    while (index < state.entityIds.length) {
        var until = <float>state.entityPotionCooldownUntil[index];
        if (until <= nowSeconds) {
            state.entityPotionCooldownUntil[index] = -1.0;
            state.entityPotionCooldownRemaining[index] = 0.0;
        } else {
            state.entityPotionCooldownRemaining[index] = until - nowSeconds;
        }
        index = index + 1;
    }
}

clearOfflineConsumables(state: WorldState, index: int): void {
    state.entityEatingItemCodes[index] = <uint>0;
    state.entityEatingHpPerTwoSeconds[index] = 0;
    state.entityEatingRemaining[index] = 0.0;
    state.entityDrinkingItemCodes[index] = <uint>0;
    state.entityDrinkingManaPerTwoSeconds[index] = 0;
    state.entityDrinkingRemaining[index] = 0.0;
}

stepOfflineConsumables(state: WorldState, index: int): void {
    if (!consumableStateIsValid(state, index)) {
        throw "woc consumable state is invalid";
    }
    if (<bool>state.entityDead[index] || !<bool>state.entitySitting[index]) {
        clearOfflineConsumables(state, index);
        return;
    }
    if (state.tick % <uint>40 != <uint>0) { return; }
    if (<uint>state.entityEatingItemCodes[index] != <uint>0) {
        var hp = <int>state.entityHp[index] +
            <int>state.entityEatingHpPerTwoSeconds[index];
        state.entityHp[index] = hp > <int>state.entityMaxHp[index] ?
            <int>state.entityMaxHp[index] : hp;
        var eatingRemaining = <float>state.entityEatingRemaining[index] - 2.0;
        if (eatingRemaining <= 0.0) {
            state.entityEatingItemCodes[index] = <uint>0;
            state.entityEatingHpPerTwoSeconds[index] = 0;
            state.entityEatingRemaining[index] = 0.0;
        } else {
            state.entityEatingRemaining[index] = eatingRemaining;
        }
    }
    if (<uint>state.entityDrinkingItemCodes[index] != <uint>0) {
        if (<uint>state.entityResourceKinds[index] == formTransitions.manaResourceKind()) {
            offlineCappedResourceGain(
                state, index, <float>state.entityDrinkingManaPerTwoSeconds[index]
            );
        }
        var drinkingRemaining = <float>state.entityDrinkingRemaining[index] - 2.0;
        if (drinkingRemaining <= 0.0) {
            state.entityDrinkingItemCodes[index] = <uint>0;
            state.entityDrinkingManaPerTwoSeconds[index] = 0;
            state.entityDrinkingRemaining[index] = 0.0;
        } else {
            state.entityDrinkingRemaining[index] = drinkingRemaining;
        }
    }
}

applyOfflineQuestCommand(
    state: WorldState,
    actorIndex: int,
    commandId: uint,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    var payloads = %import("protocol/command_payloads");
    var code = offlineQuestCodeFromPayload(
        payloadBytes, payloadOffset, payloadLength,
        commandId == payloads.acceptQuestCommandId(true)
    );
    if (code == 0 || !state.offlineSessionActive ||
        actorIndex != offlineQuestPrimaryPlayerIndex(state) || <bool>state.entityDead[actorIndex]) {
        return;
    }
    var current = offlineQuestStateFor(state, code);
    if (commandId == payloads.acceptQuestCommandId(true)) {
        if (current == <uint>0 && offlineQuestNpcIsNear(state, actorIndex, code)) {
            setOfflineQuestState(state, code, <uint>1);
            setOfflineQuestObjectiveCount(state, code, <uint>0);
            if (code == 2) { syncOfflineQuestBoarHidesFromInventory(state); }
        }
        return;
    }
    if (commandId == payloads.abandonCommandId(true)) {
        if (current == <uint>1 || current == <uint>2) {
            setOfflineQuestState(state, code, <uint>0);
            setOfflineQuestObjectiveCount(state, code, <uint>0);
        }
        return;
    }
    if (commandId != payloads.turnInQuestCommandId(true) || current != <uint>2 ||
        !offlineQuestNpcIsNear(state, actorIndex, code)) {
        return;
    }
    if (code == 2) {
        var boarHideCode = m5InventoryRules.itemCodeForId("boar_hide");
        if (m5InventoryItemCount(state, actorIndex, boarHideCode) < 5) {
            return;
        }
        if (removeM5InventoryItem(state, actorIndex, boarHideCode, 5) != 5) {
            throw "woc q_boars turn-in inventory changed";
        }
    }
    var catalog = %import("generated/m5_content_catalog");
    var questIndex = offlineQuestCatalogIndex(code);
    setOfflineQuestState(state, code, <uint>3);
    setOfflineQuestObjectiveCount(state, code, <uint>0);
    state.offlineQuestCopper = state.offlineQuestCopper +
        <uint>catalog.metric("quest", questIndex, "copperReward");
    grantOfflineQuestExperience(
        state, actorIndex, <uint>catalog.metric("quest", questIndex, "xpReward")
    );
}

applyOfflineLinkedQuestAcceptCommand(
    state: WorldState,
    actorIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>12) {
        throw "woc linked quest acceptance payload is truncated";
    }
    var questPayloadLength = payloadLength - <uint>8;
    var code = offlineQuestCodeFromPayload(
        payloadBytes, payloadOffset, questPayloadLength, false
    );
    if (code == 0 || !state.offlineSessionActive ||
        actorIndex != offlineQuestPrimaryPlayerIndex(state) ||
        offlineQuestStateFor(state, code) != <uint>0) {
        return;
    }
    var binary = %import("protocol/binary");
    var sharerValue = binary.readF64LeAt(
        payloadBytes, payloadOffset + questPayloadLength, <uint>8
    );
    if (sharerValue != sharerValue || sharerValue <= 0.0 ||
        sharerValue > 9007199254740991.0) {
        return;
    }
    var sharerId = <uint>sharerValue;
    if (<float>sharerId != sharerValue) { return; }
    var sharerIndex = partyEntityIndexById(state, sharerId);
    var partyId = partyIdForIndex(state, actorIndex);
    if (sharerIndex < 0 || <uint>state.entityKinds[sharerIndex] != <uint>1 ||
        partyId == <uint>0 || partyIdForIndex(state, sharerIndex) != partyId) {
        return;
    }
    setOfflineQuestState(state, code, <uint>1);
    setOfflineQuestObjectiveCount(state, code, <uint>0);
    if (code == 2) { syncOfflineQuestBoarHidesFromInventory(state); }
}

decodeOfflineBootstrap(bytes: container.Array<uint>): OfflineBootstrap {
    var contracts = %import("generated/contracts");
    var reader = new StateReader(bytes);
    var bootstrap = new OfflineBootstrap();
    bootstrap.launchVersion = reader.u16(1, 1);
    bootstrap.worldSeed = reader.u32(1, 1, 2);
    bootstrap.playerClass = reader.byte(1);
    var nameLength = reader.u32(1, 1, 2);
    if (nameLength > <uint>contracts.fieldOfflineSessionBootstrapPlayerNameMaxLength()) {
        throw "woc offline bootstrap name exceeds contract limit";
    }
    var nameIndex: uint = <uint>0;
    while (nameIndex < nameLength) {
        bootstrap.playerName.add(reader.byte(1));
        nameIndex = nameIndex + <uint>1;
    }
    bootstrap.skinVariant = reader.u16(1, 1);
    var ownedIndex = 0;
    while (ownedIndex <
        <int>contracts.fieldOfflineSessionBootstrapWeaponSkinOwnedMaxLength()) {
        var ownedMarker = reader.byte(1);
        if (ownedMarker > <uint>1) {
            throw "woc offline bootstrap weapon skin ownership marker is invalid";
        }
        bootstrap.weaponSkinOwned[ownedIndex] = ownedMarker == <uint>1;
        ownedIndex = ownedIndex + 1;
    }
    var typeIndex = 0;
    while (typeIndex <
        <int>contracts.fieldOfflineSessionBootstrapWeaponSkinLoadoutCodesMaxLength()) {
        var loadoutCode = reader.byte(1);
        if (loadoutCode > weaponSkinContract.weaponSkinCount()) {
            throw "woc offline bootstrap weapon skin loadout code is invalid";
        }
        bootstrap.weaponSkinLoadoutCodes[typeIndex] = loadoutCode;
        typeIndex = typeIndex + 1;
    }
    reader.finish(true);
    if (bootstrap.launchVersion != <uint>2 || bootstrap.worldSeed != <uint>20061 ||
        bootstrap.playerClass > <uint>8 ||
        !offlineSkinVariantIsValid(bootstrap.playerClass, bootstrap.skinVariant) ||
        !offlinePlayerNameIsValid(bootstrap.playerName) ||
        !weaponSkinState.loadoutStateIsValid(
            bootstrap.weaponSkinOwned, bootstrap.weaponSkinLoadoutCodes
        )) {
        throw "woc offline bootstrap does not match the source standard session contract";
    }
    return bootstrap;
}

populateOfflineKnownAbilities(state: WorldState, playerIndex: int, classIndex: int): void {
    if (playerIndex < 0 || playerIndex != state.entityIds.length - 1 ||
        <uint>state.entityKinds[playerIndex] != <uint>1 ||
        state.entityKnownAbilityOffsets.length != state.entityIds.length + 1 ||
        state.entityKnownAbilityCodes.length != 0 ||
        <uint>state.entityKnownAbilityOffsets[playerIndex] != <uint>0 ||
        <uint>state.entityKnownAbilityOffsets[playerIndex + 1] != <uint>0) {
        throw "woc offline known abilities require the freshly spawned player row";
    }
    if (classIndex != <int>state.offlinePlayerClass) {
        throw "woc offline known ability class does not match the session";
    }
    appendOfflineKnownAbilities(state, state.entityKnownAbilityCodes, playerIndex);
    state.entityKnownAbilityOffsets[playerIndex + 1] =
        <uint>state.entityKnownAbilityCodes.length;
}

talentRowLevel(rowIndex: int): int {
    if (rowIndex == 0) return 5;
    if (rowIndex == 1) return 8;
    if (rowIndex == 2) return 11;
    if (rowIndex == 3) return 14;
    if (rowIndex == 4) return 17;
    if (rowIndex == 5) return 20;
    return 0;
}

abilityCodeListContains(codes: container.Array<uint>, code: uint): bool {
    var index = 0;
    while (index < codes.length) {
        if (<uint>codes[index] == code) { return true; }
        index = index + 1;
    }
    return false;
}

talentRowCodeAt(state: WorldState, entityIndex: int, rowIndex: int): uint {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length ||
        rowIndex < 0 || rowIndex >= 6 ||
        state.entityTalentRowOptionCodes.length != state.entityIds.length * 6) {
        throw "woc talent allocation row partition is invalid";
    }
    return <uint>state.entityTalentRowOptionCodes[entityIndex * 6 + rowIndex];
}

offlineTalentAllocationValuesAreValid(
    state: WorldState,
    playerIndex: int,
    specCode: uint,
    row5Code: uint,
    row8Code: uint,
    row11Code: uint,
    row14Code: uint,
    row17Code: uint,
    row20Code: uint
): bool {
    if (!state.offlineSessionActive || playerIndex < 0 ||
        playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <uint>state.entityKinds[playerIndex] != <uint>1 ||
        state.entityTalentSpecCodes.length != state.entityIds.length ||
        state.entityTalentRowOptionCodes.length != state.entityIds.length * 6) {
        return false;
    }
    var classIndex = <int>state.offlinePlayerClass;
    var classId = knownAbilityCatalog.classId(classIndex);
    var level = <int>state.entityLevels[playerIndex];
    if (classId == "" || level < 1) { return false; }
    if (specCode != <uint>0 &&
        (level < 5 || !talentSelectionCatalog.specMatchesClass(classId, specCode))) {
        return false;
    }
    var rowCodes = new container.Array<uint>();
    rowCodes.add(row5Code);
    rowCodes.add(row8Code);
    rowCodes.add(row11Code);
    rowCodes.add(row14Code);
    rowCodes.add(row17Code);
    rowCodes.add(row20Code);
    var rowIndex = 0;
    while (rowIndex < 6) {
        var optionCode = <uint>rowCodes[rowIndex];
        var rowLevel = talentRowLevel(rowIndex);
        if (rowLevel == 0 || (optionCode != <uint>0 &&
            (level < rowLevel || !talentSelectionCatalog.optionMatchesClassRow(
                classId, rowLevel, optionCode
            )))) {
            return false;
        }
        rowIndex = rowIndex + 1;
    }
    return true;
}

offlineTalentAllocationIsValid(state: WorldState, playerIndex: int): bool {
    if (playerIndex < 0 || playerIndex >= state.entityIds.length ||
            state.entityTalentSpecCodes.length != state.entityIds.length ||
            state.entityTalentRowOptionCodes.length != state.entityIds.length * 6) {
        return false;
    }

    return offlineTalentAllocationValuesAreValid(
        state,
        playerIndex,
        <uint>state.entityTalentSpecCodes[playerIndex],
        talentRowCodeAt(state, playerIndex, 0),
        talentRowCodeAt(state, playerIndex, 1),
        talentRowCodeAt(state, playerIndex, 2),
        talentRowCodeAt(state, playerIndex, 3),
        talentRowCodeAt(state, playerIndex, 4),
        talentRowCodeAt(state, playerIndex, 5)
    );
}

offlineTalentLoadoutRowCodeAt(
    state: WorldState,
    loadoutIndex: int,
    rowIndex: int
): uint {
    if (loadoutIndex < 0 || loadoutIndex >= state.offlineTalentLoadoutSpecCodes.length ||
        rowIndex < 0 || rowIndex >= 6 ||
        state.offlineTalentLoadoutRowOptionCodes.length !=
            state.offlineTalentLoadoutSpecCodes.length * 6) {
        throw "woc talent loadout row partition is invalid";
    }
    return <uint>state.offlineTalentLoadoutRowOptionCodes[loadoutIndex * 6 + rowIndex];
}

offlineTalentLoadoutStateIsValid(state: WorldState): bool {
    var count = state.offlineTalentLoadoutSpecCodes.length;
    var barSlots = talentLoadoutContract.barSlots(true);
    if (count < 0 || count > talentLoadoutContract.maxLoadouts(true) ||
        state.offlineTalentLoadoutNameOffsets.length != count + 1 ||
        state.offlineTalentLoadoutNameOffsets.length == 0 ||
        <uint>state.offlineTalentLoadoutNameOffsets[0] != <uint>0 ||
        <uint>state.offlineTalentLoadoutNameOffsets[count] !=
            <uint>state.offlineTalentLoadoutNameBytes.length ||
        state.offlineTalentLoadoutRowOptionCodes.length != count * 6 ||
        state.offlineTalentLoadoutActionBarAbilityCodes.length != count * barSlots ||
        state.offlineTalentActiveLoadoutIndex < -1 ||
        state.offlineTalentActiveLoadoutIndex >= count) {
        return false;
    }
    if (!state.offlineSessionActive) {
        return count == 0 && state.offlineTalentActiveLoadoutIndex == -1;
    }
    var playerIndex = offlineQuestPrimaryPlayerIndex(state);
    var loadoutIndex = 0;
    while (loadoutIndex < count) {
        var nameStart = <uint>state.offlineTalentLoadoutNameOffsets[loadoutIndex];
        var nameEnd = <uint>state.offlineTalentLoadoutNameOffsets[loadoutIndex + 1];
        if (nameEnd < nameStart || nameEnd > <uint>state.offlineTalentLoadoutNameBytes.length) {
            return false;
        }
        var nameLength = nameEnd - nameStart;
        if (nameLength == <uint>0 || nameLength > <uint>96 ||
            !offlineTalentAllocationValuesAreValid(
                state, playerIndex, <uint>state.offlineTalentLoadoutSpecCodes[loadoutIndex],
                offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 0),
                offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 1),
                offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 2),
                offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 3),
                offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 4),
                offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 5)
            )) {
            return false;
        }
        var nameIndex = <int>nameStart;
        while (nameIndex < <int>nameEnd) {
            if (<uint>state.offlineTalentLoadoutNameBytes[nameIndex] > <uint>255) {
                return false;
            }
            nameIndex = nameIndex + 1;
        }
        var barIndex = 0;
        while (barIndex < barSlots) {
            var abilityCode = <uint>state.offlineTalentLoadoutActionBarAbilityCodes[
                loadoutIndex * barSlots + barIndex
            ];
            if (abilityCode != <uint>0 &&
                !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
                return false;
            }
            barIndex = barIndex + 1;
        }
        loadoutIndex = loadoutIndex + 1;
    }
    return true;
}

appendOfflineKnownAbilities(
    state: WorldState,
    destination: container.Array<uint>,
    playerIndex: int
): void {
    if (!offlineTalentAllocationIsValid(state, playerIndex)) {
        throw "woc offline talent allocation is invalid";
    }
    var classIndex = <int>state.offlinePlayerClass;
    var level = <int>state.entityLevels[playerIndex];
    var content = %import("generated/m8_offline_bootstrap_content");
    if (classIndex < 0 || classIndex >= knownAbilityCatalog.classCount() ||
        knownAbilityCatalog.classCount() != 9 ||
        knownAbilityCatalog.classId(classIndex) != content.classId(classIndex)) {
        throw "woc current known-ability class catalog drifted";
    }
    var specCode = <uint>state.entityTalentSpecCodes[playerIndex];
    var specId = specCode == <uint>0 ? "" : talentSelectionCatalog.specId(specCode);
    var grants = new container.Array<uint>();
    if (specCode != <uint>0) {
        grants.add(talentSelectionCatalog.specSignatureAbilityCode(specCode));
    }
    var rowIndex = 0;
    while (rowIndex < 6) {
        var optionCode = talentRowCodeAt(state, playerIndex, rowIndex);
        if (optionCode != <uint>0) {
            var grantCode = talentSelectionCatalog.optionGrantAbilityCode(optionCode);
            if (grantCode != <uint>0) { grants.add(grantCode); }
        }
        rowIndex = rowIndex + 1;
    }
    var base = new container.Array<uint>();
    var slot = 0;
    var count = knownAbilityCatalog.classAbilityCount(classIndex);
    while (slot < count) {
        base.add(<uint>knownAbilityCatalog.classAbilityCode(classIndex, slot));
        slot = slot + 1;
    }
    var ordered = new container.Array<uint>();
    for (var baseCode in base) { ordered.add(<uint>baseCode); }
    for (var grantCode in grants) {
        if (!abilityCodeListContains(ordered, <uint>grantCode)) {
            ordered.add(<uint>grantCode);
        }
    }
    for (var orderedCode in ordered) {
        var abilityCode = <uint>orderedCode;
        var granted = abilityCodeListContains(grants, abilityCode) ||
            !abilityCodeListContains(base, abilityCode);
        if (knownAbilityCatalog.isKnownAt(<int>abilityCode, level, granted, specId)) {
            destination.add(abilityCode);
        }
    }
}

// The current source replaces the complete PlayerMeta.known list whenever a
// level changes. Rebuild only the offline player's partition while copying every
// other entity's existing codes, so later owners can add their own partitions.
refreshOfflineKnownAbilities(state: WorldState, playerIndex: int): void {
    var classIndex = <int>state.offlinePlayerClass;
    if (!state.offlineSessionActive || playerIndex < 0 ||
        playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <uint>state.entityKinds[playerIndex] != <uint>1 ||
        <uint>state.entityTemplates[playerIndex] != <uint>(classIndex + 1) ||
        state.entityKnownAbilityOffsets.length != state.entityIds.length + 1 ||
        <uint>state.entityKnownAbilityOffsets[0] != <uint>0 ||
        <uint>state.entityKnownAbilityOffsets[state.entityIds.length] !=
            <uint>state.entityKnownAbilityCodes.length) {
        throw "woc offline known-ability refresh state is invalid";
    }
    var replacementOffsets = new container.Array<uint>();
    var replacementCodes = new container.Array<uint>();
    replacementOffsets.add(<uint>0);
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var start = <int><uint>state.entityKnownAbilityOffsets[entityIndex];
        var end = <int><uint>state.entityKnownAbilityOffsets[entityIndex + 1];
        if (start < 0 || end < start || end > state.entityKnownAbilityCodes.length) {
            throw "woc entity known-ability partition is invalid";
        }
        if (entityIndex == playerIndex) {
            appendOfflineKnownAbilities(state, replacementCodes, entityIndex);
        } else {
            var codeIndex = start;
            while (codeIndex < end) {
                var code = <uint>state.entityKnownAbilityCodes[codeIndex];
                if (!knownAbilityCatalog.abilityExists(<int>code)) {
                    throw "woc entity known ability is absent from the current catalog";
                }
                replacementCodes.add(code);
                codeIndex = codeIndex + 1;
            }
        }
        replacementOffsets.add(<uint>replacementCodes.length);
        entityIndex = entityIndex + 1;
    }
    state.entityKnownAbilityOffsets = replacementOffsets;
    state.entityKnownAbilityCodes = replacementCodes;
    stripOrphanedFormState(state, playerIndex);
}

// Source talent refresh drops form auras whose spellbook entry no longer
// exists. WOS owns the durable form row, so it must restore Bear/Cat's parked
// mana through the form transition rather than merely zeroing the code.
stripOrphanedFormState(state: WorldState, playerIndex: int): void {
    if (playerIndex < 0 || playerIndex >= state.entityIds.length ||
        state.entityActiveFormAbilityCodes.length != state.entityIds.length ||
        state.entitySavedManaMaximums.length != state.entityIds.length) {
        throw "woc orphan form state is invalid";
    }
    var activeCode = <uint>state.entityActiveFormAbilityCodes[playerIndex];
    if (activeCode == <uint>0 || knownAbilityPartitionContains(state, playerIndex, activeCode)) {
        return;
    }
    var form = loadFormTransitionState(state, playerIndex);
    formTransitions.clearActiveForm(form);
    storeFormTransitionState(state, playerIndex, form);
}

// The select-row reducer decodes the current offline command and applies its
// reachable combat lock before this shared allocation transaction. Arena and
// the source's five-second post-combat linger still require their owning state.
pub replaceOfflineTalentAllocation(
    state: WorldState,
    playerIndex: int,
    specCode: uint,
    row5Code: uint,
    row8Code: uint,
    row11Code: uint,
    row14Code: uint,
    row17Code: uint,
    row20Code: uint
): bool {
    if (!offlineTalentAllocationValuesAreValid(
            state, playerIndex, specCode, row5Code, row8Code, row11Code,
            row14Code, row17Code, row20Code
        )) {
        return false;
    }
    var priorSpecCode = <uint>state.entityTalentSpecCodes[playerIndex];
    var unchanged = priorSpecCode == specCode &&
        talentRowCodeAt(state, playerIndex, 0) == row5Code &&
        talentRowCodeAt(state, playerIndex, 1) == row8Code &&
        talentRowCodeAt(state, playerIndex, 2) == row11Code &&
        talentRowCodeAt(state, playerIndex, 3) == row14Code &&
        talentRowCodeAt(state, playerIndex, 4) == row17Code &&
        talentRowCodeAt(state, playerIndex, 5) == row20Code;
    if (unchanged) { return true; }
    if (talentSelectionCatalog.specId(priorSpecCode) == "arcane" &&
        talentSelectionCatalog.specId(specCode) != "arcane") {
        stripOfflineTemporalEchoesBySource(state, <uint>state.entityIds[playerIndex]);
    }
    state.entityTalentSpecCodes[playerIndex] = specCode;
    var rowOffset = playerIndex * 6;
    state.entityTalentRowOptionCodes[rowOffset] = row5Code;
    state.entityTalentRowOptionCodes[rowOffset + 1] = row8Code;
    state.entityTalentRowOptionCodes[rowOffset + 2] = row11Code;
    state.entityTalentRowOptionCodes[rowOffset + 3] = row14Code;
    state.entityTalentRowOptionCodes[rowOffset + 4] = row17Code;
    state.entityTalentRowOptionCodes[rowOffset + 5] = row20Code;
    refreshOfflineKnownAbilities(state, playerIndex);
    normalizeOfflineArcaneShotChargeCap(state, playerIndex);
    recomputeBaselineFormDerivedStats(state, playerIndex);
    return true;
}

// Current source choice rows grant charges only to Arcane Shot. Preserve a
// running plain cooldown when Quick Shots is selected, and convert its earliest
// recharge back to a plain cooldown if that row is later removed.
normalizeOfflineArcaneShotChargeCap(state: WorldState, playerIndex: int): void {
    if (playerIndex < 0 || playerIndex >= state.entityIds.length) { return; }
    var abilityCode = arcaneShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_shot");
    var level = <int>state.entityLevels[playerIndex];
    var cooldown = abilityIndex < 0 ? 0.0 : m4AbilityCatalog.metric(
        abilityIndex, level, "cooldown"
    );
    var modifiers = offlineTalentModifiersForEntity(state, playerIndex);
    var bonus = talentModifiers.abilityField(modifiers, "arcane_shot", "bonusCharges");
    var entityId = <uint>state.entityIds[playerIndex];
    var record = offlineAbilityChargeStateIndex(state, entityId, abilityCode);
    if (bonus <= 0.0 || cooldown <= 0.0) {
        if (record < 0) { return; }
        var prior = loadOfflineAbilityChargeState(
            state, record, <int>state.offlineAbilityChargeMaximums[record],
            <float>state.offlineAbilityChargeRechargeLengths[record]
        );
        if (prior.maxCharges - prior.charges > 0 && prior.recharge > 0.0) {
            setAbilityCooldownExpiration(
                state, playerIndex, abilityCode,
                state.timeMicros + <uint>(prior.recharge * 1000000.0 + 0.5)
            );
        } else {
            clearAbilityCooldown(state, playerIndex, abilityCode);
        }
        removeOfflineAbilityChargeAt(state, record);
        return;
    }
    if (record >= 0) { return; }
    var expiresAt = abilityCooldownExpiresAt(state, playerIndex, abilityCode);
    if (expiresAt <= state.timeMicros) { return; }
    var charges = new abilityCharges.AbilityChargeState(1 + <int>bonus, cooldown);
    charges.charges = charges.maxCharges - 1;
    charges.rechargesMaterialized = true;
    charges.recharge = <float>(expiresAt - state.timeMicros) / 1000000.0;
    charges.recharges.add(charges.recharge);
    storeOfflineAbilityChargeState(state, entityId, abilityCode, charges);
    clearAbilityCooldown(state, playerIndex, abilityCode);
}

talentRowIndexForLevel(level: int): int {
    if (level == 5) return 0;
    if (level == 8) return 1;
    if (level == 11) return 2;
    if (level == 14) return 3;
    if (level == 17) return 4;
    if (level == 20) return 5;
    return -1;
}

// The offline MVP has no arena owner yet. Its reachable combat projection is a
// live hostile mob that has entered the active AI state and still targets this
// player; clearing auto-attack alone intentionally does not unlock the build.
offlineTalentAllocationLocked(state: WorldState, playerIndex: int): bool {
    if (playerIndex < 0 || playerIndex >= state.entityIds.length ||
        <bool>state.entityDead[playerIndex]) {
        return false;
    }
    var playerId = <uint>state.entityIds[playerIndex];
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>2 &&
            !<bool>state.entityDead[index] &&
            <bool>state.entityHostile[index] &&
            <uint>state.entityAiStates[index] >= <uint>2 &&
            <uint>state.entityTargetIds[index] == playerId) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

offlineMechChromaOwnershipStateIsValid(state: WorldState): bool {
    var catalog = %import("generated/m5_content_catalog");
    return state.offlineMechChromaOwned.length == catalog.mechChromaCount();
}

offlineMechChromaIndexForItemIndex(itemIndex: int): int {
    var catalog = %import("generated/m5_content_catalog");
    var chromaIndex = 0;
    while (chromaIndex < catalog.mechChromaCount()) {
        if (catalog.mechChromaItemIndex(chromaIndex) == itemIndex) {
            return chromaIndex;
        }
        chromaIndex = chromaIndex + 1;
    }
    return -1;
}

offlineMechChromaIndexForSkinIndex(skinIndex: uint): int {
    var catalog = %import("generated/m5_content_catalog");
    var chromaIndex = 0;
    while (chromaIndex < catalog.mechChromaCount()) {
        if (<uint>catalog.mechChromaSkinIndex(chromaIndex) == skinIndex) {
            return chromaIndex;
        }
        chromaIndex = chromaIndex + 1;
    }
    return -1;
}

mechChromaPayloadShapeIsValid(
    payloadOffset: uint, payloadLength: uint, payloadBytes: container.Array<uint>
): bool {
    if (payloadLength < <uint>4 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        return false;
    }
    var chromaLength = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (chromaLength > <uint>256 || payloadLength != chromaLength + <uint>4) {
        return false;
    }
    var chromaStart = payloadOffset + <uint>4;
    return craftItemState.utf8RangeValid(
        payloadBytes, chromaStart, chromaStart + chromaLength
    );
}

offlineMechChromaIndexFromPayload(
    payloadOffset: uint, payloadLength: uint, payloadBytes: container.Array<uint>
): int {
    if (!mechChromaPayloadShapeIsValid(
            payloadOffset, payloadLength, payloadBytes
        )) {
        throw "woc unequip mech chroma identifier payload is invalid";
    }
    var chromaLength = payloadLength - <uint>4;
    var catalog = %import("generated/m5_content_catalog");
    var chromaIndex = 0;
    while (chromaIndex < catalog.mechChromaCount()) {
        if (<uint>catalog.mechChromaIdUtf8Length(chromaIndex) == chromaLength) {
            var matches = true;
            var byteIndex = 0;
            while (byteIndex < <int>chromaLength && matches) {
                if (<uint>payloadBytes[
                        <int>(payloadOffset + <uint>4 + <uint>byteIndex)
                    ] != catalog.mechChromaIdUtf8Byte(chromaIndex, byteIndex)) {
                    matches = false;
                }
                byteIndex = byteIndex + 1;
            }
            if (matches) { return chromaIndex; }
        }
        chromaIndex = chromaIndex + 1;
    }
    return -1;
}

// Source `change_skin` distinguishes class cosmetics from account-owned mech
// chromas. Class variants update the durable bootstrap selection; mech variants
// require the shared WOS82 account ownership marker.
applyOfflineSkinCommand(
    state: WorldState,
    playerIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength != <uint>2 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset ||
        <uint>state.entityKinds[playerIndex] != <uint>1) {
        return;
    }
    var catalogCode = <uint>payloadBytes[<int>payloadOffset];
    var skinVariant = <uint>payloadBytes[<int>(payloadOffset + <uint>1)];
    if (catalogCode == <uint>1) {
        var mechChromaIndex = offlineMechChromaIndexForSkinIndex(skinVariant);
        if (mechChromaIndex < 0 ||
            !offlineMechChromaOwnershipStateIsValid(state) ||
            !<bool>state.offlineMechChromaOwned[mechChromaIndex]) {
            return;
        }
        state.entitySkinCatalogs[playerIndex] = <uint>2;
        state.entitySkinIndices[playerIndex] = skinVariant;
        if (!presentationIdentityIsValid(state, playerIndex)) {
            throw "woc offline mech skin presentation identity is invalid";
        }
        return;
    }
    if (catalogCode != <uint>0 ||
        !offlineSkinVariantIsValid(state.offlinePlayerClass, skinVariant)) {
        return;
    }
    if (state.offlineSessionActive &&
        playerIndex == offlineQuestPrimaryPlayerIndex(state)) {
        state.offlinePlayerSkinVariant = skinVariant;
    }
    var entityIndex = playerIndex;
    state.entitySkinCatalogs[entityIndex] = <uint>1;
    state.entitySkinIndices[entityIndex] = skinVariant;
    if (!presentationIdentityIsValid(state, entityIndex)) {
        throw "woc offline skin presentation identity is invalid";
    }
}

applyOfflineUnequipMechChromaCommand(
    state: WorldState,
    playerIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    var chromaIndex = offlineMechChromaIndexFromPayload(
        payloadOffset, payloadLength, payloadBytes
    );
    if (chromaIndex < 0 || !offlineMechChromaOwnershipStateIsValid(state) ||
        !<bool>state.offlineMechChromaOwned[chromaIndex]) {
        return;
    }
    var catalog = %import("generated/m5_content_catalog");
    var skinIndex = <uint>catalog.mechChromaSkinIndex(chromaIndex);
    state.offlineMechChromaOwned[chromaIndex] = false;
    var primaryWasUsingChroma = state.offlineSessionActive &&
        state.entityIds.length > 0 && <uint>state.entityKinds[0] == <uint>1 &&
        <uint>state.entitySkinCatalogs[0] == <uint>2 &&
        <uint>state.entitySkinIndices[0] == skinIndex;
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        if (<uint>state.entityKinds[entityIndex] == <uint>1 &&
            <uint>state.entitySkinCatalogs[entityIndex] == <uint>2 &&
            <uint>state.entitySkinIndices[entityIndex] == skinIndex) {
            state.entitySkinCatalogs[entityIndex] = <uint>1;
            state.entitySkinIndices[entityIndex] = <uint>0;
        }
        entityIndex = entityIndex + 1;
    }
    if (primaryWasUsingChroma) {
        state.offlinePlayerSkinVariant = <uint>0;
    }
    grantM5InventoryItem(
        state, playerIndex,
        <uint>catalog.mechChromaItemIndex(chromaIndex) + <uint>1, 1
    );
}

offlineWeaponSkinMainhandItemIndex(state: WorldState, playerIndex: int): int {
    if (playerIndex < 0 || playerIndex >= state.entityIds.length ||
        <uint>state.entityKinds[playerIndex] != <uint>1) {
        return -1;
    }
    var profileCode = <uint>state.entityBaselineStatProfileCodes[playerIndex];
    if (profileCode == <uint>0) { return -1; }
    var storedCode = <uint>state.entityM5MainhandItemCodes[playerIndex];
    if (storedCode == m5Equipment.emptyMainhandStoredCode()) { return -1; }
    if (storedCode == <uint>0) {
        storedCode = m5Equipment.startingMainhandStoredCode(<int>profileCode - 1);
    }
    return m5Equipment.storedItemCodeToIndex("mainhand", storedCode);
}

offlineWeaponSkinMainhandTypeCode(state: WorldState, playerIndex: int): uint {
    var itemIndex = offlineWeaponSkinMainhandItemIndex(state, playerIndex);
    if (itemIndex < 0) { return <uint>0; }
    var catalog = %import("generated/m5_content_catalog");
    return weaponSkinContract.itemWeaponTypeCodeForId(
        catalog.text("item", itemIndex, "id")
    );
}

offlineWeaponSkinPlayerIsHunter(state: WorldState, playerIndex: int): bool {
    return playerIndex >= 0 && playerIndex < state.entityIds.length &&
        <uint>state.entityBaselineStatProfileCodes[playerIndex] ==
            <uint>(m5ClassBaseline.classIndex("hunter") + 1);
}

derivedOfflineWeaponSkinCode(state: WorldState, entityIndex: int): uint {
    var itemIndex = offlineWeaponSkinMainhandItemIndex(state, entityIndex);
    var hasMainhand = itemIndex >= 0;
    return weaponSkinState.activeSkinCode(
        offlineWeaponSkinPlayerIsHunter(state, entityIndex),
        hasMainhand,
        hasMainhand ? offlineWeaponSkinMainhandTypeCode(state, entityIndex) : <uint>0,
        state.offlineWeaponSkinLoadoutCodes
    );
}

refreshOfflineWeaponSkinForEntity(state: WorldState, entityIndex: int): void {
    if (entityIndex < 0 || entityIndex >= state.entityWeaponSkinCodes.length) {
        throw "woc weapon skin entity projection index is invalid";
    }
    state.entityWeaponSkinCodes[entityIndex] =
        derivedOfflineWeaponSkinCode(state, entityIndex);
}

refreshAllOfflineWeaponSkins(state: WorldState): void {
    var entityIndex = 0;
    while (entityIndex < state.entityWeaponSkinCodes.length) {
        refreshOfflineWeaponSkinForEntity(state, entityIndex);
        entityIndex = entityIndex + 1;
    }
}

offlineWeaponSkinStateIsValid(state: WorldState): bool {
    if (!weaponSkinState.loadoutStateIsValid(
            state.offlineWeaponSkinOwned, state.offlineWeaponSkinLoadoutCodes
        ) || state.entityWeaponSkinCodes.length != state.entityIds.length) {
        return false;
    }
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        if (<uint>state.entityWeaponSkinCodes[entityIndex] !=
            derivedOfflineWeaponSkinCode(state, entityIndex)) {
            return false;
        }
        entityIndex = entityIndex + 1;
    }
    return true;
}

applyOfflineWeaponSkinCommand(
    state: WorldState,
    playerIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (!weaponSkinState.payloadShapeIsValid(
            payloadOffset, payloadLength, payloadBytes
        ) || !offlineWeaponSkinStateIsValid(state)) {
        throw "woc weapon skin command payload or state is invalid";
    }
    var mode = <uint>payloadBytes[<int>payloadOffset];
    if (mode == <uint>0) {
        var detachTypeCode = weaponSkinState.detachTypeCodeFromPayload(
            payloadOffset, payloadLength, payloadBytes
        );
        var detachTypeIndex = <int>detachTypeCode - 1;
        if (<uint>state.offlineWeaponSkinLoadoutCodes[detachTypeIndex] == <uint>0) {
            return;
        }
        state.offlineWeaponSkinLoadoutCodes[detachTypeIndex] = <uint>0;
        refreshAllOfflineWeaponSkins(state);
        return;
    }

    var skinIndex = weaponSkinState.skinIndexFromPayload(
        payloadOffset, payloadLength, payloadBytes
    );
    if (skinIndex < 0 || !<bool>state.offlineWeaponSkinOwned[skinIndex]) {
        return;
    }
    var typeCode = <uint>weaponSkinContract.weaponSkinTypeCode(skinIndex);
    var mainhandItemIndex = offlineWeaponSkinMainhandItemIndex(state, playerIndex);
    if (!weaponSkinState.typeMatchesPlayer(
            offlineWeaponSkinPlayerIsHunter(state, playerIndex),
            mainhandItemIndex >= 0,
            mainhandItemIndex >= 0 ?
                offlineWeaponSkinMainhandTypeCode(state, playerIndex) : <uint>0,
            typeCode
        )) {
        return;
    }
    // Source loadouts make bow and crossbow mutually exclusive while keeping
    // every other parked type intact.
    if (typeCode == <uint>7) {
        state.offlineWeaponSkinLoadoutCodes[7] = <uint>0;
    } else if (typeCode == <uint>8) {
        state.offlineWeaponSkinLoadoutCodes[6] = <uint>0;
    }
    state.offlineWeaponSkinLoadoutCodes[<int>typeCode - 1] = <uint>(skinIndex + 1);
    refreshAllOfflineWeaponSkins(state);
}

offlineTalentLoadoutCommandIndex(
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): int {
    if (payloadLength != <uint>4 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        return -1;
    }
    var index = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (index >= <uint>talentLoadoutContract.maxLoadouts(true)) {
        return -1;
    }
    return <int>index;
}

saveLoadoutPayloadU16(
    bytes: container.Array<uint>, cursor: uint, payloadEnd: uint
): uint {
    if (cursor > payloadEnd || payloadEnd - cursor < <uint>2) {
        throw "woc save-loadout u16 payload is truncated";
    }
    return <uint>bytes[<int>cursor] +
        <uint>bytes[<int>(cursor + <uint>1)] * <uint>256;
}

saveLoadoutPayloadU32(
    bytes: container.Array<uint>, cursor: uint, payloadEnd: uint
): uint {
    if (cursor > payloadEnd || payloadEnd - cursor < <uint>4) {
        throw "woc save-loadout u32 payload is truncated";
    }
    return <uint>bytes[<int>cursor] +
        <uint>bytes[<int>(cursor + <uint>1)] * <uint>256 +
        <uint>bytes[<int>(cursor + <uint>2)] * <uint>65536 +
        <uint>bytes[<int>(cursor + <uint>3)] * <uint>16777216;
}

offlineTalentLoadoutNameMatches(
    state: WorldState,
    loadoutIndex: int,
    nameBytes: container.Array<uint>
): bool {
    if (loadoutIndex < 0 || loadoutIndex >= state.offlineTalentLoadoutSpecCodes.length ||
        state.offlineTalentLoadoutNameOffsets.length !=
            state.offlineTalentLoadoutSpecCodes.length + 1) {
        return false;
    }
    var start = <int><uint>state.offlineTalentLoadoutNameOffsets[loadoutIndex];
    var end = <int><uint>state.offlineTalentLoadoutNameOffsets[loadoutIndex + 1];
    if (start < 0 || end < start || end > state.offlineTalentLoadoutNameBytes.length ||
        end - start != nameBytes.length) {
        return false;
    }
    var index = 0;
    while (index < nameBytes.length) {
        if (<uint>state.offlineTalentLoadoutNameBytes[start + index] !=
            <uint>nameBytes[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

replaceOfflineTalentLoadoutName(
    state: WorldState,
    loadoutIndex: int,
    nameBytes: container.Array<uint>
): void {
    var count = state.offlineTalentLoadoutSpecCodes.length;
    if (loadoutIndex < 0 || loadoutIndex >= count || nameBytes.length == 0 ||
        nameBytes.length > 96 || state.offlineTalentLoadoutNameOffsets.length != count + 1) {
        throw "woc save-loadout name replacement is invalid";
    }
    var nextOffsets = new container.Array<uint>();
    var nextBytes = new container.Array<uint>();
    nextOffsets.add(<uint>0);
    var sourceIndex = 0;
    while (sourceIndex < count) {
        if (sourceIndex == loadoutIndex) {
            for (var replacementByte in nameBytes) {
                nextBytes.add(<uint>replacementByte);
            }
        } else {
            var start = <int><uint>state.offlineTalentLoadoutNameOffsets[sourceIndex];
            var end = <int><uint>state.offlineTalentLoadoutNameOffsets[sourceIndex + 1];
            if (start < 0 || end < start || end > state.offlineTalentLoadoutNameBytes.length) {
                throw "woc save-loadout name partition is invalid";
            }
            var byteIndex = start;
            while (byteIndex < end) {
                nextBytes.add(<uint>state.offlineTalentLoadoutNameBytes[byteIndex]);
                byteIndex = byteIndex + 1;
            }
        }
        nextOffsets.add(<uint>nextBytes.length);
        sourceIndex = sourceIndex + 1;
    }
    state.offlineTalentLoadoutNameOffsets = nextOffsets;
    state.offlineTalentLoadoutNameBytes = nextBytes;
}

applyOfflineSaveTalentLoadoutCommand(
    state: WorldState,
    playerIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (payloadLength < <uint>6 || payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset) {
        throw "woc save-loadout payload is truncated";
    }
    var payloadEnd = payloadOffset + payloadLength;
    var cursor = payloadOffset;
    var nameLength = saveLoadoutPayloadU32(payloadBytes, cursor, payloadEnd);
    cursor = cursor + <uint>4;
    if (nameLength > <uint>96 || cursor > payloadEnd || nameLength > payloadEnd - cursor) {
        throw "woc save-loadout name payload is invalid";
    }
    var effectiveName = new container.Array<uint>();
    var nameIndex: uint = <uint>0;
    while (nameIndex < nameLength) {
        effectiveName.add(<uint>payloadBytes[<int>(cursor + nameIndex)]);
        nameIndex = nameIndex + <uint>1;
    }
    cursor = cursor + nameLength;
    // Source `(name || "Build")` canonicalizes the empty public API value.
    if (effectiveName.length == 0) {
        effectiveName.add(<uint>66); effectiveName.add(<uint>117);
        effectiveName.add(<uint>105); effectiveName.add(<uint>108);
        effectiveName.add(<uint>100);
    }

    if (cursor >= payloadEnd) { throw "woc save-loadout allocation flag is truncated"; }
    var allocationPresent = <uint>payloadBytes[<int>cursor];
    cursor = cursor + <uint>1;
    if (allocationPresent > <uint>1) {
        throw "woc save-loadout allocation flag is invalid";
    }
    var specCode: uint = <uint>0;
    var rowCodes = new container.Array<uint>();
    var rowIndex = 0;
    if (allocationPresent == <uint>1) {
        if (cursor > payloadEnd || payloadEnd - cursor < <uint>14) {
            throw "woc save-loadout allocation payload is truncated";
        }
        specCode = saveLoadoutPayloadU16(payloadBytes, cursor, payloadEnd);
        cursor = cursor + <uint>2;
        while (rowIndex < 6) {
            rowCodes.add(saveLoadoutPayloadU16(payloadBytes, cursor, payloadEnd));
            cursor = cursor + <uint>2;
            rowIndex = rowIndex + 1;
        }
    }

    if (cursor >= payloadEnd) { throw "woc save-loadout bar count is truncated"; }
    var barCount = <uint>payloadBytes[<int>cursor];
    cursor = cursor + <uint>1;
    if (barCount > <uint>talentLoadoutContract.barSlots(true)) {
        throw "woc save-loadout bar count is invalid";
    }
    var barCodes = new container.Array<uint>();
    var barIndex: uint = <uint>0;
    while (barIndex < barCount) {
        if (cursor >= payloadEnd) { throw "woc save-loadout bar flag is truncated"; }
        var present = <uint>payloadBytes[<int>cursor];
        cursor = cursor + <uint>1;
        if (present == <uint>0) {
            barCodes.add(<uint>0);
        } else if (present == <uint>1) {
            var abilityLength = saveLoadoutPayloadU32(payloadBytes, cursor, payloadEnd);
            cursor = cursor + <uint>4;
            if (abilityLength > <uint>256 || cursor > payloadEnd ||
                abilityLength > payloadEnd - cursor) {
                throw "woc save-loadout ability payload is invalid";
            }
            // Current client bars are closed over the pinned ability catalog.
            // A stale unknown source string is retained as an empty WOC slot.
            barCodes.add(m4AbilityCodeFromPayload(payloadBytes, cursor, abilityLength));
            cursor = cursor + abilityLength;
        } else {
            throw "woc save-loadout bar flag is invalid";
        }
        barIndex = barIndex + <uint>1;
    }
    while (barCodes.length < talentLoadoutContract.barSlots(true)) {
        barCodes.add(<uint>0);
    }
    if (cursor != payloadEnd) { throw "woc save-loadout payload has trailing bytes"; }

    if (!state.offlineSessionActive || playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <uint>state.entityKinds[playerIndex] != <uint>1) {
        return;
    }
    if (allocationPresent == <uint>1) {
        if (offlineTalentAllocationLocked(state, playerIndex) ||
            !replaceOfflineTalentAllocation(
                state, playerIndex, specCode,
                <uint>rowCodes[0], <uint>rowCodes[1], <uint>rowCodes[2],
                <uint>rowCodes[3], <uint>rowCodes[4], <uint>rowCodes[5]
            )) {
            return;
        }
    }

    var existing = -1;
    var loadoutIndex = 0;
    while (loadoutIndex < state.offlineTalentLoadoutSpecCodes.length) {
        if (offlineTalentLoadoutNameMatches(state, loadoutIndex, effectiveName)) {
            existing = loadoutIndex;
            break;
        }
        loadoutIndex = loadoutIndex + 1;
    }
    if (existing < 0 && state.offlineTalentLoadoutSpecCodes.length >=
        talentLoadoutContract.maxLoadouts(true)) {
        // Source applies a staged allocation before rejecting a new eleventh name.
        return;
    }
    var targetIndex = existing >= 0 ? existing : state.offlineTalentLoadoutSpecCodes.length;
    if (existing < 0) {
        state.offlineTalentLoadoutNameOffsets.add(
            <uint>state.offlineTalentLoadoutNameBytes.length
        );
        state.offlineTalentLoadoutSpecCodes.add(<uint>0);
        rowIndex = 0;
        while (rowIndex < 6) {
            state.offlineTalentLoadoutRowOptionCodes.add(<uint>0);
            rowIndex = rowIndex + 1;
        }
        barIndex = <uint>0;
        while (barIndex < <uint>talentLoadoutContract.barSlots(true)) {
            state.offlineTalentLoadoutActionBarAbilityCodes.add(<uint>0);
            barIndex = barIndex + <uint>1;
        }
    }
    replaceOfflineTalentLoadoutName(state, targetIndex, effectiveName);
    state.offlineTalentLoadoutSpecCodes[targetIndex] =
        <uint>state.entityTalentSpecCodes[playerIndex];
    rowIndex = 0;
    while (rowIndex < 6) {
        state.offlineTalentLoadoutRowOptionCodes[targetIndex * 6 + rowIndex] =
            talentRowCodeAt(state, playerIndex, rowIndex);
        rowIndex = rowIndex + 1;
    }
    barIndex = <uint>0;
    while (barIndex < <uint>talentLoadoutContract.barSlots(true)) {
        state.offlineTalentLoadoutActionBarAbilityCodes[
            targetIndex * talentLoadoutContract.barSlots(true) + <int>barIndex
        ] = <uint>barCodes[<int>barIndex];
        barIndex = barIndex + <uint>1;
    }
    state.offlineTalentActiveLoadoutIndex = targetIndex;
    if (!offlineTalentLoadoutStateIsValid(state)) {
        throw "woc saved talent loadout state is invalid";
    }
}

applyOfflineSwitchTalentLoadoutCommand(
    state: WorldState,
    playerIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    var loadoutIndex = offlineTalentLoadoutCommandIndex(
        payloadOffset, payloadLength, payloadBytes
    );
    if (loadoutIndex < 0 || !state.offlineSessionActive ||
        playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <uint>state.entityKinds[playerIndex] != <uint>1 ||
        loadoutIndex >= state.offlineTalentLoadoutSpecCodes.length ||
        offlineTalentAllocationLocked(state, playerIndex)) {
        return;
    }
    if (!replaceOfflineTalentAllocation(
            state, playerIndex, <uint>state.offlineTalentLoadoutSpecCodes[loadoutIndex],
            offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 0),
            offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 1),
            offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 2),
            offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 3),
            offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 4),
            offlineTalentLoadoutRowCodeAt(state, loadoutIndex, 5)
        )) {
        return;
    }
    state.offlineTalentActiveLoadoutIndex = loadoutIndex;
}

applyOfflineDeleteTalentLoadoutCommand(
    state: WorldState,
    playerIndex: int,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    var removeIndex = offlineTalentLoadoutCommandIndex(
        payloadOffset, payloadLength, payloadBytes
    );
    var count = state.offlineTalentLoadoutSpecCodes.length;
    if (removeIndex < 0 || !state.offlineSessionActive ||
        playerIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <uint>state.entityKinds[playerIndex] != <uint>1 || removeIndex >= count ||
        offlineTalentAllocationLocked(state, playerIndex)) {
        return;
    }
    var nextActive = state.offlineTalentActiveLoadoutIndex;
    if (nextActive == removeIndex) {
        nextActive = count > 1 ? (removeIndex < count - 1 ? removeIndex : count - 2) : -1;
        if (nextActive >= 0 && !replaceOfflineTalentAllocation(
                state, playerIndex, <uint>state.offlineTalentLoadoutSpecCodes[nextActive],
                offlineTalentLoadoutRowCodeAt(state, nextActive, 0),
                offlineTalentLoadoutRowCodeAt(state, nextActive, 1),
                offlineTalentLoadoutRowCodeAt(state, nextActive, 2),
                offlineTalentLoadoutRowCodeAt(state, nextActive, 3),
                offlineTalentLoadoutRowCodeAt(state, nextActive, 4),
                offlineTalentLoadoutRowCodeAt(state, nextActive, 5)
            )) {
            return;
        }
    } else if (nextActive > removeIndex) {
        nextActive = nextActive - 1;
    }
    var nextNameOffsets = new container.Array<uint>();
    nextNameOffsets.add(<uint>0);
    var nextNameBytes = new container.Array<uint>();
    var nextSpecCodes = new container.Array<uint>();
    var nextRowCodes = new container.Array<uint>();
    var nextBarCodes = new container.Array<uint>();
    var sourceIndex = 0;
    while (sourceIndex < count) {
        if (sourceIndex != removeIndex) {
            var nameStart = <int><uint>state.offlineTalentLoadoutNameOffsets[sourceIndex];
            var nameEnd = <int><uint>state.offlineTalentLoadoutNameOffsets[sourceIndex + 1];
            var nameIndex = nameStart;
            while (nameIndex < nameEnd) {
                nextNameBytes.add(<uint>state.offlineTalentLoadoutNameBytes[nameIndex]);
                nameIndex = nameIndex + 1;
            }
            nextNameOffsets.add(<uint>nextNameBytes.length);
            nextSpecCodes.add(<uint>state.offlineTalentLoadoutSpecCodes[sourceIndex]);
            var rowIndex = 0;
            while (rowIndex < 6) {
                nextRowCodes.add(offlineTalentLoadoutRowCodeAt(state, sourceIndex, rowIndex));
                rowIndex = rowIndex + 1;
            }
            var barIndex = 0;
            while (barIndex < talentLoadoutContract.barSlots(true)) {
                nextBarCodes.add(<uint>state.offlineTalentLoadoutActionBarAbilityCodes[
                    sourceIndex * talentLoadoutContract.barSlots(true) + barIndex
                ]);
                barIndex = barIndex + 1;
            }
        }
        sourceIndex = sourceIndex + 1;
    }
    state.offlineTalentLoadoutNameOffsets = nextNameOffsets;
    state.offlineTalentLoadoutNameBytes = nextNameBytes;
    state.offlineTalentLoadoutSpecCodes = nextSpecCodes;
    state.offlineTalentLoadoutRowOptionCodes = nextRowCodes;
    state.offlineTalentLoadoutActionBarAbilityCodes = nextBarCodes;
    state.offlineTalentActiveLoadoutIndex = nextActive;
}

clearOfflineResurrectionOffer(state: WorldState, targetIndex: int): void {
    state.entityResurrectionOfferPresent[targetIndex] = false;
    state.entityResurrectionOfferCasterIds[targetIndex] = <uint>0;
    state.entityResurrectionOfferHpFractions[targetIndex] = 0.0;
    state.entityResurrectionOfferFallbackX[targetIndex] = 0.0;
    state.entityResurrectionOfferFallbackY[targetIndex] = 0.0;
    state.entityResurrectionOfferFallbackZ[targetIndex] = 0.0;
    state.entityResurrectionOfferExpiresAtMicros[targetIndex] = <uint>0;
}

clearOfflineGhostAndCorpse(state: WorldState, playerIndex: int): void {
    state.entityGhost[playerIndex] = false;
    state.entityCorpsePresent[playerIndex] = false;
    state.entityCorpseX[playerIndex] = 0.0;
    state.entityCorpseY[playerIndex] = 0.0;
    state.entityCorpseZ[playerIndex] = 0.0;
}

// The source clears the queued ability plus both one-shot billing modifiers on
// every death and resurrection terminal path. Keep that triple atomic in WOS.
clearQueuedOnSwing(state: WorldState, index: int): void {
    state.entityQueuedOnSwingAbilityCodes[index] = <uint>0;
    state.entityQueuedOnSwingFree[index] = false;
    state.entityQueuedOnSwingCostMultipliers[index] = 1.0;
}

// The source clears the character-bound combo pool on death, while retaining
// its historical expiry timestamp. `updateComboExpiry` only resets the pool as
// well, so the timestamp must not be normalized here.
clearOfflineComboPoints(state: WorldState, index: int): void {
    state.entityComboPoints[index] = 0;
}

spiritStateIsValid(state: WorldState, index: int): bool {
    var ghost = <bool>state.entityGhost[index];
    var corpsePresent = <bool>state.entityCorpsePresent[index];
    var corpseX = <float>state.entityCorpseX[index];
    var corpseY = <float>state.entityCorpseY[index];
    var corpseZ = <float>state.entityCorpseZ[index];
    var sicknessMicros = <uint>state.entityResurrectionSicknessMicros[index];
    if (<uint>state.entityKinds[index] != <uint>1) {
        return !ghost && !corpsePresent && corpseX == 0.0 && corpseY == 0.0 &&
            corpseZ == 0.0 && sicknessMicros == <uint>0;
    }
    if (ghost) {
        return <bool>state.entityDead[index] && corpsePresent;
    }
    return !corpsePresent && corpseX == 0.0 && corpseY == 0.0 && corpseZ == 0.0;
}

clearOfflineCombatPosture(state: WorldState, playerIndex: int): void {
    state.entityTargetIds[playerIndex] = <uint>0;
    state.entityAutoAttack[playerIndex] = false;
    clearQueuedOnSwing(state, playerIndex);
    clearOfflineComboPoints(state, playerIndex);
    clearHeldMovement(state, playerIndex);
    state.entityCastingAbility[playerIndex] = <uint>0;
    state.entityCastTargetIds[playerIndex] = <uint>0;
    state.entityCastRemaining[playerIndex] = 0.0;
    state.entityCastTotal[playerIndex] = 0.0;
    state.entityCastingFlags[playerIndex] = <uint>0;
    state.entityChannelTickEvery[playerIndex] = 0.0;
    state.entityChannelTickTimer[playerIndex] = 0.0;
    state.entityChannelTicksLeft[playerIndex] = 0;
    state.entityCastPushbackReduction[playerIndex] = 0.0;
    state.entityCastGcdRemaining[playerIndex] = 0.0;
    state.entityQueuedCastAbility[playerIndex] = <uint>0;
    state.entityQueuedCastDuration[playerIndex] = 0.0;
    state.entityQueuedChannelTickEvery[playerIndex] = 0.0;
    state.entityQueuedChannelTickCount[playerIndex] = 0;
    state.entityQueuedCastGcd[playerIndex] = 0.0;
}

placeOfflineSpiritAt(state: WorldState, playerIndex: int, x: float, z: float): void {
    var groundY = terrainGround.builtinGroundHeight(x, z, state.worldSeed, true);
    state.entityX[playerIndex] = x;
    state.entityY[playerIndex] = groundY;
    state.entityZ[playerIndex] = z;
    state.entityPreviousX[playerIndex] = x;
    state.entityPreviousY[playerIndex] = groundY;
    state.entityPreviousZ[playerIndex] = z;
    state.entityFacing[playerIndex] = 0.0;
    state.entityPreviousFacing[playerIndex] = 0.0;
    state.entityVelocityX[playerIndex] = 0.0;
    state.entityVelocityY[playerIndex] = 0.0;
    state.entityVelocityZ[playerIndex] = 0.0;
    state.entityOnGround[playerIndex] = true;
    state.entityJumping[playerIndex] = false;
    state.entityFallStartY[playerIndex] = groundY;
}

resurrectionSicknessDurationMicros(level: int): uint {
    if (level < 10) {
        return <uint>0;
    }
    var seconds = terrainGradient.javascriptRound(
        60.0 + <float>(level - 10) / 50.0 * 540.0, true
    );
    return <uint>seconds * <uint>1000000;
}

// Source releaseSpirit records the corpse before moving the player to the
// nearest overworld graveyard. WOC presently has no arena/delve instance
// ownership, so this reducer intentionally covers the source overworld branch.
applyOfflineReleaseSpiritCommand(state: WorldState, playerIndex: int): void {
    if (!<bool>state.entityDead[playerIndex] || <bool>state.entityGhost[playerIndex]) {
        return;
    }
    state.entityCorpsePresent[playerIndex] = true;
    state.entityCorpseX[playerIndex] = <float>state.entityX[playerIndex];
    state.entityCorpseY[playerIndex] = <float>state.entityY[playerIndex];
    state.entityCorpseZ[playerIndex] = <float>state.entityZ[playerIndex];
    state.entityGhost[playerIndex] = true;
    var graveyardIndex = spiritGraveyards.nearestIndex(
        <float>state.entityX[playerIndex], <float>state.entityZ[playerIndex], true
    );
    placeOfflineSpiritAt(
        state, playerIndex, spiritGraveyards.xAt(graveyardIndex, true),
        spiritGraveyards.zAt(graveyardIndex, true)
    );
    state.entityHp[playerIndex] = <int>state.entityMaxHp[playerIndex];
    clearOfflineCombatPosture(state, playerIndex);
}

applyOfflineResurrectAtCorpseCommand(state: WorldState, playerIndex: int): void {
    if (!<bool>state.entityDead[playerIndex] || !<bool>state.entityGhost[playerIndex] ||
        !<bool>state.entityCorpsePresent[playerIndex]) {
        return;
    }
    var dx = <float>state.entityX[playerIndex] - <float>state.entityCorpseX[playerIndex];
    var dz = <float>state.entityZ[playerIndex] - <float>state.entityCorpseZ[playerIndex];
    if (dx * dx + dz * dz > 1225.0) {
        return;
    }
    reviveOfflinePlayerAt(
        state, playerIndex, <float>state.entityX[playerIndex], <float>state.entityZ[playerIndex], 0.5
    );
}

applyOfflineResurrectAtSpiritHealerCommand(state: WorldState, playerIndex: int): void {
    if (!<bool>state.entityDead[playerIndex] || !<bool>state.entityGhost[playerIndex] ||
        !spiritGraveyards.healerInRange(
            <float>state.entityX[playerIndex], <float>state.entityZ[playerIndex], true
        )) {
        return;
    }
    reviveOfflinePlayerAt(
        state, playerIndex, <float>state.entityX[playerIndex], <float>state.entityZ[playerIndex], 0.2
    );
    state.entityResurrectionSicknessMicros[playerIndex] =
        resurrectionSicknessDurationMicros(<int>state.entityLevels[playerIndex]);
}

resurrectionOfferStateIsValid(state: WorldState, targetIndex: int): bool {
    var present = <bool>state.entityResurrectionOfferPresent[targetIndex];
    var casterId = <uint>state.entityResurrectionOfferCasterIds[targetIndex];
    var hpFraction = <float>state.entityResurrectionOfferHpFractions[targetIndex];
    var fallbackX = <float>state.entityResurrectionOfferFallbackX[targetIndex];
    var fallbackY = <float>state.entityResurrectionOfferFallbackY[targetIndex];
    var fallbackZ = <float>state.entityResurrectionOfferFallbackZ[targetIndex];
    var expiresAt = <uint>state.entityResurrectionOfferExpiresAtMicros[targetIndex];
    if (!present) {
        return casterId == <uint>0 && hpFraction == 0.0 && fallbackX == 0.0 &&
            fallbackY == 0.0 && fallbackZ == 0.0 && expiresAt == <uint>0;
    }
    return <uint>state.entityKinds[targetIndex] == <uint>1 &&
        <bool>state.entityDead[targetIndex] && casterId != <uint>0 &&
        hpFraction > 0.0 && hpFraction <= 1.0 && expiresAt > state.timeMicros;
}

abilityCooldownExpiresAt(
    state: WorldState, entityIndex: int, abilityCode: uint
): uint {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length ||
        abilityCode == <uint>0 ||
        state.entityAbilityCooldownOffsets.length != state.entityIds.length + 1) {
        return <uint>0;
    }
    var index = <int><uint>state.entityAbilityCooldownOffsets[entityIndex];
    var end = <int><uint>state.entityAbilityCooldownOffsets[entityIndex + 1];
    while (index < end) {
        if (<uint>state.entityAbilityCooldownCodes[index] == abilityCode) {
            return <uint>state.entityAbilityCooldownExpiresAtMicros[index];
        }
        index = index + 1;
    }
    return <uint>0;
}

setAbilityCooldownExpiration(
    state: WorldState, entityIndex: int, abilityCode: uint, expiresAtMicros: uint
): void {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length ||
        abilityCode == <uint>0 || expiresAtMicros <= state.timeMicros) {
        throw "woc ability cooldown expiration is invalid";
    }
    var start = <int><uint>state.entityAbilityCooldownOffsets[entityIndex];
    var end = <int><uint>state.entityAbilityCooldownOffsets[entityIndex + 1];
    var insertAt = start;
    while (insertAt < end &&
        <uint>state.entityAbilityCooldownCodes[insertAt] < abilityCode) {
        insertAt = insertAt + 1;
    }
    if (insertAt < end && <uint>state.entityAbilityCooldownCodes[insertAt] == abilityCode) {
        state.entityAbilityCooldownExpiresAtMicros[insertAt] = expiresAtMicros;
        return;
    }
    state.entityAbilityCooldownCodes.add(<uint>0);
    state.entityAbilityCooldownExpiresAtMicros.add(<uint>0);
    var cursor = state.entityAbilityCooldownCodes.length - 1;
    while (cursor > insertAt) {
        state.entityAbilityCooldownCodes[cursor] =
            <uint>state.entityAbilityCooldownCodes[cursor - 1];
        state.entityAbilityCooldownExpiresAtMicros[cursor] =
            <uint>state.entityAbilityCooldownExpiresAtMicros[cursor - 1];
        cursor = cursor - 1;
    }
    state.entityAbilityCooldownCodes[insertAt] = abilityCode;
    state.entityAbilityCooldownExpiresAtMicros[insertAt] = expiresAtMicros;
    var offsetIndex = entityIndex + 1;
    while (offsetIndex < state.entityAbilityCooldownOffsets.length) {
        state.entityAbilityCooldownOffsets[offsetIndex] =
            <uint>state.entityAbilityCooldownOffsets[offsetIndex] + <uint>1;
        offsetIndex = offsetIndex + 1;
    }
}

clearExpiredAbilityCooldowns(state: WorldState): void {
    var nextOffsets = new container.Array<uint>();
    var nextCodes = new container.Array<uint>();
    var nextExpiresAtMicros = new container.Array<uint>();
    nextOffsets.add(<uint>0);
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var cooldownIndex = <int><uint>state.entityAbilityCooldownOffsets[entityIndex];
        var cooldownEnd = <int><uint>state.entityAbilityCooldownOffsets[entityIndex + 1];
        while (cooldownIndex < cooldownEnd) {
            if (<uint>state.entityAbilityCooldownExpiresAtMicros[cooldownIndex] > state.timeMicros) {
                nextCodes.add(<uint>state.entityAbilityCooldownCodes[cooldownIndex]);
                nextExpiresAtMicros.add(
                    <uint>state.entityAbilityCooldownExpiresAtMicros[cooldownIndex]
                );
            }
            cooldownIndex = cooldownIndex + 1;
        }
        nextOffsets.add(<uint>nextCodes.length);
        entityIndex = entityIndex + 1;
    }
    state.entityAbilityCooldownOffsets = nextOffsets;
    state.entityAbilityCooldownCodes = nextCodes;
    state.entityAbilityCooldownExpiresAtMicros = nextExpiresAtMicros;
}

temporalReversalAbilityCode(): uint {
    var code = knownAbilityCatalog.abilityCode(temporalReversal.abilityId(true));
    if (code <= 0 || !knownAbilityCatalog.abilityExists(code)) {
        throw "Temporal Reversal is absent from the current ability catalog";
    }
    return <uint>code;
}

catalogAdmission(
    state: WorldState,
    casterIndex: int,
    abilityCode: uint,
    activeForm: string,
    isFormToggle: bool
): bool {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length ||
        <uint>state.entityKinds[casterIndex] != <uint>1 ||
        <uint>state.entityTemplates[casterIndex] == <uint>0) {
        return false;
    }
    var classIndex = <int><uint>state.entityTemplates[casterIndex] - 1;
    var classId = knownAbilityCatalog.classId(classIndex);
    if (classId == "") { return false; }
    var specCode = <uint>state.entityTalentSpecCodes[casterIndex];
    var specId = specCode == <uint>0 ? "" : talentSelectionCatalog.specId(specCode);
    return knownAbilities.sourceAbilityAdmission(
        abilityCode,
        classId,
        <int>state.entityLevels[casterIndex],
        false,
        specId,
        activeForm,
        isFormToggle,
        false
    ) == 1;
}

temporalReversalCatalogAdmission(state: WorldState, casterIndex: int, abilityCode: uint): bool {
    return catalogAdmission(state, casterIndex, abilityCode, "", false);
}

formCatalogAdmission(state: WorldState, casterIndex: int, abilityCode: uint): bool {
    if (!forms.isFormAbilityCode(abilityCode) || casterIndex < 0 ||
        casterIndex >= state.entityIds.length) {
        return false;
    }
    return catalogAdmission(
        state,
        casterIndex,
        abilityCode,
        forms.formKindForAbilityCode(<uint>state.entityActiveFormAbilityCodes[casterIndex]),
        true
    );
}

temporalReversalTargetIndex(
    state: WorldState, casterIndex: int, targetId: uint, requireRange: bool
): int {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || targetId == <uint>0) {
        return -1;
    }
    var targetIndex = partyEntityIndexById(state, targetId);
    var casterPartyId = partyIdForIndex(state, casterIndex);
    if (targetIndex < 0 || casterPartyId == <uint>0 ||
        <uint>state.entityKinds[targetIndex] != <uint>1 ||
        !<bool>state.entityDead[targetIndex] ||
        partyIdForIndex(state, targetIndex) != casterPartyId) {
        return -1;
    }
    if (requireRange) {
        var targetX = <bool>state.entityCorpsePresent[targetIndex] ?
            <float>state.entityCorpseX[targetIndex] : <float>state.entityX[targetIndex];
        var targetZ = <bool>state.entityCorpsePresent[targetIndex] ?
            <float>state.entityCorpseZ[targetIndex] : <float>state.entityZ[targetIndex];
        var dx = <float>state.entityX[casterIndex] - targetX;
        var dz = <float>state.entityZ[casterIndex] - targetZ;
        var range = temporalReversal.range(true);
        if (dx * dx + dz * dz > range * range) {
            return -1;
        }
    }
    return targetIndex;
}

temporalReversalPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>17 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>118 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>13)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>14)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>15)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>16)] == <uint>108;
}

readPayloadU64(
    payloadBytes: container.Array<uint>, payloadOffset: uint
): uint {
    var value: uint = <uint>0;
    var byteIndex: uint = <uint>0;
    var multiplier: uint = <uint>1;
    while (byteIndex < <uint>8) {
        value = value +
            <uint>payloadBytes[<int>(payloadOffset + byteIndex)] * multiplier;
        multiplier = multiplier * <uint>256;
        byteIndex = byteIndex + <uint>1;
    }
    return value;
}

// A negative i32 slot is absent in the target's JavaScript indexed lookup.
// The exact negative value is not otherwise observable by the WOS reducer.
castSlotIndexFromPayload(payloadBytes: container.Array<uint>, payloadOffset: uint): int {
    var bits = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    return bits > <uint>2147483647 ? -1 : <int>bits;
}

knownAbilityCodeAtSlot(state: WorldState, entityIndex: int, slot: int): uint {
    if (slot < 0 || entityIndex < 0 || entityIndex >= state.entityIds.length ||
        state.entityKnownAbilityOffsets.length != state.entityIds.length + 1) {
        return <uint>0;
    }
    var start = <int><uint>state.entityKnownAbilityOffsets[entityIndex];
    var end = <int><uint>state.entityKnownAbilityOffsets[entityIndex + 1];
    if (start < 0 || end < start || end > state.entityKnownAbilityCodes.length ||
        slot >= end - start) {
        return <uint>0;
    }
    return <uint>state.entityKnownAbilityCodes[start + slot];
}

queuedOnSwingPayloadAbilityCode(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): uint {
    if (abilityLength == <uint>4 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>108) {
        return <uint>knownAbilityCatalog.abilityCode("maul");
    }
    if (abilityLength != <uint>13) { return <uint>0; }
    if (<uint>payloadBytes[<int>abilityOffset] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>107 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>101) {
        return <uint>knownAbilityCatalog.abilityCode("heroic_strike");
    }
    if (<uint>payloadBytes[<int>abilityOffset] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>107 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>101) {
        return <uint>knownAbilityCatalog.abilityCode("raptor_strike");
    }
    return <uint>0;
}

startOfflineAutoAttack(state: WorldState, actorIndex: int): void {
    if (actorIndex < 0 || actorIndex >= state.entityIds.length ||
        <bool>state.entityDead[actorIndex] ||
        forms.isTravelFormAbilityCode(<uint>state.entityActiveFormAbilityCodes[actorIndex])) {
        return;
    }
    var actorId = <uint>state.entityIds[actorIndex];
    var targetId = <uint>state.entityTargetIds[actorIndex];
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || <bool>state.entityDead[targetIndex] ||
        !<bool>state.entityHostile[targetIndex]) {
        return;
    }
    state.entitySitting[actorIndex] = false;
    state.entityWeaponStowed[actorIndex] = false;
    state.entityAutoAttack[actorIndex] = true;
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[actorIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[actorIndex];
    if (dx * dx + dz * dz <= 25.0 &&
        <uint>state.entityKinds[targetIndex] == <uint>2 &&
        <uint>state.entityOwnerIds[targetIndex] == <uint>0 &&
        <uint>state.entityCastingAbility[actorIndex] == <uint>0) {
        if (<uint>state.entityAiStates[targetIndex] == <uint>1) {
            enterIdleMobAggro(state, targetIndex, actorId);
        } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
            state.entityAggroTargetIds[targetIndex] = actorId;
        }
        state.entityTargetIds[targetIndex] = actorId;
        state.setThreat(
            targetId,
            actorId,
            stateThreatValue(state, targetIndex, actorId) + 1.0,
            1
        );
        state.entityInCombat[actorIndex] = true;
        state.entityCombatTimers[actorIndex] = 0.0;
    }
}

startQueuedOnSwingCast(state: WorldState, casterIndex: int, abilityCode: uint): void {
    var abilityIndex = queuedOnSwingM4AbilityIndex(abilityCode);
    if (abilityIndex < 0 || !state.offlineSessionActive ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state,
            casterIndex,
            abilityCode,
            forms.formKindForAbilityCode(
                <uint>state.entityActiveFormAbilityCodes[casterIndex]
            ),
            false
        )) {
        return;
    }
    var targetIndex = partyEntityIndexById(state, <uint>state.entityTargetIds[casterIndex]);
    if (targetIndex < 0 || <bool>state.entityDead[targetIndex] ||
        !<bool>state.entityHostile[targetIndex]) {
        return;
    }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    if (dx * dx + dz * dz > 25.0 || absoluteAngleDifference(
            math.atan2(dx, dz), <float>state.entityFacing[casterIndex]
        ) > 1.5707963267948966) {
        return;
    }
    var togglingOff = <uint>state.entityQueuedOnSwingAbilityCodes[casterIndex] == abilityCode;
    if (!togglingOff && (abilityCooldownExpiresAt(state, casterIndex, abilityCode) >
            state.timeMicros || <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(
                abilityIndex, <int>state.entityLevels[casterIndex], "cost"
            ))) {
        return;
    }
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    if (togglingOff) {
        state.entityQueuedOnSwingAbilityCodes[casterIndex] = <uint>0;
        state.entityQueuedOnSwingFree[casterIndex] = false;
        state.entityQueuedOnSwingCostMultipliers[casterIndex] = 1.0;
        return;
    }
    state.entityQueuedOnSwingAbilityCodes[casterIndex] = abilityCode;
    state.entityQueuedOnSwingFree[casterIndex] = false;
    state.entityQueuedOnSwingCostMultipliers[casterIndex] = 1.0;
    if (!<bool>state.entityAutoAttack[casterIndex]) {
        startOfflineAutoAttack(state, casterIndex);
    }
}

consecrationAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("consecration");
    var abilityIndex = m4AbilityCatalog.indexOf("consecration");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "consecration") {
        throw "Consecration is absent from the current ability catalog";
    }
    return code;
}

consecrationPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>12 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>110;
}

summonImpAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("summon_imp");
    var abilityIndex = m4AbilityCatalog.indexOf("summon_imp");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "summon_imp" ||
        m4AbilityCatalog.text(abilityIndex, "class") != "warlock") {
        throw "Summon Imp is absent from the current ability catalog";
    }
    return code;
}

summonImpPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>10 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>112;
}

summonImpProfileIsValid(abilityIndex: int, level: int): bool {
    return abilityIndex >= 0 && m4AbilityCatalog.rankAtLevel(abilityIndex, level) > 0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 50.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 5.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 0.0;
}

summonImpCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

summonImpGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    return frostboltGlobalCooldownSeconds(state, casterIndex);
}

offlineOwnedLivingPetIndex(state: WorldState, ownerId: uint): int {
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>2 &&
            <uint>state.entityOwnerIds[index] == ownerId &&
            !<bool>state.entityDead[index]) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// Firebolt uses the generic ability-code-zero queue because its source closure
// carries a pet template rather than a generated player spell id. This profile
// check preserves the snapshot's closed attack profile while still allowing a
// dead source row to fizzle naturally during projectile advancement.
offlineEmberkinFireboltProjectileProfileIsValid(
    state: WorldState, projectileIndex: int
): bool {
    var sourceIndex = partyEntityIndexById(
        state, <uint>state.offlineProjectileSourceIds[projectileIndex]
    );
    if (sourceIndex < 0 || <uint>state.entityKinds[sourceIndex] != <uint>2 ||
        <uint>state.entityTemplates[sourceIndex] != OFFLINE_EMBERKIN_TEMPLATE_CODE ||
        <uint>state.entityOwnerIds[sourceIndex] == <uint>0 ||
        <bool>state.offlineProjectileWands[projectileIndex] ||
        <uint>state.offlineProjectileSchoolCodes[projectileIndex] !=
            OFFLINE_PROJECTILE_SCHOOL_FIRE) {
        return false;
    }
    return emberkinRanged.projectileProfileIsValid(
        <int>state.entityLevels[sourceIndex],
        <float>state.offlineProjectileMinimums[projectileIndex],
        <float>state.offlineProjectileMaximums[projectileIndex],
        <float>state.offlineProjectileSpeeds[projectileIndex]
    );
}

// WOS76 projects the command half of the source Emberkin lifecycle without
// inventing generic entity deletion or string-backed pet identity. The current
// retained summon is the Imp-family Emberkin only; other source pet templates
// keep their command routing but wait for their own complete projections.
offlineOwnedEmberkinPetIndex(
    state: WorldState, ownerId: uint, includeDead: bool
): int {
    var deadIndex = -1;
    var index = 0;
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>2 &&
            <uint>state.entityTemplates[index] == OFFLINE_EMBERKIN_TEMPLATE_CODE &&
            <uint>state.entityOwnerIds[index] == ownerId) {
            if (!<bool>state.entityDead[index]) {
                return index;
            }
            if (includeDead && deadIndex < 0) {
                deadIndex = index;
            }
        }
        index = index + 1;
    }
    return deadIndex;
}

offlinePetCommandActorIsSupported(state: WorldState, actorIndex: int): bool {
    if (!state.offlineSessionActive || actorIndex != offlineQuestPrimaryPlayerIndex(state) ||
        actorIndex < 0 || actorIndex >= state.entityIds.length ||
        <uint>state.entityKinds[actorIndex] != <uint>1 ||
        <uint>state.entityTemplates[actorIndex] != state.offlinePlayerClass + <uint>1) {
        return false;
    }
    var classId = knownAbilityCatalog.classId(<int>state.offlinePlayerClass);
    return classId == "hunter" || classId == "warlock";
}

offlinePetModeFromPayload(
    payloadOffset: uint, payloadLength: uint, payloadBytes: container.Array<uint>
): uint {
    if (payloadOffset > <uint>payloadBytes.length ||
        payloadLength > <uint>payloadBytes.length - payloadOffset || payloadLength < <uint>4) {
        throw "woc pet mode payload is truncated";
    }
    var length = <uint>payloadBytes[<int>payloadOffset] +
        <uint>payloadBytes[<int>(payloadOffset + <uint>1)] * <uint>256 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>2)] * <uint>65536 +
        <uint>payloadBytes[<int>(payloadOffset + <uint>3)] * <uint>16777216;
    if (payloadLength != length + <uint>4) {
        throw "woc pet mode payload has trailing bytes";
    }
    var textOffset = payloadOffset + <uint>4;
    if (length == <uint>7 &&
        <uint>payloadBytes[<int>textOffset] == <uint>112 &&
        <uint>payloadBytes[<int>(textOffset + <uint>1)] == <uint>97 &&
        <uint>payloadBytes[<int>(textOffset + <uint>2)] == <uint>115 &&
        <uint>payloadBytes[<int>(textOffset + <uint>3)] == <uint>115 &&
        <uint>payloadBytes[<int>(textOffset + <uint>4)] == <uint>105 &&
        <uint>payloadBytes[<int>(textOffset + <uint>5)] == <uint>118 &&
        <uint>payloadBytes[<int>(textOffset + <uint>6)] == <uint>101) {
        return <uint>1;
    }
    if (length == <uint>9 &&
        <uint>payloadBytes[<int>textOffset] == <uint>100 &&
        <uint>payloadBytes[<int>(textOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(textOffset + <uint>2)] == <uint>102 &&
        <uint>payloadBytes[<int>(textOffset + <uint>3)] == <uint>101 &&
        <uint>payloadBytes[<int>(textOffset + <uint>4)] == <uint>110 &&
        <uint>payloadBytes[<int>(textOffset + <uint>5)] == <uint>115 &&
        <uint>payloadBytes[<int>(textOffset + <uint>6)] == <uint>105 &&
        <uint>payloadBytes[<int>(textOffset + <uint>7)] == <uint>118 &&
        <uint>payloadBytes[<int>(textOffset + <uint>8)] == <uint>101) {
        return <uint>2;
    }
    if (length == <uint>10 &&
        <uint>payloadBytes[<int>textOffset] == <uint>97 &&
        <uint>payloadBytes[<int>(textOffset + <uint>1)] == <uint>103 &&
        <uint>payloadBytes[<int>(textOffset + <uint>2)] == <uint>103 &&
        <uint>payloadBytes[<int>(textOffset + <uint>3)] == <uint>114 &&
        <uint>payloadBytes[<int>(textOffset + <uint>4)] == <uint>101 &&
        <uint>payloadBytes[<int>(textOffset + <uint>5)] == <uint>115 &&
        <uint>payloadBytes[<int>(textOffset + <uint>6)] == <uint>115 &&
        <uint>payloadBytes[<int>(textOffset + <uint>7)] == <uint>105 &&
        <uint>payloadBytes[<int>(textOffset + <uint>8)] == <uint>118 &&
        <uint>payloadBytes[<int>(textOffset + <uint>9)] == <uint>101) {
        return <uint>3;
    }
    throw "woc pet mode is invalid";
}

offlinePetBooleanFromPayload(
    payloadOffset: uint, payloadLength: uint, payloadBytes: container.Array<uint>
): bool {
    if (payloadLength != <uint>1 || payloadOffset >= <uint>payloadBytes.length) {
        throw "woc pet autocast payload is invalid";
    }
    var marker = <uint>payloadBytes[<int>payloadOffset];
    if (marker > <uint>1) { throw "woc pet autocast marker is invalid"; }
    return marker == <uint>1;
}

reviveOfflineEmberkinPet(state: WorldState, actorIndex: int, petIndex: int): void {
    if (actorIndex < 0 || petIndex < 0 || petIndex >= state.entityIds.length ||
        !<bool>state.entityDead[petIndex] ||
        <uint>state.entityCorpseMicros[petIndex] == <uint>0) {
        return;
    }
    var x = <float>state.entityX[actorIndex] + 2.0;
    var z = <float>state.entityZ[actorIndex] + 1.0;
    var y = terrainGround.builtinGroundHeight(x, z, state.worldSeed, true);
    state.entityDead[petIndex] = false;
    state.entityHostile[petIndex] = false;
    state.entityOwnerIds[petIndex] = <uint>state.entityIds[actorIndex];
    state.entityAiStates[petIndex] = mobLifecycle.idleAiState();
    state.entityAggroTargetIds[petIndex] = <uint>0;
    state.entityInCombat[petIndex] = false;
    state.entityCombatTimers[petIndex] = 99.0;
    state.entityLootable[petIndex] = false;
    state.entityTappedByIds[petIndex] = <uint>0;
    state.entityRespawnMicros[petIndex] = <uint>0;
    state.entityCorpseMicros[petIndex] = <uint>0;
    state.entityX[petIndex] = x;
    state.entityY[petIndex] = y;
    state.entityZ[petIndex] = z;
    state.entityPreviousX[petIndex] = x;
    state.entityPreviousY[petIndex] = y;
    state.entityPreviousZ[petIndex] = z;
    var restoredHp = <int>math.round(<float>state.entityMaxHp[petIndex] * 0.35);
    if (restoredHp < 1) { restoredHp = 1; }
    state.entityHp[petIndex] = restoredHp;
    clearStateThreat(state, petIndex);
}

applyOfflineEmberkinPetCommand(
    state: WorldState,
    actorIndex: int,
    commandId: uint,
    payloadOffset: uint,
    payloadLength: uint,
    payloadBytes: container.Array<uint>
): void {
    if (!offlinePetCommandActorIsSupported(state, actorIndex)) { return; }
    var payloads = %import("protocol/command_payloads");
    var actorId = <uint>state.entityIds[actorIndex];
    var reviveCommand = payloads.petReviveCommandId(true);
    var attackCommand = payloads.petAttackCommandId(true);
    var tauntCommand = payloads.petTauntCommandId(true);
    var autoTauntCommand = payloads.petAutoTauntCommandId(true);
    var waterJetCommand = payloads.petWaterJetCommandId(true);
    var autoWaterJetCommand = payloads.petAutoWaterJetCommandId(true);
    var modeCommand = payloads.petModeCommandId(true);
    var includeDead = commandId == reviveCommand || commandId == autoTauntCommand ||
        commandId == autoWaterJetCommand || commandId == modeCommand;
    var petIndex = offlineOwnedEmberkinPetIndex(state, actorId, includeDead);
    if (petIndex < 0) { return; }

    if (commandId == reviveCommand) {
        reviveOfflineEmberkinPet(state, actorIndex, petIndex);
        return;
    }
    if (commandId == modeCommand) {
        var mode = offlinePetModeFromPayload(payloadOffset, payloadLength, payloadBytes);
        state.entityPetModes[petIndex] = mode;
        if (mode == <uint>1) {
            state.entityAggroTargetIds[petIndex] = <uint>0;
            state.entityInCombat[petIndex] = false;
            state.entityAutoAttack[petIndex] = false;
            state.entityPetManualTauntPending[petIndex] = false;
        }
        return;
    }
    if (commandId == autoTauntCommand) {
        offlinePetBooleanFromPayload(payloadOffset, payloadLength, payloadBytes);
        // Emberkin is the Imp projection, whose source template disables taunt.
        state.entityPetAutoTaunt[petIndex] = false;
        return;
    }
    if (commandId == autoWaterJetCommand) {
        offlinePetBooleanFromPayload(payloadOffset, payloadLength, payloadBytes);
        // Emberkin has no Water Jet profile, so its source command clears this flag.
        state.entityPetAutoWaterJet[petIndex] = false;
        return;
    }
    if (commandId == attackCommand) {
        var targetId = <uint>state.entityTargetIds[actorIndex];
        var targetIndex = partyEntityIndexById(state, targetId);
        if (targetIndex < 0 || <bool>state.entityDead[targetIndex] ||
            !<bool>state.entityHostile[targetIndex]) {
            return;
        }
        state.entityAggroTargetIds[petIndex] = targetId;
        state.entityInCombat[petIndex] = true;
        state.setThreat(
            targetId,
            <uint>state.entityIds[petIndex],
            stateThreatValue(state, targetIndex, <uint>state.entityIds[petIndex]) + 1.0,
            1
        );
        return;
    }
    // The Emberkin template cannot taunt and has no Water Jet. Both source
    // commands are deliberate no-ops after their owner/pet checks above.
    if (commandId != tauntCommand && commandId != waterJetCommand) {
        throw "woc Emberkin pet command is unknown";
    }
}

// The source removes a replaced demon from its entity Map. WOS parallel rows
// cannot erase a complete generic entity transactionally until Plugins08 owns
// that ABI, so the reducer retires it into an inert, owner-bound row instead.
retireOfflineOwnedPet(state: WorldState, petIndex: int): void {
    if (petIndex < 0 || petIndex >= state.entityIds.length ||
        <uint>state.entityKinds[petIndex] != <uint>2 ||
        <uint>state.entityOwnerIds[petIndex] == <uint>0) {
        return;
    }
    state.entityDead[petIndex] = true;
    state.entityHp[petIndex] = 0;
    state.entityHostile[petIndex] = false;
    state.entityLootable[petIndex] = false;
    state.entityCorpseMicros[petIndex] = <uint>0;
    state.entityRespawnMicros[petIndex] = <uint>0;
    state.entityAiStates[petIndex] = mobLifecycle.deadAiState();
    state.entityTargetIds[petIndex] = <uint>0;
    state.entityAggroTargetIds[petIndex] = <uint>0;
    state.entityInCombat[petIndex] = false;
    state.entityCombatTimers[petIndex] = 99.0;
    clearStateThreat(state, petIndex);
}

// Source handleDeath leaves a summoned demon as a dead, non-hostile pet for
// three seconds before updateMob removes it. WOS retains the post-removal row,
// but only this bounded interval is eligible for the source revive command.
beginOfflineEmberkinDemonDeath(state: WorldState, petIndex: int): void {
    retireOfflineOwnedPet(state, petIndex);
    if (petIndex >= 0 && petIndex < state.entityIds.length &&
        <uint>state.entityTemplates[petIndex] == OFFLINE_EMBERKIN_TEMPLATE_CODE) {
        state.entityCorpseMicros[petIndex] = OFFLINE_EMBERKIN_DEMON_CORPSE_MICROS;
    }
}

ageOfflineEmberkinDemonCorpses(state: WorldState): void {
    var index = 0;
    var tickMicros = <uint>mobLifecycle.fixedTickMicros();
    while (index < state.entityIds.length) {
        if (<uint>state.entityKinds[index] == <uint>2 &&
            <uint>state.entityTemplates[index] == OFFLINE_EMBERKIN_TEMPLATE_CODE &&
            <uint>state.entityOwnerIds[index] != <uint>0 &&
            <bool>state.entityDead[index] &&
            <uint>state.entityCorpseMicros[index] > <uint>0) {
            var remaining = <uint>state.entityCorpseMicros[index];
            state.entityCorpseMicros[index] = remaining > tickMicros ?
                remaining - tickMicros : <uint>0;
        }
        index = index + 1;
    }
}

spawnOfflineEmberkin(state: WorldState, casterIndex: int): uint {
    if (casterIndex < 0 || casterIndex >= state.entityIds.length ||
        <uint>state.entityKinds[casterIndex] != <uint>1) {
        return <uint>0;
    }
    var level = <int>state.entityLevels[casterIndex];
    if (level < 1) { return <uint>0; }
    var x = <float>state.entityX[casterIndex] + 2.0;
    var z = <float>state.entityZ[casterIndex] + 1.0;
    var maxHp = OFFLINE_EMBERKIN_HP_BASE + OFFLINE_EMBERKIN_HP_PER_LEVEL * (level - 1);
    var petId = state.spawnMob(
        OFFLINE_EMBERKIN_TEMPLATE_CODE,
        level,
        x,
        terrainGround.builtinGroundHeight(x, z, state.worldSeed, true),
        z,
        maxHp,
        OFFLINE_EMBERKIN_MOVE_SPEED
    );
    var petIndex = state.entityIds.length - 1;
    state.entityOwnerIds[petIndex] = <uint>state.entityIds[casterIndex];
    state.entityHostile[petIndex] = false;
    state.entityAiStates[petIndex] = mobLifecycle.idleAiState();
    state.entityTargetIds[petIndex] = <uint>0;
    state.entityAggroTargetIds[petIndex] = <uint>0;
    state.entityInCombat[petIndex] = false;
    state.entityCombatTimers[petIndex] = 99.0;
    state.entityPetModes[petIndex] = <uint>2;
    state.entityPetTauntTimers[petIndex] = 0.0;
    state.entityPetAutoTauntPresent[petIndex] = true;
    state.entityPetAutoTaunt[petIndex] = false;
    state.entityPetAutoWaterJetPresent[petIndex] = true;
    state.entityPetAutoWaterJet[petIndex] = false;
    state.entityPetManualTauntPendingPresent[petIndex] = true;
    state.entityPetManualTauntPending[petIndex] = false;
    state.entityWeaponMinimum[petIndex] = emberkinRanged.weaponMinimumForLevel(level);
    state.entityWeaponMaximum[petIndex] = emberkinRanged.weaponMaximumForLevel(level);
    state.entityWeaponSpeed[petIndex] = emberkinRanged.fireboltWeaponSpeed();
    state.entityArmor[petIndex] = 8 * (level - 1);
    state.entityPresentationScales[petIndex] = OFFLINE_EMBERKIN_PRESENTATION_SCALE;
    state.entityPresentationColors[petIndex] = OFFLINE_EMBERKIN_PRESENTATION_COLOR;
    return petId;
}

startOfflineSummonImpCast(state: WorldState, casterIndex: int): void {
    var abilityCode = summonImpAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("summon_imp");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!summonImpProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        summonImpCastSeconds(state, casterIndex, abilityIndex),
        summonImpGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineSummonImpCast(state: WorldState, casterIndex: int): void {
    var abilityCode = summonImpAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("summon_imp");
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || abilityIndex < 0) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!summonImpProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode)) {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    retireOfflineOwnedPet(
        state, offlineOwnedLivingPetIndex(state, <uint>state.entityIds[casterIndex])
    );
    if (spawnOfflineEmberkin(state, casterIndex) == <uint>0) {
        throw "woc Summon Imp Emberkin spawn is invalid";
    }
}

consecrationGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

arcaneExplosionAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("arcane_explosion");
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_explosion");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "arcane_explosion") {
        throw "Arcane Explosion is absent from the current ability catalog";
    }
    return code;
}

arcaneExplosionPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>16 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>120 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>112 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>13)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>14)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>15)] == <uint>110;
}

// Source spell haste floors the Mage GCD at 1.5 seconds. The retained
// Eastbrook projection has no spell-haste modifier, so its base path is exact.
arcaneExplosionGlobalCooldownSeconds(): float { return 1.5; }

glacialFrontAbilityCode(): uint {
    var code = empoweredConeContract.glacialFrontAbilityCode(true);
    var abilityIndex = m4AbilityCatalog.indexOf("glacial_front");
    if (code == <uint>0 || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "glacial_front" ||
        m4AbilityCatalog.text(abilityIndex, "school") != "frost" ||
        !empoweredConeContract.isEmpoweredCone(code)) {
        throw "Glacial Front is absent from the current ability catalog";
    }
    return code;
}

glacialFrontGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS /
        mageSpellHasteMultiplier(state, casterIndex);
    return gcd < OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS ?
        OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS : gcd;
}

startOfflineGlacialFrontCast(state: WorldState, casterIndex: int): void {
    var abilityCode = glacialFrontAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("glacial_front");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (cost <= 0 || <float>state.entityResources[casterIndex] < cost ||
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") !=
            empoweredConeContract.castTime(abilityCode) ||
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") != 12.0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armEmpowered(
        abilityCode,
        empoweredConeContract.castTime(abilityCode) /
            mageSpellHasteMultiplier(state, casterIndex),
        glacialFrontGlobalCooldownSeconds(state, casterIndex),
        false,
        empoweredConeContract.stageCount(abilityCode)
    );
    cast.lockTargets(false, false);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineGlacialFrontCast(
    state: WorldState, casterIndex: int, resolvedLevel: int
): void {
    var abilityCode = glacialFrontAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("glacial_front");
    if (abilityIndex < 0 || casterIndex < 0 || casterIndex >= state.entityIds.length ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode)) {
        return;
    }
    var playerLevel = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, playerLevel, "cost");
    if (cost <= 0 || <float>state.entityResources[casterIndex] < cost) { return; }
    var cast = empoweredCone.beginCast(abilityCode, resolvedLevel);
    if (!cast.valid) { return; }

    var overloadMultiplier = consumeOfflineOverloadSpell(state, casterIndex, cost);
    spendOfflineAbilityResource(
        state, casterIndex, offlineOverloadBillableCost(cost, overloadMultiplier)
    );
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode, state.timeMicros + <uint>12000000
    );

    var spellPower = <float>spellScaling.directHitBonus(
        <float>state.entitySpellPower[casterIndex], "frost", false,
        empoweredConeContract.castTime(abilityCode) *
            (<float>cast.level / <float>empoweredConeContract.stageCount(abilityCode)),
        true
    );
    var origin = new empoweredCone.PointXZ(
        <float>state.entityX[casterIndex], <float>state.entityZ[casterIndex]
    );
    var sourceId = <uint>state.entityIds[casterIndex];
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var retainedTarget = isOfflineEastbrookLifecycleMob(state, entityIndex) &&
            <bool>state.entityHostile[entityIndex] && !<bool>state.entityDead[entityIndex];
        if (retainedTarget) {
            var target = new empoweredCone.PointXZ(
                <float>state.entityX[entityIndex], <float>state.entityZ[entityIndex]
            );
            // Eastbrook's retained outdoor subset has no dynamic occluders; the
            // source cone and target iteration still decide RNG consumption.
            var eligible = empoweredCone.beginCast(abilityCode, cast.level);
            if (eligible.valid && glacialFront.glacialFrontContains(
                    origin, <float>state.entityFacing[casterIndex], target,
                    eligible.range, eligible.angle)) {
                var critChance = offlineDamageCritChance(state, casterIndex);
                var critRoll = nextAuthoritativeRandomUnit(state) < critChance;
                var damageUnit = nextAuthoritativeRandomUnit(state);
                var expectedDamage = empoweredCone.resolveHitWithStageDamage(
                    abilityCode, cast.level, origin,
                    <float>state.entityFacing[casterIndex], target,
                    true, true,
                    <int>state.entityHp[entityIndex] > 0,
                    critRoll, false, damageUnit, spellPower,
                    <float>state.entitySpellDamageMultipliers[casterIndex],
                    <float>state.entityCritDamageSpellBonus[casterIndex],
                    offlineOverloadScaledPositiveMetric(
                        empoweredConeContract.stageMinimumDamage(abilityCode, cast.level),
                        overloadMultiplier
                    ),
                    offlineOverloadScaledPositiveMetric(
                        empoweredConeContract.stageMaximumDamage(abilityCode, cast.level),
                        overloadMultiplier
                    )
                );
                // ResolveHit needs the post-damage liveness gate for control.
                // Re-run it with the exact selected draws and predicted result;
                // no additional RNG is consumed by this pure calculation.
                var targetSurvives = <int>state.entityHp[entityIndex] > expectedDamage.damage;
                var hit = empoweredCone.resolveHitWithStageDamage(
                    abilityCode, cast.level, origin,
                    <float>state.entityFacing[casterIndex], target,
                    true, true, targetSurvives, critRoll, false,
                    damageUnit, spellPower,
                    <float>state.entitySpellDamageMultipliers[casterIndex],
                    <float>state.entityCritDamageSpellBonus[casterIndex],
                    offlineOverloadScaledPositiveMetric(
                        empoweredConeContract.stageMinimumDamage(abilityCode, cast.level),
                        overloadMultiplier
                    ),
                    offlineOverloadScaledPositiveMetric(
                        empoweredConeContract.stageMaximumDamage(abilityCode, cast.level),
                        overloadMultiplier
                    )
                );
                var hp = <int>state.entityHp[entityIndex] - hit.damage;
                state.entityHp[entityIndex] = hp > 0 ? hp : 0;
                if (hit.damage > 0) {
                    clearOfflineBreakableIncapacitateOnDamage(state, entityIndex, hit.damage);
                }
                if (hp > 0) {
                    if (hit.appliesSlow) {
                        applyOfflineMotionAuraWithDetailsAndSchool(
                            state, entityIndex, abilityCode, sourceId,
                            ccContract.motionAuraKindCode("slow"), hit.slowDuration,
                            hit.slowMultiplier, 0.0, OFFLINE_PROJECTILE_SCHOOL_FROST
                        );
                    }
                    if (hit.appliesRoot) {
                        applyOfflineMotionAuraWithDetailsAndSchool(
                            state, entityIndex, abilityCode, sourceId,
                            ccContract.motionAuraKindCode("root"), hit.rootDuration,
                            0.0, 0.0, OFFLINE_PROJECTILE_SCHOOL_FROST
                        );
                    }
                    state.entityInCombat[casterIndex] = true;
                    state.entityCombatTimers[casterIndex] = 0.0;
                    state.entityInCombat[entityIndex] = true;
                    state.entityCombatTimers[entityIndex] = 0.0;
                    if (<uint>state.entityAiStates[entityIndex] == mobLifecycle.idleAiState()) {
                        enterIdleMobAggro(state, entityIndex, sourceId);
                    } else if (<uint>state.entityAggroTargetIds[entityIndex] == <uint>0) {
                        state.entityAggroTargetIds[entityIndex] = sourceId;
                    }
                    state.setThreat(
                        <uint>state.entityIds[entityIndex], sourceId,
                        stateThreatValue(state, entityIndex, sourceId) +
                            <float>hit.damage *
                                m4AbilityCatalog.metric(abilityIndex, playerLevel, "threatMult") +
                            m4AbilityCatalog.metric(abilityIndex, playerLevel, "threatFlat"),
                        1
                    );
                } else {
                    settleOfflineEastbrookLethal(state, entityIndex, casterIndex);
                }
            }
        }
        entityIndex = entityIndex + 1;
    }
}

dragonsBreathAbilityCode(): uint {
