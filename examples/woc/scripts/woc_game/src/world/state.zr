igniteAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("ignition");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(<int>code) ||
        knownAbilityCatalog.abilityId(<int>code) != fireMageContract.igniteId()) {
        throw "Ignition is absent from the current ability catalog";
    }
    return code;
}

igniteDotProfileIsValid(damage: int, duration: float, interval: float): bool {
    return damage > 0 && duration == fireMageContract.igniteDuration() &&
        interval == fireMageContract.igniteInterval();
}

// The source Ignite aura is keyed by target, source and aura id. Refreshing an
// owned row adds its per-tick value and duration, but deliberately leaves its
// next tick timer intact.
applyOfflineIgniteDot(
    state: WorldState,
    targetId: uint,
    sourceId: uint,
    damage: int
): void {
    var abilityCode = ignitionAbilityCode();
    var duration = fireMageContract.igniteDuration();
    var interval = fireMageContract.igniteInterval();
    if (targetId == <uint>0 || sourceId == <uint>0 || targetId == sourceId ||
        !igniteDotProfileIsValid(damage, duration, interval)) {
        throw "woc Ignite dot profile is invalid";
    }
    var index = 0;
    while (index < state.offlineDotTargetIds.length) {
        if (<uint>state.offlineDotTargetIds[index] == targetId &&
            <uint>state.offlineDotSourceIds[index] == sourceId &&
            <uint>state.offlineDotAbilityCodes[index] == abilityCode) {
            state.offlineDotDamages[index] = damage;
            state.offlineDotResolvedTotals[index] = damage *
                <int>(duration / interval + 0.5);
            state.offlineDotRemaining[index] = duration;
            state.offlineDotDurations[index] = duration;
            return;
        }
        index = index + 1;
    }
    if (state.offlineDotTargetIds.length >= <int>OFFLINE_DOT_PENDING_MAX) {
        throw "woc offline dot queue exceeds WOS cap";
    }
    state.offlineDotTargetIds.add(targetId);
    state.offlineDotSourceIds.add(sourceId);
    state.offlineDotAbilityCodes.add(abilityCode);
    state.offlineDotDamages.add(damage);
    state.offlineDotRanks.add(<uint>0);
    state.offlineDotSnapshotPowers.add(0);
    appendOfflineDotTalentState(
        state,
        sourceId,
        abilityCode,
        <uint>0,
        damage * <int>(duration / interval + 0.5),
        -1
    );
    state.offlineDotRemaining.add(duration);
    state.offlineDotDurations.add(duration);
    state.offlineDotTickIntervals.add(interval);
    state.offlineDotTickTimers.add(interval);
}

