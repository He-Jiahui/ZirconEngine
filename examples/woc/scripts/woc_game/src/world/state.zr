        effects.typeAt(abilityIndex, rank, 0) != "aoeDamage") { return false; }
    var pulse = new groundAoE.GroundEffectSpec();
    pulse.id = abilityCode; pulse.sourceId = <uint>state.entityIds[casterIndex];
    pulse.x = <float>state.entityCastAimX[casterIndex]; pulse.z = <float>state.entityCastAimZ[casterIndex];
    pulse.radius = effects.metric(abilityIndex, rank, 0, "radius");
