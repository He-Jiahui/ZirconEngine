fearPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>4 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>114;
}

fearRankLevel(rank: uint): int {
    return rank == <uint>1 ? 14 : 0;
}

// Fear has no direct numeric payload. The projectile still captures the
// resolved rank and cast time so a reload cannot reinterpret its ability.
fearProjectileProfileIsValid(
    rankCode: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("fear");
    var level = fearRankLevel(rankCode);
    if (abilityIndex < 0 || level <= 0 ||
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) != <int>rankCode ||
        m4AbilityEffects.typeAt(abilityIndex, <int>rankCode, 0) != "incapacitate") {
        return false;
    }
    return minimum == 0.0 && maximum == 0.0 &&
        castTime == m4AbilityCatalog.metric(abilityIndex, level, "castTime") &&
        m4AbilityEffects.metric(abilityIndex, <int>rankCode, 0, "duration") == 8.0;
}

fearTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("fear");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    // The retained Eastbrook outdoor subset has clear line of sight. Admission
    // retains the source hostile-facing gate; completion rechecks range only.
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <=
            2.2 ? targetIndex : -1;
}

fearCompletionTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("fear");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

fearCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
