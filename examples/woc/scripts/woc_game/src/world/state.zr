frostTrapAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("frost_trap");
    var abilityIndex = m4AbilityCatalog.indexOf("frost_trap");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(<int>code) ||
        abilityIndex < 0 || m4AbilityCatalog.text(abilityIndex, "id") != "frost_trap") {
        throw "Frost Trap is absent from the current ability catalog";
    }
    return code;
}

frostTrapPayloadAbilityIsExact(
    bytes: container.Array<uint>, offset: uint, length: uint
): bool {
    return length == <uint>10 && <uint>bytes[<int>offset] == <uint>102 &&
        <uint>bytes[<int>(offset + <uint>1)] == <uint>114 &&
        <uint>bytes[<int>(offset + <uint>2)] == <uint>111 &&
        <uint>bytes[<int>(offset + <uint>3)] == <uint>115 &&
        <uint>bytes[<int>(offset + <uint>4)] == <uint>116 &&
        <uint>bytes[<int>(offset + <uint>5)] == <uint>95 &&
        <uint>bytes[<int>(offset + <uint>6)] == <uint>116 &&
        <uint>bytes[<int>(offset + <uint>7)] == <uint>114 &&
        <uint>bytes[<int>(offset + <uint>8)] == <uint>97 &&
        <uint>bytes[<int>(offset + <uint>9)] == <uint>112;
}

frostTrapProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 && level >= 10 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == 1 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "hunter" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "frost" &&
        !m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        !m4AbilityCatalog.flag(abilityIndex, "offGcd") &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 35.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 30.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 0.0 &&
        effects.count(abilityIndex, 1) == 1 &&
        effects.typeAt(abilityIndex, 1, 0) == "aoeRoot" &&
        effects.metric(abilityIndex, 1, 0, "duration") == 3.0 &&
        effects.metric(abilityIndex, 1, 0, "radius") == 3.0 &&
        effects.metric(abilityIndex, 1, 0, "min") == 0.0 &&
        effects.metric(abilityIndex, 1, 0, "max") == 0.0 &&
        effects.flag(abilityIndex, 1, 0, "stun") &&
        effects.metric(abilityIndex, 1, 0, "trapArmTime") == 1.5 &&
        effects.metric(abilityIndex, 1, 0, "trapLifetime") == 60.0;
}

removeOfflineHunterTrapAt(state: WorldState, index: int): void {
    state.offlineHunterTrapSourceIds.removeAt(index);
    state.offlineHunterTrapAbilityCodes.removeAt(index);
    state.offlineHunterTrapX.removeAt(index);
    state.offlineHunterTrapZ.removeAt(index);
    state.offlineHunterTrapRadii.removeAt(index);
    state.offlineHunterTrapRemaining.removeAt(index);
    state.offlineHunterTrapArmRemaining.removeAt(index);
    state.offlineHunterTrapFreezeDurations.removeAt(index);
}

// This is the source `spawnHunterTrap` rider shape. A replacement removes
// only the casting hunter's prior trap; no combat starts until contact.
startOfflineFrostTrapCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = frostTrapAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("frost_trap");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var sourceId = <uint>state.entityIds[casterIndex];
    var replacesOwnTrap = false;
    var capacityIndex = 0;
    while (capacityIndex < state.offlineHunterTrapSourceIds.length) {
        if (<uint>state.offlineHunterTrapSourceIds[capacityIndex] == sourceId) {
            replacesOwnTrap = true;
        }
        capacityIndex = capacityIndex + 1;
    }
    if (!frostTrapProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost ||
        (state.offlineHunterTrapSourceIds.length >= <int>OFFLINE_DOT_PENDING_MAX &&
            !replacesOwnTrap)) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS;
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode,
        state.timeMicros + <uint>(
            m4AbilityCatalog.metric(abilityIndex, level, "cooldown") * 1000000.0
        )
    );
    var prior = state.offlineHunterTrapSourceIds.length - 1;
    while (prior >= 0) {
        if (<uint>state.offlineHunterTrapSourceIds[prior] == sourceId) {
            removeOfflineHunterTrapAt(state, prior);
        }
        prior = prior - 1;
    }
    state.offlineHunterTrapSourceIds.add(sourceId);
    state.offlineHunterTrapAbilityCodes.add(abilityCode);
    state.offlineHunterTrapX.add(<float>state.entityX[casterIndex]);
    state.offlineHunterTrapZ.add(<float>state.entityZ[casterIndex]);
    state.offlineHunterTrapRadii.add(effects.metric(abilityIndex, 1, 0, "radius"));
    state.offlineHunterTrapRemaining.add(effects.metric(abilityIndex, 1, 0, "trapLifetime"));
    state.offlineHunterTrapArmRemaining.add(effects.metric(abilityIndex, 1, 0, "trapArmTime"));
    state.offlineHunterTrapFreezeDurations.add(effects.metric(abilityIndex, 1, 0, "duration"));
}

startOfflineFrostArmorCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = frostArmorAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("frost_armor");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = <uint>m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!frostArmorProfileIsValid(abilityIndex, rank) ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    cast.gcdRemaining = ghostWolfGlobalCooldownSeconds(state, casterIndex);
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
