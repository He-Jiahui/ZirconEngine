    }
    clearOfflineBreakableIncapacitateOnDamage(restored, 0, 1);
    return !<bool>restored.entitySitting[0] &&
        <uint>restored.entityEatingItemCodes[0] == <uint>0 &&
        <int>restored.entityEatingHpPerTwoSeconds[0] == 0 &&
        floatMatches(<float>restored.entityEatingRemaining[0], 0.0) &&
