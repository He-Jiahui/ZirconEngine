drainLifeAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("drain_life");
    var abilityIndex = m4AbilityCatalog.indexOf("drain_life");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "drain_life") {
        throw "Drain Life is absent from the current ability catalog";
    }
    return code;
}

drainLifePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>10 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>100 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>101;
}

drainLifeRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 10; }
    if (rank == <uint>2) { return 14; }
    if (rank == <uint>3) { return 20; }
    return 0;
}

drainLifeProjectileShapeIsValid(rankCode: uint, castTime: float): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("drain_life");
    var level = drainLifeRankLevel(rankCode);
    if (abilityIndex < 0 || level <= 0 ||
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) != <int>rankCode ||
        effects.typeAt(abilityIndex, <int>rankCode, 0) != "drainTick") {
        return false;
    }
    return effects.metric(abilityIndex, <int>rankCode, 0, "healFrac") == 1.0 &&
        castTime == 0.0;
}

drainLifeProjectileProfileIsValid(
    rankCode: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("drain_life");
    return drainLifeProjectileShapeIsValid(rankCode, castTime) &&
        minimum == effects.metric(abilityIndex, <int>rankCode, 0, "min") &&
        maximum == effects.metric(abilityIndex, <int>rankCode, 0, "max");
}

drainLifeTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("drain_life");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    // The retained outdoor slice has a clear line of sight. The existing
    // Eastbrook projectile closure uses its two-yard positional tolerance.
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

drainLifeGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 1.0 ? 1.0 : gcd;
}

startOfflineDrainLifeCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = drainLifeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("drain_life");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var duration = m4AbilityCatalog.metric(abilityIndex, level, "channelDuration");
    var ticks = <int>m4AbilityCatalog.metric(abilityIndex, level, "channelTicks");
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || ticks <= 0 || duration <= 0.0 ||
        effects.typeAt(abilityIndex, rank, 0) != "drainTick" ||
        <float>state.entityResources[casterIndex] < cost ||
        drainLifeTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var hastedDuration = duration / mageSpellHasteMultiplier(state, casterIndex);
    var cast = loadCastingState(state, casterIndex);
    cast.armChannel(
        abilityCode,
        hastedDuration,
        hastedDuration / <float>ticks,
        ticks,
        drainLifeGlobalCooldownSeconds(state, casterIndex)
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    // Source channels bill at start, before their first tick is released.
    spendOfflineAbilityResource(state, casterIndex, cost);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

// Called once for each channel tick consumed by CastState. A tick validates the
// live target before launch; the deferred projectile itself may still fizzle
// later when either endpoint dies, exactly like the source pending queue.
launchOfflineDrainLifeChannelTick(state: WorldState, casterIndex: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = drainLifeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("drain_life");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    var targetIndex = drainLifeTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return false; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (rank <= 0 || effects.typeAt(abilityIndex, rank, 0) != "drainTick") {
        return false;
    }
    var resolvedRange = resolveOfflineTalentDrainTickRange(
        state,
        <uint>state.entityIds[casterIndex],
        abilityCode,
        <uint>rank,
        effects.metric(abilityIndex, rank, 0, "min"),
        effects.metric(abilityIndex, rank, 0, "max")
    );
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        <float>resolvedRange.minimum,
        <float>resolvedRange.maximum,
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_SHADOW,
        abilityCode,
        <uint>rank,
        0.0
    );
    return true;
}

mindFlayAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("mind_flay");
    var abilityIndex = m4AbilityCatalog.indexOf("mind_flay");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "mind_flay") {
        throw "Mind Flay is absent from the current ability catalog";
    }
    return code;
}

arcaneMissilesAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("arcane_missiles");
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_missiles");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "arcane_missiles") {
        throw "Aether Darts is absent from the current ability catalog";
    }
    return code;
}

mindFlayPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>9 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>100 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>121;
}

arcaneMissilesPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>15 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>13)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>14)] == <uint>115;
}

mindFlayTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("mind_flay");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

mindFlayGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

aetherDartsTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_missiles");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

startOfflineAetherDartsCast(
    state: WorldState, casterIndex: int, targetId: uint
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = arcaneMissilesAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_missiles");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var duration = m4AbilityCatalog.metric(abilityIndex, level, "channelDuration");
    var baseTicks = <int>m4AbilityCatalog.metric(abilityIndex, level, "channelTicks");
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var plan = aetherSurge.channelStart(
        "arcane_missiles", aetherSurgeAurasForEntity(state, casterIndex)
    );
    var ticks = plan.ticksOverride != 0 ? plan.ticksOverride : baseTicks;
    if (rank <= 0 || duration <= 0.0 || baseTicks <= 0 || ticks <= 0 ||
        !plan.changed || !plan.consumePending || plan.bonusPerBolt != 0 ||
        effects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        <float>state.entityResources[casterIndex] < cost ||
        aetherDartsTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var hastedDuration = duration / mageSpellHasteMultiplier(state, casterIndex);
    var cast = loadCastingState(state, casterIndex);
    cast.armChannel(
        abilityCode,
        hastedDuration,
        hastedDuration / <float>ticks,
        ticks,
        mindFlayGlobalCooldownSeconds(state, casterIndex)
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    // Source channels bill at start; charges stay armed until a missile lands.
    spendOfflineAbilityResource(state, casterIndex, cost);
    state.entityAetherDartsConsumePending[casterIndex] = plan.consumePending;
    state.entityAetherDartsBonusPerBolt[casterIndex] = plan.bonusPerBolt;
    state.entityAetherDartsTicks[casterIndex] = plan.ticksOverride;
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

launchOfflineAetherDartsChannelTick(state: WorldState, casterIndex: int): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = arcaneMissilesAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_missiles");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    var targetIndex = aetherDartsTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return false; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (rank <= 0 || effects.typeAt(abilityIndex, rank, 0) != "directDamage") {
        return false;
    }
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        effects.metric(abilityIndex, rank, 0, "min"),
        effects.metric(abilityIndex, rank, 0, "max"),
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_ARCANE,
        abilityCode,
        <uint>rank,
        0.0
    );
    return true;
}

aetherDartsProjectileProfileIsValid(
    rankCode: uint, minimum: float, maximum: float, castTime: float
): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_missiles");
    if (abilityIndex < 0 || rankCode < <uint>1 || rankCode > <uint>3 ||
        effects.typeAt(abilityIndex, <int>rankCode, 0) != "directDamage") {
        return false;
    }
    return minimum == effects.metric(abilityIndex, <int>rankCode, 0, "min") &&
        maximum == effects.metric(abilityIndex, <int>rankCode, 0, "max") && castTime == 0.0;
}

startOfflineMindFlayCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = mindFlayAbilityCode();
