    pub nextRandomU32(observe: bool): uint {
        if (!observe) {
            throw "woc authoritative rng draw must be observed";
        }
        var rng = %import("kernel/rng");
        this.rngState = (this.rngState + <uint>1831565813) & <uint>4294967295;
        var value = rng.mix(this.rngState, 1);
        this.rngDraws = this.rngDraws + <uint>1;
        this.rngDigest = rng.fold(this.rngDigest, value, 1);
        return value;
    }

    pub spawnMob(
        template: uint,
        level: int,
        x: float,
        y: float,
        z: float,
        maxHp: int,
        moveSpeed: float
    ): uint {
        if (template == <uint>0 || level < 1 || maxHp < 1 || moveSpeed <= 0.0) {
            throw "woc mob spawn parameters are invalid";
        }
        var id = this.nextEntityId;
        this.nextEntityId = this.nextEntityId + <uint>1;
        this.entityIds.add(id);
        this.entityGenerations.add(<uint>1);
        this.entityKinds.add(<uint>2);
        this.entityTemplates.add(template);
        this.entityLevels.add(level);
        this.entityX.add(x);
        this.entityY.add(y);
        this.entityZ.add(z);
        this.entityPreviousX.add(x);
        this.entityPreviousY.add(y);
        this.entityPreviousZ.add(z);
        this.entityFacing.add(0.0);
        this.entityPreviousFacing.add(0.0);
        this.entityVelocityX.add(0.0);
        this.entityVelocityY.add(0.0);
        this.entityVelocityZ.add(0.0);
        this.entityOnGround.add(true);
        this.entityJumping.add(false);
        this.entityFallStartY.add(y);
        this.entitySpawnX.add(x);
        this.entitySpawnY.add(y);
        this.entitySpawnZ.add(z);
        this.entityMoveSpeed.add(moveSpeed);
        this.entityHp.add(maxHp);
        this.entityMaxHp.add(maxHp);
        this.entityHostile.add(true);
        this.entityDead.add(false);
        this.entityOverheadEmoteCodes.add(<uint>0);
        this.entityOverheadEmoteUntil.add(<uint>0);
        this.entityOverheadEmoteSequences.add(<uint>0);
        appendDefaultDeadTargetColumns(this);
        appendDefaultCorpseQuestLootColumns(this);
        appendDefaultCorpseSharedLootColumns(this);
        appendDefaultCombatLoadoutColumns(this);
        appendDefaultWanderColumns(this);
        appendDefaultMobCombatStateColumns(this);
