appendDefaultCorpseQuestLootColumns(state: WorldState): void {
    state.entityCorpseQuestItemCodes.add(<uint>0);
    state.entityCorpseQuestItemCounts.add(<uint>0);
}

corpseQuestLootStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length ||
        state.entityCorpseQuestItemCodes.length != state.entityIds.length ||
        state.entityCorpseQuestItemCounts.length != state.entityIds.length) {
        return false;
    }
    var itemCode = <uint>state.entityCorpseQuestItemCodes[index];
    var count = <uint>state.entityCorpseQuestItemCounts[index];
    if (itemCode == <uint>0) {
        return count == <uint>0;
    }
    return count == <uint>1 && m5InventoryRules.itemCodeIsValid(itemCode);
}

corpseSharedLootSlotCount(): int { return 6; }

corpseSharedLootSlotIndex(entityIndex: int, slot: int): int {
    return entityIndex * corpseSharedLootSlotCount() + slot;
}

appendDefaultCorpseSharedLootColumns(state: WorldState): void {
    var index = state.entityIds.length - 1;
    if (index < 0 || state.entityCorpseCopper.length != index ||
        state.entityCorpseSharedItemCodes.length != index * corpseSharedLootSlotCount() ||
        state.entityCorpseSharedItemCodes.length != state.entityCorpseSharedItemCounts.length) {
        throw "woc corpse shared loot default row is invalid";
    }
    state.entityCorpseCopper.add(0);
    var slot = 0;
    while (slot < corpseSharedLootSlotCount()) {
        state.entityCorpseSharedItemCodes.add(<uint>0);
        state.entityCorpseSharedItemCounts.add(<uint>0);
        slot = slot + 1;
    }
}

corpseSharedLootStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length ||
        state.entityCorpseCopper.length != state.entityIds.length ||
        state.entityCorpseSharedItemCodes.length !=
            state.entityIds.length * corpseSharedLootSlotCount() ||
        state.entityCorpseSharedItemCodes.length != state.entityCorpseSharedItemCounts.length ||
        <int>state.entityCorpseCopper[index] < 0) {
        return false;
    }
    var slot = 0;
    while (slot < corpseSharedLootSlotCount()) {
        var sharedIndex = corpseSharedLootSlotIndex(index, slot);
        var itemCode = <uint>state.entityCorpseSharedItemCodes[sharedIndex];
        var count = <uint>state.entityCorpseSharedItemCounts[sharedIndex];
        if (itemCode == <uint>0) {
            if (count != <uint>0) { return false; }
        } else if (count != <uint>1 || !m5InventoryRules.itemCodeIsValid(itemCode)) {
            return false;
        }
        slot = slot + 1;
    }
    return true;
}

clearCorpseSharedLoot(state: WorldState, index: int): void {
    if (index < 0 || index >= state.entityIds.length ||
        !corpseSharedLootStateIsValid(state, index)) {
        throw "woc corpse shared loot row is invalid";
    }
    state.entityCorpseCopper[index] = 0;
    var slot = 0;
    while (slot < corpseSharedLootSlotCount()) {
        var sharedIndex = corpseSharedLootSlotIndex(index, slot);
        state.entityCorpseSharedItemCodes[sharedIndex] = <uint>0;
        state.entityCorpseSharedItemCounts[sharedIndex] = <uint>0;
        slot = slot + 1;
    }
}

hasOfflineCorpseLoot(state: WorldState, mobIndex: int): bool {
    if (!corpseQuestLootStateIsValid(state, mobIndex) ||
        !corpseSharedLootStateIsValid(state, mobIndex)) {
        throw "woc corpse loot row is invalid";
    }
    if (<uint>state.entityCorpseQuestItemCounts[mobIndex] != <uint>0 ||
        <int>state.entityCorpseCopper[mobIndex] > 0 ||
        hasPendingOfflineLootRollForMob(state, <uint>state.entityIds[mobIndex])) {
        return true;
    }
    var slot = 0;
    while (slot < corpseSharedLootSlotCount()) {
        if (<uint>state.entityCorpseSharedItemCounts[
                corpseSharedLootSlotIndex(mobIndex, slot)
            ] != <uint>0) {
            return true;
        }
        slot = slot + 1;
    }
    return false;
}

appendDefaultQueuedOnSwingColumns(state: WorldState): void {
    state.entityQueuedOnSwingAbilityCodes.add(<uint>0);
    state.entityQueuedOnSwingFree.add(false);
    state.entityQueuedOnSwingCostMultipliers.add(1.0);
}

queuedOnSwingM4AbilityIndex(abilityCode: uint): int {
    if (abilityCode == <uint>0 || !knownAbilityCatalog.abilityExists(<int>abilityCode)) {
        return -1;
    }
    var index = m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
    if (index < 0 || !m4AbilityCatalog.flag(index, "onNextSwing")) {
        return -1;
    }
    return index;
}

queuedOnSwingStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length) {
        return false;
    }
    var abilityCode = <uint>state.entityQueuedOnSwingAbilityCodes[index];
    var free = <bool>state.entityQueuedOnSwingFree[index];
    var multiplier = <float>state.entityQueuedOnSwingCostMultipliers[index];
    if (abilityCode == <uint>0) {
        return !free && multiplier == 1.0;
    }
    return queuedOnSwingM4AbilityIndex(abilityCode) >= 0 && multiplier > 0.0;
}

