// Verifies the source sequencing that matters for a reliable backend: ranged
// shots launch without RNG or pre-aggro, survive snapshot restore with their
// school closure, then land from the projectile prologue; dead targets fizzle
// without a draw.
pub offlineHunterAutoShotStateTest(): int {
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>4;
    var playerId = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 20, 8.0);
    state.entityTargetIds[0] = targetId;
    state.entityAutoAttack[0] = true;
    state.entityArmor[1] = 0;
    state.entityRangedPower[0] = 0;
    state.entityCritChance[0] = 0.0;
    stepOfflineHunterAutoShot(state);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileSourceIds[0] != playerId ||
        <uint>state.offlineProjectileTargetIds[0] != targetId ||
        <float>state.offlineProjectileX[0] != 0.0 ||
        <float>state.offlineProjectileZ[0] != 0.0 ||
        <float>state.offlineProjectileTtls[0] != 3.0 ||
        <bool>state.offlineProjectileWands[0] ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL ||
        <float>state.offlineProjectileMinimums[0] != 5.0 ||
        <float>state.offlineProjectileMaximums[0] != 9.0 ||
        <float>state.offlineProjectileSpeeds[0] != 2.3 ||
        <uint>state.rngDraws != <uint>0 ||
        <int>state.entityHp[1] != 20 ||
        <bool>state.entityInCombat[0] || <bool>state.entityInCombat[1]) {
        return -1;
    }
    var restored = decodeState(encodeState(state));
    if (restored.offlineProjectileSourceIds.length != 1 ||
        <uint>restored.offlineProjectileSourceIds[0] != playerId ||
        <uint>restored.offlineProjectileTargetIds[0] != targetId ||
        <float>restored.offlineProjectileTtls[0] != 3.0 ||
        <bool>restored.offlineProjectileWands[0] ||
        <uint>restored.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL) {
        return -2;
    }
    var steps = 0;
    while (steps < 8) {
        stepOfflineEastbrookProjectiles(restored);
        steps = steps + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 ||
        restored.rngDraws == <uint>0 ||
        !<bool>restored.entityInCombat[0] || !<bool>restored.entityInCombat[1]) {
        return -3;
    }

    var fizzled = new WorldState();
    fizzled.offlineSessionActive = true;
    fizzled.offlinePlayerClass = <uint>4;
    fizzled.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var fizzleTargetId = fizzled.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 20, 8.0);
    fizzled.entityTargetIds[0] = fizzleTargetId;
    fizzled.entityAutoAttack[0] = true;
    stepOfflineHunterAutoShot(fizzled);
    fizzled.entityDead[1] = true;
    stepOfflineEastbrookProjectiles(fizzled);
    if (fizzled.offlineProjectileSourceIds.length != 0 ||
        fizzled.rngDraws != <uint>0) {
        return -4;
    }

    var wand = new WorldState();
    wand.offlineSessionActive = true;
    wand.offlinePlayerClass = <uint>1;
    var wandPlayerId = wand.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var wandTargetId = wand.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 20, 8.0);
    wand.entityTargetIds[0] = wandTargetId;
    wand.entityAutoAttack[0] = true;
    wand.entityArmor[1] = 500;
    wand.entityRangedPower[0] = 0;
    wand.entityCritChance[0] = 0.0;
    stepOfflineCasterWandAutoAttack(wand);
    if (wandPlayerId == <uint>0 || wandTargetId == <uint>0 ||
        wand.offlineProjectileSourceIds.length != 1 ||
        !<bool>wand.offlineProjectileWands[0] ||
        <uint>wand.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
        <float>wand.offlineProjectileMinimums[0] != 3.0 ||
        <float>wand.offlineProjectileMaximums[0] != 6.0 ||
        <float>wand.offlineProjectileSpeeds[0] != 1.8 ||
        wand.rngDraws != <uint>0 || <int>wand.entityHp[1] != 20 ||
        <bool>wand.entityInCombat[0] || <bool>wand.entityInCombat[1]) {
        return -5;
    }
    var wandRestored = decodeState(encodeState(wand));
    if (wandRestored.offlineProjectileSourceIds.length != 1 ||
        !<bool>wandRestored.offlineProjectileWands[0] ||
        <uint>wandRestored.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_ARCANE) {
        return -6;
    }
    steps = 0;
    while (steps < 8) {
        stepOfflineEastbrookProjectiles(wandRestored);
        steps = steps + 1;
    }
    if (wandRestored.offlineProjectileSourceIds.length != 0 ||
        wandRestored.rngDraws == <uint>0 ||
        !<bool>wandRestored.entityInCombat[0] || !<bool>wandRestored.entityInCombat[1]) {
        return -7;
    }

    var profiles = new WorldState();
    profiles.offlineSessionActive = true;
    profiles.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    profiles.offlinePlayerClass = <uint>5;
    if (offlineWandSchoolForPlayer(profiles, 0) != "holy") { return -8; }
    profiles.offlinePlayerClass = <uint>7;
    if (offlineWandSchoolForPlayer(profiles, 0) != "shadow") { return -9; }
    profiles.offlinePlayerClass = <uint>8;
    profiles.entityActiveFormAbilityCodes[0] = forms.formAbilityCode("form_bear");
    if (offlineCasterWandProfileEnabled(profiles, 0) ||
        !offlineDirectMeleeAutoProfileEnabled(profiles, 0)) {
        return -10;
    }
    profiles.entityActiveFormAbilityCodes[0] = forms.formAbilityCode("form_cat");
    if (offlineCasterWandProfileEnabled(profiles, 0) ||
        !offlineDirectMeleeAutoProfileEnabled(profiles, 0)) {
        return -11;
    }
    profiles.entityActiveFormAbilityCodes[0] = forms.formAbilityCode("form_travel");
    if (offlineCasterWandProfileEnabled(profiles, 0) ||
        offlineDirectMeleeAutoProfileEnabled(profiles, 0)) {
        return -12;
    }
    profiles.entityAutoAttack[0] = true;
    profiles.entitySwingTimer[0] = 1.0;
    profiles.entityOffhandSwingTimer[0] = 0.5;
    stepOfflineTravelFormAutoAttack(profiles);
    if (<bool>profiles.entityAutoAttack[0] ||
        <float>profiles.entitySwingTimer[0] != 0.95 ||
        <float>profiles.entityOffhandSwingTimer[0] != 0.45) {
        return -13;
    }
    profiles.offlinePlayerClass = <uint>1;
    profiles.entityActiveFormAbilityCodes[0] = forms.formAbilityCode("form_fireball");
    profiles.entityAutoAttack[0] = true;
    stepOfflineTravelFormAutoAttack(profiles);
    if (<bool>profiles.entityAutoAttack[0]) { return -14; }
    profiles.offlinePlayerClass = <uint>8;
    profiles.entityActiveFormAbilityCodes[0] = forms.formAbilityCode("form_moonkin");
    if (offlineWandSchoolForPlayer(profiles, 0) != "nature" ||
        offlineDirectMeleeAutoProfileEnabled(profiles, 0)) {
        return -15;
    }
    return 1;
}

