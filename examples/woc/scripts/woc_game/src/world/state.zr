    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <int>state.entityResources[0] != 25 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != frostbolt ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        !floatMatches(<float>state.entityCastRemaining[0], 1.0) ||
        !floatMatches(<float>state.entityCastTotal[0], 1.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.0)) {
        return -3;
    }

    state.entityCastRemaining[0] = 0.05;
    stepRetainedCasting(state, 0, false);
    if (<int>state.entityResources[0] != 0 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != <uint>0 ||
        <uint>state.entityCastTargetIds[0] != <uint>0 ||
        <int>state.entityHp[1] != 100 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileSourceIds[0] != playerId ||
        <uint>state.offlineProjectileTargetIds[0] != targetId ||
        <bool>state.offlineProjectileWands[0] ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_FROST ||
        <float>state.offlineProjectileMinimums[0] != 18.0 ||
        <float>state.offlineProjectileMaximums[0] != 20.0 ||
        <float>state.offlineProjectileSpeeds[0] != projectileTravel.projectileSpeed() ||
        <uint>state.offlineProjectileAbilityCodes[0] != frostbolt ||
        <uint>state.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>state.offlineProjectileCastTimes[0], 1.5) ||
        <uint>state.entityMotionAuraOffsets[2] != <uint>0) {
        return -4;
    }

    var restored = decodeState(encodeState(state));
    if (<int>restored.entityHp[1] != 100 || <uint>restored.rngDraws != <uint>0 ||
        restored.offlineProjectileSourceIds.length != 1 ||
        <uint>restored.offlineProjectileAbilityCodes[0] != frostbolt ||
        <uint>restored.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>restored.offlineProjectileCastTimes[0], 1.5)) {
        return -5;
    }

    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>3 || <int>restored.entityHp[1] >= 100 ||
        <uint>restored.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>restored.entityMotionAuraAbilityCodes[0] != frostbolt ||
        <uint>restored.entityMotionAuraSourceIds[0] != playerId ||
        <uint>restored.entityMotionAuraKindCodes[0] !=
            ccContract.motionAuraKindCode("slow") ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 5.0) ||
        stateThreatValue(restored, 1, playerId) <= 0.0) {
        return -6;
    }

    restored.entityAiStates[1] = mobLifecycle.chaseAiState();
    restored.entityAggroTargetIds[1] = playerId;
    restored.entityInCombat[1] = true;
    var zBeforeSlowPursuit = <float>restored.entityZ[1];
    stepOfflineEastbrookMobMeleePursuit(restored);
    if (!floatMatches(<float>restored.entityZ[1], zBeforeSlowPursuit - 0.24) ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 4.95)) {
        return -7;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 25;
    var frostboltBytes = new container.Array<uint>();
    frostboltBytes.add(<uint>102);
    frostboltBytes.add(<uint>114);
    frostboltBytes.add(<uint>111);
    frostboltBytes.add(<uint>115);
    frostboltBytes.add(<uint>116);
    frostboltBytes.add(<uint>98);
    frostboltBytes.add(<uint>111);
    frostboltBytes.add(<uint>108);
    frostboltBytes.add(<uint>116);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, frostboltBytes, targetId
    );
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 25 &&
        <uint>restored.entityCastingAbility[0] == frostbolt &&
        <uint>restored.entityCastTargetIds[0] == targetId &&
        floatMatches(<float>restored.entityCastRemaining[0], 1.0) &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -8;
}

// Smite has no persistent aura row: its pending WOS56 projectile must survive
// a WOS65 round trip and then spend resist, range and critical draws on impact.
pub smiteCommandStateTest(): int {
    if (timedSpell.contractTest() != 1 || spellResist.contractTest() != 1) { return -1; }
    var m4AbilityEffects = %import("generated/m4_ability_effects");
