        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, abilityCode) != <uint>20000000 ||
        <uint>state.rngDraws != <uint>2 || <int>state.entityHp[1] > 66 ||
        <int>state.entityHp[2] > 66 || <int>state.entityHp[3] != 100 ||
        !<bool>state.entityInCombat[0] || !<bool>state.entityInCombat[1] ||
        !<bool>state.entityInCombat[2] || stateThreatValue(state, 1, playerId) <= 0.0 ||
        stateThreatValue(state, 2, playerId) <= 0.0 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -2;
    }
    var restored = decodeState(encodeState(state));
    if (<uint>restored.rngDraws != <uint>2 || <int>restored.entityHp[1] > 66 ||
        <int>restored.entityHp[2] > 66 || <int>restored.entityHp[3] != 100 ||
        abilityCooldownExpiresAt(restored, 0, abilityCode) != <uint>20000000) {
        return -3;
    }

    var whiff = new WorldState();
    whiff.offlineSessionActive = true;
    whiff.offlinePlayerClass = <uint>1;
    whiff.spawnPlayer(<uint>2, 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    whiff.entityResources[0] = 60;
    whiff.entityMaxResources[0] = 60;
    whiff.entityKnownAbilityCodes.add(abilityCode);
    whiff.entityKnownAbilityOffsets[1] = <uint>1;
    startOfflineConeOfColdCast(whiff, 0);
    return <int>whiff.entityResources[0] == 0 &&
        <uint>whiff.rngDraws == <uint>0 &&
        abilityCooldownExpiresAt(whiff, 0, abilityCode) == <uint>20000000 &&
        !<bool>whiff.entityInCombat[0] ? 1 : -4;
}

