// Conflagrate spends its instant cast before projectile impact. The positive
// path consumes only the caster's Immolate row; missing or foreign rows stop
// after the one source resistance draw and keep the aura untouched.
pub conflagrateCommandStateTest(): int {
    if (timedSpell.contractTest() != 1 || spellResist.contractTest() != 1) { return -1; }
    var effects = %import("generated/m4_ability_effects");
    var conflagrate = conflagrateAbilityCode();
    var immolate = immolateAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("conflagrate");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (conflagrate == <uint>0 || immolate == <uint>0 || abilityIndex != 50 ||
        forestWolf == <uint>0 || !conflagrateProfileIsValid(abilityIndex, 20) ||
        effects.consumeAuraIdAt(abilityIndex, 1, 0, 0) != "immolate" ||
        !conflagrateProjectileProfileIsValid(<uint>1, 54.0, 64.0, 0.0)) {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>7, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 1000, 8.0);
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 200;
    state.entityMaxResources[0] = 200;
    state.entitySpellPower[0] = 100;
    state.entityCritChance[0] = 0.0;
    state.entityHitBonus[0] = 1.0;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(conflagrate);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }
    applyOfflineImmolateDot(
        state, targetId, playerId, immolate, <uint>3, 0, 60, -1, 12, 15.0, 3.0
    );

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <float>state.entityResources[0] != 145 || <uint>state.rngDraws != <uint>0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, conflagrate) != state.timeMicros + <uint>6000000 ||
        state.offlineProjectileSourceIds.length != 1 || state.offlineDotTargetIds.length != 1 ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
        <float>state.offlineProjectileMinimums[0] != 54.0 ||
        <float>state.offlineProjectileMaximums[0] != 64.0 ||
        <uint>state.offlineProjectileAbilityCodes[0] != conflagrate ||
        <uint>state.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>state.offlineProjectileCastTimes[0], 0.0)) {
        return -3;
    }

    var restored = decodeState(encodeState(state));
    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>3 || restored.offlineDotTargetIds.length != 0 ||
        <int>restored.entityHp[1] >= 1000 || !<bool>restored.entityInCombat[0] ||
        !<bool>restored.entityInCombat[1] || stateThreatValue(restored, 1, playerId) <= 0.0) {
        return -4;
    }

    var conflagrateBytes = new container.Array<uint>();
    conflagrateBytes.add(<uint>99); conflagrateBytes.add(<uint>111);
    conflagrateBytes.add(<uint>110); conflagrateBytes.add(<uint>102);
    conflagrateBytes.add(<uint>108); conflagrateBytes.add(<uint>97);
    conflagrateBytes.add(<uint>103); conflagrateBytes.add(<uint>114);
    conflagrateBytes.add(<uint>97); conflagrateBytes.add(<uint>116);
    conflagrateBytes.add(<uint>101);
    var hpBeforeMissingAura = <int>restored.entityHp[1];
    var threatBeforeMissingAura = stateThreatValue(restored, 1, playerId);
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 55;
    restored.timeMicros = abilityCooldownExpiresAt(restored, 0, conflagrate);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, conflagrateBytes, targetId
    );
    restored.applyCommands(typed, 1);
    if (<int>restored.entityResources[0] != 0 ||
        restored.offlineProjectileSourceIds.length != 1 ||
        <uint>restored.entityLastCommandSequence[0] != <uint>2) {
        return -5;
    }
    flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>4 || <int>restored.entityHp[1] != hpBeforeMissingAura ||
        stateThreatValue(restored, 1, playerId) != threatBeforeMissingAura ||
        restored.offlineDotTargetIds.length != 0) {
        return -6;
    }

    applyOfflineImmolateDot(
        restored, targetId, <uint>777, immolate, <uint>3, 0, 60, -1, 12, 15.0, 3.0
    );
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 55;
    restored.timeMicros = abilityCooldownExpiresAt(restored, 0, conflagrate);
    var foreign = new CommandBatch();
    appendCastSlotCommand(foreign, playerId, <uint>1, <uint>3, <uint>0);
    restored.applyCommands(foreign, 1);
    flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    return <int>restored.entityResources[0] == 0 &&
        restored.offlineProjectileSourceIds.length == 0 && flightTicks <= 8 &&
        <uint>restored.rngDraws == <uint>5 &&
        <int>restored.entityHp[1] == hpBeforeMissingAura &&
        restored.offlineDotTargetIds.length == 1 &&
        <uint>restored.offlineDotSourceIds[0] == <uint>777 &&
        <uint>restored.offlineDotAbilityCodes[0] == immolate &&
        <uint>restored.entityLastCommandSequence[0] == <uint>3 ? 1 : -7;
}

