// These effects are source spell projectiles even though their cast time is
// zero. A successful impact snapshots the selected scaling power and applies
// only the periodic aura; resistance is the sole impact-time random event.
landOfflinePureDotProjectile(
    state: WorldState,
    projectileIndex: int,
    casterIndex: int,
    targetIndex: int,
    expectedAbilityCode: uint
): void {
    var abilityCode = <uint>state.offlineProjectileAbilityCodes[projectileIndex];
    var rank = <uint>state.offlineProjectileRanks[projectileIndex];
    var abilityIndex = pureDotAbilityIndex(abilityCode);
    if (abilityCode != expectedAbilityCode || abilityIndex < 0 ||
        !pureDotProjectileProfileIsValid(
            abilityCode,
            rank,
            <float>state.offlineProjectileMinimums[projectileIndex],
            <float>state.offlineProjectileMaximums[projectileIndex],
            <float>state.offlineProjectileCastTimes[projectileIndex]
        )) {
        return;
    }

    var resist = new spellResist.SpellResistState();
    resist.casterLevel = <int>state.entityLevels[casterIndex];
    resist.targetLevel = <int>state.entityLevels[targetIndex];
    resist.hitRating = <float>state.entityHitBonus[casterIndex] * 1000.0;
    resist.randomUnits.add(nextAuthoritativeRandomUnit(state));
    if (!spellResist.resolve(resist)) {
        enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
        return;
    }

    var profile = numericEffects.resolvePureDotProfile(
        abilityIndex,
        <int>rank,
        <int>state.entitySpellPower[casterIndex],
        <int>state.entityRangedPower[casterIndex],
        <int>effectiveOfflineAttackPower(state, casterIndex)
    );
    var resolvedTotal = offlineTalentDotProjectileResolvedTotal(state, projectileIndex);
    if (!profile.valid || resolvedTotal <= 0) { return; }
    profile = numericEffects.dotProfileFromResolvedTotal(
        abilityIndex, <int>rank, 0, profile.snapshotPower, resolvedTotal
    );
    if (!profile.valid) { return; }
    enterOfflineSpellProjectileCombat(state, casterIndex, targetIndex);
    appendOfflinePureDot(
        state,
        <uint>state.entityIds[targetIndex],
        <uint>state.entityIds[casterIndex],
        abilityCode,
        rank,
        profile.snapshotPower,
        resolvedTotal,
        projectileIndex,
        profile.damage,
        profile.duration,
        profile.interval
    );
}

