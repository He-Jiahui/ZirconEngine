    autoAttackState.initializeAuthoritativeRng(
        rangedEvents, state.rngState, state.rngDraws, state.rngDigest, true
    );
    autoAttackState.fixedTick(rangedActor, target, rangedEvents);
    if (rangedEvents.projectileEvents != 1 ||
        !floatMatches(rangedActor.swingTimer, 2.0 / 1.4)) { return -4; }

    applyOfflineMotionAuraWithDetails(
        state, 0, bladeFlurry, playerId, ccContract.motionAuraKindCode("buff_haste"),
        12.0, 1.2, 0.0
    );
    var combinedActor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(state, 0, 0, combinedActor);
    if (state.entityMotionAuraAbilityCodes.length != 2 ||
        !bladeFlurryMotionStateIsValid(state) ||
        !floatMatches(combinedActor.swingIntervalMultiplier, 1.0 / (1.4 * 1.2))) {
        return -5;
    }
    var restored = decodeState(encodeState(state));
    var restoredActor = new autoAttackState.AutoActor();
    prepareOfflineAutoActor(restored, 0, 0, restoredActor);
    if (!floatMatches(restoredActor.swingIntervalMultiplier, 1.0 / (1.4 * 1.2))) {
        return -6;
    }
    restored.entityMotionAuraRemaining[0] = 0.05;
    ageMotionAurasForEntity(restored, 0);
    prepareOfflineAutoActor(restored, 0, 0, restoredActor);
    if (restored.entityMotionAuraAbilityCodes.length != 1 ||
        <uint>restored.entityMotionAuraAbilityCodes[0] != bladeFlurry ||
        !floatMatches(restoredActor.swingIntervalMultiplier, 1.0 / 1.2)) { return -7; }
    restored.entityMotionAuraRemaining[0] = 0.05;
    ageMotionAurasForEntity(restored, 0);
    prepareOfflineAutoActor(restored, 0, 0, restoredActor);
    if (restored.entityMotionAuraAbilityCodes.length != 0 ||
        !floatMatches(restoredActor.swingIntervalMultiplier, 1.0)) { return -8; }

    restored.timeMicros = <uint>300000000;
    var bytes = new container.Array<uint>();
    bytes.add(<uint>114); bytes.add(<uint>97); bytes.add(<uint>112); bytes.add(<uint>105);
    bytes.add(<uint>100); bytes.add(<uint>95); bytes.add(<uint>102); bytes.add(<uint>105);
    bytes.add(<uint>114); bytes.add(<uint>101);
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(typed, playerId, <uint>1, <uint>2, bytes);
    restored.applyCommands(typed, 1);
    if (abilityCooldownExpiresAt(restored, 0, rapidFire) != <uint>600000000 ||
        restored.entityMotionAuraAbilityCodes.length != 1 ||
        <uint>restored.entityMotionAuraAbilityCodes[0] != rapidFire ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 15.0) ||
        <uint>restored.entityLastCommandSequence[0] != <uint>2) { return -9; }
    restored.entityMotionAuraRemaining[0] = 1.0;
    applyOfflineMotionAuraWithDetails(
        restored, 0, rapidFire, playerId, ccContract.motionAuraKindCode("buff_haste"),
        15.0, 1.4, 0.0
    );
    startOfflineRapidFireCast(restored, 0);
    if (restored.entityMotionAuraAbilityCodes.length != 1 ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 15.0) ||
        abilityCooldownExpiresAt(restored, 0, rapidFire) != <uint>600000000) { return -10; }

    var lowLevel = new WorldState();
    lowLevel.offlineSessionActive = true;
    lowLevel.offlinePlayerClass = <uint>hunter;
    var lowLevelId = lowLevel.spawnPlayer(
        <uint>(hunter + 1), 19, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    lowLevel.entityKnownAbilityCodes.add(rapidFire);
    offset = 1;
    while (offset < lowLevel.entityKnownAbilityOffsets.length) {
        lowLevel.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    startOfflineRapidFireCast(lowLevel, 0);
    var wrongClass = decodeState(encodeState(lowLevel));
    wrongClass.entityLevels[0] = 20;
    wrongClass.offlinePlayerClass = <uint>rogue;
    wrongClass.entityTemplates[0] = <uint>(rogue + 1);
    startOfflineRapidFireCast(wrongClass, 0);
    return lowLevelId != <uint>0 && lowLevel.entityMotionAuraAbilityCodes.length == 0 &&
        wrongClass.entityMotionAuraAbilityCodes.length == 0 &&
        abilityCooldownExpiresAt(lowLevel, 0, rapidFire) == <uint>0 &&
        abilityCooldownExpiresAt(wrongClass, 0, rapidFire) == <uint>0 &&
        restored.rngDraws == <uint>0 ? 1 : -11;
}

pub arcaneShotRuntimeStateTest(): int {
    var arcaneShot = arcaneShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("arcane_shot");
    var hunter = knownAbilityCatalog.classIndex("hunter");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (arcaneShot == <uint>0 || abilityIndex != 109 || hunter < 0 ||
        forestWolf == <uint>0 || !arcaneShotProfileIsValid(abilityIndex, 5)) {
        return -1;
    }
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>hunter;
    var playerId = state.spawnPlayer(<uint>(hunter + 1), 5, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 5, 0.0, 1.5, 10.0, 1000, 7.0);
    state.entityResources[0] = 50.0;
    state.entityRangedPower[0] = 100;
    state.entityHitBonus[0] = 1.0;
    state.entityKnownAbilityCodes.add(arcaneShot);
    var offset = 1;
    while (offset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    state.entityTargetIds[0] = targetId;
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || !floatMatches(<float>state.entityResources[0], 25.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, arcaneShot) != <uint>6000000 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileAbilityCodes[0] != arcaneShot ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_ARCANE ||
        !offlineProjectileStateIsValid(state) || state.rngDraws != <uint>0) { return -2; }
    var restored = decodeState(encodeState(state));
    var hpBefore = <int>restored.entityHp[1];
    landOfflineArcaneShotProjectile(restored, 0, 0, 1);
    if (<int>restored.entityHp[1] >= hpBefore || restored.rngDraws != <uint>3) {
        return -3;
    }
    var rejected = new WorldState();
    rejected.offlineSessionActive = true;
    rejected.offlinePlayerClass = <uint>hunter;
    var rejectedPlayer = rejected.spawnPlayer(
        <uint>(hunter + 1), 5, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    var rejectedTarget = rejected.spawnMob(forestWolf, 5, 0.0, 1.5, 7.0, 100, 7.0);
    rejected.entityResources[0] = 50.0;
    rejected.entityKnownAbilityCodes.add(arcaneShot);
    offset = 1;
    while (offset < rejected.entityKnownAbilityOffsets.length) {
        rejected.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    startOfflineArcaneShotCast(rejected, 0, rejectedTarget);
    rejected.entityZ[1] = 36.0;
    startOfflineArcaneShotCast(rejected, 0, rejectedTarget);
    rejected.entityZ[1] = 10.0;
    rejected.entityFacing[0] = 3.14159265;
    startOfflineArcaneShotCast(rejected, 0, rejectedTarget);
    if (rejectedPlayer == <uint>0 || rejected.entityMotionAuraAbilityCodes.length != 0 ||
        rejected.offlineProjectileSourceIds.length != 0 ||
        abilityCooldownExpiresAt(rejected, 0, arcaneShot) != <uint>0 ||
        !floatMatches(<float>rejected.entityResources[0], 50.0)) { return -4; }

    // Rank selection and its cast-time debit are retained in the projectile,
    // so every source endpoint remains reconstructable after a snapshot.
    var rankTwo = new WorldState();
    rankTwo.offlineSessionActive = true;
    rankTwo.offlinePlayerClass = <uint>hunter;
    var rankTwoPlayer = rankTwo.spawnPlayer(
        <uint>(hunter + 1), 12, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    var rankTwoTarget = rankTwo.spawnMob(forestWolf, 12, 0.0, 1.5, 10.0, 1000, 7.0);
    rankTwo.entityResources[0] = 100.0;
    rankTwo.entityKnownAbilityCodes.add(arcaneShot);
    offset = 1;
    while (offset < rankTwo.entityKnownAbilityOffsets.length) {
        rankTwo.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    startOfflineArcaneShotCast(rankTwo, 0, rankTwoTarget);
    if (rankTwoPlayer == <uint>0 || !floatMatches(<float>rankTwo.entityResources[0], 60.0) ||
        <uint>rankTwo.offlineProjectileRanks[0] != <uint>2 ||
        !floatMatches(<float>rankTwo.offlineProjectileMinimums[0], 24.0) ||
        !floatMatches(<float>rankTwo.offlineProjectileMaximums[0], 30.0) ||
        !offlineProjectileStateIsValid(decodeState(encodeState(rankTwo)))) { return -5; }

    var rankThree = new WorldState();
    rankThree.offlineSessionActive = true;
    rankThree.offlinePlayerClass = <uint>hunter;
    var rankThreePlayer = rankThree.spawnPlayer(
        <uint>(hunter + 1), 18, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    var rankThreeTarget = rankThree.spawnMob(forestWolf, 18, 0.0, 1.5, 10.0, 1000, 7.0);
    rankThree.entityResources[0] = 100.0;
    rankThree.entityKnownAbilityCodes.add(arcaneShot);
    offset = 1;
    while (offset < rankThree.entityKnownAbilityOffsets.length) {
        rankThree.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    startOfflineArcaneShotCast(rankThree, 0, rankThreeTarget);
    if (rankThreePlayer == <uint>0 || !floatMatches(<float>rankThree.entityResources[0], 45.0) ||
        <uint>rankThree.offlineProjectileRanks[0] != <uint>3 ||
        !floatMatches(<float>rankThree.offlineProjectileMinimums[0], 38.0) ||
        !floatMatches(<float>rankThree.offlineProjectileMaximums[0], 47.0)) { return -6; }

    // A resist consumes only its spell-resist sample. A landed shot consumes
    // that sample first, then its direct interval and spell-crit samples.
    var resisted = decodeState(encodeState(state));
    resisted.entityHitBonus[0] = -100.0;
    var resistedHp = <int>resisted.entityHp[1];
    landOfflineArcaneShotProjectile(resisted, 0, 0, 1);
    if (<int>resisted.entityHp[1] != resistedHp || resisted.rngDraws != <uint>1) {
        return -7;
    }

    // All nonphysical hit fields are read when the projectile lands. Identical
    // RNG streams make the live-RAP, spell-crit, and armor exclusion checks
    // deterministic without asserting implementation-specific random values.
    var lowRap = decodeState(encodeState(state));
    var highRap = decodeState(encodeState(state));
    var armoredRap = decodeState(encodeState(state));
    lowRap.entityRangedPower[0] = 0;
    highRap.entityRangedPower[0] = 500;
    armoredRap.entityRangedPower[0] = 500;
    armoredRap.entityArmor[1] = 100000;
    var lowHp = <int>lowRap.entityHp[1];
    var highHp = <int>highRap.entityHp[1];
    var armoredHp = <int>armoredRap.entityHp[1];
    landOfflineArcaneShotProjectile(lowRap, 0, 0, 1);
    landOfflineArcaneShotProjectile(highRap, 0, 0, 1);
    landOfflineArcaneShotProjectile(armoredRap, 0, 0, 1);
    var lowDamage = lowHp - <int>lowRap.entityHp[1];
    var highDamage = highHp - <int>highRap.entityHp[1];
    if (highDamage <= lowDamage || armoredHp - <int>armoredRap.entityHp[1] != highDamage ||
        lowRap.rngDraws != <uint>3 || highRap.rngDraws != <uint>3 ||
        armoredRap.rngDraws != <uint>3) { return -8; }
    // Rewind to an unlanded projectile with the same live RAP and force the
    // spell critical branch; Arcane Shot must not use attack critical state.
    var critical = decodeState(encodeState(state));
    critical.entityRangedPower[0] = 500;
    critical.entityCritChance[0] = 1.0;
    var criticalHp = <int>critical.entityHp[1];
    landOfflineArcaneShotProjectile(critical, 0, 0, 1);
    if (criticalHp - <int>critical.entityHp[1] <= highDamage ||
        critical.rngDraws != <uint>3) { return -9; }

    // The generic projectile queue performs its validity check before the
    // landing reducer, so despawn/death fizzles neither roll nor deal damage.
    var targetFizzle = decodeState(encodeState(state));
    targetFizzle.entityDead[1] = true;
    stepOfflineEastbrookProjectiles(targetFizzle);
    var sourceFizzle = decodeState(encodeState(state));
    sourceFizzle.entityDead[0] = true;
    stepOfflineEastbrookProjectiles(sourceFizzle);
    if (targetFizzle.offlineProjectileSourceIds.length != 0 ||
        sourceFizzle.offlineProjectileSourceIds.length != 0 ||
        targetFizzle.rngDraws != <uint>0 || sourceFizzle.rngDraws != <uint>0) {
        return -10;
    }

    var typed = new WorldState();
    typed.offlineSessionActive = true;
    typed.offlinePlayerClass = <uint>hunter;
    var typedPlayer = typed.spawnPlayer(<uint>(hunter + 1), 5, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var typedTarget = typed.spawnMob(forestWolf, 5, 0.0, 1.5, 10.0, 1000, 7.0);
    typed.entityResources[0] = 50.0;
    typed.entityKnownAbilityCodes.add(arcaneShot);
    offset = 1;
    while (offset < typed.entityKnownAbilityOffsets.length) {
        typed.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    var arcaneBytes = new container.Array<uint>();
    arcaneBytes.add(<uint>97); arcaneBytes.add(<uint>114); arcaneBytes.add(<uint>99);
    arcaneBytes.add(<uint>97); arcaneBytes.add(<uint>110); arcaneBytes.add(<uint>101);
    arcaneBytes.add(<uint>95); arcaneBytes.add(<uint>115); arcaneBytes.add(<uint>104);
    arcaneBytes.add(<uint>111); arcaneBytes.add(<uint>116);
    var typedCommand = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typedCommand, typedPlayer, <uint>1, <uint>1, arcaneBytes, typedTarget
    );
    typed.applyCommands(typedCommand, 1);
    return typedPlayer != <uint>0 && typed.offlineProjectileSourceIds.length == 1 &&
        <uint>typed.offlineProjectileAbilityCodes[0] == arcaneShot &&
        !floatMatches(<float>typed.entityResources[0], 50.0) &&
        !floatMatches(<float>typed.entityCastGcdRemaining[0], 0.0) &&
        abilityCooldownExpiresAt(typed, 0, arcaneShot) == <uint>6000000 &&
        <uint>typed.entityLastCommandSequence[0] == <uint>1 ? 1 : -11;
}

pub arcaneShotChoiceRuntimeStateTest(): int {
    var arcaneShot = arcaneShotAbilityCode();
    var hunter = knownAbilityCatalog.classIndex("hunter");
    var beastMastery = talentSelectionCatalog.specCode("hunter", "beast_mastery");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (arcaneShot == <uint>0 || hunter < 0 || beastMastery == <uint>0 ||
        forestWolf == <uint>0 || abilityCharges.contractTest() != 1) { return -1; }

    // Quick Shots spends two independent uses. After the first 1.5 seconds,
    // the second spend must retain both the 4.5 and 6.0 second timers while
    // exposing only the earliest through the ordinary cooldown table.
    var charged = new WorldState();
    charged.offlineSessionActive = true;
    charged.offlinePlayerClass = <uint>hunter;
    var chargedPlayer = charged.spawnPlayer(
        <uint>(hunter + 1), 14, 0.0, 1.5, 0.0, 500, 7.0, 1
    );
    var chargedTarget = charged.spawnMob(forestWolf, 14, 0.0, 1.5, 10.0, 10000, 7.0);
    charged.entityResources[0] = 500.0;
    charged.entityMaxResources[0] = 500.0;
    charged.entityHitBonus[0] = 100.0;
    if (!replaceOfflineTalentAllocation(
            charged, 0, beastMastery, <uint>38, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(charged, 0, arcaneShot)) { return -2; }
    startOfflineArcaneShotCast(charged, 0, chargedTarget);
    if (chargedPlayer == <uint>0 || !floatMatches(<float>charged.entityResources[0], 460.0) ||
        charged.offlineAbilityChargeEntityIds.length != 1 ||
        <int>charged.offlineAbilityChargeCounts[0] != 1 ||
        <int>charged.offlineAbilityChargeMaximums[0] != 2 ||
        abilityCooldownExpiresAt(charged, 0, arcaneShot) != <uint>0) { return -3; }
    var elapsed = 0;
    while (elapsed < 30) {
        advanceState(charged, charged.tick + <uint>1, charged.generation, 1);
        stepOfflineAbilityCharges(charged);
        elapsed = elapsed + 1;
    }
    charged.entityCastGcdRemaining[0] = 0.0;
    startOfflineArcaneShotCast(charged, 0, chargedTarget);
    if (!floatMatches(<float>charged.entityResources[0], 420.0) ||
        charged.offlineProjectileSourceIds.length != 2 ||
        <int>charged.offlineAbilityChargeCounts[0] != 0 ||
        <uint>charged.offlineAbilityChargeRechargeOffsets[1] != <uint>2 ||
        !floatMatches(<float>charged.offlineAbilityChargeRechargeRemaining[0], 4.5) ||
        !floatMatches(<float>charged.offlineAbilityChargeRechargeRemaining[1], 6.0) ||
        abilityCooldownExpiresAt(charged, 0, arcaneShot) != <uint>6000000) { return -4; }
    charged.entityCastGcdRemaining[0] = 0.0;
    startOfflineArcaneShotCast(charged, 0, chargedTarget);
    if (charged.offlineProjectileSourceIds.length != 2 ||
        !floatMatches(<float>charged.entityResources[0], 420.0)) { return -5; }
    var chargedRestored = decodeState(encodeState(charged));
    if (!offlineAbilityChargeStateIsValid(chargedRestored) ||
        chargedRestored.offlineAbilityChargeRechargeRemaining.length != 2 ||
        abilityCooldownExpiresAt(chargedRestored, 0, arcaneShot) != <uint>6000000) { return -6; }
    var collapsed = decodeState(encodeState(charged));
    if (!replaceOfflineTalentAllocation(
            collapsed, 0, beastMastery, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || collapsed.offlineAbilityChargeEntityIds.length != 0 ||
        abilityCooldownExpiresAt(collapsed, 0, arcaneShot) != <uint>6000000) {
        return -7;
    }
    advanceState(collapsed, collapsed.tick + <uint>1, collapsed.generation, 1);
    stepOfflineAbilityCharges(collapsed);
    if (abilityCooldownExpiresAt(collapsed, 0, arcaneShot) <= collapsed.timeMicros) {
        return -8;
    }
    elapsed = 0;
    while (elapsed < 91) {
        advanceState(chargedRestored, chargedRestored.tick + <uint>1,
            chargedRestored.generation, 1);
        stepOfflineAbilityCharges(chargedRestored);
        elapsed = elapsed + 1;
    }
    if (<int>chargedRestored.offlineAbilityChargeCounts[0] != 1 ||
        chargedRestored.offlineAbilityChargeRechargeRemaining.length != 1 ||
        abilityCooldownExpiresAt(chargedRestored, 0, arcaneShot) != <uint>0) { return -9; }
    elapsed = 0;
    while (elapsed < 30) {
        advanceState(chargedRestored, chargedRestored.tick + <uint>1,
            chargedRestored.generation, 1);
        stepOfflineAbilityCharges(chargedRestored);
        elapsed = elapsed + 1;
    }
    if (<int>chargedRestored.offlineAbilityChargeCounts[0] != 2 ||
        chargedRestored.offlineAbilityChargeRechargeRemaining.length != 0) { return -10; }
    if (!replaceOfflineTalentAllocation(
            chargedRestored, 0, beastMastery, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) { return -11; }
    chargedRestored.entityCastGcdRemaining[0] = 0.0;
    startOfflineArcaneShotCast(chargedRestored, 0, chargedTarget);
    if (chargedRestored.offlineProjectileSourceIds.length != 3 ||
        abilityCooldownExpiresAt(chargedRestored, 0, arcaneShot) <=
            chargedRestored.timeMicros) { return -12; }

    // Serpents Venom resolves from the projectile's allocation snapshot. Its
    // total follows the critical direct result, never appears on resist/fizzle,
    // and persists as three one-second Nature-equivalent periodic ticks.
    var venom = new WorldState();
    venom.offlineSessionActive = true;
    venom.offlinePlayerClass = <uint>hunter;
    var venomPlayer = venom.spawnPlayer(
        <uint>(hunter + 1), 14, 0.0, 1.5, 0.0, 500, 7.0, 1
    );
    var venomTarget = venom.spawnMob(forestWolf, 14, 0.0, 1.5, 10.0, 10000, 7.0);
    venom.entityResources[0] = 500.0;
    venom.entityMaxResources[0] = 500.0;
    venom.entityHitBonus[0] = 100.0;
    venom.entityRangedPower[0] = 0;
    venom.entityCritChance[0] = 0.0;
    if (!replaceOfflineTalentAllocation(
            venom, 0, beastMastery, <uint>38, <uint>0, <uint>0,
            <uint>48, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(venom, 0, arcaneShot)) { return -13; }
    startOfflineArcaneShotCast(venom, 0, venomTarget);
    var snapshotted = decodeState(encodeState(venom));
    if (!replaceOfflineTalentAllocation(
            snapshotted, 0, beastMastery, <uint>38, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) { return -14; }
    landOfflineArcaneShotProjectile(snapshotted, 0, 0, 1);
    if (venomPlayer == <uint>0 || snapshotted.offlineDotTargetIds.length != 1 ||
        <uint>snapshotted.offlineDotAbilityCodes[0] != arcaneShot ||
        <uint>snapshotted.offlineDotRanks[0] != <uint>2 ||
        !floatMatches(<float>snapshotted.offlineDotDurations[0], 3.0) ||
        !floatMatches(<float>snapshotted.offlineDotTickIntervals[0], 1.0) ||
        !offlineDotStateIsValid(snapshotted)) { return -15; }
    var tickHp = <int>snapshotted.entityHp[1];
    var tickDamage = <int>snapshotted.offlineDotDamages[0];
    var tickThreat = stateThreatValue(snapshotted, 1, <uint>snapshotted.entityIds[0]);
    var arcaneIndex = m4AbilityCatalog.indexOf("arcane_shot");
    var expectedTickThreat = tickThreat + <float>tickDamage *
        m4AbilityCatalog.metric(arcaneIndex, <int>snapshotted.entityLevels[0], "threatMult") +
        m4AbilityCatalog.metric(arcaneIndex, <int>snapshotted.entityLevels[0], "threatFlat");
    snapshotted.offlineDotTickTimers[0] = 0.05;
    stepOfflineEastbrookDots(snapshotted);
    if (arcaneIndex < 0 || <int>snapshotted.entityHp[1] != tickHp - tickDamage ||
        !floatMatches(
            stateThreatValue(snapshotted, 1, <uint>snapshotted.entityIds[0]), expectedTickThreat
        )) { return -16; }

    var normal = decodeState(encodeState(venom));
    var critical = decodeState(encodeState(venom));
    critical.entityCritChance[0] = 1.0;
    landOfflineArcaneShotProjectile(normal, 0, 0, 1);
    landOfflineArcaneShotProjectile(critical, 0, 0, 1);
    if (normal.offlineDotTargetIds.length != 1 || critical.offlineDotTargetIds.length != 1 ||
        <int>critical.offlineDotResolvedTotals[0] <=
            <int>normal.offlineDotResolvedTotals[0] ||
        normal.rngDraws != <uint>3 || critical.rngDraws != <uint>3) { return -17; }
    var resisted = decodeState(encodeState(venom));
    resisted.entityHitBonus[0] = -100.0;
    landOfflineArcaneShotProjectile(resisted, 0, 0, 1);
    var fizzled = decodeState(encodeState(venom));
    fizzled.entityDead[1] = true;
    stepOfflineEastbrookProjectiles(fizzled);
    return resisted.offlineDotTargetIds.length == 0 && resisted.rngDraws == <uint>1 &&
        fizzled.offlineDotTargetIds.length == 0 && fizzled.rngDraws == <uint>0 ? 1 : -18;
}

pub wingClipRuntimeStateTest(): int {
    var wingClip = wingClipAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("wing_clip");
    var hunter = knownAbilityCatalog.classIndex("hunter");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (wingClip == <uint>0 || abilityIndex != 110 || hunter < 0 || forestWolf == <uint>0 ||
        !wingClipProfileIsValid(abilityIndex, 10) || wingClipResolution.contractTest() != 1) {
        return -1;
    }

    // Fettering Slash has no projectile or weapon-swing admission: a valid
    // instant cast spends 20 resource, consumes exactly range/crit draws, and
    // writes the physical slow before this snapshot is serialized.
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>hunter;
    var playerId = state.spawnPlayer(<uint>(hunter + 1), 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 10, 0.0, 1.5, 3.0, 1000, 7.0);
    state.entityResources[0] = 100.0;
    state.entityMaxResources[0] = 100.0;
    state.entityAttackPower[0] = 0;
    state.entityCritChance[0] = 0.0;
    state.entityArmor[1] = 0;
    state.entityKnownAbilityCodes.add(wingClip);
    var offset = 1;
    while (offset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    state.entityTargetIds[0] = targetId;
    var baseline = decodeState(encodeState(state));
    var armored = decodeState(encodeState(state));
    armored.entityArmor[1] = 100000;
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    var damage = 1000 - <int>state.entityHp[1];
    if (playerId == <uint>0 || damage < 3 || damage > 5 ||
        !floatMatches(<float>state.entityResources[0], 80.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        state.rngDraws != <uint>2 || abilityCooldownExpiresAt(state, 0, wingClip) != <uint>0 ||
        state.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>state.entityMotionAuraAbilityCodes[0] != wingClip ||
        <uint>state.entityMotionAuraSourceIds[0] != playerId ||
        <uint>state.entityMotionAuraSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL ||
        <uint>state.entityMotionAuraKindCodes[0] != ccContract.motionAuraKindCode("slow") ||
        !floatMatches(<float>state.entityMotionAuraRemaining[0], 10.0) ||
        !floatMatches(<float>state.entityMotionAuraValues[0], 0.6) ||
        !floatMatches(stateThreatValue(state, 1, playerId), <float>damage)) { return -2; }
    var restored = decodeState(encodeState(state));
    if (restored.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>restored.entityMotionAuraAbilityCodes[0] != wingClip ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 10.0) ||
        !floatMatches(<float>restored.entityMotionAuraValues[0], 0.6)) { return -3; }

    startOfflineWingClipCast(baseline, 0, targetId);
    startOfflineWingClipCast(armored, 0, targetId);
    var baselineDamage = 1000 - <int>baseline.entityHp[1];
    var armoredDamage = 1000 - <int>armored.entityHp[1];
    if (baselineDamage < 3 || baselineDamage > 5 || armoredDamage >= baselineDamage ||
        baseline.rngDraws != <uint>2 || armored.rngDraws != <uint>2) { return -4; }

    var rejected = new WorldState();
    rejected.offlineSessionActive = true;
    rejected.offlinePlayerClass = <uint>hunter;
    var rejectedPlayer = rejected.spawnPlayer(
        <uint>(hunter + 1), 10, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    var rejectedTarget = rejected.spawnMob(forestWolf, 10, 0.0, 1.5, 6.0, 1000, 7.0);
    rejected.entityResources[0] = 100.0;
    rejected.entityKnownAbilityCodes.add(wingClip);
    offset = 1;
    while (offset < rejected.entityKnownAbilityOffsets.length) {
        rejected.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    startOfflineWingClipCast(rejected, 0, rejectedTarget);
    rejected.entityZ[1] = 3.0;
    rejected.entityFacing[0] = 3.14159265;
    startOfflineWingClipCast(rejected, 0, rejectedTarget);
    if (rejectedPlayer == <uint>0 || !floatMatches(<float>rejected.entityResources[0], 100.0) ||
        !floatMatches(<float>rejected.entityCastGcdRemaining[0], 0.0) ||
        rejected.rngDraws != <uint>0 || rejected.entityMotionAuraAbilityCodes.length != 0) {
        return -5;
    }

    var typed = new WorldState();
    typed.offlineSessionActive = true;
    typed.offlinePlayerClass = <uint>hunter;
    var typedPlayer = typed.spawnPlayer(<uint>(hunter + 1), 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var typedTarget = typed.spawnMob(forestWolf, 10, 0.0, 1.5, 3.0, 1000, 7.0);
    typed.entityResources[0] = 100.0;
    typed.entityArmor[1] = 0;
    typed.entityKnownAbilityCodes.add(wingClip);
    offset = 1;
    while (offset < typed.entityKnownAbilityOffsets.length) {
        typed.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    var bytes = new container.Array<uint>();
    bytes.add(<uint>119); bytes.add(<uint>105); bytes.add(<uint>110); bytes.add(<uint>103);
    bytes.add(<uint>95); bytes.add(<uint>99); bytes.add(<uint>108); bytes.add(<uint>105);
    bytes.add(<uint>112);
    var typedCommand = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typedCommand, typedPlayer, <uint>1, <uint>1, bytes, typedTarget
    );
    typed.applyCommands(typedCommand, 1);
    return typedPlayer != <uint>0 && floatMatches(<float>typed.entityResources[0], 80.0) &&
        typed.rngDraws == <uint>2 && typed.entityMotionAuraOffsets[2] == <uint>1 &&
        <uint>typed.entityMotionAuraAbilityCodes[0] == wingClip &&
        <uint>typed.entityLastCommandSequence[0] == <uint>1 ? 1 : -6;
}

pub concussiveShotRuntimeStateTest(): int {
    var concussiveShot = concussiveShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("concussive_shot");
    var hunter = knownAbilityCatalog.classIndex("hunter");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (concussiveShot == <uint>0 || abilityIndex != 111 || hunter < 0 ||
        forestWolf == <uint>0 || !concussiveShotProfileIsValid(abilityIndex, 8)) {
        return -1;
    }

    // The instant physical shot spends and arms its projectile at admission;
    // its range and critical rolls are deferred until the projectile lands.
    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>hunter;
    var playerId = state.spawnPlayer(<uint>(hunter + 1), 8, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 8, 0.0, 1.5, 10.0, 1000, 7.0);
    state.entityResources[0] = 100.0;
    state.entityMaxResources[0] = 100.0;
    state.entityRangedPower[0] = 300;
    state.entityCritChance[0] = 0.0;
    state.entityCritDamagePhysicalBonus[0] = 0.0;
    state.entityArmor[1] = 0;
    // The seeded range roll stays below 0.25, making the source's round-after-
    // crit rule exactly double the uncritical result for this coefficient probe.
    state.rngState = <uint>20061;
    state.entityKnownAbilityCodes.add(concussiveShot);
    var offset = 1;
    while (offset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    state.entityTargetIds[0] = targetId;
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || !floatMatches(<float>state.entityResources[0], 80.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, concussiveShot) != <uint>12000000 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileAbilityCodes[0] != concussiveShot ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL ||
        !floatMatches(<float>state.offlineProjectileMinimums[0], 4.0) ||
        !floatMatches(<float>state.offlineProjectileMaximums[0], 6.0) ||
        !floatMatches(<float>state.offlineProjectileCastTimes[0], 0.0) ||
        state.entityMotionAuraAbilityCodes.length != 0 || state.rngDraws != <uint>0) {
        return -2;
    }

    var baseline = decodeState(encodeState(state));
    var zeroRap = decodeState(encodeState(state));
    var armored = decodeState(encodeState(state));
    var critical = decodeState(encodeState(state));
    var lethal = decodeState(encodeState(state));
    zeroRap.entityRangedPower[0] = 0;
    armored.entityArmor[1] = 100000;
    critical.entityCritChance[0] = 1.0;
    lethal.entityHp[1] = 1;
    var baselineHp = <int>baseline.entityHp[1];
    var zeroRapHp = <int>zeroRap.entityHp[1];
    var armoredHp = <int>armored.entityHp[1];
    var criticalHp = <int>critical.entityHp[1];
    landOfflineConcussiveShotProjectile(baseline, 0, 0, 1);
    landOfflineConcussiveShotProjectile(zeroRap, 0, 0, 1);
    landOfflineConcussiveShotProjectile(armored, 0, 0, 1);
    landOfflineConcussiveShotProjectile(critical, 0, 0, 1);
    landOfflineConcussiveShotProjectile(lethal, 0, 0, 1);
    var baselineDamage = baselineHp - <int>baseline.entityHp[1];
    var zeroRapDamage = zeroRapHp - <int>zeroRap.entityHp[1];
    var armoredDamage = armoredHp - <int>armored.entityHp[1];
    var criticalDamage = criticalHp - <int>critical.entityHp[1];
    var expectedRangedApBonus = spellScaling.directHitBonus(300.0, "physical", true, 0.0, false);
    if (baselineDamage != zeroRapDamage + expectedRangedApBonus ||
        criticalDamage != baselineDamage * 2 || zeroRapDamage < 4 || armoredDamage < 1 ||
        armoredDamage >= baselineDamage || baseline.rngDraws != <uint>2 ||
        zeroRap.rngDraws != <uint>2 || armored.rngDraws != <uint>2 ||
        critical.rngDraws != <uint>2 || <int>lethal.entityHp[1] != 0 ||
        lethal.entityMotionAuraAbilityCodes.length != 0 ||
        !floatMatches(stateThreatValue(lethal, 1, playerId), 0.0) ||
        lethal.rngDraws != <uint>2 || baseline.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>baseline.entityMotionAuraAbilityCodes[0] != concussiveShot ||
        <uint>baseline.entityMotionAuraSourceIds[0] != playerId ||
        <uint>baseline.entityMotionAuraSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL ||
        <uint>baseline.entityMotionAuraKindCodes[0] != ccContract.motionAuraKindCode("slow") ||
        !floatMatches(<float>baseline.entityMotionAuraRemaining[0], 4.0) ||
        !floatMatches(<float>baseline.entityMotionAuraValues[0], 0.5) ||
        !floatMatches(stateThreatValue(baseline, 1, playerId), <float>baselineDamage)) {
        return -3;
    }
    var restored = decodeState(encodeState(baseline));
    if (restored.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>restored.entityMotionAuraAbilityCodes[0] != concussiveShot ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 4.0) ||
        !floatMatches(<float>restored.entityMotionAuraValues[0], 0.5)) {
        return -4;
    }

    var fizzled = decodeState(encodeState(state));
    fizzled.entityDead[1] = true;
    stepOfflineEastbrookProjectiles(fizzled);
    if (fizzled.offlineProjectileSourceIds.length != 0 || fizzled.rngDraws != <uint>0 ||
        fizzled.entityMotionAuraAbilityCodes.length != 0) { return -5; }

    var rejected = new WorldState();
