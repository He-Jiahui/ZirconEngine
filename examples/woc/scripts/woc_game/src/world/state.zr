    ) / mageSpellHasteMultiplier(state, casterIndex);
}

fearGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 1.0 ? 1.0 : gcd;
}

