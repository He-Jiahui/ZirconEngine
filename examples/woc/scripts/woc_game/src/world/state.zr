        <int>playerBoarMelee.entityHp[1] != 0 ||
        !<bool>playerBoarMelee.entityDead[0] ||
        <int>playerBoarMelee.entityHp[0] != 0 ||
        <uint>playerBoarMelee.rngDraws != <uint>7) {
        return -14;
    }

    var playerQuestMelee = new WorldState();
    playerQuestMelee.offlineSessionActive = true;
    var playerQuestMeleeId = playerQuestMelee.spawnPlayer(
        <uint>1, 1, 0.0, 1.5, 4.0, 100, 7.0, 1
    );
    var playerQuestMeleeMobId = playerQuestMelee.spawnMob(
        forestWolf, 1, 0.0, 1.5, 0.0, 5, 8.0
    );
    playerQuestMelee.offlineQuestWolvesState = <uint>1;
    playerQuestMelee.entityWeaponMinimum[0] = 10.0;
    playerQuestMelee.entityWeaponMaximum[0] = 10.0;
    playerQuestMelee.entityWeaponSpeed[0] = 2.0;
    playerQuestMelee.entityAttackPower[0] = 0;
    playerQuestMelee.entityCritChance[0] = 0.0;
    playerQuestMelee.entityFacing[0] = 3.141592653589793;
    playerQuestMelee.entityTargetIds[0] = playerQuestMeleeMobId;
    playerQuestMelee.entityAutoAttack[0] = true;
    playerQuestMelee.entityArmor[1] = 0;
    stepOfflineDirectMeleeAutoAttack(playerQuestMelee);
    if (playerQuestMeleeId == <uint>0 || playerQuestMeleeMobId == <uint>0 ||
        <int>playerQuestMelee.entityHp[1] != 0 ||
        playerQuestMelee.offlineQuestWolvesObjectiveCount != <uint>1 ||
        playerQuestMelee.offlineQuestWolvesState != <uint>1) {
        return -15;
    }
    if (offlineMobXpValue(1, 1) != <uint>50 ||
        offlineMobXpValue(2, 1) != <uint>58 ||
        offlineMobXpValue(1, 2) != <uint>40 ||
        offlineMobXpValue(2, 7) != <uint>0) {
        return -16;
    }
    return 1;
}

