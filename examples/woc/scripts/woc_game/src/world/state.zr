pub offlineEastbrookMobLifecycleStateTest(): int {
    var state = new WorldState();
    state.offlineSessionActive = true;
    var playerId = state.spawnPlayer(<uint>1, 1, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var mobId = state.spawnMob(forestWolf, 1, 12.0, 2.5, -4.0, 40, 8.0);
    var mobIndex = 1;
    state.entityAiStates[mobIndex] = mobLifecycle.chaseAiState();
    state.entityTargetIds[mobIndex] = playerId;
    state.entityAggroTargetIds[mobIndex] = playerId;
    state.entityInCombat[mobIndex] = true;
    state.entityLeashAnchorPresent[mobIndex] = true;
    state.entityForcedTargetIds[mobIndex] = playerId;
    state.entityForcedTargetTimers[mobIndex] = 3.0;
    state.setThreat(mobId, playerId, 2.0, 1);
    state.entityHp[mobIndex] = 0;
    stepOfflineEastbrookMobLifecycle(state);
    if (playerId == <uint>0 || mobId == <uint>0 ||
        !<bool>state.entityDead[mobIndex] ||
        <uint>state.entityAiStates[mobIndex] != mobLifecycle.deadAiState() ||
        <uint>state.entityCorpseMicros[mobIndex] != <uint>59950000 ||
        <uint>state.entityRespawnMicros[mobIndex] != <uint>29950000 ||
        <uint>state.entityAggroTargetIds[mobIndex] != <uint>0 ||
        !<bool>state.entityInCombat[mobIndex] ||
        !<bool>state.entityLeashAnchorPresent[mobIndex] ||
        <uint>state.entityForcedTargetIds[mobIndex] != <uint>0 ||
        <float>state.entityForcedTargetTimers[mobIndex] != 0.0 ||
        <uint>state.entityThreatOffsets[2] != <uint>0) {
        return -1;
    }
    state.entityX[mobIndex] = 99.0;
    state.entityY[mobIndex] = 0.0;
    state.entityZ[mobIndex] = 99.0;
    state.entityRespawnMicros[mobIndex] = mobLifecycle.fixedTickMicros();
    state.entityCorpseMicros[mobIndex] = <uint>100000;
    state.entityLootable[mobIndex] = true;
    stepOfflineEastbrookMobLifecycle(state);
    if (!<bool>state.entityDead[mobIndex] ||
        <uint>state.entityRespawnMicros[mobIndex] != <uint>0 ||
        <uint>state.entityCorpseMicros[mobIndex] != mobLifecycle.fixedTickMicros()) {
        return -2;
    }
    state.entityLootable[mobIndex] = false;
    var drawsBefore = <uint>state.rngDraws;
    stepOfflineEastbrookMobLifecycle(state);
    if (<bool>state.entityDead[mobIndex] ||
        <int>state.entityHp[mobIndex] != <int>state.entityMaxHp[mobIndex] ||
        !<bool>state.entityHostile[mobIndex] ||
        <uint>state.entityAiStates[mobIndex] != mobLifecycle.idleAiState() ||
        <uint>state.entityTargetIds[mobIndex] != <uint>0 ||
        <uint>state.entityAggroTargetIds[mobIndex] != <uint>0 ||
        <bool>state.entityInCombat[mobIndex] ||
        <float>state.entityX[mobIndex] != 12.0 ||
        <float>state.entityY[mobIndex] != 2.5 ||
        <float>state.entityZ[mobIndex] != -4.0 ||
        <float>state.entityPreviousX[mobIndex] != 12.0 ||
        <float>state.entityPreviousY[mobIndex] != 2.5 ||
        <float>state.entityPreviousZ[mobIndex] != -4.0 ||
        <bool>state.entityLootable[mobIndex] ||
        <uint>state.entityCorpseMicros[mobIndex] != <uint>0 ||
        <uint>state.entityRespawnMicros[mobIndex] != <uint>0 ||
        <float>state.entityWanderTimers[mobIndex] < 2.0 ||
        <float>state.entityWanderTimers[mobIndex] >= 8.0 ||
        <uint>state.rngDraws != drawsBefore + <uint>1) {
        return -3;
    }
    return 1;
}

