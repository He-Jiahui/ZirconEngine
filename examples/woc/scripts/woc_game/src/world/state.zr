pub improvedConcussiveRuntimeStateTest(): int {
    var concussiveShot = concussiveShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("concussive_shot");
    var hunter = knownAbilityCatalog.classIndex("hunter");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    var improved = talentSelectionCatalog.optionCode(
        "hunter", 8, "hun_r8_improved_concussive"
    );
    if (concussiveShot == <uint>0 || abilityIndex != 111 || hunter < 0 ||
        forestWolf == <uint>0 || improved != <uint>42 ||
        concussiveShotRuntimeStateTest() != 1) { return -1; }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>hunter;
    var playerId = state.spawnPlayer(<uint>(hunter + 1), 8, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 8, 0.0, 1.5, 10.0, 1000, 7.0);
    state.entityResources[0] = 100.0;
    state.entityMaxResources[0] = 100.0;
    state.entityArmor[1] = 0;
    state.entityCritChance[0] = 0.0;
    if (!replaceOfflineTalentAllocation(
            state, 0, <uint>0, <uint>0, improved, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, concussiveShot)) {
        return -2;
    }
    state.entityTargetIds[0] = targetId;
    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        !floatMatches(<float>state.entityResources[0], 80.0) ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileTalentRowOptionCodes[1] != improved ||
        state.rngDraws != <uint>0) { return -3; }

    var fizzled = decodeState(encodeState(state));
    fizzled.entityDead[1] = true;
    stepOfflineEastbrookProjectiles(fizzled);
    if (fizzled.offlineProjectileSourceIds.length != 0 ||
        fizzled.entityMotionAuraAbilityCodes.length != 0 ||
        fizzled.rngDraws != <uint>0) { return -4; }

    // The projectile owns the selected row even after the live loadout changes.
    if (!replaceOfflineTalentAllocation(
            state, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || <uint>state.entityTalentRowOptionCodes[1] != <uint>0) {
        return -5;
    }
    var restored = decodeState(encodeState(state));
    if (<uint>restored.offlineProjectileTalentRowOptionCodes[1] != improved ||
        <uint>restored.entityTalentRowOptionCodes[1] != <uint>0) { return -6; }
    landOfflineConcussiveShotProjectile(restored, 0, 0, 1);
    if (restored.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>restored.entityMotionAuraAbilityCodes[0] != concussiveShot ||
        <uint>restored.entityMotionAuraSourceIds[0] != playerId ||
        <uint>restored.entityMotionAuraKindCodes[0] != ccContract.motionAuraKindCode("slow") ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 4.0) ||
        !floatMatches(<float>restored.entityMotionAuraValues[0], 0.3) ||
        !floatMatches(motionAuras.movementMultiplier(
            frostboltSlowMultiplier(), 1.0,
            restored.entityMotionAuraAbilityCodes,
            restored.entityMotionAuraSourceIds,
            restored.entityMotionAuraKindCodes,
            restored.entityMotionAuraRemaining,
            restored.entityMotionAuraValues,
            <int><uint>restored.entityMotionAuraOffsets[1],
            <int><uint>restored.entityMotionAuraOffsets[2], true
        ), 0.3) || restored.rngDraws != <uint>2) { return -7; }

    // Same-source Concussive rows refresh, while a second caster's same aura
    // id remains active and participates in the source minimum-slow rule.
    var otherSourceId = restored.spawnPlayer(
        <uint>(hunter + 1), 8, 2.0, 1.5, 0.0, 100, 7.0, 1
    );
    applyOfflineMotionAuraWithDetailsAndSchool(
        restored, 1, concussiveShot, otherSourceId,
        ccContract.motionAuraKindCode("slow"), 4.0, 0.5, 0.0,
        OFFLINE_PROJECTILE_SCHOOL_PHYSICAL
    );
    applyOfflineMotionAuraWithDetailsAndSchool(
        restored, 1, concussiveShot, otherSourceId,
        ccContract.motionAuraKindCode("slow"), 3.0, 0.4, 0.0,
        OFFLINE_PROJECTILE_SCHOOL_PHYSICAL
    );
    if (otherSourceId == <uint>0 || restored.entityMotionAuraOffsets[2] != <uint>2 ||
        <uint>restored.entityMotionAuraSourceIds[0] != playerId ||
        <uint>restored.entityMotionAuraSourceIds[1] != otherSourceId ||
        !floatMatches(<float>restored.entityMotionAuraValues[0], 0.3) ||
        !floatMatches(<float>restored.entityMotionAuraValues[1], 0.4) ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[1], 3.0) ||
        !floatMatches(motionAuras.movementMultiplier(
            frostboltSlowMultiplier(), 1.0,
            restored.entityMotionAuraAbilityCodes,
            restored.entityMotionAuraSourceIds,
            restored.entityMotionAuraKindCodes,
            restored.entityMotionAuraRemaining,
            restored.entityMotionAuraValues,
            <int><uint>restored.entityMotionAuraOffsets[1],
            <int><uint>restored.entityMotionAuraOffsets[2], true
        ), 0.3)) { return -11; }

    var typed = new WorldState();
    typed.offlineSessionActive = true;
    typed.offlinePlayerClass = <uint>hunter;
    var typedPlayer = typed.spawnPlayer(
        <uint>(hunter + 1), 8, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    var typedTarget = typed.spawnMob(forestWolf, 8, 0.0, 1.5, 10.0, 1000, 7.0);
    typed.entityResources[0] = 100.0;
    typed.entityMaxResources[0] = 100.0;
    typed.entityArmor[1] = 0;
    typed.entityCritChance[0] = 0.0;
    if (!replaceOfflineTalentAllocation(
            typed, 0, <uint>0, <uint>0, improved, <uint>0,
            <uint>0, <uint>0, <uint>0
        )) { return -8; }
    var bytes = new container.Array<uint>();
    bytes.add(<uint>99); bytes.add(<uint>111); bytes.add(<uint>110); bytes.add(<uint>99);
    bytes.add(<uint>117); bytes.add(<uint>115); bytes.add(<uint>115); bytes.add(<uint>105);
    bytes.add(<uint>118); bytes.add(<uint>101); bytes.add(<uint>95); bytes.add(<uint>115);
    bytes.add(<uint>104); bytes.add(<uint>111); bytes.add(<uint>116);
    var typedCommand = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typedCommand, typedPlayer, <uint>1, <uint>1, bytes, typedTarget
    );
    typed.applyCommands(typedCommand, 1);
    if (typedPlayer == <uint>0 || typedTarget == <uint>0 ||
        !floatMatches(<float>typed.entityResources[0], 80.0) ||
        <uint>typed.offlineProjectileTalentRowOptionCodes[1] != improved ||
        <uint>typed.entityLastCommandSequence[0] != <uint>1 || typed.rngDraws != <uint>0) {
        return -9;
    }
