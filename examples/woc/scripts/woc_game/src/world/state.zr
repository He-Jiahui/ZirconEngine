        <uint>state.offlineTalentLoadoutActionBarAbilityCodes[1] != <uint>0 ||
        <uint>state.offlineTalentLoadoutActionBarAbilityCodes[2] != rendCode ||
        saved.offlineTalentLoadoutSpecCodes.length != 1 ||
