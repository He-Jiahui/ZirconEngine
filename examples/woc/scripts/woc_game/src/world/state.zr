        schemaVersion != <uint>7 && schemaVersion != <uint>8 && schemaVersion != <uint>9 &&
        schemaVersion != <uint>10 && schemaVersion != <uint>11 && schemaVersion != <uint>12 &&
        schemaVersion != <uint>13 && schemaVersion != <uint>14 &&
        schemaVersion != <uint>15 && schemaVersion != <uint>16 &&
        schemaVersion != <uint>17 && schemaVersion != <uint>18 &&
         schemaVersion != <uint>19 && schemaVersion != <uint>20 &&
         schemaVersion != <uint>21 && schemaVersion != <uint>22 &&
         schemaVersion != <uint>23 && schemaVersion != <uint>24 &&
         schemaVersion != <uint>25 && schemaVersion != <uint>26 &&
         schemaVersion != <uint>27 && schemaVersion != <uint>28 &&
         schemaVersion != <uint>29 && schemaVersion != <uint>30 &&
         schemaVersion != <uint>31 && schemaVersion != <uint>32 &&
         schemaVersion != <uint>33 && schemaVersion != <uint>34 &&
         schemaVersion != <uint>35 && schemaVersion != <uint>36 &&
         schemaVersion != <uint>37 && schemaVersion != <uint>38 &&
         schemaVersion != <uint>39 && schemaVersion != <uint>40 &&
          schemaVersion != <uint>41 && schemaVersion != <uint>42 &&
          schemaVersion != <uint>43 && schemaVersion != <uint>44 &&
          schemaVersion != <uint>45 && schemaVersion != <uint>46 &&
          schemaVersion != <uint>47 && schemaVersion != <uint>48 &&
          schemaVersion != <uint>49 && schemaVersion != <uint>50 &&
        schemaVersion != <uint>51 && schemaVersion != <uint>52 &&
        schemaVersion != <uint>53 && schemaVersion != <uint>54 &&
        schemaVersion != <uint>55 && schemaVersion != <uint>56 &&
        schemaVersion != <uint>57 && schemaVersion != <uint>58 &&
        schemaVersion != <uint>59 && schemaVersion != <uint>60 &&
        schemaVersion != <uint>61 && schemaVersion != <uint>62 &&
        schemaVersion != <uint>63 && schemaVersion != <uint>64 &&
        schemaVersion != <uint>65 && schemaVersion != <uint>66 &&
        schemaVersion != <uint>67 && schemaVersion != <uint>68 &&
        schemaVersion != <uint>69 && schemaVersion != <uint>70 &&
        schemaVersion != <uint>71 && schemaVersion != <uint>72 &&
        schemaVersion != <uint>73 && schemaVersion != <uint>74 &&
        schemaVersion != <uint>75 && schemaVersion != <uint>76 &&
        schemaVersion != <uint>77 && schemaVersion != <uint>78 &&
        schemaVersion != <uint>79 && schemaVersion != <uint>80 &&
        schemaVersion != <uint>81 && schemaVersion != <uint>82 &&
        schemaVersion != <uint>83 && schemaVersion != <uint>84 &&
        schemaVersion != <uint>85 && schemaVersion != <uint>86 &&
        schemaVersion != <uint>87 && schemaVersion != <uint>88 &&
        schemaVersion != <uint>89 && schemaVersion != <uint>90 &&
        schemaVersion != <uint>91 && schemaVersion != <uint>92 &&
        schemaVersion != <uint>93 && schemaVersion != <uint>94 &&
        schemaVersion != <uint>95 && schemaVersion != <uint>96 &&
        schemaVersion != <uint>97 && schemaVersion != <uint>98 &&
        schemaVersion != <uint>99 && schemaVersion != <uint>100 &&
        schemaVersion != <uint>101 && schemaVersion != <uint>102 &&
        schemaVersion != <uint>103 && schemaVersion != <uint>104 &&
        schemaVersion != <uint>105 && schemaVersion != <uint>106 &&
        schemaVersion != <uint>107 && schemaVersion != <uint>108 &&
        schemaVersion != <uint>109 && schemaVersion != <uint>110 &&
        schemaVersion != <uint>111 && schemaVersion != <uint>112 &&
        schemaVersion != <uint>113 && schemaVersion != <uint>114 &&
        schemaVersion != <uint>115 && schemaVersion != <uint>116 &&
        schemaVersion != <uint>117) {
        throw "woc world state schema is unsupported";
    }
    var state = new WorldState();
    state.tick = reader.u64(1, 1, 2, 4);
    state.timeMicros = reader.u64(1, 1, 2, 4);
    state.nextEntityId = reader.u64(1, 1, 2, 4);
    state.generation = reader.u64(1, 1, 2, 4);
    state.rngState = reader.u32(1, 1, 2);
