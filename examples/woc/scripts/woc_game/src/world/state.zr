            ),
            false
        )) { return; }
    var level = <int>state.entityLevels[casterIndex];
    if (!dashProfileIsValid(abilityIndex, level) ||
        !m4AbilityCatalog.flag(abilityIndex, "offGcd")) { return; }
    state.entitySitting[casterIndex] = false;
