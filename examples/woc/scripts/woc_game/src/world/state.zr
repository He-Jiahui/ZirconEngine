    }
    state.entityResources[0] = 0;
    setAbilityCooldownExpiration(state, 0, enrage, <uint>0);
    if (!replaceOfflineTalentAllocation(
            state, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, enrage)) {
        return -5;
    }
    startOfflineEnrageCast(state, 0);
    return <float>state.entityResources[0] == 20 &&
        abilityCooldownExpiresAt(state, 0, enrage) == <uint>60000000 ? 1 : -6;
}

// Tiger's Fury retains its resolved `buff_ap` row and application selection;
// respec only changes the next application after the old aura is removed.
pub tigersFuryTalentSnapshotRuntimeStateTest(): int {
    if (flatBuffTalentScaling.contractTest() != 1) { return -1; }
    var feral = talentSelectionCatalog.specCode("druid", "feral");
    var tigersFury = tigersFuryAbilityCode();
