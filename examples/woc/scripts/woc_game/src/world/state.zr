appendDefaultConsumableColumns(state: WorldState): void {
    state.entityEatingItemCodes.add(<uint>0);
    state.entityEatingHpPerTwoSeconds.add(0);
    state.entityEatingRemaining.add(0.0);
    state.entityDrinkingItemCodes.add(<uint>0);
    state.entityDrinkingManaPerTwoSeconds.add(0);
    state.entityDrinkingRemaining.add(0.0);
}

consumableStateIsValid(state: WorldState, index: int): bool {
    if (index < 0 || index >= state.entityIds.length) { return false; }
    var catalog = %import("generated/m5_content_catalog");
    var eatingCode = <uint>state.entityEatingItemCodes[index];
    var eatingValue = <int>state.entityEatingHpPerTwoSeconds[index];
    var eatingRemaining = <float>state.entityEatingRemaining[index];
    if (eatingCode == <uint>0) {
        if (eatingValue != 0 || eatingRemaining != 0.0) { return false; }
    } else {
        var eatingItemIndex = m5InventoryRules.itemIndexFromCode(eatingCode);
        if (eatingItemIndex < 0 || catalog.text("item", eatingItemIndex, "kind") != "food" ||
            eatingValue <= 0 || eatingValue > 65535 ||
            eatingRemaining <= 0.0 || eatingRemaining > 18.0) {
            return false;
        }
    }
    var drinkingCode = <uint>state.entityDrinkingItemCodes[index];
    var drinkingValue = <int>state.entityDrinkingManaPerTwoSeconds[index];
    var drinkingRemaining = <float>state.entityDrinkingRemaining[index];
    if (drinkingCode == <uint>0) {
        return drinkingValue == 0 && drinkingRemaining == 0.0;
    }
    var drinkingItemIndex = m5InventoryRules.itemIndexFromCode(drinkingCode);
    return drinkingItemIndex >= 0 &&
        catalog.text("item", drinkingItemIndex, "kind") == "drink" &&
        drinkingValue > 0 && drinkingValue <= 65535 &&
        drinkingRemaining > 0.0 && drinkingRemaining <= 18.0;
}

resourceCooldownStateIsValid(state: WorldState, index: int): bool {
    return index >= 0 && index < state.entityIds.length &&
        <float>state.entityFiveSecondRules[index] >= 0.0 &&
        <int>state.entityComboPoints[index] >= 0 && <int>state.entityComboPoints[index] <= 5 &&
        <float>state.entityComboUntil[index] >= -1.0 &&
        <float>state.entityOverpowerUntil[index] >= -1.0 &&
        <float>state.entityPotionCooldownUntil[index] >= -1.0 &&
        <float>state.entityPotionCooldownRemaining[index] >= 0.0 &&
        <int>state.entitySavedMana[index] >= 0;
}

