// WOS v17 keeps the opaque Card Duel service state bounded so an untrusted
// authoritative-state payload cannot allocate without limit during restore.
var CARD_DUEL_SNAPSHOT_MAX_BYTES: uint = <uint>16777216;
// The offline MVP has source-pinned Hunter and caster-wand profiles. Bound this
// untrusted snapshot tail while still preserving every realistic projectile in
// its three-second source flight window.
var OFFLINE_PROJECTILE_PENDING_MAX: uint = <uint>64;
var OFFLINE_DOT_PENDING_MAX: uint = <uint>64;
var OFFLINE_PERIODIC_TICK_EPS: float = 0.000001;
var OFFLINE_SOURCE_GLOBAL_COOLDOWN_SECONDS: float = 1.5;
var OFFLINE_SOURCE_MIN_GLOBAL_COOLDOWN_SECONDS: float = 0.75;
var OFFLINE_SOURCE_TARGET_FACING_HALF_ARC: float = 2.2;
var OFFLINE_PROJECTILE_SCHOOL_PHYSICAL: uint = <uint>0;
var OFFLINE_PROJECTILE_SCHOOL_ARCANE: uint = <uint>1;
var OFFLINE_PROJECTILE_SCHOOL_HOLY: uint = <uint>2;
var OFFLINE_PROJECTILE_SCHOOL_SHADOW: uint = <uint>3;
var OFFLINE_PROJECTILE_SCHOOL_NATURE: uint = <uint>4;
var OFFLINE_PROJECTILE_SCHOOL_FROST: uint = <uint>5;
var OFFLINE_PROJECTILE_SCHOOL_FIRE: uint = <uint>6;
// This code is outside the camp table by design: summoned demons are not
// overworld camp templates, but their ordinary entity rows remain WOS-owned.
var OFFLINE_EMBERKIN_TEMPLATE_CODE: uint = <uint>48;
var OFFLINE_EMBERKIN_HP_BASE: int = 30;
var OFFLINE_EMBERKIN_HP_PER_LEVEL: int = 12;
var OFFLINE_EMBERKIN_MOVE_SPEED: float = 5.2;
var OFFLINE_EMBERKIN_DEMON_CORPSE_MICROS: uint = <uint>3000000;
var OFFLINE_EMBERKIN_PRESENTATION_SCALE: float = 0.55;
var OFFLINE_EMBERKIN_PRESENTATION_COLOR: uint = <uint>16742954;

// State-owned projection of the decoded batch. The WOS codec, retained movement
// columns and candidate mutation stay together because the experimental ZrVM
// cross-module Array ABI cannot yet safely carry these parallel mutable columns.
class CommandBatch {
    pub var commandCount: int;
    pub var commandIds: container.Array<uint>;
    pub var commandActorIds: container.Array<uint>;
    pub var commandActorGenerations: container.Array<uint>;
    pub var commandSequences: container.Array<uint>;
    pub var commandPayloadOffsets: container.Array<uint>;
    pub var commandPayloadLengths: container.Array<uint>;
    pub var commandPayloadBytes: container.Array<uint>;

    pub @constructor() {
        this.commandCount = 0;
        this.commandIds = new container.Array<uint>();
        this.commandActorIds = new container.Array<uint>();
        this.commandActorGenerations = new container.Array<uint>();
        this.commandSequences = new container.Array<uint>();
        this.commandPayloadOffsets = new container.Array<uint>();
        this.commandPayloadLengths = new container.Array<uint>();
        this.commandPayloadBytes = new container.Array<uint>();
    }
}

class OfflineBootstrap {
    pub var launchVersion: uint;
    pub var worldSeed: uint;
    pub var playerClass: uint;
    pub var playerName: container.Array<uint>;
    pub var skinVariant: uint;

    pub @constructor() {
        this.launchVersion = <uint>0;
        this.worldSeed = <uint>0;
        this.playerClass = <uint>0;
        this.playerName = new container.Array<uint>();
        this.skinVariant = <uint>0;
    }
}

class WorldState {
    pub var tick: uint;
    pub var timeMicros: uint;
    pub var nextEntityId: uint;
    pub var generation: uint;
    pub var rngState: uint;
    pub var rngDraws: uint;
    pub var rngDigest: uint;
    // Offline WOC worlds begin from the pinned target seed. Realm creation may
    // supply another seed later, but the committed state—not host wall time—is
    // the authority once a transaction exists.
    pub var worldSeed: uint;
    pub var offlineSessionActive: bool;
    pub var offlinePlayerClass: uint;
    pub var offlinePlayerName: container.Array<uint>;
    pub var offlinePlayerSkinVariant: uint;
    // Session-only offline characters have one authoritative player. Keep its
    // quest ledger beside the WOS codec until the VM can carry a mutable,
    // per-player inventory/quest aggregate across module boundaries.
    pub var offlineQuestBoarsState: uint;
    pub var offlineQuestWolvesState: uint;
    pub var offlineQuestBoarsObjectiveCount: uint;
    pub var offlineQuestWolvesObjectiveCount: uint;
    pub var offlineQuestBoarHideCount: uint;
    pub var offlineQuestCopper: uint;
    pub var offlineQuestExperience: uint;
    pub var offlineQuestLifetimeExperience: uint;
    // WOS56 owns the launch-order pending projectile queue. The primitive
    // payload mirrors the source closure capture; actor/target combat stats
    // stay live and are read only at landing.
    pub var offlineProjectileSourceIds: container.Array<uint>;
    pub var offlineProjectileTargetIds: container.Array<uint>;
    pub var offlineProjectileX: container.Array<float>;
    pub var offlineProjectileZ: container.Array<float>;
    pub var offlineProjectileTtls: container.Array<float>;
    pub var offlineProjectileWands: container.Array<bool>;
    pub var offlineProjectileSchoolCodes: container.Array<uint>;
    pub var offlineProjectileMinimums: container.Array<float>;
    pub var offlineProjectileMaximums: container.Array<float>;
    pub var offlineProjectileSpeeds: container.Array<float>;
    pub var offlineProjectileAbilityCodes: container.Array<uint>;
    pub var offlineProjectileRanks: container.Array<uint>;
    pub var offlineProjectileCastTimes: container.Array<float>;
    // WOS57 stores only source Aura fields required by retained hostile-spell
    // DoT closures. WOS63 adds application-time rank and selected-power rows
    // for pure projectile DoTs; this remains a bounded global tail, not a
    // second entity row.
    pub var offlineDotTargetIds: container.Array<uint>;
    pub var offlineDotSourceIds: container.Array<uint>;
    pub var offlineDotAbilityCodes: container.Array<uint>;
    pub var offlineDotDamages: container.Array<int>;
    pub var offlineDotRanks: container.Array<uint>;
    pub var offlineDotSnapshotPowers: container.Array<int>;
    pub var offlineDotRemaining: container.Array<float>;
    pub var offlineDotDurations: container.Array<float>;
    pub var offlineDotTickIntervals: container.Array<float>;
    pub var offlineDotTickTimers: container.Array<float>;
    // WOS60 is the retained friendly periodic-heal closure. WOS64 appends
    // source rank and selected spell power so new pure HoTs survive reload
    // without reconstructing from later gear.
    pub var offlineHotTargetIds: container.Array<uint>;
    pub var offlineHotSourceIds: container.Array<uint>;
    pub var offlineHotAbilityCodes: container.Array<uint>;
    pub var offlineHotHeals: container.Array<int>;
    pub var offlineHotRanks: container.Array<uint>;
    pub var offlineHotSnapshotPowers: container.Array<int>;
    pub var offlineHotRemaining: container.Array<float>;
    pub var offlineHotDurations: container.Array<float>;
    pub var offlineHotTickIntervals: container.Array<float>;
    pub var offlineHotTickTimers: container.Array<float>;
    // WOS65 is the bounded source-order absorb queue used by the retained
    // Power Word Shield closure. The array order is aura application order.
    pub var offlineAbsorbTargetIds: container.Array<uint>;
    pub var offlineAbsorbSourceIds: container.Array<uint>;
    pub var offlineAbsorbAbilityCodes: container.Array<uint>;
    pub var offlineAbsorbRanks: container.Array<uint>;
    pub var offlineAbsorbAmounts: container.Array<int>;
    pub var offlineAbsorbRemaining: container.Array<float>;
    // WOS61 owns retained Consecration ground-effect closures. The spell-power
    // bonus is captured when the zone is created, as in the source GroundAoE.
    pub var offlineGroundEffectSourceIds: container.Array<uint>;
    pub var offlineGroundEffectAbilityCodes: container.Array<uint>;
    pub var offlineGroundEffectX: container.Array<float>;
    pub var offlineGroundEffectZ: container.Array<float>;
    pub var offlineGroundEffectRadii: container.Array<float>;
    pub var offlineGroundEffectMinimums: container.Array<float>;
    pub var offlineGroundEffectMaximums: container.Array<float>;
    pub var offlineGroundEffectSpellPowerBonuses: container.Array<float>;
    pub var offlineGroundEffectRemaining: container.Array<float>;
    pub var offlineGroundEffectIntervals: container.Array<float>;
    pub var offlineGroundEffectTickTimers: container.Array<float>;
    // WOS11 keeps the source SavedLoadout projection for the single offline
    // player. Names stay raw bounded bytes; code catalogs avoid strings
    // in authoritative allocation and action-bar partitions.
    pub var offlineTalentLoadoutNameOffsets: container.Array<uint>;
    pub var offlineTalentLoadoutNameBytes: container.Array<uint>;
    pub var offlineTalentLoadoutSpecCodes: container.Array<uint>;
    pub var offlineTalentLoadoutRowOptionCodes: container.Array<uint>;
    pub var offlineTalentLoadoutActionBarAbilityCodes: container.Array<uint>;
    pub var offlineTalentActiveLoadoutIndex: int;
    pub var entityIds: container.Array<uint>;
    pub var entityGenerations: container.Array<uint>;
    pub var entityKinds: container.Array<uint>;
    pub var entityTemplates: container.Array<uint>;
    pub var entityLevels: container.Array<int>;
    pub var entityX: container.Array<float>;
    pub var entityY: container.Array<float>;
    pub var entityZ: container.Array<float>;
    pub var entityPreviousX: container.Array<float>;
    pub var entityPreviousY: container.Array<float>;
    pub var entityPreviousZ: container.Array<float>;
    pub var entityFacing: container.Array<float>;
    pub var entityPreviousFacing: container.Array<float>;
    pub var entityVelocityX: container.Array<float>;
    pub var entityVelocityY: container.Array<float>;
    pub var entityVelocityZ: container.Array<float>;
    pub var entityOnGround: container.Array<bool>;
    pub var entityJumping: container.Array<bool>;
    pub var entityFallStartY: container.Array<float>;
    pub var entitySpawnX: container.Array<float>;
    pub var entitySpawnY: container.Array<float>;
    pub var entitySpawnZ: container.Array<float>;
    pub var entityMoveSpeed: container.Array<float>;
    pub var entityHp: container.Array<int>;
    pub var entityMaxHp: container.Array<int>;
    pub var entityHostile: container.Array<bool>;
    pub var entityDead: container.Array<bool>;
    // WOS17 uses source-compatible dead-target metadata: ownerId=0 is null.
    pub var entityOwnerIds: container.Array<uint>;
    // WOS32 keeps the nullable loot/xp/quest-credit tap owner as zero-or-entity-id.
    pub var entityTappedByIds: container.Array<uint>;
    // WOS34 keeps the nullable profession corpse-component claim owner as zero-or-entity-id.
    pub var entityHarvestClaimedByIds: container.Array<uint>;
    // WOS35 distinguishes a finite FFA owner-lock countdown from source Infinity.
    pub var entityLootFfaTimerPresent: container.Array<bool>;
    pub var entityLootFfaTimers: container.Array<float>;
    // WOS36 retains pet scalar runtime fields while the mutable petPath remains
    // outside the projection until Plugins08 can carry generic mutable arrays.
    pub var entityPetModes: container.Array<uint>;
    pub var entityPetTauntTimers: container.Array<float>;
    pub var entityPetAutoTauntPresent: container.Array<bool>;
    pub var entityPetAutoTaunt: container.Array<bool>;
    pub var entityPetAutoWaterJetPresent: container.Array<bool>;
    pub var entityPetAutoWaterJet: container.Array<bool>;
    pub var entityPetManualTauntPendingPresent: container.Array<bool>;
    pub var entityPetManualTauntPending: container.Array<bool>;
    pub var entityPetPathCooldowns: container.Array<float>;
    // WOS37 keeps boss cadence baselines without executing boss mechanics.
    pub var entityBossPulseTimers: container.Array<float>;
    pub var entityBossStompTimers: container.Array<float>;
    pub var entityBossBigCastTimers: container.Array<float>;
    pub var entityBossYelledEngage: container.Array<bool>;
    pub var entityBossStoneskinTimers: container.Array<float>;
    // WOS38 preserves the remaining scalar boss cadence inputs and flags.
    pub var entityBossTerrifyTimers: container.Array<float>;
    pub var entityBossAoeSlowTimers: container.Array<float>;
    pub var entityBossLoudYellTimers: container.Array<float>;
    pub var entityBossLoudYellIndices: container.Array<int>;
    pub var entityBossDetonateTimerPresent: container.Array<bool>;
    pub var entityBossDetonateTimers: container.Array<float>;
    pub var entityBossMendTimers: container.Array<float>;
    pub var entityBossWardTimers: container.Array<float>;
    pub var entityBossChannelTimers: container.Array<float>;
    pub var entityBossChannelRamps: container.Array<float>;
    pub var entityBossRallyTimers: container.Array<float>;
    pub var entityBossWarcryTimers: container.Array<float>;
    pub var entityBossFiredSummons: container.Array<int>;
    pub var entityBossEnraged: container.Array<bool>;
    pub var entityBossHealedThisPull: container.Array<bool>;
    // WOS39 keeps only the source aura rows that affect retained player
    // motion. WOS58 adds source aura value and graded-break fields in a
    // versioned tail, preserving historical entity-row layouts.
    pub var entityMotionAuraOffsets: container.Array<uint>;
    pub var entityMotionAuraAbilityCodes: container.Array<uint>;
    pub var entityMotionAuraSourceIds: container.Array<uint>;
    pub var entityMotionAuraSchoolCodes: container.Array<uint>;
    pub var entityMotionAuraKindCodes: container.Array<uint>;
    pub var entityMotionAuraRemaining: container.Array<float>;
    pub var entityMotionAuraValues: container.Array<float>;
    pub var entityMotionAuraBreakChanceScales: container.Array<float>;
    // Fear is the only retained PvP DR category in this M4 closure. The source
    // stores it per target, so these are entity-aligned rather than aura rows.
    pub var entityFearDrStages: container.Array<int>;
    pub var entityFearDrResetAt: container.Array<float>;
    // WOS71 keeps Sunder Armor as the source's one shared target aura. The
    // retained Eastbrook loop has one authoritative player, so entity-aligned
    // rows preserve the live stack, display value and expiry without inventing
    // a second generic aura partition.
    pub var entitySunderArmorStacks: container.Array<int>;
    pub var entitySunderArmorRemaining: container.Array<float>;
    pub var entitySunderArmorValues: container.Array<float>;
    // WOS66 retains the one source `demoralizing_roar_ap` debuff per target.
    // The offline closure has one authoritative player, so source identity is
    // implicit and the source refresh rule is one row per affected entity.
    pub var entityDemoralizingRoarRemaining: container.Array<float>;
    pub var entityDemoralizingRoarValues: container.Array<float>;
    // WOS67 keeps Prowl's source-owned stealth self-buff separate from CC
    // motion rows: its identity affects idle detection as well as movement.
    pub var entityProwlRemaining: container.Array<float>;
    pub var entityProwlValues: container.Array<float>;
    // WOS62 projects the source's one mutually-exclusive player weapon imbue.
    // Store its application-time rank, rather than recomputing from a later
    // level-up, because Aura value/value2/value3 are captured on application.
    pub var entityImbueAbilityCodes: container.Array<uint>;
    pub var entityImbueRanks: container.Array<uint>;
    pub var entityImbueRemaining: container.Array<float>;
    // WOS40 preserves one source form aura plus the mana ceiling parked while
    // Bear or Cat owns the visible rage/energy resource bar.
    pub var entityActiveFormAbilityCodes: container.Array<uint>;
    pub var entitySavedManaMaximums: container.Array<int>;
    // WOS41 stores the source-pinned M5 pre-form profile. Zero retains an
    // older/future profile whose full contribution graph is not yet available.
    pub var entityBaselineStatProfileCodes: container.Array<uint>;
    // WOS42 gives the retained source spell-haste contribution an authoritative
    // final-column owner alongside the existing melee and ranged haste rows.
    pub var entitySpellHaste: container.Array<float>;
    // WOS43 owns the bounded M5 equipment identities for the catalog's helmet,
    // feet and mainhand slots. Zero is empty/start-mainhand; nonzero is the
    // pinned M5 content item index plus one.
    pub var entityM5HelmetItemCodes: container.Array<uint>;
    pub var entityM5FeetItemCodes: container.Array<uint>;
    pub var entityM5MainhandItemCodes: container.Array<uint>;
    // WOS44 keeps the source's dense PlayerMeta.inventory order as a flattened
    // partition. Item codes are pinned M5 catalog indexes plus one; bags are
    // four fixed sockets that increase the pooled slot budget.
    pub var entityInventoryCopper: container.Array<int>;
    pub var entityInventoryBagCodes: container.Array<uint>;
    pub var entityInventoryStackOffsets: container.Array<uint>;
    pub var entityInventoryStackItemCodes: container.Array<uint>;
    pub var entityInventoryStackCounts: container.Array<int>;
    // WOS47 preserves PlayerMeta.vendorBuyback as a dense, newest-first
    // scalar partition. Each code is an M5 catalog item code plus one.
    pub var entityVendorBuybackOffsets: container.Array<uint>;
    pub var entityVendorBuybackItemCodes: container.Array<uint>;
    pub var entityVendorBuybackCounts: container.Array<int>;
    pub var entityLootable: container.Array<bool>;
    // WOS51 keeps the MVP's source-personal quest slot on the corpse. Zero means
    // no retained quest item and must therefore have a zero count.
    pub var entityCorpseQuestItemCodes: container.Array<uint>;
    pub var entityCorpseQuestItemCounts: container.Array<uint>;
    // WOS52 adds source-visible currency plus six ordered shared item slots.
    // The M5 table has no more than six entries, while personal quest drops stay
    // isolated so their capacity result cannot be consumed by shared loot.
    pub var entityCorpseCopper: container.Array<int>;
    pub var entityCorpseSharedItemCodes: container.Array<uint>;
    pub var entityCorpseSharedItemCounts: container.Array<uint>;
    // WOS18 retains source-visible weapon presentation state per entity.
    pub var entityWeaponStowed: container.Array<bool>;
    // WOS31 retains the source sit/rest posture alongside the existing AI and weapon columns.
    pub var entitySitting: container.Array<bool>;
    pub var entityAiStates: container.Array<uint>;
    pub var entityTargetIds: container.Array<uint>;
    pub var entityAutoAttack: container.Array<bool>;
    // WOS55 persists source queued-on-swing state as primitive columns so the
    // direct auto bridge can bill it on the next mainhand swing.
    pub var entityQueuedOnSwingAbilityCodes: container.Array<uint>;
    pub var entityQueuedOnSwingFree: container.Array<bool>;
    pub var entityQueuedOnSwingCostMultipliers: container.Array<float>;
    // WOS22 owns the scalar initial combat loadout. Keeping this byte-level
    // projection beside the state codec avoids a mutable object crossing the
    // still-unreliable Plugins08 array/class ABI.
    pub var entityWeaponMinimum: container.Array<int>;
    pub var entityWeaponMaximum: container.Array<int>;
    pub var entityWeaponSpeed: container.Array<float>;
    pub var entityOffhandWeaponMinimum: container.Array<int>;
    pub var entityOffhandWeaponMaximum: container.Array<int>;
    pub var entityOffhandWeaponSpeed: container.Array<float>;
    pub var entityHasOffhandWeapon: container.Array<bool>;
    pub var entityDualWielding: container.Array<bool>;
    pub var entityAttackPower: container.Array<int>;
    pub var entityRangedPower: container.Array<int>;
    pub var entitySpellPower: container.Array<int>;
    pub var entityArmor: container.Array<int>;
    pub var entityCritChance: container.Array<float>;
    pub var entityDodgeChance: container.Array<float>;
    pub var entityHitBonus: container.Array<float>;
    pub var entityCritDamagePhysicalBonus: container.Array<float>;
    pub var entityMeleeHaste: container.Array<float>;
    pub var entityRangedHaste: container.Array<float>;
    pub var entitySwingTimer: container.Array<float>;
    pub var entityOffhandSwingTimer: container.Array<float>;
    pub var entityBlockChance: container.Array<float>;
    pub var entityBlockValue: container.Array<int>;
    // WOS23 preserves the source constructor's initial idle-wander countdown.
    pub var entityWanderTimers: container.Array<float>;
    // WOS50 carries source-null wander targets explicitly. It applies only to
    // the current offline idle-mob slice; all entity kinds retain the columns
    // so snapshot rows stay parallel and future mob AI can reuse the boundary.
    pub var entityWanderTargetPresent: container.Array<bool>;
    pub var entityWanderTargetX: container.Array<float>;
    pub var entityWanderTargetZ: container.Array<float>;
    // WOS24 retains source combat-state baselines without executing the mob
    // locomotion or combat reducer that mutates them.
    pub var entityInCombat: container.Array<bool>;
    pub var entityCombatTimers: container.Array<float>;
    // Zero is the source-null representation for aggroTargetId.
    pub var entityAggroTargetIds: container.Array<uint>;
    // WOS25 retains the mob recovery inputs used by flee and evade branches.
    // Null leash anchors remain a flag plus canonical zero coordinates.
    pub var entityLeashAnchorPresent: container.Array<bool>;
    pub var entityLeashAnchorX: container.Array<float>;
    pub var entityLeashAnchorY: container.Array<float>;
    pub var entityLeashAnchorZ: container.Array<float>;
    pub var entityEvadeStalls: container.Array<float>;
    pub var entityFleeTimers: container.Array<float>;
    pub var entityFleeReturnTimers: container.Array<float>;
    pub var entityHasFled: container.Array<bool>;
    // WOS26 stores taunt and special-target selection inputs without running
    // their source reducer.
    pub var entityForcedTargetIds: container.Array<uint>;
    pub var entityForcedTargetTimers: container.Array<float>;
    pub var entityShuffleTargetTimers: container.Array<float>;
    // WOS27 retains player combat resource timers without advancing them.
    pub var entityFiveSecondRules: container.Array<float>;
    pub var entityComboPoints: container.Array<int>;
    pub var entityComboUntil: container.Array<float>;
    pub var entityOverpowerUntil: container.Array<float>;
    pub var entityPotionCooldownUntil: container.Array<float>;
    pub var entityPotionCooldownRemaining: container.Array<float>;
    // WOS69 stores the two independent source consuming slots. Item code zero
    // is the nullable marker; per-tick values are fixed at item use time.
    pub var entityEatingItemCodes: container.Array<uint>;
    pub var entityEatingHpPerTwoSeconds: container.Array<int>;
    pub var entityEatingRemaining: container.Array<float>;
    pub var entityDrinkingItemCodes: container.Array<uint>;
    pub var entityDrinkingManaPerTwoSeconds: container.Array<int>;
    pub var entityDrinkingRemaining: container.Array<float>;
    pub var entitySavedMana: container.Array<int>;
    // WOS28 retains cast aim and charge/follow targets as scalar snapshots.
    // chargePath execution remains owned by the ZrVM runtime backend.
    pub var entityCastAimPresent: container.Array<bool>;
    pub var entityCastAimX: container.Array<float>;
    pub var entityCastAimY: container.Array<float>;
    pub var entityCastAimZ: container.Array<float>;
    pub var entityQueuedCastAimPresent: container.Array<bool>;
    pub var entityQueuedCastAimX: container.Array<float>;
