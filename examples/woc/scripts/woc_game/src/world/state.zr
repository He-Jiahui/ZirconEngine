    state.entityLevels[0] = 5;
    var optionCode = talentSelectionCatalog.optionCode(
        "warrior", 5, "war_row_double_charge"
    );
    var mageOptionCode = talentSelectionCatalog.optionCode(
        "mage", 5, "mag_r5_ice_floes"
    );
