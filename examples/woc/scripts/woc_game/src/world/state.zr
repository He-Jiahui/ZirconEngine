        <int>state.entityResources[casterIndex] < cost) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        ghostWolfCastSeconds(state, casterIndex, abilityIndex),
        ghostWolfGlobalCooldownSeconds(state, casterIndex),
        false
    );
