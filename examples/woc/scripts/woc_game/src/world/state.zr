        <uint>state.entityCastingAbility[0] != <uint>0 ||
        <uint>state.entityCastTargetIds[0] != <uint>0 ||
        <int>state.entityHp[1] != 100 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileSourceIds[0] != playerId ||
        <uint>state.offlineProjectileTargetIds[0] != targetId ||
        <bool>state.offlineProjectileWands[0] ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_FIRE ||
        <float>state.offlineProjectileMinimums[0] != 16.0 ||
        <float>state.offlineProjectileMaximums[0] != 25.0 ||
        <float>state.offlineProjectileSpeeds[0] != projectileTravel.projectileSpeed() ||
        <uint>state.offlineProjectileAbilityCodes[0] != fireball ||
        <uint>state.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>state.offlineProjectileCastTimes[0], 1.5) ||
        state.offlineDotTargetIds.length != 0) {
        return -4;
    }

    var restored = decodeState(encodeState(state));
    if (<int>restored.entityHp[1] != 100 || <uint>restored.rngDraws != <uint>0 ||
        restored.offlineProjectileSourceIds.length != 1 ||
        <uint>restored.offlineProjectileAbilityCodes[0] != fireball ||
        <uint>restored.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>restored.offlineProjectileCastTimes[0], 1.5) ||
        restored.offlineDotTargetIds.length != 0) {
        return -5;
    }

    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>3 || <int>restored.entityHp[1] >= 100 ||
        restored.offlineDotTargetIds.length != 1 ||
        <uint>restored.offlineDotTargetIds[0] != targetId ||
        <uint>restored.offlineDotSourceIds[0] != playerId ||
        <uint>restored.offlineDotAbilityCodes[0] != fireball ||
        <int>restored.offlineDotDamages[0] != 1 ||
        !floatMatches(<float>restored.offlineDotRemaining[0], 4.0) ||
        !floatMatches(<float>restored.offlineDotDurations[0], 4.0) ||
        !floatMatches(<float>restored.offlineDotTickIntervals[0], 2.0) ||
        !floatMatches(<float>restored.offlineDotTickTimers[0], 2.0) ||
        stateThreatValue(restored, 1, playerId) <= 0.0) {
        return -6;
    }

    var hpAfterImpact = <int>restored.entityHp[1];
    var dotTicks = 0;
    while (restored.offlineDotTargetIds.length > 0 && dotTicks < 80) {
        stepOfflineEastbrookDots(restored);
        dotTicks = dotTicks + 1;
    }
    if (restored.offlineDotTargetIds.length != 0 || dotTicks != 80 ||
        <int>restored.entityHp[1] != hpAfterImpact - 2 ||
        <uint>restored.rngDraws != <uint>3) {
        return -7;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 30;
    var fireballBytes = new container.Array<uint>();
    fireballBytes.add(<uint>102);
    fireballBytes.add(<uint>105);
    fireballBytes.add(<uint>114);
    fireballBytes.add(<uint>101);
    fireballBytes.add(<uint>98);
    fireballBytes.add(<uint>97);
    fireballBytes.add(<uint>108);
    fireballBytes.add(<uint>108);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, fireballBytes, targetId
    );
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 30 &&
        <uint>restored.entityCastingAbility[0] == fireball &&
        <uint>restored.entityCastTargetIds[0] == targetId &&
        floatMatches(<float>restored.entityCastRemaining[0], 1.5) &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -8;
}

