appendSaveLoadoutCommandForTest(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    nameBytes: container.Array<uint>,
    allocationPresent: bool,
    specCode: uint,
    rowCodes: container.Array<uint>,
    barCodes: container.Array<uint>
): void {
    if (nameBytes.length > 96 || rowCodes.length != 6 || barCodes.length > 22) {
        throw "woc test save loadout payload is invalid";
    }
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.saveLoadoutCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    var payloadOffset = <uint>batch.commandPayloadBytes.length;
    batch.commandPayloadOffsets.add(payloadOffset);
    var nameLength = <uint>nameBytes.length;
    batch.commandPayloadBytes.add(nameLength & <uint>255);
    batch.commandPayloadBytes.add((nameLength >> 8) & <uint>255);
    batch.commandPayloadBytes.add((nameLength >> 16) & <uint>255);
    batch.commandPayloadBytes.add((nameLength >> 24) & <uint>255);
    for (var nameByte in nameBytes) {
        batch.commandPayloadBytes.add(<uint>nameByte);
    }
    batch.commandPayloadBytes.add(allocationPresent ? <uint>1 : <uint>0);
    if (allocationPresent) {
        batch.commandPayloadBytes.add(specCode & <uint>255);
        batch.commandPayloadBytes.add((specCode >> 8) & <uint>255);
        for (var rowCode in rowCodes) {
            var code = <uint>rowCode;
            batch.commandPayloadBytes.add(code & <uint>255);
            batch.commandPayloadBytes.add((code >> 8) & <uint>255);
        }
    }
    batch.commandPayloadBytes.add(<uint>barCodes.length);
    for (var barCode in barCodes) {
        var abilityCode = <uint>barCode;
        if (abilityCode == <uint>0) {
            batch.commandPayloadBytes.add(<uint>0);
        } else {
            var abilityIndex = m4AbilityCatalog.indexOf(
                knownAbilityCatalog.abilityId(<int>abilityCode)
            );
            if (abilityIndex < 0) {
                throw "woc test save loadout ability code is invalid";
            }
            batch.commandPayloadBytes.add(<uint>1);
            var abilityLength = <uint>m4AbilityCatalog.idUtf8Length(abilityIndex);
            batch.commandPayloadBytes.add(abilityLength & <uint>255);
            batch.commandPayloadBytes.add((abilityLength >> 8) & <uint>255);
            batch.commandPayloadBytes.add((abilityLength >> 16) & <uint>255);
            batch.commandPayloadBytes.add((abilityLength >> 24) & <uint>255);
            for (var byteIndex = 0; byteIndex < <int>abilityLength; byteIndex = byteIndex + 1) {
                batch.commandPayloadBytes.add(
                    m4AbilityCatalog.idUtf8Byte(abilityIndex, byteIndex)
                );
            }
        }
    }
    batch.commandPayloadLengths.add(
        <uint>batch.commandPayloadBytes.length - payloadOffset
    );
}

