    var state = new WorldState();
    applyOfflineBootstrap(state, bootstrap);
    var playerId = <uint>state.entityIds[0];
    var payloads = %import("protocol/command_payloads");

    state.entityDead[0] = true;
    state.entityHp[0] = 0;
    state.entityX[0] = -15.0;
    state.entityY[0] = 0.0;
    state.entityZ[0] = -14.0;
    var release = new CommandBatch();
    appendEmptyCommand(release, payloads.releaseCommandId(true), playerId, <uint>1, <uint>1);
    state.applyCommands(release, 1);
    if (!<bool>state.entityDead[0] || !<bool>state.entityGhost[0] ||
        !<bool>state.entityCorpsePresent[0] || <float>state.entityCorpseX[0] != -15.0 ||
        <float>state.entityCorpseZ[0] != -14.0 || <float>state.entityX[0] != -14.0 ||
        <float>state.entityZ[0] != -14.0 || <int>state.entityHp[0] != 54 ||
        <uint>state.entityLastCommandSequence[0] != <uint>1) {
        return -1;
    }
    var releasedRoundTrip = decodeState(encodeState(state));
    if (!<bool>releasedRoundTrip.entityGhost[0] ||
        !<bool>releasedRoundTrip.entityCorpsePresent[0] ||
        <float>releasedRoundTrip.entityCorpseX[0] != -15.0 ||
        <float>releasedRoundTrip.entityX[0] != -14.0) {
        return -2;
    }

    var resurrectCorpse = new CommandBatch();
    appendEmptyCommand(
        resurrectCorpse, payloads.resurrectCorpseCommandId(true), playerId, <uint>1, <uint>2
    );
    state.applyCommands(resurrectCorpse, 1);
    if (<bool>state.entityDead[0] || <bool>state.entityGhost[0] ||
        <bool>state.entityCorpsePresent[0] || <int>state.entityHp[0] != 27 ||
        <uint>state.entityLastCommandSequence[0] != <uint>2) {
        return -3;
    }

    state.entityLevels[0] = 10;
    state.entityDead[0] = true;
    state.entityHp[0] = 0;
    state.entityX[0] = -14.0;
    state.entityY[0] = 0.0;
    state.entityZ[0] = -14.0;
    var releaseAgain = new CommandBatch();
    appendEmptyCommand(
        releaseAgain, payloads.releaseCommandId(true), playerId, <uint>1, <uint>3
    );
    state.applyCommands(releaseAgain, 1);
    var resurrectHealer = new CommandBatch();
    appendEmptyCommand(
        resurrectHealer, payloads.resurrectHealerCommandId(true), playerId, <uint>1, <uint>4
    );
    state.applyCommands(resurrectHealer, 1);
    if (<bool>state.entityDead[0] || <bool>state.entityGhost[0] ||
        <bool>state.entityCorpsePresent[0] || <int>state.entityHp[0] != 11 ||
        <uint>state.entityResurrectionSicknessMicros[0] != <uint>60000000 ||
        <uint>state.entityLastCommandSequence[0] != <uint>4) {
        return -4;
    }
    tickResurrectionSickness(state);
    if (<uint>state.entityResurrectionSicknessMicros[0] != <uint>59950000) {
        return -5;
    }
    return 1;
}

