// WOS84 keeps source instant DoTs in the projectile lifecycle: admission pays
// cost/GCD, impact rolls resistance once, then a pure periodic row owns damage.
pub instantDotCommandStateTest(): int {
    if (numericEffects.contractTest() != 1) { return -1; }
    var serpent = serpentStingAbilityCode();
    var shadowPain = shadowWordPainAbilityCode();
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (serpent == <uint>0 || shadowPain == <uint>0 || forestWolf == <uint>0 ||
        m4AbilityCatalog.indexOf("serpent_sting") != 23 ||
        m4AbilityCatalog.indexOf("shadow_word_pain") != 24) {
        return -2;
    }

    var serpentState = new WorldState();
    serpentState.offlineSessionActive = true;
    serpentState.offlinePlayerClass = <uint>4;
    var hunterId = serpentState.spawnPlayer(<uint>4, 4, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var serpentTargetId = serpentState.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 1000, 8.0);
    serpentState.entityPresentationScales[1] = 0.9;
    serpentState.entityWeaponSpeed[1] = 2.0;
    serpentState.entityResources[0] = 15;
    serpentState.entityMaxResources[0] = 15;
    serpentState.entityRangedPower[0] = 300;
    serpentState.entityHitBonus[0] = 1.0;
    serpentState.entityTargetIds[0] = serpentTargetId;
    serpentState.entityKnownAbilityCodes.add(serpent);
    var knownOffset = 1;
    while (knownOffset < serpentState.entityKnownAbilityOffsets.length) {
        serpentState.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }
    var serpentSlot = new CommandBatch();
    appendCastSlotCommand(serpentSlot, hunterId, <uint>1, <uint>1, <uint>0);
    serpentState.applyCommands(serpentSlot, 1);
    if (<int>serpentState.entityResources[0] != 0 ||
        !floatMatches(<float>serpentState.entityCastGcdRemaining[0], 1.5) ||
        serpentState.offlineProjectileSourceIds.length != 1 ||
        <uint>serpentState.offlineProjectileAbilityCodes[0] != serpent ||
        <uint>serpentState.offlineProjectileRanks[0] != <uint>1 ||
        <uint>serpentState.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_NATURE ||
        <float>serpentState.offlineProjectileMinimums[0] != 0.0 ||
        <float>serpentState.offlineProjectileMaximums[0] != 0.0 ||
        serpentState.offlineDotTargetIds.length != 0 || <uint>serpentState.rngDraws != <uint>0) {
        return -3;
    }

    var restoredSerpent = decodeState(encodeState(serpentState));
    if (restoredSerpent.offlineProjectileSourceIds.length != 1 ||
        <uint>restoredSerpent.offlineProjectileAbilityCodes[0] != serpent ||
        restoredSerpent.offlineDotRanks.length != 0) {
        return -4;
    }
    var serpentFlightTicks = 0;
    while (restoredSerpent.offlineProjectileSourceIds.length > 0 && serpentFlightTicks < 8) {
        stepOfflineEastbrookProjectiles(restoredSerpent);
        serpentFlightTicks = serpentFlightTicks + 1;
    }
    if (restoredSerpent.offlineProjectileSourceIds.length != 0 || serpentFlightTicks > 8 ||
        <uint>restoredSerpent.rngDraws != <uint>1 || <int>restoredSerpent.entityHp[1] != 1000 ||
        restoredSerpent.offlineDotTargetIds.length != 1 ||
        <uint>restoredSerpent.offlineDotAbilityCodes[0] != serpent ||
        <uint>restoredSerpent.offlineDotRanks[0] != <uint>1 ||
        <int>restoredSerpent.offlineDotSnapshotPowers[0] != 300 ||
        <int>restoredSerpent.offlineDotDamages[0] != 13 ||
        !floatMatches(<float>restoredSerpent.offlineDotDurations[0], 15.0) ||
        !floatMatches(<float>restoredSerpent.offlineDotTickIntervals[0], 3.0)) {
        return -5;
    }
    var serpentTicks = 0;
    while (restoredSerpent.offlineDotTargetIds.length > 0 && serpentTicks < 300) {
        stepOfflineEastbrookDots(restoredSerpent);
        serpentTicks = serpentTicks + 1;
    }
    if (restoredSerpent.offlineDotTargetIds.length != 0 || serpentTicks != 300 ||
        <int>restoredSerpent.entityHp[1] != 935 || <uint>restoredSerpent.rngDraws != <uint>1) {
        return -6;
    }

    restoredSerpent.entityCastGcdRemaining[0] = 0.0;
    restoredSerpent.entityResources[0] = 15;
    var serpentBytes = new container.Array<uint>();
    serpentBytes.add(<uint>115); serpentBytes.add(<uint>101); serpentBytes.add(<uint>114);
    serpentBytes.add(<uint>112); serpentBytes.add(<uint>101); serpentBytes.add(<uint>110);
    serpentBytes.add(<uint>116); serpentBytes.add(<uint>95); serpentBytes.add(<uint>115);
    serpentBytes.add(<uint>116); serpentBytes.add(<uint>105); serpentBytes.add(<uint>110);
    serpentBytes.add(<uint>103);
    var serpentTyped = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        serpentTyped, hunterId, <uint>1, <uint>2, serpentBytes, serpentTargetId
    );
    restoredSerpent.applyCommands(serpentTyped, 1);
    if (<int>restoredSerpent.entityResources[0] != 0 ||
        restoredSerpent.offlineProjectileSourceIds.length != 1 ||
        <uint>restoredSerpent.entityLastCommandSequence[0] != <uint>2) {
        return -7;
    }
    restoredSerpent.entityCastGcdRemaining[0] = 0.0;
    restoredSerpent.entityResources[0] = 15;
    restoredSerpent.entityZ[1] = 4.0;
    startOfflineSerpentStingCast(restoredSerpent, 0, serpentTargetId);
    if (<int>restoredSerpent.entityResources[0] != 15 ||
        restoredSerpent.offlineProjectileSourceIds.length != 1) {
        return -8;
    }
    restoredSerpent.entitySpellHaste[0] = 2.0;
    if (!floatMatches(pureDotGlobalCooldownSeconds(restoredSerpent, 0), 0.75)) { return -9; }

    var shadowState = new WorldState();
    shadowState.offlineSessionActive = true;
    shadowState.offlinePlayerClass = <uint>5;
    var priestId = shadowState.spawnPlayer(<uint>5, 4, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var shadowTargetId = shadowState.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 1000, 8.0);
    shadowState.entityPresentationScales[1] = 0.9;
    shadowState.entityWeaponSpeed[1] = 2.0;
    shadowState.entityResources[0] = 25;
    shadowState.entityMaxResources[0] = 25;
    shadowState.entitySpellPower[0] = 150;
    shadowState.entityHitBonus[0] = 1.0;
    shadowState.entityTargetIds[0] = shadowTargetId;
    shadowState.entityKnownAbilityCodes.add(shadowPain);
    knownOffset = 1;
    while (knownOffset < shadowState.entityKnownAbilityOffsets.length) {
        shadowState.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }
    var shadowSlot = new CommandBatch();
    appendCastSlotCommand(shadowSlot, priestId, <uint>1, <uint>1, <uint>0);
    shadowState.applyCommands(shadowSlot, 1);
    if (<int>shadowState.entityResources[0] != 0 ||
        !floatMatches(<float>shadowState.entityCastGcdRemaining[0], 1.5) ||
        shadowState.offlineProjectileSourceIds.length != 1 ||
        <uint>shadowState.offlineProjectileAbilityCodes[0] != shadowPain ||
        <uint>shadowState.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_SHADOW) {
        return -10;
    }
    var shadowFlightTicks = 0;
    while (shadowState.offlineProjectileSourceIds.length > 0 && shadowFlightTicks < 8) {
        stepOfflineEastbrookProjectiles(shadowState);
        shadowFlightTicks = shadowFlightTicks + 1;
    }
    if (shadowState.offlineProjectileSourceIds.length != 0 || shadowFlightTicks > 8 ||
        <uint>shadowState.rngDraws != <uint>1 || <int>shadowState.entityHp[1] != 1000 ||
        shadowState.offlineDotTargetIds.length != 1 ||
        <uint>shadowState.offlineDotAbilityCodes[0] != shadowPain ||
        <uint>shadowState.offlineDotRanks[0] != <uint>1 ||
        <int>shadowState.offlineDotSnapshotPowers[0] != 150 ||
        <int>shadowState.offlineDotDamages[0] != 35 ||
        !floatMatches(<float>shadowState.offlineDotDurations[0], 18.0) ||
        !floatMatches(<float>shadowState.offlineDotTickIntervals[0], 3.0)) {
        return -11;
    }
    var shadowTicks = 0;
    while (shadowState.offlineDotTargetIds.length > 0 && shadowTicks < 360) {
        stepOfflineEastbrookDots(shadowState);
        shadowTicks = shadowTicks + 1;
    }
    return shadowState.offlineDotTargetIds.length == 0 && shadowTicks == 360 &&
        <int>shadowState.entityHp[1] == 790 && <uint>shadowState.rngDraws == <uint>1 ? 1 : -12;
}

pub lesserHealCommandStateTest(): int {
