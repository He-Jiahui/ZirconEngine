        <bool>state.entityInCombat[0] || <bool>state.entityInCombat[1]) { return -2; }

    var restored = decodeState(encodeState(state));
    if (restored.offlineHunterTrapSourceIds.length != 1 ||
        <uint>restored.offlineHunterTrapAbilityCodes[0] != frostTrap ||
        !floatMatches(<float>restored.offlineHunterTrapArmRemaining[0], 1.5) ||
        !floatMatches(<float>restored.offlineHunterTrapRemaining[0], 60.0)) {
        return -3;
    }

    // A crossing during arming cannot trigger. The final arming tick also
    // cannot trigger; the next tick observes the armed source rider.
    restored.entityPreviousZ[1] = 4.0;
    restored.entityZ[1] = 0.0;
    stepOfflineHunterTraps(restored);
    if (restored.offlineHunterTrapSourceIds.length != 1 ||
        !floatMatches(<float>restored.offlineHunterTrapArmRemaining[0], 1.45) ||
        restored.entityMotionAuraAbilityCodes.length != 0) { return -4; }
    restored.offlineHunterTrapArmRemaining[0] = 0.05;
    stepOfflineHunterTraps(restored);
    if (restored.offlineHunterTrapSourceIds.length != 1 ||
        !floatMatches(<float>restored.offlineHunterTrapArmRemaining[0], 0.0) ||
        restored.entityMotionAuraAbilityCodes.length != 0) { return -5; }
    stepOfflineHunterTraps(restored);
    if (restored.offlineHunterTrapSourceIds.length != 0 ||
        restored.entityMotionAuraOffsets[2] != <uint>1 ||
        <uint>restored.entityMotionAuraAbilityCodes[0] != frostTrap ||
        <uint>restored.entityMotionAuraSourceIds[0] != playerId ||
        <uint>restored.entityMotionAuraKindCodes[0] != ccContract.motionAuraKindCode("stun") ||
        <uint>restored.entityMotionAuraSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_FROST ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 3.0) ||
        !<bool>restored.entityInCombat[0] || !<bool>restored.entityInCombat[1] ||
        <uint>restored.entityAggroTargetIds[1] != playerId || restored.rngDraws != <uint>0) {
        return -6;
    }

    // Replacement is owner-scoped and leaves only the new foot position.
    restored.timeMicros = <uint>30000000;
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 35.0;
    restored.entityX[0] = 2.0;
    startOfflineFrostTrapCast(restored, 0);
    if (restored.offlineHunterTrapSourceIds.length != 1 ||
        !floatMatches(<float>restored.offlineHunterTrapX[0], 2.0) ||
        abilityCooldownExpiresAt(restored, 0, frostTrap) != <uint>60000000) {
        return -7;
    }
    restored.offlineHunterTrapRemaining[0] = 0.05;
    stepOfflineHunterTraps(restored);
    if (restored.offlineHunterTrapSourceIds.length != 0 || restored.rngDraws != <uint>0) {
        return -8;
    }

    // Replacement is admitted at global rider capacity when the casting owner
    // already occupies a row. Only that owner is removed before the fresh row
    // is appended; all other source rows remain intact.
    var full = new WorldState();
    full.offlineSessionActive = true;
    full.offlinePlayerClass = <uint>hunter;
    var fullPlayerId = full.spawnPlayer(<uint>(hunter + 1), 10, 3.0, 1.5, 0.0, 100, 7.0, 1);
    full.entityResources[0] = 35.0;
    full.entityMaxResources[0] = 35.0;
    full.entityKnownAbilityCodes.add(frostTrap);
    offset = 1;
    while (offset < full.entityKnownAbilityOffsets.length) {
        full.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    var fullIndex = 0;
    while (fullIndex < <int>OFFLINE_DOT_PENDING_MAX) {
        full.offlineHunterTrapSourceIds.add(
            fullIndex == 0 ? fullPlayerId : <uint>(1000 + fullIndex)
        );
        full.offlineHunterTrapAbilityCodes.add(frostTrap);
        full.offlineHunterTrapX.add(<float>fullIndex);
        full.offlineHunterTrapZ.add(0.0);
        full.offlineHunterTrapRadii.add(3.0);
        full.offlineHunterTrapRemaining.add(60.0);
        full.offlineHunterTrapArmRemaining.add(1.5);
        full.offlineHunterTrapFreezeDurations.add(3.0);
        fullIndex = fullIndex + 1;
    }
    startOfflineFrostTrapCast(full, 0);
    if (full.offlineHunterTrapSourceIds.length != <int>OFFLINE_DOT_PENDING_MAX) {
        return -12;
    }
    var preservedIndex = 0;
    while (preservedIndex < <int>OFFLINE_DOT_PENDING_MAX - 1) {
        if (<uint>full.offlineHunterTrapSourceIds[preservedIndex] !=
            <uint>(1001 + preservedIndex)) { return -12; }
        preservedIndex = preservedIndex + 1;
    }
    if (
        <uint>full.offlineHunterTrapSourceIds[63] != fullPlayerId ||
        !floatMatches(<float>full.offlineHunterTrapX[63], 3.0) ||
        !floatMatches(<float>full.entityResources[0], 0.0) ||
        !floatMatches(<float>full.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(full, 0, frostTrap) != <uint>30000000 ||
        full.rngDraws != <uint>0) { return -12; }

    restored.timeMicros = <uint>60000000;
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 35.0;
    var bytes = new container.Array<uint>();
    bytes.add(<uint>102); bytes.add(<uint>114); bytes.add(<uint>111); bytes.add(<uint>115);
    bytes.add(<uint>116); bytes.add(<uint>95); bytes.add(<uint>116); bytes.add(<uint>114);
    bytes.add(<uint>97); bytes.add(<uint>112);
    var typed = new CommandBatch();
    appendTypedCastCommandForTest(typed, playerId, <uint>1, <uint>2, bytes);
    restored.applyCommands(typed, 1);
    if (restored.offlineHunterTrapSourceIds.length != 1 ||
        abilityCooldownExpiresAt(restored, 0, frostTrap) != <uint>90000000 ||
        <uint>restored.entityLastCommandSequence[0] != <uint>2 ||
        restored.rngDraws != <uint>0) { return -9; }

    var rejected = new WorldState();
    rejected.offlineSessionActive = true;
    rejected.offlinePlayerClass = <uint>hunter;
    var rejectedId = rejected.spawnPlayer(
        <uint>(hunter + 1), 9, 0.0, 1.5, 0.0, 100, 7.0, 1
    );
    rejected.entityResources[0] = 35.0;
    rejected.entityMaxResources[0] = 35.0;
    rejected.entityKnownAbilityCodes.add(frostTrap);
    offset = 1;
    while (offset < rejected.entityKnownAbilityOffsets.length) {
        rejected.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    startOfflineFrostTrapCast(rejected, 0);
    rejected.entityLevels[0] = 10;
    rejected.offlinePlayerClass = <uint>warrior;
    startOfflineFrostTrapCast(rejected, 0);
    return rejectedId != <uint>0 &&
        floatMatches(<float>rejected.entityResources[0], 35.0) &&
        rejected.offlineHunterTrapSourceIds.length == 0 &&
        abilityCooldownExpiresAt(rejected, 0, frostTrap) == <uint>0 &&
        rejected.rngDraws == <uint>0 ? 1 : -10;
}

// Hemorrhage is intentionally tested through both the direct reducer and the
// typed command path because its source effect array continues after a miss.
pub hemorrhageRuntimeStateTest(): int {
    var hemorrhage = hemorrhageAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("hemorrhage");
    var rogue = knownAbilityCatalog.classIndex("rogue");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (hemorrhage == <uint>0 || abilityIndex != 106 || rogue < 0 ||
        forestWolf == <uint>0 || !hemorrhageProfileIsValid(abilityIndex, 10)) {
        return -1;
    }

    // An impossible hit bonus forces the retained weapon strike to miss. The
    // subsequent DoT and target debuff must still be present, while combo is not.
    var missed = new WorldState();
    missed.offlineSessionActive = true;
    missed.offlinePlayerClass = <uint>rogue;
    var missedPlayer = missed.spawnPlayer(<uint>(rogue + 1), 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var missedTarget = missed.spawnMob(forestWolf, 1, 0.0, 1.5, 3.0, 1000, 8.0);
    missed.entityResources[0] = 100.0;
    missed.entityMaxResources[0] = 100.0;
    missed.entityHitBonus[0] = -100.0;
    missed.entityKnownAbilityCodes.add(hemorrhage);
    var offset = 1;
    while (offset < missed.entityKnownAbilityOffsets.length) {
        missed.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    startOfflineHemorrhageCast(missed, 0, missedTarget);
    if (missedPlayer == <uint>0 || !floatMatches(<float>missed.entityResources[0], 65.0) ||
        !floatMatches(<float>missed.entityCastGcdRemaining[0], 1.5) ||
        <int>missed.entityComboPoints[0] != 0 || missed.offlineDotTargetIds.length != 1 ||
        missed.entityMotionAuraAbilityCodes.length != 1 ||
        !floatMatches(offlineBleedVulnerabilityMultiplier(missed, 1), 1.4)) { return -2; }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>rogue;
    var playerId = state.spawnPlayer(<uint>(rogue + 1), 10, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var rivalId = state.spawnPlayer(<uint>(rogue + 1), 10, 0.0, 1.5, 8.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 3.0, 1000, 8.0);
    state.entityResources[0] = 100.0;
    state.entityMaxResources[0] = 100.0;
    state.entityHitBonus[0] = 100.0;
    state.entityKnownAbilityCodes.add(hemorrhage);
    offset = 1;
    while (offset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    startOfflineHemorrhageCast(state, 0, targetId);
    if (playerId == <uint>0 || rivalId == <uint>0 ||
        !floatMatches(<float>state.entityResources[0], 65.0) ||
        <int>state.entityComboPoints[0] != 1 || state.offlineDotTargetIds.length != 1 ||
        state.entityMotionAuraAbilityCodes.length != 1 ||
        <uint>state.entityMotionAuraAbilityCodes[0] != hemorrhage ||
        <uint>state.entityMotionAuraKindCodes[0] != ccContract.motionAuraKindCode("bleed_vuln") ||
        !floatMatches(offlineBleedVulnerabilityMultiplier(state, 2), 1.4)) { return -3; }

    var restored = decodeState(encodeState(state));
    if (!offlineDotStateIsValid(restored) ||
        !floatMatches(offlineBleedVulnerabilityMultiplier(restored, 2), 1.4)) { return -4; }
    restored.offlineDotTickTimers[0] = 0.05;
    var singleHp = <int>restored.entityHp[2];
    var singleDamage = terrainGradient.javascriptRound(
        <float>restored.offlineDotDamages[0] * 1.4, true
    );
    stepOfflineEastbrookDots(restored);
    if (<int>restored.entityHp[2] != singleHp - singleDamage) { return -5; }

    applyOfflineHemorrhageBleedVulnerability(restored, 2, rivalId, 12.0, 0.4);
    if (restored.entityMotionAuraAbilityCodes.length != 2 ||
        !floatMatches(offlineBleedVulnerabilityMultiplier(restored, 2), 1.8)) { return -6; }
    restored.offlineDotTickTimers[0] = 0.05;
    var doubleHp = <int>restored.entityHp[2];
    var doubleDamage = terrainGradient.javascriptRound(
        <float>restored.offlineDotDamages[0] * 1.8, true
    );
    stepOfflineEastbrookDots(restored);
    if (<int>restored.entityHp[2] != doubleHp - doubleDamage) { return -7; }

    restored.entityMotionAuraRemaining[0] = 1.0;
    applyOfflineHemorrhageBleedVulnerability(restored, 2, playerId, 12.0, 0.4);
    if (restored.entityMotionAuraAbilityCodes.length != 2 ||
        !floatMatches(<float>restored.entityMotionAuraRemaining[0], 12.0) ||
        !floatMatches(offlineBleedVulnerabilityMultiplier(restored, 2), 1.8)) { return -8; }

    var cancelled = decodeState(encodeState(restored));
    var bytes = new container.Array<uint>();
    bytes.add(<uint>104); bytes.add(<uint>101); bytes.add(<uint>109); bytes.add(<uint>111);
    bytes.add(<uint>114); bytes.add(<uint>114); bytes.add(<uint>104); bytes.add(<uint>97);
    bytes.add(<uint>103); bytes.add(<uint>101);
    var cancel = new CommandBatch();
    appendCancelAuraCommandForTest(cancel, playerId, <uint>1, <uint>1, bytes);
    cancelled.applyCommands(cancel, 1);
    if (cancelled.entityMotionAuraAbilityCodes.length != 2 ||
        <uint>cancelled.entityLastCommandSequence[0] != <uint>1) { return -9; }

    restored.entityMotionAuraRemaining[0] = 0.05;
    restored.entityMotionAuraRemaining[1] = 0.05;
    ageMotionAurasForEntity(restored, 2);
    if (restored.entityMotionAuraAbilityCodes.length != 0 ||
        !floatMatches(offlineBleedVulnerabilityMultiplier(restored, 2), 1.0)) { return -10; }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 35.0;
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(typed, playerId, <uint>1, <uint>1, bytes, targetId);
    restored.applyCommands(typed, 1);
    return !floatMatches(<float>restored.entityResources[0], 0.0) ||
        restored.offlineDotTargetIds.length != 1 ||
        restored.entityMotionAuraAbilityCodes.length != 1 ||
        <uint>restored.entityLastCommandSequence[0] != <uint>1 ? -11 : 1;
}

pub aimedShotRuntimeStateTest(): int {
    var aimedShot = aimedShotAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("aimed_shot");
    var hunter = knownAbilityCatalog.classIndex("hunter");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (aimedShot == <uint>0 || abilityIndex != 107 || hunter < 0 ||
        forestWolf == <uint>0 || !aimedShotProfileIsValid(abilityIndex, 11)) {
        return -1;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>hunter;
    var playerId = state.spawnPlayer(<uint>(hunter + 1), 11, 0.0, 1.5, 0.0, 1000, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 11, 0.0, 1.5, 10.0, 2000, 7.0);
    state.entityResources[0] = 100.0;
    state.entityMaxResources[0] = 100.0;
    state.entityRangedPower[0] = 400;
    state.entityCritChance[0] = 0.0;
    state.entityArmor[1] = 0;
    state.entityKnownAbilityCodes.add(aimedShot);
    var offset = 1;
    while (offset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.entityTargetIds[0] = targetId;
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || !floatMatches(<float>state.entityResources[0], 100.0) ||
        !floatMatches(<float>state.entityCastRemaining[0], 3.0) ||
        !floatMatches(<float>state.entityCastTotal[0], 3.0) ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        <uint>state.entityCastTargetIds[0] != targetId ||
        abilityCooldownExpiresAt(state, 0, aimedShot) != <uint>0 ||
        state.offlineProjectileSourceIds.length != 0 || state.rngDraws != <uint>0) {
        return -2;
    }

    completeOfflineAimedShotCast(state, 0);
    if (!floatMatches(<float>state.entityResources[0], 50.0) ||
        abilityCooldownExpiresAt(state, 0, aimedShot) != <uint>6000000 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileAbilityCodes[0] != aimedShot ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_PHYSICAL ||
        !floatMatches(<float>state.offlineProjectileMinimums[0], 50.0) ||
        !floatMatches(<float>state.offlineProjectileMaximums[0], 62.0) ||
        !floatMatches(<float>state.offlineProjectileCastTimes[0], 3.0) ||
        !offlineProjectileStateIsValid(state) || state.rngDraws != <uint>0) {
        return -3;
    }

    var baseline = decodeState(encodeState(state));
    var armored = decodeState(encodeState(state));
    armored.entityArmor[1] = 500;
    var baselineHp = <int>baseline.entityHp[1];
    var armoredHp = <int>armored.entityHp[1];
    var baselineDraws = baseline.rngDraws;
    landOfflineAimedShotProjectile(baseline, 0, 0, 1);
    landOfflineAimedShotProjectile(armored, 0, 0, 1);
    var baselineDamage = baselineHp - <int>baseline.entityHp[1];
    var armoredDamage = armoredHp - <int>armored.entityHp[1];
    if (baselineDamage < 101 || baselineDamage > 113 || armoredDamage <= 0 ||
        armoredDamage >= baselineDamage || baseline.rngDraws != baselineDraws + <uint>2 ||
        armored.rngDraws != baselineDraws + <uint>2) {
        return -4;
    }

    var critical = decodeState(encodeState(state));
    applyOfflineMotionAuraWithDetails(
        critical, 0, coldBloodAbilityCode(), playerId,
        ccContract.motionAuraKindCode("next_attack_crit"), 60.0, 1.0, 0.0
    );
    var criticalHp = <int>critical.entityHp[1];
    landOfflineAimedShotProjectile(critical, 0, 0, 1);
    if (critical.entityMotionAuraAbilityCodes.length != 0 ||
        criticalHp - <int>critical.entityHp[1] <= baselineDamage ||
        critical.rngDraws != baselineDraws + <uint>2) {
        return -5;
    }

    var traveled = decodeState(encodeState(state));
    var ticks = 0;
    while (traveled.offlineProjectileSourceIds.length > 0 && ticks < 80) {
        stepOfflineEastbrookProjectiles(traveled);
        ticks = ticks + 1;
    }
    if (traveled.offlineProjectileSourceIds.length != 0 || ticks <= 0 ||
        <int>traveled.entityHp[1] >= 2000 || !offlineProjectileStateIsValid(traveled)) {
        return -6;
    }

    var near = new WorldState();
    near.offlineSessionActive = true;
    near.offlinePlayerClass = <uint>hunter;
    var nearPlayer = near.spawnPlayer(<uint>(hunter + 1), 11, 0.0, 1.5, 0.0, 1000, 7.0, 1);
    var nearTarget = near.spawnMob(forestWolf, 11, 0.0, 1.5, 7.0, 1000, 7.0);
    near.entityResources[0] = 100.0;
    near.entityKnownAbilityCodes.add(aimedShot);
    offset = 1;
    while (offset < near.entityKnownAbilityOffsets.length) {
        near.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    near.entityZ[1] = 10.0;
    near.entityFacing[0] = 3.14159265;
    startOfflineAimedShotCast(near, 0, nearTarget);
    near.entityFacing[0] = 0.0;
    near.entityZ[1] = 7.0;
    startOfflineAimedShotCast(near, 0, nearTarget);
    near.entityZ[1] = 36.0;
    startOfflineAimedShotCast(near, 0, nearTarget);
    if (nearPlayer == <uint>0 || !floatMatches(<float>near.entityResources[0], 100.0) ||
        <uint>near.entityCastingAbility[0] != <uint>0 ||
        abilityCooldownExpiresAt(near, 0, aimedShot) != <uint>0) {
        return -7;
    }

    var cancelled = decodeState(encodeState(state));
    cancelled.entityCastGcdRemaining[0] = 0.0;
    cancelled.timeMicros = <uint>7000000;
    cancelled.entityResources[0] = 100.0;
    clearAbilityCooldown(cancelled, 0, aimedShot);
    startOfflineAimedShotCast(cancelled, 0, targetId);
    cancelled.entityZ[1] = 38.0;
    completeOfflineAimedShotCast(cancelled, 0);
    if (!floatMatches(<float>cancelled.entityResources[0], 100.0) ||
        abilityCooldownExpiresAt(cancelled, 0, aimedShot) != <uint>0 ||
        cancelled.offlineProjectileSourceIds.length != 1) {
        return -8;
    }

    var marksmanship = talentSelectionCatalog.specCode("hunter", "marksmanship");
    var talented = new WorldState();
    talented.offlineSessionActive = true;
    talented.offlinePlayerClass = <uint>hunter;
    var talentedPlayer = talented.spawnPlayer(
        <uint>(hunter + 1), 14, 0.0, 1.5, 0.0, 1000, 7.0, 1
    );
    var talentedTarget = talented.spawnMob(forestWolf, 11, 0.0, 1.5, 10.0, 1000, 7.0);
    talented.entityResources[0] = 100.0;
    talented.entityMaxResources[0] = 100.0;
    if (marksmanship == <uint>0 || !replaceOfflineTalentAllocation(
            talented, 0, marksmanship, <uint>0, <uint>0, <uint>0,
            <uint>47, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(talented, 0, aimedShot)) {
        return -9;
    }
    startOfflineAimedShotCast(talented, 0, talentedTarget);
    if (talentedPlayer == <uint>0 ||
        !floatMatches(<float>talented.entityCastTotal[0], 2.4)) {
        return -10;
    }
    completeOfflineAimedShotCast(talented, 0);
    if (talented.offlineProjectileSourceIds.length != 1 ||
        !floatMatches(<float>talented.offlineProjectileCastTimes[0], 2.4) ||
        !offlineProjectileStateIsValid(talented)) {
        return -11;
    }

    var typed = new WorldState();
    typed.offlineSessionActive = true;
    typed.offlinePlayerClass = <uint>hunter;
    var typedPlayer = typed.spawnPlayer(<uint>(hunter + 1), 11, 0.0, 1.5, 0.0, 1000, 7.0, 1);
    var typedTarget = typed.spawnMob(forestWolf, 11, 0.0, 1.5, 10.0, 1000, 7.0);
    typed.entityResources[0] = 100.0;
    typed.entityKnownAbilityCodes.add(aimedShot);
    offset = 1;
    while (offset < typed.entityKnownAbilityOffsets.length) {
        typed.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    var bytes = new container.Array<uint>();
    bytes.add(<uint>97); bytes.add(<uint>105); bytes.add(<uint>109); bytes.add(<uint>101);
    bytes.add(<uint>100); bytes.add(<uint>95); bytes.add(<uint>115); bytes.add(<uint>104);
    bytes.add(<uint>111); bytes.add(<uint>116);
    var typedCommand = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typedCommand, typedPlayer, <uint>1, <uint>1, bytes, typedTarget
    );
    typed.applyCommands(typedCommand, 1);
    if (typedPlayer == <uint>0 || <uint>typed.entityCastTargetIds[0] != typedTarget ||
        !floatMatches(<float>typed.entityCastTotal[0], 3.0) ||
        !floatMatches(<float>typed.entityResources[0], 100.0) ||
        <uint>typed.entityLastCommandSequence[0] != <uint>1) {
        return -12;
    }
    completeOfflineAimedShotCast(typed, 0);
    return !floatMatches(<float>typed.entityResources[0], 50.0) ||
        abilityCooldownExpiresAt(typed, 0, aimedShot) != <uint>6000000 ||
        typed.offlineProjectileSourceIds.length != 1 || typed.rngDraws != <uint>0 ? -13 : 1;
}

pub hunterAspectRuntimeStateTest(): int {
    var hawk = aspectOfTheHawkAbilityCode();
    var monkey = aspectOfTheMonkeyAbilityCode();
    var cheetah = aspectOfTheCheetahAbilityCode();
    var hawkIndex = m4AbilityCatalog.indexOf("aspect_of_the_hawk");
    var monkeyIndex = m4AbilityCatalog.indexOf("aspect_of_the_monkey");
    var cheetahIndex = m4AbilityCatalog.indexOf("aspect_of_the_cheetah");
    var hunter = knownAbilityCatalog.classIndex("hunter");
    if (hawkIndex != 101 || monkeyIndex != 102 || cheetahIndex != 103 || hunter < 0 ||
        !aspectOfTheHawkProfileIsValid(hawkIndex, <uint>1) ||
        !aspectOfTheHawkProfileIsValid(hawkIndex, <uint>2) ||
        !aspectOfTheHawkProfileIsValid(hawkIndex, <uint>3) ||
        !aspectOfTheMonkeyProfileIsValid(monkeyIndex, 5) ||
