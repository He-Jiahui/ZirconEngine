    var abilityIndex = m4AbilityCatalog.indexOf("entangling_roots");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "entangling_roots") {
        throw "Entangling Roots is absent from the current ability catalog";
    }
    return code;
}

entanglingRootsPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>16 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>103 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>110 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>103 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>11)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>12)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>13)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>14)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>15)] == <uint>115;
}

entanglingRootsRankLevel(rankCode: uint): int {
    if (rankCode == <uint>1) { return 8; }
    if (rankCode == <uint>2) { return 16; }
    return 0;
}

entanglingRootsProjectileProfileIsValid(
    rankCode: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("entangling_roots");
    var level = entanglingRootsRankLevel(rankCode);
    if (abilityIndex < 0 || level <= 0 ||
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) != <int>rankCode ||
        effects.typeAt(abilityIndex, <int>rankCode, 0) != "root" ||
        effects.metric(abilityIndex, <int>rankCode, 0, "duration") != 12.0) {
        return false;
    }
    if (rankCode == <uint>1 && effects.count(abilityIndex, 1) != 1) { return false; }
    if (rankCode == <uint>2 && (effects.count(abilityIndex, 2) != 2 ||
        effects.typeAt(abilityIndex, 2, 1) != "dot" ||
        effects.metric(abilityIndex, 2, 1, "total") != 32.0 ||
        effects.metric(abilityIndex, 2, 1, "duration") != 12.0 ||
        effects.metric(abilityIndex, 2, 1, "interval") != 3.0)) {
        return false;
    }
    return minimum == 0.0 && maximum == 0.0 &&
        castTime == m4AbilityCatalog.metric(abilityIndex, level, "castTime");
}

entanglingRootsTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("entangling_roots");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

entanglingRootsCompletionTargetIndex(
    state: WorldState, casterIndex: int, targetId: uint
): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("entangling_roots");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

entanglingRootsCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

entanglingRootsGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineEntanglingRootsCast(
    state: WorldState, casterIndex: int, targetId: uint
): void {
    var abilityCode = entanglingRootsAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("entangling_roots");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = <uint>m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (!entanglingRootsProjectileProfileIsValid(
            rank, 0.0, 0.0, m4AbilityCatalog.metric(abilityIndex, level, "castTime")
        ) || <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        entanglingRootsTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        entanglingRootsCastSeconds(state, casterIndex, abilityIndex),
        entanglingRootsGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineEntanglingRootsCast(state: WorldState, casterIndex: int): void {
    var abilityCode = entanglingRootsAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("entangling_roots");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = entanglingRootsCompletionTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = <uint>m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var castTime = m4AbilityCatalog.metric(abilityIndex, level, "castTime");
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!entanglingRootsProjectileProfileIsValid(rank, 0.0, 0.0, castTime) ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        0.0,
        0.0,
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_NATURE,
        abilityCode,
        rank,
        castTime
    );
}

