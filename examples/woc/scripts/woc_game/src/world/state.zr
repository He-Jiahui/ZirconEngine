appendRawMechChromaCommandForTest(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    chromaBytes: container.Array<uint>,
    trailing: bool
): void {
    var payloads = %import("protocol/command_payloads");
    batch.commandCount = batch.commandCount + 1;
    batch.commandIds.add(payloads.unequipMechChromaCommandId(true));
    batch.commandActorIds.add(actorId);
    batch.commandActorGenerations.add(generation);
    batch.commandSequences.add(sequence);
    batch.commandPayloadOffsets.add(<uint>batch.commandPayloadBytes.length);
    var length = <uint>chromaBytes.length;
    batch.commandPayloadLengths.add(length + <uint>4 + (trailing ? <uint>1 : <uint>0));
    batch.commandPayloadBytes.add(length & <uint>255);
    batch.commandPayloadBytes.add((length >> 8) & <uint>255);
    batch.commandPayloadBytes.add((length >> 16) & <uint>255);
    batch.commandPayloadBytes.add((length >> 24) & <uint>255);
    for (var byte in chromaBytes) {
        batch.commandPayloadBytes.add(<uint>byte);
    }
    if (trailing) { batch.commandPayloadBytes.add(<uint>0); }
}

appendMechChromaCommandForTest(
    batch: CommandBatch,
    actorId: uint,
    generation: uint,
    sequence: uint,
    chromaIndex: int
): void {
    var catalog = %import("generated/m5_content_catalog");
    if (chromaIndex < 0 || chromaIndex >= catalog.mechChromaCount()) {
        throw "woc mech chroma test index is invalid";
    }
    var chromaBytes = new container.Array<uint>();
    var byteIndex = 0;
    while (byteIndex < catalog.mechChromaIdUtf8Length(chromaIndex)) {
        chromaBytes.add(catalog.mechChromaIdUtf8Byte(chromaIndex, byteIndex));
        byteIndex = byteIndex + 1;
    }
    appendRawMechChromaCommandForTest(
        batch, actorId, generation, sequence, chromaBytes, false
    );
}

