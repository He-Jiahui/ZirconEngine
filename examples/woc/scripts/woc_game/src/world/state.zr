        !floatMatches(<float>dotted.offlineDotRemaining[0], profile.duration - 0.05) ||
        !floatMatches(<float>dotted.offlineDotTickTimers[0], profile.interval) ||
        stateThreatValue(dotted, 1, playerId) <= 0.0) {
        return -6;
    }

    dotted.entityCastGcdRemaining[0] = 0.0;
    dotted.entityResources[0] = 75;
    var corruptionBytes = new container.Array<uint>();
    corruptionBytes.add(<uint>99); corruptionBytes.add(<uint>111);
    corruptionBytes.add(<uint>114); corruptionBytes.add(<uint>114);
    corruptionBytes.add(<uint>117); corruptionBytes.add(<uint>112);
    corruptionBytes.add(<uint>116); corruptionBytes.add(<uint>105);
    corruptionBytes.add(<uint>111); corruptionBytes.add(<uint>110);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, corruptionBytes, targetId
    );
    dotted.applyCommands(typed, 1);
    return <int>dotted.entityResources[0] == 75 &&
        <uint>dotted.entityCastingAbility[0] == corruption &&
        <uint>dotted.entityCastTargetIds[0] == targetId &&
        floatMatches(<float>dotted.entityCastRemaining[0], 2.0) &&
        <uint>dotted.entityLastCommandSequence[0] == <uint>2 ? 1 : -7;
}

