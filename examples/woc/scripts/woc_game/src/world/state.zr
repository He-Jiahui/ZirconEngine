        abilityCode,
        <uint>state.entityIds[casterIndex],
        ccContract.motionAuraKindCode("buff_speed"),
        effects.metric(abilityIndex, 1, 0, "duration"),
        effects.metric(abilityIndex, 1, 0, "value"),
        0.0
    );
}

pounceTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("pounce");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return dx * dx + dz * dz <= range * range &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

startOfflinePounceCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = pounceAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("pounce");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        !offlineProwlIsActive(state, casterIndex) ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(
            state,
            casterIndex,
            abilityCode,
            forms.formKindForAbilityCode(
                <uint>state.entityActiveFormAbilityCodes[casterIndex]
            ),
            false
        )) { return; }
    var targetIndex = pounceTargetIndex(state, casterIndex, targetId);
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (targetIndex < 0 || !pounceProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost) { return; }
    var cast = loadCastingState(state, casterIndex);
    var gcd = rakeGlobalCooldownSeconds(state, casterIndex);
    if (gcd > cast.gcdRemaining) { cast.gcdRemaining = gcd; }
    storeCastingState(state, casterIndex, cast);
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
    spendOfflineAbilityResource(state, casterIndex, cost);
    clearOfflineProwl(state, casterIndex);
    var casterId = <uint>state.entityIds[casterIndex];
    state.entityInCombat[casterIndex] = true;
    state.entityCombatTimers[casterIndex] = 0.0;
    state.entityInCombat[targetIndex] = true;
    state.entityCombatTimers[targetIndex] = 0.0;
    if (<uint>state.entityAiStates[targetIndex] == mobLifecycle.idleAiState()) {
        enterIdleMobAggro(state, targetIndex, casterId);
    } else if (<uint>state.entityAggroTargetIds[targetIndex] == <uint>0) {
        state.entityAggroTargetIds[targetIndex] = casterId;
    }
    // The pinned source's stun branch applies no `awardsCombo` side effect.
    applyOfflinePounceStun(
        state,
        targetIndex,
        casterId,
        effects.metric(abilityIndex, 1, 0, "duration")
    );
}

offlineImbueBonus(state: WorldState, index: int): float {
    if (index < 0 || index >= state.entityIds.length || !imbueStateIsValid(state)) {
        throw "woc retained imbue state is invalid";
    }
    return <float>state.entityImbueResolvedBonuses[index];
}

clearOfflineImbue(state: WorldState, index: int): void {
    state.entityImbueAbilityCodes[index] = <uint>0;
    state.entityImbueRanks[index] = <uint>0;
    state.entityImbueRemaining[index] = 0.0;
    state.entityImbueResolvedBonuses[index] = 0;
    state.entityImbueResolvedJudgementMinimums[index] = 0;
    state.entityImbueResolvedJudgementMaximums[index] = 0;
    state.entityImbueTalentSpecCodes[index] = <uint>0;
    var row = 0;
    while (row < 6) {
        state.entityImbueTalentRowOptionCodes[index * 6 + row] = <uint>0;
        row = row + 1;
    }
}

applyOfflineImbue(
    state: WorldState, casterIndex: int, abilityCode: uint, rank: uint, duration: float
): void {
    state.entityImbueAbilityCodes[casterIndex] = abilityCode;
    state.entityImbueRanks[casterIndex] = rank;
    state.entityImbueRemaining[casterIndex] = duration;
    captureOfflineTalentImbueState(state, casterIndex);
}

applyOfflineSealOfRighteousness(state: WorldState, casterIndex: int, rank: uint): void {
    if (!sealOfRighteousnessProfileIsValid(rank)) {
        throw "woc Seal of Righteousness profile is invalid";
    }
    applyOfflineImbue(
        state, casterIndex, sealOfRighteousnessAbilityCode(), rank,
        sealOfRighteousnessDuration(rank)
    );
}

applyOfflineFlametongueWeapon(state: WorldState, casterIndex: int, rank: uint): void {
    if (!flametongueWeaponProfileIsValid(rank)) {
        throw "woc Flametongue Weapon profile is invalid";
    }
    applyOfflineImbue(
        state, casterIndex, flametongueWeaponAbilityCode(), rank,
        flametongueWeaponDuration(rank)
    );
}

applyOfflineFrostbrandWeapon(state: WorldState, casterIndex: int, rank: uint): void {
    if (!frostbrandWeaponProfileIsValid(rank)) {
        throw "woc Frostbrand Weapon profile is invalid";
    }
    applyOfflineImbue(
        state, casterIndex, frostbrandWeaponAbilityCode(), rank,
        frostbrandWeaponDuration(rank)
    );
}

sealOfRighteousnessGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 1.0 ? 1.0 : gcd;
}

