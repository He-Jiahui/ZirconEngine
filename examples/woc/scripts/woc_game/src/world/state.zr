    searingPainBytes.add(<uint>115); searingPainBytes.add(<uint>101);
    searingPainBytes.add(<uint>97); searingPainBytes.add(<uint>114);
    searingPainBytes.add(<uint>105); searingPainBytes.add(<uint>110);
    searingPainBytes.add(<uint>103); searingPainBytes.add(<uint>95);
    searingPainBytes.add(<uint>112); searingPainBytes.add(<uint>97);
    searingPainBytes.add(<uint>105); searingPainBytes.add(<uint>110);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>2, searingPainBytes, targetId
    );
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 35 &&
        <uint>restored.entityCastingAbility[0] == searingPain &&
        <uint>restored.entityCastTargetIds[0] == targetId &&
        floatMatches(<float>restored.entityCastRemaining[0], 1.5) &&
        <uint>restored.entityLastCommandSequence[0] == <uint>2 ? 1 : -6;
}

// Shadowburn resolves at instant admission while keeping its cost, GCD and
// cooldown independent from the later projectile resist and direct-hit draws.
pub shadowburnCommandStateTest(): int {
    if (timedSpell.contractTest() != 1 || spellResist.contractTest() != 1) { return -1; }
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var shadowburn = shadowburnAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("shadowburn");
    var forestWolf = <uint>(campMobCore.indexOf("forest_wolf", true) + 1);
    if (shadowburn == <uint>0 || abilityIndex != 47 || forestWolf == <uint>0 ||
        m4AbilityCatalog.text(abilityIndex, "class") != "warlock" ||
        m4AbilityEffects.typeAt(abilityIndex, 1, 0) != "directDamage" ||
        !shadowburnProjectileProfileIsValid(<uint>1, 56.0, 66.0, 0.0)) {
        return -2;
    }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>7;
    var playerId = state.spawnPlayer(<uint>7, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    var targetId = state.spawnMob(forestWolf, 1, 0.0, 1.5, 10.0, 1000, 8.0);
    state.entityPresentationScales[1] = 0.9;
    state.entityWeaponSpeed[1] = 2.0;
    state.entityResources[0] = 70;
    state.entityMaxResources[0] = 70;
    state.entitySpellPower[0] = 100;
    state.entityCritChance[0] = 0.0;
    state.entityHitBonus[0] = 1.0;
    state.entityTargetIds[0] = targetId;
    state.entityKnownAbilityCodes.add(shadowburn);
    var knownOffset = 1;
    while (knownOffset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[knownOffset] = <uint>1;
        knownOffset = knownOffset + 1;
    }

    var slot = new CommandBatch();
    appendCastSlotCommand(slot, playerId, <uint>1, <uint>1, <uint>0);
    state.applyCommands(slot, 1);
    if (playerId == <uint>0 || targetId == <uint>0 ||
        <float>state.entityResources[0] != 0 || <uint>state.rngDraws != <uint>0 ||
        <uint>state.entityCastingAbility[0] != <uint>0 ||
        !floatMatches(<float>state.entityCastGcdRemaining[0], 1.5) ||
        abilityCooldownExpiresAt(state, 0, shadowburn) != state.timeMicros + <uint>15000000 ||
        state.offlineProjectileSourceIds.length != 1 ||
        <uint>state.offlineProjectileSchoolCodes[0] != OFFLINE_PROJECTILE_SCHOOL_SHADOW ||
        <float>state.offlineProjectileMinimums[0] != 56.0 ||
        <float>state.offlineProjectileMaximums[0] != 66.0 ||
        <uint>state.offlineProjectileAbilityCodes[0] != shadowburn ||
        <uint>state.offlineProjectileRanks[0] != <uint>1 ||
        !floatMatches(<float>state.offlineProjectileCastTimes[0], 0.0)) {
        return -3;
    }

    var restored = decodeState(encodeState(state));
    var flightTicks = 0;
    while (restored.offlineProjectileSourceIds.length > 0 && flightTicks < 8) {
        stepOfflineEastbrookProjectiles(restored);
        flightTicks = flightTicks + 1;
    }
    if (restored.offlineProjectileSourceIds.length != 0 || flightTicks > 8 ||
        <uint>restored.rngDraws != <uint>3 || <int>restored.entityHp[1] >= 1000 ||
        !<bool>restored.entityInCombat[0] || !<bool>restored.entityInCombat[1] ||
        stateThreatValue(restored, 1, playerId) <= 0.0) {
        return -4;
    }

    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 70;
    var shadowburnBytes = new container.Array<uint>();
    shadowburnBytes.add(<uint>115); shadowburnBytes.add(<uint>104);
    shadowburnBytes.add(<uint>97); shadowburnBytes.add(<uint>100);
    shadowburnBytes.add(<uint>111); shadowburnBytes.add(<uint>119);
    shadowburnBytes.add(<uint>98); shadowburnBytes.add(<uint>117);
    shadowburnBytes.add(<uint>114); shadowburnBytes.add(<uint>110);
    var blocked = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        blocked, playerId, <uint>1, <uint>2, shadowburnBytes, targetId
    );
    restored.applyCommands(blocked, 1);
    if (<int>restored.entityResources[0] != 70 ||
        restored.offlineProjectileSourceIds.length != 0) {
        return -5;
    }
    restored.timeMicros = abilityCooldownExpiresAt(restored, 0, shadowburn);
    var typed = new CommandBatch();
    appendTypedCastTargetCommandForTest(
        typed, playerId, <uint>1, <uint>3, shadowburnBytes, targetId
    );
    restored.applyCommands(typed, 1);
    return <int>restored.entityResources[0] == 0 &&
        restored.offlineProjectileSourceIds.length == 1 &&
        <uint>restored.offlineProjectileAbilityCodes[0] == shadowburn &&
        <uint>restored.entityLastCommandSequence[0] == <uint>3 ? 1 : -6;
}

