mindFlayProjectileShapeIsValid(rankCode: uint, castTime: float): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("mind_flay");
    if (abilityIndex < 0 || rankCode != <uint>1 ||
        m4AbilityCatalog.rankAtLevel(abilityIndex, 14) != 1 ||
        effects.typeAt(abilityIndex, 1, 0) != "drainTick" ||
        effects.metric(abilityIndex, 1, 0, "healFrac") != 0.0) {
        return false;
    }
    return castTime == 0.0;
}

mindFlayProjectileProfileIsValid(
    rankCode: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("mind_flay");
    return mindFlayProjectileShapeIsValid(rankCode, castTime) &&
        minimum == effects.metric(abilityIndex, 1, 0, "min") &&
        maximum == effects.metric(abilityIndex, 1, 0, "max");
}

startOfflineFireballCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = fireballAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("fireball");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 1) != "dot" ||
        <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        fireballTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        fireballCastSeconds(state, casterIndex, abilityIndex),
        fireballGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineFireballCast(state: WorldState, casterIndex: int): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = fireballAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("fireball");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = fireballCompletionTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || <float>state.entityResources[casterIndex] < cost ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 1) != "dot") {
        return;
    }
    var overloadMultiplier = consumeOfflineOverloadSpell(state, casterIndex, cost);
    spendOfflineAbilityResource(
        state, casterIndex, offlineOverloadBillableCost(cost, overloadMultiplier)
    );
    var resolvedRange = resolveOfflineTalentDirectDamageRange(
        state,
        <uint>state.entityIds[casterIndex],
        abilityCode,
        <uint>rank,
        m4AbilityEffects.metric(abilityIndex, rank, 0, "min"),
        m4AbilityEffects.metric(abilityIndex, rank, 0, "max")
    );
    var launchRange = offlineOverloadTalentDirectDamageRange(
        resolvedRange, overloadMultiplier
    );
    appendOfflineAbilityProjectileWithDotTotal(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        <float>launchRange.minimum,
        <float>launchRange.maximum,
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_FIRE,
        abilityCode,
        <uint>rank,
        m4AbilityCatalog.metric(abilityIndex, level, "castTime"),
        offlineOverloadScaledPositiveMetric(
            m4AbilityEffects.metric(abilityIndex, rank, 1, "total"), overloadMultiplier
        )
    );
}

launchOfflinePyroblastProjectile(
    state: WorldState, casterIndex: int, targetId: uint, overloadMultiplier: float
): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = pyroblastAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("pyroblast");
    var level = <int>state.entityLevels[casterIndex];
    var rank = abilityIndex >= 0 ? m4AbilityCatalog.rankAtLevel(abilityIndex, level) : 0;
    if (rank != 1 || effects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        effects.typeAt(abilityIndex, rank, 1) != "dot") {
        throw "woc Pyroblast launch profile is invalid";
    }
    var resolvedRange = resolveOfflineTalentDirectDamageRange(
        state,
        <uint>state.entityIds[casterIndex],
        abilityCode,
        <uint>rank,
        effects.metric(abilityIndex, rank, 0, "min"),
        effects.metric(abilityIndex, rank, 0, "max")
    );
    var launchRange = offlineOverloadTalentDirectDamageRange(
        resolvedRange, overloadMultiplier
    );
    appendOfflineAbilityProjectileWithDotTotal(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        <float>launchRange.minimum,
        <float>launchRange.maximum,
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_FIRE,
        abilityCode,
        <uint>rank,
        m4AbilityCatalog.metric(abilityIndex, level, "castTime"),
        offlineOverloadScaledPositiveMetric(
            effects.metric(abilityIndex, rank, 1, "total"), overloadMultiplier
        )
    );
}

startOfflinePyroblastCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = pyroblastAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("pyroblast");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var freeAtStart = nextCastModifierActiveForAbility(
        state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
    );
    if (rank != 1 || effects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        effects.typeAt(abilityIndex, rank, 1) != "dot" ||
        (!freeAtStart && <float>state.entityResources[casterIndex] < cost) ||
        pyroblastTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var castSeconds = pyroblastCastSeconds(state, casterIndex, abilityIndex);
    var instantAtStart = castSeconds > 0.0 && nextCastModifierActiveForAbility(
        state, casterIndex, nextCastModifiers.instantKind(), abilityCode
    );
    if (instantAtStart) {
        if (!consumeNextCastModifierForAbility(
                state, casterIndex, nextCastModifiers.instantKind(), abilityCode
            )) {
            throw "woc Pyroblast instant modifier changed before consumption";
        }
        var overloadMultiplier = consumeOfflineOverloadSpell(state, casterIndex, cost);
        if (nextCastModifierActiveForAbility(
                state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
            )) {
            if (!consumeNextCastModifierForAbility(
                    state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
                )) {
                throw "woc Pyroblast free modifier changed before consumption";
            }
        } else {
            spendOfflineAbilityResource(
                state, casterIndex, offlineOverloadBillableCost(cost, overloadMultiplier)
            );
        }
        var instantCast = loadCastingState(state, casterIndex);
        instantCast.gcdRemaining = pyroblastGlobalCooldownSeconds(state, casterIndex);
        storeCastingState(state, casterIndex, instantCast);
        state.entitySitting[casterIndex] = false;
        state.entityWeaponStowed[casterIndex] = false;
        launchOfflinePyroblastProjectile(state, casterIndex, targetId, overloadMultiplier);
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        castSeconds,
        pyroblastGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflinePyroblastCast(state: WorldState, casterIndex: int): void {
    var effects = %import("generated/m4_ability_effects");
    var abilityCode = pyroblastAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("pyroblast");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = pyroblastCompletionTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var freeAtCompletion = nextCastModifierActiveForAbility(
        state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
    );
    if (rank != 1 || (!freeAtCompletion && <float>state.entityResources[casterIndex] < cost) ||
        effects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        effects.typeAt(abilityIndex, rank, 1) != "dot") {
        return;
    }
    var overloadMultiplier = consumeOfflineOverloadSpell(state, casterIndex, cost);
    if (freeAtCompletion) {
        if (!consumeNextCastModifierForAbility(
                state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
            )) {
            throw "woc Pyroblast free modifier changed before completion";
        }
    } else {
        spendOfflineAbilityResource(
            state, casterIndex, offlineOverloadBillableCost(cost, overloadMultiplier)
        );
    }
    launchOfflinePyroblastProjectile(state, casterIndex, targetId, overloadMultiplier);
}

combustionAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("combustion");
    var abilityIndex = m4AbilityCatalog.indexOf("combustion");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "combustion") {
        throw "Combustion is absent from the current ability catalog";
    }
    return code;
}

combustionPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>10 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>99 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>98 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>117 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>110;
}

flamestrikeAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("flamestrike");
    var abilityIndex = m4AbilityCatalog.indexOf("flamestrike");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "flamestrike") {
        throw "Flamestrike is absent from the current ability catalog";
    }
    return code;
}

flamestrikePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>11 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>101 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>107 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>101;
}

flamestrikeProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 && level >= 12 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "mage" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "fire" &&
        m4AbilityCatalog.text(abilityIndex, "targetMode") == "position" &&
        !m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 80.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 2.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 12.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "range") == 30.0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == 1 &&
        effects.count(abilityIndex, 1) == 1 &&
        effects.typeAt(abilityIndex, 1, 0) == "aoeDamage" &&
        effects.metric(abilityIndex, 1, 0, "min") == 34.0 &&
        effects.metric(abilityIndex, 1, 0, "max") == 44.0 &&
        effects.metric(abilityIndex, 1, 0, "radius") == 7.0 &&
        effects.flag(abilityIndex, 1, 0, "canCrit");
}

flamestrikeAimX(state: WorldState, casterIndex: int, requestedX: float, requestedZ: float): float {
    var abilityIndex = m4AbilityCatalog.indexOf("flamestrike");
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var deltaX = requestedX - <float>state.entityX[casterIndex];
    var deltaZ = requestedZ - <float>state.entityZ[casterIndex];
    var distance = math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
    return distance > range && distance > 0.0 ?
        <float>state.entityX[casterIndex] + deltaX * range / distance : requestedX;
}

flamestrikeAimZ(state: WorldState, casterIndex: int, requestedX: float, requestedZ: float): float {
    var abilityIndex = m4AbilityCatalog.indexOf("flamestrike");
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    var deltaX = requestedX - <float>state.entityX[casterIndex];
    var deltaZ = requestedZ - <float>state.entityZ[casterIndex];
    var distance = math.sqrt(deltaX * deltaX + deltaZ * deltaZ);
    return distance > range && distance > 0.0 ?
        <float>state.entityZ[casterIndex] + deltaZ * range / distance : requestedZ;
}

combustionProfileIsValid(abilityIndex: int, level: int): bool {
    var effects = %import("generated/m4_ability_effects");
    return abilityIndex >= 0 && level >= 12 &&
        m4AbilityCatalog.text(abilityIndex, "class") == "mage" &&
        m4AbilityCatalog.text(abilityIndex, "school") == "fire" &&
        !m4AbilityCatalog.flag(abilityIndex, "requiresTarget") &&
        m4AbilityCatalog.metric(abilityIndex, level, "cost") == 100.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "castTime") == 0.0 &&
        m4AbilityCatalog.metric(abilityIndex, level, "cooldown") == 120.0 &&
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) == 1 &&
        effects.count(abilityIndex, 1) == 1 &&
        effects.typeAt(abilityIndex, 1, 0) == "selfBuff" &&
        effects.text(abilityIndex, 1, 0, "kind") == "combustion" &&
        effects.metric(abilityIndex, 1, 0, "value") == 0.0 &&
        effects.metric(abilityIndex, 1, 0, "duration") == 10.0;
}

startOfflineCombustionCast(state: WorldState, casterIndex: int): void {
    var abilityCode = combustionAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("combustion");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (!combustionProfileIsValid(abilityIndex, level) ||
        <float>state.entityResources[casterIndex] < cost) {
        return;
    }
    var overloadMultiplier = consumeOfflineOverloadSpell(state, casterIndex, cost);
    spendOfflineAbilityResource(
        state, casterIndex, offlineOverloadBillableCost(cost, overloadMultiplier)
    );
    state.entityCombustionRemaining[casterIndex] = 10.0;
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode, state.timeMicros + <uint>120000000
    );
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

fireMageHotStreakSpenderCodes(): container.Array<uint> {
    var pyroblast = pyroblastAbilityCode();
    var flamestrike = <uint>knownAbilityCatalog.abilityCode("flamestrike");
    if (pyroblast == <uint>0 || flamestrike == <uint>0 ||
        !knownAbilityCatalog.abilityExists(flamestrike)) {
        throw "woc Fire Mage spender catalog is invalid";
    }
    var codes = new container.Array<uint>();
    if (pyroblast < flamestrike) {
        codes.add(pyroblast);
        codes.add(flamestrike);
    } else {
        codes.add(flamestrike);
        codes.add(pyroblast);
    }
    return codes;
}

clearAbilityCooldown(state: WorldState, entityIndex: int, abilityCode: uint): void {
    if (entityIndex < 0 || entityIndex >= state.entityIds.length || abilityCode == <uint>0) {
        return;
    }
    var nextOffsets = new container.Array<uint>();
    var nextCodes = new container.Array<uint>();
    var nextExpiresAtMicros = new container.Array<uint>();
    nextOffsets.add(<uint>0);
    var currentEntityIndex = 0;
    while (currentEntityIndex < state.entityIds.length) {
        var cooldownIndex = <int><uint>state.entityAbilityCooldownOffsets[currentEntityIndex];
        var cooldownEnd = <int><uint>state.entityAbilityCooldownOffsets[currentEntityIndex + 1];
        while (cooldownIndex < cooldownEnd) {
            var code = <uint>state.entityAbilityCooldownCodes[cooldownIndex];
            if (currentEntityIndex != entityIndex || code != abilityCode) {
                nextCodes.add(code);
                nextExpiresAtMicros.add(
                    <uint>state.entityAbilityCooldownExpiresAtMicros[cooldownIndex]
                );
            }
            cooldownIndex = cooldownIndex + 1;
        }
        nextOffsets.add(<uint>nextCodes.length);
        currentEntityIndex = currentEntityIndex + 1;
    }
    state.entityAbilityCooldownOffsets = nextOffsets;
    state.entityAbilityCooldownCodes = nextCodes;
    state.entityAbilityCooldownExpiresAtMicros = nextExpiresAtMicros;
}

offlineAbilityChargeStateIndex(
    state: WorldState, entityId: uint, abilityCode: uint
): int {
    var index = 0;
    while (index < state.offlineAbilityChargeEntityIds.length) {
        if (<uint>state.offlineAbilityChargeEntityIds[index] == entityId &&
            <uint>state.offlineAbilityChargeCodes[index] == abilityCode) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// The source map may survive a respec while its existing timers finish. Its
// identity is therefore validated from the catalog and cooldown, not from the
// caster's current bonusCharges selection.
offlineAbilityChargeStateIsValid(state: WorldState): bool {
    var count = state.offlineAbilityChargeEntityIds.length;
    if (count != state.offlineAbilityChargeCodes.length ||
        count != state.offlineAbilityChargeCounts.length ||
        count != state.offlineAbilityChargeMaximums.length ||
        count != state.offlineAbilityChargeRechargeLengths.length ||
        state.offlineAbilityChargeRechargeOffsets.length != count + 1 ||
        <uint>state.offlineAbilityChargeRechargeOffsets[0] != <uint>0 ||
        <uint>state.offlineAbilityChargeRechargeOffsets[count] !=
            <uint>state.offlineAbilityChargeRechargeRemaining.length ||
        count > <int>OFFLINE_ABILITY_CHARGE_PENDING_MAX) {
        return false;
    }
    var index = 0;
    while (index < count) {
        var entityId = <uint>state.offlineAbilityChargeEntityIds[index];
        var abilityCode = <uint>state.offlineAbilityChargeCodes[index];
        var entityIndex = partyEntityIndexById(state, entityId);
        var abilityIndex = abilityCode == <uint>0 ||
            !knownAbilityCatalog.abilityExists(<int>abilityCode) ? -1 :
            m4AbilityCatalog.indexOf(knownAbilityCatalog.abilityId(<int>abilityCode));
        var maximum = <int>state.offlineAbilityChargeMaximums[index];
        var charges = <int>state.offlineAbilityChargeCounts[index];
        var start = <int><uint>state.offlineAbilityChargeRechargeOffsets[index];
        var end = <int><uint>state.offlineAbilityChargeRechargeOffsets[index + 1];
        if (entityId == <uint>0 || entityIndex < 0 || abilityIndex < 0 ||
            maximum <= 1 || charges < 0 || charges > maximum || start < 0 ||
            end < start || end > state.offlineAbilityChargeRechargeRemaining.length ||
            end - start != maximum - charges ||
            <float>state.offlineAbilityChargeRechargeLengths[index] <= 0.0 ||
            <float>state.offlineAbilityChargeRechargeLengths[index] !=
                m4AbilityCatalog.metric(
                    abilityIndex, <int>state.entityLevels[entityIndex], "cooldown"
                )) {
            return false;
        }
        var prior = 0.0;
        var timerIndex = start;
        while (timerIndex < end) {
            var remaining = <float>state.offlineAbilityChargeRechargeRemaining[timerIndex];
            if (remaining <= 0.0 || remaining >
                <float>state.offlineAbilityChargeRechargeLengths[index] ||
                (timerIndex > start && remaining < prior)) {
                return false;
            }
            prior = remaining;
            timerIndex = timerIndex + 1;
        }
        var other = index + 1;
        while (other < count) {
            if (<uint>state.offlineAbilityChargeEntityIds[other] == entityId &&
                <uint>state.offlineAbilityChargeCodes[other] == abilityCode) {
                return false;
            }
            other = other + 1;
        }
        index = index + 1;
    }
    return true;
}

loadOfflineAbilityChargeState(
    state: WorldState, index: int, maximum: int, rechargeLength: float
): abilityCharges.AbilityChargeState {
    var charges = new abilityCharges.AbilityChargeState(maximum, rechargeLength);
    if (index < 0) { return charges; }
    charges.charges = <int>state.offlineAbilityChargeCounts[index];
    charges.rechargesMaterialized = true;
    var timerIndex = <int><uint>state.offlineAbilityChargeRechargeOffsets[index];
    var timerEnd = <int><uint>state.offlineAbilityChargeRechargeOffsets[index + 1];
    while (timerIndex < timerEnd) {
        charges.recharges.add(<float>state.offlineAbilityChargeRechargeRemaining[timerIndex]);
        timerIndex = timerIndex + 1;
    }
    charges.recharge = charges.recharges.length > 0 ? <float>charges.recharges[0] : 0.0;
    charges.hasCooldownMirror = charges.charges <= 0 && charges.recharges.length > 0;
    charges.cooldownMirror = charges.hasCooldownMirror ? charges.recharge : 0.0;
    return charges;
}

removeOfflineAbilityChargeAt(state: WorldState, index: int): void {
    var timerStart = <int><uint>state.offlineAbilityChargeRechargeOffsets[index];
    var timerEnd = <int><uint>state.offlineAbilityChargeRechargeOffsets[index + 1];
    var removedTimers = timerEnd - timerStart;
    while (timerStart < timerEnd) {
        state.offlineAbilityChargeRechargeRemaining.removeAt(timerStart);
        timerEnd = timerEnd - 1;
    }
    state.offlineAbilityChargeEntityIds.removeAt(index);
    state.offlineAbilityChargeCodes.removeAt(index);
    state.offlineAbilityChargeCounts.removeAt(index);
    state.offlineAbilityChargeMaximums.removeAt(index);
    state.offlineAbilityChargeRechargeLengths.removeAt(index);
    state.offlineAbilityChargeRechargeOffsets.removeAt(index + 1);
    var offset = index + 1;
    while (offset < state.offlineAbilityChargeRechargeOffsets.length) {
        state.offlineAbilityChargeRechargeOffsets[offset] =
            <uint>state.offlineAbilityChargeRechargeOffsets[offset] - <uint>removedTimers;
        offset = offset + 1;
    }
}

storeOfflineAbilityChargeState(
    state: WorldState,
    entityId: uint,
    abilityCode: uint,
    charges: abilityCharges.AbilityChargeState
): void {
    var prior = offlineAbilityChargeStateIndex(state, entityId, abilityCode);
    if (prior >= 0) { removeOfflineAbilityChargeAt(state, prior); }
    state.offlineAbilityChargeEntityIds.add(entityId);
    state.offlineAbilityChargeCodes.add(abilityCode);
    state.offlineAbilityChargeCounts.add(charges.charges);
    state.offlineAbilityChargeMaximums.add(charges.maxCharges);
    state.offlineAbilityChargeRechargeLengths.add(charges.rechargeLength);
    for (var remaining in charges.recharges) {
        state.offlineAbilityChargeRechargeRemaining.add(<float>remaining);
    }
    state.offlineAbilityChargeRechargeOffsets.add(
        <uint>state.offlineAbilityChargeRechargeRemaining.length
    );
}

offlineAbilityChargeReady(
    state: WorldState,
    entityIndex: int,
    abilityCode: uint,
    bonusCharges: float,
    rechargeLength: float
): bool {
    if (bonusCharges <= 0.0 || rechargeLength <= 0.0) {
        return abilityCooldownExpiresAt(state, entityIndex, abilityCode) <= state.timeMicros;
    }
    var record = offlineAbilityChargeStateIndex(
        state, <uint>state.entityIds[entityIndex], abilityCode
    );
    return record < 0 || <int>state.offlineAbilityChargeCounts[record] > 0;
}

armOfflineAbilityChargeCooldown(
    state: WorldState,
    entityIndex: int,
    abilityCode: uint,
    bonusCharges: float,
    rechargeLength: float
): void {
    if (bonusCharges <= 0.0 || rechargeLength <= 0.0) {
        setAbilityCooldownExpiration(
            state, entityIndex, abilityCode,
            state.timeMicros + <uint>(rechargeLength * 1000000.0)
        );
        return;
    }
    var maximum = 1 + <int>bonusCharges;
    var entityId = <uint>state.entityIds[entityIndex];
    var record = offlineAbilityChargeStateIndex(state, entityId, abilityCode);
    var charges = loadOfflineAbilityChargeState(state, record, maximum, rechargeLength);
    if (!abilityCharges.spendAbilityCharge(charges)) {
        throw "woc ability charge arm is not ready";
    }
    storeOfflineAbilityChargeState(state, entityId, abilityCode, charges);
    if (charges.hasCooldownMirror) {
        setAbilityCooldownExpiration(
            state, entityIndex, abilityCode,
            state.timeMicros + <uint>(charges.cooldownMirror * 1000000.0 + 0.5)
        );
    } else {
        clearAbilityCooldown(state, entityIndex, abilityCode);
    }
}

// Source updateTimers ages every missing use together. Rebuild the flat rows
// only after all current records are read so offsets remain authoritative.
stepOfflineAbilityCharges(state: WorldState): void {
    if (!offlineAbilityChargeStateIsValid(state)) {
        throw "woc ability charge state is invalid";
    }
    var nextEntityIds = new container.Array<uint>();
    var nextCodes = new container.Array<uint>();
    var nextCounts = new container.Array<int>();
    var nextMaximums = new container.Array<int>();
    var nextRechargeLengths = new container.Array<float>();
    var nextOffsets = new container.Array<uint>();
    var nextRemaining = new container.Array<float>();
    nextOffsets.add(<uint>0);
    var index = 0;
    while (index < state.offlineAbilityChargeEntityIds.length) {
        var entityId = <uint>state.offlineAbilityChargeEntityIds[index];
        var abilityCode = <uint>state.offlineAbilityChargeCodes[index];
        var entityIndex = partyEntityIndexById(state, entityId);
        var charges = loadOfflineAbilityChargeState(
            state, index, <int>state.offlineAbilityChargeMaximums[index],
            <float>state.offlineAbilityChargeRechargeLengths[index]
        );
        abilityCharges.tickAbilityCharges(charges, projectileTravel.projectileTickSeconds());
        if (charges.hasCooldownMirror) {
            setAbilityCooldownExpiration(
                state, entityIndex, abilityCode,
                state.timeMicros + <uint>(charges.cooldownMirror * 1000000.0 + 0.5)
            );
        } else {
            clearAbilityCooldown(state, entityIndex, abilityCode);
        }
        nextEntityIds.add(entityId);
        nextCodes.add(abilityCode);
        nextCounts.add(charges.charges);
        nextMaximums.add(charges.maxCharges);
        nextRechargeLengths.add(charges.rechargeLength);
        for (var remaining in charges.recharges) { nextRemaining.add(<float>remaining); }
        nextOffsets.add(<uint>nextRemaining.length);
        index = index + 1;
    }
    state.offlineAbilityChargeEntityIds = nextEntityIds;
    state.offlineAbilityChargeCodes = nextCodes;
    state.offlineAbilityChargeCounts = nextCounts;
    state.offlineAbilityChargeMaximums = nextMaximums;
    state.offlineAbilityChargeRechargeLengths = nextRechargeLengths;
    state.offlineAbilityChargeRechargeOffsets = nextOffsets;
    state.offlineAbilityChargeRechargeRemaining = nextRemaining;
}

applyOfflineFireMageSpellHit(
    state: WorldState, casterIndex: int, abilityCode: uint, critical: bool
): void {
    var abilityId = abilityCode == fireballAbilityCode() ? "fireball" :
        abilityCode == pyroblastAbilityCode() ? "pyroblast" :
        abilityCode == flamestrikeAbilityCode() ? "flamestrike" :
        abilityCode == dragonsBreathAbilityCode() ? "dragons_breath" : "";
    if (casterIndex < 0 || casterIndex >= state.entityIds.length || abilityId == "" ||
        <uint>state.entityKinds[casterIndex] != <uint>1 ||
        !fireMageProcStateIsValid(state) || !nextCastModifierStateIsValid(state)) {
        return;
    }
    var combustionCode = combustionAbilityCode();
    var combustionExpiresAt = abilityCooldownExpiresAt(state, casterIndex, combustionCode);
    var hasCombustionCooldown = combustionExpiresAt > state.timeMicros;
    var combustionCooldown = hasCombustionCooldown ?
        <float>(combustionExpiresAt - state.timeMicros) / 1000000.0 : 0.0;
    var plan = fireMage.hotStreakOnSpellHit(
        true,
        true,
        abilityId,
        critical,
        <float>state.entityHeatingUpRemaining[casterIndex] > 0.0,
        <float>state.entityCombustionRemaining[casterIndex] > 0.0,
        hasCombustionCooldown,
        combustionCooldown
    );
    if (plan.removeHeating) {
        state.entityHeatingUpRemaining[casterIndex] = 0.0;
    }
    if (plan.applyHeating) {
        state.entityHeatingUpRemaining[casterIndex] = fireMageContract.heatingUpWindow();
    }
    if (plan.applyHotStreakPair) {
        state.entityHotStreakRemaining[casterIndex] = fireMageContract.hotStreakDuration();
        var spenders = fireMageHotStreakSpenderCodes();
        setNextCastModifier(
            state,
            casterIndex,
            fireMageContract.hotStreakFreeModifierIdentityCode(),
            nextCastModifiers.freeCostKind(),
            fireMageContract.hotStreakDuration(),
            0.0,
            spenders
        );
        setNextCastModifier(
            state,
            casterIndex,
            fireMageContract.hotStreakInstantModifierIdentityCode(),
            nextCastModifiers.instantKind(),
            fireMageContract.hotStreakDuration(),
            0.0,
            spenders
        );
    }
    if (plan.updateCombustionCooldown) {
        if (plan.combustionCooldown > 0.0) {
            setAbilityCooldownExpiration(
                state,
                casterIndex,
                combustionCode,
                state.timeMicros + <uint>(plan.combustionCooldown * 1000000.0)
            );
        } else {
            clearAbilityCooldown(state, casterIndex, combustionCode);
        }
    }
}

clearFlamestrikeCastAim(state: WorldState, casterIndex: int): void {
    state.entityCastAimPresent[casterIndex] = false;
    state.entityCastAimX[casterIndex] = 0.0;
    state.entityCastAimY[casterIndex] = 0.0;
    state.entityCastAimZ[casterIndex] = 0.0;
}

resolveOfflineFlamestrikeBurst(
    state: WorldState, casterIndex: int, aimX: float, aimZ: float, overloadMultiplier: float
): void {
    var abilityCode = flamestrikeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("flamestrike");
    var level = <int>state.entityLevels[casterIndex];
    var effects = %import("generated/m4_ability_effects");
    if (!flamestrikeProfileIsValid(abilityIndex, level)) {
        throw "woc Flamestrike burst profile is invalid";
    }
    var radius = 7.0;
    var targetCount = 0;
    var entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var dx = <float>state.entityX[entityIndex] - aimX;
        var dz = <float>state.entityZ[entityIndex] - aimZ;
        if (isOfflineEastbrookLifecycleMob(state, entityIndex) &&
            <bool>state.entityHostile[entityIndex] && !<bool>state.entityDead[entityIndex] &&
            dx * dx + dz * dz <= radius * radius) {
            targetCount = targetCount + 1;
        }
        entityIndex = entityIndex + 1;
    }
    if (targetCount == 0) { return; }
    var critical = nextAuthoritativeRandomUnit(state) <
        offlineDamageCritChance(state, casterIndex) || fireMage.fireGuaranteedCrit(
            true,
            "fire",
            <float>state.entityCombustionRemaining[casterIndex] > 0.0,
            "flamestrike",
            false,
            0,
            0
        );
    var spellPowerBonus = <float>spellScaling.directHitBonus(
        <float>state.entitySpellPower[casterIndex],
        "fire",
        false,
        m4AbilityCatalog.metric(abilityIndex, level, "castTime"),
        true
    );
    var sourceId = <uint>state.entityIds[casterIndex];
    var talentRange = resolveOfflineTalentAoEDamageRange(
        state,
        sourceId,
        abilityCode,
        <uint>m4AbilityCatalog.rankAtLevel(abilityIndex, level),
        0,
        effects.metric(abilityIndex, 1, 0, "min"),
        effects.metric(abilityIndex, 1, 0, "max")
    );
    var minimum = offlineOverloadScaledPositiveMetric(
        <float>talentRange.minimum, overloadMultiplier
    );
    var maximum = offlineOverloadScaledPositiveMetric(
        <float>talentRange.maximum, overloadMultiplier
    );
    entityIndex = 0;
    while (entityIndex < state.entityIds.length) {
        var targetDx = <float>state.entityX[entityIndex] - aimX;
        var targetDz = <float>state.entityZ[entityIndex] - aimZ;
        if (isOfflineEastbrookLifecycleMob(state, entityIndex) &&
            <bool>state.entityHostile[entityIndex] && !<bool>state.entityDead[entityIndex] &&
            targetDx * targetDx + targetDz * targetDz <= radius * radius) {
            var damage = minimum + nextAuthoritativeRandomUnit(state) *
                (maximum - minimum) + spellPowerBonus;
            damage = damage * <float>state.entitySpellDamageMultipliers[casterIndex];
            if (critical) {
                damage = damage * (1.5 +
                    <float>state.entityCritDamageSpellBonus[casterIndex]);
            }
            var roundedDamage = <int>(damage + 0.5);
            var hp = <int>state.entityHp[entityIndex] - roundedDamage;
            state.entityHp[entityIndex] = hp > 0 ? hp : 0;
            if (roundedDamage > 0) {
                clearOfflineBreakableIncapacitateOnDamage(state, entityIndex, roundedDamage);
            }
            state.entityInCombat[casterIndex] = true;
            state.entityCombatTimers[casterIndex] = 0.0;
            state.entityInCombat[entityIndex] = true;
            state.entityCombatTimers[entityIndex] = 0.0;
            if (hp > 0) {
                if (<uint>state.entityAiStates[entityIndex] == mobLifecycle.idleAiState()) {
                    enterIdleMobAggro(state, entityIndex, sourceId);
                } else if (<uint>state.entityAggroTargetIds[entityIndex] == <uint>0) {
                    state.entityAggroTargetIds[entityIndex] = sourceId;
                }
                state.setThreat(
                    <uint>state.entityIds[entityIndex],
                    sourceId,
                    stateThreatValue(state, entityIndex, sourceId) +
                        <float>roundedDamage * m4AbilityCatalog.metric(
                            abilityIndex, level, "threatMult"
                        ) + m4AbilityCatalog.metric(abilityIndex, level, "threatFlat"),
                    1
                );
            } else {
                settleOfflineEastbrookLethal(state, entityIndex, casterIndex);
            }
        }
        entityIndex = entityIndex + 1;
    }
    applyOfflineFireMageSpellHit(state, casterIndex, abilityCode, critical);
}

startOfflineFlamestrikeCast(
    state: WorldState, casterIndex: int, requestedX: float, requestedZ: float
): void {
    var abilityCode = flamestrikeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("flamestrike");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        abilityCooldownExpiresAt(state, casterIndex, abilityCode) > state.timeMicros ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var freeAtStart = nextCastModifierActiveForAbility(
        state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
    );
    if (!flamestrikeProfileIsValid(abilityIndex, level) ||
        (!freeAtStart && <float>state.entityResources[casterIndex] < cost)) {
        return;
    }
    var aimX = flamestrikeAimX(state, casterIndex, requestedX, requestedZ);
    var aimZ = flamestrikeAimZ(state, casterIndex, requestedX, requestedZ);
    var castSeconds = m4AbilityCatalog.metric(abilityIndex, level, "castTime") /
        mageSpellHasteMultiplier(state, casterIndex);
    var instantAtStart = castSeconds > 0.0 && nextCastModifierActiveForAbility(
        state, casterIndex, nextCastModifiers.instantKind(), abilityCode
    );
    if (instantAtStart) {
        if (!consumeNextCastModifierForAbility(
                state, casterIndex, nextCastModifiers.instantKind(), abilityCode
            )) {
            throw "woc Flamestrike instant modifier changed before consumption";
        }
        var overloadMultiplier = consumeOfflineOverloadSpell(state, casterIndex, cost);
        if (nextCastModifierActiveForAbility(
                state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
            )) {
            if (!consumeNextCastModifierForAbility(
                    state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
                )) {
                throw "woc Flamestrike free modifier changed before consumption";
            }
        } else {
            spendOfflineAbilityResource(
                state, casterIndex, offlineOverloadBillableCost(cost, overloadMultiplier)
            );
        }
        var instantCast = loadCastingState(state, casterIndex);
        instantCast.gcdRemaining = rainOfFireGlobalCooldownSeconds(state, casterIndex);
        storeCastingState(state, casterIndex, instantCast);
        setAbilityCooldownExpiration(
            state, casterIndex, abilityCode, state.timeMicros + <uint>12000000
        );
        state.entitySitting[casterIndex] = false;
        state.entityWeaponStowed[casterIndex] = false;
        resolveOfflineFlamestrikeBurst(state, casterIndex, aimX, aimZ, overloadMultiplier);
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        castSeconds,
        rainOfFireGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(true, false);
    storeCastingState(state, casterIndex, cast);
    state.entityCastAimPresent[casterIndex] = true;
    state.entityCastAimX[casterIndex] = aimX;
    state.entityCastAimY[casterIndex] = <float>state.entityY[casterIndex];
    state.entityCastAimZ[casterIndex] = aimZ;
    state.entityCastTargetIds[casterIndex] = <uint>0;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineFlamestrikeCast(state: WorldState, casterIndex: int): void {
    var abilityCode = flamestrikeAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("flamestrike");
    var hadAim = <bool>state.entityCastAimPresent[casterIndex];
    var aimX = <float>state.entityCastAimX[casterIndex];
    var aimZ = <float>state.entityCastAimZ[casterIndex];
    clearFlamestrikeCastAim(state, casterIndex);
    if (abilityIndex < 0 || !hadAim) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    var freeAtCompletion = nextCastModifierActiveForAbility(
        state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
    );
    if (!flamestrikeProfileIsValid(abilityIndex, level) ||
        (!freeAtCompletion && <float>state.entityResources[casterIndex] < cost)) {
        return;
    }
    var overloadMultiplier = consumeOfflineOverloadSpell(state, casterIndex, cost);
    if (freeAtCompletion) {
        if (!consumeNextCastModifierForAbility(
                state, casterIndex, nextCastModifiers.freeCostKind(), abilityCode
            )) {
            throw "woc Flamestrike free modifier changed before completion";
        }
    } else {
        spendOfflineAbilityResource(
            state, casterIndex, offlineOverloadBillableCost(cost, overloadMultiplier)
        );
    }
    setAbilityCooldownExpiration(
        state, casterIndex, abilityCode, state.timeMicros + <uint>12000000
    );
    resolveOfflineFlamestrikeBurst(state, casterIndex, aimX, aimZ, overloadMultiplier);
}

frostboltAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("frostbolt");
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "frostbolt") {
        throw "Frostbolt is absent from the current ability catalog";
    }
    return code;
}

frostboltPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>9 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>102 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>114 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>98 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>116;
}

// All source Frostbolt ranks carry the same 0.6 slow multiplier. The WOS55
// motion row therefore persists the source ability identity, owner and clock
// while this M4 projection deterministically supplies its value.
frostboltSlowMultiplier(): float {
    var effects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    if (abilityIndex < 0 || effects.typeAt(abilityIndex, 1, 1) != "slow") {
        throw "Frostbolt slow projection is invalid";
    }
    return effects.metric(abilityIndex, 1, 1, "mult");
}

frostboltRankLevel(rank: uint): int {
    if (rank == <uint>1) { return 4; }
    if (rank == <uint>2) { return 8; }
    if (rank == <uint>3) { return 14; }
    if (rank == <uint>4) { return 20; }
    return 0;
}

// A queued spell must retain the resolved source ability, rather than resolve
// a potentially changed level when it lands after projectile travel.
frostboltProjectileProfileIsValid(
    rankCode: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    var level = frostboltRankLevel(rankCode);
    if (abilityIndex < 0 || level <= 0 ||
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) != <int>rankCode ||
        m4AbilityEffects.typeAt(abilityIndex, <int>rankCode, 0) != "directDamage" ||
        m4AbilityEffects.typeAt(abilityIndex, <int>rankCode, 1) != "slow") {
        return false;
    }
    return minimum == m4AbilityEffects.metric(abilityIndex, <int>rankCode, 0, "min") &&
        maximum == m4AbilityEffects.metric(abilityIndex, <int>rankCode, 0, "max") &&
        castTime == m4AbilityCatalog.metric(abilityIndex, level, "castTime");
}

frostboltTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    // The source applies its generic hostile-target facing gate after range
    // and LoS validation. The retained Eastbrook outdoor subset has clear LoS.
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

// Cast admission uses the source hostile-facing gate. Completion revalidates
// the locked target through applyAbility's range and LoS checks only: turning
// during the cast cannot cancel a Frostbolt that is otherwise still in range.
frostboltCompletionTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    // The retained Eastbrook outdoor subset has clear line of sight.
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

// The retained stat is the source's additive spell-haste bonus. The Mage
// projectiles in this slice have no spell-specific modifier, so the source
// multiplier is `1 + max(0, entitySpellHaste)` for both bar and Mage GCD.
mageSpellHasteMultiplier(state: WorldState, casterIndex: int): float {
    var bonus = <float>state.entitySpellHaste[casterIndex] +
        arcanePowerSpellHasteBonus(state, casterIndex) +
        icyVeinsSpellHasteBonus(state, casterIndex) +
        groupHasteSpellBonus(state, casterIndex);
    return 1.0 + (bonus < 0.0 ? 0.0 : bonus);
}

frostboltSpellHasteMultiplier(state: WorldState, casterIndex: int): float {
    return mageSpellHasteMultiplier(state, casterIndex);
}

// Every TimedSpellSpec here is a source magic hit. Keep the mutable world
// projection at this shared boundary so an aura applies before the final
// critical multiplier and rounding, while physical strike paths stay outside.
configureOfflineSpellDamageModifiers(
    state: WorldState, casterIndex: int, spell: timedSpell.TimedSpellSpec
): void {
    spell.critDamageBonus = <float>state.entityCritDamageSpellBonus[casterIndex];
    spell.damageMultiplier = <float>state.entitySpellDamageMultipliers[casterIndex];
}

frostboltCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

frostboltGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 1.0 ? 1.0 : gcd;
}

startOfflineFrostboltCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = frostboltAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 1) != "slow" ||
        <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        frostboltTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        frostboltCastSeconds(state, casterIndex, abilityIndex),
        frostboltGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineFrostboltCast(state: WorldState, casterIndex: int): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = frostboltAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("frostbolt");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = frostboltCompletionTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || <float>state.entityResources[casterIndex] < cost ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 1) != "slow") {
        return;
    }
    var overloadMultiplier = consumeOfflineOverloadSpell(state, casterIndex, cost);
    spendOfflineAbilityResource(
        state, casterIndex, offlineOverloadBillableCost(cost, overloadMultiplier)
    );
    // A spell is released at cast completion, then its one resist draw and
    // direct-effect draws occur only at the projectile's landing tick.
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        offlineOverloadScaledPositiveMetric(
            m4AbilityEffects.metric(abilityIndex, rank, 0, "min"), overloadMultiplier
        ),
        offlineOverloadScaledPositiveMetric(
            m4AbilityEffects.metric(abilityIndex, rank, 0, "max"), overloadMultiplier
        ),
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_FROST,
        abilityCode,
        <uint>rank,
        m4AbilityCatalog.metric(abilityIndex, level, "castTime")
    );
}

smiteAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("smite");
    var abilityIndex = m4AbilityCatalog.indexOf("smite");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "smite") {
        throw "Smite is absent from the current ability catalog";
    }
    return code;
}

smitePayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>5 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>109 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>105 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>116 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>101;
}

smiteTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("smite");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

smiteCompletionTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("smite");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

smiteCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

smiteGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineSmiteCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = smiteAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("smite");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        smiteTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        smiteCastSeconds(state, casterIndex, abilityIndex),
        smiteGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineSmiteCast(state: WorldState, casterIndex: int): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = smiteAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("smite");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = smiteCompletionTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || <float>state.entityResources[casterIndex] < cost ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage") {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        m4AbilityEffects.metric(abilityIndex, rank, 0, "min"),
        m4AbilityEffects.metric(abilityIndex, rank, 0, "max"),
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_HOLY,
        abilityCode,
        <uint>rank,
        m4AbilityCatalog.metric(abilityIndex, level, "castTime")
    );
}

// Shadow Bolt is the Warlock's source-defined direct Shadow cast. It shares
// the retained nonphysical projectile reducer while preserving its own rank
// profile and delayed-cost cast completion.
shadowBoltAbilityCode(): uint {
    var code = <uint>knownAbilityCatalog.abilityCode("shadow_bolt");
    var abilityIndex = m4AbilityCatalog.indexOf("shadow_bolt");
    if (code == <uint>0 || !knownAbilityCatalog.abilityExists(code) || abilityIndex < 0 ||
        m4AbilityCatalog.text(abilityIndex, "id") != "shadow_bolt") {
        throw "Shadow Bolt is absent from the current ability catalog";
    }
    return code;
}

shadowBoltPayloadAbilityIsExact(
    payloadBytes: container.Array<uint>, abilityOffset: uint, abilityLength: uint
): bool {
    return abilityLength == <uint>11 &&
        <uint>payloadBytes[<int>abilityOffset] == <uint>115 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>1)] == <uint>104 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>2)] == <uint>97 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>3)] == <uint>100 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>4)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>5)] == <uint>119 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>6)] == <uint>95 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>7)] == <uint>98 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>8)] == <uint>111 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>9)] == <uint>108 &&
        <uint>payloadBytes[<int>(abilityOffset + <uint>10)] == <uint>116;
}

shadowBoltRankLevel(rankCode: uint): int {
    if (rankCode == <uint>1) { return 1; }
    if (rankCode == <uint>2) { return 8; }
    if (rankCode == <uint>3) { return 14; }
    if (rankCode == <uint>4) { return 20; }
    return 0;
}

shadowBoltProjectileProfileIsValid(
    rankCode: uint,
    minimum: float,
    maximum: float,
    castTime: float
): bool {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityIndex = m4AbilityCatalog.indexOf("shadow_bolt");
    var level = shadowBoltRankLevel(rankCode);
    if (abilityIndex < 0 || level <= 0 ||
        m4AbilityCatalog.rankAtLevel(abilityIndex, level) != <int>rankCode ||
        m4AbilityEffects.typeAt(abilityIndex, <int>rankCode, 0) != "directDamage") {
        return false;
    }
    return minimum == m4AbilityEffects.metric(abilityIndex, <int>rankCode, 0, "min") &&
        maximum == m4AbilityEffects.metric(abilityIndex, <int>rankCode, 0, "max") &&
        castTime == m4AbilityCatalog.metric(abilityIndex, level, "castTime");
}

shadowBoltTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("shadow_bolt");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) &&
        absoluteAngleDifference(math.atan2(dx, dz), <float>state.entityFacing[casterIndex]) <= 2.2 ?
        targetIndex : -1;
}

shadowBoltCompletionTargetIndex(state: WorldState, casterIndex: int, targetId: uint): int {
    var targetIndex = partyEntityIndexById(state, targetId);
    if (targetIndex < 0 || !isOfflineEastbrookLifecycleMob(state, targetIndex) ||
        <bool>state.entityDead[targetIndex] || !<bool>state.entityHostile[targetIndex]) {
        return -1;
    }
    var abilityIndex = m4AbilityCatalog.indexOf("shadow_bolt");
    if (abilityIndex < 0) { return -1; }
    var dx = <float>state.entityX[targetIndex] - <float>state.entityX[casterIndex];
    var dz = <float>state.entityZ[targetIndex] - <float>state.entityZ[casterIndex];
    var range = m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "range"
    );
    return range > 0.0 && dx * dx + dz * dz <= (range + 2.0) * (range + 2.0) ?
        targetIndex : -1;
}

shadowBoltCastSeconds(state: WorldState, casterIndex: int, abilityIndex: int): float {
    return m4AbilityCatalog.metric(
        abilityIndex, <int>state.entityLevels[casterIndex], "castTime"
    ) / mageSpellHasteMultiplier(state, casterIndex);
}

shadowBoltGlobalCooldownSeconds(state: WorldState, casterIndex: int): float {
    var gcd = 1.5 / mageSpellHasteMultiplier(state, casterIndex);
    return gcd < 0.75 ? 0.75 : gcd;
}

startOfflineShadowBoltCast(state: WorldState, casterIndex: int, targetId: uint): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = shadowBoltAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("shadow_bolt");
    if (!state.offlineSessionActive || abilityIndex < 0 ||
        casterIndex != offlineQuestPrimaryPlayerIndex(state) ||
        <bool>state.entityDead[casterIndex] ||
        <uint>state.entityCastingAbility[casterIndex] != <uint>0 ||
        <float>state.entityCastGcdRemaining[casterIndex] > 0.0 ||
        <uint>state.entityActiveFormAbilityCodes[casterIndex] != <uint>0 ||
        !knownAbilityPartitionContains(state, casterIndex, abilityCode) ||
        !catalogAdmission(state, casterIndex, abilityCode, "", false)) {
        return;
    }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    if (rank <= 0 || m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage" ||
        <float>state.entityResources[casterIndex] <
            <int>m4AbilityCatalog.metric(abilityIndex, level, "cost") ||
        shadowBoltTargetIndex(state, casterIndex, targetId) < 0) {
        return;
    }
    var cast = loadCastingState(state, casterIndex);
    cast.armTimed(
        abilityCode,
        shadowBoltCastSeconds(state, casterIndex, abilityIndex),
        shadowBoltGlobalCooldownSeconds(state, casterIndex),
        false
    );
    cast.lockTargets(false, true);
    storeCastingState(state, casterIndex, cast);
    state.entityCastTargetIds[casterIndex] = targetId;
    state.entitySitting[casterIndex] = false;
    state.entityWeaponStowed[casterIndex] = false;
}

completeOfflineShadowBoltCast(state: WorldState, casterIndex: int): void {
    var m4AbilityEffects = %import("generated/m4_ability_effects");
    var abilityCode = shadowBoltAbilityCode();
    var abilityIndex = m4AbilityCatalog.indexOf("shadow_bolt");
    var targetId = <uint>state.entityCastTargetIds[casterIndex];
    state.entityCastTargetIds[casterIndex] = <uint>0;
    var targetIndex = shadowBoltCompletionTargetIndex(state, casterIndex, targetId);
    if (abilityIndex < 0 || targetIndex < 0) { return; }
    var level = <int>state.entityLevels[casterIndex];
    var rank = m4AbilityCatalog.rankAtLevel(abilityIndex, level);
    var cost = <int>m4AbilityCatalog.metric(abilityIndex, level, "cost");
    if (rank <= 0 || <float>state.entityResources[casterIndex] < cost ||
        m4AbilityEffects.typeAt(abilityIndex, rank, 0) != "directDamage") {
        return;
    }
    spendOfflineAbilityResource(state, casterIndex, cost);
    appendOfflineAbilityProjectile(
        state,
        <uint>state.entityIds[casterIndex],
        targetId,
        <float>state.entityX[casterIndex],
        <float>state.entityZ[casterIndex],
        m4AbilityEffects.metric(abilityIndex, rank, 0, "min"),
        m4AbilityEffects.metric(abilityIndex, rank, 0, "max"),
        projectileTravel.projectileSpeed(),
        false,
        OFFLINE_PROJECTILE_SCHOOL_SHADOW,
        abilityCode,
        <uint>rank,
        m4AbilityCatalog.metric(abilityIndex, level, "castTime")
    );
}

