    var abilityIndex = m4AbilityCatalog.indexOf("tigers_fury");
    if (feral == <uint>0 || tigersFury == <uint>0 || cat == <uint>0 ||
        !tigersFuryProfileIsValid(abilityIndex, 20)) { return -2; }

    var state = new WorldState();
    state.offlineSessionActive = true;
    state.offlinePlayerClass = <uint>8;
    var playerId = state.spawnPlayer(<uint>5, 20, 0.0, 1.5, 0.0, 100, 7.0, 1);
    state.entityActiveFormAbilityCodes[0] = cat;
    state.entityResourceKinds[0] = formTransitions.energyResourceKind();
    state.entityResources[0] = 30;
    state.entityMaxResources[0] = 100;
    state.entityAttackPower[0] = 100;
    state.entityKnownAbilityCodes.add(tigersFury);
    var offset = 1;
    while (offset < state.entityKnownAbilityOffsets.length) {
        state.entityKnownAbilityOffsets[offset] = <uint>1;
        offset = offset + 1;
    }
    if (playerId == <uint>0 || !replaceOfflineTalentAllocation(
            state, 0, feral, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || !knownAbilityPartitionContains(state, 0, tigersFury)) {
        return -3;
    }

    startOfflineTigersFuryCast(state, 0);
    if (state.entityMotionAuraAbilityCodes.length != 1 ||
        <float>state.entityMotionAuraValues[0] != 46.0 ||
        <int>state.entityTigersFuryResolvedAttackPower[0] != 46 ||
        <uint>state.entityTigersFuryTalentSpecCodes[0] != feral ||
        !floatMatches(effectiveOfflineAttackPower(state, 0), 146.0) ||
        tigersFuryTalentStateIsSchema110Compatible(state) ||
        !tigersFuryTalentStateIsValid(state)) {
        return -4;
    }
    if (!replaceOfflineTalentAllocation(
            state, 0, <uint>0, <uint>0, <uint>0, <uint>0,
            <uint>0, <uint>0, <uint>0
        ) || <uint>state.entityTigersFuryTalentSpecCodes[0] != feral ||
        <float>state.entityMotionAuraValues[0] != 46.0 ||
        !floatMatches(effectiveOfflineAttackPower(state, 0), 146.0) ||
        !tigersFuryTalentStateIsValid(state)) {
        return -5;
    }

    var restored = decodeState(encodeState(state));
    if (<int>restored.entityTigersFuryResolvedAttackPower[0] != 46 ||
        <uint>restored.entityTigersFuryTalentSpecCodes[0] != feral ||
        <float>restored.entityMotionAuraValues[0] != 46.0 ||
        !floatMatches(effectiveOfflineAttackPower(restored, 0), 146.0) ||
        !tigersFuryTalentStateIsValid(restored)) {
        return -6;
    }
    var tampered = decodeState(encodeState(restored));
    tampered.entityTigersFuryResolvedAttackPower[0] = 47;
    if (tigersFuryTalentStateIsValid(tampered)) { return -7; }

    restored.entityMotionAuraRemaining[0] = 0.05;
    ageMotionAurasForEntity(restored, 0);
    if (restored.entityMotionAuraAbilityCodes.length != 0 ||
        <int>restored.entityTigersFuryResolvedAttackPower[0] != 0 ||
        !offlineTigersFuryTalentSnapshotIsEmpty(restored, 0) ||
        !tigersFuryTalentStateIsSchema110Compatible(restored)) {
        return -8;
    }
    restored.timeMicros = abilityCooldownExpiresAt(restored, 0, tigersFury);
    restored.entityCastGcdRemaining[0] = 0.0;
    restored.entityResources[0] = 30;
    startOfflineTigersFuryCast(restored, 0);
    if (restored.entityMotionAuraAbilityCodes.length != 1 ||
        <float>restored.entityMotionAuraValues[0] != 40.0 ||
        <int>restored.entityTigersFuryResolvedAttackPower[0] != 40 ||
        !offlineTigersFuryTalentSnapshotIsEmpty(restored, 0) ||
        !floatMatches(effectiveOfflineAttackPower(restored, 0), 140.0) ||
        !tigersFuryTalentStateIsSchema110Compatible(restored)) {
        return -9;
    }
    var legacy = decodeState(encodeStateVersion(restored, <uint>110));
    return <float>legacy.entityMotionAuraValues[0] == 40.0 &&
        <int>legacy.entityTigersFuryResolvedAttackPower[0] == 40 &&
        offlineTigersFuryTalentSnapshotIsEmpty(legacy, 0) &&
        tigersFuryTalentStateIsValid(legacy) ? 1 : -10;
}

