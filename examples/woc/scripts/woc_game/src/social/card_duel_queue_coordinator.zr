// Current-head Card Duel queue orchestration from card_duel.ts. The world
// reducer owns entity liveness, NPC range and match storage; this module
// receives those predicates explicitly and preserves source FIFO behavior.
var container = %import("zr.container");
var queueModule = %import("social/card_duel_queue");

pub class CardDuelQueueCandidate {
    pub var pid: uint;
    // A human, live player that can be matched. Fiesta/Vale Cup bots and dead
    // players must be represented as false before they reach this coordinator.
    pub var queueable: bool;
    pub var queued: bool;
    pub var queueSlot: int;
    pub var queueGeneration: uint;
    pub var purgePending: bool;

    pub @constructor() {
        this.pid = <uint>0;
        this.queueable = false;
        this.queued = false;
        this.queueSlot = -1;
        this.queueGeneration = <uint>0;
        this.purgePending = false;
    }
}

pub class CardDuelQueueCoordinator {
    pri var candidates: container.Array<CardDuelQueueCandidate>;
    pri var queue: queueModule.CardDuelQueue;
    pri var pendingPurgeCandidateIndexes: container.Array<int>;

    pub @constructor() {
        this.candidates = new container.Array<CardDuelQueueCandidate>();
        this.queue = new queueModule.CardDuelQueue();
        this.pendingPurgeCandidateIndexes = new container.Array<int>();
    }

    pri candidateIndex(pid: uint): int {
        var index = 0;
        while (index < this.candidates.length) {
            if (<uint>this.candidates[index].pid == pid) return index;
            index = index + 1;
        }
        return -1;
    }

    pri clearQueueHandle(candidate: CardDuelQueueCandidate): void {
        candidate.queued = false;
        candidate.queueSlot = -1;
        candidate.queueGeneration = <uint>0;
    }

    pub upsert(pid: uint, queueable: bool): void {
        if (pid == <uint>0) throw "card duel candidate id is invalid";
        var index = this.candidateIndex(pid);
        if (index >= 0) {
            var existing = this.candidates[index];
            existing.queueable = queueable;
            if (!queueable && existing.queued && !existing.purgePending) {
                existing.purgePending = true;
                this.pendingPurgeCandidateIndexes.add(index);
            }
            return;
        }
        var candidate = new CardDuelQueueCandidate();
        candidate.pid = pid;
        candidate.queueable = queueable;
        this.candidates.add(candidate);
    }

    pub isQueueable(pid: uint): bool {
        var index = this.candidateIndex(pid);
        return index >= 0 && this.candidates[index].queueable;
    }

    // Matches the source's availability gate: another queueable human must
    // exist, but nobody needs to have joined the queue yet.
    pub availableFor(pid: uint): bool {
        var index = 0;
        while (index < this.candidates.length) {
            var candidate = this.candidates[index];
            if (<uint>candidate.pid != pid && candidate.queueable) return true;
            index = index + 1;
        }
        return false;
    }

    // Returns CardDuelQueue's 1/0/-1 outcomes after the source preconditions;
    // -2 is out of Card Master range, -3 has no possible opponent and -4 is
    // an unknown/non-queueable player.
    pub join(pid: uint, cardMasterInRange: bool, alreadyInDuel: bool): int {
        var index = this.candidateIndex(pid);
        if (index < 0 || !this.candidates[index].queueable) return -4;
        if (!cardMasterInRange) return -2;
        if (!this.availableFor(pid)) return -3;
        var candidate = this.candidates[index];
        var admission = this.queue.joinTracked(
            pid, alreadyInDuel, candidate.queued, index
        );
        if (admission.status == 1) {
            candidate.queued = true;
            candidate.queueSlot = admission.slot;
            candidate.queueGeneration = admission.generation;
        }
        return admission.status;
    }

    pub leave(pid: uint): bool {
        var index = this.candidateIndex(pid);
        if (index < 0 || !this.candidates[index].queued) return false;
        var candidate = this.candidates[index];
        if (!this.queue.leaveTracked(
                candidate.queueSlot, candidate.queueGeneration, pid
            )) {
            throw "card duel candidate queue handle is stale";
        }
        this.clearQueueHandle(candidate);
        return true;
    }

    pub queued(pid: uint): bool {
        var index = this.candidateIndex(pid);
        return index >= 0 && this.candidates[index].queued;
    }

    pub size(): int {
        return this.queue.size();
    }

    // A queue snapshot is FIFO ordered. It carries only player ids; candidate
    // liveness is restored by CardDuelService before this list is accepted.
    pub snapshotEntries(): container.Array<uint> {
        return this.queue.snapshotEntries();
    }

    pub restoreEntries(entries: container.Array<uint>): void {
        this.queue = new queueModule.CardDuelQueue();
        this.pendingPurgeCandidateIndexes = new container.Array<int>();
        for (var candidate in this.candidates) {
            this.clearQueueHandle(candidate);
            candidate.purgePending = false;
        }
        for (var pid in entries) {
            var index = this.candidateIndex(<uint>pid);
            if (pid == <uint>0 || index < 0 ||
                !this.candidates[index].queueable || this.candidates[index].queued) {
                throw "card duel queue snapshot is invalid";
            }
            var admission = this.queue.joinTracked(<uint>pid, false, false, index);
            if (admission.status != 1) {
                throw "card duel queue snapshot could not restore";
            }
            var candidate = this.candidates[index];
            candidate.queued = true;
            candidate.queueSlot = admission.slot;
            candidate.queueGeneration = admission.generation;
        }
    }

    // Queueability transitions are recorded once by upsert. Draining this
    // small dirty list preserves update-time purge semantics without rescans.
    pub purgeUnqueueable(): void {
        while (this.pendingPurgeCandidateIndexes.length > 0) {
            var pendingIndex = this.pendingPurgeCandidateIndexes.length - 1;
            var index = <int>this.pendingPurgeCandidateIndexes[pendingIndex];
            this.pendingPurgeCandidateIndexes.removeAt(pendingIndex);
            var candidate = this.candidates[index];
            candidate.purgePending = false;
            if (!candidate.queueable && candidate.queued) {
                if (!this.queue.leaveTracked(
                        candidate.queueSlot, candidate.queueGeneration, candidate.pid
                    )) {
                    throw "card duel purge queue handle is stale";
                }
                this.clearQueueHandle(candidate);
            }
        }
    }

    pub pairNext(): queueModule.CardDuelPair {
        this.purgeUnqueueable();
        var pair = this.queue.pairFirst();
        if (!pair.ready) return pair;
        if (pair.aOwnerIndex < 0 || pair.aOwnerIndex >= this.candidates.length ||
            pair.bOwnerIndex < 0 || pair.bOwnerIndex >= this.candidates.length ||
            <uint>this.candidates[pair.aOwnerIndex].pid != pair.a ||
            <uint>this.candidates[pair.bOwnerIndex].pid != pair.b) {
            throw "card duel pair owner index is invalid";
        }
        this.clearQueueHandle(this.candidates[pair.aOwnerIndex]);
        this.clearQueueHandle(this.candidates[pair.bOwnerIndex]);
        return pair;
    }
}
