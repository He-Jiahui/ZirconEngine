// Source-pinned $WOC Protect Yumi! FIFO first-fit queue packing from
// social/yumi.ts. This leaf owns no match, player liveness, rating mutation or
// queue removal: it deterministically selects the source queue-unit indexes
// that a host transaction may later seat into a yumi3/yumi5 arena match.
var container = %import("zr.container");

pub class YumiQueueUnit {
    pub var pids: container.Array<int>;
    pub var rating: int;

    pub @constructor() {
        this.pids = new container.Array<int>();
        this.rating = 0;
    }
}

pub class YumiPackedTeams {
    pub var teamAUnitIndexes: container.Array<int>;
    pub var teamBUnitIndexes: container.Array<int>;
    pub var teamAPids: container.Array<int>;
    pub var teamBPids: container.Array<int>;

    pub @constructor() {
        this.teamAUnitIndexes = new container.Array<int>();
        this.teamBUnitIndexes = new container.Array<int>();
        this.teamAPids = new container.Array<int>();
        this.teamBPids = new container.Array<int>();
    }
}

pub createYumiQueueUnit(rating: int): YumiQueueUnit {
    var unit = new YumiQueueUnit();
    unit.rating = rating;
    return unit;
}

pub addYumiQueuePlayer(unit: YumiQueueUnit, pid: int): void {
    unit.pids.add(pid);
}

clearPacked(result: YumiPackedTeams): void {
    result.teamAUnitIndexes.clear();
    result.teamBUnitIndexes.clear();
    result.teamAPids.clear();
    result.teamBPids.clear();
}

appendUnitPids(target: container.Array<int>, unit: YumiQueueUnit): void {
    var index = 0;
    while (index < unit.pids.length) {
        target.add(<int>unit.pids[index]);
        index = index + 1;
    }
}

// Exact source packYumiTeams() unit traversal: arrival order is the fairness
// rule; each unit is placed into A first, then B, and unseatable units are
// skipped while later units continue to be considered. false is source null.
pub packYumiTeams(
    queue: container.Array<YumiQueueUnit>,
    teamSize: int,
    result: YumiPackedTeams
): bool {
    clearPacked(result);
    var countA = 0;
    var countB = 0;
    var index = 0;
    while (index < queue.length) {
        var unit = <YumiQueueUnit>queue[index];
        var unitSize = unit.pids.length;
        if (countA + unitSize <= teamSize) {
            result.teamAUnitIndexes.add(index);
            appendUnitPids(result.teamAPids, unit);
            countA = countA + unitSize;
        } else if (countB + unitSize <= teamSize) {
            result.teamBUnitIndexes.add(index);
            appendUnitPids(result.teamBPids, unit);
            countB = countB + unitSize;
        }
        if (countA == teamSize && countB == teamSize) { return true; }
        index = index + 1;
    }
    clearPacked(result);
    return false;
}

unitIndexAt(indexes: container.Array<int>, index: int): int {
    if (index < 0 || index >= indexes.length) { return -1; }
    return <int>indexes[index];
}

pidAt(pids: container.Array<int>, index: int): int {
    if (index < 0 || index >= pids.length) { return 0; }
    return <int>pids[index];
}

pub packedTeamAUnitIndex(result: YumiPackedTeams, index: int): int {
    return unitIndexAt(result.teamAUnitIndexes, index);
}

pub packedTeamBUnitIndex(result: YumiPackedTeams, index: int): int {
    return unitIndexAt(result.teamBUnitIndexes, index);
}

pub packedTeamAPid(result: YumiPackedTeams, index: int): int {
    return pidAt(result.teamAPids, index);
}

pub packedTeamBPid(result: YumiPackedTeams, index: int): int {
    return pidAt(result.teamBPids, index);
}

addUnit(queue: container.Array<YumiQueueUnit>, rating: int, first: int, second: int, third: int): void {
    var unit = createYumiQueueUnit(rating);
    if (first > 0) addYumiQueuePlayer(unit, first);
    if (second > 0) addYumiQueuePlayer(unit, second);
    if (third > 0) addYumiQueuePlayer(unit, third);
    queue.add(unit);
}

pub contractTest(): int {
    var first = new container.Array<YumiQueueUnit>();
    addUnit(first, 1, 1, 2, 3);
    addUnit(first, 2, 4, 0, 0);
    addUnit(first, 3, 5, 0, 0);
    addUnit(first, 4, 6, 0, 0);
    var packed = new YumiPackedTeams();
    if (!packYumiTeams(first, 3, packed) ||
        packed.teamAUnitIndexes.length != 1 || packed.teamBUnitIndexes.length != 3 ||
        packedTeamAUnitIndex(packed, 0) != 0 ||
        packedTeamBUnitIndex(packed, 0) != 1 || packedTeamBUnitIndex(packed, 2) != 3 ||
        packed.teamAPids.length != 3 || packed.teamBPids.length != 3 ||
        packedTeamAPid(packed, 0) != 1 || packedTeamAPid(packed, 2) != 3 ||
        packedTeamBPid(packed, 0) != 4 || packedTeamBPid(packed, 2) != 6) { return -1; }
    var second = new container.Array<YumiQueueUnit>();
    addUnit(second, 1, 1, 2, 0);
    addUnit(second, 2, 3, 4, 0);
    addUnit(second, 3, 5, 0, 0);
    addUnit(second, 4, 6, 0, 0);
    if (!packYumiTeams(second, 3, packed) ||
        packedTeamAUnitIndex(packed, 0) != 0 || packedTeamAUnitIndex(packed, 1) != 2 ||
        packedTeamBUnitIndex(packed, 0) != 1 || packedTeamBUnitIndex(packed, 1) != 3 ||
        packedTeamAPid(packed, 0) != 1 || packedTeamAPid(packed, 2) != 5 ||
        packedTeamBPid(packed, 0) != 3 || packedTeamBPid(packed, 2) != 6) { return -2; }
    var insufficient = new container.Array<YumiQueueUnit>();
    addUnit(insufficient, 1, 1, 2, 3);
    addUnit(insufficient, 2, 4, 0, 0);
    if (packYumiTeams(insufficient, 3, packed) ||
        packed.teamAUnitIndexes.length != 0 || packed.teamBUnitIndexes.length != 0 ||
        packed.teamAPids.length != 0 || packed.teamBPids.length != 0) { return -3; }
    return 1;
}
