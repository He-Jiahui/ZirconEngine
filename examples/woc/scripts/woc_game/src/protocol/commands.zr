    return id == <uint>6 || id == <uint>76 || id == <uint>106 || id == <uint>107 || id == <uint>108 || id == <uint>109 || id == <uint>110 || id == <uint>111 || id == <uint>113;
}

pub count(a: int, b: int, c: int, d: int, e: int, f: int): int {
    if (a != 1 || b != 1 || c != 2 || d != 3 || e != 5 || f != 8) {
        throw "WOC command count marker is invalid";
    }
    return 165;
}

pub contractTest(a: int, b: int, c: int, d: int, e: int, f: int, g: int): int {
    if (a != 1 || b != 1 || c != 2 || d != 3 || e != 5 || f != 8 || g != 13) {
        return -1;
    }
    if (count(1, 1, 2, 3, 5, 8) != 165 ||
        fingerprintHex(1, 1, 2, 3, 5, 8, 13, 21) != "3660a0d84f3f85a" ||
        name(<uint>0, true) != "castSlot" ||
        name(<uint>164, true) != "resurrect_respond" ||
        name(<uint>163, true) != "selectTalentRow" ||
        isKnown(<uint>165) || facet(<uint>42, 1, 1, 2) != "IWorldParty") {
        return -2;
    }
    var dispatchCount = 0;
    var id: uint = <uint>0;
    while (id < <uint>165) {
        if (name(id, true).length <= 0 || kind(id, 1, 1).length <= 0) { return -3; }
        if (isDispatchOnly(id, 1, 1, 2, 3)) { dispatchCount = dispatchCount + 1; }
        id = id + <uint>1;
    }
    return dispatchCount == 9 ? 1 : -4;
}
