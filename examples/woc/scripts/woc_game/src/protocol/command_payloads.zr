// kind: 1 empty, 2 target_entity, 3 slot_index, 4 utf8_id,
// 5 u32_index, 6 utf8_id_optional_u32, 7 lockpick_engage,
// 8 lockpick_action, 9 optional_utf8_id, 10 utf8_id_f64_pair,
// 11 utf8_id_optional_utf8_id, 12 talent_row_selection, 13 talent_spec,
// 14 talent_allocation, 15 cosmetic_skin, 16 boolean,
// 17 utf8_id_optional_target_entity, 18 target_entity_raid_group,
// 19 i32_value, 20 guild_event_create, 46 linked_quest_acceptance,
// 53 town_focus_allocation, 54 chat_text, 55 utf8_id_pair, 58 mail_send,
// 59 market_search, 60 trade_offer, 61 challenge_response,
// 0 not yet ported.
pub payloadKind(id: uint, marker: int): int {
    if (marker != 1) { throw "WOC command payload kind marker is invalid"; }
    if (id == <uint>0) { return 19; }
    if (id == <uint>1) { return 10; }
    if (id == <uint>2) { return 17; }
    if (id == <uint>3) { return 4; }
    if (id == <uint>4) { return 2; }
    if (id == <uint>5) { return 1; }
    if (id == <uint>6) { return 1; }
    if (id == <uint>7) { return 1; }
    if (id == <uint>8) { return 1; }
    if (id == <uint>9) { return 1; }
