pub abilityRankAtLevel(index: int, level: int): int {
    if (index == 0) {
        if (level < 5) { return 0; }
        return 1;
    }
    if (index == 1) {
        if (level < 5) { return 0; }
        return 1;
    }
    if (index == 2) {
        if (level < 2) { return 0; }
        if (level >= 16) { return 2; }
        return 1;
    }
    throw "unknown WOC M5 ability index";
}
