pub mobLootCount(index: int): int {
    if (index == 0) { return 4; }
    throw "unknown WOC M5 mob index";
}

pub mobLootText(index: int, lootIndex: int, field: string): string {
    if (index == 0) {
        if (lootIndex == 0) {
            return "";
        }
        if (lootIndex == 1) {
            if (field == "itemId") { return "wolf_fang"; }
            return "";
        }
        if (lootIndex == 2) {
            if (field == "itemId") { return "milepost_boots"; }
            return "";
        }
        if (lootIndex == 3) {
            if (field == "itemId") { return "wolfhide_satchel"; }
            return "";
        }
        throw "unknown WOC M5 mob loot index";
    }
    throw "unknown WOC M5 mob index";
}

pub mobLootMetric(index: int, lootIndex: int, field: string): float {
    if (index == 0) {
        if (lootIndex == 0) {
            if (field == "copper") { return 8.0; }
            if (field == "chance") { return 1.0; }
            return 0.0;
        }
        if (lootIndex == 1) {
            if (field == "chance") { return 0.45; }
            return 0.0;
        }
        if (lootIndex == 2) {
            if (field == "chance") { return 0.1; }
            return 0.0;
        }
        if (lootIndex == 3) {
            if (field == "chance") { return 0.02; }
            return 0.0;
        }
        throw "unknown WOC M5 mob loot index";
    }
    throw "unknown WOC M5 mob index";
}

