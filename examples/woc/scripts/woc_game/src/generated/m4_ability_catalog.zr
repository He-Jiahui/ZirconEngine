pub text(index: int, field: string): string {
    if (index == 0) {
        if (field == "id") { return "heroic_strike"; }
        if (field == "name") { return "Reaver Strike"; }
        if (field == "class") { return "warrior"; }
        if (field == "school") { return "physical"; }
        if (field == "scalesWith") { return ""; }
        if (field == "targetType") { return "enemy"; }
        if (field == "targetMode") { return "entity"; }
        if (field == "description") { return "A strong attack that increases melee damage by $d. Activates on your next swing."; }
        throw "unknown WOC M4 ability text field";
    }
    if (index == 1) {
        if (field == "id") { return "fireball"; }
        if (field == "name") { return "Cinderbolt"; }
        if (field == "class") { return "mage"; }
        if (field == "school") { return "fire"; }
        if (field == "scalesWith") { return ""; }
        if (field == "targetType") { return "enemy"; }
        if (field == "targetMode") { return "entity"; }
        if (field == "description") { return "Hurls a fiery ball that causes $d Fire damage plus additional damage over time."; }
        throw "unknown WOC M4 ability text field";
