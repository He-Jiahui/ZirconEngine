pub contractTest(): int {
    if (catalogSha() != "2e3e5c235d2590839f6844c6720a4ab53ea9bfbd0d576b516a5747d3d4716802" || classCount() != 9 || levelCap() != 20) { return -1; }
    if (classIndex("warrior") != 0 || classIndex("druid") != 8 || classIndex("missing") != -1 ||
        classInteger(0, 1, "maxHp") != 90 ||
        classInteger(0, levelCap(), "maxHp") != 812 ||
        classInteger(0, levelCap(), "attackPower") != 122) { return -2; }
    var mageIndex = classIndex("mage");
    if (mageIndex != 1 ||
        classInteger(mageIndex, 1, "maxResource") != 195 ||
        classInteger(mageIndex, levelCap(), "maxResource") != 1506 ||
        classInteger(mageIndex, levelCap(), "spellPower") != 41 ||
        classDecimal(mageIndex, levelCap(), "weaponSpeed") != 2.9) { return -3; }
    if (classInteger(4, levelCap(), "rangedPower") != 164 ||
        classDecimal(4, levelCap(), "moveSpeed") != 7.0) { return -4; }
    if (startingEquipmentText(0, "mainhand") != "worn_sword" ||
        startingEquipmentInteger(0, "mainhand", "weaponMin") != 2 ||
        startingEquipmentDecimal(0, "mainhand", "weaponSpeed") != 2.0 ||
        startingEquipmentText(mageIndex, "mainhand") != "gnarled_staff" ||
        startingEquipmentInteger(mageIndex, "mainhand", "statInt") != 1) { return -5; }
    var index = 0;
    while (index < classCount()) {
        if (classIndex(classId(index)) != index) { return -6; }
        index = index + 1;
    }
    return 1;
}
