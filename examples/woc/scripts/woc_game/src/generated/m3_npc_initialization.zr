    if (index == 15) { return "Mind the thicket west of the road. The webs are thick as sailcloth this season."; }
    if (index == 16) { return "Quiet feet and a short blade keep you breathing out here. Speak quick — I am due back in the reeds."; }
    if (index == 17) { return "The Gilded Strongbox keeps clean ledgers and cleaner vaults. What shall we stow for you?"; }
    if (index == 18) { return "Mind the damp on the pages, $N. The fen eats more books than readers ever will."; }
    if (index == 19) { return "Two hundred years this wall has held, $C. It will not break on my watch — but it groans."; }
    if (index == 20) { return "From a chapel yard in the Vale to the roof of the world... the trail we have followed ends here. I can feel the mountain listening."; }
    if (index == 21) { return "From a chapel yard in the Vale to the roof of the world... the trail we have followed ends here. I can feel the mountain listening."; }
    if (index == 22) { return "I tracked cultists through the fen at your side, and the trail led here. The peaks are worse, $C. Stay sharp."; }
    if (index == 23) { return "Wool, hardtack, and steel-shod boots — Highwatch runs on all three, and I am short of everything."; }
    if (index == 24) { return "Forge is hot and the grindstone is turning. If it cuts, I sell it."; }
    if (index == 25) { return "Proof of the heroic depths buys the finest rings and pendants in Highwatch. Show me your marks."; }
    if (index == 26) { return "Mind the loose shale, $C. The mountain has been... restless of late. I intend to learn why."; }
    if (index == 27) { return "The World Market is open here too, $C. Buy from every adventurer in the realm, or set out your own wares."; }
    if (index == 28) { return "Every crate, coffer, and trinket is safe with the Gilded Strongbox."; }
    if (index == 29) { return "The mountain forgets nothing, $N, and neither do I. Let us see what you have done."; }
    if (index == 30) { return "The mere drinks the moonlight, $C, and gives back the drowned. I have watched that gate for thirty nights — and tonight it is open."; }
    if (index == 31) { return "The sands remember every victory. Spend your honor well."; }
    if (index == 32) { return "The reliquary below has shifted again."; }
    if (index == 33) { return "The trail led north. Another reliquary, another rite. Choose your tier, and I'll hold the rope until you return."; }
    if (index == 34) { return "Rest now, spirit. I can return you to your body, but the crossing back leaves you weak."; }
    }
