pub contractTest(): int {
    if (catalogSha() != "5a0d990c8b72bf655a66f6eb510014dbb5ebe5e5273a0a6e3c608195d0874f7c" || campCount() != 4 || spawnCount() != 24) { return -1; }
    if (campMobId(0) != "forest_wolf" || campMemberCount(0) != 7 || campSourceIndex(0) != 0 ||
        campMobId(3) != "wild_boar" || campMemberCount(3) != 5 || campSourceIndex(3) != 4) { return -2; }
    if (sourceEntityId(0) != 32 || mobId(0) != "forest_wolf" || level(0) != 1 ||
        x(0) != -11.218006452547318 || y(0) != -0.6134338027064364 || z(0) != 64.69484230798517 ||
        maxHp(0) != 40 || moveSpeed(0) != 8.0 ||
        resourceKind(0) != <uint>0 ||
        facing(0) != -2.241543395702632 || wanderTimer(0) != 7.203460566699505 ||
        combatInteger(0, "weaponMin") != 2 ||
        combatInteger(0, "armor") != 0 ||
        combatDecimal(0, "weaponSpeed") != 2.0 ||
        combatFlag(0, "dualWielding") || combatStateFlag(0, "inCombat") ||
        combatStateDecimal(0, "combatTimer") != 99.0 ||
        combatStateTargetId(0) != <uint>0 ||
        locomotionRecoveryFlag(0, "leashAnchorPresent") ||
        locomotionRecoveryFlag(0, "hasFled") ||
        locomotionRecoveryDecimal(0, "fleeTimer") != 0.0 ||
        forcedTargetId(0) != <uint>0 ||
        forcedTargetDecimal(0, "forcedTargetTimer") != 0.0 ||
        resourceCooldownInteger(0, "comboPoints") != 0 ||
        resourceCooldownDecimal(0, "fiveSecondRule") != 99.0 ||
        castChargeTargetFlag(0, "castAimPresent") ||
        castChargeTargetDecimal(0, "chargeTimeLeft") != 0.0 ||
        castChargeTargetId(0, "chargeTargetId") != <uint>0) { return -3; }
    if (sourceEntityId(13) != 46 || mobId(13) != "wild_boar" || level(13) != 2 ||
        maxHp(13) != 54 || moveSpeed(13) != 7.5 ||
        combatInteger(13, "weaponMax") != 7 ||
        combatDecimal(13, "critChance") != 0.05) { return -4; }
    if (sourceEntityId(23) != 56 || sourceCampIndex(23) != 4 ||
        campMemberIndex(23) != 4 || mobId(23) != "wild_boar") { return -5; }
    var index = 0;
    while (index < spawnCount()) {
        if (level(index) < 1 || maxHp(index) < 1 || moveSpeed(index) <= 0.0 ||
            campMemberIndex(index) < 0 || sourceCampIndex(index) < 0) { return -6; }
        index = index + 1;
    }
    return 1;
}
