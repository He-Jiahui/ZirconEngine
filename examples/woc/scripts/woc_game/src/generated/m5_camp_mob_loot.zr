pub entryText(mobIndex: int, entryIndex: int, field: string, required: bool): string {
    if (!required || !mobIndexIsValid(mobIndex)) { throw "woc camp mob loot query is invalid"; }
    if (mobIndex == 0) {
        if (entryIndex == 0) {
            if (field == "item_id") { return ""; }
            if (field == "quest_id") { return ""; }
            if (field == "roll_group") { return ""; }
            return "";
        }
        if (entryIndex == 1) {
            if (field == "item_id") { return "wolf_fang"; }
            if (field == "quest_id") { return ""; }
            if (field == "roll_group") { return ""; }
            return "";
        }
        if (entryIndex == 2) {
            if (field == "item_id") { return "milepost_boots"; }
            if (field == "quest_id") { return ""; }
            if (field == "roll_group") { return ""; }
            return "";
        }
        if (entryIndex == 3) {
            if (field == "item_id") { return "wolfhide_satchel"; }
            if (field == "quest_id") { return ""; }
            if (field == "roll_group") { return ""; }
            return "";
        }
        throw "woc camp mob loot entry index is invalid";
    }
    if (mobIndex == 1) {
