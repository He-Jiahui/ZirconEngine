pub hasExcludedSpecs(code: int): bool {
    if (code == 21) { return true; }
    if (code == 118) { return true; }
    if (code == 143) { return true; }
    if (code == 191) { return true; }
    return false;
}

pub matchesExcludedSpec(code: int, spec: string): bool {
    if (code == 21) { return spec == "fury"; }
    if (code == 118) { return spec == "fire" || spec == "arcane"; }
    if (code == 143) { return spec == "prot" || spec == "arms" || spec == "fury"; }
    if (code == 191) { return spec == "fury" || spec == "prot"; }
    return false;
}

pub excludeAtLevel(code: int): int {
    if (code == 21) { return 0; }
    if (code == 118) { return 0; }
    if (code == 143) { return 0; }
    if (code == 191) { return 10; }
    return 0;
}

pub isKnownAt(code: int, level: int, granted: bool, committedSpec: string): bool {
    if (!abilityExists(code)) { return false; }
    if (granted) { return true; }
    if (learnLevel(code) > level) { return false; }
    if (hasRequiredSpecs(code) && !matchesRequiredSpec(code, committedSpec)) { return false; }
    if (hasExcludedSpecs(code) && matchesExcludedSpec(code, committedSpec) &&
        level >= excludeAtLevel(code)) { return false; }
    return true;
}

pub classId(index: int): string {
    if (index == 0) { return "warrior"; }
    if (index == 1) { return "mage"; }
    if (index == 2) { return "rogue"; }
    if (index == 3) { return "paladin"; }
    if (index == 4) { return "hunter"; }
    if (index == 5) { return "priest"; }
    if (index == 6) { return "shaman"; }
    if (index == 7) { return "warlock"; }
    if (index == 8) { return "druid"; }
    return "";
}

pub classIndex(id: string): int {
    if (id == "warrior") { return 0; }
    if (id == "mage") { return 1; }
    if (id == "rogue") { return 2; }
    if (id == "paladin") { return 3; }
    if (id == "hunter") { return 4; }
    if (id == "priest") { return 5; }
    if (id == "shaman") { return 6; }
    if (id == "warlock") { return 7; }
    if (id == "druid") { return 8; }
    return -1;
}

pub classAbilityCount(classIndex: int): int {
    if (classIndex == 0) { return 39; }
