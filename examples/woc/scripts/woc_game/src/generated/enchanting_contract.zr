pub materialForQuality(quality: string): string {
    if (quality == "common") return "arcane_dust";
    if (quality == "uncommon") return "arcane_dust";
    if (quality == "rare") return "arcane_essence";
    if (quality == "epic") return "arcane_shard";
    if (quality == "legendary") return "arcane_shard";
    return "arcane_dust";
}
