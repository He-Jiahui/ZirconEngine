pub contractTest(): int {
    if (catalogSha() != "fcded2766235cb323e9b981c9802a24be282b95723000391090268668dcf6c6a" || classCount() != 9) { return -1; }
    if (classIndex("warrior") != 0 || classIndex("druid") != 8 || classIndex("missing") != -1 ||
        classInteger(0, "maxHp") != 90 ||
        classInteger(0, "statArmor") != 110 ||
        classInteger(0, "attackPower") != 46 ||
        resourceKind(0) != <uint>2) { return -2; }
    var mageIndex = classIndex("mage");
    if (mageIndex != 1 ||
        classInteger(mageIndex, "maxResource") != 195 ||
        classInteger(mageIndex, "spellPower") != 13 ||
        classDecimal(mageIndex, "weaponSpeed") != 2.9 ||
        combatInteger(mageIndex, "armor") != 57 ||
        combatDecimal(mageIndex, "meleeHaste") != 0.0 ||
        combatFlag(mageIndex, "dualWielding") || combatStateFlag(mageIndex, "inCombat") ||
        combatStateDecimal(mageIndex, "combatTimer") != 99.0 ||
        combatStateTargetId(mageIndex) != <uint>0 ||
        locomotionRecoveryFlag(mageIndex, "leashAnchorPresent") ||
        locomotionRecoveryFlag(mageIndex, "hasFled") ||
        locomotionRecoveryDecimal(mageIndex, "fleeTimer") != 0.0 ||
        forcedTargetId(mageIndex) != <uint>0 ||
        forcedTargetDecimal(mageIndex, "forcedTargetTimer") != 0.0 ||
        resourceCooldownInteger(mageIndex, "comboPoints") != 0 ||
        resourceCooldownDecimal(mageIndex, "fiveSecondRule") != 99.0 ||
        castChargeTargetFlag(mageIndex, "castAimPresent") ||
        castChargeTargetDecimal(mageIndex, "chargeTimeLeft") != 0.0 ||
        castChargeTargetId(mageIndex, "chargeTargetId") != <uint>0) { return -3; }
    if (classInteger(4, "rangedPower") != 50 ||
        classDecimal(4, "moveSpeed") != 7.0) { return -4; }
    var index = 0;
    while (index < classCount()) {
        if (classIndex(classId(index)) != index) { return -5; }
        index = index + 1;
    }
    return 1;
}
