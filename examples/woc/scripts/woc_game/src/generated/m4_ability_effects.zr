pub flag(index: int, rank: int, effect: int, field: string): bool {
    if (
        field != "requiresBehind"
    ) { throw "unknown WOC M4 effect flag field"; }
    if (index == 0) {
        if (rank == 1) {
            if (effect == 0) {
                if (field == "requiresBehind") { return false; }
                return false;
