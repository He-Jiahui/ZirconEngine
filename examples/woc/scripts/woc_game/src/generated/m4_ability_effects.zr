pub metric(index: int, rank: int, effect: int, field: string): float {
    if (
        field != "amount" &&
        field != "armor" &&
        field != "base" &&
        field != "bonus" &&
        field != "duration" &&
        field != "healFrac" &&
        field != "hp" &&
        field != "interval" &&
        field != "judgeMax" &&
        field != "judgeMin" &&
        field != "leechPct" &&
        field != "lockout" &&
        field != "max" &&
        field != "maxStacks" &&
        field != "mana" &&
        field != "min" &&
        field != "mult" &&
        field != "perCombo" &&
        field != "radius" &&
        field != "total" &&
        field != "value" &&
        field != "variance" &&
        field != "weaponMult"
    ) { throw "unknown WOC M4 effect metric field"; }
    if (index == 0) {
        if (rank == 1) {
            if (effect == 0) {
                if (field == "bonus") { return 11.0; }
                return 0.0;
