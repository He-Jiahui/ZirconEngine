pub contractTest(): int {
    if (catalogSha() != "77ce0c4d8ab36735313eb026a3151e25e9f732ba4f98d5c1cab410de74bc3697" || classCount() != 9 ||
        playerStartX() != 2.0 || playerStartZ() != -2.0) { return -1; }
    if (classIndex("warrior") != 0 || classIndex("druid") != 8 || classIndex("missing") != -1 ||
        classText(0, "resourceType") != "rage" || classMetric(0, "baseSta") != 22.0 ||
        classText(0, "startWeapon") != "worn_sword") { return -2; }
    var mageIndex = classIndex("mage");
    if (mageIndex != 1 || classText(mageIndex, "resourceType") != "mana" || classRationCount(mageIndex) != 2 ||
        classRationId(mageIndex, 1) != "spring_water" || classRationCountValue(mageIndex, 1) != 5) { return -3; }
    if (starterItemMetric("worn_sword", "weaponMin") != 2.0 ||
        starterItemMetric("worn_sword", "weaponSpeed") != 2.0 ||
        starterItemMetric("spring_water", "drinkMana") != 76.0) { return -4; }
    var index = 0;
    while (index < classCount()) {
        if (classIndex(classId(index)) != index) { return -5; }
        index = index + 1;
    }
    return 1;
}
