pub statPerIlvl(required: bool): float { return required ? 0.7 : 0.0; }
pub unknownSlotMultiplier(required: bool): float { return required ? 0.7 : 0.0; }
pub qualityMultiplier(quality: string): float {
    if (quality == "poor") return 0;
    if (quality == "common") return 0;
    if (quality == "uncommon") return 0.55;
    if (quality == "rare") return 0.8;
    if (quality == "epic") return 1;
    if (quality == "legendary") return 1.9;
    return 0.0;
}
pub slotMultiplier(slot: string): float {
    if (slot == "mainhand") return 1;
    if (slot == "offhand") return 0.75;
    if (slot == "chest") return 1;
    if (slot == "legs") return 0.9;
    if (slot == "helmet") return 0.85;
    if (slot == "shoulder") return 0.75;
    if (slot == "waist") return 0.7;
    if (slot == "gloves") return 0.7;
    if (slot == "feet") return 0.65;
    if (slot == "neck") return 0.65;
    if (slot == "ring") return 0.6;
    if (slot == "ring1") return 0.6;
    if (slot == "ring2") return 0.6;
    return unknownSlotMultiplier(true);
}
