layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 68.0, preferred = 68.0, max = 68.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectClass/rogue", event = "Toggle", route = "woc.shell.offline.select_class.rogue" }]

[nodes.class_priest]
component = "ToggleButton"
control_id = "OfflineClassPriest"
classes = ["woc-class-button", "class-priest"]
