[nodes.compact_class_grid]
component = "GridGroup"
control_id = "OfflineCompactClassPicker"
layout = { container = { kind = "GridBox", columns = 3, rows = 3, column_gap = 4.0, row_gap = 4.0 }, width = { stretch = "Stretch" }, height = { min = 98.0, preferred = 98.0, max = 98.0, stretch = "Fixed" } }
children = [
  { node = "compact_class_warrior" },
  { node = "compact_class_paladin" },
  { node = "compact_class_hunter" },
