component = "ToggleButton"
control_id = "OfflineClassPaladin"
classes = ["woc-class-button", "class-paladin"]
props = { text = "Paladin", checked = false, selection_state = "exclusive" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 68.0, preferred = 68.0, max = 68.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectClass/paladin", event = "Toggle", route = "woc.shell.offline.select_class.paladin" }]

