[asset]
kind = "view"
id = "res://ui/shell/offline_picker.zui"
version = 2
display_name = "World of ClaudeCraft Offline Character Picker"

[imports]
widgets = []
styles = ["res://ui/shell/shell_theme.zui"]
resources = [
  { kind = "image", uri = "res://m8/env/vale_backdrop.webp", fallback = { mode = "optional" } },
]

[root]
node = "offline_root"

[nodes.preview_host]
component = "Space"
control_id = "OfflineCharacterPreviewHost"
classes = ["woc-preview-host"]
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 0.0, y = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.stage_scrim]
component = "Space"
classes = ["woc-stage-scrim"]
layout = { anchor = { x = 0.0, y = 0.0 }, pivot = { x = 0.0, y = 0.0 }, position = { x = 0.0, y = 0.0 }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }

[nodes.title]
component = "Label"
control_id = "OfflineCharacterTitle"
classes = ["woc-screen-title"]
props = { text = "Offline Character", text_align = "center" }
layout = { anchor = { x = 0.5, y = 0.0 }, pivot = { x = 0.5, y = 0.0 }, position = { x = 0.0, y = 18.0 }, width = { min = 300.0, preferred = 420.0, max = 560.0, stretch = "Fixed" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }

[nodes.name_label]
component = "Label"
control_id = "OfflineCharacterNameLabel"
classes = ["woc-label"]
props = { text = "Character Name", text_align = "center" }
layout = { anchor = { x = 0.5, y = 0.0 }, pivot = { x = 0.5, y = 0.0 }, position = { x = 0.0, y = 58.0 }, width = { min = 180.0, preferred = 300.0, max = 300.0, stretch = "Fixed" }, height = { min = 20.0, preferred = 20.0, max = 20.0, stretch = "Fixed" } }

[nodes.name_field]
component = "TextField"
control_id = "OfflineCharacterName"
classes = ["woc-input"]
props = { value_text = "", label = "", placeholder = "Character name", helper_text = "", variant = "outlined" }
layout = { anchor = { x = 0.5, y = 0.0 }, pivot = { x = 0.5, y = 0.0 }, position = { x = 0.0, y = 82.0 }, width = { min = 240.0, preferred = 300.0, max = 300.0, stretch = "Fixed" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" } }
events = [
  { id = "WocOffline/CharacterNameChanged", event = "Change", route = "woc.shell.offline.set_name" },
  { id = "WocOffline/CharacterNameSubmitted", event = "Submit", route = "woc.shell.offline.enter_world" },
]

[nodes.error]
component = "Label"
control_id = "OfflineCharacterError"
classes = ["woc-error"]
props = { text = "", text_align = "center" }
layout = { anchor = { x = 0.5, y = 0.0 }, pivot = { x = 0.5, y = 0.0 }, position = { x = 0.0, y = 132.0 }, width = { min = 300.0, preferred = 520.0, max = 640.0, stretch = "Fixed" }, height = { min = 20.0, preferred = 20.0, max = 40.0, stretch = "Fixed" } }

[nodes.skin_title]
component = "Label"
control_id = "OfflineSkinTitle"
classes = ["woc-section-title"]
props = { text = "Appearance", text_align = "center" }
layout = { width = { stretch = "Stretch" }, height = { min = 22.0, preferred = 22.0, max = 22.0, stretch = "Fixed" } }

[nodes.skin_0]
component = "ToggleButton"
control_id = "OfflineSkin0"
classes = ["woc-skin-swatch"]
props = { text = "1", checked = true, selection_state = "exclusive" }
layout = { width = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectSkin/0", event = "Toggle", route = "woc.shell.offline.select_skin.0" }]

[nodes.skin_1]
component = "ToggleButton"
control_id = "OfflineSkin1"
classes = ["woc-skin-swatch"]
props = { text = "2", checked = false, selection_state = "exclusive" }
layout = { width = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectSkin/1", event = "Toggle", route = "woc.shell.offline.select_skin.1" }]

[nodes.skin_2]
component = "ToggleButton"
control_id = "OfflineSkin2"
classes = ["woc-skin-swatch"]
props = { text = "3", checked = false, selection_state = "exclusive" }
layout = { width = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectSkin/2", event = "Toggle", route = "woc.shell.offline.select_skin.2" }]

[nodes.skin_3]
component = "ToggleButton"
control_id = "OfflineSkin3"
classes = ["woc-skin-swatch"]
props = { text = "4", checked = false, selection_state = "exclusive" }
layout = { width = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" }, height = { min = 56.0, preferred = 56.0, max = 56.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectSkin/3", event = "Toggle", route = "woc.shell.offline.select_skin.3" }]

[nodes.skin_column]
component = "VerticalBox"
control_id = "OfflineSkinPicker"
layout = { container = { kind = "VerticalBox", gap = 12.0 }, anchor = { x = 0.0, y = 0.5 }, pivot = { x = 0.0, y = 0.5 }, position = { x = 26.0, y = 0.0 }, width = { min = 72.0, preferred = 72.0, max = 72.0, stretch = "Fixed" }, height = { min = 300.0, preferred = 300.0, max = 300.0, stretch = "Fixed" } }
children = [{ node = "skin_title" }, { node = "skin_0" }, { node = "skin_1" }, { node = "skin_2" }, { node = "skin_3" }]

[nodes.details_name]
component = "Label"
control_id = "OfflineClassName"
classes = ["woc-screen-title"]
props = { text = "Warrior" }
layout = { width = { stretch = "Stretch" }, height = { min = 30.0, preferred = 30.0, max = 30.0, stretch = "Fixed" } }

[nodes.details_role]
component = "Label"
control_id = "OfflineClassRole"
classes = ["woc-section-title"]
props = { text = "Hybrid" }
layout = { width = { stretch = "Stretch" }, height = { min = 22.0, preferred = 22.0, max = 22.0, stretch = "Fixed" } }

[nodes.details_lore]
component = "Label"
control_id = "OfflineClassLore"
classes = ["woc-muted"]
props = { text = "", overflow = "wrap" }
layout = { width = { stretch = "Stretch" }, height = { min = 60.0, preferred = 72.0, max = 96.0, stretch = "Fixed" } }

[nodes.details_stats_title]
component = "Label"
classes = ["woc-section-title"]
props = { text = "Combat Profile" }
layout = { width = { stretch = "Stretch" }, height = { min = 22.0, preferred = 22.0, max = 22.0, stretch = "Fixed" } }

[nodes.details_stats]
component = "Label"
control_id = "OfflineClassStats"
classes = ["woc-label"]
props = { text = "", overflow = "wrap" }
layout = { width = { stretch = "Stretch" }, height = { min = 54.0, preferred = 64.0, max = 84.0, stretch = "Fixed" } }

[nodes.details_gear_title]
component = "Label"
classes = ["woc-section-title"]
props = { text = "Armor & Weapons" }
layout = { width = { stretch = "Stretch" }, height = { min = 22.0, preferred = 22.0, max = 22.0, stretch = "Fixed" } }

[nodes.details_armor]
component = "Label"
control_id = "OfflineClassArmor"
classes = ["woc-muted"]
props = { text = "Chain, Leather, Cloth" }
layout = { width = { stretch = "Stretch" }, height = { min = 20.0, preferred = 20.0, max = 20.0, stretch = "Fixed" } }

[nodes.details_weapons]
component = "Label"
control_id = "OfflineClassWeapons"
classes = ["woc-muted"]
props = { text = "Swords, Maces, Axes" }
layout = { width = { stretch = "Stretch" }, height = { min = 20.0, preferred = 20.0, max = 20.0, stretch = "Fixed" } }

[nodes.details_abilities_title]
component = "Label"
classes = ["woc-section-title"]
props = { text = "Signature Abilities" }
layout = { width = { stretch = "Stretch" }, height = { min = 22.0, preferred = 22.0, max = 22.0, stretch = "Fixed" } }

[nodes.details_ability_0]
component = "Label"
control_id = "OfflineClassAbility0"
classes = ["woc-label"]
props = { text = "Charge" }
layout = { width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }

[nodes.details_ability_1]
component = "Label"
control_id = "OfflineClassAbility1"
classes = ["woc-label"]
props = { text = "Heroic Strike" }
layout = { width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }

[nodes.details_ability_2]
component = "Label"
control_id = "OfflineClassAbility2"
classes = ["woc-label"]
props = { text = "Execute" }
layout = { width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }

[nodes.details_panel]
component = "ScrollBox"
control_id = "OfflineClassDetails"
classes = ["woc-panel-strong"]
props = { scroll_axis = "vertical", scroll_x = false, scroll_y = true, show_scrollbars = true, clip_content = true }
layout = { container = { kind = "VerticalBox", gap = 8.0 }, anchor = { x = 1.0, y = 0.0 }, pivot = { x = 1.0, y = 0.0 }, position = { x = -26.0, y = 110.0 }, padding = { left = 14.0, right = 14.0, top = 14.0, bottom = 14.0 }, width = { min = 320.0, preferred = 360.0, max = 360.0, stretch = "Fixed" }, height = { min = 360.0, preferred = 500.0, max = 560.0, stretch = "Fixed" } }
children = [
  { node = "details_name" },
  { node = "details_role" },
  { node = "details_lore" },
  { node = "details_stats_title" },
  { node = "details_stats" },
  { node = "details_gear_title" },
  { node = "details_armor" },
  { node = "details_weapons" },
  { node = "details_abilities_title" },
  { node = "details_ability_0" },
  { node = "details_ability_1" },
  { node = "details_ability_2" },
]

[nodes.class_warrior]
component = "ToggleButton"
control_id = "OfflineClassWarrior"
classes = ["woc-class-button", "class-warrior"]
props = { text = "Warrior", checked = true, selection_state = "exclusive" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 68.0, preferred = 68.0, max = 68.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectClass/warrior", event = "Toggle", route = "woc.shell.offline.select_class.warrior" }]

