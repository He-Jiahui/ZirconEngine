classes = ["woc-class-button", "class-warlock"]
props = { text = "Warlock", checked = false, selection_state = "exclusive" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 68.0, preferred = 68.0, max = 68.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectClass/warlock", event = "Toggle", route = "woc.shell.offline.select_class.warlock" }]

[nodes.class_druid]
component = "ToggleButton"
control_id = "OfflineClassDruid"
classes = ["woc-class-button", "class-druid"]
props = { text = "Druid", checked = false, selection_state = "exclusive" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 68.0, preferred = 68.0, max = 68.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectClass/druid", event = "Toggle", route = "woc.shell.offline.select_class.druid" }]

[nodes.class_rail]
component = "HorizontalBox"
control_id = "OfflineClassPicker"
layout = { container = { kind = "HorizontalBox", gap = 14.0 }, anchor = { x = 0.5, y = 1.0 }, pivot = { x = 0.5, y = 1.0 }, position = { x = 0.0, y = -26.0 }, width = { min = 832.0, preferred = 832.0, max = 832.0, stretch = "Fixed" }, height = { min = 68.0, preferred = 68.0, max = 68.0, stretch = "Fixed" } }
children = [
  { node = "class_warrior" },
  { node = "class_paladin" },
  { node = "class_hunter" },
  { node = "class_rogue" },
  { node = "class_priest" },
  { node = "class_shaman" },
  { node = "class_mage" },
  { node = "class_warlock" },
  { node = "class_druid" },
]

[nodes.back]
component = "Button"
control_id = "OfflineBack"
classes = ["woc-secondary-action"]
props = { text = "Back", button_variant = "outlined" }
layout = { anchor = { x = 0.0, y = 1.0 }, pivot = { x = 0.0, y = 1.0 }, position = { x = 26.0, y = -30.0 }, width = { min = 140.0, preferred = 140.0, max = 140.0, stretch = "Fixed" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/Back", event = "Click", route = "woc.shell.offline.back" }]

[nodes.enter_world]
component = "Button"
control_id = "OfflineEnterWorld"
classes = ["woc-primary-action"]
props = { text = "Enter World", button_variant = "contained", disabled = false }
layout = { anchor = { x = 1.0, y = 1.0 }, pivot = { x = 1.0, y = 1.0 }, position = { x = -26.0, y = -30.0 }, width = { min = 180.0, preferred = 180.0, max = 180.0, stretch = "Fixed" }, height = { min = 44.0, preferred = 44.0, max = 44.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/EnterWorld", event = "Click", route = "woc.shell.offline.enter_world" }]

[nodes.desktop_layer]
component = "Overlay"
control_id = "OfflineDesktopLayer"
props = { visibility = { xs = "collapsed", md = "visible" } }
layout = { clip = true, container = { kind = "Overlay" }, width = { stretch = "Stretch" }, height = { stretch = "Stretch" } }
children = [
  { node = "preview_host" },
  { node = "stage_scrim" },
  { node = "title" },
  { node = "name_label" },
  { node = "name_field" },
  { node = "error" },
  { node = "skin_column" },
  { node = "details_panel" },
  { node = "class_rail" },
  { node = "back" },
  { node = "enter_world" },
]

[nodes.compact_title]
component = "Label"
control_id = "OfflineCompactCharacterTitle"
classes = ["woc-screen-title"]
props = { text = "Offline Character", text_align = "center" }
layout = { width = { stretch = "Stretch" }, height = { min = 24.0, preferred = 24.0, max = 24.0, stretch = "Fixed" } }

[nodes.compact_name_label]
