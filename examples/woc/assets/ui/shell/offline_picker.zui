layout = { width = { stretch = "Stretch" }, height = { min = 32.0, preferred = 32.0, max = 32.0, stretch = "Fixed" } }
events = [
  { id = "WocOfflineCompact/CharacterNameChanged", event = "Change", route = "woc.shell.offline.set_name" },
  { id = "WocOfflineCompact/CharacterNameSubmitted", event = "Submit", route = "woc.shell.offline.enter_world" },
]

