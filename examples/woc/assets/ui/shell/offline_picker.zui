control_id = "OfflineClassShaman"
classes = ["woc-class-button", "class-shaman"]
props = { text = "Shaman", checked = false, selection_state = "exclusive" }
layout = { width = { min = 80.0, preferred = 80.0, max = 80.0, stretch = "Fixed" }, height = { min = 68.0, preferred = 68.0, max = 68.0, stretch = "Fixed" } }
events = [{ id = "WocOffline/SelectClass/shaman", event = "Toggle", route = "woc.shell.offline.select_class.shaman" }]

[nodes.class_mage]
component = "ToggleButton"
