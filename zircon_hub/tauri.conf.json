{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zircon Hub",
  "version": "0.1.0",
  "identifier": "com.zirconengine.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zircon Hub",
        "width": 1568,
        "height": 1003,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
