import { HubTokens, HubVisualSpec } from "tokens.slint";
import { HubPanel } from "surfaces.slint";
import {
    MaterialPalette,
    MaterialText,
    MaterialTypography,
} from "material_bridge.slint";

export component PopupPanel inherits HubPanel {
    in property <length> panel-width: HubTokens.panel-min-sm - HubTokens.space-6;
    in property <length> panel-min-height: HubTokens.control-md;

    width: root.panel-width;
    min-height: root.panel-min-height;
    variant: "elevated";
    clip: true;
}

export component HubPopupWindow inherits PopupWindow {
    in property <length> popup-x: 0px;
    in property <length> popup-y: 0px;
    in property <length> popup-width: HubTokens.panel-min-sm;
    in property <length> popup-height: HubTokens.control-lg;

    close-policy: close-on-click-outside;
    x: root.popup-x;
    y: root.popup-y;
    width: root.popup-width;
    height: root.popup-height;

    @children
}

export component HubAnchoredPopupPanel inherits PopupWindow {
    in property <length> popup-x: 0px;
    in property <length> popup-y: 0px;
    in property <length> popup-width: HubTokens.panel-min-sm;
    in property <length> popup-height: HubTokens.list-row-lg;
    in property <length> panel-padding: HubTokens.toolbar-gap;
    in property <length> panel-spacing: HubTokens.space-2;
    in property <length> panel-radius: HubVisualSpec.panel-radius;

    close-policy: close-on-click-outside;
    x: root.popup-x;
    y: root.popup-y;
    width: root.popup-width;
    height: root.popup-height;

    PopupPanel {
        width: parent.width;
        height: parent.height;
        panel-width: parent.width;
        panel-min-height: parent.height;
        border-radius: root.panel-radius;
        clip: true;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding: root.panel-padding;
            spacing: root.panel-spacing;

            @children
        }
    }
}

export component HubPopupSectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> meta;
    in property <length> section-height: HubTokens.icon-lg;
    in property <length> section-spacing: HubTokens.space-2;

    horizontal-stretch: 1;
    height: root.section-height;
    background: transparent;
    clip: true;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: root.section-spacing;
        alignment: center;

        MaterialText {
            horizontal-stretch: 1;
            min-width: 1px;
            text: root.title;
            color: MaterialPalette.on_surface;
            style: MaterialTypography.label_large;
            vertical_alignment: center;
            overflow: elide;
        }

        if root.meta != "": MaterialText {
            text: root.meta;
            color: MaterialPalette.on_surface_variant;
            style: MaterialTypography.label_medium;
            vertical_alignment: center;
            overflow: elide;
        }
    }
}

export component HubPopupDivider inherits Rectangle {
    in property <length> divider-height: HubTokens.border-width;
    in property <color> divider-color: HubVisualSpec.outline-muted;

    horizontal-stretch: 1;
    height: root.divider-height;
    background: root.divider-color;
}

export component HubPopupProfileHeader inherits Rectangle {
    in property <string> avatar-text;
    in property <string> title;
    in property <string> subtitle;
    in property <length> profile-height: HubTokens.list-row-lg;
    in property <length> profile-spacing: HubTokens.space-3;
    in property <length> avatar-size: HubTokens.icon-xl + HubTokens.space-2;
    in property <length> avatar-border-width: HubTokens.border-width;
    in property <color> avatar-border: HubVisualSpec.accent-stroke;
    in property <color> avatar-background: MaterialPalette.secondary_container;
    in property <color> avatar-foreground: MaterialPalette.on_secondary_container;
    in property <color> title-foreground: MaterialPalette.on_surface;
    in property <color> subtitle-foreground: MaterialPalette.on_surface_variant;

    horizontal-stretch: 1;
    height: root.profile-height;
    background: transparent;
    clip: true;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: root.profile-spacing;
        alignment: center;

        Rectangle {
            width: root.avatar-size;
            height: root.avatar-size;
            border-radius: root.avatar-size / 2;
            border-width: root.avatar-border-width;
            border-color: root.avatar-border;
            background: root.avatar-background;

            MaterialText {
                width: parent.width;
                height: parent.height;
                text: root.avatar-text;
                color: root.avatar-foreground;
                style: MaterialTypography.title_small;
                horizontal_alignment: center;
                vertical_alignment: center;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 1px;
            height: parent.height;
            spacing: HubTokens.space-0;

            Rectangle { vertical-stretch: 1; min-height: 0px; }
            MaterialText {
                text: root.title;
                color: root.title-foreground;
                style: MaterialTypography.label_large;
                overflow: elide;
            }
            MaterialText {
                text: root.subtitle;
                color: root.subtitle-foreground;
                style: MaterialTypography.body_small;
                overflow: elide;
            }
            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }
    }
}
