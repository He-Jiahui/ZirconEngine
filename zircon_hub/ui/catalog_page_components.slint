import {
    AssetData,
    LearnData,
    PluginData,
    UiTextData,
} from "shared.slint";
import { CatalogDetailPanel } from "catalog_detail_components.slint";
import { HubCompactTabStrip } from "compact_page_components.slint";
import { HubInteractiveRowSurface } from "data_display.slint";
import { HubListView } from "list_container_components.slint";
import { PageScrollSurface, WorkspacePanelSection } from "layout.slint";
import { HubTokens, HubVisualSpec } from "tokens.slint";
import { HubRowLeadingIconSlot, HubRowMainSlot, HubRowMetaSlot, HubRowTrailingSlot } from "row_slot_components.slint";
import { EmptyStateBlock } from "surfaces.slint";
import { MaterialStyleMetrics } from "material_bridge.slint";

component CatalogColumnRow inherits HubInteractiveRowSurface {
    in property <string> title;
    in property <string> detail;
    in property <string> metadata;
    in property <string> tag-text;
    in property <string> tag-tone: "accent";
    in property <image> icon-image;
    in property <bool> collapse-trailing-label: false;
    in property <bool> show-arrow: false;
    in property <length> content-width: HubTokens.panel-min-lg;

    private property <length> avatar-size: HubTokens.control-lg;
    private property <length> arrow-size: HubTokens.control-md;
    private property <length> tag-width: root.show-arrow ? max(HubTokens.control-md * 4, min(HubTokens.panel-min-sm, root.content-width / 4)) : max(HubTokens.control-md * 3, min(HubTokens.control-lg * 7 / 2, root.content-width / 7));
    private property <length> meta-width: root.show-arrow ? max(HubTokens.control-md * 3, min(HubTokens.control-md * 4, root.content-width / 7)) : max(HubTokens.control-md * 3, min(HubTokens.control-md * 4, root.content-width / 6));

    row-radius: HubVisualSpec.panel-radius;
    idle-border-width: HubTokens.border-width;
    idle-border: HubVisualSpec.outline-muted;
    selected-border: HubVisualSpec.accent-stroke;
    idle-background: HubVisualSpec.panel-background;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: HubTokens.space-3;
        padding-right: HubTokens.space-3;
        spacing: HubTokens.space-3;
        alignment: stretch;

        HubRowLeadingIconSlot {
            row-height: root.row-height;
            slot-width: root.avatar-size;
            shell-size: root.avatar-size;
            icon-size: HubTokens.icon-lg;
            icon-image: root.icon-image;
        }

        Rectangle {
            horizontal-stretch: 3;
            min-width: HubTokens.panel-min-sm * 3 / 5;
            preferred-width: 0px;
            height: parent.height;
            background: transparent;
            clip: true;

            HubRowMainSlot {
                width: parent.width;
                height: parent.height;
                title: root.title;
                detail: root.detail;
                row-height: root.row-height;
                title-foreground: HubTokens.text-primary;
            }
        }

        HubRowMetaSlot {
            text: root.metadata;
            row-height: root.row-height;
            slot-width: root.meta-width;
        }

        if !root.collapse-trailing-label || root.show-arrow: HubRowTrailingSlot {
            row-height: root.row-height;
            badge-text: root.tag-text;
            badge-tone: root.tag-tone;
            badge-width: root.tag-width;
            collapse-badge: root.collapse-trailing-label;
            show-chevron: root.show-arrow;
            chevron-size: root.arrow-size;
            clicked => { root.clicked(); }
        }
    }
}

export component AssetRow inherits CatalogColumnRow {
    in property <AssetData> asset;
    in property <UiTextData> ui-text;
    in property <bool> collapse-label: false;

    title: root.asset.name;
    detail: root.asset.path;
    metadata: root.asset.source;
    tag-text: root.asset.kind;
    tag-tone: "accent";
    icon-image: @image-url("../assets/icons/nav/assets.svg");
    collapse-trailing-label: root.collapse-label;
    row-height: HubTokens.list-row-md;
}

export component PluginRow inherits CatalogColumnRow {
    in property <PluginData> plugin;
    in property <UiTextData> ui-text;
    in property <bool> collapse-label: false;

    title: root.plugin.title;
    detail: root.plugin.description;
    metadata: root.plugin.scope;
    tag-text: root.plugin.category;
    tag-tone: "accent";
    icon-image: @image-url("../assets/icons/nav/plugins.svg");
    collapse-trailing-label: root.collapse-label;
    row-height: HubTokens.list-row-md;
}

export component LearnRow inherits CatalogColumnRow {
    in property <LearnData> resource;
    in property <UiTextData> ui-text;
    in property <bool> collapse-label: false;
    callback open-resource(string);

    title: root.resource.title;
    detail: root.resource.summary;
    metadata: root.resource.source;
    tag-text: root.resource.category;
    tag-tone: "accent";
    icon-image: @image-url("../assets/icons/ui/help.svg");
    collapse-trailing-label: root.collapse-label;
    row-height: HubTokens.list-row-md;
    show-arrow: true;
    clicked => {
        root.open-resource(root.resource.path);
    }
}

export component CatalogListPanel inherits HubListView {
    in property <string> empty-title;
    in property <string> empty-detail;

    badge-tone: "accent";
    badge-width: HubTokens.control-md * 4;
    show-header: true;
    row-height: HubTokens.list-row-lg;
    row-spacing: HubTokens.space-2;
    vertical-padding: HubTokens.space-1;
    body-padding: HubTokens.space-4;
    empty-height: root.row-height + HubTokens.space-4;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-height: root.row-height * 4;

    if root.row-count == 0: EmptyStateBlock {
        horizontal-stretch: 1;
        height: max(root.row-height + HubTokens.space-2, parent.height);
        title: root.empty-title;
        detail: root.empty-detail;
        body-padding: MaterialStyleMetrics.padding_14;
        body-spacing: MaterialStyleMetrics.spacing_6;
        center-content: true;
    }

    @children
}

export component CatalogPage inherits PageScrollSurface {
    in-out property <length> list-scroll-y: 0px;
    in property <string> title;
    in property <string> badge-text;
    in property <string> badge-tone: "accent";
    in property <string> empty-title;
    in property <string> empty-detail;
    in property <int> row-count;
    in property <length> row-height: HubTokens.list-row-lg;
    in property <bool> show-tabs: true;
    in property <string> first-tab-label: "All";
    in property <string> second-tab-label: "Project";
    in property <string> third-tab-label: "Engine";
    in property <string> fourth-tab-label: "Workspace";
    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <string> detail-primary;
    in property <string> detail-secondary;
    in property <image> detail-icon-image: @image-url("../assets/brand/zircon-mark.svg");
    in property <string> detail-stat-one-label;
    in property <string> detail-stat-one-value;
    in property <string> detail-stat-one-detail;
    in property <string> detail-stat-two-label;
    in property <string> detail-stat-two-value;
    in property <string> detail-stat-two-detail;
    in property <string> detail-stat-three-label;
    in property <string> detail-stat-three-value;
    in property <string> detail-stat-three-detail;
    in property <string> detail-stat-four-label;
    in property <string> detail-stat-four-value;
    in property <string> detail-stat-four-detail;
    in property <string> detail-check-one-title;
    in property <string> detail-check-one-detail;
    in property <string> detail-check-one-badge: "Ready";
    in property <string> detail-check-one-tone: "ok";
    in property <string> detail-check-two-title;
    in property <string> detail-check-two-detail;
    in property <string> detail-check-two-badge: "Ready";
    in property <string> detail-check-two-tone: "neutral";
    in property <string> detail-check-three-title;
    in property <string> detail-check-three-detail;
    in property <string> detail-check-three-badge: "Review";
    in property <string> detail-check-three-tone: "warning";
    in property <length> catalog-badge-width: HubTokens.control-md * 4;
    private property <length> row-slot-height: root.row-height + HubTokens.space-2;
    private property <length> panel-chrome-height: HubTokens.space-4 * 2 + HubTokens.control-md + HubTokens.toolbar-gap;
    private property <length> tabs-block-height: root.show-tabs ? HubTokens.control-md + HubTokens.panel-gap : 0px;
    private property <length> list-panel-basis: HubTokens.panel-min-lg + HubTokens.control-lg;
    private property <length> detail-panel-basis: HubTokens.panel-min-md;
    private property <bool> detail-layout-compact: root.content-width < root.list-panel-basis + root.detail-panel-basis + HubTokens.panel-gap;
    private property <length> fit-list-height: max(root.row-slot-height, root.content-height - root.panel-chrome-height - root.tabs-block-height);
    private property <int> fit-row-count: Math.floor(root.fit-list-height / root.row-slot-height);
    private property <int> visible-row-count: root.fit-row-count < 1 ? 1 : root.fit-row-count;
    private property <length> fitted-panel-height: root.panel-chrome-height + root.visible-row-count * root.row-slot-height;
    private property <length> panel-height: root.row-count > root.visible-row-count ? root.fitted-panel-height : max(root.row-slot-height + root.panel-chrome-height, root.content-height - root.tabs-block-height);
    private property <length> detail-section-height: root.detail-layout-compact ? root.panel-height * 2 + HubTokens.panel-gap : root.panel-height;

    background: HubVisualSpec.page-background;

    if root.show-tabs: HubCompactTabStrip {
        current-index: 0;
        first-label: root.first-tab-label;
        second-label: root.second-tab-label;
        third-label: root.third-tab-label;
        fourth-label: root.fourth-tab-label;
        tab-width: HubTokens.control-md * 3;
    }

    WorkspacePanelSection {
        compact: root.detail-layout-compact;
        row-height: root.panel-height;
        compact-height-override: root.detail-section-height;
        spacing-horizontal: HubTokens.panel-gap;
        spacing-vertical: HubTokens.panel-gap;

        CatalogListPanel {
            flex-basis: root.detail-layout-compact ? root.content-width : root.list-panel-basis;
            flex-grow: 2;
            flex-shrink: 1;
            min-width: root.detail-layout-compact ? root.content-width : HubTokens.panel-min-md;
            height: root.panel-height;
            scroll-y <=> root.list-scroll-y;
            title: root.title;
            badge-text: root.badge-text;
            badge-tone: root.badge-tone;
            badge-width: root.catalog-badge-width;
            empty-title: root.empty-title;
            empty-detail: root.empty-detail;
            row-count: root.row-count;
            row-height: root.row-height;

            @children
        }

        CatalogDetailPanel {
            basis: root.detail-panel-basis;
            flex-basis: root.detail-layout-compact ? root.content-width : root.detail-panel-basis;
            grow: 1;
            flex-grow: 1;
            shrink: 1;
            flex-shrink: 1;
            min-width: root.detail-layout-compact ? root.content-width : HubTokens.panel-min-sm;
            height: root.panel-height;
            panel-title: root.detail-title;
            panel-subtitle: root.detail-subtitle;
            badge-text: root.badge-text;
            badge-tone: root.badge-tone;
            badge-width: root.catalog-badge-width;
            icon-image: root.detail-icon-image;
            primary: root.detail-primary;
            secondary: root.detail-secondary;
            stat-one-label: root.detail-stat-one-label;
            stat-one-value: root.detail-stat-one-value;
            stat-one-detail: root.detail-stat-one-detail;
            stat-two-label: root.detail-stat-two-label;
            stat-two-value: root.detail-stat-two-value;
            stat-two-detail: root.detail-stat-two-detail;
            stat-three-label: root.detail-stat-three-label;
            stat-three-value: root.detail-stat-three-value;
            stat-three-detail: root.detail-stat-three-detail;
            stat-four-label: root.detail-stat-four-label;
            stat-four-value: root.detail-stat-four-value;
            stat-four-detail: root.detail-stat-four-detail;
            check-one-title: root.detail-check-one-title;
            check-one-detail: root.detail-check-one-detail;
            check-one-badge: root.detail-check-one-badge;
            check-one-tone: root.detail-check-one-tone;
            check-two-title: root.detail-check-two-title;
            check-two-detail: root.detail-check-two-detail;
            check-two-badge: root.detail-check-two-badge;
            check-two-tone: root.detail-check-two-tone;
            check-three-title: root.detail-check-three-title;
            check-three-detail: root.detail-check-three-detail;
            check-three-badge: root.detail-check-three-badge;
            check-three-tone: root.detail-check-three-tone;
        }
    }
}
