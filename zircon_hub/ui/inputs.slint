import { HubTokens, HubVisualSpec } from "tokens.slint";
import {
    MenuItem,
    Icon,
    OutlineButton,
    SegmentedButton,
    TonalButton,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    StateLayerArea,
} from "material_bridge.slint";
import { HubSelectMenu } from "dropdown_components.slint";

export struct SelectOptionData {
    id: string,
    label: string,
    active: bool,
}

component HubSelectTriggerLabel inherits MaterialText {
    in property <string> value;
    in property <color> foreground;
    in property <bool> dense: false;

    horizontal-stretch: 1;
    min-width: 1px;
    text: root.value;
    color: root.foreground;
    style: root.dense ? MaterialTypography.label_medium : MaterialTypography.label_large;
    vertical_alignment: center;
    overflow: elide;
}

export component HubSelectTrigger inherits Rectangle {
    in property <string> text;
    in property <image> icon-image;
    in property <bool> has-icon-image: false;
    in property <length> trigger-width: HubVisualSpec.toolbar-density-height * 7 / 2;
    in property <length> trigger-height: HubVisualSpec.toolbar-density-height;
    in property <length> chevron-size: max(MaterialStyleMetrics.icon_size_18, min(MaterialStyleMetrics.icon_size_24, root.trigger-height * 2 / 5));
    in property <length> content-inset: max(MaterialStyleMetrics.padding_12, root.trigger-height / 4);
    in property <bool> enabled: true;
    in property <bool> focused: false;
    in property <bool> menu-ready: true;
    in property <bool> dense-label: false;
    in property <color> idle-foreground: HubVisualSpec.toolbar-select-foreground;
    callback activated();

    // MUI Select separates the button-like anchor from the menu surface. Hub
    // keeps that split so toolbar and shell selectors share one trigger shape.
    private property <color> select-background: !root.enabled ? HubVisualSpec.panel-background.with_alpha(MaterialPalette.disable_opacity) : (root.focused ? MaterialPalette.surface_container_high : HubVisualSpec.panel-background);
    private property <color> select-border: root.focused ? HubVisualSpec.focus-ring-color : HubVisualSpec.outline-muted;
    private property <color> select-foreground: root.focused ? MaterialPalette.on_surface_variant : root.idle-foreground;

    width: root.trigger-width;
    height: root.trigger-height;
    clip: false;

    trigger := OutlineButton {
        width: parent.width;
        height: parent.height;
        text: root.text;
        icon: root.icon-image;
        opacity: 0%;
        enabled: root.enabled;
        clicked => {
            if (root.menu-ready) {
                root.activated();
            }
        }
    }

    select-visual := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: HubVisualSpec.compact-radius;
        border-width: root.focused ? HubVisualSpec.focus-ring-width : HubTokens.border-width;
        border-color: root.select-border;
        background: root.select-background;
        opacity: root.enabled ? 1.0 : HubVisualSpec.disabled-opacity;
        clip: true;

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: root.content-inset;
            padding-right: root.content-inset + root.chevron-size + HubTokens.space-2;
            spacing: HubTokens.space-2;
            alignment: center;

            if root.has-icon-image: Icon {
                width: HubTokens.icon-sm;
                height: HubTokens.icon-sm;
                source: root.icon-image;
                colorize: root.select-foreground;
            }

            HubSelectTriggerLabel {
                value: root.text;
                foreground: root.select-foreground;
                dense: root.dense-label;
            }
        }

        StateLayerArea {
            width: parent.width;
            height: parent.height;
            color: root.menu-ready ? HubVisualSpec.accent-stroke : MaterialPalette.on_surface_variant;
            border_radius: HubVisualSpec.compact-radius;
            clicked => {
                if (root.menu-ready) {
                    root.activated();
                }
            }
        }
    }

    trailing-chevron := Icon {
        width: root.chevron-size;
        height: root.chevron-size;
        x: parent.width - root.content-inset - self.width;
        y: (parent.height - self.height) / 2;
        source: @image-url("../assets/icons/ui/chevron-down.svg");
        colorize: root.select-foreground;
    }
}

export component ToolbarSelect inherits Rectangle {
    in property <string> icon;
    in property <image> icon-image;
    in property <bool> has-icon-image: false;
    in property <string> text;
    in property <length> select-width: HubVisualSpec.toolbar-density-height * 7 / 2;
    in property <length> select-height: HubVisualSpec.toolbar-density-height;
    in property <bool> enabled: true;
    in property <bool> focused: false;
    in property <[MenuItem]> menu-items: [];
    in property <[SelectOptionData]> options: [];
    in property <int> option-count: 0;
    callback selected(string);
    callback selected-index(int);

    private property <bool> menu-ready: root.enabled && root.menu-items.length > 0;

    width: root.select-width;
    height: root.select-height;
    clip: false;

    HubSelectTrigger {
        trigger-width: parent.width;
        trigger-height: parent.height;
        text: root.text;
        icon-image: root.icon-image;
        has-icon-image: root.has-icon-image;
        enabled: root.enabled;
        focused: root.focused;
        menu-ready: root.menu-ready;
        activated => {
            menu.show();
        }
    }

    menu := HubSelectMenu {
        anchor-width: root.select-width;
        anchor-height: root.height;
        menu-min-width: HubTokens.input-width / 2;
        select-items: root.menu-items;

        activated(index) => {
            menu.close();
            root.selected-index(index);
            if index >= 0 && index < root.options.length {
                root.selected(root.options[index].id);
            }
        }
    }
}

export component DropDownButton inherits Rectangle {
    in property <string> text;
    in property <image> icon-image;
    in property <bool> has-icon-image: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> focused: false;
    in property <length> button-width: HubTokens.input-width * 2 / 5;
    in property <length> button-height: HubTokens.control-md;
    callback clicked;

    // Active and inactive triggers use Material buttons; the wrapper normalizes
    // density, disabled opacity, and focus-ring geometry.
    private property <length> focus-radius: root.button-height / 2;

    width: root.button-width;
    height: root.button-height;
    opacity: root.enabled ? 1.0 : HubVisualSpec.disabled-opacity;
    clip: true;

    if root.active: TonalButton {
        width: parent.width;
        height: parent.height;
        text: root.text;
        icon: root.icon-image;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    if !root.active: OutlineButton {
        width: parent.width;
        height: parent.height;
        text: root.text;
        icon: root.icon-image;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    if root.focused: Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: root.focus-radius;
        border-width: HubVisualSpec.focus-ring-width;
        border-color: HubVisualSpec.focus-ring-color;
        background: transparent;
    }
}

export component SegmentButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> focused: false;
    in property <length> button-height: HubTokens.control-md;
    callback clicked;

    private property <int> selected-index: root.active ? 0 : -1;
    private property <length> focus-radius: root.button-height / 2;

    height: root.button-height;
    min-width: MaterialStyleMetrics.size_80;
    opacity: root.enabled ? 1.0 : HubVisualSpec.disabled-opacity;
    clip: true;

    material-segment := SegmentedButton {
        width: parent.width;
        height: parent.height;
        current_index <=> root.selected-index;
        items: [{ text: root.text }];
        index_changed(index) => {
            if (root.enabled) {
                root.clicked();
            } else {
                root.selected-index = root.active ? 0 : -1;
            }
        }
    }

    if root.focused: Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: root.focus-radius;
        border-width: HubVisualSpec.focus-ring-width;
        border-color: HubVisualSpec.focus-ring-color;
        background: transparent;
    }

    changed active => {
        root.selected-index = root.active ? 0 : -1;
    }
}
