import { MutedText } from "shared.slint";
import { Divider, ResponsiveSlot } from "layout.slint";
import { HubPanelHeaderActionButton } from "button_components.slint";
import { HubTokens, HubVisualSpec } from "tokens.slint";
import { ElevatedCard, OutlinedCard, MaterialPalette, MaterialStyleMetrics, MaterialText, MaterialTypography, StateLayerArea } from "material_bridge.slint";

export component HubPanel inherits Rectangle {
    in property <string> variant: "default";

    border-radius: HubVisualSpec.panel-radius;
    border-width: HubTokens.border-width;
    border-color: root.variant == "danger" ? HubVisualSpec.error-stroke : (root.variant == "warning" ? HubVisualSpec.warning-stroke : (root.variant == "selected" ? HubVisualSpec.accent-stroke : HubVisualSpec.outline-muted));
    background: root.variant == "danger" ? HubVisualSpec.error-fill : (root.variant == "warning" ? HubVisualSpec.warning-fill : (root.variant == "selected" ? HubVisualSpec.panel-hover-background : HubVisualSpec.panel-background));
    clip: true;

    if root.variant == "elevated": ElevatedCard {
        width: parent.width;
        height: parent.height;
        opacity: 0.0;
    }

    if root.variant != "elevated": OutlinedCard {
        width: parent.width;
        height: parent.height;
        opacity: 0.0;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: HubVisualSpec.panel-radius;
        border-width: 0px;
        border-color: transparent;
        background: transparent;
        clip: true;

        @children
    }
}

export component HubCard inherits HubPanel {
    variant: "interactive";
}

export component HubInteractiveCardSurface inherits HubPanel {
    in property <bool> selected: false;
    in property <color> interaction-foreground: MaterialPalette.on_surface;
    callback clicked;

    variant: root.selected ? "selected" : "interactive";

    StateLayerArea {
        width: parent.width;
        height: parent.height;
        color: root.interaction-foreground;
        border_radius: HubVisualSpec.panel-radius;
        clicked => {
            root.clicked();
        }
    }

    @children
}

export component PanelSlot inherits ResponsiveSlot {
    in property <string> variant: "default";
    in property <length> body-padding: HubTokens.space-4;
    in property <length> body-spacing: HubTokens.toolbar-gap;

    HubPanel {
        width: parent.width;
        height: parent.height;
        variant: root.variant;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding: root.body-padding;
            spacing: root.body-spacing;
            alignment: stretch;

            @children
        }
    }
}

export component HeaderGroup inherits Rectangle {
    in property <length> group-height: HubTokens.shell-header-height;

    height: root.group-height;
    horizontal-stretch: 1;
    min-width: 1px;
    preferred-width: 0px;
    background: HubVisualSpec.chrome-background;
    border-width: HubTokens.border-width;
    border-color: HubVisualSpec.chrome-outline-muted;
    clip: true;
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral";
    in property <length> badge-width: MaterialStyleMetrics.size_64;
    in property <length> badge-height: MaterialStyleMetrics.size_24;
    private property <bool> accent-tone: root.tone == "accent";
    private property <bool> success-tone: root.tone == "ok" || root.tone == "success";

    width: root.badge-width;
    height: root.badge-height;
    border-radius: HubVisualSpec.badge-radius;
    border-width: HubTokens.border-width;
    border-color: root.tone == "warning" ? HubVisualSpec.status-warning-stroke : (root.tone == "error" ? HubVisualSpec.status-error-stroke : (root.tone == "info" ? HubVisualSpec.status-info-stroke : (root.accent-tone ? HubVisualSpec.badge-accent-stroke : (root.success-tone ? HubVisualSpec.status-success-stroke : HubVisualSpec.status-neutral-stroke))));
    background: root.tone == "warning" ? HubVisualSpec.status-warning-fill : (root.tone == "error" ? HubVisualSpec.status-error-fill : (root.tone == "info" ? HubVisualSpec.status-info-fill : (root.accent-tone ? HubVisualSpec.badge-accent-fill : (root.success-tone ? HubVisualSpec.status-success-fill : HubVisualSpec.status-neutral-fill))));

    MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.text;
        overflow: elide;
        color: root.tone == "warning" ? HubVisualSpec.status-warning-foreground : (root.tone == "error" ? HubVisualSpec.status-error-foreground : (root.tone == "info" ? HubVisualSpec.status-info-foreground : (root.accent-tone ? HubVisualSpec.badge-accent-foreground : (root.success-tone ? HubVisualSpec.status-success-foreground : HubVisualSpec.status-neutral-foreground))));
        style: MaterialTypography.label_medium;
        horizontal_alignment: center;
        vertical_alignment: center;
    }
}

export component StatusBadge inherits Badge {
    badge-width: HubTokens.control-md * 3;
    badge-height: HubTokens.control-sm;
}

export component PanelHeader inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> badge-text;
    in property <string> badge-tone: "neutral";
    in property <bool> show-badge: false;
    in property <length> badge-width: HubTokens.control-md * 3;
    in property <string> action-text;
    in property <bool> show-action: false;
    in property <length> action-width: HubTokens.panel-min-sm / 2;
    callback action-clicked;

    height: subtitle == "" ? HubTokens.control-md : HubTokens.list-row-sm;
    horizontal-stretch: 1;
    min-width: 1px;
    preferred-width: 0px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: HubTokens.toolbar-gap;
        alignment: stretch;

        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_2;
            min-width: 1px;

            MaterialText {
                text: root.title;
                overflow: elide;
                color: HubTokens.text-primary;
                style: MaterialTypography.title_medium;
                horizontal_alignment: left;
                vertical_alignment: center;
            }

            if root.subtitle != "": MutedText {
                text: root.subtitle;
                overflow: elide;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: HubTokens.space-2;
        }

        if root.show-badge: StatusBadge {
            text: root.badge-text;
            tone: root.badge-tone;
            badge-width: root.badge-width;
        }

        if root.show-action: HubPanelHeaderActionButton {
            button-width: root.action-width;
            button-height: HubVisualSpec.toolbar-density-height;
            text: root.action-text;
            clicked => {
                root.action-clicked();
            }
        }
    }
}

export component HubFormPanelSlot inherits PanelSlot {
    in property <string> title;
    in property <string> subtitle;
    in property <string> badge-text;
    in property <string> badge-tone: "neutral";
    in property <bool> show-header: true;
    in property <bool> show-badge: root.badge-text != "";
    in property <length> badge-width: HubTokens.control-md * 3;
    in property <length> header-height: root.subtitle == "" ? HubTokens.control-md : HubTokens.list-row-sm;
    in property <length> form-spacing: HubTokens.space-2;
    in property <bool> form-stretch: true;

    if root.show-header: PanelHeader {
        height: root.header-height;
        title: root.title;
        subtitle: root.subtitle;
        show-badge: root.show-badge;
        badge-text: root.badge-text;
        badge-tone: root.badge-tone;
        badge-width: root.badge-width;
    }

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: root.form-stretch ? 1 : 0;
        spacing: root.form-spacing;

        @children
    }
}

export component HubContentPanelSlot inherits PanelSlot {
    in property <string> title;
    in property <string> subtitle;
    in property <string> badge-text;
    in property <string> badge-tone: "neutral";
    in property <bool> show-header: true;
    in property <bool> show-badge: root.badge-text != "";
    in property <length> badge-width: HubTokens.control-md * 3;
    in property <length> header-height: root.subtitle == "" ? HubTokens.control-md : HubTokens.list-row-sm;
    in property <bool> show-divider: false;
    in property <string> action-text;
    in property <bool> show-action: false;
    in property <length> action-width: HubTokens.panel-min-sm / 2;
    in property <length> content-spacing: HubTokens.space-2;
    in property <bool> content-stretch: true;
    callback action-clicked;

    if root.show-header: PanelHeader {
        height: root.header-height;
        title: root.title;
        subtitle: root.subtitle;
        show-badge: root.show-badge;
        badge-text: root.badge-text;
        badge-tone: root.badge-tone;
        badge-width: root.badge-width;
        show-action: root.show-action;
        action-text: root.action-text;
        action-width: root.action-width;
        action-clicked => {
            root.action-clicked();
        }
    }

    if root.show-divider: Divider {}

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: root.content-stretch ? 1 : 0;
        spacing: root.content-spacing;

        @children
    }
}

export component HubMediaContentPanelSlot inherits PanelSlot {
    in property <string> title;
    in property <string> subtitle;
    in property <string> badge-text;
    in property <string> badge-tone: "neutral";
    in property <bool> show-header: true;
    in property <bool> show-badge: root.badge-text != "";
    in property <length> badge-width: HubTokens.control-md * 3;
    in property <length> header-height: root.subtitle == "" ? HubTokens.control-md : HubTokens.list-row-sm;
    in property <bool> show-divider: false;
    in property <bool> show-media: true;
    in property <length> media-height: HubTokens.list-row-lg;
    in property <length> media-radius: HubVisualSpec.panel-radius;
    in property <color> media-background: MaterialPalette.primary_container;
    in property <image> media-source;
    in property <bool> has-media-source: false;
    in property <length> content-spacing: HubTokens.space-2;
    in property <bool> content-stretch: true;

    if root.show-media: Rectangle {
        horizontal-stretch: 1;
        height: root.media-height;
        border-radius: root.media-radius;
        background: root.media-background;
        clip: true;

        if root.has-media-source: Image {
            width: parent.width;
            height: parent.height;
            source: root.media-source;
            image-fit: cover;
        }
    }

    if root.show-header: PanelHeader {
        height: root.header-height;
        title: root.title;
        subtitle: root.subtitle;
        show-badge: root.show-badge;
        badge-text: root.badge-text;
        badge-tone: root.badge-tone;
        badge-width: root.badge-width;
    }

    if root.show-divider: Divider {}

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: root.content-stretch ? 1 : 0;
        spacing: root.content-spacing;

        @children
    }
}

export component OverviewPanel inherits HubPanel {
    in property <string> title;
    in property <string> subtitle;
    in property <string> badge-text;
    in property <string> badge-tone: "accent";
    in property <bool> show-badge: true;
    in property <length> badge-width: HubTokens.control-md * 3;
    in property <length> body-padding-horizontal: MaterialStyleMetrics.padding_16;
    in property <length> body-padding-vertical: MaterialStyleMetrics.padding_14;

    height: HubTokens.list-row-lg;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: root.body-padding-horizontal;
        padding-right: root.body-padding-horizontal;
        padding-top: root.body-padding-vertical;
        padding-bottom: root.body-padding-vertical;

        PanelHeader {
            title: root.title;
            subtitle: root.subtitle;
            show-badge: root.show-badge;
            badge-text: root.badge-text;
            badge-tone: root.badge-tone;
            badge-width: root.badge-width;
        }
    }
}

export component EmptyStateBlock inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> extra-detail;
    in property <length> body-padding: HubTokens.space-4;
    in property <length> body-spacing: HubTokens.space-2;
    in property <bool> title-prominent: false;
    in property <bool> center-content: false;

    horizontal-stretch: 1;
    min-height: HubTokens.control-md;
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: root.body-padding;
        spacing: root.body-spacing;
        alignment: stretch;

        Rectangle {
            vertical-stretch: root.center-content ? 1 : 0;
            min-height: 0px;
        }

        MaterialText {
            text: root.title;
            overflow: elide;
            color: MaterialPalette.on_surface;
            style: root.title-prominent ? MaterialTypography.title_medium : MaterialTypography.label_large;
            horizontal-stretch: 1;
            min-width: 1px;
        }

        if root.detail != "": MutedText {
            text: root.detail;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 1px;
        }

        if root.extra-detail != "": MutedText {
            text: root.extra-detail;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 1px;
        }

        Rectangle {
            vertical-stretch: root.center-content ? 1 : 0;
            min-height: 0px;
        }
    }
}

export component EmptyStatePanel inherits HubPanel {
    in property <string> title;
    in property <string> detail;
    in property <string> extra-detail;
    in property <length> body-padding: HubTokens.space-4;
    in property <length> body-spacing: HubTokens.space-2;
    in property <bool> title-prominent: false;

    horizontal-stretch: 1;
    min-height: HubTokens.list-row-sm;

    EmptyStateBlock {
        width: parent.width;
        height: parent.height;
        title: root.title;
        detail: root.detail;
        extra-detail: root.extra-detail;
        body-padding: root.body-padding;
        body-spacing: root.body-spacing;
        title-prominent: root.title-prominent;
    }
}

export component StatusBanner inherits HubPanel {
    in property <string> title;
    in property <string> detail;
    in property <string> tone: "info";

    variant: root.tone == "error" ? "danger" : "elevated";
    height: HubTokens.list-row-sm;
    vertical-stretch: 0;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: HubTokens.space-4;
        spacing: HubTokens.space-1;

        MaterialText {
            text: root.title;
            overflow: elide;
            color: HubTokens.text-primary;
            style: MaterialTypography.title_small;
        }

        if root.detail != "": MutedText {
            text: root.detail;
            overflow: elide;
        }
    }
}

export component HubSectionSummary inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <length> summary-height: HubTokens.control-sm + HubTokens.space-4;
    in property <length> summary-spacing: HubTokens.panel-gap;
    in property <color> title-foreground: HubTokens.text-primary;
    in property <bool> prominent: false;

    horizontal-stretch: 1;
    min-width: 1px;
    preferred-width: 0px;
    height: root.summary-height;
    vertical-stretch: 0;
    background: transparent;
    clip: true;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: root.summary-spacing;

        MaterialText {
            text: root.title;
            overflow: elide;
            color: root.title-foreground;
            style: root.prominent ? MaterialTypography.headline_small : MaterialTypography.title_small;
            horizontal-stretch: 1;
            min-width: 1px;
        }

        if root.detail != "": MutedText {
            text: root.detail;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 1px;
        }
    }
}

export component HubSection inherits Rectangle {
    in property <length> section-height: HubTokens.list-row-lg;
    in property <length> section-spacing: HubTokens.toolbar-gap;
    in property <string> title;
    in property <string> subtitle;
    in property <string> badge-text;
    in property <string> badge-tone: "neutral";
    in property <bool> show-badge: false;
    in property <bool> stretch: false;

    horizontal-stretch: 1;
    min-width: 1px;
    preferred-width: 0px;
    height: root.section-height;
    vertical-stretch: root.stretch ? 1 : 0;
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        vertical-stretch: 0;
        spacing: root.section-spacing;

        PanelHeader {
            title: root.title;
            subtitle: root.subtitle;
            show-badge: root.show-badge;
            badge-text: root.badge-text;
            badge-tone: root.badge-tone;
        }

        @children
    }
}
