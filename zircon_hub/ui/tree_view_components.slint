import { HubRowActionButton } from "icon_button_components.slint";
import { HubInteractiveRowSurface } from "data_display.slint";
import { PanelListViewport } from "list_container_components.slint";
import { HubRowLeadingIconSlot, HubRowMainSlot, HubRowTrailingSlot } from "row_slot_components.slint";
import { HubTokens, HubVisualSpec } from "tokens.slint";
import { HubPanel, PanelHeader } from "surfaces.slint";
import { MaterialPalette } from "material_bridge.slint";

export struct TreeItemData {
    id: string,
    title: string,
    detail: string,
    depth: int,
    expanded: bool,
    selected: bool,
    disabled: bool,
    has-children: bool,
    icon-image: image,
    has-icon-image: bool,
    trailing-text: string,
    trailing-tone: string,
}

export component HubTreeRow inherits HubInteractiveRowSurface {
    in property <TreeItemData> item;
    in property <length> row-spacing: HubTokens.space-2;
    callback activated(string);
    callback toggle-expanded(string);

    private property <length> depth-indent: root.item.depth * HubTokens.space-4;
    private property <string> supporting-text: root.item.detail;
    private property <image> visible-icon-image: root.item.has-icon-image ? root.item.icon-image : @image-url("../assets/brand/zircon-mark.svg");

    selected: root.item.selected;
    enabled: !root.item.disabled;
    idle-background: HubVisualSpec.panel-background;
    selected-background: MaterialPalette.secondary_container;
    selected-border-width: HubTokens.border-width;
    row-radius: HubVisualSpec.compact-radius;
    interaction-enabled: root.enabled;
    interaction-foreground: root.content-foreground;

    clicked => {
        if root.enabled {
            root.activated(root.item.id);
        }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: HubTokens.space-3;
        padding-right: HubTokens.space-3;
        spacing: root.row-spacing;
        alignment: stretch;

        Rectangle {
            width: root.depth-indent;
            height: parent.height;
            background: transparent;
        }

        Rectangle {
            width: HubTokens.control-sm;
            height: HubTokens.control-sm;
            border-radius: HubVisualSpec.compact-radius;
            background: transparent;
            clip: true;

            if root.item.has-children: HubRowActionButton {
                button-size: HubTokens.control-sm;
                button-radius: HubVisualSpec.compact-radius;
                icon-size: HubTokens.icon-sm;
                icon-image: root.item.expanded ? @image-url("../assets/icons/ui/chevron-down.svg") : @image-url("../assets/icons/ui/chevron-right.svg");
                idle-foreground: MaterialPalette.on_surface_variant;
                state-layer-color: MaterialPalette.on_surface_variant;
                framed: false;
                clicked => {
                    if root.enabled {
                        root.toggle-expanded(root.item.id);
                    }
                }
            }
        }

        HubRowLeadingIconSlot {
            row-height: root.row-height;
            icon-image: root.visible-icon-image;
            has-icon-image: true;
            shell-background: HubVisualSpec.neutral-icon-background;
            shell-border: HubVisualSpec.neutral-icon-stroke;
            icon-foreground: HubVisualSpec.neutral-icon-foreground;
        }

        HubRowMainSlot {
            horizontal-stretch: 1;
            min-width: 1px;
            preferred-width: 0px;
            row-height: root.row-height;
            title: root.item.title;
            detail: root.supporting-text;
            title-foreground: root.content-foreground;
            detail-foreground: MaterialPalette.on_surface_variant;
        }

        if root.item.trailing-text != "": HubRowTrailingSlot {
            row-height: root.row-height;
            badge-text: root.item.trailing-text;
            badge-tone: root.item.trailing-tone;
            show-badge: true;
            show-action: false;
        }
    }
}

export component HubTreeView inherits HubPanel {
    in-out property <length> scroll-y: 0px;
    in property <string> title;
    in property <[TreeItemData]> items;
    in property <int> item-count;
    in property <length> row-height: HubTokens.list-row-md;
    in property <bool> show-header: false;
    callback activated(string);
    callback toggle-expanded(string);

    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-height: root.row-height * 3;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: HubTokens.space-4;
        spacing: HubTokens.space-2;

        if root.show-header: PanelHeader {
            title: root.title;
            show-badge: true;
            badge-text: root.item-count + "";
            badge-tone: "info";
        }

        PanelListViewport {
            scroll-y <=> root.scroll-y;
            row-count: root.item-count;
            row-height: root.row-height;
            row-spacing: HubTokens.space-1;
            vertical-padding: HubTokens.space-0;

            for item in root.items: HubTreeRow {
                item: item;
                row-height: root.row-height;
                activated(id) => {
                    root.activated(id);
                }
                toggle-expanded(id) => {
                    root.toggle-expanded(id);
                }
            }
        }
    }
}
