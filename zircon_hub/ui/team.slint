import { TeamData, TeamMemberData, UiTextData } from "shared.slint";
import { HubMetricSectionState, HubTokens, HubVisualSpec, PageScrollSurface, ResponsiveCollapse, WorkspacePanelSection } from "components.slint";
import { TeamActionsPanel, TeamMembersPanel, TeamSummarySlot } from "team_page_components.slint";

export component TeamPage inherits PageScrollSurface {
    in property <TeamData> summary;
    in property <[TeamMemberData]> members;
    in property <int> member-count;
    in property <bool> has-selected-project: false;
    in property <UiTextData> ui-text;
    private property <bool> overview-compact: root.content-width < HubTokens.panel-min-lg + HubTokens.panel-min-md + HubTokens.panel-gap;
    private property <length> member-row-height: HubTokens.list-row-md;
    private property <length> action-row-height: HubTokens.list-row-sm;
    private property <length> member-row-slot-height: root.member-row-height + HubTokens.space-2;
    private property <length> member-panel-chrome-height: HubTokens.list-row-sm + HubTokens.control-md + HubTokens.toolbar-gap * 2 + HubTokens.space-4 * 2;
    private property <int> member-visible-rows: root.member-count < 3 ? root.member-count : 3;
    private property <int> member-panel-rows: root.member-visible-rows + 1;
    private property <length> member-list-height: root.member-count == 0 ? root.member-row-height + HubTokens.space-2 + HubTokens.list-row-lg + HubTokens.space-4 : root.member-panel-rows * root.member-row-height + (root.member-panel-rows - 1) * HubTokens.space-2 + HubTokens.space-1 * 2;
    private property <length> members-panel-height: root.member-panel-chrome-height + root.member-list-height;
    private property <length> actions-panel-height: HubTokens.list-row-sm + root.action-row-height * 6 + HubTokens.toolbar-gap * 6 + HubTokens.space-4 * 2;
    private property <length> overview-section-height: max(root.members-panel-height, root.actions-panel-height);
    private property <length> member-scroll-y: 0px;
    private property <string> members-empty-detail: root.has-selected-project ? root.ui-text.team-empty-selected-detail : root.ui-text.team-empty-global-detail;

    background: HubVisualSpec.page-background;
    clip: true;

    label-collapse := ResponsiveCollapse {
        content-width: root.content-width;
        collapse-at: HubTokens.breakpoint-medium;
    }

    summary-metrics := HubMetricSectionState {
        content-width: root.content-width;
        metric-gap: HubTokens.panel-gap;
        regular-row-height: HubTokens.workspace-row-team-summary;
        compact-row-height: HubTokens.workspace-row-team-summary;
        allow-two-columns: false;
        wide-breakpoint: HubTokens.panel-min-sm * 3 + HubTokens.panel-gap * 3;
        compact-card-breakpoint: HubTokens.panel-min-sm * 3 + HubTokens.panel-gap * 3;
    }

    WorkspacePanelSection {
        compact: summary-metrics.row-count > 1;
        compact-rows: summary-metrics.row-count;
        row-height: summary-metrics.row-height;
        spacing-horizontal: summary-metrics.metric-gap;
        spacing-vertical: summary-metrics.metric-gap;

        TeamSummarySlot {
            basis: summary-metrics.slot-basis;
            flex-basis: summary-metrics.slot-basis;
            grow: summary-metrics.slot-grow;
            flex-grow: summary-metrics.slot-grow;
            shrink: 1;
            flex-shrink: 1;
            min-width: summary-metrics.slot-min-width;
            height: summary-metrics.row-height;
            label: root.ui-text.team-git-identity;
            primary: root.summary.identity-name;
            secondary: root.summary.identity-email;
            compact-card: summary-metrics.compact-card;
        }

        TeamSummarySlot {
            basis: summary-metrics.slot-basis;
            flex-basis: summary-metrics.slot-basis;
            grow: summary-metrics.slot-grow;
            flex-grow: summary-metrics.slot-grow;
            shrink: 1;
            flex-shrink: 1;
            min-width: summary-metrics.slot-min-width;
            height: summary-metrics.row-height;
            label: root.ui-text.team-repository;
            primary: root.summary.repository-path;
            secondary: root.summary.status;
            compact-card: summary-metrics.compact-card;
        }

        TeamSummarySlot {
            basis: summary-metrics.slot-basis;
            flex-basis: summary-metrics.slot-basis;
            grow: summary-metrics.slot-grow;
            flex-grow: summary-metrics.slot-grow;
            shrink: 1;
            flex-shrink: 1;
            min-width: summary-metrics.slot-min-width;
            height: summary-metrics.row-height;
            label: "Members";
            primary: root.member-count + " active";
            secondary: "Reviewers assigned";
            compact-card: summary-metrics.compact-card;
        }

        TeamSummarySlot {
            basis: summary-metrics.slot-basis;
            flex-basis: summary-metrics.slot-basis;
            grow: summary-metrics.slot-grow;
            flex-grow: summary-metrics.slot-grow;
            shrink: 1;
            flex-shrink: 1;
            min-width: summary-metrics.slot-min-width;
            height: summary-metrics.row-height;
            label: "Access";
            primary: "Local";
            secondary: "No cloud sign-in required";
            compact-card: summary-metrics.compact-card;
        }
    }

    WorkspacePanelSection {
        compact: root.overview-compact;
        compact-rows: 2;
        row-height: root.overview-section-height;
        spacing-horizontal: HubTokens.panel-gap;
        spacing-vertical: HubTokens.panel-gap;

        TeamMembersPanel {
            basis: HubTokens.panel-min-lg;
            flex-basis: HubTokens.panel-min-lg;
            grow: 2;
            flex-grow: 2;
            shrink: 1;
            flex-shrink: 1;
            min-width: root.overview-compact ? root.content-width : HubTokens.panel-min-lg;
            height: root.overview-section-height;
            summary: root.summary;
            members: root.members;
            member-count: root.member-count;
            member-row-height: root.member-row-height;
            members-empty-detail: root.members-empty-detail;
            repository-path: root.summary.repository-path;
            ui-text: root.ui-text;
            collapse-label: label-collapse.collapsed;
            member-scroll-y <=> root.member-scroll-y;
        }

        TeamActionsPanel {
            basis: HubTokens.panel-min-md;
            flex-basis: HubTokens.panel-min-md;
            grow: 1;
            flex-grow: 1;
            shrink: 1;
            flex-shrink: 1;
            min-width: root.overview-compact ? root.content-width : HubTokens.panel-min-md;
            height: root.overview-section-height;
            action-row-height: root.action-row-height;
        }
    }
}
