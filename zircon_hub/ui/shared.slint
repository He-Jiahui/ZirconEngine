export component BrandMark inherits Rectangle {
    width: MaterialStyleMetrics.size_40 + MaterialStyleMetrics.size_1;
    height: root.width;
    border-radius: HubVisualSpec.compact-radius;
    background: transparent;

    Image {
        width: parent.width;
        height: parent.height;
        y: MaterialStyleMetrics.size_1;
        source: @image-url("../assets/brand/zircon-mark.svg");
        image-fit: contain;
        opacity: 0.68;
    }
}

export component CenteredIcon inherits Rectangle {
    in property <image> source-image;
    in property <image> fallback-image: @image-url("../assets/icons/ui/alert.svg");
    in property <bool> has-source-image: false;
    in property <length> icon-size: MaterialStyleMetrics.icon_size_18;

    clip: true;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
        }

        HorizontalLayout {
            height: root.icon-size;
            alignment: center;

            Image {
                width: root.icon-size;
                height: root.icon-size;
                source: root.has-source-image ? root.source-image : root.fallback-image;
                image-fit: contain;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
        }
    }
}

export component NavButton inherits Rectangle {
    in property <NavItemData> item;
    in property <bool> collapsed: false;
    in property <bool> enabled: true;
    in property <bool> focused: false;
    callback clicked(string);

    height: MaterialStyleMetrics.size_48 + MaterialStyleMetrics.size_2;
    border-radius: HubVisualSpec.compact-radius;
    border-width: root.focused ? HubVisualSpec.focus-ring-width : (root.item.active ? HubTokens.border-width : 0px);
    border-color: root.focused ? HubVisualSpec.focus-ring-color : HubVisualSpec.nav-active-stroke;
    background: root.item.active ? HubVisualSpec.nav-active-fill : transparent;
    opacity: root.enabled ? 1.0 : HubVisualSpec.disabled-opacity;
    clip: true;

    StateLayerArea {
        width: parent.width;
        height: parent.height;
        color: root.item.active ? HubVisualSpec.nav-active-stroke : MaterialPalette.on_surface;
        border_radius: HubVisualSpec.compact-radius;
        clicked => {
            if (root.enabled) {
                root.clicked(root.item.id);
            }
        }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: root.collapsed ? 0px : HubTokens.space-3;
        padding-right: root.collapsed ? 0px : HubTokens.space-3;
        spacing: HubTokens.space-3;
        alignment: start;

        Rectangle {
            width: HubTokens.icon-lg;
            height: parent.height;

            Image {
                width: HubTokens.icon-lg;
                height: HubTokens.icon-lg;
                source: root.item.has-icon-image ? root.item.icon-image : @image-url("../assets/icons/nav/projects.svg");
                colorize: root.item.active ? HubVisualSpec.neutral-icon-foreground : HubVisualSpec.nav-idle-foreground;
            }
        }

        if !root.collapsed: MaterialText {
            horizontal-stretch: 1;
            height: parent.height;
            text: root.item.title;
            color: root.item.active ? MaterialPalette.on_surface : HubVisualSpec.nav-idle-foreground;
            style: MaterialTypography.label_large;
            overflow: elide;
            vertical_alignment: center;
        }
    }
}

export component StatusPill inherits Rectangle {
    in property <string> icon;
    in property <image> icon-image;
    in property <image> fallback-icon-image: @image-url("../assets/icons/ui/alert.svg");
    in property <bool> has-icon-image: false;
    in property <string> text;
    in property <color> accent-color;
    in property <string> tone: "custom";
    private property <bool> show-running-dot: root.icon == ">" || root.tone == "running";

    height: MaterialStyleMetrics.size_40 - MaterialStyleMetrics.size_2;
    min-width: root.height * 5 / 2;
    border-radius: HubVisualSpec.compact-radius;
    border-width: MaterialStyleMetrics.size_1;
    border-color: root.tone == "running" ? HubVisualSpec.status-running-stroke.with_alpha(0.34) : (root.tone == "success" || root.tone == "ok" ? HubVisualSpec.status-success-stroke.with_alpha(0.34) : (root.tone == "warning" ? HubVisualSpec.status-warning-stroke.with_alpha(0.42) : (root.tone == "error" ? HubVisualSpec.status-error-stroke.with_alpha(0.44) : (root.tone == "neutral" ? HubVisualSpec.status-neutral-stroke : (root.tone == "info" ? HubVisualSpec.status-info-stroke.with_alpha(0.36) : root.accent-color.with_alpha(0.36))))));
    background: root.tone == "running" ? HubVisualSpec.status-running-fill : (root.tone == "success" || root.tone == "ok" ? HubVisualSpec.status-success-fill : (root.tone == "warning" ? HubVisualSpec.status-warning-fill : (root.tone == "error" ? HubVisualSpec.status-error-fill : (root.tone == "neutral" ? HubVisualSpec.status-neutral-fill : (root.tone == "info" ? HubVisualSpec.status-info-fill : root.accent-color.with-alpha(0.11))))));
    clip: true;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: MaterialStyleMetrics.spacing_12;
        padding-right: MaterialStyleMetrics.spacing_12;
        spacing: MaterialStyleMetrics.spacing_8;
        alignment: center;

        Rectangle {
            width: HubTokens.icon-xs;
            height: parent.height;
            background: transparent;

            VerticalLayout {
                width: parent.width;
                height: parent.height;

                Rectangle { vertical-stretch: 1; min-height: 0px; }

                Image {
                    width: HubTokens.icon-xs;
                    height: HubTokens.icon-xs;
                    source: root.icon == ">" ? @image-url("../assets/icons/status/reference-running.svg") : (root.icon == "!" ? @image-url("../assets/icons/status/reference-warning.svg") : (root.icon == "x" ? @image-url("../assets/icons/status/reference-error.svg") : @image-url("../assets/icons/status/reference-success.svg")));
                    image-fit: contain;
                }

                Rectangle { vertical-stretch: 1; min-height: 0px; }
            }
        }

        MaterialText {
            height: parent.height;
            text: root.text;
            color: root.tone == "running" ? HubVisualSpec.status-running-foreground : (root.tone == "success" || root.tone == "ok" ? HubVisualSpec.status-success-foreground : (root.tone == "warning" ? HubVisualSpec.status-warning-foreground : (root.tone == "error" ? HubVisualSpec.status-error-foreground : (root.tone == "neutral" ? HubVisualSpec.status-neutral-foreground : (root.tone == "info" ? HubVisualSpec.status-info-foreground : root.accent-color)))));
            style: MaterialTypography.label_medium;
            overflow: elide;
            vertical_alignment: center;
        }

        if root.show-running-dot: Rectangle {
            width: MaterialStyleMetrics.size_6;
            height: parent.height;
            background: transparent;

            VerticalLayout {
                width: parent.width;
                height: parent.height;

                Rectangle { vertical-stretch: 1; min-height: 0px; }

                Rectangle {
                    width: MaterialStyleMetrics.size_6;
                    height: MaterialStyleMetrics.size_6;
                    border-radius: MaterialStyleMetrics.size_3;
                    background: root.accent-color;
                }

                Rectangle { vertical-stretch: 1; min-height: 0px; }
            }
        }
    }
}

export component Panel inherits Rectangle {
    border-radius: HubVisualSpec.panel-radius;
    border-width: MaterialStyleMetrics.size_1;
    border-color: HubVisualSpec.outline-muted;
    background: HubVisualSpec.panel-background;
}

export component FieldLabel inherits MaterialText {
    color: MaterialPalette.on_surface;
    style: MaterialTypography.label_large;
}

export component MutedText inherits MaterialText {
    color: MaterialPalette.on_surface_variant;
    style: MaterialTypography.body_small;
}
