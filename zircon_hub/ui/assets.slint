import { AssetData, UiTextData } from "shared.slint";
import { CatalogPage, HubTokens, ResponsiveCollapse } from "components.slint";
import { AssetRow } from "catalog_page_components.slint";

export component AssetsPage inherits CatalogPage {
    in property <[AssetData]> assets;
    in property <int> asset-count;
    in property <bool> has-selected-project: false;
    in property <UiTextData> ui-text;
    private property <string> catalog-title: root.has-selected-project ? root.ui-text.asset-catalog-selected : root.ui-text.asset-catalog;
    private property <string> assets-empty-detail: root.has-selected-project ? root.ui-text.asset-empty-selected-detail : root.ui-text.asset-empty-global-detail;
    private property <string> detail-summary: root.has-selected-project ? "Selected project and Source Engine assets." : "Project and Source Engine asset index.";

    title: root.catalog-title;
    badge-text: root.asset-count + " " + root.ui-text.assets-found;
    badge-tone: "accent";
    empty-title: root.ui-text.no-assets-found;
    empty-detail: root.assets-empty-detail;
    row-count: root.asset-count;
    row-height: HubTokens.list-row-md;
    detail-title: root.catalog-title + " Detail";
    detail-subtitle: root.detail-summary;
    detail-primary: root.asset-count + " " + root.ui-text.assets-found;
    detail-secondary: root.has-selected-project ? "Project scope asset index" : "Workspace and engine asset index";
    detail-icon-image: @image-url("../assets/icons/nav/assets.svg");
    detail-stat-one-label: root.ui-text.assets-found;
    detail-stat-one-value: root.asset-count + "";
    detail-stat-one-detail: root.has-selected-project ? "Selected project" : "All projects";
    detail-stat-two-label: root.ui-text.asset-source;
    detail-stat-two-value: root.has-selected-project ? "Project" : "Workspace";
    detail-stat-two-detail: "Local catalog";
    detail-stat-three-label: root.ui-text.asset-kind;
    detail-stat-three-value: "Mixed";
    detail-stat-three-detail: "Images, UI, resources";
    detail-stat-four-label: root.ui-text.asset-size;
    detail-stat-four-value: "Indexed";
    detail-stat-four-detail: "Metadata ready";
    detail-check-one-title: "Project link";
    detail-check-one-detail: root.has-selected-project ? "Bound to selected project" : "Showing global workspace scope";
    detail-check-one-badge: root.has-selected-project ? "Project" : "Global";
    detail-check-one-tone: root.has-selected-project ? "ok" : "neutral";
    detail-check-two-title: "Metadata";
    detail-check-two-detail: "Source, kind, size, path columns aligned";
    detail-check-two-badge: "Ready";
    detail-check-two-tone: "ok";
    detail-check-three-title: "Review";
    detail-check-three-detail: root.asset-count == 0 ? root.assets-empty-detail : "Review paths and source ownership";
    detail-check-three-badge: root.asset-count == 0 ? "Empty" : "Review";
    detail-check-three-tone: root.asset-count == 0 ? "warning" : "neutral";

    label-collapse := ResponsiveCollapse {
        content-width: root.content-width;
        collapse-at: HubTokens.breakpoint-medium;
    }

    for asset in root.assets: AssetRow {
        asset: asset;
        ui-text: root.ui-text;
        collapse-label: label-collapse.collapsed;
        content-width: root.content-width;
    }
}
