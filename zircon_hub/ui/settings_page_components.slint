import { SettingStatusData, UiTextData } from "shared.slint";
import { HubFormActionRow } from "button_components.slint";
import {
    EmptyStateBlock,
    HubContentPanelSlot,
    HubComboBox,
    HubFormPanelSlot,
    HubListPanelSlot,
    HubMetricSlot,
    HubPathFieldRow,
    HubTextField,
    HubTokens,
    InfoRow,
    MenuItem,
} from "components.slint";

export component PathSettingRow inherits Rectangle {
    in property <string> label;
    in property <string> browse-label;
    in property <length> row-preferred-width: HubTokens.input-width + HubTokens.control-md * 3 + HubTokens.toolbar-gap;
    in-out property <string> value;
    callback browse;

    min-width: 1px;
    preferred-width: root.row-preferred-width;
    horizontal-stretch: 1;
    height: HubTokens.input-field;

    HubPathFieldRow {
        width: parent.width;
        height: parent.height;
        label: root.label;
        placeholder: root.label;
        text <=> root.value;
        action-label: root.browse-label;
        action-icon: @image-url("../assets/icons/ui/folder.svg");
        action-width: HubTokens.control-md * 3;
        action-height: HubTokens.control-md;
        row-spacing: HubTokens.toolbar-gap;
        row-preferred-width: root.row-preferred-width;
        action-clicked => {
            root.browse();
        }
    }
}

export component SettingStatusRow inherits InfoRow {
    in property <SettingStatusData> status;
    in property <bool> collapse-label: false;
    callback triggered(string);

    title: root.status.label;
    detail: root.status.detail;
    meta: root.collapse-label ? root.status.scope : (root.status.disabled-reason == "" ? root.status.scope : (root.status.scope == "" ? root.status.disabled-reason : root.status.scope + " / " + root.status.disabled-reason));
    leading-image: root.status.state == "ok" ? @image-url("../assets/icons/status/success.svg") : (root.status.state == "warn" ? @image-url("../assets/icons/status/warning.svg") : (root.status.state == "error" ? @image-url("../assets/icons/status/error.svg") : @image-url("../assets/icons/status/running.svg")));
    has-leading-image: true;
    accent: root.status.state == "ok" ? 3 : (root.status.state == "warn" ? 2 : (root.status.state == "error" ? 2 : 1));
    trailing-text: root.status.action-label == "" ? root.status.detail : root.status.action-label;
    trailing-tone: root.status.state == "ok" ? "ok" : (root.status.state == "warn" ? "warning" : (root.status.state == "error" ? "error" : "info"));
    show-trailing-badge: true;
    collapse-trailing-label: root.collapse-label;
    show-arrow: root.status.actionable;
    row-height: HubTokens.list-row-md;
    clicked => {
        if (root.status.actionable) {
            root.triggered(root.status.action-id);
        }
    }
}

export component SettingsToolchainField inherits HubTextField {
    in property <string> field-label;
    in-out property <string> field-value;

    label: root.field-label;
    placeholder: root.field-label;
    text <=> root.field-value;
}

export component SettingsComboChoice inherits Rectangle {
    in property <string> label;
    in property <string> first-label;
    in property <string> first-value;
    in property <string> second-label;
    in property <string> second-value;
    in-out property <string> selected-value;

    private property <int> desired-index: root.selected-value == root.second-value ? 1 : 0;
    private property <int> selected-index: -1;
    private property <[MenuItem]> choice-items: [
        { icon: @image-url("../assets/icons/ui/settings.svg"), text: root.first-label, trailing_text: "", enabled: true },
        { icon: @image-url("../assets/icons/ui/settings.svg"), text: root.second-label, trailing_text: "", enabled: true },
    ];

    horizontal-stretch: 1;
    height: HubTokens.input-field;

    HubComboBox {
        width: parent.width;
        height: parent.height;
        combo-width: parent.width;
        combo-height: parent.height;
        label: root.label;
        leading-icon: @image-url("../assets/icons/ui/settings.svg");
        items: root.choice-items;
        current-index: root.selected-index;
        selected(index) => {
            root.selected-index = index;
            root.selected-value = index == 1 ? root.second-value : root.first-value;
        }
    }

    init => {
        root.selected-index = root.desired-index;
    }

    changed selected-value => {
        root.selected-index = root.desired-index;
    }
}

export component SettingsSaveActionRow inherits HubFormActionRow {
    in property <length> button-width;

    action-width: root.button-width;
    action-height: HubTokens.control-md;
    action-icon: @image-url("../assets/icons/ui/chevron-right.svg");
}

export component SettingsConfigurationOverviewPanel inherits HubContentPanelSlot {
    in property <string> panel-title;
    in property <UiTextData> ui-text;
    in property <int> settings-status-count;
    in property <string> build-profile;
    in property <string> language;
    in property <string> project-location;

    title: root.panel-title;
    show-badge: true;
    badge-text: root.settings-status-count + " " + root.ui-text.configuration-health;
    badge-tone: root.settings-status-count == 0 ? "warning" : "ok";
    badge-width: HubTokens.control-lg * 5;
    content-spacing: HubTokens.space-2;

    VerticalLayout {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        spacing: HubTokens.space-2;

        HorizontalLayout {
            horizontal-stretch: 1;
            height: HubTokens.list-row-md;
            spacing: HubTokens.space-2;

            HubMetricSlot {
                horizontal-stretch: 1;
                height: parent.height;
                label: root.ui-text.build-profile;
                primary: root.build-profile;
                secondary: root.ui-text.build-defaults;
                compact-card: true;
            }

            HubMetricSlot {
                horizontal-stretch: 1;
                height: parent.height;
                label: root.ui-text.language;
                primary: root.language;
                secondary: root.ui-text.toolchain;
                compact-card: true;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            height: HubTokens.list-row-md;
            spacing: HubTokens.space-2;

            HubMetricSlot {
                horizontal-stretch: 1;
                height: parent.height;
                label: root.ui-text.default-project-directory;
                primary: root.project-location == "" ? root.ui-text.location : root.project-location;
                secondary: root.ui-text.default-paths;
                compact-card: true;
            }

            HubMetricSlot {
                horizontal-stretch: 1;
                height: parent.height;
                label: root.ui-text.configuration-health;
                primary: root.settings-status-count + "";
                secondary: root.ui-text.no-configuration-checks;
                compact-card: true;
            }
        }
    }
}

export component SettingsToolchainPanel inherits HubFormPanelSlot {
    in property <string> panel-title;
    in property <UiTextData> ui-text;
    in-out property <string> python-path;
    in-out property <string> cargo-path;
    in-out property <string> rustup-path;

    title: root.panel-title;
    form-spacing: HubTokens.space-2;

    SettingsToolchainField {
        field-label: root.ui-text.python-executable;
        field-value <=> root.python-path;
    }
    SettingsToolchainField {
        field-label: root.ui-text.cargo-executable;
        field-value <=> root.cargo-path;
    }
    SettingsToolchainField {
        field-label: root.ui-text.rustup-executable;
        field-value <=> root.rustup-path;
    }
}

export component SettingsBuildDefaultsPanel inherits HubFormPanelSlot {
    in property <string> panel-title;
    in property <UiTextData> ui-text;
    in-out property <string> build-jobs;
    in-out property <string> build-profile;
    in-out property <string> language;

    title: root.panel-title;
    form-spacing: HubTokens.space-2;

    SettingsComboChoice {
        label: root.ui-text.build-profile;
        first-label: root.ui-text.debug;
        first-value: "debug";
        second-label: root.ui-text.release;
        second-value: "release";
        selected-value <=> root.build-profile;
    }

    HubTextField {
        label: root.ui-text.build-jobs;
        placeholder: root.ui-text.build-jobs;
        text <=> root.build-jobs;
    }

    SettingsComboChoice {
        label: root.ui-text.language;
        first-label: root.ui-text.english;
        first-value: "English";
        second-label: root.ui-text.chinese;
        second-value: "Chinese";
        selected-value <=> root.language;
    }
}

export component SettingsDefaultPathsPanel inherits HubListPanelSlot {
    in property <string> panel-title;
    in property <UiTextData> ui-text;
    in-out property <string> project-location;
    in-out property <string> source-path;
    in-out property <string> output-path;
    in-out property <string> device-install-path;
    in-out property <length> paths-scroll-y: 0px;
    callback browse-folder(string);

    title: root.panel-title;
    scroll-y <=> root.paths-scroll-y;
    row-count: 4;
    row-height: HubTokens.input-field;
    row-spacing: HubTokens.space-2;
    vertical-padding: 0px;

    PathSettingRow {
        label: root.ui-text.default-project-directory;
        browse-label: root.ui-text.browse;
        value <=> root.project-location;
        browse => {
            root.browse-folder("project-location");
        }
    }
    PathSettingRow {
        label: root.ui-text.default-source-directory;
        browse-label: root.ui-text.browse;
        value <=> root.source-path;
        browse => {
            root.browse-folder("source");
        }
    }
    PathSettingRow {
        label: root.ui-text.default-staged-output-directory;
        browse-label: root.ui-text.browse;
        value <=> root.output-path;
        browse => {
            root.browse-folder("output");
        }
    }
    PathSettingRow {
        label: root.ui-text.default-device-install-directory;
        browse-label: root.ui-text.browse;
        value <=> root.device-install-path;
        browse => {
            root.browse-folder("device-install");
        }
    }
}

export component SettingsConfigurationHealthPanel inherits HubListPanelSlot {
    in property <string> panel-title;
    in property <UiTextData> ui-text;
    in property <[SettingStatusData]> settings-statuses;
    in property <int> settings-status-count;
    in property <bool> compact-labels: false;
    in property <length> health-empty-height: HubTokens.list-row-lg + HubTokens.space-4;
    in-out property <length> health-scroll-y: 0px;
    callback status-action(string);

    title: root.panel-title;
    scroll-y <=> root.health-scroll-y;
    row-count: root.settings-status-count;
    row-height: HubTokens.list-row-md;
    row-spacing: HubTokens.space-2;
    empty-height: root.health-empty-height;

    if root.settings-status-count == 0: EmptyStateBlock {
        height: root.health-empty-height;
        title: root.ui-text.no-configuration-checks;
        detail: root.ui-text.configuration-health-empty-detail;
        body-padding: HubTokens.space-4;
        center-content: true;
    }

    for status in root.settings-statuses: SettingStatusRow {
        status: status;
        collapse-label: root.compact-labels;
        triggered(action-id) => {
            root.status-action(action-id);
        }
    }
}
