import { OperationTimelineRowData, ProjectDetailData, SourceBuildHistoryRowData, SourceEngineData, UiTextData, WorkspaceActionReadinessData } from "shared.slint";
import { HubTokens, HubVisualSpec, HubWorkspaceSplitState, HubWorkspaceTabStrip, OperationTimelinePanel, PageScrollSurface, WorkspacePanelSection } from "components.slint";
import {
    BuildControlsPanel,
    BuildPipelinePanel,
    BuildSourceSummaryPanel,
    BuildTaskHistoryPanel,
} from "builds_page_components.slint";

export component BuildsPage inherits PageScrollSurface {
    in property <WorkspaceActionReadinessData> readiness;
    in property <ProjectDetailData> project;
    in property <SourceEngineData> source-engine;
    in property <[SourceBuildHistoryRowData]> source-build-history;
    in property <int> source-build-history-count;
    in property <[OperationTimelineRowData]> operation-timeline;
    in property <int> operation-timeline-count;
    in property <string> status-label;
    in property <string> status-detail;
    in property <UiTextData> ui-text;
    callback build-engine();
    callback open-output();
    callback launch-editor();
    callback package-project();
    callback install-device();
    private property <length> build-history-scroll-y: 0px;
    private property <length> operation-timeline-scroll-y: 0px;
    private property <length> build-row-height: HubTokens.list-row-sm - HubTokens.space-2;
    private property <length> build-summary-height: HubTokens.control-md + root.build-row-height * 5 + HubTokens.toolbar-gap * 5 + HubTokens.space-4 * 2;
    private property <length> build-source-summary-height: HubTokens.list-row-sm + HubTokens.border-width + root.build-row-height * 2 + HubTokens.control-md + HubTokens.toolbar-gap * 4 + HubTokens.space-4 * 2;
    private property <length> build-summary-section-height: root.build-source-summary-height + root.build-summary-height + HubTokens.panel-gap;
    private property <length> build-detail-height: HubTokens.control-md + root.build-row-height * 4 + HubTokens.toolbar-gap * 4 + HubTokens.space-4 * 2;
    private property <bool> controls-first: workspace-split.compact && root.content-height < root.build-summary-section-height + HubTokens.control-lg;

    background: HubVisualSpec.page-background;
    clip: true;

    workspace-split := HubWorkspaceSplitState {
        content-width: root.content-width;
        compact-label-breakpoint: HubTokens.breakpoint-medium;
    }

    HubWorkspaceTabStrip {
        current-index: 0;
        first-label: "Overview";
        second-label: "Pipeline";
        third-label: "History";
        fourth-label: "Timeline";
    }

    WorkspacePanelSection {
        compact: workspace-split.compact;
        row-height: root.build-summary-height;
        compact-height-override: root.build-summary-section-height;
        spacing-horizontal: HubTokens.panel-gap;
        spacing-vertical: HubTokens.panel-gap;

        BuildSourceSummaryPanel {
            basis: workspace-split.main-basis;
            flex-basis: workspace-split.main-basis;
            grow: workspace-split.main-grow;
            flex-grow: workspace-split.main-grow;
            shrink: 1;
            flex-shrink: 1;
            order: root.controls-first ? 1 : 0;
            flex-order: root.controls-first ? 1 : 0;
            min-width: workspace-split.main-min-width;
            height: workspace-split.compact ? root.build-source-summary-height : root.build-summary-height;
            readiness: root.readiness;
            project: root.project;
            source-engine: root.source-engine;
            status-label: root.status-label;
            ui-text: root.ui-text;
            row-height: root.build-row-height;
            collapse-label: workspace-split.compact-labels;
        }

        BuildControlsPanel {
            basis: workspace-split.side-basis;
            flex-basis: workspace-split.side-basis;
            grow: workspace-split.side-grow;
            flex-grow: workspace-split.side-grow;
            shrink: 1;
            flex-shrink: 1;
            order: root.controls-first ? 0 : 1;
            flex-order: root.controls-first ? 0 : 1;
            min-width: workspace-split.side-min-width;
            height: root.build-summary-height;
            readiness: root.readiness;
            project: root.project;
            source-engine: root.source-engine;
            ui-text: root.ui-text;
            row-height: root.build-row-height;
            build-engine => { root.build-engine(); }
            open-output => { root.open-output(); }
            launch-editor => { root.launch-editor(); }
            package-project => { root.package-project(); }
            install-device => { root.install-device(); }
        }
    }

    WorkspacePanelSection {
        compact: workspace-split.compact;
        compact-rows: 3;
        row-height: root.build-detail-height;
        spacing-horizontal: HubTokens.panel-gap;
        spacing-vertical: HubTokens.panel-gap;

        BuildPipelinePanel {
            basis: workspace-split.main-basis - HubTokens.control-lg * 3;
            flex-basis: workspace-split.main-basis - HubTokens.control-lg * 3;
            grow: workspace-split.main-grow;
            flex-grow: workspace-split.main-grow;
            shrink: 1;
            flex-shrink: 1;
            min-width: workspace-split.compact ? root.content-width : workspace-split.main-basis - HubTokens.control-lg * 3;
            height: root.build-detail-height;
            readiness: root.readiness;
            project: root.project;
            source-engine: root.source-engine;
            status-label: root.status-label;
            ui-text: root.ui-text;
            row-height: root.build-row-height;
            collapse-label: workspace-split.compact-labels;
        }

        BuildTaskHistoryPanel {
            basis: HubTokens.panel-min-sm;
            flex-basis: HubTokens.panel-min-sm;
            grow: 1;
            flex-grow: 1;
            shrink: 1;
            flex-shrink: 1;
            min-width: workspace-split.compact ? root.content-width : HubTokens.panel-min-sm;
            height: root.build-detail-height;
            readiness: root.readiness;
            status-label: root.status-label;
            status-detail: root.status-detail;
            current-task-title: root.ui-text.current-task;
            build-history-title: root.ui-text.build-history;
            no-build-history-title: root.ui-text.no-build-history-short;
            source-build-history: root.source-build-history;
            source-build-history-count: root.source-build-history-count;
            row-height: root.build-row-height;
            history-scroll-y <=> root.build-history-scroll-y;
            collapse-label: workspace-split.compact-labels;
        }

        OperationTimelinePanel {
            basis: HubTokens.panel-min-sm;
            flex-basis: HubTokens.panel-min-sm;
            grow: 1;
            flex-grow: 1;
            shrink: 1;
            flex-shrink: 1;
            min-width: workspace-split.compact ? root.content-width : HubTokens.panel-min-sm;
            height: root.build-detail-height;
            timeline-title: root.ui-text.operation-timeline;
            empty-title: root.ui-text.no-operation-timeline;
            empty-detail: root.ui-text.operation-timeline-empty-detail-short;
            operation-timeline: root.operation-timeline;
            operation-timeline-count: root.operation-timeline-count;
            row-height: root.build-row-height;
            timeline-scroll-y <=> root.operation-timeline-scroll-y;
            collapse-label: workspace-split.compact-labels;
        }
    }

}
