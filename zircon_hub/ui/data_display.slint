import {
    QuickActionData,
    SourceBuildHistoryRowData,
    MutedText,
} from "shared.slint";
import { ResponsiveSlot } from "layout.slint";
import { HubRowLeadingIconSlot, HubRowMainSlot, HubRowMetaSlot, HubRowTrailingSlot } from "row_slot_components.slint";
import { HubTokens, HubVisualSpec } from "tokens.slint";
import { HubPanel } from "surfaces.slint";
import {
    Icon,
    ListTile,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    StateLayerArea,
} from "material_bridge.slint";

export component HubRowSurface inherits Rectangle {
    in property <bool> selected: false;
    in property <bool> focused: false;
    in property <bool> enabled: true;
    in property <length> row-height: HubTokens.list-row-md;
    in property <length> row-radius: HubVisualSpec.compact-radius;
    in property <length> idle-border-width: 0px;
    in property <length> selected-border-width: HubTokens.border-width;
    in property <color> idle-border: transparent;
    in property <color> selected-border: HubVisualSpec.accent-stroke;
    in property <color> idle-background: HubVisualSpec.panel-background;
    in property <color> selected-background: MaterialPalette.secondary_container;
    in property <color> disabled-background: HubVisualSpec.panel-background.with_alpha(HubVisualSpec.disabled-opacity);
    in property <color> idle-foreground: MaterialPalette.on_surface;
    in property <color> selected-foreground: MaterialPalette.on_secondary_container;
    in property <color> content-foreground: root.selected ? root.selected-foreground : root.idle-foreground;

    horizontal-stretch: 1;
    height: root.row-height;
    min-width: 1px;
    preferred-width: 0px;
    border-radius: root.row-radius;
    border-width: root.focused ? HubVisualSpec.focus-ring-width : (root.selected ? root.selected-border-width : root.idle-border-width);
    border-color: root.focused ? HubVisualSpec.focus-ring-color : (root.selected ? root.selected-border : root.idle-border);
    background: !root.enabled ? root.disabled-background : (root.selected ? root.selected-background : root.idle-background);
    opacity: root.enabled ? 1.0 : HubVisualSpec.disabled-opacity;
    clip: true;

    @children
}

export component HubInteractiveRowSurface inherits HubRowSurface {
    in property <bool> interaction-enabled: root.enabled;
    in property <color> interaction-foreground: root.content-foreground;
    callback clicked;

    row-state := StateLayerArea {
        width: parent.width;
        height: parent.height;
        color: root.interaction-foreground;
        border_radius: root.row-radius;
        clicked => {
            if (root.interaction-enabled) {
                root.clicked();
            }
        }
    }

    @children
}

component HubMenuRowTrailingText inherits MaterialText {
    in property <string> value;
    in property <color> foreground;

    text: root.value;
    color: root.foreground;
    style: MaterialTypography.label_medium;
    horizontal_alignment: right;
    vertical_alignment: center;
    overflow: elide;
}

export component HubMenuRow inherits HubRowSurface {
    in property <string> title;
    in property <string> detail;
    in property <image> leading-image;
    in property <bool> has-leading-image: false;
    in property <image> trailing-image: @image-url("../assets/icons/ui/chevron-right.svg");
    in property <string> trailing-text;
    in property <bool> show-trailing-icon: false;
    in property <bool> show-trailing-text: false;
    in property <bool> dense: false;
    in property <color> enabled-avatar-background: HubVisualSpec.neutral-icon-background;
    in property <color> enabled-avatar-foreground: HubVisualSpec.neutral-icon-foreground;
    callback clicked;

    private property <length> trailing-slot-width: root.show-trailing-text ? HubTokens.control-md * 2 : (root.show-trailing-icon ? HubTokens.control-sm : 0px);
    private property <color> avatar-background: root.has-leading-image ? root.enabled-avatar-background : transparent;
    private property <color> avatar-foreground: root.enabled-avatar-foreground;

    row-height: root.dense ? HubTokens.list-row-sm : HubTokens.list-row-md;
    selected-border-width: 0px;
    idle-background: transparent;
    selected-background: MaterialPalette.secondary_container;

    ListTile {
        width: parent.width;
        height: parent.height;
        text: root.title;
        supporting_text: root.detail;
        avatar_icon: root.leading-image;
        avatar_background: root.avatar-background;
        avatar_foreground: root.avatar-foreground;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }

        Rectangle {
            width: root.trailing-slot-width;
            height: parent.height;
            background: transparent;

            if root.show-trailing-text: HubMenuRowTrailingText {
                width: parent.width;
                height: parent.height;
                value: root.trailing-text;
                foreground: root.content-foreground;
            }

            if root.show-trailing-icon: Icon {
                width: HubTokens.icon-sm;
                height: HubTokens.icon-sm;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                source: root.trailing-image;
                colorize: root.content-foreground;
            }
        }
    }
}

export component InfoRow inherits HubInteractiveRowSurface {
    in property <string> title;
    in property <string> detail;
    in property <string> meta;
    in property <image> leading-image;
    in property <bool> has-leading-image: false;
    in property <int> accent: 0;
    in property <string> trailing-text;
    in property <string> trailing-tone: "neutral";
    in property <bool> show-trailing-badge: false;
    in property <bool> collapse-trailing-label: false;
    in property <bool> show-arrow: false;
    in property <bool> pressed: false;
    in property <bool> hovered: false;
    in property <color> enabled-avatar-background: root.avatar-background;
    in property <color> enabled-avatar-foreground: root.avatar-foreground;

    private property <length> trailing-slot-width: root.show-trailing-badge ? (root.collapse-trailing-label ? (root.show-arrow ? HubTokens.control-md : 0px) : (root.show-arrow ? HubTokens.control-md * 4 : HubTokens.control-md * 3)) : (root.show-arrow ? HubTokens.control-md : 0px);
    private property <length> trailing-icon-size: max(MaterialStyleMetrics.size_32, min(HubTokens.control-md, root.row-height * 7 / 12));
    private property <color> avatar-background: HubVisualSpec.neutral-icon-background;
    private property <color> avatar-foreground: HubVisualSpec.neutral-icon-foreground;
    private property <string> supporting-text: root.detail == "" ? root.meta : (root.meta == "" ? root.detail : root.detail + " / " + root.meta);
    private property <image> visible-leading-image: root.has-leading-image ? root.leading-image : @image-url("../assets/brand/zircon-mark.svg");
    private property <length> leading-slot-width: HubTokens.control-lg;
    private property <length> badge-width: root.show-arrow ? max(HubTokens.control-md * 2, root.trailing-slot-width - root.trailing-icon-size - HubTokens.space-2) : root.trailing-slot-width;

    row-radius: HubVisualSpec.panel-radius;
    idle-border-width: HubTokens.border-width;
    selected-border-width: HubTokens.border-width;
    idle-border: HubVisualSpec.outline-muted;
    selected-border: HubVisualSpec.accent-stroke;
    idle-background: HubVisualSpec.panel-background;
    selected-background: MaterialPalette.secondary_container;
    disabled-background: HubVisualSpec.panel-background.with_alpha(HubVisualSpec.disabled-opacity);

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: HubTokens.space-3;
        padding-right: HubTokens.space-3;
        spacing: HubTokens.space-2;
        alignment: stretch;

        HubRowLeadingIconSlot {
            row-height: root.row-height;
            slot-width: root.leading-slot-width;
            icon-image: root.visible-leading-image;
            has-icon-image: true;
            shell-background: root.enabled ? root.enabled-avatar-background : MaterialPalette.surface_container_high;
            icon-foreground: root.enabled ? root.enabled-avatar-foreground : MaterialPalette.on_surface_variant;
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: 1px;
            preferred-width: 0px;
            height: parent.height;
            background: transparent;
            clip: true;

            HubRowMainSlot {
                width: parent.width;
                height: parent.height;
                title: root.title;
                detail: root.supporting-text;
                row-height: root.row-height;
                title-foreground: root.content-foreground;
                detail-foreground: MaterialPalette.on_surface_variant;
            }
        }

        if root.show-trailing-badge || root.show-arrow: HubRowTrailingSlot {
            slot-width: root.trailing-slot-width;
            row-height: root.row-height;
            badge-text: root.trailing-text;
            badge-tone: root.trailing-tone;
            badge-width: root.badge-width;
            show-badge: root.show-trailing-badge;
            collapse-badge: root.collapse-trailing-label;
            show-action: root.show-arrow;
            action-size: root.trailing-icon-size;
            action-icon-size: HubTokens.icon-sm;
            action-foreground: MaterialPalette.on_surface_variant;
            action-state-layer-color: MaterialPalette.on_surface_variant;
            clicked => {
                if (root.enabled) {
                    root.clicked();
                }
            }
        }
    }
}

export component HubKeyValueRow inherits HubRowSurface {
    in property <string> label;
    in property <string> value;
    in property <bool> badge-value: false;
    in property <string> badge-tone: "neutral";
    in property <length> label-width: HubTokens.control-md * 4;
    in property <length> badge-width: HubTokens.control-md * 3;
    in property <length> row-spacing: HubTokens.space-2;
    in property <color> label-foreground: MaterialPalette.on_surface_variant;
    in property <color> value-foreground: MaterialPalette.on_surface;

    row-height: HubTokens.control-md;
    selected-border-width: 0px;
    idle-background: transparent;
    selected-background: transparent;
    disabled-background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: root.row-spacing;
        alignment: stretch;

        HubRowMetaSlot {
            row-height: root.row-height;
            slot-width: root.label-width;
            text: root.label;
            foreground: root.label-foreground;
        }

        if !root.badge-value: HubRowMainSlot {
            row-height: root.row-height;
            title: root.value;
            detail: "";
            title-foreground: root.value-foreground;
        }

        if root.badge-value: Rectangle {
            horizontal-stretch: 1;
            min-width: 1px;
            height: parent.height;
            background: transparent;

            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;

                HubRowTrailingSlot {
                    row-height: root.row-height;
                    slot-width: root.badge-width;
                    badge-width: root.badge-width;
                    badge-text: root.value;
                    badge-tone: root.badge-tone;
                    show-badge: true;
                    show-action: false;
                }
            }
        }
    }
}

export component HubBadgeMetaStrip inherits HubRowSurface {
    in property <string> first-badge-text;
    in property <string> first-badge-tone: "accent";
    in property <length> first-badge-width: HubTokens.control-md * 3;
    in property <string> second-badge-text;
    in property <string> second-badge-tone: "neutral";
    in property <length> second-badge-width: HubTokens.control-md * 3;
    in property <string> meta-text;
    in property <length> row-spacing: HubTokens.space-2;
    in property <color> meta-foreground: MaterialPalette.on_surface_variant;

    private property <bool> show-first-badge: root.first-badge-text != "";
    private property <bool> show-second-badge: root.second-badge-text != "";

    row-height: HubTokens.control-md;
    selected-border-width: 0px;
    idle-background: transparent;
    selected-background: transparent;
    disabled-background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: root.row-spacing;
        alignment: stretch;

        if root.show-first-badge: HubRowTrailingSlot {
            row-height: root.row-height;
            slot-width: root.first-badge-width;
            badge-width: root.first-badge-width;
            badge-text: root.first-badge-text;
            badge-tone: root.first-badge-tone;
            show-badge: true;
            show-action: false;
            slot-spacing: 0px;
        }

        if root.show-second-badge: HubRowTrailingSlot {
            row-height: root.row-height;
            slot-width: root.second-badge-width;
            badge-width: root.second-badge-width;
            badge-text: root.second-badge-text;
            badge-tone: root.second-badge-tone;
            show-badge: true;
            show-action: false;
            slot-spacing: 0px;
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: 1px;
            preferred-width: 0px;
            height: parent.height;
            background: transparent;
            clip: true;

            HubRowMetaSlot {
                width: parent.width;
                row-height: root.row-height;
                slot-width: 1px;
                text: root.meta-text;
                foreground: root.meta-foreground;
            }
        }
    }
}

export component ActionRow inherits HubInteractiveRowSurface {
    in property <QuickActionData> action;
    in property <string> title-override;
    in property <string> detail-override;
    in property <bool> plain-avatar: false;
    in property <bool> plain-trailing: false;
    in property <bool> show-trailing: true;
    in property <bool> compact-shell: false;
    in property <float> disabled-shell-opacity: 1.0;
    in property <color> enabled-avatar-background: HubVisualSpec.neutral-icon-background;
    in property <color> enabled-avatar-foreground: HubVisualSpec.neutral-icon-foreground;
    in property <color> disabled-avatar-background: MaterialPalette.surface_container_high;
    in property <color> disabled-avatar-foreground: MaterialPalette.on_surface_variant;
    in property <length> leading-shell-size-override: 0px;
    in property <length> leading-icon-size-override: 0px;
    callback activate(string);

    private property <length> trailing-size: max(MaterialStyleMetrics.size_32, min(HubTokens.control-md, root.row-height * 7 / 12));
    private property <length> row-corner-radius: root.compact-shell ? HubVisualSpec.compact-radius : HubVisualSpec.panel-radius;
    private property <color> action-avatar-background: root.plain-avatar ? transparent : (root.action.enabled ? root.enabled-avatar-background : root.disabled-avatar-background);
    private property <color> action-avatar-foreground: root.plain-avatar ? HubVisualSpec.neutral-icon-foreground : (root.action.enabled ? root.enabled-avatar-foreground : root.disabled-avatar-foreground);
    private property <image> visible-leading-image: root.action.has-icon-image ? root.action.icon-image : @image-url("../assets/icons/ui/alert.svg");
    private property <length> leading-shell-size: root.leading-shell-size-override > 0px ? root.leading-shell-size-override : (root.plain-avatar ? HubTokens.control-md : HubTokens.control-lg);
    private property <length> leading-icon-size: root.leading-icon-size-override > 0px ? root.leading-icon-size-override : (root.plain-avatar ? HubTokens.icon-md : HubTokens.icon-lg);
    private property <color> trailing-foreground: root.action.enabled ? (root.plain-trailing ? MaterialPalette.on_surface : MaterialPalette.on_surface_variant) : root.disabled-avatar-foreground;
    private property <string> visible-title: root.title-override == "" ? root.action.title : root.title-override;
    private property <string> visible-detail: root.detail-override == "" ? root.action.detail : root.detail-override;

    row-radius: root.row-corner-radius;
    idle-border-width: HubTokens.border-width;
    selected-border-width: HubTokens.border-width;
    idle-border: HubVisualSpec.outline-muted;
    selected-border: HubVisualSpec.accent-stroke;
    idle-background: root.action.enabled ? HubVisualSpec.panel-background : HubVisualSpec.panel-background.with_alpha(root.disabled-shell-opacity);
    selected-background: MaterialPalette.secondary_container;
    interaction-enabled: root.enabled && root.action.enabled;
    interaction-foreground: root.action.enabled ? root.content-foreground : MaterialPalette.on_surface_variant;

    clicked => {
        if (root.enabled && root.action.enabled) {
            root.activate(root.action.id);
        }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: HubTokens.space-3;
        padding-right: HubTokens.space-3;
        spacing: HubTokens.space-2;
        alignment: stretch;

        HubRowLeadingIconSlot {
            row-height: root.row-height;
            slot-width: HubTokens.control-lg;
            shell-size: root.leading-shell-size;
            icon-size: root.leading-icon-size;
            icon-image: root.visible-leading-image;
            has-icon-image: true;
            shell-background: root.action-avatar-background;
            shell-border: root.plain-avatar ? transparent : HubVisualSpec.neutral-icon-stroke;
            icon-foreground: root.action-avatar-foreground;
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: 1px;
            preferred-width: 0px;
            height: parent.height;
            background: transparent;
            clip: true;

            HubRowMainSlot {
                width: parent.width;
                height: parent.height;
                title: root.visible-title;
                detail: root.visible-detail;
                row-height: root.row-height;
                title-foreground: root.action.enabled ? root.content-foreground : MaterialPalette.on_surface_variant;
                detail-foreground: MaterialPalette.on_surface_variant;
            }
        }

        if root.show-trailing: HubRowTrailingSlot {
            slot-width: root.trailing-size;
            row-height: root.row-height;
            show-badge: false;
            show-action: true;
            action-framed: !root.plain-trailing;
            action-icon-image: @image-url("../assets/icons/ui/chevron-right.svg");
            action-size: root.trailing-size;
            action-radius: HubVisualSpec.compact-radius;
            action-icon-size: HubTokens.icon-sm;
            action-foreground: root.trailing-foreground;
            action-state-layer-color: root.trailing-foreground;
            clicked => {
                root.clicked();
            }
        }
    }
}

component MetricCardTextStack inherits VerticalLayout {
    in property <string> label;
    in property <string> primary;
    in property <string> secondary;
    in property <bool> compact: false;

    padding-left: MaterialStyleMetrics.padding_16;
    padding-right: MaterialStyleMetrics.padding_16;
    padding-top: root.compact ? HubTokens.space-2 : MaterialStyleMetrics.padding_16;
    padding-bottom: root.compact ? HubTokens.space-2 : MaterialStyleMetrics.padding_16;
    spacing: root.compact ? HubTokens.space-1 : MaterialStyleMetrics.spacing_6;

    MutedText {
        text: root.label;
        overflow: elide;
    }

    MaterialText {
        text: root.primary;
        overflow: elide;
        color: MaterialPalette.on_surface;
        style: MaterialTypography.title_small;
    }

    MutedText {
        text: root.secondary;
        overflow: elide;
    }
}

export component MetricCard inherits HubPanel {
    in property <string> label;
    in property <string> primary;
    in property <string> secondary;
    in property <bool> compact: false;

    min-height: root.compact ? HubTokens.list-row-md + HubTokens.space-2 : HubTokens.list-row-md;
    horizontal-stretch: 1;

    MetricCardTextStack {
        width: parent.width;
        height: parent.height;
        label: root.label;
        primary: root.primary;
        secondary: root.secondary;
        compact: root.compact;
    }
}

export component HubMetricSlot inherits ResponsiveSlot {
    in property <string> label;
    in property <string> primary;
    in property <string> secondary;
    in property <bool> compact-card: false;

    MetricCard {
        width: parent.width;
        height: parent.height;
        label: root.label;
        primary: root.primary;
        secondary: root.secondary;
        compact: root.compact-card;
    }
}

export component HubMetricSectionState inherits Rectangle {
    in property <length> content-width;
    in property <length> metric-gap: HubTokens.panel-gap;
    in property <length> metric-min-width: HubTokens.panel-min-sm * 3 / 4;
    in property <length> regular-row-height: HubTokens.workspace-row-cloud-metrics;
    in property <length> compact-row-height: HubTokens.list-row-md + HubTokens.space-2;
    in property <length> wide-breakpoint: root.metric-min-width * 4 + root.metric-gap * 4;
    in property <length> medium-breakpoint: root.metric-min-width * 2 + root.metric-gap;
    in property <length> compact-card-breakpoint: HubTokens.panel-min-md * 2 + root.metric-gap;
    in property <bool> allow-two-columns: true;
    out property <bool> compact-card: root.content-width < root.compact-card-breakpoint;
    out property <bool> four-columns: root.content-width >= root.wide-breakpoint;
    out property <bool> two-columns: !root.four-columns && root.allow-two-columns && root.content-width >= root.medium-breakpoint;
    out property <int> row-count: root.four-columns ? 1 : (root.two-columns ? 2 : 4);
    out property <length> row-height: root.compact-card ? root.compact-row-height : root.regular-row-height;
    out property <length> slot-basis: root.four-columns || root.two-columns ? root.metric-min-width : root.content-width;
    out property <length> slot-min-width: root.slot-basis;
    out property <float> slot-grow: 1;
    out property <length> section-height: root.row-height * root.row-count + root.metric-gap * (root.row-count - 1);

    width: 0px;
    height: 0px;
    background: transparent;
}

export component BuildHistoryRow inherits InfoRow {
    in property <SourceBuildHistoryRowData> record;
    in property <bool> collapse-label: false;

    row-height: HubTokens.list-row-md;
    title: root.record.detail;
    detail: root.record.log != "" ? root.record.log : root.record.output-path;
    meta: root.record.process-id != "" ? root.record.process-id + " / " + root.record.profile + " / " + root.record.finished : root.record.profile + " / " + root.record.finished;
    leading-image: root.record.success ? @image-url("../assets/icons/status/success.svg") : @image-url("../assets/icons/status/error.svg");
    has-leading-image: true;
    trailing-text: root.record.status;
    trailing-tone: root.record.success ? "ok" : "error";
    show-trailing-badge: true;
    collapse-trailing-label: root.collapse-label;
}
