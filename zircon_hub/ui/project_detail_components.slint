import {
    MutedText,
    ProjectDetailData,
    SourceEngineRowData,
    UiTextData,
} from "shared.slint";
import {
    HubActionCommandButton,
    HubActionStack,
    HubBadgeMetaStrip,
    HubContentPanelSlot,
    HubMediaContentPanelSlot,
    HubSection,
    HubToggleRow,
    HubTokens,
    HubVisualSpec,
    MaterialPalette,
    StatusBanner,
} from "components.slint";
import {
    ProjectEngineChoiceList,
    ProjectSettingSummaryRow,
} from "project_page_components.slint";

export component ProjectDetailPinToggleRow inherits HubToggleRow {
    in property <ProjectDetailData> detail;
    in property <UiTextData> copy;

    row-height: HubTokens.list-row-sm;
    checked: root.detail.pinned;
    label: root.detail.pinned ? root.copy.pinned-label : root.copy.not-pinned-label;
    supporting-text: root.detail.pinned ? root.copy.unpin-project : root.copy.pin-project;
}

component ProjectDetailActionNote inherits MutedText {
    in property <string> note-text;
    in property <length> note-height: HubTokens.control-sm;

    height: root.note-height;
    text: root.note-text;
    overflow: elide;
}

export component ProjectDetailActionStack inherits HubActionStack {
    in property <ProjectDetailData> project;
    in property <UiTextData> copy;
    in property <length> action-row-height: HubTokens.control-md;
    in property <length> pin-toggle-row-height: HubTokens.list-row-sm;
    in property <length> note-height: HubTokens.control-sm;
    in property <length> action-spacing: HubTokens.panel-gap;
    callback open-project(string);
    callback toggle-pin;
    callback remove-from-hub;
    callback request-delete;

    stack-height: root.action-row-height * 3 + root.pin-toggle-row-height + root.note-height + root.action-spacing * 4;
    stack-spacing: root.action-spacing;

    HubActionCommandButton {
        action-height: root.action-row-height;
        text: root.copy.open;
        source-image: @image-url("../assets/icons/nav/editor.svg");
        has-source-image: true;
        primary: true;
        enabled: root.project.can-open;
        clicked => { root.open-project(root.project.open-path); }
    }

    ProjectDetailPinToggleRow {
        row-height: root.pin-toggle-row-height;
        detail: root.project;
        copy: root.copy;
        toggled(checked) => { root.toggle-pin(); }
    }

    HubActionCommandButton {
        action-height: root.action-row-height;
        text: root.copy.remove-from-hub;
        source-image: @image-url("../assets/icons/ui/close.svg");
        has-source-image: true;
        clicked => { root.remove-from-hub(); }
    }

    ProjectDetailActionNote {
        note-height: root.note-height;
        note-text: root.copy.remove-from-hub-detail;
    }

    HubActionCommandButton {
        action-height: root.action-row-height;
        text: root.copy.delete-project;
        source-image: @image-url("../assets/icons/ui/alert.svg");
        has-source-image: true;
        enabled: root.project.can-delete;
        clicked => { root.request-delete(); }
    }
}

export component ProjectDetailDeleteActionStack inherits HubActionStack {
    in property <ProjectDetailData> project;
    in property <UiTextData> copy;
    in property <length> action-row-height: HubTokens.control-md;
    in property <length> action-spacing: HubTokens.panel-gap;
    callback cancel-delete;
    callback confirm-delete;

    stack-height: HubTokens.list-row-sm + root.action-row-height * 2 + root.action-spacing * 2;
    stack-spacing: root.action-spacing;

    StatusBanner {
        horizontal-stretch: 1;
        title: root.copy.confirm-delete;
        detail: root.copy.recycle-bin-delete-detail;
        tone: "error";
    }

    HubActionCommandButton {
        action-height: root.action-row-height;
        text: root.copy.confirm-delete;
        source-image: @image-url("../assets/icons/ui/alert.svg");
        has-source-image: true;
        enabled: root.project.can-delete;
        clicked => { root.confirm-delete(); }
    }

    HubActionCommandButton {
        action-height: root.action-row-height;
        text: root.copy.cancel-delete;
        source-image: @image-url("../assets/icons/ui/close.svg");
        has-source-image: true;
        clicked => { root.cancel-delete(); }
    }
}

export component ProjectDetailEngineSection inherits HubSection {
    in property <[SourceEngineRowData]> engines;
    in property <int> engine-count;
    in property <ProjectDetailData> detail;
    in property <UiTextData> copy;
    in property <length> list-height;
    in-out property <length> list-scroll-y: 0px;
    in property <length> row-height;
    in property <length> row-spacing;
    in property <length> empty-height;
    in property <bool> collapse-label;
    callback selected(string);

    title: root.copy.change-source-engine;
    subtitle: root.copy.bound-source-engine + ": " + root.detail.engine-label;

    ProjectEngineChoiceList {
        engines: root.engines;
        engine-count: root.engine-count;
        list-height: root.list-height;
        list-scroll-y <=> root.list-scroll-y;
        row-height: root.row-height;
        row-spacing: root.row-spacing;
        empty-height: root.empty-height;
        selected-label: root.copy.selected-label;
        registered-label: root.copy.registered;
        empty-title: root.copy.no-source-engine-available;
        collapse-label: root.collapse-label;
        selected(id) => { root.selected(id); }
    }
}

export component ProjectDetailActionsSection inherits HubContentPanelSlot {
    in property <ProjectDetailData> project;
    in property <[SourceEngineRowData]> engines;
    in property <int> engine-count;
    in property <UiTextData> copy;
    in property <length> panel-padding: HubTokens.space-4;
    in property <length> panel-spacing: HubTokens.panel-gap;
    in property <length> action-row-height: HubTokens.control-md;
    in property <length> pin-toggle-row-height: HubTokens.list-row-sm;
    in property <length> engine-section-height;
    in property <length> engine-list-height;
    in-out property <length> engine-scroll-y: 0px;
    in property <length> engine-row-height: HubTokens.list-row-md;
    in property <length> engine-row-spacing: HubTokens.space-2;
    in property <bool> collapse-engine-label: false;
    callback open-project(string);
    callback select-engine(string);
    callback toggle-pin;
    callback remove-from-hub;
    callback request-delete;
    callback cancel-delete;
    callback confirm-delete;

    body-padding: root.panel-padding;
    body-spacing: root.panel-spacing;
    content-spacing: root.panel-spacing;
    title: root.copy.project-actions-title;

    if root.project.pending-delete: ProjectDetailDeleteActionStack {
        project: root.project;
        copy: root.copy;
        action-row-height: root.action-row-height;
        action-spacing: root.panel-spacing;
        cancel-delete => { root.cancel-delete(); }
        confirm-delete => { root.confirm-delete(); }
    }

    if !root.project.pending-delete: ProjectDetailActionStack {
        project: root.project;
        copy: root.copy;
        action-row-height: root.action-row-height;
        pin-toggle-row-height: root.pin-toggle-row-height;
        note-height: HubTokens.control-sm;
        action-spacing: root.panel-spacing;
        open-project(path) => { root.open-project(path); }
        toggle-pin => { root.toggle-pin(); }
        remove-from-hub => { root.remove-from-hub(); }
        request-delete => { root.request-delete(); }
    }

    if !root.project.pending-delete: ProjectDetailEngineSection {
        section-height: root.engine-section-height;
        section-spacing: root.panel-spacing;
        detail: root.project;
        copy: root.copy;
        engines: root.engines;
        engine-count: root.engine-count;
        list-height: root.engine-list-height;
        list-scroll-y <=> root.engine-scroll-y;
        row-height: root.engine-row-height;
        row-spacing: root.engine-row-spacing;
        empty-height: HubTokens.list-row-lg;
        collapse-label: root.collapse-engine-label;
        selected(id) => { root.select-engine(id); }
    }
}

export component ProjectDetailStatusStrip inherits HubBadgeMetaStrip {
    in property <ProjectDetailData> detail;
    in property <UiTextData> copy;
    in property <length> version-badge-width;
    in property <length> pin-badge-width;

    first-badge-text: root.detail.version;
    first-badge-tone: "accent";
    first-badge-width: root.version-badge-width;
    second-badge-text: root.detail.pinned ? root.copy.pinned-label : root.copy.not-pinned-label;
    second-badge-tone: root.detail.pinned ? "accent" : "neutral";
    second-badge-width: root.pin-badge-width;
    meta-text: root.copy.modified-prefix + root.detail.modified;
}

export component ProjectDetailInfoSection inherits HubSection {
    in property <ProjectDetailData> project;
    in property <UiTextData> ui-text;
    in property <length> row-height;
    in property <length> row-spacing;
    in property <string> header-subtitle;

    section-spacing: root.row-spacing;
    title: root.ui-text.project-info-title;
    subtitle: root.header-subtitle;

    ProjectSettingSummaryRow {
        row-height: root.row-height;
        label: root.ui-text.project-status;
        value: root.project.status;
        badge-value: true;
        badge-tone: root.project.missing ? "warning" : "accent";
    }

    ProjectSettingSummaryRow {
        row-height: root.row-height;
        label: root.ui-text.project-root-path;
        value: root.project.project-path;
    }

    ProjectSettingSummaryRow {
        row-height: root.row-height;
        label: root.ui-text.source-engine;
        value: root.project.engine-label;
    }

    ProjectSettingSummaryRow {
        row-height: root.row-height;
        label: root.ui-text.engine-version-column;
        value: root.project.version;
    }

    ProjectSettingSummaryRow {
        row-height: root.row-height;
        label: root.ui-text.last-modified-column;
        value: root.project.modified;
    }
}

export component ProjectDetailMainPanel inherits HubMediaContentPanelSlot {
    in property <ProjectDetailData> project;
    in property <UiTextData> ui-text;
    in property <length> cover-height;
    in property <length> status-row-height;
    in property <length> status-row-spacing;
    in property <length> info-section-height;
    in property <length> info-row-height;
    in property <length> info-row-spacing;
    in property <length> content-stack-spacing: HubTokens.panel-gap;
    in property <string> header-subtitle;
    in property <string> info-header-subtitle;
    in property <length> version-badge-width;
    in property <length> pin-badge-width;

    title: root.project.title;
    subtitle: root.header-subtitle;
    show-badge: true;
    badge-text: root.project.status;
    badge-tone: root.project.missing ? "warning" : "accent";
    media-height: root.cover-height;
    media-radius: HubVisualSpec.panel-radius;
    media-background: root.project.accent == 0 ? MaterialPalette.primary_container : (root.project.accent == 1 ? MaterialPalette.secondary_container : MaterialPalette.tertiary_container);
    media-source: root.project.cover-image;
    has-media-source: root.project.has-cover;
    content-spacing: root.content-stack-spacing;

    ProjectDetailStatusStrip {
        row-height: root.status-row-height;
        row-spacing: root.status-row-spacing;
        version-badge-width: root.version-badge-width;
        pin-badge-width: root.pin-badge-width;
        detail: root.project;
        copy: root.ui-text;
    }

    ProjectDetailInfoSection {
        section-height: root.info-section-height;
        row-height: root.info-row-height;
        row-spacing: root.info-row-spacing;
        header-subtitle: root.info-header-subtitle;
        project: root.project;
        ui-text: root.ui-text;
    }
}
