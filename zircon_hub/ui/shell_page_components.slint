import { ProjectDetailData, SourceEngineData, UiTextData } from "shared.slint";
import { HubHeaderCommandGroup } from "button_components.slint";
import { HubTokens, HubVisualSpec } from "tokens.slint";
import { Badge } from "surfaces.slint";
import { MaterialPalette, MaterialStyleMetrics, MaterialText, MaterialTypography } from "material_bridge.slint";

component HubPageHeaderTitleStack inherits Rectangle {
    in property <string> title-text;
    in property <string> subtitle-text;
    in property <length> stack-height: HubTokens.shell-header-height;
    in property <length> stack-spacing: MaterialStyleMetrics.spacing_6;

    height: root.stack-height;
    horizontal-stretch: 0;
    min-width: 1px;
    background: transparent;
    clip: true;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: root.stack-spacing;

        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
        }
        MaterialText {
            text: root.title-text;
            color: MaterialPalette.on_surface;
            style: MaterialTypography.headline_medium;
            overflow: elide;
        }
        MaterialText {
            text: root.subtitle-text;
            color: MaterialPalette.on_surface_variant;
            style: MaterialTypography.body_medium;
            overflow: elide;
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
        }
    }
}

component HubStatusDetailText inherits MaterialText {
    in property <string> detail-text;

    text: root.detail-text;
    color: MaterialPalette.on_surface_variant;
    style: MaterialTypography.label_medium;
    vertical_alignment: center;
    overflow: elide;
    horizontal-stretch: 1;
}

export component HubPageHeader inherits Rectangle {
    in property <string> selected-page;
    in property <string> selected-page-title;
    in property <string> selected-page-subtitle;
    in property <UiTextData> ui-text;
    in property <bool> header-visible: true;
    in property <bool> project-actions-visible: true;
    in property <bool> page-actions-visible: false;
    in property <string> secondary-action-label: "";
    in property <string> primary-action-label: "";
    in property <string> secondary-action-id: "";
    in property <string> primary-action-id: "";
    in property <image> secondary-action-image: @image-url("../assets/icons/ui/plus.svg");
    in property <image> primary-action-image: @image-url("../assets/icons/ui/plus.svg");
    in property <bool> primary-action-with-menu: false;
    in property <length> page-title-height: HubTokens.shell-header-height + HubTokens.space-6;
    in property <length> page-pad-x: HubTokens.page-padding;
    in property <length> gap: HubTokens.toolbar-gap;
    in property <length> action-height: HubTokens.control-lg;
    in property <length> content-offset-y: HubTokens.space-3 + MaterialStyleMetrics.size_1;
    private property <bool> projects-action-strip-visible: root.selected-page == "projects" && root.project-actions-visible;
    private property <bool> action-strip-visible: root.projects-action-strip-visible || root.page-actions-visible;
    callback import-project();
    callback create-project();
    callback page-action(string);

    height: root.header-visible ? root.page-title-height : 0px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    background: HubVisualSpec.page-background;
    clip: true;

    HorizontalLayout {
        width: parent.width;
        height: root.page-title-height;
        padding-left: root.page-pad-x;
        padding-right: root.page-pad-x + (root.action-strip-visible ? MaterialStyleMetrics.size_4 + MaterialStyleMetrics.size_1 : 0px);
        padding-top: root.content-offset-y;
        spacing: root.gap;
        alignment: stretch;

        HubPageHeaderTitleStack {
            stack-height: parent.height;
            title-text: root.selected-page-title;
            subtitle-text: root.selected-page-subtitle;
        }

        Rectangle { horizontal-stretch: 1; }

        if root.action-strip-visible: VerticalLayout {
            height: parent.height;
            horizontal-stretch: 0;
            padding-bottom: MaterialStyleMetrics.size_8;

            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
            }

            HubHeaderCommandGroup {
                action-height: root.action-height;
                action-gap: root.gap;
                secondary-text: root.projects-action-strip-visible ? root.ui-text.import-project : root.secondary-action-label;
                secondary-image: root.projects-action-strip-visible ? @image-url("../assets/icons/ui/import.svg") : root.secondary-action-image;
                primary-text: root.projects-action-strip-visible ? root.ui-text.create-project : root.primary-action-label;
                primary-image: root.projects-action-strip-visible ? @image-url("../assets/icons/ui/plus.svg") : root.primary-action-image;
                primary-with-menu: root.projects-action-strip-visible || root.primary-action-with-menu;
                secondary-clicked => {
                    if (root.projects-action-strip-visible) {
                        root.import-project();
                    } else {
                        root.page-action(root.secondary-action-id);
                    }
                }
                primary-clicked => {
                    if (root.projects-action-strip-visible) {
                        root.create-project();
                    } else {
                        root.page-action(root.primary-action-id);
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
            }
        }
    }
}

export component HubStatusBar inherits Rectangle {
    in property <string> status-detail;
    in property <length> status-height: HubTokens.bottom-status-height;
    in property <ProjectDetailData> project;
    in property <SourceEngineData> source-engine;
    in property <UiTextData> ui-text;
    in property <bool> compact: false;
    in property <length> context-badge-width: HubTokens.status-badge-width;
    private property <string> project-context: root.ui-text.current-project + ": " + (root.project.selected ? root.project.title : root.ui-text.no-project-selected);
    private property <string> engine-context: root.ui-text.active-source-engine + ": " + root.source-engine.title;

    preferred-height: root.status-height;
    max-height: root.status-height;
    horizontal-stretch: 1;
    background: HubVisualSpec.panel-background;
    border-color: HubVisualSpec.outline-muted;
    border-width: HubTokens.border-width;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: HubTokens.panel-gap;
        padding-right: HubTokens.panel-gap;
        spacing: HubTokens.toolbar-gap;
        alignment: center;

        HubStatusDetailText {
            detail-text: root.status-detail;
        }

        if !root.compact: Badge {
            text: root.project-context;
            tone: root.project.selected ? "accent" : "neutral";
            badge-width: root.context-badge-width;
            badge-height: root.status-height - HubTokens.space-2;
        }

        if !root.compact: Badge {
            text: root.engine-context;
            tone: "neutral";
            badge-width: root.context-badge-width;
            badge-height: root.status-height - HubTokens.space-2;
        }
    }
}
