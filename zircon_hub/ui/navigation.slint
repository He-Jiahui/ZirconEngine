import { NavItemData } from "shared.slint";
import { HubTokens, HubVisualSpec } from "tokens.slint";
import {
    NavigationItem,
    NavigationRail as MaterialNavigationRail,
    SecondaryTabBar,
    TabBar,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    StateLayerArea,
} from "material_bridge.slint";

component NavButtonLabel inherits MaterialText {
    in property <string> value;
    in property <bool> active: false;

    text: root.value;
    color: root.active ? MaterialPalette.on_surface : HubVisualSpec.nav-idle-foreground;
    style: MaterialTypography.label_large;
    overflow: elide;
    vertical_alignment: center;
}

export component NavButton inherits Rectangle {
    in property <NavItemData> item;
    in property <bool> collapsed: false;
    in property <bool> enabled: true;
    in property <bool> focused: false;
    callback clicked(string);

    height: MaterialStyleMetrics.size_48 + MaterialStyleMetrics.size_2;
    border-radius: HubVisualSpec.compact-radius;
    border-width: root.focused ? HubVisualSpec.focus-ring-width : (root.item.active ? HubTokens.border-width : 0px);
    border-color: root.focused ? HubVisualSpec.focus-ring-color : HubVisualSpec.nav-active-stroke;
    background: root.item.active ? HubVisualSpec.nav-active-fill : transparent;
    opacity: root.enabled ? 1.0 : HubVisualSpec.disabled-opacity;
    clip: true;

    StateLayerArea {
        width: parent.width;
        height: parent.height;
        color: root.item.active ? HubVisualSpec.nav-active-stroke : MaterialPalette.on_surface;
        border_radius: HubVisualSpec.compact-radius;
        clicked => {
            if (root.enabled) {
                root.clicked(root.item.id);
            }
        }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: root.collapsed ? 0px : HubTokens.space-3;
        padding-right: root.collapsed ? 0px : HubTokens.space-3;
        spacing: HubTokens.space-3;
        alignment: start;

        Rectangle {
            width: HubTokens.icon-lg;
            height: parent.height;

            Image {
                width: HubTokens.icon-lg;
                height: HubTokens.icon-lg;
                source: root.item.has-icon-image ? root.item.icon-image : @image-url("../assets/icons/nav/projects.svg");
                colorize: root.item.active ? HubVisualSpec.neutral-icon-foreground : HubVisualSpec.nav-idle-foreground;
            }
        }

        if !root.collapsed: NavButtonLabel {
            horizontal-stretch: 1;
            height: parent.height;
            value: root.item.title;
            active: root.item.active;
        }
    }
}

export component NavRail inherits Rectangle {
    in property <[NavItemData]> items;
    in property <[NavigationItem]> material-items;
    in-out property <int> current-index: 0;
    in property <bool> collapsed: false;
    in property <length> rail-padding: root.collapsed ? HubTokens.space-2 : HubTokens.space-4;
    in property <length> rail-gap: HubTokens.space-3;
    in property <brush> rail-background: HubVisualSpec.chrome-background;
    in property <bool> enabled: true;
    callback clicked(string);

    private property <[NavigationItem]> enabled-material-items: root.enabled ? root.material-items : [];

    min-width: root.collapsed ? MaterialStyleMetrics.size_80 : 0px;
    background: root.rail-background;

    if root.collapsed: MaterialNavigationRail {
        width: parent.width;
        height: parent.height;
        items: root.enabled-material-items;
        current_index <=> root.current-index;
        alignment: start;
        has_menu: false;

        index_changed(index) => {
            if root.enabled && index >= 0 && index < root.items.length {
                root.clicked(root.items[index].id);
            }
        }
    }

    if !root.collapsed: VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: root.rail-padding;
        spacing: root.rail-gap;

        for item in root.items: NavButton {
            width: parent.width - root.rail-padding * 2;
            item: item;
            collapsed: false;
            enabled: root.enabled;
            clicked(id) => {
                root.clicked(id);
            }
        }
    }
}

export component HubTabs inherits Rectangle {
    in property <[NavigationItem]> items;
    in-out property <int> current-index: 0;
    in property <bool> secondary: false;
    in property <bool> enabled: true;
    in property <bool> focused: false;
    in property <length> tabs-height: MaterialStyleMetrics.size_56;
    callback selected(int);

    horizontal-stretch: 1;
    height: root.tabs-height;
    min-width: 1px;
    opacity: root.enabled ? 1.0 : HubVisualSpec.disabled-opacity;
    border-radius: HubVisualSpec.compact-radius;
    border-width: root.focused ? HubVisualSpec.focus-ring-width : 0px;
    border-color: root.focused ? HubVisualSpec.focus-ring-color : transparent;
    background: MaterialPalette.surface;
    clip: true;

    if !root.secondary: TabBar {
        width: parent.width;
        height: parent.height;
        items: root.items;
        current_index <=> root.current-index;
        index_changed(index) => {
            if root.enabled {
                root.selected(index);
            }
        }
    }

    if root.secondary: SecondaryTabBar {
        width: parent.width;
        height: parent.height;
        items: root.items;
        current_index <=> root.current-index;
        index_changed(index) => {
            if root.enabled {
                root.selected(index);
            }
        }
    }
}
