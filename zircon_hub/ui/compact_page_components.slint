import { HubTokens } from "tokens.slint";
import { NavigationItem } from "material_bridge.slint";
import { HubTabs } from "navigation.slint";

export component HubCompactTabStrip inherits Rectangle {
    in-out property <int> current-index: 0;
    in property <string> first-label: "All";
    in property <string> second-label: "Recent";
    in property <string> third-label: "Project";
    in property <string> fourth-label: "Workspace";
    in property <bool> show-second: true;
    in property <bool> show-third: true;
    in property <bool> show-fourth: true;
    in property <length> tab-width: HubTokens.control-md * 3;
    callback selected(int);

    private property <[NavigationItem]> first-only-tabs: [
        { text: root.first-label },
    ];
    private property <[NavigationItem]> first-second-tabs: [
        { text: root.first-label },
        { text: root.second-label },
    ];
    private property <[NavigationItem]> first-third-tabs: [
        { text: root.first-label },
        { text: root.third-label },
    ];
    private property <[NavigationItem]> first-fourth-tabs: [
        { text: root.first-label },
        { text: root.fourth-label },
    ];
    private property <[NavigationItem]> first-second-third-tabs: [
        { text: root.first-label },
        { text: root.second-label },
        { text: root.third-label },
    ];
    private property <[NavigationItem]> first-second-fourth-tabs: [
        { text: root.first-label },
        { text: root.second-label },
        { text: root.fourth-label },
    ];
    private property <[NavigationItem]> first-third-fourth-tabs: [
        { text: root.first-label },
        { text: root.third-label },
        { text: root.fourth-label },
    ];
    private property <[NavigationItem]> all-tabs: [
        { text: root.first-label },
        { text: root.second-label },
        { text: root.third-label },
        { text: root.fourth-label },
    ];
    private property <[NavigationItem]> visible-tabs: root.show-second && root.show-third && root.show-fourth ? root.all-tabs : (
        root.show-second && root.show-third ? root.first-second-third-tabs : (
            root.show-second && root.show-fourth ? root.first-second-fourth-tabs : (
                root.show-third && root.show-fourth ? root.first-third-fourth-tabs : (
                    root.show-second ? root.first-second-tabs : (
                        root.show-third ? root.first-third-tabs : (
                            root.show-fourth ? root.first-fourth-tabs : root.first-only-tabs
                        )
                    )
                )
            )
        )
    );
    private property <int> visible-current-index: root.current-index == 1 ? (root.show-second ? 1 : 0) : (
        root.current-index == 2 ? (root.show-third ? (root.show-second ? 2 : 1) : 0) : (
            root.current-index == 3 ? (
                root.show-fourth ? (
                    root.show-second && root.show-third ? 3 : (
                        root.show-second || root.show-third ? 2 : 1
                    )
                ) : 0
            ) : 0
        )
    );

    horizontal-stretch: 1;
    height: HubTokens.control-md;
    min-width: 1px;
    background: transparent;
    clip: true;

    HubTabs {
        width: root.tab-width * root.visible-tabs.length;
        height: parent.height;
        current-index: root.visible-current-index;
        items: root.visible-tabs;
        secondary: true;
        tabs-height: HubTokens.control-md;
        selected(index) => {
            if index == 0 {
                root.current-index = 0;
                root.selected(0);
            } else if index == 1 {
                if root.show-second {
                    root.current-index = 1;
                    root.selected(1);
                } else if root.show-third {
                    root.current-index = 2;
                    root.selected(2);
                } else if root.show-fourth {
                    root.current-index = 3;
                    root.selected(3);
                }
            } else if index == 2 {
                if root.show-second && root.show-third {
                    root.current-index = 2;
                    root.selected(2);
                } else if root.show-fourth {
                    root.current-index = 3;
                    root.selected(3);
                }
            } else if index == 3 {
                root.current-index = 3;
                root.selected(3);
            }
        }
    }
}

export component HubWorkspaceTabStrip inherits HubCompactTabStrip {
    first-label: "Overview";
    second-label: "Details";
    third-label: "History";
    fourth-label: "Timeline";
    tab-width: HubTokens.control-md * 4;
}
