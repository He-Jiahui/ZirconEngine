import { HubRowActionButton } from "icon_button_components.slint";
import { HubCheckBox } from "input_state_components.slint";
import { HubTokens, HubVisualSpec } from "tokens.slint";
import { StatusBadge } from "surfaces.slint";
import {
    CheckState,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
} from "material_bridge.slint";

export component HubRowLeadingIconSlot inherits Rectangle {
    in property <image> icon-image;
    in property <bool> has-icon-image: true;
    in property <length> row-height: HubTokens.list-row-md;
    in property <length> slot-width: HubTokens.control-lg;
    in property <length> shell-size: HubTokens.control-lg;
    in property <length> icon-size: HubTokens.icon-lg;
    in property <length> shell-radius: HubVisualSpec.panel-radius;
    in property <length> shell-border-width: HubTokens.border-width;
    in property <color> shell-background: HubVisualSpec.neutral-icon-background;
    in property <color> shell-border: HubVisualSpec.neutral-icon-stroke;
    in property <color> icon-foreground: HubVisualSpec.neutral-icon-foreground;

    width: root.slot-width;
    height: root.row-height;
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        Rectangle { vertical-stretch: 1; min-height: 0px; }

        HorizontalLayout {
            width: parent.width;
            height: root.shell-size;
            alignment: center;

            Rectangle {
                width: root.shell-size;
                height: root.shell-size;
                border-radius: root.shell-radius;
                border-width: root.shell-border-width;
                border-color: root.shell-border;
                background: root.shell-background;

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;

                    Rectangle { vertical-stretch: 1; min-height: 0px; }

                    HorizontalLayout {
                        width: parent.width;
                        height: root.icon-size;
                        alignment: center;

                        if root.has-icon-image: Image {
                            width: root.icon-size;
                            height: root.icon-size;
                            source: root.icon-image;
                            colorize: root.icon-foreground;
                            image-fit: contain;
                        }
                    }

                    Rectangle { vertical-stretch: 1; min-height: 0px; }
                }
            }
        }

        Rectangle { vertical-stretch: 1; min-height: 0px; }
    }
}

export component HubRowSelectionSlot inherits Rectangle {
    in property <CheckState> check-state: CheckState.unchecked;
    in property <bool> tristate: false;
    in property <bool> has-error: false;
    in property <bool> enabled: true;
    in property <bool> focused: false;
    in property <length> row-height: HubTokens.list-row-md;
    in property <length> slot-width: HubTokens.control-md;
    in property <length> control-size: HubTokens.control-md;
    callback changed(CheckState);

    width: root.slot-width;
    height: root.row-height;
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        Rectangle { vertical-stretch: 1; min-height: 0px; }

        HorizontalLayout {
            width: parent.width;
            height: root.control-size;
            alignment: center;

            HubCheckBox {
                width: root.control-size;
                height: root.control-size;
                check-state: root.check-state;
                tristate: root.tristate;
                has-error: root.has-error;
                enabled: root.enabled;
                focused: root.focused;
                changed(state) => { root.changed(state); }
            }
        }

        Rectangle { vertical-stretch: 1; min-height: 0px; }
    }
}

export component HubRowMetaSlot inherits Rectangle {
    in property <string> text;
    in property <length> row-height: HubTokens.list-row-md;
    in property <length> slot-width: HubTokens.control-md * 3;
    in property <color> foreground: MaterialPalette.on_surface_variant;

    height: root.row-height;
    min-width: root.slot-width;
    preferred-width: root.slot-width;
    background: transparent;

    MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.text;
        overflow: elide;
        color: root.foreground;
        style: MaterialTypography.body_small;
        vertical_alignment: center;
    }
}

export component HubRowMainSlot inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <length> row-height: HubTokens.list-row-md;
    in property <color> title-foreground: MaterialPalette.on_surface;
    in property <color> detail-foreground: MaterialPalette.on_surface_variant;

    horizontal-stretch: 1;
    min-width: 1px;
    preferred-width: 0px;
    height: root.row-height;
    background: transparent;
    clip: true;

    if root.detail == "": MaterialText {
        width: parent.width;
        height: parent.height;
        text: root.title;
        overflow: elide;
        color: root.title-foreground;
        style: MaterialTypography.label_large;
        vertical_alignment: center;
    }

    if root.detail != "": VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: MaterialStyleMetrics.spacing_2;

        Rectangle { vertical-stretch: 1; min-height: 0px; }

        MaterialText {
            height: MaterialStyleMetrics.size_20;
            text: root.title;
            overflow: elide;
            color: root.title-foreground;
            style: MaterialTypography.label_large;
            vertical_alignment: center;
        }

        MaterialText {
            height: MaterialStyleMetrics.size_18;
            text: root.detail;
            overflow: elide;
            color: root.detail-foreground;
            style: MaterialTypography.body_small;
            vertical_alignment: center;
        }

        Rectangle { vertical-stretch: 1; min-height: 0px; }
    }
}

export component HubRowTrailingSlot inherits Rectangle {
    in property <string> badge-text;
    in property <string> badge-tone: "neutral";
    in property <bool> show-badge: true;
    in property <bool> collapse-badge: false;
    in property <bool> show-chevron: false;
    in property <bool> show-action: false;
    in property <image> action-icon-image: @image-url("../assets/icons/ui/chevron-right.svg");
    in property <bool> action-framed: true;
    in property <length> row-height: HubTokens.list-row-md;
    in property <length> badge-width: HubTokens.control-md * 3;
    in property <length> chevron-size: HubTokens.control-md;
    in property <length> action-size: root.chevron-size;
    in property <length> action-icon-size: HubTokens.icon-md;
    in property <length> action-radius: root.action-size / 2;
    in property <length> slot-spacing: HubTokens.space-2;
    in property <length> slot-width: (root.show-badge && !root.collapse-badge ? root.badge-width : 0px) + (root.show-action || root.show-chevron ? root.action-size : 0px) + ((root.show-badge && !root.collapse-badge) && (root.show-action || root.show-chevron) ? root.slot-spacing : 0px);
    in property <color> action-foreground: MaterialPalette.on_surface_variant;
    in property <color> action-state-layer-color: root.action-foreground;
    callback clicked;

    private property <bool> badge-visible: root.show-badge && !root.collapse-badge;
    private property <bool> action-visible: root.show-action || root.show-chevron;

    width: root.slot-width;
    height: root.row-height;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: root.slot-spacing;
        alignment: center;

        if root.badge-visible: StatusBadge {
            text: root.badge-text;
            tone: root.badge-tone;
            badge-width: root.badge-width;
        }

        if root.action-visible: HubRowActionButton {
            button-size: root.action-size;
            button-radius: root.action-radius;
            icon-image: root.action-icon-image;
            icon-size: root.action-icon-size;
            idle-foreground: root.action-foreground;
            state-layer-color: root.action-state-layer-color;
            framed: root.action-framed;
            clicked => { root.clicked(); }
        }
    }
}
